{
  "extends": "../ts/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "bun"],
    "paths": {
      "@seseragi/runtime/*": ["../ts/src/*"]
    }
  },
  "include": [
    "child-process.ts",
    "filesystem.ts",
    "http1-stream.ts",
    "http-client.ts",
    "browser/**/*.ts",
    "bun/**/*.ts",
    "timezones.ts",
    "node/**/*.ts",
    "postgres/**/*.ts",
    "sqlite/**/*.ts"
  ]
}
