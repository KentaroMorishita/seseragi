struct Point { x: Int, y: Int }
struct DetailedCard {
  title: String,
  subtitle: String,
  description: String,
  tags: Array<String>
}

type Mode =
  | Compact
  | Detailed

trait Render<A> {
  fn render value: A -> String
  fn renderDetailed value: A -> prefix: String -> suffix: String -> String
}

instance Render<Mode> {
  fn render value: Mode -> String = match value {
    Compact -> "compact"
    Detailed -> "detailed"
  }

  fn renderDetailed value: Mode -> prefix: String -> suffix: String -> String =
    prefix
    <+> render value
    <+> suffix
}

impl Point {
  operator + self -> other: Point -> Point = Point {
    x: self.x + other.x,
    y: self.y + other.y
  }

  operator == self -> other: Point -> Bool = self.x == other.x && self.y == other.y
}

foreign "typescript" from "host" {
  pure fn identity value: Int -> Int
  task fn load value: Int -> Int
}

fn shortBlock -> Int = {
  let value = 1
  value
}

fn shortMatch mode: Mode -> String = match mode {
  Compact -> "compact"
  Detailed -> "detailed"
}

pub effect fn shortDo = do {
  value <- load 1
  println $ show value
}

pub effect fn longDo input: String
  -> prefix: String
  -> suffix: String
  -> Unit
with Console
fails ConsoleError =
  do {
    println $ prefix <+> input <+> suffix
  }

