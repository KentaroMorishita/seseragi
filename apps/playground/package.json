{
  "name": "@seseragi/playground",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "samples:generate": "bun ../../scripts/generate-playground-samples.ts",
    "samples:check": "bun ../../scripts/generate-playground-samples.ts --check",
    "tour:generate": "bun ../../scripts/generate-playground-tour.ts",
    "tour:check": "bun ../../scripts/generate-playground-tour.ts --check",
    "deep-dive:generate": "bun ../../scripts/generate-playground-deep-dive.ts",
    "deep-dive:check": "bun ../../scripts/generate-playground-deep-dive.ts --check",
    "catalog:check": "bun run samples:check && bun run tour:check && bun run deep-dive:check",
    "brand:check": "bun test tests/brand-assets.test.ts",
    "dev": "bun run samples:generate && bun run tour:generate && bun run deep-dive:generate && vite",
    "build": "bun run catalog:check && bun run brand:check && vite build",
    "build:wasm": "../../scripts/build-playground-wasm.sh apps/playground/src/wasm/pkg",
    "test": "bun run catalog:check && bun test tests",
    "test:visual": "bun scripts/visual-baselines.ts check && playwright test --config playwright.config.ts",
    "test:visual:update": "bun scripts/visual-baselines.ts update",
    "test:visual:install": "playwright install chromium",
    "test:web-build": "bun scripts/web-build-smoke.ts",
    "typecheck": "bun run catalog:check && tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "latest",
    "vite": "^7.0.4"
  }
}
