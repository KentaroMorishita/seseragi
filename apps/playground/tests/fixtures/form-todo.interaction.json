  "steps": [
    {
      "id": "initial",
      "actions": [],
      "assert": {
        "planCount": 3,
        "planTitles": [
          "告知文の骨子を書く",
          "二人にレビューを頼む",
          "ひと息つく時間を残す"
        ],
        "summary": "すべて: 3 件 ・ 完了 1 / 3",
        "status": "段取りを始める準備ができました。"
      }
    },
    {
      "id": "invalid-submit",
      "actions": [
        {
          "kind": "input",
          "selector": "#plan-title",
          "value": "ローンチの流れを見直す"
        },
        {
          "kind": "submit",
          "buttonText": "追加する"
        }
      ],
      "assert": {
        "planCount": 3,
        "alert": "何のためにやるのかを、ひとこと添えてください。",
        "status": "入力の確認: ひとことがまだ空です。"
      }
    },
    {
      "id": "valid-submit",
      "actions": [
        {
          "kind": "input",
          "selector": "#plan-details",
          "value": "操作を一つずつ、通しで確かめる。"
        },
        {
          "kind": "click",
          "buttonText": "伝える"
        },
        {
          "kind": "change",
          "selector": "#plan-pinned",
          "checked": true
        },
        {
          "kind": "submit",
          "buttonText": "追加する"
        }
      ],
      "assert": {
        "planCount": 4,
        "addedPlanId": "4",
        "addedPlanTitle": "ローンチの流れを見直す",
        "addedPlanTrack": "伝える",
        "addedPlanPinned": true,
        "status": "「ローンチの流れを見直す」を追加しました。"
      }
    },
    {
      "id": "item-add",
      "actions": [],
      "assert": {
        "planCount": 4,
        "addedPlanId": "4",
        "addedPlanTitle": "ローンチの流れを見直す",
        "addedPlanTrack": "伝える",
        "addedPlanPinned": true
      }
    },
    {
      "id": "inline-edit",
      "actions": [
        {
          "kind": "input",
          "selector": "#plan-4",
          "value": "ローンチの流れを見直すメモ"
        }
      ],
      "assert": {
        "planId": "4",
        "title": "ローンチの流れを見直すメモ",
        "status": "カードの名前を直しました。"
      }
    },
    {
      "id": "complete",
      "actions": [
        {
          "kind": "click",
          "cardId": "4",
          "buttonText": "完了にする"
        }
      ],
      "assert": {
        "planId": "4",
        "buttonText": "未完了に戻す",
        "status": "完了の印を切り替えました。"
      }
    },
    {
      "id": "pin",
      "actions": [
        {
          "kind": "click",
          "cardId": "2",
          "buttonText": "ピン留めする"
        }
      ],
      "assert": {
        "planId": "2",
        "buttonText": "ピンを外す",
        "status": "ピン留めを切り替えました。"
      }
    },
    {
      "id": "remove",
      "actions": [
        {
          "kind": "remove",
          "cardId": "4",
          "buttonText": "削除"
        }
      ],
      "assert": {
        "planCount": 3,
        "removedPlanId": "4",
        "status": "カードを一枚削除しました。"
      }
    },
    {
      "id": "filter-done",
      "actions": [
        {
          "kind": "filter",
          "buttonText": "完了"
        }
      ],
      "assert": {
        "planCount": 1,
        "summary": "完了: 1 件 ・ 完了 1 / 3",
        "status": "表示を切り替えました。"
      }
    },
    {
      "id": "keyboard-arrow-right",
      "actions": [
        {
          "kind": "keyboard",
          "filter": "完了",
          "key": "ArrowRight"
        }
      ],
      "assert": {
        "planCount": 3,
        "summary": "すべて: 3 件 ・ 完了 1 / 3",
        "status": "表示を切り替えました。"
      }
    },
    {
      "id": "keyboard-end",
      "actions": [
        {
          "kind": "keyboard",
          "filter": "すべて",
          "key": "End"
        }
      ],
      "assert": {
        "planCount": 1,
        "summary": "完了: 1 件 ・ 完了 1 / 3",
        "status": "表示を切り替えました。"
      }
    },
    {
      "id": "pointer",
      "actions": [
        {
          "kind": "pointer",
          "selector": "article p",
          "pointerType": "touch"
        }
      ],
      "assert": {
        "status": "カードの説明をポインターで見ています。"
      }
    },
    {
      "id": "clear-completed",
      "actions": [
        {
          "kind": "clear",
          "buttonText": "完了したカードを片付ける"
        }
      ],
      "assert": {
        "planCount": 2,
        "summary": "すべて: 2 件 ・ 完了 0 / 2",
        "status": "完了したカードを片付けました。"
      }
    },
    {
      "id": "empty-state",
      "actions": [
        {
          "kind": "remove",
          "buttonText": "削除",
          "repeat": 2
        }
      ],
      "assert": {
        "planCount": 0,
        "summary": "すべて: 0 件 ・ 完了 0 / 0",
        "status": "カードを一枚削除しました。",
        "emptyHeading": "計画はすべて片付きました。"
      }
    }
  ]
}
