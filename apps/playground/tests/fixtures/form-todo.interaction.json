    "workspaceHash": "sha256:3ca416d5bf7baa57ae5db8fb55b36046938fe64abeabbf4c849d615bd93d4a51"
  },
  "runner": {
    "kind": "browser-use",
    "url": "http://127.0.0.1:4173/",
    "previewSelector": "#html-preview",
    "recordedAt": "2026-11-19",
    "note": "Playground Preview で座席指定チケット予約（form-todo）を実行し、座席選択・フィルター・一括バリデーション・電子チケット発券・空状態を観測した。"
  },
  "requiredOperations": [
    "filter",
    "auto-pick",
    "invalid-submit",
    "valid-submit",
    "clear",
    "empty-state"
  ],
  "viewports": [
    {
      "id": "desktop",
      "previewWidth": 538,
      "previewHeight": 966,
      "browserViewport": "1710x1112",
      "horizontalOverflow": false,
      "surfaces": ["code-editor", "preview"],
      "artifact": "docs/reviews/issue-188/visual/desktop-initial.png"
    },
    {
      "id": "iphone-13",
      "previewWidth": 390,
      "previewHeight": 844,
      "browserViewport": "1710x1112",
      "horizontalOverflow": false,
      "surfaces": ["code-editor", "preview"],
      "artifact": "docs/reviews/issue-188/visual/iphone-390-initial.png"
    },
    {
      "id": "small-android",
      "previewWidth": 360,
      "previewHeight": 800,
      "browserViewport": "1710x1112",
      "horizontalOverflow": false,
      "surfaces": ["code-editor", "preview"],
      "artifacts": [
        "docs/reviews/issue-188/visual/android-360-initial.png",
        "docs/reviews/issue-188/visual/android-360-populated.png",
        "docs/reviews/issue-188/visual/android-360-empty.png"
      ]
    }
  ],
  "steps": [
    {
      "id": "initial",
      "actions": [],
      "assert": {
        "selectedSeats": ["B5", "B6"],
        "subtotalYen": 24000,
        "heading": "秋夜の室内楽特別公演 — 弦楽四重奏の夕べ"
      }
    },
    {
      "id": "filter-tier",
      "actions": [{ "kind": "filter", "buttonText": "S席 12,000円" }],
      "assert": {
        "activeFilter": "S席",
        "selectedSeats": ["B5", "B6"]
      }
    },
    {
      "id": "auto-pick",
      "actions": [
        { "kind": "click", "buttonText": "すべて" },
        { "kind": "click", "buttonText": "2 連番でおすすめ席を選ぶ" }
      ],
      "assert": {
        "contiguousPair": true,
        "crossesCenterAisle": false
      }
    },
    {
      "id": "invalid-submit",
      "actions": [
        { "kind": "click", "selector": "#proceed-checkout" },
        { "kind": "submit", "selector": "#submit-booking" }
      ],
      "assert": {
        "alert": "入力内容を確認してください（4 件の未入力・不備）"
      }
    },
    {
      "id": "valid-submit",
      "actions": [
        { "kind": "input", "selector": "#buyer-name", "value": "佐藤 葵" },
        {
          "kind": "input",
          "selector": "#buyer-email",
          "value": "aoi@example.com"
        },
        {
          "kind": "input",
          "selector": "#buyer-phone",
          "value": "090-1234-5678"
        },
        { "kind": "change", "selector": "#accept-terms", "checked": true },
        { "kind": "submit", "selector": "#submit-booking" }
      ],
      "assert": {
        "ticketIssued": true,
        "ticketHeading": "ご予約が確定しました",
        "barcodeRendered": true
      }
    },
    {
      "id": "clear-selection",
      "actions": [
        { "kind": "click", "buttonText": "別の席を新しく予約する" },
        { "kind": "clear", "buttonText": "選択をクリア" }
      ],
      "assert": {
        "selectedCount": 0
      }
    },
    {
      "id": "empty-state",
      "actions": [],
      "assert": {
        "selectedCount": 0,
        "emptyMessage": "左の座席マップからご希望の席をクリックするか、上の連番自動選択ボタンをお試しください。",
        "proceedDisabled": true
      }
    }
  ]
}
