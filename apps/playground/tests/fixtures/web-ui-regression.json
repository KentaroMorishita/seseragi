{
  "schema": 1,
  "runner": {
    "kind": "playwright",
    "browser": "chromium",
    "baseUrl": "http://127.0.0.1:4173",
    "artifactRoot": "test-results/web-ui-review"
  },
  "viewports": [
    {
      "id": "desktop",
      "width": 1440,
      "height": 1000
    },
    {
      "id": "landscape-568",
      "width": 568,
      "height": 320
    },
    {
      "id": "iphone-390",
      "width": 390,
      "height": 844
    },
    {
      "id": "android-360",
      "width": 360,
      "height": 800
    },
    {
      "id": "minimum-320",
      "width": 320,
      "height": 700
    }
  ],
  "samples": [
    {
      "id": "html-components",
      "pickerLabel": "読書メモのカードを HTML の部品で組み立てる",
      "heading": "三冊の本",
      "architecture": "static",
      "requiredSurfaces": ["sample-picker", "code", "preview"],
      "requiredStates": ["initial"]
    },
    {
      "id": "interactive-app",
      "pickerLabel": "散歩コースを Signal で切り替える",
      "heading": "木陰の周回コースを歩く",
      "architecture": "signal-run",
      "requiredSurfaces": ["sample-picker", "code", "preview"],
      "requiredStates": ["initial", "riverside-route"]
    },
    {
      "id": "feature-composition",
      "pickerLabel": "Signal + dom.runでfeatureを合成",
      "heading": "Compose the release rhythm.",
      "architecture": "signal-run",
      "requiredSurfaces": ["sample-picker", "code", "preview"],
      "requiredStates": ["initial", "hidden-feature", "image-fallback"]
    },
    {
      "id": "form-todo",
      "pickerLabel": "座席指定チケット予約（コンサートホール）",
      "heading": "秋夜の室内楽特別公演 — 弦楽四重奏の夕べ",
      "architecture": "signal-run",
      "requiredSurfaces": ["sample-picker", "code", "preview"],
      "requiredStates": [
        "initial",
        "invalid-submit",
        "valid-submit",
        "empty"
      ]
    },
    {
      "id": "project-flow-app",
      "pickerLabel": "Release Room — multi-module Signal Showcase",
      "heading": "Make room for the next release.",
      "architecture": "multi-module",
      "requiredSurfaces": [
        "sample-picker",
        "explorer",
        "tabs",
        "code",
        "preview"
      ],
      "requiredStates": [
        "initial",
        "invalid-submit",
        "day-studio",
        "empty-disabled",
        "image-fallback"
      ]
    },
    {
      "id": "web-starter",
      "pickerLabel": "最初の Web プロジェクト（seseragi new web）",
      "heading": "Hello from Seseragi",
      "architecture": "multi-module",
      "requiredSurfaces": [
        "sample-picker",
        "explorer",
        "tabs",
        "code",
        "preview"
      ],
      "requiredStates": ["initial", "incremented"]
    },
    {
      "id": "seseragi-landing-page",
      "pickerLabel": "Seseragi Landing Page Showcase",
      "heading": "Code that",
      "architecture": "multi-module",
      "requiredSurfaces": [
        "sample-picker",
        "explorer",
        "tabs",
        "code",
        "preview"
      ],
      "requiredStates": ["initial", "composable", "alive", "image-fallback"]
    }
  ]
}
