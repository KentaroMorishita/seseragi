      "requiredSurfaces": [
        "sample-picker",
        "explorer",
        "tabs",
        "code",
        "preview"
      ],
      "requiredStates": [
        "initial",
        "invalid-submit",
        "day-studio",
        "empty-disabled",
        "image-fallback"
      ]
    },
    {
      "id": "seseragi-landing-page",
      "pickerLabel": "Seseragi Landing Page Showcase",
      "heading": "Code that",
      "architecture": "multi-module",
      "requiredSurfaces": [
        "sample-picker",
        "explorer",
        "tabs",
        "code",
        "preview"
      ],
      "requiredStates": ["initial", "composable", "alive", "image-fallback"]
    }
