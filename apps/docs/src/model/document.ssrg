import * as json from "std/json"

pub struct DocInline deriving JsonDecode {
  kind: String,
  text: String,
  href: String
}

pub struct DocBlock deriving JsonDecode {
  kind: String,
  inlines: Array<DocInline>,
  level: Int,
  ordered: Bool,
  items: Array<Array<DocInline>>,
  title: String,
  text: String,
  source: String,
  language: String,
  reference: String,
  referenceName: String,
  referenceKind: String,
  referenceNamespace: String,
  referenceSignature: String,
  referenceDescription: String,
  sha256: String
}

pub struct SourceProvenance deriving JsonDecode {
  path: String,
  section: String,
  sha256: String
}

pub struct PageMetadata deriving JsonDecode {
  schema: Int,
  id: String,
  locale: String,
  route: String,
  kind: String,
  title: String,
  summary: String,
  availability: String,
  spec: Array<String>,
  examples: Array<String>,
  prerequisites: Array<String>,
  related: Array<String>,
  next: String,
  referenceIdentities: Array<String>
}

pub struct DocPage deriving JsonDecode {
  sourcePath: String,
  metadata: PageMetadata,
  documentTitle: String,
  spec: Array<SourceProvenance>,
  blocks: Array<DocBlock>
}

pub struct DocCorpus deriving JsonDecode {
  schema: Int,
  defaultLocale: String,
  locales: Array<String>,
  pages: Array<DocPage>
}

pub fn decodeCorpus encoded: String -> Either<json.JsonReadError, DocCorpus> =
  json.decodeString encoded
