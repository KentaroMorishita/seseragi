import * as paths from "std/path"

fn describe text: String -> String = match paths.parse text {
  Left error -> show error
  Right path -> paths.render path
}

fn segment name: String -> String = match paths.parse "reports" {
  Left error -> show error
  Right base -> match paths.child name base {
    Left error -> show error
    Right path -> paths.render path
  }
}

pub effect fn main = do {
  _ <- println (describe "reports/../report.txt")
  _ <- println (describe "/reports/report.txt")
  _ <- println (describe "C:/reports/report.txt")
  _ <- println (describe "//server/share/report.txt")
  _ <- println (describe "a\0b")
  _ <- println (describe "C:report.txt")
  _ <- println (describe "//server")
  _ <- println (segment "a/b")
  _ <- println (segment "a\\b")
  println (segment "a\0b")
}
