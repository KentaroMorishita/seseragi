import * as bytes from "std/bytes"

fn describe content: bytes.Bytes -> String =
  if bytes.isEmpty content then "Empty" else `Bytes: ${show (bytes.toInts content)}`
pub effect fn main = do {
  println (describe (bytes.empty ()))
  match bytes.byte 65 {
    Left error -> println (show error)
    Right checked -> println (describe (bytes.singleton checked))
  }
}
