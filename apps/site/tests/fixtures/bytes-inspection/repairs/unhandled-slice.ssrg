import * as bytes from "std/bytes"

fn extract start: Int -> end: Int -> content: bytes.Bytes -> String =
  match bytes.slice start end content {
    Left (bytes.InvalidByteRange { start, end, length }) -> `Invalid range ${start}..${end} for ${length} bytes`
    Right part -> show (bytes.toInts part)
  }
pub effect fn main = match bytes.fromInts [10, 20, 30, 40] {
  Left error -> println (show error)
  Right content -> do {
    println (extract 1 3 content)
    println (extract 2 2 content)
    println (extract 3 1 content)
    println (extract (-1) 2 content)
    println (extract 0 5 content)
    println (show (bytes.toInts content))
  }
}
