import * as bytes from "std/bytes"

fn byteResult value: Int -> String = match bytes.byte value {
  Left (bytes.ByteOutOfRange invalid) -> `left:${invalid}`
  Right checked -> `right:${bytes.toInt checked}`
}
fn getResult index: Int -> content: bytes.Bytes -> String =
  match bytes.get index content {
    Nothing -> "nothing"
    Just value -> `just:${bytes.toInt value}`
  }
fn sliceResult start: Int -> end: Int -> content: bytes.Bytes -> String =
  match bytes.slice start end content {
    Left (bytes.InvalidByteRange { start, end, length }) -> `left:${start},${end},${length}`
    Right part -> `right:${show (bytes.toInts part)}`
  }
fn reason error: bytes.BytesSliceError -> String = match error {
  bytes.InvalidByteRange { start, end, length } -> `${start},${end},${length}`
}
pub effect fn main = do {
  for value <- [0, 255, -1, 256, 65] {
    println (`byte|${value}|${byteResult value}`)
  }
  match (bytes.fromInts [0, 15, 255], bytes.fromInts [30, 40]) {
    (Right content, Right suffix) -> do {
      for index <- [0, 2, 3, -1] {
        println (`get|${index}|${getResult index content}`)
      }
      println (`get-empty|${getResult 0 (bytes.empty ())}`)
      for (start, end) <- [
        (0, 3),
        (1, 2),
        (0, 0),
        (3, 3),
        (1, 1),
        (2, 1),
        (-1, 1),
        (0, 4),
        (4, 4),
        (0, -1)
      ] {
        println (`slice|${start},${end}|${sliceResult start end content}`)
      }
      println (`slice-empty|${sliceResult 0 0 (bytes.empty ())}`)
      println (`append|${show (bytes.toInts (bytes.append suffix content))}`)
      println (`append-swapped|${show (bytes.toInts (bytes.append content suffix))}`)
      println (`append-empty-suffix|${show (bytes.toInts (bytes.append (bytes.empty ()) content))}`)
      println (`append-empty-content|${show (bytes.toInts (bytes.append suffix (bytes.empty ())))}`)
      println (`concat|${show (bytes.toInts (bytes.concat [bytes.empty (), content, bytes.empty (), suffix, bytes.empty ()]))}`)
      println (`concat-empty|${show (bytes.toInts (bytes.concat []))}`)
      println (`concat-all-empty|${show (bytes.toInts (bytes.concat [bytes.empty (), bytes.empty ()]))}`)
      println (`content-after|${show (bytes.toInts content)}`)
      println (`suffix-after|${show (bytes.toInts suffix)}`)
    }
    _ -> println "Unexpected invalid fixture"
  }
  println (`constructed-valid-range-reason|${reason (bytes.InvalidByteRange { start: 0, end: 1, length: 3 })}`)
}
