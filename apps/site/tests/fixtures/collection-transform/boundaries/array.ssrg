import * as items from "std/array"
import * as other from "std/list"
import * as json from "std/json"
import * as ints from "std/int"

fn display values: Array<Int> -> String = json.encodeString [n | n <- values]
fn nested values: Array<Array<Int>> -> String =
  json.encodeString [[n | n <- group] | group <- values]
fn wrap n: Int -> Array<Array<Int>> = [[n], [n + 10]]
fn parse value: String -> Maybe<Int> = match ints.parse value {
  Right n -> Just n
  Left _ -> Nothing
}
fn describe value: Maybe<Array<Int>> -> String = match value {
  Nothing -> "missing"
  Just values -> "present: " + display values
}

let empty = items.empty<Int> ()
let source = [1, 2, 3]
let batches = [[[1], [2]], [], [[3]]]
let words = ["bad", "2", "", "0", "3", "bad"]

pub effect fn main = do {
  _ <- println (display (items.append [4, 5] source))
  _ <- println (display (items.append source [4, 5]))
  _ <- println (display (items.append empty source))
  _ <- println (display (items.append source empty))
  _ <- println (nested (items.concat batches))
  _ <- println (display (items.concat (items.empty<Array<Int>> ())))
  _ <- println (nested (items.flatMap wrap [1, 2]))
  _ <- println (nested (items.flatMap wrap empty))
  _ <- println (display (items.filterMap parse words))
  _ <- println (display (items.filterMap parse ["bad", ""]))
  _ <- println (display (items.filterMap parse (items.empty<String> ())))
  _ <- println (display (items.reverse source))
  _ <- println (display (items.reverse empty))
  _ <- println (display (items.reverse [1]))
  _ <- println (describe (items.tail empty))
  _ <- println (describe (items.tail [1]))
  _ <- println (describe (items.tail source))
  _ <- println (display (other.toArray (items.toList source)))
  _ <- println (display (other.toArray (items.toList empty)))
  _ <- println (display source)
  _ <- println (json.encodeString [[[n | n <- group] | group <- batch] | batch <- batches])
  println (json.encodeString [word | word <- words])
}
