import * as json from "std/json"
import * as items from "std/list"
import * as ints from "std/int"
pub fn valid -> List<Int> = items.filterMap parseCount `["2"]

fn parseCount value: String -> Maybe<Int> = match ints.parse value {
  Right count -> Just count
  Left _ -> Nothing
}

pub effect fn main = println (json.encodeString [n | n <- (valid ())])
