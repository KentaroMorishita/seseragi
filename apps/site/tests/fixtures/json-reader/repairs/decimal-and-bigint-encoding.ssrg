import * as json from "std/json"
import * as decimal from "std/decimal"
import * as bigints from "std/big-int"
fn encodeDecimal source: String -> String = match decimal.parse source {
  Left _ -> "invalid decimal"
  Right value -> json.encodeString value
}
pub effect fn main -> Unit with Console fails ConsoleError = do {
  _ <- println (encodeDecimal "1.25")
  println (json.encodeString (bigints.format (bigints.fromInt 42)))
}
