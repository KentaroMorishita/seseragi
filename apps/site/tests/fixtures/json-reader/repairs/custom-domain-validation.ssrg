import * as json from "std/json"
struct Settings deriving JsonDecode { retries: Int }
fn readSettings source: String -> Either<json.JsonReadError, Settings> =
  json.decodeString source
fn checkRetries settings: Settings -> Either<String, Settings> =
  if settings.retries < 0 then Left "retries must be nonnegative" else Right settings
fn report source: String -> String = match readSettings source {
  Left _ -> "shape rejected"
  Right settings -> match checkRetries settings {
    Left reason -> reason
    Right accepted -> "accepted: " + show accepted.retries
  }
}
pub effect fn main -> Unit with Console fails ConsoleError = do {
  _ <- println (report "{\"retries\":2}")
  _ <- println (report "{\"retries\":-1}")
  println (report "{\"retries\":false}")
}
