import * as effects from "std/effect"
fn divide divisor: Int -> Int = 7 / divisor
fn risky -> Effect<{}, String, Int> = effects.defer (\_ -> effects.succeed (divide 0))
fn outputFailure problem: ConsoleError -> String = "output failed"
pub effect fn main = do {
  _ <- effects.mapError outputFailure (println "Before execution")
  _ <- effects.mapError (\reason -> "mapped: " + reason) (risky ())
  effects.mapError outputFailure (println "After execution")
}
