import * as effects from "std/effect"
fn describe result: Either<String, Int> -> String = match result {
  Right value -> "Ready: " + show value
  Left reason -> "Rejected: " + reason
}
pub effect fn main = do {
  accepted <- effects.attempt (effects.succeed 42)
  rejected <- effects.attempt (effects.fail "not approved")
  _ <- println (describe accepted)
  println (describe rejected)
}
