import * as effects from "std/effect"

fn describe result: Either<String, Int> -> String = match result {
  Right value -> "Ready: " + show value
  Left reason -> "Rejected: " + reason
}

effect fn accepted -> Int fails String = effects.succeed 42

effect fn rejected -> Int fails String = effects.fail "not approved"

pub effect fn main = do {
  acceptedResult <- effects.attempt (accepted ())
  rejectedResult <- effects.attempt (rejected ())
  _ <- println (describe acceptedResult)
  _ <- println (describe rejectedResult)
  println "Caller continues"
}
