import * as items from "std/list"
import * as json from "std/json"
fn integer value: Maybe<Int> -> String = match value {
  Just found -> "present:" + json.encodeString found
  Nothing -> "missing"
}
fn boolean value: Maybe<Bool> -> String = match value {
  Just found -> "present:" + json.encodeString found
  Nothing -> "missing"
}
fn text value: Maybe<String> -> String = match value {
  Just found -> "present:" + json.encodeString found
  Nothing -> "missing"
}
pub effect fn main = do {
  _ <- println (integer (items.get 0 (`[0])))
  _ <- println (boolean (items.get 0 (`[False])))
  _ <- println (text (items.get 0 (`[""])))
  _ <- println (integer (items.head (`[0])))
  _ <- println (boolean (items.head (`[False])))
  _ <- println (text (items.head (`[""])))
  _ <- println (integer (items.find (\value -> value == 0) (`[1, 0, 0])))
  _ <- println (boolean (items.find (\value -> value == False) (`[True, False, False])))
  _ <- println (text (items.find (\value -> value == "") (`["x", "", ""])))
  _ <- println (
    json.encodeString
      [value | value <- items.filter (\value -> value == 0) (`[
        1,
        0,
        0
      ])]
  )
  _ <- println (
    json.encodeString
      [value | value <- items.filter (\value -> value == False) (`[
        True,
        False,
        False
      ])]
  )
  println (
    json.encodeString
      [value | value <- items.filter (\value -> value == "") (`[
        "x",
        "",
        ""
      ])]
  )
}
