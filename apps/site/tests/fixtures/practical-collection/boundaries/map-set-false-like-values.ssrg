import * as maps from "std/map"
import * as sets from "std/set"
import * as json from "std/json"
fn keepZero key: String -> value: Int -> Bool = key == "zero" && value == 0
fn keepFalse key: String -> value: Bool -> Bool = key == "flag" && value == False
fn keepBlank key: String -> value: String -> Bool = key == "" && value == ""
pub effect fn main = do {
  _ <- println (
    json.encodeString
      (maps.entries (maps.filter keepZero (maps.fromEntries [
        ("one", 1),
        ("zero", 0)
      ])))
  )
  _ <- println (
    json.encodeString
      (maps.entries (maps.filter keepFalse (maps.fromEntries [("flag", False)])))
  )
  _ <- println (
    json.encodeString
      (maps.entries (maps.filter keepBlank (maps.fromEntries [("", "")])))
  )
  _ <- println (
    json.encodeString
      (sets.toArray (sets.filter (\value -> value == 0) (sets.fromIterable [
        1,
        0
      ])))
  )
  _ <- println (
    json.encodeString (
      sets.toArray
        (sets.filter (\value -> value == False) (sets.fromIterable [
          True,
          False
        ]))
    )
  )
  println (
    json.encodeString
      (sets.toArray (sets.filter (\value -> value == "") (sets.fromIterable [
        "x",
        ""
      ])))
  )
}
