import * as maybe from "std/maybe"
import * as either from "std/either"
pub effect fn main = do {
  let values: List<Maybe<Int>> = `[Just 2, Just 1]
  let empty: List<Maybe<Int>> = `[]
  let errors: List<Either<String, Int>> = `[Right 2, Left "first", Left "second"]
  println (show (maybe.sequence values))
  println (show (maybe.sequence empty))
  println (show (either.sequence errors))
}
