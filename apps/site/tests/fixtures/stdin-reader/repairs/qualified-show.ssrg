import * as effects from "std/effect"
import * as stdin from "std/stdin"

pub effect fn main -> Unit with Console, stdin: stdin.Stdin fails ConsoleError = do {
  result <- effects.attempt (stdin.readLine ())
  match result {
    Right Nothing -> println "EOF"
    Right (Just "") -> println "Blank line"
    Right (Just text) -> println ("Line: " + text)
    Left (stdin.InvalidStdinUtf8 { offset }) -> println ("Invalid UTF-8 at byte " + show offset)
    Left (stdin.StdinLineTooLong { limitBytes }) -> println ("Line exceeds " + show limitBytes + " bytes")
    Left _ -> println "Input failed"
  }
}
