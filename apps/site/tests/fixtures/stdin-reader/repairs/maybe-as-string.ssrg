import * as effects from "std/effect"

pub effect fn main -> Unit with Console, Stdin fails ConsoleError = do {
  result <- effects.attempt (readLine ())
  match result {
    Right Nothing -> println "EOF"
    Right (Just "") -> println "Blank line"
    Right (Just text) -> println ("Line: " + text)
    Left reason -> println ("Input failed: " + show reason)
  }
}
