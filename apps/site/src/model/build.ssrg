import * as json from "std/json"

pub struct HighlightPart deriving JsonDecode { text: String, className: String }

pub struct ReferenceReading deriving JsonDecode { en: String, ja: String }

pub struct ExampleSource deriving JsonDecode {
  id: String,
  sourcePath: String,
  source: String,
  sha256: String,
  playgroundUrl: String,
  highlighted: Array<HighlightPart>
}

pub struct ReferenceSymbol deriving JsonDecode {
  identity: String,
  name: String,
  module: String,
  category: String,
  namespace: String,
  itemKind: String,
  signature: String,
  description: String,
  descriptionJa: String,
  reading: ReferenceReading,
  typeParameters: Array<String>,
  constraints: Array<String>,
  instanceClass: String,
  instanceHead: String,
  highlighted: Array<HighlightPart>
}

pub struct ReferenceModule deriving JsonDecode {
  specifier: String,
  availability: String,
  targets: Array<String>,
  items: Array<ReferenceSymbol>
}

pub struct BuildInput deriving JsonDecode {
  schema: Int,
  origin: String,
  playgroundUrl: String,
  tourUrl: String,
  grammar: String,
  examples: Array<ExampleSource>,
  referenceModules: Array<ReferenceModule>
}

pub fn decodeBuildInput encoded: String -> Either<json.JsonReadError, BuildInput> =
  json.decodeString encoded
