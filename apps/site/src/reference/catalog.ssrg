import * as arrays from "std/array"
import * as text from "std/text"
import { ReferenceModule, ReferenceSymbol } from "../model/build"
import { LocalizedText, localized } from "../model/locale"
import { modulePurpose } from "./module-copy"
import { itemKindLabel } from "./labels"
import { instanceSummary } from "./instance-copy"
import { editorialFor, moduleEditorial } from "./editorial/catalog"
import { Editorial, editorialBlocks } from "./editorial/model"
import {
  ApiReference,
  Block,
  BulletList,
  Heading,
  InternalLink,
  NestedSection,
  NavigationGroup,
  NavigationSection,
  PageDefinition,
  Paragraph,
  Reference,
  Words
} from "../model/page"

fn moduleRoute specifier: String -> String =
  "/docs/library/" + text.replace "std/" "" specifier + "/"

fn operatorSlug name: String -> Maybe<String> = match name {
  "-" -> Just "subtract"
  ":" -> Just "cons"
  "!=" -> Just "not-equal"
  "??" -> Just "coalesce"
  "*" -> Just "multiply"
  "**" -> Just "power"
  "/" -> Just "divide"
  "%" -> Just "remainder"
  "+" -> Just "add"
  "<" -> Just "less-than"
  "<*>" -> Just "apply-operator"
  "<=" -> Just "less-than-or-equal"
  "<$>" -> Just "map-operator"
  "==" -> Just "equal"
  ">" -> Just "greater-than"
  ">=" -> Just "greater-than-or-equal"
  ">>=" -> Just "bind-operator"
  _ -> Nothing
}

fn referenceSlug symbol: ReferenceSymbol -> String = {
  if symbol.itemKind == "instance" then
    symbol.name
    |> text.toLower
    |> text.replaceAll "..." "values"
    |> text.replaceAll "<" "-"
    |> text.replaceAll ">" ""
    |> text.replaceAll ", " "-"
    |> text.replaceAll "," "-"
    |> text.replaceAll " " "-"
    |> text.replaceAll "." "-"
    |> text.replaceAll "/" "-"
    |> text.replaceAll "(" ""
    |> text.replaceAll ")" ""
  else
    match operatorSlug symbol.name {
    Just slug -> slug
    Nothing ->
      if symbol.identity == "std/prelude::Reducible::reduce" then
        "reducible-reduce"
      else
        symbol.name
        |> text.toLower
        |> text.replaceAll "_" "-"
  }
}

pub fn referenceRoute symbol: ReferenceSymbol -> String =
  moduleRoute symbol.module + symbol.itemKind + "/" + referenceSlug symbol + "/"

fn referenceLabel symbol: ReferenceSymbol -> LocalizedText = {
  let kind = itemKindLabel symbol.itemKind
  localized (symbol.name + " · " + kind.en) (symbol.name + " · " + kind.ja)
}

pub fn referenceSummary symbol: ReferenceSymbol -> LocalizedText =
  match editorialFor symbol {
    Just editorial -> editorial.summary
    Nothing ->
      if symbol.itemKind != "instance" then
        localized symbol.descriptionEn symbol.descriptionJa
      else
        instanceSummary symbol
  }

fn symbolPage symbol: ReferenceSymbol -> PageDefinition = PageDefinition {
  id: "reference.symbol." + symbol.identity + "." + symbol.namespace + "." + symbol.itemKind,
  path: referenceRoute symbol,
  kind: Reference,
  title: localized symbol.name symbol.name,
  summary: referenceSummary symbol,
  blocks: arrays.concat [
    editorialBlocks (editorialFor symbol),
    [
      ApiReference (symbol.identity, symbol.namespace, symbol.itemKind),
      Heading ("related", localized "Related documentation" "関連ドキュメント"),
      Paragraph (
        [
          Words (
            localized
              "Browse the owning module for related public symbols, or consult the language reference for syntax and typing rules."
              "関連する公開シンボルは所属するモジュール、構文や型付けの規則は言語リファレンスで確認できます。"
          ),
          InternalLink (
            localized (" " + symbol.module) (" " + symbol.module),
            moduleRoute symbol.module
          ),
          InternalLink (localized " Language Reference" " 言語リファレンス", "/docs/language/")
        ]
      )
    ]
  ]
}

fn modulePage value: ReferenceModule -> PageDefinition = PageDefinition {
  id: "reference.module." + value.specifier,
  path: moduleRoute value.specifier,
  kind: Reference,
  title: localized value.specifier value.specifier,
  summary: modulePurpose value.specifier,
  blocks: arrays.concat [
    moduleEditorial value.specifier,
    [
      Heading ("using-this-module", localized "Using this module" "このモジュールを使うには"),
      Paragraph (
        [Words (
          localized
            "Choose an operation below to see what it does, its argument order, and its result type. Functions take arguments separated by spaces. Types and constructors are listed separately from functions."
            "下の一覧から操作を選ぶと、役割・引数の順序・戻り値の型を確認できます。関数には空白で区切って引数を渡します。型や値を作るコンストラクターは、関数とは別の種類として表示しています。"
        )]
      ),
      Paragraph (
        [Words (
          localized
            (if value.specifier == "std/prelude" then
              "Prelude is available without an import."
            else
              "Import this module with: import * as api from \"" + value.specifier + "\". Call its functions as api.name argument.")
            (if value.specifier == "std/prelude" then
              "Preludeはimportを書かずに使えます。"
            else
              "import * as api from \"" + value.specifier + "\"で読み込みます。関数はapi.関数名 引数の形で呼びます。")
        )]
      ),
      Paragraph (
        [Words (
          localized (
            "Availability: " + value.availability + ". Targets: " + join ", " value.targets + "."
          ) (
            "利用方法: " + (if value.availability == "implicit" then
              "importなしで使えます"
            else
              "importして使います") + "。対象: " + join ", " value.targets + "。"
          )
        )]
      ),
      Heading ("public-api", localized "Public API" "公開API"),
      BulletList (
        [[InternalLink (referenceLabel symbol, referenceRoute symbol)] | symbol <- value.items]
      )
    ]
  ]
}

fn moduleSection value: ReferenceModule -> NavigationSection = NavigationSection {
  id: value.specifier,
  title: localized value.specifier value.specifier,
  kind: NestedSection,
  overview: modulePage value,
  pages: [symbolPage symbol | symbol <- value.items]
}

fn moduleMatches specifier: String -> value: ReferenceModule -> Bool =
  specifier == value.specifier

fn sectionsFor specifier: String
  -> modules: Array<ReferenceModule>
  -> Array<NavigationSection> =
  [moduleSection value | value <- arrays.filter (moduleMatches specifier) modules]

fn group id: String
  -> title: String
  -> japanese: String
  -> specifiers: Array<String>
  -> modules: Array<ReferenceModule>
  -> NavigationGroup =
  NavigationGroup {
    id,
    title: localized title japanese,
    sections: arrays.concat [sectionsFor specifier modules | specifier <- specifiers]
  }

pub fn referenceGroups modules: Array<ReferenceModule> -> Array<NavigationGroup> = [
  group "prelude" "Prelude" "Prelude" ["std/prelude"] modules,
  group "data-validation" "Data and validation" "データと検証" [
    "std/maybe",
    "std/either",
    "std/validation",
    "std/transformer/maybe",
    "std/transformer/either",
    "std/transformer/reader",
    "std/transformer/state",
    "std/transformer/writer"
  ] modules,
  group "collections" "Collections" "コレクション" [
    "std/collection",
    "std/array",
    "std/list",
    "std/non-empty-list",
    "std/map",
    "std/set",
    "std/iterator"
  ] modules,
  group "text" "Text" "文字列" [
    "std/text",
    "std/regex",
    "std/text/grapheme",
    "std/text/unicode",
    "std/char"
  ] modules,
  group "numbers-bytes" "Numbers and bytes" "数値とバイト" [
    "std/number",
    "std/int",
    "std/float",
    "std/math",
    "std/big-int",
    "std/decimal",
    "std/bytes",
    "std/bytes/hex",
    "std/bytes/base64"
  ] modules,
  group "data-formats" "Data formats" "データ形式" ["std/json"] modules,
  group "time-randomness" "Time and randomness" "時刻と乱数" [
    "std/time",
    "std/clock",
    "std/random",
    "std/entropy"
  ] modules,
  group "effects-concurrency" "Effects and concurrency" "Effectと並行処理" [
    "std/effect",
    "std/ref",
    "std/deferred",
    "std/queue",
    "std/semaphore"
  ] modules,
  group "streams-signals" "Streams and signals" "StreamとSignal" [
    "std/stream",
    "std/signal"
  ] modules,
  group "system" "System capabilities" "システムの能力" [
    "std/console",
    "std/log",
    "std/stdin",
    "std/fs",
    "std/path",
    "std/process",
    "std/child-process"
  ] modules,
  group "network-browser" "Networking and browser" "ネットワークとブラウザー" [
    "std/http",
    "std/http/server",
    "std/http/multipart",
    "std/sse",
    "std/websocket",
    "std/websocket/server",
    "std/web/file",
    "std/web/navigation",
    "std/web/storage",
    "std/web/html",
    "std/web/svg",
    "std/web/dom"
  ] modules,
  group "testing" "Testing and measurement" "テストと計測" ["std/test", "std/benchmark"]
    modules
]
