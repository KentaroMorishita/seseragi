import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "先頭から条件を満たす部分だけを残す",
  purpose: "先頭に続く小さな値だけを取り出すならtakeWhileを使います。最初の引数は各要素を調べてBoolを返す関数、次の引数は配列です。Falseになった要素の手前で止まります。",
  reading: "isSmallはvalueという整数を受け取り、value < 3の真偽値を返します。最初の例は1と2を残し、4で止まるので[1, 2]になります。4の後にある1は結果に入りません。",
  boundaries: "先頭の4が条件を満たさない2行目は[]です。全要素が条件を満たす3行目は[1, 2]です。arrays.empty<Int> ()で作る整数の空配列は、そのまま空の結果になります。",
  rules: "先頭から判定し、最初のFalseが決まった時点で後の要素は判定しません。元の配列を変更せず、残す要素を新しい配列にします。判定した要素と結果の大きさに応じた処理を行います。",
  mistake: "全体から条件を満たす要素を集めるfilterとは違います。この例で後ろの1も欲しいならfilterを使います。条件を満たす先頭部分を捨て、残りが欲しいならdropWhileです。",
}
