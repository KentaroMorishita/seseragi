import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Keep only the matching prefix",
  purpose: "Use takeWhile to keep a leading run of small values. Its first argument is a function returning Bool for each element; the second is the array. It stops before the first element producing False.",
  reading: "isSmall takes an integer named value and returns whether value < 3. The first call keeps 1 and 2, stops at 4, and returns [1, 2]. The later 1 is not included.",
  boundaries: "The second call returns [] because the first 4 fails the condition. The third keeps all of [1, 2]. arrays.empty<Int> () creates an empty integer array and produces an empty result.",
  rules: "Predicates run from the start and stop at the first False without testing later elements. The source is unchanged and the retained elements form a new array. Work depends on the tested prefix and the result size.",
  mistake: "Unlike filter, this does not collect matching values throughout the array. Use filter to include the final 1 too. Use dropWhile to discard the matching prefix and keep the remainder.",
}
