import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Create a sorted array using the element type’s order",
  purpose: "Use sort numbers to sort integers in ascending order. It takes one array and returns a separate sorted array without rearranging the source.",
  reading: "numbers contains [30, 2, 10, 2]. The first output is [2, 2, 10, 30] in numeric order. The second println call prints the original [30, 2, 10, 2], demonstrating that it was not changed.",
  boundaries: "arrays.empty<Int> () creates an empty integer array. With no items to sort, the result is []. show converts an array into display text; println writes that text.",
  rules: "The element type needs Ord, the standard implementation for comparing two values. Int uses numeric order. Equal elements keep their input order. Sorting uses O(n log n) comparisons for n elements and leaves the source unchanged.",
  mistake: "Do not assume TypeScript Array.sort() default string comparison or in-place mutation. Use sortBy to order objects by a field such as score. sort does not accept an arbitrary two-argument comparison function.",
}
