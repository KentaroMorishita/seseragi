import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "値の標準の順序で並べた新しい配列を得る",
  purpose: "整数を小さい順に並べるならsort numbersを使います。渡すのは配列一つです。元の配列を並べ替えず、並べた結果を別の配列で受け取ります。",
  reading: "numbersには[30, 2, 10, 2]を入れています。最初の出力は整数の順序で並べた[2, 2, 10, 30]です。続くshow numbersは元の[30, 2, 10, 2]を表示し、変更されていないことを確かめます。",
  boundaries: "arrays.empty<Int> ()は整数の空配列です。並べる要素がないので結果も[]です。showは配列を表示用の文字列にし、printlnはその文字列を出力します。",
  rules: "要素の型にはOrd、つまり二つの値の順序を比較する標準の実装が必要です。Intでは数の大小を使います。等しいと判定した要素は入力順を保ちます。比較回数は要素数nに対してO(n log n)で、入力は変更しません。",
  mistake: "TypeScriptのArray.sort()の既定の文字列比較や、その場の変更を想定しないでください。オブジェクトのscoreなど、値から取り出した基準で並べるならsortByを使います。任意の二項比較関数をsortへ渡す形式ではありません。",
}
