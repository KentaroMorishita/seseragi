import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "同じ基準の値を、元の順序を保ってまとめる",
  purpose: "偶数と奇数を別々に取り出すように、同じ基準の要素をまとめるならgroupByを使います。最初の引数は各要素からキーを作る関数、次は配列です。結果のMapは、キーごとに要素の配列を持つ対応表です。",
  reading: "parityは整数を2で割った余りを返します。groupsは[3, 2, 5, 4, 7]を余りでまとめます。最初にキー1、その次に0が現れるのでmaps.keys groupsは[1, 0]です。mapsはstd/mapを読み込むときに付けた名前です。",
  boundaries: "maps.get 1 groupsはJust [3, 5, 7]、キー0ではJust [2, 4]です。getの戻り値Maybeは、キーが存在するときのJustと、ないときのNothingの二択です。利用するときはmatchでJust valuesとNothingを分けます。空入力ではグループがなく、maps.sizeは0を返します。",
  rules: "キーを作る関数は入力順に各要素一度だけ呼びます。キーは初出順、グループ内の要素も入力順を保ちます。キー型にはEqとHash、つまり同じキーかを調べる規則と検索に使うハッシュの実装が必要です。Intは両方を持ちます。適切なハッシュでは要素数に比例する処理が期待できます。元の配列は変えません。",
  mistake: "離れた場所にある要素も、キーが同じなら一つのグループへ集めます。サイズで区切りたいならchunksOf、基準順に並べたいならsortByです。存在しないキーを取り出す可能性があるので、getのNothingも扱ってください。",
}
