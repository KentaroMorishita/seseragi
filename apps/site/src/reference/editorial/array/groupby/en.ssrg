import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Group equal keys while preserving source order",
  purpose: "Use groupBy to collect items with the same key, such as separating odd and even numbers. Pass the key function first and the array second. The resulting Map associates each key with an array of its items.",
  reading: "parity returns the remainder after dividing an integer by two. groups classifies [3, 2, 5, 4, 7] by that remainder. Key 1 appears before key 0, so maps.keys groups is [1, 0]. maps is the name assigned to the std/map import.",
  boundaries: "maps.get 1 groups returns Just [3, 5, 7]; key 0 returns Just [2, 4]. get returns Maybe: Just when the key exists or Nothing when it does not. To use the value, match Just values and Nothing separately. Empty input creates no groups, so maps.size returns zero.",
  rules: "The key function runs once per element in source order. Keys keep first-occurrence order, and each group keeps source order. Key type K needs Eq and Hash: rules for key equality and a hash used for lookup. Int supplies both. With an appropriate hash, expected work is proportional to the input length. The original array is unchanged.",
  mistake: "Equal keys are collected even when their items were not adjacent. Use chunksOf for fixed-size batches or sortBy to order items by a key. Handle Nothing when looking up a key that may be absent.",
}
