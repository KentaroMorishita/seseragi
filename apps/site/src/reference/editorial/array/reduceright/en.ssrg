import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Combine an array from right to left",
  purpose: "Use reduceRight to combine elements starting at the end. Pass the initial result, the step function, and the array in that order. The step receives the current element first and the accumulated result second.",
  reading: "subtract value: Int -> total: Int -> Int takes two integers and returns value - total. Starting at zero over [1, 2, 3], the steps are 3 - 0 = 3, then 2 - 3 = -1, then 1 - (-1) = 2. That gives the first output.",
  boundaries: "The second input is the empty integer array arrays.empty<Int> (). It never calls subtract and returns the initial value 10 unchanged.",
  rules: "The step runs once per element, from last to first. The initial value and every step result have the same type B; element type A may differ. The array stays unchanged and the number of calls is proportional to its length.",
  mistake: "Do not copy the callback argument order from TypeScript reduceRight: here the element comes before the accumulator. The initial value is required. Supply a value that can also be returned for an empty array.",
}
