import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "末尾から計算して、一つの結果にまとめる",
  purpose: "配列を右から順にまとめるときにreduceRightを使います。初期値、計算する関数、配列の順に渡します。計算する関数には、今回の要素、これまでの計算結果の順で引数が渡ります。",
  reading: "subtract value: Int -> total: Int -> Intは二つの整数を受け取り、value - totalを返します。初期値0で[1, 2, 3]を右から処理すると、まず3 - 0 = 3、次に2 - 3 = -1、最後に1 - (-1) = 2です。これが最初の出力になります。",
  boundaries: "2行目の入力はarrays.empty<Int> ()で作る空配列です。subtractを一度も呼ばずに初期値10をそのまま返すため、出力は10です。",
  rules: "各要素につき計算関数を一度呼び、末尾から先頭へ進みます。初期値と各ステップの戻り値は同じ型Bです。要素の型AはBと違っていても構いません。配列は変えず、要素数に比例した回数の呼び出しを行います。",
  mistake: "TypeScriptのreduceRightのcallbackをそのまま写すと引数の順序を取り違えます。この関数ではelementが先、accumulatorが後です。初期値は省略できません。空配列でも返せる値を明示してください。",
}
