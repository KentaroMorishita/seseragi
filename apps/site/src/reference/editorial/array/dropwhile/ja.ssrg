import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "先頭から条件を満たす間だけ取り除く",
  purpose: "先頭に続く小さな値だけを読み飛ばすなら、dropWhileへ判定関数と配列を渡します。判定関数は一要素を受け取り、取り除くならTrue、そこで止めるならFalseを返します。",
  reading: "fn isSmall value: Int -> Boolは、整数valueを受け取って真偽値を返す関数の宣言です。value < 3を計算します。arrays.dropWhile isSmall [1, 2, 4, 1]は1と2を取り除き、4で止まるため[4, 1]を返します。最後の1は調べ直しません。",
  boundaries: "2行目は先頭の4で止まるので[4, 1]のままです。3行目はすべて条件を満たすため[]、4行目も空入力なので[]です。arrays.empty<Int> ()は要素が整数の空配列を作ります。",
  rules: "判定は先頭から進み、最初のFalseで止まります。それ以降の要素へ判定関数を呼びません。結果は元の順序を保った新しい配列で、元の配列は変わりません。結果のコピーを含め、入力と出力の大きさに応じた処理が必要です。",
  mistake: "配列全体から条件を満たす要素を取り除く操作とは違います。途中の4の後ろにある1も除きたいなら、残す条件を使ってfilterを選びます。先頭の条件を満たす部分を残したい場合はtakeWhileです。",
}
