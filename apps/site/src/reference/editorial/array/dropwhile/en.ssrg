import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Skip only the matching prefix",
  purpose: "Pass a predicate and an array to dropWhile to skip a leading run of small values. The predicate receives one element and returns True to discard it or False to stop.",
  reading: "fn isSmall value: Int -> Bool declares a function taking an integer and returning a boolean. It evaluates value < 3. arrays.dropWhile isSmall [1, 2, 4, 1] discards 1 and 2, stops at 4, and returns [4, 1]. It does not examine the final 1 again.",
  boundaries: "The second call stops immediately at 4 and keeps [4, 1]. The third returns [] because every value matches; the fourth returns [] for empty input. arrays.empty<Int> () creates an empty integer array.",
  rules: "Predicates run from the start and stop at the first False. Later elements do not trigger the predicate. The result is a new array in source order; the source stays unchanged. Work includes copying the retained elements.",
  mistake: "This does not remove matching elements throughout the array. To remove the later 1 as well, use filter with a condition describing what to keep. Use takeWhile to keep the matching prefix instead.",
}
