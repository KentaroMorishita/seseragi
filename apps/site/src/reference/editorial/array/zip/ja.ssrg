import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "二つのArrayの同じ位置にある値を組にします。",
  purpose: "名前の一覧と点数の一覧を、(名前, 点数)の組へ合わせる操作です。丸括弧内の二つの値をカンマで区切ったものをtupleと呼びます。フィールド名の代わりに位置で役割が決まり、一つ目が名前、二つ目が点数です。",
  reading: "arrays.zip scores namesでは、先に渡すscoresが組の右側、後に渡すnamesが左側になります。結果の最初は(Aki, 80)、次は(Mio, 95)です。逆にarrays.zip names scoresとすると、(80, Aki)の順になります。",
  boundaries: "namesは3件、scoresは2件です。どちらの引数順でも短い2件で止まり、Renに対応する組は作りません。最後の二例は片方を空にしているので、結果も[]になります。noNamesとnoScoresの型注釈は空の値の要素型を指定します。",
  rules: "両方の先頭から一組ずつ作り、どちらかが尽きた時点で終了します。短い側がk個ならk個の組を作り、処理量と結果の保存領域はkに比例します。入力は変更しません。",
  mistake: "足りない側を埋める処理や長さの不一致のエラーはありません。全件の対応が必要なら先に両方のlengthを比べてください。組をそのまま残さず計算したい場合はzipWith、組から二つの一覧へ戻す場合はunzipを使います。"
}
