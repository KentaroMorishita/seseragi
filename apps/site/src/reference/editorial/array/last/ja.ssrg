import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "配列の最後の要素を、空の場合も含めて扱う",
  purpose: "最後に追加された値など、末尾の一要素が欲しいときにlastを使います。引数は配列一つです。空かもしれないので、戻り値はそのままのAではなくMaybe<A>になります。",
  reading: "最初の結果Just 30は「最後の値が30だった」という意味です。Justは中身を持つ場合の名前、Nothingは要素がない場合の名前です。Maybeはこの二つの選択肢を持つ型です。[10]でも最後の値はあるのでJust 10です。",
  boundaries: "arrays.empty<Int> ()は整数の空配列を作るため、最後の出力はNothingです。値を使う場合はmatchでJust valueとNothingを分け、前者でvalueを使い、後者で空の場合の処理を選びます。",
  rules: "配列の末尾を読むだけで、要素を取り除いたり元の配列を変えたりしません。Arrayのlastは、配列の長さにかかわらず一定の手順で末尾を参照します。",
  mistake: "空の場合を0や空文字列と取り違えないでください。Just 0は実際に0という要素があった結果です。末尾を除いた配列が欲しい場合はinitを使います。",
}
