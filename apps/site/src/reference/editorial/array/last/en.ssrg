import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Read the final element while handling an empty array",
  purpose: "Use last when you need the final value, such as the most recently appended item. It takes one array. Because that array may be empty, the result is Maybe<A> rather than A directly.",
  reading: "Just 30 means the final value was 30. Just names the case with a value; Nothing names the case without one. Maybe is the type containing those two alternatives. [10] also has a final element, so it returns Just 10.",
  boundaries: "arrays.empty<Int> () creates an empty integer array, producing Nothing. To use the result, match Just value and Nothing: use value in the first branch and choose empty-input behavior in the second.",
  rules: "Reading the last element does not remove it or change the source. Array last finds the final element in constant time, independent of the array length.",
  mistake: "Do not confuse absence with zero or an empty string. Just 0 means an actual zero was present. Use init if you want the array with its final element removed.",
}
