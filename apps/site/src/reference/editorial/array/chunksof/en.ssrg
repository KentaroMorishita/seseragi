import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Split an array into separate batches",
  purpose: "Use chunksOf 2 values when you want batches of at most two items. The first argument is the maximum batch size; the second is the source array. The final leftover items are kept.",
  reading: "The first call splits five numbers into [10, 20], [30, 40], and [50]. Right names the successful alternative and wraps the result. Either means the function returns either Right with a successful value or Left with a failure reason. Here Left reports an invalid size.",
  boundaries: "The second call has no input elements, so it returns Right []. arrays.empty<Int> () creates an empty array of integers. Zero and -2 are not positive sizes, so the final calls return Left NonPositiveSize with that number. To use a result, match both Right groups and Left error, then pass the successful groups to the next calculation.",
  rules: "A size larger than the input produces one batch containing the whole input. A positive size with an empty input succeeds. The operation creates new arrays without changing the source. Work is proportional to the input and output element counts.",
  mistake: "Use windows to compare overlapping neighboring items. A shorter final chunk is normal. Do not use zero to request an empty result: supply a positive integer or handle Left.",
}
