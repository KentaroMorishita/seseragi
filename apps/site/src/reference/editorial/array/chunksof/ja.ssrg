import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "配列を、重ならない小さなまとまりに分ける",
  purpose: "たとえば一度に2件ずつ処理したいとき、chunksOf 2 valuesで配列を区切れます。最初の引数が各まとまりの最大件数、次の引数が元の配列です。最後に余った要素も捨てません。",
  reading: "最初の呼び出しは5個の数を2個ずつに分けるため、[10, 20]、[30, 40]、[50]になります。結果のRightは成功した値を包む名前です。Eitherは成功のRightか、失敗理由を持つLeftのどちらかを返す型で、この関数ではサイズが正しくない場合にLeftを返します。",
  boundaries: "2行目は要素のないInt配列なのでRight []です。arrays.empty<Int> ()は整数の空配列を作ります。0と-2は正のサイズではないため、後の2行はLeft NonPositiveSizeと指定した数になります。取り出して使うときはmatchでRight groupsとLeft errorの両方を扱い、成功したgroupsだけを後続処理に渡します。",
  rules: "サイズが入力の長さより大きければ、入力全体を一つのまとまりにします。正のサイズと空配列の組み合わせは成功です。元の配列を変えず、新しい配列を作ります。処理量は入力と出力の要素数に比例します。",
  mistake: "隣り合う要素を重複させて比べたいならwindowsを使います。chunksOfの最後のまとまりが短いのは正常です。サイズ0を「空の結果」の意味で渡さず、1以上の整数を渡すかLeftを処理してください。",
}
