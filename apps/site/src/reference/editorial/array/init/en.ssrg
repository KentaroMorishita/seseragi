import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Get the array without its final element",
  purpose: "Use init to remove just the final element. It takes one array. Maybe<Array<A>> distinguishes Just with the remaining array from Nothing when there was no element to remove.",
  reading: "Removing 30 from [10, 20, 30] gives Just [10, 20]. Just wraps the remaining array; it is not the array itself. To use it, match Just remaining and Nothing, then use remaining in the first branch.",
  boundaries: "The singleton [10] has an element to remove, so it gives Just []. The already empty arrays.empty<Int> () has none, so it gives Nothing. An empty successful result is different from an input that had no removable element.",
  rules: "The source stays unchanged. The result is a new array in the original order, ending before the final element, with copying proportional to the retained elements. Keeping that result does not retain the excluded element through backing storage.",
  mistake: "init does not create an initial value. Use arrays.empty<Int> () to create an empty integer array. Use last when you want the final element itself.",
}
