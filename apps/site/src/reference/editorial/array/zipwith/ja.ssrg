import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "二つのArrayの対応する値を関数で計算します。",
  purpose: "同じ位置にある二つの値から差額などを求めたいときに使います。zipが値の組を残すのに対し、zipWithは渡した関数の計算結果を並べます。",
  reading: "fn subtract left: Int -> right: Int -> Int = left - rightは、整数leftとrightを受け取って差を返す関数です。fnは関数宣言、矢印は引数と結果の型の区切りです。arrays.zipWith subtract right leftは関数、右の一覧、左の一覧の順に渡します。subtractへは左、右の順で値が入り、10 - 1と20 - 2から9、18になります。",
  boundaries: "二例目は一覧の引数を逆にしたので1 - 10と2 - 20になり、-9、-18が並びます。長い側の30は使いません。none: Array<Int>は空の整数の一覧です。片方が空の最後の二例ではsubtractは呼ばれず、結果も[]です。",
  rules: "対応する位置を先頭から進み、短い側の要素数だけ関数を一度ずつ呼びます。k組ならk回の関数実行に加え、kに比例する組み立てと結果の保存領域が必要です。渡す関数は値を計算する通常の関数で、出力などのEffect処理ではありません。",
  mistake: "一覧を渡す順番と、関数に値が入る順番を逆にしないでください。足し算では逆順の間違いが見えにくいため、例では引き算を使っています。値をそのまま二つずつ残すならzipを選びます。"
}
