import { Editorial } from "../../model"
import { sequenceReaderEditorial } from "../../nonempty-iterator-model"
import * as en from "./en"
import * as ja from "./ja"
pub fn editorial -> Editorial =
  sequenceReaderEditorial "std/iterator::next" "std/iterator" "next" "3\n3\n2\ndone" "3\n2\n1\ndone" (en.copy ()) (ja.copy ())
