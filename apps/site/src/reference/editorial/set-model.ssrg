import { ApiCopy, Editorial } from "./model"
import { localized } from "../../model/locale"
import {
  CodeExample,
  Heading,
  InternalLink,
  Inline,
  Paragraph,
  Terminal,
  Words
} from "../../model/page"

fn readerNote shown: Bool -> english: String -> japanese: String -> Inline =
  Words (if shown then
    localized english japanese
  else
    localized "" "")

fn displaysMembers identity: String -> Bool =
  identity != "std/set::contains"
  && identity != "std/set::size"
  && identity != "std/set::isSubsetOf"

pub fn setEditorial identity: String
  -> exampleId: String
  -> output: String
  -> english: ApiCopy
  -> japanese: ApiCopy
  -> Editorial =
  Editorial {
    identity,
    namespace: "value",
    itemKind: "function",
    summary: localized english.summary japanese.summary,
    blocks: [
      Heading ("using-this-operation", localized "Use this operation" "この操作を使う"),
      Paragraph ([Words (localized english.purpose japanese.purpose)]),
      Paragraph (
        [
          Words (
            localized
              "import * as sets names std/set as sets. let names a value. Arguments are separated by spaces, and parentheses group nested calls."
              "import * as setsはstd/setをsetsという名前で読み込みます。letは値に名前を付けます。引数は空白で区切り、括弧で内側の呼び出しをまとめます。"
          ),
          readerNote (identity == "std/set::empty")
              " Set<Int> contains distinct integers." "Set<Int>は異なる整数の集合です。",
          readerNote (identity != "std/set::empty" && identity != "std/set::singleton")
              " Square brackets make an Array." "角括弧でArrayを作ります。",
          readerNote (identity == "std/set::fromIterable")
              " A leading backtick makes `[3, 1, 3, 2] a List."
              "先頭にバッククォートを付けた`[3, 1, 3, 2]はListです。",
          readerNote (identity == "std/set::map")
              " In fn parity value: Int -> Int = value % 2, : gives the parameter type, -> gives the result type, and = starts the expression that returns it."
              "fn parity value: Int -> Int = value % 2では、:の後が引数の型、->の後が結果の型、=の後が返す式です。"
        ]
      ),
      CodeExample
              (exampleId, localized "Seseragi: a complete program" "Seseragiの完全なプログラム"),
      Paragraph (
        [
          Words (
            localized
              "pub effect fn main is the entry function; do runs these prints in order. println displays a value and adds a newline."
              "pub effect fn mainは実行入口で、doの中は出力を行う順に並びます。printlnは値を表示して改行します。"
          ),
          readerNote (displaysMembers identity)
              " sets.toArray reads members in insertion order; json.encodeString formats the Array as JSON text."
              "sets.toArrayが要素を挿入順に読み、json.encodeStringがArrayをJSONの文字列にします。",
          readerNote (identity == "std/set::empty")
              " The Set<Int> annotation supplies the empty Set's element type."
              "Set<Int>という型注釈が空のSetの要素型を指定します。",
          readerNote
              (identity != "std/set::empty" && identity != "std/set::singleton" && identity != "std/set::fromIterable")
              " In sets.empty<Int> (), <Int> supplies the empty Set's element type."
              "sets.empty<Int> ()の<Int>が空のSetの要素型を指定します。",
          readerNote
              (identity != "std/set::singleton" && identity != "std/set::fromIterable")
              " () supplies Unit, meaning no additional input."
              "()は追加の情報を持たないUnitの引数です。",
          Words
              (localized " These examples use small integer members." "例の要素には小さな整数を使っています。")
        ]
      ),
      Terminal (localized "Output" "実行結果", output),
      Heading ("reading-the-example", localized "Read the result" "結果を読む"),
      Paragraph ([Words (localized english.reading japanese.reading)]),
      Paragraph ([Words (localized english.boundaries japanese.boundaries)]),
      Heading (
        "typescript-comparison",
        localized "The same task in TypeScript" "TypeScriptで同じ処理を表す"
      ),
      Paragraph ([Words (localized english.mistake japanese.mistake)]),
      CodeExample (
        exampleId + "-ts",
        localized "TypeScript: matching input and output" "TypeScriptで同じ入力と出力を確かめる"
      ),
      Paragraph (
        [
          Words (
            localized "This TypeScript program produces the same output above."
              "このTypeScriptのプログラムも先ほどと同じ出力になります。"
          ),
          readerNote (identity != "std/set::contains" && identity != "std/set::size")
              " Spreading a Set inside [...] collects its members into an array."
              "[...]の中でSetを展開すると、要素を配列に集められます。",
          readerNote (displaysMembers identity)
              " JSON.stringify formats the array as JSON text."
              "JSON.stringifyが配列をJSONの文字列にします。",
          readerNote (identity == "std/set::singleton" || identity == "std/set::size")
              " new Set(values) copies members before add, so values stays unchanged."
              "addの前にnew Set(values)で要素をコピーするため、valuesは変わりません。",
          readerNote (identity == "std/set::insert")
              " new Set(original) copies members before add, so original stays unchanged."
              "addの前にnew Set(original)で要素をコピーするため、originalは変わりません。",
          readerNote (identity == "std/set::remove")
              " new Set(original) and new Set(removed) copy members before delete or add, so the earlier Sets stay unchanged."
              "deleteやaddの前にnew Set(original)やnew Set(removed)で要素をコピーするため、それまでのSetは変わりません。",
          Words (
            localized
              " The final export {} keeps this standalone file’s names local to its module. Small integers are used here; this does not establish matching equality for arbitrary custom element types."
              "最後のexport {}は、この独立したファイルの名前をモジュール内にとどめるためのものです。小さな整数の比較であり、独自の要素型の等しさまで同じとは示していません。"
          )
        ]
      ),
      Heading ("operation-rules", localized "Rules and cost" "規則と処理量"),
      Paragraph ([Words (localized english.rules japanese.rules)]),
      Paragraph (
        [
          InternalLink (localized "std/set" "std/set", "/docs/library/set/"),
          Words (localized ": choose by the task you need." "：必要な処理から操作を選べます。")
        ]
      ),
      Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")
    ]
  }
