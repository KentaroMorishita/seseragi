import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "withQueryは、Urlのクエリ全体を指定したQueryへ入れ替え、新しいUrlを返します。パスやフラグメントなど、ほかの部分と元のUrlは保たれます。",
  taskTitle: "編集した条件を検索リンクへ反映する",
  purpose: "共有リンクのtagとpageを、検索語qだけの新しい条件へ入れ替えます。続いて条件をすべて外したリンクも作り、位置指定の#resultsと元のリンクが保たれることを確かめます。",
  typescriptBefore: "TypeScriptではquery.toString()の結果をURLのsearchへ設定します。元のURLを保つこの例では、new URL(original)で作った別のURLへ設定します。searchの代入も、古いクエリへの追加ではなく全体の置き換えです。",
  benefit: "withQueryはQueryとUrlを受け取り、変更後のUrlを返します。?の付け外しを自分で処理せず、元のURLを保ったまま編集結果を反映できます。",
  setup: "navigationはstd/web/navigationの別名です。navigation.withQuery replacement originalのようにQuery、Urlの順で引数を空白で並べます。letで新しいUrlに名前を付けます。replaceFiltersの: Stringは引数の型、-> Stringは戻り値の型です。",
  after: [
    "最初のparseUrlはEither<UrlBuildError, Url>を返します。matchのRightは確認済みのUrl、Leftは確認に失敗した理由です。URLを作り直す操作は成功側で行います。Left _の_は、ここでは失敗の詳しい理由を使わない印です。",
    "urlQueryで取り出したoldQueryは、まず元の条件を表示するために使います。置き換え用のreplacementはemptyQueryから別に作り、q=teaだけを入れています。",
    "replacementをwithQueryへ渡すと、元のtagとpageは消え、q=teaだけになります。withQueryは二つのクエリを結合する操作ではありません。",
    "emptyQueryを渡すとクエリと?が取り除かれます。どの場合もパスとフラグメントは保たれ、元のUrl自体は変わりません。",
  ],
  details: [
    "UrlとQueryの順を逆に渡すと型が合いません。withQuery newQuery originalの順に直します。QueryをrenderQueryでStringへ変えてから渡す必要もありません。",
    "タグが消えた場合は、渡したQueryにそのタグが含まれているか確認します。一つの条件だけ変えるなら、元のURLをurlQueryで読み取ってからsetQueryなどで編集します。",
    "クエリは値から書き直されるので、元の%20が+になる場合があります。入力時の綴りのままであることを、クエリの内容が変わらないことと混同しないようにします。",
  ],
}
