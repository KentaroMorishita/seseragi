import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "Query stores an ordered sequence of names and values. A name can appear more than once, so a link can retain every selected tag without collapsing them into a single value.",
  taskTitle: "Build filters with several selected tags",
  purpose: "Create a query containing one search term and two selected tags. Keep both tag entries in selection order, ready to attach to a shareable link.",
  typescriptBefore: "TypeScript's URLSearchParams already supports repeated names and ordered entries. append adds each selection. A plain object or Map with one value per name would be a poor substitute for these repeated tags.",
  benefit: "Query represents the same useful sequence of names and values. Its editing operations return new Query values, so an earlier set of conditions remains available while you build another.",
  setup: "navigation is the import alias for std/web/navigation. navigation.emptyQuery is an empty Query value. appendQuery takes a name, a value, and the previous Query, separated by spaces. let names the returned value.",
  after: [
    "Start with no entries, then append the search term and each tag. Every tag adds another pair at the end. An existing tag is not removed just because its name is used again.",
    "Pass ordinary, decoded strings as names and values. The search term contains a space and an ampersand; renderQuery handles their query encoding when producing text.",
    "renderQuery returns query text without a leading ?. To attach these conditions to a complete URL, pass the Query to withQuery instead of joining URL fragments by hand.",
    "search contains only the search term; selected also contains books and music. Printing both shows that adding the tags did not change search. The TypeScript version makes one copy because it also displays both stages.",
  ],
  details: [
    "Use setQuery when a name should have just one value. Using it to add another selected tag would replace the existing tags; use appendQuery for that task.",
    "Query is not a record whose entries field you edit directly. Read all pairs with queryEntries, or all values for one name with queryValues.",
    "An empty value still counts as an entry. A missing name and a present name with an empty string are different states. Keep the pairs when order or repeated names matter.",
  ],
}
