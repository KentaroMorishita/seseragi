import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "Urlは、URLとして確認した値を、まだ確認していない文字列と区別するための型です。parseUrlなどで作り、公開された操作で読み取りや編集を行います。",
  taskTitle: "確認したリンクを保ったまま条件を変える",
  purpose: "貼り付けられた検索リンクを一度確認してから、検索語、タグ、表示位置を変更します。編集前のUrlも手元に残し、最後に共有用の文字列を取り出します。",
  typescriptBefore: "TypeScriptのURLも、文字列を解析した結果を扱う標準の型です。new URL(input)で作った値のsearchParamsやhashを編集してhrefを読みます。この例のように新しく作ったURLだけを編集するなら、その場での書き換えで十分です。",
  benefit: "Seseragiでは、renderUrlやwithQueryなどに必要なUrlを、単なるStringと区別できます。編集操作が新しいUrlを返すため、元のリンクを残すためだけのコピー処理は要りません。",
  setup: "navigationは読み込んだstd/web/navigationの別名です。shareLinkのinput: Stringは入力の型、-> Stringは戻り値の型です。navigation.parseUrl inputのように引数を空白で並べ、letで各段階の値に名前を付けます。",
  after: [
    "parseUrlはEither<UrlBuildError, Url>を返します。Right originalには確認できたUrlが入り、Left _は確認に失敗した場合です。matchで分岐するので、失敗した値がそのまま編集操作へ渡ることはありません。Left _の_は、ここでは失敗の詳しい理由を使わない印です。",
    "originalはUrl、urlQuery originalはQueryです。検索語やタグはQueryを編集してからwithQueryで新しいUrlへ反映します。withFragmentも新しいUrlを返し、originalは変わりません。",
    "最後のrenderUrlでStringに戻すと、コピーしたり表示したりできる完全なリンクになります。Urlを保持している間は、クエリやフラグメントを文字列の切り貼りで探す必要がありません。",
    "この型に用意された解析操作は、絶対HTTP(S) URLを受け入れ、空でないユーザー名やパスワードを含むURLを拒否します。名前だけの独自レコードを作ってUrlの代わりにはできません。",
  ],
  details: [
    "renderUrlに生の文字列を渡してしまったら、先にparseUrlの結果をmatchで分け、RightのUrlを渡します。Urlの内部フィールドを直接読む代わりに、renderUrlやurlQueryなどを使います。",
    "Urlは元の綴りを保存する型ではありません。ホスト名や既定ポートなどが正規化されることがあります。入力をそのまま再表示する必要がある場合は、元のStringも別に持ちます。",
    "URLの解析はリンク先へ通信せず、存在確認や移動先の許可判断もしません。また、%に続く2桁の確認は、すべての読み取り操作で文字の復号が成功する保証ではありません。フラグメントを読む場合の注意はurlFragmentで確認できます。",
  ],
}
