import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "urlFragmentは、Urlの#より後ろの部分を復号した文字列として読み取ります。内容があればJust、なければNothingを返します。",
  taskTitle: "共有リンクが指すページ内の位置を読む",
  purpose: "検索結果へのリンクから、results 2のような表示位置の指定を読みます。位置が指定されている場合と、何も指定されていない場合を分けて表示します。",
  typescriptBefore: "TypeScriptのURL.hashは#付きのエンコードされた文字列です。内容を読むには先頭の#を除いてdecodeURIComponentを使い、空なら位置指定なしとして扱います。",
  benefit: "urlFragmentは、通常の入力について#を外して復号する処理と、内容の有無の区別をまとめています。呼び出し側ではJustとNothingに分けて表示を選べます。",
  setup: "navigationはstd/web/navigationの別名です。navigation.urlFragment urlのようにUrlを空白で続けて渡します。sectionTextのurl: navigation.Urlは引数の型、-> Stringは戻り値の型で、matchは結果に合った分岐を選びます。",
  after: [
    "まずparseUrlの結果をLeftとRightに分けます。LeftはURLの読み取り失敗、Rightは使えるUrlです。そのUrlにurlFragmentを使います。Left _の_は、ここでは失敗の詳しい理由を使わない印です。",
    "戻り値のMaybe<String>は、内容ありのJust sectionか、内容なしのNothingです。Justでは復号済みのsectionにSection:を付け、NothingではNo sectionを表示します。",
    "withFragmentで作ったURLの空白は%20ですが、urlFragmentで読むとSection: results 2と表示されます。元のURLには位置指定がないので、その行はNo sectionです。フラグメント内の+は空白ではなく、そのまま+です。",
    "#がないURLと、末尾が#だけのURLは、どちらもNothingです。空文字列のJustとして見分けるAPIではありません。",
  ],
  details: [
    "重要な例外があります。https://example.test/#%FFはparseUrlではRightになりますが、urlFragmentは不正なUTF-8を復号できずURIErrorを投げます。この失敗はLeftやNothingではありません。解析の成功だけで、その後の読み取りが必ず成功するとは判断しないでください。",
    "位置の指定を自分で作る場合は、withFragmentにエンコード前の通常の文字列を渡します。外部から来た任意のフラグメントについて、Maybeが復号の失敗まで表すとは考えません。",
    "ここで読めるのはページ内の位置指定です。クエリのqやtagを読みたいならurlQueryを使います。読み取りでスクロールや画面移動は起こりません。",
  ],
}
