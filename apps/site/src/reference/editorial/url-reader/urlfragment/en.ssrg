import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "urlFragment reads the part after # as decoded section text. It returns Just when there is content and Nothing when there is no nonempty fragment.",
  taskTitle: "Read the section named by a link",
  purpose: "Read a section such as results 2 from a search link. Show the section when present and a useful fallback when absent, without opening or scrolling the page.",
  typescriptBefore: "URL.hash gives TypeScript an encoded string with its leading #. The example removes that marker and uses decodeURIComponent, returning No section when hash is empty.",
  benefit: "For ordinary valid input, urlFragment combines marker removal, decoding, and the presence check. The caller handles the two outcomes with Just and Nothing.",
  setup: "navigation is the import alias for std/web/navigation. navigation.urlFragment url passes one Url after a space. sectionText's : navigation.Url is the input type and -> String its return type. match chooses a branch for the result.",
  after: [
    "sectionLink first matches parseUrl: Left _ returns Link rejected without using the reason, and Right original contains the usable Url. sectionText reads a fragment from a Url.",
    "Maybe<String> means either Just section, containing text, or Nothing, containing no section. The Just branch adds Section: to the decoded value; the Nothing branch returns No section.",
    "The new URL contains results%202. After decoding, sectionText returns Section: results 2 for that URL and No section for the original, which had no fragment. println displays that text. A literal + in a fragment remains a plus, unlike form-style query spaces.",
    "A URL with no # and a URL ending in a bare # both return Nothing. This operation does not distinguish the bare marker as Just containing an empty string.",
  ],
  details: [
    "There is an important failure boundary: https://example.test/#%FF parses as Right, but urlFragment throws URIError when decoding its invalid UTF-8. That failure is neither Left nor Nothing. Parse success alone does not make every fragment read safe.",
    "When creating a section yourself, pass ordinary unencoded text to withFragment. For arbitrary external fragment text, do not assume Maybe also represents decoding failures.",
    "This reads the page-section component, not q or tag conditions. Use urlQuery for those. Reading a section does not scroll or navigate.",
  ],
}
