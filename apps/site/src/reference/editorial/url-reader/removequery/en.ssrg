import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "removeQuery removes every entry with the specified name. It returns a new Query, preserving the other conditions and leaving the original unchanged.",
  taskTitle: "Reset the page number and keep the filters",
  purpose: "Remove an old page number when preparing a search link. Even if page appears twice, remove both entries while keeping the search term and selected tag.",
  typescriptBefore: "TypeScript uses URLSearchParams.delete(\"page\") to remove all entries with that name. The remaining names retain their order. Deleting a name that is absent leaves the visible contents unchanged.",
  benefit: "removeQuery handles all matching entries in one call and returns the cleared Query. The earlier Query remains available if another step needs the original conditions.",
  setup: "navigation is the import alias for std/web/navigation. navigation.removeQuery \"page\" original passes the name first and the Query second. let names the result; : String and -> String give firstPage's input and return types.",
  after: [
    "parseQuery returns Right original for readable conditions or Left _ for a rejection. match selects the branch; _ means the detailed error is unused. Editing happens only with the successful Query.",
    "Both page entries are removed, not just the first. The remaining q and tag retain their order.",
    "The example then removes missing, a name that was never present. The two output lines are equal because removing an absent name does not change the remaining contents.",
    "The example displays the two cleared results. original still holds the earlier conditions. Continue with cleared or unchanged when the next step should use the query after removal.",
  ],
  details: [
    "Names are case-sensitive: removing page leaves Page alone. If a removal appears ineffective, inspect the actual names with queryEntries.",
    "Replacing the whole query with emptyQuery would also lose the search term and tags. Use removeQuery for one name, or withQuery and emptyQuery when every condition should go.",
    "The destination application decides what an absent page parameter means. This operation only removes the condition; it does not run a search or reload a page.",
  ],
}
