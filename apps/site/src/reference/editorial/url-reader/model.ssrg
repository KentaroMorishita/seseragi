import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { Editorial } from "../model"

pub struct UrlReaderCopy {
  summary: String,
  taskTitle: String,
  purpose: String,
  typescriptBefore: String,
  benefit: String,
  setup: String,
  after: Array<String>,
  details: Array<String>
}

fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  [Paragraph ([Words (localized en ja)]) | (en, ja) <- arrays.zip japanese english]

fn link title: String -> route: String -> english: String -> japanese: String -> Block =
  Paragraph (
    [
      InternalLink (localized title title, route),
      Words (localized (": " + english) ("：" + japanese))
    ]
  )

pub fn urlReaderEditorial identity: String
  -> namespace: String
  -> itemKind: String
  -> source: String
  -> output: String
  -> english: UrlReaderCopy
  -> japanese: UrlReaderCopy
  -> Editorial =
  Editorial {
    identity,
    namespace,
    itemKind,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-operation", localized english.taskTitle japanese.taskTitle),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        Heading (
          "typescript-comparison",
          localized "Start with familiar TypeScript" "TypeScriptの処理から考える"
        ),
        Paragraph
          ([Words (localized english.typescriptBefore japanese.typescriptBefore)]),
        CodeExample
          ("url-reader-" + source + "-ts", localized "TypeScript" "TypeScript"),
        Terminal (localized "TypeScript output" "TypeScriptの実行結果", output),
        Heading (
          "seseragi-example",
          localized "Write the same task in Seseragi" "Seseragiで同じ処理を書く"
        ),
        CodeExample (
          "url-reader-" + source,
          localized "Complete Seseragi program" "Seseragiの完全なプログラム"
        ),
        Terminal (localized "Seseragi output" "Seseragiの実行結果", output),
        Paragraph ([Words (localized english.benefit japanese.benefit)]),
        Heading ("reading-the-example", localized "Read the important lines" "大事な行を読む"),
        Paragraph ([Words (localized english.setup japanese.setup)])
      ],
      paragraphs english.after japanese.after,
      [Paragraph (
        [Words (
          localized
          "pub effect fn main names the public program entry; effect allows this entry to print. println writes text followed by a newline. A block enclosed in { and } returns its final expression, after any let names. The URL calculations return values; they do not print by themselves."
          "pub effect fn mainはプログラムの公開された実行入口です。effectを付けたこの入口から表示を行います。printlnは文字列と改行を出力します。{と}で囲んだブロックは、letで途中の値に名前を付けたあと、最後の式を結果にします。URLの計算自体は値を返すだけで、表示は行いません。"
        )]
      )],
      if source == "check-absolute-link" || source == "parse-filter-query" || source == "resolve-search-link" || source == "url-build-errors" then
        [Paragraph (
          [Words (
            localized
          "do lists the print operations in order. _ <- runs an earlier print before continuing without naming its unused result. The last println is the final operation."
          "doには表示を行う順番に処理を並べます。_ <-は先の表示を終えてから次へ進み、使わない戻り値には名前を付けません。最後のprintlnが最後の処理です。"
          )]
        )]
      else
        [],
      [
        Paragraph (
          [Words (
            localized
          "Open the complete program in the Playground and choose Run to see its output. std/web/navigation is a browser-target module. These examples only create URL and query values; they do not read or change browser location. Their main entry needs Console for printing, not the Navigation service. To produce browser files outside the Playground, save the source under the filename below and build it for web. Building alone does not print the example output."
          "Playgroundで完全なプログラムを開き、Runを選ぶと結果を確認できます。std/web/navigationはブラウザー向けのモジュールです。この例はURLやクエリの値を作るだけで、ブラウザーの現在位置を読み取ったり変更したりしません。mainの表示にはConsoleを使いますが、Navigationサービスは使いません。Playground以外でブラウザー用のファイルを作るには、下の名前でソースを保存し、webを指定してビルドします。ビルドだけでは実行結果は表示されません。"
          )]
        ),
        Terminal (
          localized "Build browser files" "ブラウザー用のファイルを作る",
          "seseragi build " + source + ".ssrg --target web --out-dir dist"
        ),
        Heading ("operation-rules", localized "Rules and common mistakes" "規則と間違いやすい点")
      ],
      paragraphs english.details japanese.details,
      [Heading ("choose-next", localized "Choose the next operation" "次に必要な操作を選ぶ")],
      related identity,
      if itemKind == "module" then
        []
      else
        [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
}

fn urlLinks -> Array<Block> = [
  link "parseUrl" "/docs/library/web/navigation/function/parseurl/"
    "check an absolute link before using it." "絶対URLを確認してから使います。",
  link "resolveUrl" "/docs/library/web/navigation/function/resolveurl/"
    "turn a relative link into an absolute URL with an explicit base."
    "基準のURLを指定し、相対的なリンクを絶対URLにします。",
  link "urlQuery" "/docs/library/web/navigation/function/urlquery/"
    "read the filters already present in a link." "リンクに含まれている検索条件を取り出します。"
]

fn queryLinks -> Array<Block> = [
  link "appendQuery" "/docs/library/web/navigation/function/appendquery/"
    "add one more value without removing repeated keys." "同じ名前の値を残しながら、新しい値を追加します。",
  link "setQuery" "/docs/library/web/navigation/function/setquery/"
    "replace all values for one filter with one new value." "一つの検索条件の値を、新しい一件に置き換えます。",
  link "withQuery" "/docs/library/web/navigation/function/withquery/"
    "put the finished query into a new URL." "組み立てたクエリを新しいURLに入れます。"
]

fn fragmentLinks -> Array<Block> = [
  link "urlFragment" "/docs/library/web/navigation/function/urlfragment/"
    "read the section named after the # marker." "#の後にあるセクション名を読み取ります。",
  link "withFragment" "/docs/library/web/navigation/function/withfragment/"
    "set a section name using ordinary text." "通常の文字列でセクション名を指定します。",
  link "withoutFragment" "/docs/library/web/navigation/function/withoutfragment/"
    "share the filtered page without a section marker." "セクションの指定を外して検索結果を共有します。"
]

fn related identity: String -> Array<Block> = match identity {
  "std/web/navigation" -> [
    link "parseUrl" "/docs/library/web/navigation/function/parseurl/"
      "check the starting link." "元になるリンクを確認します。",
    link "Query" "/docs/library/web/navigation/opaque-type/query/"
      "keep repeated filter values in order." "同じ名前の検索条件を、順序を保って扱います。",
    link "withFragment" "/docs/library/web/navigation/function/withfragment/"
      "point the shared link at a section." "共有するリンクにセクションを指定します。"
  ]
  "std/web/navigation::Url" -> urlLinks ()
  "std/web/navigation::UrlBuildError" -> urlLinks ()
  "std/web/navigation::parseUrl" -> urlLinks ()
  "std/web/navigation::resolveUrl" -> urlLinks ()
  "std/web/navigation::renderUrl" -> urlLinks ()
  "std/web/navigation::urlFragment" -> fragmentLinks ()
  "std/web/navigation::withFragment" -> fragmentLinks ()
  "std/web/navigation::withoutFragment" -> fragmentLinks ()
  _ -> queryLinks ()
}
