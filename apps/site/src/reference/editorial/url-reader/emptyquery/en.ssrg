import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "emptyQuery is a Query value containing no conditions. It is not a function: use it without () as the starting point for a new set of filters.",
  taskTitle: "Start filters from an empty selection",
  purpose: "Build conditions for a fresh search form: add the search term, then the selected tags. Start from nothing rather than accidentally inheriting conditions from an older link.",
  typescriptBefore: "TypeScript starts with new URLSearchParams() and adds entries with append. toString() returns an empty string before any entries exist, and encoded query text after additions.",
  benefit: "emptyQuery can be reused as the starting value. Adding conditions returns a new Query, so earlier searches cannot leave entries inside the shared empty value.",
  setup: "navigation is the import alias for std/web/navigation. navigation.emptyQuery is the value itself. appendQuery takes a name, a value, and a Query with spaces between arguments. let names the new Query it returns.",
  after: [
    "The starting Query has no name/value pairs. The example first adds q to make search and prints that search-only query. Rendering emptyQuery itself would produce an empty string.",
    "Appending the first condition leaves emptyQuery empty. Later appends add books and music as separate tag entries; repeated names do not overwrite earlier selections.",
    "Pass ordinary text, including spaces and ampersands. renderQuery turns those characters into the appropriate query spelling at the end.",
    "Use withQuery to attach a built Query to a Url. Passing emptyQuery to withQuery instead removes the URL's entire query.",
  ],
  details: [
    "emptyQuery () attempts to call a value as a function. Remove the parentheses and pass navigation.emptyQuery directly.",
    "Starting from an empty query is different from clearing just one condition. To reset page while retaining the search term and tags, use removeQuery.",
    "emptyQuery is a Query, not an empty String. Choose renderQuery when text is needed, or withQuery when applying it to a URL.",
  ],
}
