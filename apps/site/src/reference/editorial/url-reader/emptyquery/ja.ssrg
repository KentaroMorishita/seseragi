import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "emptyQueryは、検索条件を一つも持たないQueryの値です。関数ではないので()を付けず、そこから条件を追加して使います。",
  taskTitle: "何も選ばれていない状態から検索条件を作る",
  purpose: "新しい検索フォームの状態から、検索語と選んだタグをリンク用のクエリへまとめます。前のページの条件を引き継がず、必要な項目だけを追加します。",
  typescriptBefore: "TypeScriptではnew URLSearchParams()で空の条件を作り、appendで項目を追加します。toString()は空なら空文字列を返し、追加後はエンコードされたクエリを返します。",
  benefit: "emptyQueryを毎回の出発点にできます。追加操作は新しいQueryを返すため、共有されている空の値に前の検索条件が残ることはありません。",
  setup: "navigationはstd/web/navigationの別名です。navigation.emptyQueryと書くだけで空の値を使えます。appendQueryは名前、値、Queryを空白で並べて呼び、letで返された新しい値に名前を付けます。",
  after: [
    "最初のQueryには名前と値の組がありません。例ではそこへqを追加してsearchを作り、最初の行に検索語だけの条件を表示します。renderQuery emptyQueryだけなら出力は空文字列になります。",
    "appendQueryで最初の条件を加えると、元のemptyQueryは空のまま、項目を一つ持つ新しいQueryが得られます。さらにタグを追加すれば、同じ名前の複数の値も保持できます。",
    "値は普通の文字列のまま渡し、renderQueryにクエリの表記を任せます。空白や&を含む検索語でも、先にエンコードする必要はありません。",
    "作ったQueryをURLへ使う場合はwithQueryへ渡します。反対に、emptyQueryをwithQueryへ渡せば、そのURLのクエリ全体を外せます。",
  ],
  details: [
    "emptyQuery ()と書くと、値を関数として呼び出そうとしてしまいます。括弧を外し、navigation.emptyQueryをそのまま渡します。",
    "クエリを一度空にすることと、一つの名前の条件だけを消すことは違います。ほかの条件を残してpageだけ消したいならremoveQueryを使います。",
    "emptyQueryは空文字列そのものではなくQueryです。文字列が必要なところではrenderQuery、URLへの反映ではwithQueryと、必要な操作を選びます。",
  ],
}
