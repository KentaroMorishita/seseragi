import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "setQueryは、指定した名前の条件を一つの値へ置き換えます。同名の項目が複数あれば一つにまとめ、ほかの条件と元のQueryは保ちます。",
  taskTitle: "選択したタグを一つへ入れ替える",
  purpose: "リンクにbooksとmusicの二つのtagが入っていても、saleだけを選択した条件へ変えます。検索語qとページ番号pageを残し、編集前の条件も表示します。",
  typescriptBefore: "TypeScriptのURLSearchParams.set(name, value)も、同名の項目を一つへまとめます。最初の同名項目の位置を使い、ほかの項目を勝手に並べ替えません。",
  benefit: "setQueryで同じ名前の条件をまとめて置き換え、新しいQueryを受け取れます。元のQueryは変わらないので、編集前の選択とsaleへ変更した選択を並べて確認できます。",
  setup: "navigationはstd/web/navigationの別名です。setQueryには名前、新しい値、元のQueryの順で引数を渡します。空白が引数の区切りで、letは返された値に名前を付けます。 fnの: Stringは引数の型、-> Stringは戻り値の型です。",
  after: [
    "最初にparseQueryで条件を読みます。matchのRightには読めたQuery、Leftには読めなかった理由が入ります。成功したQueryだけにsetQueryを適用します。Left _の_は、ここでは失敗の詳しい理由を使わない印です。",
    "tagが二つあっても、新しいsaleの一組だけになります。その位置は最初のtag=booksがあった場所なので、出力はq、tag、pageの順です。後ろのtag=musicは取り除かれます。",
    "存在しない名前を設定した場合は、末尾に一組加わります。setQueryはクエリ全体を並べ替える操作ではありません。",
    "renderQueryで編集前と編集後を文字列にすると、元の条件が変わらず残っていることと、同名項目が一つになったことを確認できます。",
  ],
  details: [
    "複数選択のtagに一つ追加したいだけならappendQueryを使います。setQueryでtagを指定すると、前のtagの値はすべて置き換わります。",
    "名前は大文字と小文字を区別します。tagを設定してもTagは別の条件として残ります。フォーム側の名前と、編集する名前をそろえます。",
    "値はエンコード前の文字列で渡します。検索語の&を自分で%26にしてから渡すと、%も文字として扱われるので、そのままの検索語に戻して指定します。",
  ],
}
