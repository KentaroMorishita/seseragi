import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "appendQueryは、Queryの末尾に名前と値の組を一つ追加します。同じ名前の条件がすでにあっても残るので、タグなどの複数選択に使えます。",
  taskTitle: "選択済みのタグにもう一つ追加する",
  purpose: "検索語と選択済みのタグを保ち、別のタグを最後に加えます。同じtagという名前でも、前に選んだ値を上書きしないリンク用の条件を作ります。",
  typescriptBefore: "TypeScriptのURLSearchParams.append(name, value)も、同名の項目を残して末尾に追加します。標準APIがエンコードを行うため、値の記号を自分で置き換える必要はありません。",
  benefit: "appendQueryでは追加後のQueryが返り、追加前のQueryは変わりません。同じ出発点から別々の選択状態を作りたいときも、元の条件をそのまま使えます。",
  setup: "navigationはstd/web/navigationの別名です。navigation.appendQuery \"tag\" \"books\" searchのように、名前、値、Queryの順に空白で引数を並べます。letで受け取った値が追加後のQueryです。",
  after: [
    "検索語だけのsearchから、booksを追加したbooks、さらにmusicを追加したselectedを作ります。同じtagという名前でも、二つの値は選択順に残ります。",
    "appendQueryは末尾に一組追加する操作です。すでに同じ名前と同じ値があっても、重複を自動で取り除くことはありません。",
    "追加する値は、空白や+や&を含んでもそのまま渡します。renderQueryが区切り記号と値の中の文字を区別して書き出します。",
    "searchとselectedの出力を見比べると、追加前のsearchには検索語しかありません。TypeScript版も両方を表示するためにコピーを一つ作っています。appendQueryの戻り値を受け取らなければ、追加後の条件は次の処理へ渡りません。",
  ],
  details: [
    "検索語qのように一つだけ持ちたい条件へ毎回appendQueryすると、qが増えていきます。一つの値へ置き換える場合はsetQueryを使います。",
    "%20などを事前に用意して渡すと、%自身がエンコードされて%2520になります。空白を表したいなら実際の空白を渡します。",
    "追加したQueryだけではUrlは変わりません。既存のリンクへ反映するにはwithQueryへ新しいQueryと元のUrlを渡し、その結果をrenderUrlで文字列にします。",
  ],
}
