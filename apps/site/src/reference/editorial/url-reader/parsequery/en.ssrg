import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "parseQuery reads query text into names and values. It accepts the usual optional leading ?, returning either a Query or an error for malformed percent-escape spelling.",
  taskTitle: "Read supplied filter text",
  purpose: "Normalize query text containing a space, a literal plus, a slash, and an empty value. Compare two spellings of the same conditions, one with a leading ? and one without it.",
  typescriptBefore: "TypeScript uses new URLSearchParams(text). Its standard parsing already handles repeated names and form-style spaces. Malformed percent escapes do not produce the same explicit failure as parseQuery, so this comparison uses ordinary valid input.",
  benefit: "parseQuery separates a usable Query from malformed percent-escape spelling in its return value. Handle that result before editing or reading the parsed conditions.",
  setup: "navigation is the import alias for std/web/navigation. parseQuery takes query text, with a space between the function and its argument. In normalize, : String gives the input type and -> String gives the return type.",
  after: [
    "The result is Either<UrlBuildError, Query>. match selects Right query for usable conditions, or Left _ for a rejection. The underscore means this example ignores the detailed reason and returns Query rejected.",
    "q=tea%20cake and q=tea+cake both read as tea cake. literal=%2b and literal=%2B both read as a literal +. Names and values are decoded before later operations use them.",
    "The first input’s bare entry named empty and the second input’s empty= both represent an empty value. Neither means the name is absent; both serialize as empty=.",
    "Both lines print q=tea+cake&literal=%2B&path=%2F&empty=. renderQuery does not include the leading ? and rebuilds the spelling from the names and values.",
  ],
  details: [
    "Do not pass a complete https:// URL here. To read conditions from a full link, obtain a Url with parseUrl and then use urlQuery.",
    "Use zero or one leading ? for ordinary input. The current implementation reads ??q=x as q=x, whereas native new URLSearchParams(\"??q=x\") treats the name as ?q. Do not assume parity for that unusual input.",
    "A malformed triplet such as %ZZ returns Left. A byte-invalid but correctly spelled triplet such as %FF is read as a replacement character. This is not a strict UTF-8 validation API.",
  ],
}
