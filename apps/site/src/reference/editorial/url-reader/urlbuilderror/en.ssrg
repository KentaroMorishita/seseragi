import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "UrlBuildError describes why URL or query text was rejected. Read it from a Left result and choose a useful explanation for the person correcting the input.",
  taskTitle: "Explain why a link was rejected",
  purpose: "Accept a usable absolute link, then show specific feedback for four rejected inputs: a relative path, an unsupported scheme, login details, and a broken percent escape. The first ordinary mistake is /search without a base URL.",
  typescriptBefore: "The TypeScript comparison adds HTTP(S), login-detail, and percent-escape checks around new URL and try/catch. Those extra checks make the rejection policy match this example. Native new URL is shorter on its own, but does not impose all of these restrictions.",
  benefit: "UrlBuildError gives these failures distinct names. A match can choose feedback from the error value without trying to infer the cause from an exception's message text.",
  setup: "navigation is the import alias for std/web/navigation. reason takes error: navigation.UrlBuildError and returns String after ->. Calls use spaces between arguments. match selects an error alternative, and show turns a numeric offset into display text.",
  after: [
    "parseUrl returns Either<UrlBuildError, Url>. Right contains the parsed Url, which checkLink renders. Left contains an error, which checkLink passes to reason for a more specific message.",
    "InvalidUrl means the text could not be read as a URL. UnsupportedUrlScheme carries the rejected scheme, such as ftp. If the input is deliberately relative, use resolveUrl with a known base instead of asking parseUrl to guess one.",
    "UrlContainsUserInfo rejects a nonempty username or password. InvalidPercentEncoding means a percent sign is not followed by two hexadecimal digits; its offset points to that percent sign.",
    "The four public alternatives can be used in match even though UrlBuildError's internal representation is hidden. The example turns each alternative into an ordinary String for display.",
  ],
  details: [
    "InvalidUrl currently reports offset 0; it is not a precise syntax-error position. InvalidPercentEncoding uses a zero-based UTF-16 code-unit offset. This is not always a count of visible characters: an emoji such as 😀 occupies two units.",
    "For parseQuery, offsets refer to the text after one leading ? has been removed. The percent-escape check happens before scheme and user-info checks, so an input with several problems can report InvalidPercentEncoding first.",
    "navigation.errorMessage accepts the separate NavigationError type, not UrlBuildError; use a match like this one. Valid triplet spelling such as %FF is not validated UTF-8. A later urlFragment read can throw URIError instead of returning one of these errors.",
  ],
}
