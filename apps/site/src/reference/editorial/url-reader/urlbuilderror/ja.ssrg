import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "UrlBuildErrorは、URLやクエリの文字列を読めなかった理由を表す型です。parseUrlなどが返すLeftから取り出し、理由に合わせた案内を作れます。",
  taskTitle: "読めなかったリンクの直し方を案内する",
  purpose: "入力欄のリンクを確認し、URLとして読めたら整えた文字列を、読めなければ原因に合う案内を表示します。/searchだけの入力に続いて、未対応の方式、ログイン情報、不正な%の綴りも区別します。",
  typescriptBefore: "TypeScript版はnew URLとtry/catchに、HTTP(S)限定、ログイン情報なし、%の綴りの確認を追加しています。これは四つの失敗を同じ条件で比べるための処理です。通常のnew URLだけなら短く書けますが、これらの制限は自動では付きません。",
  benefit: "UrlBuildErrorでは、URLの形、方式、ユーザー情報、%の綴りの問題を名前付きの結果として扱えます。例外の文章から原因を推測せず、matchで必要な案内を選べます。",
  setup: "navigationはstd/web/navigationの別名です。reasonのerror: navigation.UrlBuildErrorは引数の型、-> Stringは戻り値の型です。関数名と引数を空白で並べ、matchで理由に合う分岐を選びます。showはoffsetの数値を表示用の文字列にします。",
  after: [
    "parseUrlの結果はEither<UrlBuildError, Url>です。Rightには読めたUrl、LeftにはこのページのUrlBuildErrorが入ります。成功ならrenderUrlで文字列に戻し、失敗ならその理由をさらに分けます。",
    "InvalidUrlはURLとして読めない場合、UnsupportedUrlSchemeはhttpやhttps以外の方式の場合です。後者にはftpなどの方式名が含まれます。相対リンクが入力なら、既知の基準URLとresolveUrlを使う方法もあります。",
    "UrlContainsUserInfoは空でないユーザー名やパスワードを含む場合です。InvalidPercentEncodingは%の後ろに16進数が2桁そろっていない場合で、offsetにその%の位置が入ります。",
    "型の内部を自由に組み立てる必要はありません。公開されている四つの名前をmatchの分岐に使い、表示したい案内へ変換できます。",
  ],
  details: [
    "InvalidUrlのoffsetは現在0で、構文エラーの正確な位置を示すものではありません。InvalidPercentEncodingのoffsetは0始まりのUTF-16コード単位の位置です。見た目の文字数とは限らず、たとえば😀は2単位です。",
    "parseQueryの場合、offsetは先頭の?を一つ除いた文字列に対する位置です。また、%の綴りの確認は方式やユーザー情報の確認より先なので、複数の問題があるとInvalidPercentEncodingが先に返ることがあります。",
    "navigation.errorMessageは別のNavigationError用で、UrlBuildErrorには使えません。この例のように分岐して案内を作ります。%FFのように桁が正しくても不正なUTF-8の並びはこのエラーにならず、urlFragmentの読み取りがURIErrorを投げる場合があります。",
  ],
}
