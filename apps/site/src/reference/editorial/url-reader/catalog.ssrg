import { editorial as case0 } from "./module/page"
import { editorial as case1 } from "./url/page"
import { editorial as case2 } from "./query/page"
import { editorial as case3 } from "./urlbuilderror/page"
import { editorial as case4 } from "./parseurl/page"
import { editorial as case5 } from "./resolveurl/page"
import { editorial as case6 } from "./renderurl/page"
import { editorial as case7 } from "./emptyquery/page"
import { editorial as case8 } from "./parsequery/page"
import { editorial as case9 } from "./appendquery/page"
import { editorial as case10 } from "./setquery/page"
import { editorial as case11 } from "./removequery/page"
import { editorial as case12 } from "./queryvalues/page"
import { editorial as case13 } from "./queryentries/page"
import { editorial as case14 } from "./renderquery/page"
import { editorial as case15 } from "./urlquery/page"
import { editorial as case16 } from "./withquery/page"
import { editorial as case17 } from "./urlfragment/page"
import { editorial as case18 } from "./withfragment/page"
import { editorial as case19 } from "./withoutfragment/page"
import { ReferenceSymbol } from "../../../model/build"
import { Block } from "../../../model/page"
import { Editorial, editorialBlocks } from "../model"

// Only exact identities with their canonical owner, namespace and kind receive copy.
pub fn urlReaderEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.module != "std/web/navigation" then
    Nothing
  else
    match (symbol.namespace, symbol.itemKind) {
  ("type", "opaque-type") -> editorialGroup0 symbol.identity
  ("value", "function") -> editorialGroup1 symbol.identity
  ("value", "value") -> editorialGroup2 symbol.identity
  _ -> Nothing
}

fn editorialGroup0 identity: String -> Maybe<Editorial> = match identity {
  "std/web/navigation::Url" -> Just (case1 ())
  "std/web/navigation::Query" -> Just (case2 ())
  "std/web/navigation::UrlBuildError" -> Just (case3 ())
  _ -> Nothing
}

fn editorialGroup1 identity: String -> Maybe<Editorial> = match identity {
  "std/web/navigation::parseUrl" -> Just (case4 ())
  "std/web/navigation::resolveUrl" -> Just (case5 ())
  "std/web/navigation::renderUrl" -> Just (case6 ())
  "std/web/navigation::parseQuery" -> Just (case8 ())
  "std/web/navigation::appendQuery" -> Just (case9 ())
  "std/web/navigation::setQuery" -> Just (case10 ())
  "std/web/navigation::removeQuery" -> Just (case11 ())
  "std/web/navigation::queryValues" -> Just (case12 ())
  "std/web/navigation::queryEntries" -> Just (case13 ())
  "std/web/navigation::renderQuery" -> Just (case14 ())
  "std/web/navigation::urlQuery" -> Just (case15 ())
  "std/web/navigation::withQuery" -> Just (case16 ())
  "std/web/navigation::urlFragment" -> Just (case17 ())
  "std/web/navigation::withFragment" -> Just (case18 ())
  "std/web/navigation::withoutFragment" -> Just (case19 ())
  _ -> Nothing
}

fn editorialGroup2 identity: String -> Maybe<Editorial> = match identity {
  "std/web/navigation::emptyQuery" -> Just (case7 ())
  _ -> Nothing
}

pub fn urlReaderModuleBlocks specifier: String -> Array<Block> =
  editorialBlocks (match specifier {
    "std/web/navigation" -> Just (case0 ())
    _ -> Nothing
  }
)
