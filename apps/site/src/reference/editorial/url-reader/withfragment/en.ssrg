import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "withFragment sets section text on a Url and returns a new Url. Supply ordinary text without a leading # or prior percent encoding.",
  taskTitle: "Point a search link at its results section",
  purpose: "Add the section name results 2 to a link that already has search conditions. Produce the complete link and read the section back to confirm the value.",
  typescriptBefore: "The TypeScript version copies the URL, assigns encodeURIComponent's result to hash, and reads the sections from both versions. The copy is useful here because the example checks that the original still has no section.",
  benefit: "withFragment accepts ordinary section text and returns a URL with that text encoded. The original link, its path, and its search conditions remain available without a copy step.",
  setup: "navigation is the import alias for std/web/navigation. navigation.withFragment \"results 2\" original passes the section String before the Url, separated by spaces. let names the new Url. : and -> declare function input and return types.",
  after: [
    "sectionLink matches parseUrl's result. Right original is the checked Url; Left _ returns a rejection message and ignores the detailed reason. Only the successful Url is edited.",
    "renderUrl shows the section as results%202 because its space is encoded. Pass the section text to withFragment rather than concatenating it onto the link yourself.",
    "urlFragment reads it back as Maybe<String>. Just section carries the decoded results 2; Nothing means there is no nonempty section. sectionText uses match to display either Section: followed by the text or No section.",
    "The final No section comes from the original URL, which was not changed. The edited URL retains its path and query. Supplying an empty string to withFragment would remove its fragment.",
  ],
  details: [
    "Do not pass #results when you mean the section results. The # would be treated as section content and encoded as %23. Omit the marker.",
    "Pass actual spaces instead of pre-encoded %20 text. Otherwise the percent sign is encoded again, and the section text will not be what you intended.",
    "Building the link does not check that an element with this section name exists and does not scroll to it. Use withoutFragment when your next task is simply to remove the section.",
  ],
}
