import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "queryValues returns every value for a name, in its original order. Use it to restore repeated tag selections. A missing name produces an empty array.",
  taskTitle: "Read all selected tags from a link",
  purpose: "Recover the tag selections from shared query text. A multi-select filter needs every tag, rather than just the first matching value. Also distinguish a missing condition from a present empty value.",
  typescriptBefore: "TypeScript uses URLSearchParams.getAll(\"tag\"). get would return only one value, so getAll fits this task. A missing name returns an empty array; a present empty value returns an array containing an empty string.",
  benefit: "queryValues supplies the selected values as an array of strings without changing the Query. You do not need to inspect every pair yourself to collect one name.",
  setup: "navigation, arrays, and text are import aliases for std/web/navigation, std/array, and std/text. Calls separate arguments with spaces; let names results. pairText takes pair: (String, String), a two-string pair, and -> String declares its output type.",
  after: [
    "match handles parseQuery's result. Right query supplies the Query; Left _ returns Query rejected without using the reason. queryValues takes the name before the Query and returns Array<String>, an array of strings.",
    "The tag values are books and music in order. text.join combines strings using its first argument as the separator. arrays.length counts values, and show converts each count to display text: Missing count: 0 and Empty count: 1.",
    "A missing name produces [], whereas empty= produces an array with one empty string. The counts establish the difference even when printing an empty value would make it hard to see.",
    "The final line also lists every entry. queryEntries supplies pairs, pairText matches each as (name, value), and [pairText pair | pair <- pairs] builds one display string per pair. Its = and | characters are presentation, not URL encoding.",
  ],
  details: [
    "Do not determine presence from the printed appearance of an array alone. An empty array and an array containing an empty string can look alike; inspect the element count.",
    "Names are case-sensitive, so tag and Tag are separate selections. Use queryEntries when you need to inspect all names as well as their values.",
    "The returned values are decoded strings, not a way to edit the original Query. Use setQuery or appendQuery to build changed conditions and retain the Query those operations return.",
  ],
}
