import { UrlReaderCopy } from "../model"

pub fn copy -> UrlReaderCopy = UrlReaderCopy {
  summary: "queryValuesは、指定した名前の値をすべて、元の順番で返します。同じ名前が繰り返されるタグの読み取りに使え、見つからない場合は空の配列になります。",
  taskTitle: "リンクから選択済みのタグを読み戻す",
  purpose: "共有されたクエリから、選択されているtagをすべて取り出します。複数選択の復元では、最初の値だけでなく後ろの値も使います。",
  typescriptBefore: "TypeScriptではURLSearchParams.getAll(\"tag\")を使います。getは一つだけを読むので、この用途ではgetAllが適しています。存在しない名前なら空の配列、空の値が存在すれば空文字列を含む配列になります。",
  benefit: "queryValuesで複数の値をまとめて取り出せます。Queryそのものを変更せずに、フォームの選択状態へ使える文字列の配列が得られます。",
  setup: "navigationはstd/web/navigation、arraysはstd/array、textはstd/textの別名です。関数と引数を空白で並べて呼び、letで途中の値に名前を付けます。pairTextのpair: (String, String)は文字列の二つ組の引数、-> Stringは戻り値の型です。",
  after: [
    "parseQueryをmatchで分け、RightのQueryからtag、missing、emptyの値を読みます。Left _は失敗時のQuery rejectedを返し、_はここでは理由を使わない印です。queryValuesが返すArray<String>は文字列の配列です。",
    "tagの結果はbooks、musicの順です。text.joinは配列の文字列を指定の区切りでつなぎます。arrays.lengthは個数、showはその数値の文字列で、Missing count: 0とEmpty count: 1を表示します。",
    "見つからない名前の結果は[]です。一方、empty=のような項目があると結果は空文字列を一つ含む配列になります。例では個数も示して、この二つを見分けます。",
    "最後の行は全項目も表示します。queryEntriesの各組をpairTextのmatchで(name, value)に分けます。[pairText pair | pair <- pairs]は各組を順にpairTextへ渡し、表示用の文字列の配列を作ります。出力中の「=」や「 | 」は読みやすくする区切りで、URL用のエンコードではありません。",
  ],
  details: [
    "空の配列も、空文字列を一つ含む配列も、表示の仕方によっては似て見えます。文字列化した見た目だけに頼らず、要素数を調べて存在するかを判断します。",
    "名前は大文字と小文字を区別します。tagとTagを一緒に集める処理ではありません。すべての名前と値を確認したいときはqueryEntriesを使います。",
    "返り値は復号済みの文字列の配列で、元のQueryを直接編集する入口ではありません。リンクの条件を置き換えるにはsetQuery、追加するにはappendQueryを使い、その戻り値を利用します。",
  ],
}
