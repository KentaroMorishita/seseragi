import { BytesInspectionCopy } from "../model"

pub fn copy -> BytesInspectionCopy = BytesInspectionCopy {
  summary: "Byteは、0から255までの整数を表す型です。普通のIntとは別の型で、内部の表現を直接取り出す代わりにstd/bytesの操作を使います。",
  taskTitle: "1バイトとして使える値だけを受け取る",
  purpose: "数値を1バイトとして使う前に、0から255までに収まるか確認します。0と255は受け入れ、-1と256は理由を表示します。ここでは1つの値を表すByteと、複数のバイトを並べたBytesを区別します。",
  typescriptBefore: "TypeScriptではNumber.isIntegerと上下限の比較で検証します。numberには小数なども含まれるため、整数かどうかも調べます。この成功経路のvalueは通常のnumberのままで、Byteという別の型にはなりません。Uint8Arrayにそのまま渡すと範囲外の値も変換されるので、拒否したい場合はこのような検証が必要です。",
  benefit: "両方とも短く書けます。Seseragiでは検証で得た値がByteになり、Byteを受け取る操作と普通のIntを受け取る操作を型で区別できます。成功した値を使う前に、検証結果の成功と失敗を分けます。",
  setup: "import * as bytesは、std/bytesの公開された名前をbytesという別名で使えるようにします。fn describe value: Int -> Stringは、整数のvalueを受け取り文字列を返す関数です。bytes.byte valueのように、関数名の後へ空白で引数を渡します。",
  after: [
    "bytes.byte valueはEither<ByteError, Byte>を返します。Eitherはここでは失敗のLeftか成功のRightのどちらかです。matchは、返った結果に合う枝を選びます。Byteそのものが返るわけではありません。",
    "Left (bytes.ByteOutOfRange invalid)では、失敗の中にあるByteOutOfRangeを調べ、拒否された整数をinvalidという名前で受け取ります。ByteOutOfRangeはエラーの形であり、Byteの内部を取り出す形ではありません。",
    "Right checkedは、成功したByteにcheckedという名前を付けます。bytes.toInt checkedはそのByteをIntに変える公開された操作です。checkedを普通の数値として表示したいこの場所で使います。",
    "バッククォートで囲む文字列の${...}には、変数や計算結果を埋め込みます。各枝の->の右側が返す文字列になり、describeの呼び出し元へ戻ります。",
    "for value <- [0, 255, -1, 256]は、配列の各整数に順にvalueという名前を付けます。describe valueで1つずつ検証するので、出力の先頭2行は成功、後ろ2行は範囲外になります。",
  ],
  details: [
    "Byteの有効範囲は0以上255以下で、両端を含みます。Intの65も、そのままではByteではありません。Byteを要求する関数へ渡すには、まずbyteなどでByteを得ます。",
    "Byteの公開コンストラクターやByteというパターンはありません。byteで検証するほか、BytesからgetなどでByteを得られます。getの結果はMaybe<Byte>なので、その場合はJustとNothingを分けます。数値として読むにはtoIntを使います。",
    "Either<ByteError, Byte>全体もByteとは別の型です。検証結果をそのままtoIntに渡すことはできません。この例のRight checkedのように、成功したByteを受け取ってから使います。",
  ],
}
