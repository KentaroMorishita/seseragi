import { BytesInspectionCopy } from "../model"

pub fn copy -> BytesInspectionCopy = BytesInspectionCopy {
  summary: "concat takes an array of Bytes and joins them into one Bytes value in array order. Empty chunks contribute no elements, and an empty array produces empty Bytes.",
  taskTitle: "Join several byte sequences, including an empty one",
  purpose: "Join [10, 20], an empty sequence, and [30] in that order. Also try an array with no sequences, then check that the input sequences keep their original contents.",
  typescriptBefore: "TypeScript converts each Uint8Array to an ordinary array with Array.from, flattens those arrays in order with flatMap, and passes the result to Uint8Array.from. This is a comparison for small, readable inputs. The numbers already fit in the byte range, and empty typed arrays can be included in the same operation.",
  benefit: "Seseragi’s concat takes Array<Bytes> directly. You do not need to convert each sequence to an integer array just to join it. One operation expresses the order and the handling of empty chunks.",
  setup: "import * as bytes gives std/bytes the alias bytes. bytes.fromInts [10, 20] passes an integer array after a space and validates it to produce Bytes. Two calls separated by a comma inside parentheses form a tuple.",
  after: [
    "fromInts returns Either<ByteError, Bytes>, with Left for failure and Right for success. The match pattern (Right first, Right last) selects two successes and binds their Bytes to first and last. The _ branch handles anything else, meaning at least one validation failed.",
    "let joined = ... gives the result the name joined. The argument to bytes.concat [first, bytes.empty (), last] is an array of Bytes. In bytes.empty (), () is a Unit value and the call creates empty Bytes.",
    "concat joins the elements of first, the empty sequence, and last in that order, so joined contains [10, 20, 30]. The empty sequence does not insert a byte of value 0 or a separator.",
    "bytes.concat [] passes an array with no chunks. Because concat requires Array<Bytes>, that is the type of this empty array. The resulting Bytes is empty too, so the second output line is [].",
    "do { ... } runs the display steps from top to bottom. bytes.toInts converts Bytes to an integer array, then show makes a String for printing. The last two lines show the original first and last, still containing [10, 20] and [30], rather than the joined result.",
  ],
  details: [
    "concat flattens one level of Array<Bytes>. It does not directly accept an array of integers. To create chunks from integers, validate with fromInts and put the resulting Bytes values into the array.",
    "Both an empty array and an array containing only empty Bytes produce empty Bytes. The order within each nonempty chunk and the order of the chunks in the array are preserved.",
    "The result is directly Bytes; there is no join result to unpack from Either. The input chunks keep their contents too. For just two chunks, you can also use append, which takes the suffix first.",
  ],
}
