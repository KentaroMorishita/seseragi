import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { Editorial } from "../model"

pub struct BytesInspectionCopy {
  summary: String,
  taskTitle: String,
  purpose: String,
  typescriptBefore: String,
  benefit: String,
  setup: String,
  after: Array<String>,
  details: Array<String>
}
fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  [Paragraph ([Words (localized en ja)]) | (en, ja) <- arrays.zip japanese english]
fn link title: String -> route: String -> english: String -> japanese: String -> Block =
  Paragraph (
    [
      InternalLink (localized title title, route),
      Words (localized (": " + english) ("：" + japanese))
    ]
  )

pub fn bytesInspectionEditorial identity: String
  -> namespace: String
  -> itemKind: String
  -> source: String
  -> english: BytesInspectionCopy
  -> japanese: BytesInspectionCopy
  -> Editorial =
  Editorial {
    identity,
    namespace,
    itemKind,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-operation", localized english.taskTitle japanese.taskTitle),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        Heading (
          "typescript-comparison",
          localized "Start with familiar TypeScript" "TypeScriptの処理から考える"
        ),
        Paragraph
          ([Words (localized english.typescriptBefore japanese.typescriptBefore)]),
        CodeExample (
          "bytes-inspection-" + source + "-ts",
          localized "TypeScript · Node 24.19.0 / Bun 1.3.9"
          "TypeScript・Node 24.19.0 / Bun 1.3.9"
        ),
        Terminal (localized "TypeScript output" "TypeScriptの実行結果", output source),
        Heading (
          "seseragi-example",
          localized "Write the same task in Seseragi" "Seseragiで同じ処理を書く"
        ),
        CodeExample (
          "bytes-inspection-" + source,
          localized "Complete Seseragi program" "Seseragiの完全なプログラム"
        ),
        Terminal (localized "Seseragi output" "Seseragiの実行結果", output source),
        Paragraph ([Words (localized english.benefit japanese.benefit)]),
        Heading ("reading-the-example", localized "Read the important lines" "大事な行を読む"),
        Paragraph ([Words (localized english.setup japanese.setup)])
      ],
      paragraphs english.after japanese.after,
      [
        Paragraph (
          [Words (
            localized
          "pub effect fn main is the public program entry. effect permits printing here; println writes a String and a newline. The byte operations themselves return values without printing. The TypeScript declaration export {} keeps this file separate during checking and does not change its output."
          "pub effect fn mainはプログラムの公開された実行入口です。effectを付けることで、ここから表示を行えます。printlnはStringと改行を表示します。バイト列の操作そのものは表示せず、値を返します。TypeScriptのexport {}は型を確認するときにこのファイルをほかと分ける宣言で、表示結果は変えません。"
          )]
        ),
        Paragraph (
          [Words (
            localized
          "Save the complete Seseragi source with the filename below and run it locally, or open its Playground link. These examples use small in-memory values. Only printing needs Console; no file, network, browser storage or process-settings service is used. The TypeScript source uses the same native APIs on the two labelled runtimes."
          "Seseragiの完全なソースを下のファイル名で保存するとローカルで実行できます。Playgroundのリンクからも開けます。例で使うのはプログラム内の小さな値です。表示にだけConsoleを使い、ファイル・ネットワーク・ブラウザーの保存領域・プロセスの設定は使いません。TypeScriptのソースは、見出しに示した二つの実行環境で同じ標準APIを使います。"
          )]
        ),
        Terminal (
          localized "Run locally" "ローカルで実行する",
          "seseragi run " + source + ".ssrg --target process"
        ),
        Heading ("operation-rules", localized "Rules and common mistakes" "規則と間違いやすい点")
      ],
      paragraphs english.details japanese.details,
      [Heading ("choose-next", localized "Choose the next operation" "次に必要な操作を選ぶ")],
      related identity,
      [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
}

fn output source: String -> String = match source {
  "validate-one-byte" -> "Byte: 0\nByte: 255\nOut of range: -1\nOut of range: 256\n"
  "empty-and-singleton" -> "Empty\nBytes: [65]\n"
  "inspect-byte" -> "Index 0: 0\nIndex 2: 255\nIndex 3: missing\nIndex -1: missing\n"
  "checked-range" -> "[20, 30]\n[]\nInvalid range 3..1 for 4 bytes\nInvalid range -1..2 for 4 bytes\nInvalid range 0..5 for 4 bytes\n[10, 20, 30, 40]\n"
  "append-chunk" -> "[10, 20, 30, 40]\n[10, 20, 30, 40]\n[30, 40, 10, 20]\n[10, 20]\n[30, 40]\n"
  "join-chunks" -> "[10, 20, 30]\n[]\n[10, 20]\n[30]\n"
  _ -> ""
}

fn related identity: String -> Array<Block> = match identity {
  "std/bytes::Byte" -> [
    link "byte" "/docs/library/bytes/function/byte/"
      "validate an integer before using it as a Byte." "整数を確認してからByteとして使います。",
    link "toInt" "/docs/library/bytes/function/toint/"
      "read the numeric value of a Byte." "Byteの数値を読み取ります。",
    link "get" "/docs/library/bytes/function/get/" "read one optional byte from Bytes."
      "Bytesの一つの位置を、値がない場合も含めて調べます。",
  ]
  "std/bytes::BytesSliceError" -> [
    link "slice" "/docs/library/bytes/function/slice/"
      "check and extract a half-open byte range." "開始を含み終了を含まない範囲を確認して取り出します。",
    link "get" "/docs/library/bytes/function/get/"
      "inspect one position without extracting a range." "範囲を切り出さず一つの位置を調べます。",
    link "Bytes" "/docs/library/bytes/opaque-type/bytes/"
      "understand the byte sequence used by these operations." "これらの操作で使うバイト列を確認します。",
  ]
  "std/bytes::byte" -> [
    link "Byte" "/docs/library/bytes/opaque-type/byte/"
      "understand a validated single byte." "確認済みの一つのバイトを理解します。",
    link "fromInts" "/docs/library/bytes/function/fromints/"
      "check an integer array before making Bytes." "整数の配列を確認してBytesを作ります。",
    link "toInts" "/docs/library/bytes/function/toints/"
      "display the bytes as an integer array." "バイト列を整数の配列で表示します。",
  ]
  "std/bytes::toInt" -> [
    link "Byte" "/docs/library/bytes/opaque-type/byte/"
      "understand a validated single byte." "確認済みの一つのバイトを理解します。",
    link "fromInts" "/docs/library/bytes/function/fromints/"
      "check an integer array before making Bytes." "整数の配列を確認してBytesを作ります。",
    link "toInts" "/docs/library/bytes/function/toints/"
      "display the bytes as an integer array." "バイト列を整数の配列で表示します。",
  ]
  "std/bytes::empty" -> [
    link "get" "/docs/library/bytes/function/get/"
      "inspect a position and handle its absence." "位置を調べ、値がない場合も扱います。",
    link "fromInts" "/docs/library/bytes/function/fromints/"
      "check an integer array before making Bytes." "整数の配列を確認してBytesを作ります。",
    link "toInts" "/docs/library/bytes/function/toints/"
      "display the bytes as an integer array." "バイト列を整数の配列で表示します。",
  ]
  "std/bytes::singleton" -> [
    link "get" "/docs/library/bytes/function/get/"
      "inspect a position and handle its absence." "位置を調べ、値がない場合も扱います。",
    link "fromInts" "/docs/library/bytes/function/fromints/"
      "check an integer array before making Bytes." "整数の配列を確認してBytesを作ります。",
    link "toInts" "/docs/library/bytes/function/toints/"
      "display the bytes as an integer array." "バイト列を整数の配列で表示します。",
  ]
  "std/bytes::isEmpty" -> [
    link "get" "/docs/library/bytes/function/get/"
      "inspect a position and handle its absence." "位置を調べ、値がない場合も扱います。",
    link "fromInts" "/docs/library/bytes/function/fromints/"
      "check an integer array before making Bytes." "整数の配列を確認してBytesを作ります。",
    link "toInts" "/docs/library/bytes/function/toints/"
      "display the bytes as an integer array." "バイト列を整数の配列で表示します。",
  ]
  "std/bytes::get" -> [
    link "BytesSliceError" "/docs/library/bytes/opaque-type/bytessliceerror/"
      "read the bounds of a rejected slice." "切り出しに失敗した範囲を読み取ります。",
    link "fromInts" "/docs/library/bytes/function/fromints/"
      "check an integer array before making Bytes." "整数の配列を確認してBytesを作ります。",
    link "toInts" "/docs/library/bytes/function/toints/"
      "display the bytes as an integer array." "バイト列を整数の配列で表示します。",
  ]
  "std/bytes::slice" -> [
    link "BytesSliceError" "/docs/library/bytes/opaque-type/bytessliceerror/"
      "read the bounds of a rejected slice." "切り出しに失敗した範囲を読み取ります。",
    link "fromInts" "/docs/library/bytes/function/fromints/"
      "check an integer array before making Bytes." "整数の配列を確認してBytesを作ります。",
    link "toInts" "/docs/library/bytes/function/toints/"
      "display the bytes as an integer array." "バイト列を整数の配列で表示します。",
  ]
  "std/bytes::append" -> [
    link "concat" "/docs/library/bytes/function/concat/" "join an array of byte chunks."
      "バイト列の配列を順番につなぎます。",
    link "fromInts" "/docs/library/bytes/function/fromints/"
      "check an integer array before making Bytes." "整数の配列を確認してBytesを作ります。",
    link "toInts" "/docs/library/bytes/function/toints/"
      "display the bytes as an integer array." "バイト列を整数の配列で表示します。",
  ]
  "std/bytes::concat" -> [
    link "append" "/docs/library/bytes/function/append/" "join two byte chunks."
      "二つのバイト列をつなぎます。",
    link "fromInts" "/docs/library/bytes/function/fromints/"
      "check an integer array before making Bytes." "整数の配列を確認してBytesを作ります。",
    link "toInts" "/docs/library/bytes/function/toints/"
      "display the bytes as an integer array." "バイト列を整数の配列で表示します。",
  ]
  _ -> []
}
