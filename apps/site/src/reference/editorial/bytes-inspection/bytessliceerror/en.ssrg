import { BytesInspectionCopy } from "../model"

pub fn copy -> BytesInspectionCopy = BytesInspectionCopy {
  summary: "BytesSliceError describes a range rejected by slice. Read the requested bounds and the input length from the start, end, and length fields of InvalidByteRange.",
  taskTitle: "Explain exactly which slice range was rejected",
  purpose: "Instead of reporting only that extraction failed, display the requested start and end alongside the actual byte count. Include a successful ordinary range and an empty range to see which requests were rejected.",
  typescriptBefore: "The TypeScript example validates the range and, if it is invalid, builds an explanation from the requested bounds and content.length. Uint8Array.slice itself clamps bounds and counts negative positions from the end, so this rejection behavior needs an explicit check.",
  benefit: "In Seseragi, a slice failure is a BytesSliceError value whose returned reason contains the bounds and length. The code that builds the message does not have to implement range validation again.",
  setup: "import * as bytes exposes std/bytes names through the alias bytes. fn extract start: Int -> end: Int -> content: bytes.Bytes -> String makes a String from two integer bounds and Bytes. bytes.slice start end content is a call with arguments separated by spaces.",
  after: [
    "bytes.fromInts [10, 20, 30, 40] returns Either<ByteError, Bytes>: Left error is a numeric-input failure, and Right content contains successful Bytes. This input validation is a separate stage from the range validation inside extract.",
    "bytes.slice start end content returns Either<BytesSliceError, Bytes>. The Left branch of match receives this page’s error type. Right part instead receives extracted Bytes, which bytes.toInts and show turn into a string displaying its numeric contents.",
    "Left (bytes.InvalidByteRange { start, end, length }) matches the record inside the public InvalidByteRange constructor. The { start, end, length } pattern binds each field value to a local variable with the same name.",
    "start and end are the requested bounds, and length is the input’s byte count. Inserting them at ${...} in a backtick string shows that 3..1, -1..2, and 0..5 are all invalid requests for four bytes. The expression after the branch’s -> is the String returned by extract.",
    "do { ... } runs the display steps from top to bottom. Positions 1 up to 3 produce [20, 30], and 2 up to 2 produces []. Parenthesize a negative argument as in extract (-1) 2 content. The last line also confirms that the original input keeps its contents.",
  ],
  details: [
    "The range includes the start and excludes the end. Its valid bounds satisfy 0 <= start <= end <= length. An empty range with equal bounds succeeds, including when both equal length. Requesting 0 to 0 from empty Bytes is not an error either.",
    "BytesSliceError is classified as opaque-type, but InvalidByteRange is a public constructor. You can match it as shown or directly construct a reason with start, end, and length fields. This differs from Byte, which has no public Byte value constructor.",
    "Constructing an InvalidByteRange value does not validate any range. You can even give it numbers that describe a valid range. A reason establishes that slice rejected a request when it was actually returned by slice in Left.",
  ],
}
