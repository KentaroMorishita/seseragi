import { BytesInspectionCopy } from "../model"

pub fn copy -> BytesInspectionCopy = BytesInspectionCopy {
  summary: "singletonはByteを1つ受け取り、そのバイトだけを含むBytesを作ります。Intではなく、Byteを渡す点が重要です。",
  taskTitle: "検証した数値から1バイトだけの列を作る",
  purpose: "65が有効な1バイトであることを確かめ、1要素のBytesを作ります。空の列も先に表示して、中身が0個の場合と1個の場合を見比べます。",
  typescriptBefore: "TypeScriptのUint8Array.of(value)は1要素の型付き配列を作れます。この例では整数かつ0から255までであることを先に調べ、変換によって範囲外の数値が折り返されるのを避けます。成功経路でもvalueの型は普通のnumberです。",
  benefit: "singleton自体は短い操作です。SeseragiではByteを引数に要求するため、数値の検証を終えてから1要素のBytesを作る順序が型に表れます。singletonへ渡した後に範囲エラーを処理する必要はありません。",
  setup: "import * as bytesでstd/bytesの名前をbytes経由で使います。fn describe content: bytes.Bytes -> Stringは、contentというBytesから表示文字列を作る関数です。bytes.singleton checkedのように、関数の引数は空白で渡します。",
  after: [
    "mainのdo { ... }は、上から順に処理するブロックです。bytes.empty ()へ渡す()はUnitの値で、空のBytesが作られます。describeはこれを最初のEmptyという行にします。",
    "bytes.byte 65は、整数の65を検証してEither<ByteError, Byte>を返します。EitherのLeftは失敗、Rightは成功です。matchのLeft errorは失敗に名前を付け、showでその内容を表示します。",
    "Right checkedは成功したByteをcheckedとして受け取ります。bytes.singleton checkedは、そのByteを1つ含むBytesを返します。括弧を付けたdescribe (bytes.singleton checked)で、その結果をdescribeに渡します。",
    "describeはif ... then ... else ...で文字列を選びます。bytes.isEmpty contentが返すBoolは1要素の列ではFalseなので、else側の表示になります。",
    "bytes.toInts contentは中身を整数の配列にし、showはその配列を文字列にします。バッククォート内の${...}へ埋め込むとBytes: [65]になります。検証した値が1つだけ入ったことを確認できます。",
  ],
  details: [
    "singletonの型はByte -> Bytesです。singleton自身がIntを検証するわけではありません。bytes.singleton 65や、byteのEitherをそのまま渡す書き方では型が合いません。",
    "byteで0や255を検証したByteもsingletonに渡せます。0のByteから作った列も1要素なので、isEmptyはFalseです。空にしたい場合はemptyを使います。",
    "Byteは内部表現が非公開で、公開されたByteコンストラクターはありません。整数からはbyte、既存のBytesからはgetなどでByteを得ます。整数の配列全体をBytesにするならfromIntsを使います。",
  ],
}
