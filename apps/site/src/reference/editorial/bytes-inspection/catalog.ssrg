import { editorial as case0 } from "./byte-type/page"
import { editorial as case1 } from "./bytessliceerror/page"
import { editorial as case2 } from "./byte/page"
import { editorial as case3 } from "./toint/page"
import { editorial as case4 } from "./empty/page"
import { editorial as case5 } from "./singleton/page"
import { editorial as case6 } from "./isempty/page"
import { editorial as case7 } from "./get/page"
import { editorial as case8 } from "./slice/page"
import { editorial as case9 } from "./append/page"
import { editorial as case10 } from "./concat/page"
import { ReferenceSymbol } from "../../../model/build"
import { Editorial } from "../model"

// This family owns only these exact existing std/bytes symbols.
pub fn bytesInspectionEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.module != "std/bytes" then
    Nothing
  else
    match (symbol.namespace, symbol.itemKind) {
  ("type", "opaque-type") -> types symbol.identity
  ("value", "function") -> functions symbol.identity
  _ -> Nothing
}

fn types identity: String -> Maybe<Editorial> = match identity {
  "std/bytes::Byte" -> Just (case0 ())
  "std/bytes::BytesSliceError" -> Just (case1 ())
  _ -> Nothing
}

fn functions identity: String -> Maybe<Editorial> = match identity {
  "std/bytes::byte" -> Just (case2 ())
  "std/bytes::toInt" -> Just (case3 ())
  "std/bytes::empty" -> Just (case4 ())
  "std/bytes::singleton" -> Just (case5 ())
  "std/bytes::isEmpty" -> Just (case6 ())
  "std/bytes::get" -> Just (case7 ())
  "std/bytes::slice" -> Just (case8 ())
  "std/bytes::append" -> Just (case9 ())
  "std/bytes::concat" -> Just (case10 ())
  _ -> Nothing
}
