import { BytesInspectionCopy } from "../model"

pub fn copy -> BytesInspectionCopy = BytesInspectionCopy {
  summary: "emptyはバイトを1つも含まないBytesを作ります。呼び出しはbytes.empty ()で、()はUnitという型の値です。",
  taskTitle: "空のバイト列を作り、1バイトの列と見比べる",
  purpose: "中身がない場合もBytesとして扱えるようにします。空の列ならEmptyと表示し、65を1つ含む列ならBytes: [65]と表示する同じ関数を使います。",
  typescriptBefore: "TypeScriptではnew Uint8Array()が空のバイト列を作り、length === 0で判定できます。1バイトの例では65を検証してからUint8Array.of(value)へ渡します。型付き配列の生成自体は範囲外の数値を拒否する検証ではないためです。",
  benefit: "空の場合にも、値がある場合にも同じBytes型を使えます。空かどうかはisEmptyで調べます。emptyは失敗の値や欠けた値ではなく、中身が0個の通常のBytesを作ります。",
  setup: "import * as bytesはstd/bytesをbytesという別名から使う宣言です。fn describe content: bytes.Bytes -> Stringは、Bytesをcontentとして受け取り文字列を返します。呼び出しではdescribe contentのように空白で引数を渡します。",
  after: [
    "bytes.empty ()は、emptyへUnitの値()を渡して空のBytesを作ります。describe (bytes.empty ())の括弧は、先にそのBytesを得てからdescribeへ渡すことを表します。",
    "describeのif bytes.isEmpty content then ... else ...は、空なら最初の文字列、それ以外なら後ろの文字列を返します。isEmptyの結果はBoolです。ここでは空の列からEmptyが得られます。",
    "mainのdo { ... }は、表示などを上から順に行うブロックです。最初に空の列を表示してからbytes.byte 65を検証します。この結果はEither<ByteError, Byte>で、Leftは失敗、Rightは成功です。",
    "matchのLeft errorは失敗をerrorという名前で受け取り、showで文字列にします。Right checkedは成功したByteをcheckedと名付け、bytes.singleton checkedで1バイトのBytesを作ります。65というIntをそのままsingletonへ渡すわけではありません。",
    "空でない枝ではbytes.toInts contentが整数の配列を返し、showが表示用のStringにします。バッククォート文字列の${...}にその結果を埋め込むので、2行目はBytes: [65]です。",
  ],
  details: [
    "emptyの引数はUnit、戻り値はBytesです。()を渡すだけでよく、元になる配列や検証結果は必要ありません。空の結果をEitherやMaybeから取り出す操作も要りません。",
    "空のBytesは0というバイトを1つ含むBytesとは異なります。前者のisEmptyはTrue、後者はFalseです。バイトの値ではなく要素数が0かを調べます。",
    "emptyで作った値は、appendやconcatに渡す空の列としても使えます。空の列をつないでも、その部分から新しい要素は増えません。",
  ],
}
