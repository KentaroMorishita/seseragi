import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "見た目のまとまりを壊さず範囲を切り出す",
  purpose: "ラベルの先頭二文字だけを見せたいとき、sliceは絵文字の修飾や結合アクセントを分断せずに切り出します。開始位置、終了位置、Stringの順に渡します。0から数え、終了位置の要素は含みません。Rightには切り出した文字列、Leftには不正な範囲の理由が入ります。",
  reading: "preview関数のstartとendはInt、labelはStringで、最後の-> Stringは説明文を返す指定です。matchのRight partは成功した中身にpartという名前を付け、角括弧で囲んで表示します。Left reasonは失敗理由をshowで文字列にして表示します。最初の範囲0から2はAと👍🏽です。",
  boundaries: "範囲1から3は👍🏽と、eに\\u{0301}のアクセントを付けたまとまりです。2から2は空で、preview: []と表示します。終了位置4、開始位置が終了位置より後の2から1、開始位置-1はLeftです。理由のstart・endは渡した値、lengthは実際のまとまりの個数3です。空文字列の0から0は成功します。",
  rules: "成功する範囲は0 <= start <= end <= まとまりの個数です。範囲を自動で丸めません。入力のUTF-8バイト数に比例する処理で、元の文字列は変更せず、切り出し時の正規化も行いません。結果の小さな文字列だけを保持しても、巨大な元の入力を残す必要はありません。",
  mistake: "TypeScriptのString.sliceはUTF-16の単位、配列のsliceは配列の位置を使い、不正な範囲の扱いも異なります。SeseragiのこのsliceにはUTF-8バイト位置やscalarの位置を渡さず、見た目のまとまりを数えた位置を使ってください。Leftを直すには、渡す範囲を実際の個数の中へ修正します。",
}
