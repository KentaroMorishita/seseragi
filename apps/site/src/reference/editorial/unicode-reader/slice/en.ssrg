import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Slice a checked range of complete clusters",
  purpose: "To show only the first two perceived characters of a label, slice keeps emoji modifiers and combining accents with their clusters. Pass start, end, then the String. Positions start at zero and the end is excluded. Right contains the substring; Left contains an invalid-range reason.",
  reading: "preview takes Int start and end positions and a String label; the final -> String specifies its message result. In match, Right part names the successful substring and adds display brackets. Left reason uses show to turn the failure reason into text. The first range, zero up to two, contains A and 👍🏽.",
  boundaries: "The range one up to three contains 👍🏽 and e with its \\u{0301} accent. Two up to two is empty, displayed as preview: []. End four, reversed bounds two up to one, and start minus one return Left. Its start/end fields retain the supplied values and length is the actual cluster count, three. Zero up to zero on empty text succeeds.",
  rules: "A valid range satisfies 0 <= start <= end <= cluster count. Bounds are not clamped. Work is linear in UTF-8 input length; the input is unchanged and the substring is not normalized. Keeping a small result does not require keeping a much larger original input alive.",
  mistake: "TypeScript String.slice uses UTF-16 units; array slice uses array positions, with different handling of invalid bounds. Pass cluster positions here, not UTF-8 byte or scalar offsets. Repair a Left result by choosing a range within the actual cluster count.",
}
