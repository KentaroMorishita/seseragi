import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "大文字・小文字の違いをそろえる比較用文字列を作る",
  purpose: "StraßeとSTRASSEを、大文字・小文字の違いを除いて比べたいときに使います。fullCaseFoldはUnicodeの既定の比較規則に従い、両方をstrasseへ変えます。この比較用の変換をcase foldingと呼びます。表示用の元の文字列を残し、必要な比較のために結果を使えます。",
  reading: "letで元の文字列にoriginal、変換結果にfoldedという名前を付けます。foldedはstrasseで、originalはStraßeのままです。same comparisonでは、STRASSEも変換して==で文字列を比べます。両方ともstrasseなのでTrueです。小文字への変換だけではßがssにならず、この比較と結果が違います。",
  boundaries: "İはiと結合した点U+0307へ、Σとςは両方ともσへ変わります。Unicodeの文字番号の単位をscalarと呼びます。accent scalarsが2なのは、入力のeと結合アクセントU+0301が二つのscalarのまま残るためです。fullCaseFoldは正規化を行いません。最後の[]は、空文字列を変換した結果も空であることを示します。",
  rules: "一つのscalarが複数へ広がることがあり、例のßはssになります。処理量は入力と出力のバイト数に比例します。規則は言語設定によらず、トルコ語などを指定する引数もありません。std/textのcaseFoldでも同じ結果が得られます。文字列の長さや位置を使う場合は、変換後の値について計算してください。",
  mistake: "比較用に変換したstrasseから、元がStraßeだったかSTRASSEだったかは復元できません。表示に元の表記が必要ならoriginalを残してください。TypeScriptのtoLowerCaseはStraßeをstraßeにするため、この操作の代わりにはなりません。正規化、言語ごとの並べ替え、利用者名の安全性判定には、それぞれ別の方針が必要です。",
}
