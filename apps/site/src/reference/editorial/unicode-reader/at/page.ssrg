import { Editorial } from "../../model"
import { unicodeEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  unicodeEditorial "std/text/grapheme::at" "unicode-at" "found: 👍🏽\nfound: é\nnot found\nnot found\nnot found" "std/text/grapheme" (en.copy ()) (ja.copy ())
