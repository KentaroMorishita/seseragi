import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Read a cluster at a checked position",
  purpose: "To inspect the second perceived character, pass its position and the string to at. Positions start at zero. Maybe<String> is either Just containing the cluster or Nothing when that position does not exist. A cluster can contain multiple Unicode code values, called scalars. It is therefore a String rather than a Char, which holds one scalar.",
  reading: "fn defines labelAt. index: Int is the integer position, value: String is the input, and the final -> String names the result type of the descriptive message. match inspects at’s result: Just piece names the contained string piece, while Nothing returns not found.",
  boundaries: "In label, position zero is A, one is 👍🏽, and two is e with the accent written as \\u{0301}. The first two calls return complete clusters. A negative position, position three equal to the count, and position zero in empty text all produce Nothing, giving the last three not found lines.",
  rules: "Work is linear in UTF-8 input length; indexed access is not guaranteed constant-time. Clusters follow the pinned Unicode version. The original text and accent spelling stay unchanged. A negative position does not count backward from the end.",
  mistake: "Do not pass an index measured in TypeScript UTF-16 units without considering the unit. Choose the indexing unit first. Handle both Maybe cases as this example does instead of assuming a value exists where the result can be Nothing.",
}
