import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "指定した位置の見た目のまとまりを取り出す",
  purpose: "二文字目の表示内容を調べるときは、atに位置と文字列を渡します。位置は0から数えます。結果のMaybe<String>は、取り出せた文字列を持つJustか、その位置がないNothingです。一つのまとまりにUnicodeの番号の単位であるscalarが複数入ることがあるため、結果はStringです。Charはscalar一個を表す型です。",
  reading: "fnはlabelAtという関数を定義します。index: Intは整数の位置、value: Stringは調べる文字列、最後の-> Stringは返す説明文の型です。matchはatの結果を調べ、Just pieceでは中の文字列にpieceという名前を付けます。Nothingの場合も処理してnot foundを返します。",
  boundaries: "labelの位置0はA、1は👍🏽、2はeと結合アクセントです。\\u{0301}はそのアクセントの表記です。最初の二回はまとまり全体を返します。負の位置、個数と等しい3、空文字列の位置0はすべてNothingなので、最後の三行はnot foundです。",
  rules: "入力のUTF-8バイト数に比例する処理を行い、位置の読み取りを定数時間とは保証しません。Unicodeの固定版でまとまりを判定します。元の文字列も、結合アクセントの綴りも変わりません。負の位置を末尾から数える規則はありません。",
  mistake: "TypeScriptの文字列インデックスはUTF-16の単位なので、その数値をそのまま渡さないでください。まず必要な単位を選びます。結果がNothingかもしれない場所で、中身をあるものとして使うのではなく、この例のように両方の場合を扱ってください。",
}
