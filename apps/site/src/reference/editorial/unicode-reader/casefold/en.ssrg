import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Use Unicode full case folding from std/text",
  purpose: "Use caseFold in code that already imports std/text when a comparison should follow Unicode’s case-insensitive mapping. It returns the same result as std/text/unicode.fullCaseFold. For example, Straße and STRASSE both become strasse.",
  reading: "let names Straße as stored and STRASSE as entered. The first comparison uses toLower: straße and strasse differ, so it is False. The next comparison applies caseFold to both values and compares them with ==, giving True. The folded text line shows the comparison string strasse.",
  boundaries: "same API result compares caseFold and unicode.fullCaseFold on the same stored value. Both names provide the same transformation, so it is True. stored and entered stay unchanged and remain available for display.",
  rules: "Case folding is Unicode’s transformation for comparisons that ignore case distinctions. It is independent of locale and can increase length, such as ß becoming ss. Work is proportional to input and output byte counts. Normalization is a separate operation; choose an explicit form in your application when it is needed.",
  mistake: "Choose toLower when the task is to display a lowercase label. A caseFold result is for comparison and need not be reversible to the original spelling. The fullCaseFold explanation covers accent and Greek-letter boundaries. Do not substitute TypeScript’s toLowerCase as though it used the same comparison rules.",
}
