import { Editorial } from "../../model"
import { unicodeEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  unicodeEditorial "std/text::caseFold" "unicode-casefold" "lowercase equal: False\nfolded equal: True\nfolded text: strasse\nsame API result: True" "std/text" (en.copy ()) (ja.copy ())
