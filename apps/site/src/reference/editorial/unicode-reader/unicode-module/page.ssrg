import { localized } from "../../../../model/locale"
import {
  Block,
  BulletList,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"

pub fn blocks specifier: String -> Array<Block> =
  if specifier != "std/text/unicode" then
    []
  else
    [
      Heading (
        "choose-unicode-operation",
        localized "Choose a rule for spelling and comparison" "表記と比較の規則を選ぶ"
      ),
      Paragraph ([Words (localized (en.purpose ()) (ja.purpose ()))]),
      Paragraph ([Words (localized (en.choose ()) (ja.choose ()))]),
      Heading (
        "normalize-spellings",
        localized "Align equivalent spellings explicitly" "同じ文字の表記を明示的にそろえる"
      ),
      Paragraph ([Words (localized (en.normalization ()) (ja.normalization ()))]),
      CodeExample
        ("unicode-normalize", localized "Choose a normalization form" "正規化の形式を指定する"),
      Paragraph ([Words (localized (en.wrapper ()) (ja.wrapper ()))]),
      Terminal (
        localized "Output" "実行結果",
        "NFC: é\nNFD scalars: 2\nNFKC: ffi1\nNFKD: 1\nidempotent: True\noriginal scalars: 2"
      ),
      Paragraph
        ([Words (localized (en.normalizationReading ()) (ja.normalizationReading ()))]),
      Paragraph
        ([Words (localized (en.normalizationBoundary ()) (ja.normalizationBoundary ()))]),
      Heading (
        "compare-case",
        localized "Prepare text for case-insensitive comparison" "大文字・小文字を区別しない比較に使う"
      ),
      Paragraph ([Words (localized (en.folding ()) (ja.folding ()))]),
      CodeExample (
        "unicode-fullcasefold",
        localized "Fold both strings before comparing" "両方の文字列を変換して比べる"
      ),
      Terminal (
        localized "Output" "実行結果",
        "folded: strasse\noriginal: Straße\nsame comparison: True\ndotted I: i̇\nsigmas: σσ\naccent scalars: 2\nempty: []"
      ),
      Paragraph ([Words (localized (en.foldingReading ()) (ja.foldingReading ()))]),
      Heading (
        "typescript-comparison",
        localized "Choose the corresponding TypeScript operation" "TypeScriptでも処理を選んで使う"
      ),
      Paragraph ([Words (localized (en.comparison ()) (ja.comparison ()))]),
      CodeExample (
        "unicode-normalization-typescript",
        localized "TypeScript normalization and display casing" "TypeScriptの正規化と表示用の変換"
      ),
      Terminal (
        localized "Output" "実行結果",
        "NFC: é\nNFD scalars: 2\nNFKC: ffi1\nNFKD: 1\noriginal scalars: 2\nlowercase: straße\nuppercase: STRASSE"
      ),
      Paragraph
        ([Words (localized (en.comparisonReading ()) (ja.comparisonReading ()))]),
      Paragraph ([Words (localized (en.version ()) (ja.version ()))]),
      Heading
        ("choose-text-policy", localized "Keep each text decision explicit" "用途ごとに使う規則を決める"),
      Paragraph ([Words (localized (en.policy ()) (ja.policy ()))]),
      BulletList (
        [
          [
            InternalLink (
              localized "normalize" "normalize",
              "/docs/library/text/unicode/function/normalize/"
            ),
            Words (localized ": choose among four forms" "：四つの形式を選ぶ")
          ],
          [
            InternalLink (
              localized "isNormalized" "isNormalized",
              "/docs/library/text/unicode/function/isnormalized/"
            ),
            Words
        (localized ": check without requesting converted text" "：文字列の正規化形式を調べる")
          ],
          [
            InternalLink (
              localized "fullCaseFold" "fullCaseFold",
              "/docs/library/text/unicode/function/fullcasefold/"
            ),
            Words
        (localized ": compare text and understand expansions" "：比較と文字数の変化を確認する")
          ],
          [
            InternalLink
        (localized "caseFold" "caseFold", "/docs/library/text/function/casefold/"),
            Words
        (localized ": use the same folding from std/text" "：std/textから同じ比較用の変換を使う")
          ],
          [
            InternalLink
        (localized "toLower" "toLower", "/docs/library/text/function/tolower/"),
            Words (localized ": display lowercase text" "：小文字を表示する")
          ],
          [
            InternalLink
        (localized "toUpper" "toUpper", "/docs/library/text/function/toupper/"),
            Words (localized ": display uppercase text" "：大文字を表示する")
          ],
          [
            InternalLink (
              localized "version" "version",
              "/docs/library/text/unicode/function/version/"
            ),
            Words
        (localized ": identify the Unicode data in use" "：使用中のUnicodeデータの版を調べる")
          ],
          [
            InternalLink (
              localized "std/text/grapheme" "std/text/grapheme",
              "/docs/library/text/grapheme/"
            ),
            Words (localized ": select and count visible pieces" "：見た目のまとまりを数え、取り出す")
          ],
          [InternalLink (
            localized "std/text: compare scalar, byte, and visible-character counts"
        "std/textで文字番号、バイト、見た目の文字の数を比べる",
            "/docs/library/text/#text-units"
          )]
        ]
      ),
      Heading
        ("unicode-api-index", localized "Browse the complete module" "モジュール全体を調べる")
    ]
