import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "表示する文字列をUnicodeの既定規則で小文字にする",
  purpose: "ラベルなどの文字列を小文字で表示したいときに使います。toLowerはUnicodeの既定の小文字変換を行い、結果のStringを返します。Helloはhelloになります。言語設定を指定する操作ではなく、元の入力も変更しません。",
  reading: "importでstd/textをtextという名前で読み込み、text.toLowerの後ろに対象の文字列を書きます。Greekの入力はΟΣ、ΟΣΑ、Σの三つです。結果は順にος、οσα、σとなります。ΟΣのΣは文字の並びの末尾にあるためςへ変わり、ΟΣΑのΣは後ろにΑがあるためσへ変わります。Σだけの場合もσです。",
  boundaries: "İの結果はiと結合した点U+0307で、Unicodeの文字番号の単位が一つから二つへ増えます。小文字にしても文字列の長さが同じとは限りません。最後の[]は空文字列のままという意味です。",
  rules: "既定の完全な小文字変換を使い、ギリシャ文字Σの前後の文字も調べます。大文字・小文字を持つ文字が前にあり後ろにない場合に、語末のςへ変わります。この判定では、Unicodeが大文字・小文字の文脈で無視すると定めた文字を読み飛ばします。トルコ語やリトアニア語などの言語固有の規則は適用しません。処理量は入力と出力のバイト数に比例します。",
  mistake: "大文字・小文字を無視した比較にtoLowerを使うと、StraßeとSTRASSEが同じになりません。その用途ではcaseFoldの比較規則を検討してください。トルコ語の規則でİをiにしたい要求にも、この操作は対応しません。TypeScriptではtoLowerCaseがこの例に対応し、言語を指定するtoLocaleLowerCaseは別の要求を表します。",
}
