import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Make display text uppercase using Unicode default casing",
  purpose: "Use toUpper to display a label or heading in uppercase. It applies Unicode’s default uppercase conversion and returns the resulting String. Hello becomes HELLO. There is no locale argument, and the original input stays unchanged.",
  reading: "The import names std/text as text. Write the input string after text.toUpper. Straße becomes STRASSE, expanding ß into SS. The ligature ﬃ becomes FFI, and é becomes É. Uppercasing does not remove accents, so the accent remains on É.",
  boundaries: "One Unicode character code can become several, as ß becomes SS and ﬃ becomes FFI. Do not reuse the input length as the result’s length. The final [] shows that uppercasing an empty string still gives an empty string.",
  rules: "The operation uses Unicode default full uppercase conversion without Turkish, Lithuanian, or other locale-specific rules. The result does not record its original spelling, so applying toLower afterward need not restore the input. Work is proportional to input and output byte counts.",
  mistake: "Do not use uppercasing as a reversible storage format. Lowercasing STRASSE, the uppercase result of Straße, gives strasse without restoring ß. Keep the source value when you also need its original spelling for display. Choose caseFold for comparison and normalize for normalization. TypeScript’s toUpperCase is the corresponding operation for these examples.",
}
