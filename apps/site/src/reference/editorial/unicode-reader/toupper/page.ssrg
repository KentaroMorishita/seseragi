import { Editorial } from "../../model"
import { unicodeEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  unicodeEditorial "std/text::toUpper" "unicode-toupper" "ordinary: HELLO\nexpanded: STRASSE\nligature: FFI\naccent: É\nempty: []" "std/text" (en.copy ()) (ja.copy ())
