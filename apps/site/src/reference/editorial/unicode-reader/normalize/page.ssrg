import { Editorial } from "../../model"
import { unicodeEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  unicodeEditorial "std/text/unicode::normalize" "unicode-normalize" "NFC: é\nNFD scalars: 2\nNFKC: ffi1\nNFKD: 1\nidempotent: True\noriginal scalars: 2" "std/text/unicode" (en.copy ()) (ja.copy ())
