import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Put text into an explicit Unicode normalization form",
  purpose: "An entered é can use one character code or an e followed by an accent. normalize returns a chosen spelling for representations that Unicode treats as the same character. This process is called normalization. You can keep the original input and produce a separate string for a comparison or another task.",
  reading: "let gives a value a name. The e\\u{0301} in original contains e followed by combining acute accent U+0301. The escape \\u{0301} writes the accent by its code; it appears over the preceding e. unicode.normalize takes the form value unicode.NFC followed by original. The result, composed, is the single-code spelling é. text.lengthScalars counts Unicode character-code values, so decomposing é with NFD gives a count of 2.",
  boundaries: "NFKC turns ﬃ① into ffi1, and NFKD turns ① into 1. The idempotent line applies NFC to the NFC result again and compares the strings with ==. They are equal, giving True. The final 2 is the length of original, showing that normalization did not rewrite the input.",
  rules: "NormalizationForm is a type with four choices: NFC, NFD, NFKC, and NFKD. NFD decomposes characters, such as é into e and its accent, and puts combining marks into their prescribed order. NFC then combines characters where possible. NFKD and NFKC additionally remove compatibility distinctions such as ﬃ versus ffi and ① versus 1. Repeating the same form leaves the result unchanged. The length can change, so calculate lengths and positions on the converted string.",
  mistake: "NFKC changes ① into 1, losing the information that the original digit had a circle. Decide which distinctions your storage or comparison needs before choosing a form. Normalization is separate from lowercasing or detecting lookalike characters. It also does not strip an accent to make é and e equal.",
}
