import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "文字列を指定したUnicode正規化形式へそろえる",
  purpose: "入力されたéが、一つの文字番号で書かれる場合と、eとアクセントで書かれる場合があります。normalizeは、Unicodeが同じ文字として扱うこうした表記を、指定した形式へそろえて返します。この処理を正規化と呼びます。元の入力を残したまま、比較などに使う別の文字列を作れます。",
  reading: "letは値に名前を付けます。originalのe\\u{0301}は、eと結合アクセントU+0301を含む文字列です。\\u{0301}はアクセントの番号を書く表記で、直前のeに重なって見えます。unicode.normalizeには形式の値unicode.NFCと対象のoriginalを渡します。結果のcomposedは、一つの番号で表すéです。text.lengthScalarsはUnicodeの文字番号の単位を数えるため、éをNFDへ変えた結果は2になります。",
  boundaries: "NFKCでﬃ①を変換するとffi1、NFKDで①を変換すると1になります。idempotentの行は、NFCの結果にもう一度NFCを適用して==で比べています。同じ文字列なのでTrueです。最後の2は元のoriginalの長さで、正規化しても入力を書き換えないことを確認できます。",
  rules: "NormalizationFormはNFC、NFD、NFKC、NFKDの四つから形式を選ぶ型です。NFDはéをeとアクセントへ分けるような分解と、結合文字の規定順への並べ替えを行います。NFCはその後、合成できる文字をまとめます。NFKDとNFKCはそれぞれの処理に加え、ﬃとffi、①と1のような互換表記の違いも取り除きます。同じ形式を繰り返しても結果は変わりません。結果の長さは変わり得るため、文字数や位置は変換後に調べてください。",
  mistake: "NFKCを使うと①が1になり、元が丸付きだった情報を結果から復元できません。保存や比較に必要な区別を決めてから形式を選んでください。正規化は小文字化や、似て見える文字の検出とは別の処理です。éとeをそろえるようなアクセント除去でもありません。",
}
