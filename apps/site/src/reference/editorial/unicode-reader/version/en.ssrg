import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Read the data version used for Unicode rules",
  purpose: "When another tool classifies or transforms text differently, comparing Unicode data versions can help investigate the cause. version returns the Unicode data version used by Seseragi as a string. This is separate from the product version of Seseragi or your browser.",
  reading: "The import gives std/text/unicode the name unicode. The () in unicode.version () is a Unit value, which carries no additional information; pass it to request the current version. + joins the string Unicode: with the returned version, and println prints it. The example’s 17.0.0 is the currently pinned Unicode data version.",
  boundaries: "The result is a String in major.minor.patch form, not a number. There is no text or normalization-form argument, and calling version does not switch Unicode versions. Recording the result gives you a useful detail when comparing behavior across environments.",
  rules: "The compiler, runtime, formatter, and LSP share a Unicode data version recorded in their artifacts. The LSP supplies editor features such as diagnostics. Generated modules check the required version; a runtime with different Unicode data is rejected before the source initializers run. Calling version cannot bypass this check.",
  mistake: "A result of 17.0.0 does not establish that your TypeScript host uses the same Unicode or ICU version. ICU is a library some environments use for Unicode processing. When results differ, check the data version along with the normalization form, locale settings, and the unit used to count text.",
}
