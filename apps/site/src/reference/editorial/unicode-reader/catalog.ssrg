import * as arrays from "std/array"
import { ReferenceSymbol } from "../../../model/build"
import { Block } from "../../../model/page"
import { Editorial } from "../model"
import { editorial as atEditorial } from "./at/page"
import { editorial as byteboundariesEditorial } from "./byteboundaries/page"
import { editorial as casefoldEditorial } from "./casefold/page"
import { editorial as clustersEditorial } from "./clusters/page"
import { editorial as fullcasefoldEditorial } from "./fullcasefold/page"
import { editorial as isnormalizedEditorial } from "./isnormalized/page"
import { editorial as lengthEditorial } from "./length/page"
import { editorial as normalizeEditorial } from "./normalize/page"
import { editorial as sliceEditorial } from "./slice/page"
import { editorial as tolowerEditorial } from "./tolower/page"
import { editorial as toupperEditorial } from "./toupper/page"
import { editorial as versionEditorial } from "./version/page"
import { blocks as graphemeBlocks } from "./grapheme-module/page"
import { blocks as unicodeBlocks } from "./unicode-module/page"

pub fn unicodeReaderEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.namespace != "value"
    || symbol.itemKind != "function" then
    Nothing
  else
    match (symbol.module, symbol.identity) {
  ("std/text/grapheme", "std/text/grapheme::at") -> Just (atEditorial ())
  ("std/text/grapheme", "std/text/grapheme::byteBoundaries") -> Just (byteboundariesEditorial ())
  ("std/text", "std/text::caseFold") -> Just (casefoldEditorial ())
  ("std/text/grapheme", "std/text/grapheme::clusters") -> Just (clustersEditorial ())
  ("std/text/unicode", "std/text/unicode::fullCaseFold") -> Just (fullcasefoldEditorial ())
  ("std/text/unicode", "std/text/unicode::isNormalized") -> Just (isnormalizedEditorial ())
  ("std/text/grapheme", "std/text/grapheme::length") -> Just (lengthEditorial ())
  ("std/text/unicode", "std/text/unicode::normalize") -> Just (normalizeEditorial ())
  ("std/text/grapheme", "std/text/grapheme::slice") -> Just (sliceEditorial ())
  ("std/text", "std/text::toLower") -> Just (tolowerEditorial ())
  ("std/text", "std/text::toUpper") -> Just (toupperEditorial ())
  ("std/text/unicode", "std/text/unicode::version") -> Just (versionEditorial ())
  _ -> Nothing
}

pub fn unicodeReaderModuleBlocks specifier: String -> Array<Block> = arrays.concat [
  graphemeBlocks specifier,
  unicodeBlocks specifier
]
