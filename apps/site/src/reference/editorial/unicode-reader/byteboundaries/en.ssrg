import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Get cluster boundaries as UTF-8 byte offsets",
  purpose: "Use byteBoundaries when connecting user-perceived character boundaries to an operation that uses UTF-8 byte positions. It takes a String and returns an Array<Int> containing each cluster’s start and the end of the whole string. These positions count bytes, not characters.",
  reading: "A uses one byte, 👍🏽 uses eight for the emoji and modifier together, and e with its \\u{0301} accent uses three. The boundaries are therefore 0, 1, 9, and 12. The final twelve equals text.lengthBytes label: it marks the end of the string, not the position of a final character.",
  boundaries: "Even empty text needs its start/end boundary, so the result is [0], not []. Nonempty input returns one more boundary than clusters. Boundaries are ascending and equal the cumulative UTF-8 byte lengths of the pieces returned by clusters.",
  rules: "The operation scans linearly in UTF-8 input length and uses output storage proportional to the boundary array. It uses the pinned Unicode segmentation rules without normalizing the original spelling. These are positions in this string’s UTF-8 encoding, not reusable positions in a different string.",
  mistake: "Passing the end byte offset twelve to graphemes.slice is out of range here: that function accepts cluster positions up to three. TypeScript String.slice does not take bytes either. For simply extracting visible pieces, graphemes.slice is more direct than converting to byte positions.",
}
