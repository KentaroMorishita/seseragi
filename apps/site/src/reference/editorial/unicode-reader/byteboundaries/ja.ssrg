import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "見た目のまとまりの境界をUTF-8バイト位置で得る",
  purpose: "見た目の文字の区切りを、UTF-8のバイト位置を使う処理と対応させたいときに使います。byteBoundariesはStringを受け取り、各まとまりの開始位置と文字列全体の終了位置をArray<Int>で返します。位置の単位は文字数ではなくバイト数です。",
  reading: "Aは1バイト、👍🏽は絵文字と肌の色を合わせて8バイト、eと\\u{0301}のアクセントは合わせて3バイトです。そのため境界は0、1、9、12になります。最後の12はtext.lengthBytes labelの結果と同じで、最後の文字の位置ではなく文字列の終了位置です。",
  boundaries: "空文字列でも先頭と末尾を表す0が必要なので、結果は[]ではなく[0]です。空でない入力では、見た目のまとまりの個数より一つ多く境界が返ります。各境界は昇順で、同じ文字列をclustersで分けた部分のUTF-8バイト数を順に足した値と一致します。",
  rules: "入力のUTF-8バイト数に比例して走査し、境界の配列には結果の大きさに比例する領域を使います。Unicodeの固定版で区切りを求め、元の綴りを正規化しません。値は文字列内のUTF-8位置で、別の文字列へそのまま使える位置ではありません。",
  mistake: "12という終了位置をgraphemes.sliceへ渡すと、この例では範囲外です。そちらはまとまりの個数3までを受け取ります。TypeScriptのString.sliceもバイト位置ではありません。見た目の文字を切り出すだけなら、バイト位置へ変換せずgraphemes.sliceを使う方が直接的です。",
}
