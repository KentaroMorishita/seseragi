import { Editorial } from "../../model"
import { unicodeEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  unicodeEditorial "std/text/grapheme::byteBoundaries" "unicode-byteboundaries" "boundaries: [0, 1, 9, 12]\nUTF-8 bytes: 12\nempty: [0]" "std/text/grapheme" (en.copy ()) (ja.copy ())
