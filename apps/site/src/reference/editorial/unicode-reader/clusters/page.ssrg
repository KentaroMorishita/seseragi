import { Editorial } from "../../model"
import { unicodeEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  unicodeEditorial "std/text/grapheme::clusters" "unicode-clusters" "pieces: [A, 👍🏽, é]\nsame text: True\nempty: []" "std/text/grapheme" (en.copy ()) (ja.copy ())
