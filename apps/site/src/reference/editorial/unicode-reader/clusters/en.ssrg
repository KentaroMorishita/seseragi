import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Split text into user-perceived clusters",
  purpose: "Use clusters to display a label one perceived character at a time without separating an accent or part of an emoji. It takes a String and returns an Array<String> of grapheme clusters. A cluster can contain several Unicode code values, called scalars.",
  reading: "The three pieces of label are A, 👍🏽, and e with a combining accent. \\u{0301} denotes that accent. pieces contains those strings in order. Interpolating the array prints the elements without quotation marks, but their type is still String.",
  boundaries: "text.concat joins the strings without a separator. Comparing the result to label gives True, preserving the original spelling including the accent. Empty input gives an empty array, []. Every cluster produced from nonempty input is itself nonempty.",
  rules: "The pinned Unicode rules select consecutive substrings in source order without normalization. Work is linear in UTF-8 input length, and the output array needs storage proportional to its result. Keeping a small returned string does not require retaining a much larger original input.",
  mistake: "Array.from(text) and string spreading in TypeScript use a different unit from grapheme clusters. The closer operation is Intl.Segmenter with grapheme granularity. clusters does not find words or sentences; check std/text.words for whitespace-based splitting.",
}
