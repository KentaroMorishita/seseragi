import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "文字列を見た目のまとまりごとに分ける",
  purpose: "ラベルを一文字ずつ表示したいとき、結合アクセントや絵文字の一部だけを取り出さないようにできます。clustersはStringを受け取り、見た目のまとまりごとに分けたArray<String>を返します。一つのまとまりに複数のUnicodeの番号（scalar）が入ることがあります。",
  reading: "labelの三つの要素はA、👍🏽、eと結合アクセントです。\\u{0301}は結合アクセントを表します。piecesにはこの順の文字列の配列が入ります。printlnで配列を埋め込むと出力では引用符が付きませんが、各要素の型はStringです。",
  boundaries: "text.concatは区切りを入れず配列の文字列をつなぎます。元のlabelと比較するとTrueになり、アクセントの綴りも含めて元に戻ります。空文字列は空配列[]です。空でない入力からできる各要素は空文字列にはなりません。",
  rules: "Unicodeの固定版に基づき、元の文字列の連続した部分を順に返します。正規化は行いません。処理量は入力のUTF-8バイト数に比例し、返す配列には結果の大きさに応じた領域が必要です。取り出した小さな文字列を保持するために、巨大な入力全体を残し続けることはありません。",
  mistake: "TypeScriptのArray.from(text)や文字列の展開は、結合アクセントを含む見た目のまとまりとは別の単位です。対応する操作はIntl.Segmenterのgrapheme指定です。語や文に分ける操作でもありません。空白で語を分けたい場合はstd/text.wordsの規則を確認してください。",
}
