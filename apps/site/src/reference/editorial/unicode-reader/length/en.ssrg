import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Count user-perceived character clusters",
  purpose: "For a character limit, you may want an emoji and its skin-tone modifier, or e and its combining accent, to count together. length counts these user-perceived units, called grapheme clusters. Its argument is a String and its result is an Int count.",
  reading: "label contains A, 👍🏽, and e followed by a combining accent. \\u{0301} writes the accent by its Unicode number; it combines visually with the preceding e. graphemes is the local name for std/text/grapheme. The first output counts these three clusters.",
  boundaries: "Counting Unicode scalar values, each one a Unicode code value, separates the emoji modifier and accent and gives five. UTF-8 encoding uses twelve bytes. Empty text has zero clusters. TypeScript String.length counts UTF-16 units and gives seven for this same label.",
  rules: "Segmentation follows the extended grapheme-cluster rules of Seseragi’s pinned Unicode version. Work is linear in the input’s UTF-8 byte length. Counting does not normalize or change the text. Different scalar sequences that look alike do not thereby become equal strings.",
  mistake: "This is not display width or a cursor’s pixel position; those depend on rendering. Choose std/text.lengthBytes for encoded size and lengthScalars for scalar count. TypeScript can count clusters with Intl.Segmenter too, but different Unicode versions can disagree at some boundaries.",
}
