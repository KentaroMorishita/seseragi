import * as arrays from "std/array"
import { LocalizedText, localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { ApiCopy, Editorial } from "../model"

pub fn unicodeEditorial identity: String
  -> exampleId: String
  -> output: String
  -> owner: String
  -> english: ApiCopy
  -> japanese: ApiCopy
  -> Editorial =
  Editorial {
    identity,
    namespace: "value",
    itemKind: "function",
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-operation", localized "Use this operation" "この操作を使う"),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        CodeExample (exampleId, localized "A complete program" "そのまま実行できるプログラム"),
        Paragraph ([Words (wrapperCopy identity)]),
        Terminal (localized "Output" "実行結果", output),
        Heading ("reading-the-example", localized "Read the example" "例を順に読む"),
        Paragraph ([Words (localized english.reading japanese.reading)]),
        Paragraph ([Words (localized english.boundaries japanese.boundaries)]),
        Heading ("operation-rules", localized "Rules and cost" "規則と処理量"),
        Paragraph ([Words (localized english.rules japanese.rules)]),
        Heading
          ("operation-mistakes", localized "Choose the right operation" "使い分けと間違いやすい点"),
        Paragraph ([Words (localized english.mistake japanese.mistake)]),
        Paragraph (
          [
            InternalLink (
              localized owner owner,
              if owner == "std/text/grapheme" then
                "/docs/library/text/grapheme/"
              else if owner == "std/text/unicode" then
                "/docs/library/text/unicode/"
              else
                "/docs/library/text/"
            ),
            Words (
              localized ": compare related operations and their result shapes."
          "で、関連する操作と戻り値の違いを比べられます。"
            )
          ]
        ),
        Paragraph (
          [Words (
            localized
          "This is a pure text operation available on process and browser targets; it does not need an external service. The Unicode rules come from Seseragi's pinned data version, not the host browser's locale or ICU version."
          "この文字列の操作はprocessとbrowserの両方が対象で、外部サービスは必要ありません。Unicodeの規則にはSeseragiで固定したデータの版を使い、ブラウザーの言語設定やICUの版には依存しません。"
          )]
        ),
      ],
      caseFoldHelp identity,
      [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
  }

fn caseFoldHelp identity: String -> Array<Block> =
  if identity == "std/text::caseFold" then
    [Paragraph (
      [
        InternalLink (
          localized "fullCaseFold" "fullCaseFold",
          "/docs/library/text/unicode/function/fullcasefold/"
        ),
        Words (
          localized
            ": read the shared folding rules, including expansion and the normalization boundary."
            "では、文字数が増える場合や正規化との違いを含む、共通の規則を説明しています。"
        )
      ]
    )]
  else
    []

fn wrapperCopy identity: String -> LocalizedText =
  if identity == "std/text/unicode::version" then
    localized "import gives std/text/unicode the local name unicode. pub effect fn main is the output entry; println prints the resulting string and a newline. The version lookup itself does not print." "importはstd/text/unicodeにunicodeという名前を付けます。pub effect fn mainは出力の実行入口で、printlnはできた文字列と改行を出力します。版を取得する操作そのものは出力しません。"
  else
    localized "import gives a module a local name such as graphemes, text, or unicode. let names a value. Arguments follow the function name, separated by spaces; parentheses group a call used inside another expression. pub effect fn main is the output entry, and println prints the resulting string and a newline. Backticks form a string with ${...} values inserted; a line break inside it becomes a line break in the output. The text operations themselves do not print or change their inputs." "importはモジュールにgraphemes、text、unicodeなどの名前を付け、letは値に名前を付けます。関数名の後ろに空白で区切って引数を書き、別の式の中で使う呼び出しは括弧で囲みます。pub effect fn mainは出力の実行入口で、printlnはできた文字列と改行を出力します。バッククォートで囲む文字列には${...}の値が入り、文字列内の改行もそのまま出力されます。文字列の操作そのものは、出力も入力の変更もしません。"
