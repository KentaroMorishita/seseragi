import { EffectSequencingCopy } from "../model"

pub fn copy -> EffectSequencingCopy = EffectSequencingCopy {
  summary: "実行するたびに、その場で処理を組み立て直します。",
  taskTitle: "準備の呼び出しを、実行する時まで待つ",
  purpose: "プレビュー用の文字列を準備する呼び出しを、workを作る時には行わず、workを実行する時まで待ちます。同じworkを二度実行すると、そのたびに準備し直します。",
  typescriptBefore: "TypeScriptなら、prepareを呼ぶ関数をworkに保存します。関数を作るだけではprepareは動かず、work()を呼ぶたびに動きます。この例にPromiseは必要ありません。",
  benefit: "deferは、この「実行時に作る」という境界を組み合わせ可能な処理として表せます。処理を手元に置くことと、その中の準備を呼ぶことを分けられます。",
  setup: "std/effectをeffectsとして読み込みます。prepareはStringを受け取り、文字列を + でつなげて返す普通の関数です。後回しにしたいのは、このprepareの呼び出しです。",
  after: [
    "effects.deferに渡す \\_ -> ...は、後で呼ばれる関数、つまりコールバックです。_は使わない引数を表します。deferはこの関数をすぐには呼ばず、workの各実行時に呼んで、その回に実行する処理を受け取ります。",
    "コールバックの中ではprepareを呼び、その結果をeffects.succeedに渡します。let workが保存するのはこの手順を持つ処理で、準備済みの文字列ではありません。deferが結果を保存して再利用することもありません。",
    "effect fn mainのdoは上から順に実行します。_ <- printlnは出力が終わるのを待ち、その戻り値を捨てます。first <- workとsecond <- workはそれぞれworkを実行し、その回の成功値を受け取ります。",
    "二度とも同じ入力をprepareに渡すので、同じプレビューが二行表示されます。同じ出力であることだけでは、いつ呼ばれたかや、結果が再利用されたかは分かりません。毎回コールバックを呼ぶのはdeferの動作です。",
    "続く未実行の例では、divideがIntの整数を受け取り、7をその数で割ります。_workは使わない名前として保存した処理です。ゼロで割る呼び出しはコールバックの内側にあるため、_workを作るだけでは評価されません。",
    "その例は_workを実行せず、Constructed without executingを表示します。もし_workを実行すれば、そこでゼロ除算が起きます。実行を遅らせることは、危険な計算を安全にすることではありません。"
  ],
  details: [
    "下の宣言にあるコールバックの型はUnit -> Effect<R, E, A>です。Unitの値()には意味のある入力がなく、deferがコールバックへ渡します。例の_は、その引数を使わないという記法です。",
    "よくある間違いは、effects.succeed (prepare title)自体がprepareの呼び出しを遅らせると思うことです。引数は、そのsucceedの式を評価する時に先に計算されます。呼び出しも遅らせたいなら、例のようにdeferのコールバックの内側へ置きます。",
    "deferはキャッシュではありません。同じworkを二度実行すれば、コールバックも二度呼ばれます。一度だけ計算した値を再利用したい場合は、それとは別に値を保持する設計が必要です。",
    "ゼロ除算のような実行時の欠陥は、遅らせても型に含まれた想定した失敗には変わりません。attempt、recover、mapErrorで回復できる値にもなりません。回復可能な入力エラーにしたいなら、計算前に入力を確認し、想定した失敗を明示的に返します。"
  ]
}
