import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { Editorial } from "../model"

pub struct EffectSequencingCopy {
  summary: String,
  taskTitle: String,
  purpose: String,
  typescriptBefore: String,
  benefit: String,
  setup: String,
  after: Array<String>,
  details: Array<String>
}

fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  [Paragraph ([Words (localized en ja)]) | (en, ja) <- arrays.zip japanese english]

fn link title: String -> route: String -> english: String -> japanese: String -> Block =
  Paragraph (
    [
      InternalLink (localized title title, route),
      Words (localized (": " + english) ("：" + japanese))
    ]
  )

pub fn effectSequencingEditorial identity: String
  -> namespace: String
  -> itemKind: String
  -> source: String
  -> output: String
  -> english: EffectSequencingCopy
  -> japanese: EffectSequencingCopy
  -> Editorial =
  Editorial {
    identity,
    namespace,
    itemKind,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-operation", localized english.taskTitle japanese.taskTitle),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        Heading (
          "typescript-comparison",
          localized "Start with familiar TypeScript" "TypeScriptの処理から考える"
        ),
        Paragraph
          ([Words (localized english.typescriptBefore japanese.typescriptBefore)]),
        CodeExample
          ("effect-sequencing-" + source + "-ts", localized "TypeScript" "TypeScript"),
        Terminal (localized "TypeScript output" "TypeScriptの実行結果", output),
        Heading (
          "seseragi-example",
          localized "Write the same task in Seseragi" "Seseragiで同じ処理を書く"
        ),
        CodeExample (
          "effect-sequencing-" + source,
          localized "Complete Seseragi program" "Seseragiの完全なプログラム"
        ),
        Terminal (localized "Seseragi output" "Seseragiの実行結果", output),
        Paragraph ([Words (localized english.benefit japanese.benefit)]),
        Heading ("reading-the-example", localized "Read the important lines" "大事な行を読む"),
        Paragraph ([Words (localized english.setup japanese.setup)])
      ],
      paragraphs english.after japanese.after,
      [
        Paragraph (
          [Words (
            localized
          "Save the complete program using the filename below and run it with the CLI, or open its Playground link. These examples need no network or browser-navigation service. The program entry uses Console to print the results."
          "完全なプログラムを下のファイル名で保存し、CLIで実行できます。Playgroundのリンクからも試せます。例はネットワークやブラウザの移動を行うサービスを使いません。実行入口はConsoleを使って結果を表示します。"
          )]
        ),
        Terminal (
          localized "Run locally" "ローカルで実行する",
          "seseragi run " + source + ".ssrg --target process"
        ),
        Heading ("operation-rules", localized "Rules and common mistakes" "規則と間違いやすい点")
      ],
      paragraphs english.details japanese.details,
      if identity == "std/effect::defer" then
        [
          Heading (
            "unexecuted-work",
            localized "An operation that is never executed" "実行しない処理を作る"
          ),
          CodeExample (
            "effect-sequencing-deferred-unrun",
            localized "Keep the risky calculation unexecuted" "危険な計算を実行せずに置く"
          ),
          Terminal (localized "Output" "実行結果", "Constructed without executing\n"),
          Paragraph (
            [Words (
              localized
          "The divide call is inside the callback, so merely constructing this deferred operation does not divide by zero. Moving divide 0 directly into succeed evaluates it immediately and causes a runtime defect. If the deferred operation is executed, the same defect occurs then; defer does not make division safe."
          "divideの呼び出しはコールバックの中にあるため、この処理を作るだけでは0で割りません。divide 0をsucceedの引数に直接書くと、その場で計算して実行時の不具合になります。遅らせた処理を実行すれば、その時点で同じ不具合が起きます。deferが割り算を安全にするわけではありません。"
            )]
          )
        ]
      else
        [],
      [Heading ("choose-next", localized "Choose the next operation" "次に必要な操作を選ぶ")],
      related identity,
      if itemKind == "module" then
        []
      else
        [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
}

fn related identity: String -> Array<Block> =
  if identity == "std/effect::forEachUntil"
    || identity == "std/effect::LoopControl"
    || identity == "std/effect::Continue"
    || identity == "std/effect::Break" then
    [
      link "forEachUntil" "/docs/library/effect/effect-function/foreachuntil/"
        "run a list of operations in order and stop successfully."
        "処理を順番に実行し、途中で正常に終了します。",
      link "LoopControl" "/docs/library/effect/opaque-type/loopcontrol/"
        "read the Continue and Break values returned by the callback."
        "コールバックが返すContinueとBreakの値を確認できます。",
      link "attempt" "/docs/library/effect/effect-function/attempt/"
        "distinguish a successful stop from a known failure." "正常な終了と、予想した失敗を区別します。"
    ]
  else
    [
      link "fromEither" "/docs/library/effect/effect-function/fromeither/"
        "continue a planned operation from an already-checked value."
        "確認済みの値から、実行する処理を続けます。",
      link "attempt" "/docs/library/effect/effect-function/attempt/"
        "inspect a successful result or its known failure." "成功した結果か、予想した失敗を調べます。",
      link "recover" "/docs/library/effect/effect-function/recover/"
        "choose a fallback operation for an expected failure." "予想した失敗に対して、代わりの処理を選びます。",
      if identity == "std/effect::succeed" then
        link "defer" "/docs/library/effect/effect-function/defer/"
        "delay constructing an operation until it is executed."
        "実行される時点まで、処理を作る関数の呼び出しを遅らせます。"
      else
        link "forEachUntil" "/docs/library/effect/effect-function/foreachuntil/"
        "process items in order with an explicit successful stop."
        "要素を順に処理し、正常な途中終了を明示します。"
    ]
