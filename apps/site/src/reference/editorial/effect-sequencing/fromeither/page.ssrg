import { Editorial } from "../../model"
import { effectSequencingEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  effectSequencingEditorial "std/effect::fromEither" "value" "effect-function" "validate-preview" "Ready: Release: Search improvements\nRejected: title is required\nRejected: template is missing\nReady: : Search improvements\n" (en.copy ()) (ja.copy ())
