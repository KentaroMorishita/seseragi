import { EffectSequencingCopy } from "../model"

pub fn copy -> EffectSequencingCopy = EffectSequencingCopy {
  summary: "すでにある検証結果をeffectの処理につなぐときはfromEitherを使います。Rightの値は成功結果に、Leftの理由はその処理の既知の失敗になります。",
  taskTitle: "確認済みのタイトルをプレビューに使う",
  purpose: "checkedTitleは、タイトルを受け入れるか、無効な理由を返すかをすでに判断できます。この関数を使いながら、テンプレートも必要なプレビューを準備します。タイトルが空ならテンプレートの選択まで進まず、先に見つかった問題を呼び出し側へ伝えます。",
  typescriptBefore: "TypeScriptのcheckedTitleは普通のResultオブジェクトを返します。prepareはそれをcheckedに保存し、!checked.okならそのまま返します。続いてテンプレートがundefinedかを確認し、問題がなければ組み立てた文章を成功のオブジェクトで返します。previewはresult.okで分岐して表示します。",
  benefit: "fromEitherは既存の確認をdoにつなぎ、後続の処理へ <- で確認済みのタイトルを渡します。検証のルールをeffect関数の中へ移す必要はなく、成功時に続けるためだけのmatchも書かずに済みます。",
  setup: "effectsはstd/effectの別名です。fn checkedTitle title: String -> Either<String, String>は、文字列から二つの選択肢のどちらかを返す通常の関数です。タイトルが空ならLeft \"title is required\"、それ以外ならRight titleです。Eitherの型には失敗理由、成功値の順に型を書きます。",
  after: [
    "effect fn prepareは、title: Stringとtemplate: Maybe<String>を受け取り、成功時にString、既知の失敗時にfails Stringの理由を返す処理です。validTitle <- effects.fromEither (checkedTitle title)が、既存の検証を最初の処理にします。",
    "Maybe<String>は、Justでテンプレートの文字列があるか、Nothingで指定がないかを表します。fromMaybeは指定された値をselectedに渡し、指定がなければtemplate is missingで失敗します。succeedはselected + \": \" + validTitleをdo全体の成功結果にします。",
    "previewはprepareをattemptで囲み、結果をresultに受け取ります。通常の関数describeはmatchを使い、Right valueなら準備完了の文章、Left reasonなら拒否理由の文章にします。printlnがその文章を表示します。",
    "previewのUnitは、戻り値として使う情報がないことを表します。with Console fails ConsoleErrorはコンソールの利用と表示の失敗可能性の宣言です。mainは四つのケースを実行し、最後の呼び出しより前では_ <- で各プレビューの戻り値を使わずに進みます。",
  ],
  details: [
    "fromEitherに普通のStringを渡すと型エラー SES-T0101になります。すでにEitherであるcheckedTitleの結果を渡してください。検証が不要で、手元の文章をそのまま成功結果にしたい場合はsucceedを使います。",
    "タイトルもテンプレートもない場合は、先にタイトルの確認で失敗します。表示はRejected: title is requiredです。この処理はすべての検証エラーを集めるものではありません。",
    "Just \"\" にもテンプレートの値はあるため、最後の表示はReady: : Search improvementsになります。fromEitherが使うのはcheckedTitleに書かれたルールです。テンプレートも空文字列であってはいけない、というルールは追加しません。",
    "attemptはprepareの既知の拒否をLeftにして、表示できるようにします。実行時のプログラム上の不具合やキャンセルは捕まえません。後のprintlnは囲んだ処理の外にあり、表示自体の失敗可能性は残ります。",
  ],
}
