import { EffectSequencingCopy } from "../model"

pub fn copy -> EffectSequencingCopy = EffectSequencingCopy {
  summary: "正常な値を返す代わりに、分かっている拒否理由を伝えるときはfailを使います。この例ではnot approvedを伝え、どのように表示するかは呼び出し側が決めます。",
  taskTitle: "承認されなかった理由を返す",
  purpose: "承認の確認では、拒否されたことを明確に表す必要があります。代わりの数値を返すと拒否を見落としやすくなり、確認の中で表示まで行うと呼び出し側の表示方法を固定してしまいます。ここではrejectedが理由を伝え、呼び出し側がその理由を文章にします。",
  typescriptBefore: "TypeScript版は拒否を { ok: false, reason: \"not approved\" }、承認を { ok: true, value: 42 }で表します。共通のResult型でこの二つを示し、describeがresult.okを見て文章を選びます。呼び出し側は両方を表示した後、次の処理へ進みます。",
  benefit: "failはeffectの既知の失敗として理由を伝えます。通常の <- では、その失敗した処理から成功値を受け取れないため、承認された前提で後続の処理が進むことはありません。明示的にattemptを使えば、呼び出し側は拒否を確認したうえで続けられます。",
  setup: "effectsは読み込んだstd/effectの別名です。effect fn rejected -> Int fails Stringは、成功時の整数と、失敗理由の文字列を宣言します。本体のeffects.fail \"not approved\" は失敗を選び、成功時の整数は作りません。",
  after: [
    "比較用のacceptedはeffects.succeed 42で成功します。二つのeffect関数には同じ型宣言を付けているので、attemptの結果を共通のdescribeに渡せます。",
    "accepted ()とrejected ()は、意味のある入力を持たない関数の呼び出しです。mainのdoブロックが、attemptを付けた処理を順に実行します。<- は戻ってきた値をacceptedResultとrejectedResultに結び付けます。",
    "この二つの呼び出しから受け取る値はEither<String, Int>の結果です。成功した整数はRight、拒否理由の文字列はLeftに入ります。通常の関数fn describeはmatchでRight valueとLeft reasonを分けて読みます。",
    "showは成功した数値を文章に変換します。printlnはReady: 42、続いてRejected: not approvedを表示します。_ <- は表示処理の戻り値を使わない書き方で、最後の表示によってCaller continuesが出ます。",
  ],
  details: [
    "下の宣言のEffect<{}, E, Never>では、最後のNeverが成功値を返さないことを表します。Eは想定した失敗の型、{}は環境のサービスを要求しないという意味です。Neverは型であり、自分で作って返す特別な値ではありません。",
    "この例で続行できるのは、rejected ()がattemptの中にあるためです。失敗する処理を直接 <- でつなぐと、同じdoブロックの後続の処理は実行されません。fail自体がブロックを再開するわけではありません。",
    "失敗理由には、未承認の申請など、プログラムが想定して扱う条件を書きます。failはあらゆるプログラムの誤りを通常の拒否結果として扱う仕組みではありません。",
    "例の二つの関数では -> Int fails Stringを残してください。この宣言は、共通の呼び出し側で結果の形をそろえるためのものです。拒否する本体に整数を作らせたり、成功する本体に失敗を起こさせたりはしません。",
    "attemptが扱うのは、囲んだ処理で宣言した既知の失敗だけです。実行時のプログラム上の不具合やキャンセルは別です。後のprintlnの失敗も、このattemptの対象外です。拒否が表示されたことと、起こり得るすべての問題を捕まえたことは同じではありません。",
  ],
}
