import { EffectSequencingCopy } from "../model"

pub fn copy -> EffectSequencingCopy = EffectSequencingCopy {
  summary: "手元にある値を処理の成功結果にするときはsucceedを使います。この例では、承認された処理が整数 42を結果として返します。",
  taskTitle: "承認された結果を返す",
  purpose: "呼び出し側は承認と拒否の両方を表示した後、そのまま次の処理へ進みたいとします。このページでは、すでに答えが決まっているacceptedに注目します。対になるrejectedと並べることで、値を返す処理と既知の失敗を伝える処理の違いを確認できます。",
  typescriptBefore: "TypeScriptのacceptedは普通のオブジェクト { ok: true, value: 42 }を返します。rejectedは { ok: false, reason: \"not approved\" }を返します。両方に同じResult型を使い、describeがresult.okによって表示を選びます。この版は通常の関数呼び出しとconsole.logで書けます。",
  benefit: "succeedを使うと、すでにある値を、ほかのeffectの処理と同じようにつなげられます。値の検証や表示を行う関数ではありません。呼び出し側はその後に処理を続けたり、attemptで結果を受け取って表示したりできます。",
  setup: "effectsは読み込んだstd/effectの別名です。effect fn accepted -> Int fails Stringは、成功すると整数を返し、既知の失敗理由には文字列を使う処理の宣言です。この関数の本体は必ず 42で成功します。宣言にfails Stringがあっても、実際に失敗する分岐があるとは限りません。",
  after: [
    "acceptedの本体はeffects.succeed 42です。accepted ()でその処理を呼び出します。()は意味のある入力がない関数に渡す引数です。rejected ()は、failを使ってnot approvedという既知の失敗を伝える処理を呼び出します。",
    "mainはdoで処理を順番に並べています。acceptedResult <- effects.attempt (accepted ())は、attemptを付けた処理を実行し、受け取った結果に名前を付けます。次の行ではrejectedResultも同じように受け取ります。",
    "describeは文章を返す通常のfnです。入力のEither<String, Int>は二つの選択肢を持ちます。Right valueには整数、Left reasonには失敗理由の文字列が入ります。matchが実際の選択肢に合う分岐を選びます。",
    "showは整数を文章に変換するため、Ready: 42を組み立てられます。printlnが説明を表示し、_ <- は表示処理の戻り値を使わないことを示します。最後にCaller continuesが出るので、両方の結果を受け取った後も続けられたと分かります。",
  ],
  details: [
    "下の宣言のEffect<{}, Never, A>では、{}は環境のサービスを要求しないこと、中央のNeverは想定した失敗の値を返さないこと、Aは成功値の型を表します。Neverは渡す値ではなく、この位置の型です。プログラム上の不具合やキャンセルは、この失敗の型とは別に扱われます。",
    "Intが必要な場所にeffects.succeed 42を代入しないでください。これは整数そのものではなく、整数を結果にする処理です。整数の計算に使うならdoの中で <- で受け取ります。普通の整数だけが必要なら 42を使います。",
    "同じdescribeに渡すときは、例にあるacceptedとrejectedの型宣言を残してください。片方は常に成功し、もう片方は常に失敗しますが、宣言によって両方のattemptの結果をEither<String, Int>として扱えます。",
    "succeedは、数値が正である、承認済みである、上限以下である、といったルールを追加しません。必要な条件は別に確認し、その結果に応じてsucceedとfailを選びます。",
    "ここで扱う失敗は、failが明示的に伝える想定内の結果です。attemptは実行時のプログラム上の不具合やキャンセルを捕まえません。また、同じdoにあるというだけで、後の表示処理まで対象になるわけではありません。",
  ],
}
