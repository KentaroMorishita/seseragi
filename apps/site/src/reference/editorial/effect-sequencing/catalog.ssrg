import { editorial as case0 } from "./module/page"
import { editorial as case1 } from "./succeed/page"
import { editorial as case2 } from "./fail/page"
import { editorial as case3 } from "./fromeither/page"
import { editorial as case4 } from "./frommaybe/page"
import { editorial as case5 } from "./attempt/page"
import { editorial as case6 } from "./maperror/page"
import { editorial as case7 } from "./recover/page"
import { editorial as case8 } from "./defer/page"
import { editorial as case9 } from "./foreachuntil/page"
import { editorial as case10 } from "./loopcontrol/page"
import { editorial as case11 } from "./continue/page"
import { editorial as case12 } from "./break/page"
import { ReferenceSymbol } from "../../../model/build"
import { Block } from "../../../model/page"
import { Editorial, editorialBlocks } from "../model"

// Every override is limited to its exact compiler identity, owner and kind.
pub fn effectSequencingEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.identity == "std/effect::succeed"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "effect-function" then
    Just (case1 ())
  else if symbol.identity == "std/effect::fail"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "effect-function" then
    Just (case2 ())
  else if symbol.identity == "std/effect::fromEither"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "effect-function" then
    Just (case3 ())
  else if symbol.identity == "std/effect::fromMaybe"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "effect-function" then
    Just (case4 ())
  else if symbol.identity == "std/effect::attempt"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "effect-function" then
    Just (case5 ())
  else if symbol.identity == "std/effect::mapError"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "effect-function" then
    Just (case6 ())
  else if symbol.identity == "std/effect::recover"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "effect-function" then
    Just (case7 ())
  else if symbol.identity == "std/effect::defer"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "effect-function" then
    Just (case8 ())
  else if symbol.identity == "std/effect::forEachUntil"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "effect-function" then
    Just (case9 ())
  else if symbol.identity == "std/effect::LoopControl"
    && symbol.module == "std/effect"
    && symbol.namespace == "type"
    && symbol.itemKind == "opaque-type" then
    Just (case10 ())
  else if symbol.identity == "std/effect::Continue"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "constructor" then
    Just (case11 ())
  else if symbol.identity == "std/effect::Break"
    && symbol.module == "std/effect"
    && symbol.namespace == "value"
    && symbol.itemKind == "constructor" then
    Just (case12 ())
  else
    Nothing

pub fn effectSequencingModuleBlocks specifier: String -> Array<Block> =
  editorialBlocks (match specifier {
    "std/effect" -> Just (case0 ())
    _ -> Nothing
  }
)
