import { Editorial } from "../../model"
import { effectSequencingEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  effectSequencingEditorial "std/effect::recover" "value" "effect-function" "recover" "Title: Release\nTitle: Preview\nRejected: invalid setting\n" (en.copy ()) (ja.copy ())
