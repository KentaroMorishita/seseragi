import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Remove whitespace only at the end of a string",
  purpose: "Use trimEnd when you want to remove trailing padding while preserving leading indentation. It takes a String and returns a String. Whitespace follows the Unicode White_Space set, which includes ordinary spaces, line breaks, and certain wider space characters.",
  reading: "label has two ordinary spaces on each side. text.trimEnd label produces [  Aki]. The brackets in the output only make the remaining spaces visible. The original line confirms that label itself has not changed.",
  boundaries: "The NEL removed line spells NEXT LINE as \\u{0085}, using its Unicode number. It belongs to White_Space and is removed by trimEnd. In contrast, \\u{FEFF} is outside that set, so withBom is retained. Both empty and only whitespace return the empty String.",
  rules: "Only the continuous trailing run of White_Space is removed; characters inside the string and at the opposite end remain unchanged. Seseragi pins the Unicode data version. Trimming is linear in the input and output UTF-8 byte counts. It performs no normalization, word splitting, or case conversion.",
  mistake: "Do not assume every invisible character will disappear. FEFF and zero-width space are outside White_Space. Choose trim to remove both ends, or trimEnd when leading indentation must remain. There is no reason to delete every remaining character without an application-specific policy.",
}

pub fn comparison -> String =
  "TypeScript’s .trimEnd() gives the same ordinary-space result. Its whitespace set differs, though: NEL remains and FEFF is removed. trimUnicodeEnd demonstrates a Unicode White_Space property escape, \\p{White_Space}. The + means one or more; $ restricts it to the end; u selects Unicode-aware regex interpretation."

pub fn comparisonBoundary -> String =
  "The output separates the JS built-in behavior from the White_Space-specific version. TypeScript true and Seseragi True differ only in display spelling. These selected inputs were checked, but the host’s Unicode data depends on the engine. An ICU or similar reported version alone does not establish the data version used by every JS operation."
