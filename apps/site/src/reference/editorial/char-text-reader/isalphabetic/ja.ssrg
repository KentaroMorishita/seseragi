import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "一つのCharがUnicodeのAlphabeticという性質を持つか調べる",
  purpose: "文字の成分を調べるとき、Aや漢がUnicodeのAlphabeticという性質を持つか確認できます。isAlphabeticは該当すればTrue、しなければFalseを返します。この二つの値を持つ型がBoolです。入力のCharはUnicode scalarを一つ持ちます。scalarはUnicodeの文字番号のうちサロゲート用の番号を除いたものです。'A'の単一引用符はCharを作り、二重引用符はStringを作ります。見た目の一文字が複数のscalarでできる場合もあります。",
  reading: "letで'A'をletterと名付け、unicode.isAlphabetic letterへ渡します。Aと漢はTrue、数字の3はFalseになります。Alphabeticは英字だけを意味せず、多くの文字体系の文字を含むUnicodeの性質の名前です。Falseも通常の判定結果であり、入力エラーやコンパイルエラーではありません。",
  boundaries: "U+0345はギリシャ文字に付く結合記号で、文字に付加する記号であってもAlphabeticがTrueになる例です。一方、結合アキュートアクセントU+0301はFalseです。U+の後ろは16進数の文字番号で、\\u{0345}などのエスケープはその番号のscalarを書きます。Alphabeticは『一般分類がLetter』と同じ条件ではなく、一部の付加記号も含みます。",
  rules: "isAlphabeticの型Char -> Boolは、一つのCharを受け取りBoolを返すという意味です。判定は固定されたUnicode 17.0.0データのAlphabeticに従い、入力を分解したり正規化したりしません。一回の呼び出しは一つのscalarを表で調べるだけで、String全体を走査しません。単語、識別子、入力欄の許可文字などを判定する場合は、その用途で必要な条件を別に決めます。",
  mistake: "unicode.isAlphabetic \"A\"のようにStringを渡すと、Charが必要なため型エラーSES-T0101になります。この例の一つの文字なら'A'へ直してください。実際の入力がStringなら、その全体を一つのCharと見なさず、文字列から必要なCharを取り出し、取り出せなかった場合も処理します。英字A〜Zとa〜zだけを許可したい場合は、その範囲を明示して判定してください。漢もTrueになるこの性質だけでは、その条件になりません。",
}

pub fn comparison -> String =
  "TypeScriptでもUnicodeプロパティの正規表現/\\p{Alphabetic}/uで、同じ五つの入力を調べられます。\\p{Alphabetic}はAlphabeticという性質、uはUnicode対応の解釈を指定し、testがbooleanを返します。この例のtrueとfalseはSeseragiのTrueとFalseに対応します。\\p{Letter}へ置き換えるとU+0345の条件が変わるため、同じ比較にはなりません。"

pub fn comparisonBoundary -> String =
  "比較には、それぞれ一つの正しいscalarを持つ既知のstringだけを使っています。JavaScriptのstring自体は空文字列、複数のscalar、単独のサロゲートも表せます。この正規表現を任意の文字列へ使うと、Alphabeticな文字を一つでも含むかを調べます。Seseragiでは引数のCharが一つのscalarであることを型で表します。Unicodeプロパティのデータは実行エンジンによるため、ここでの結果の一致を全Unicode値の一致とは扱いません。"
