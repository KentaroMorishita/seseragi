import * as arrays from "std/array"
import { LocalizedText, localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { ApiCopy, Editorial } from "../model"

pub fn charTextEditorial identity: String
  -> exampleId: String
  -> output: String
  -> owner: String
  -> english: ApiCopy
  -> japanese: ApiCopy
  -> comparison: LocalizedText
  -> comparisonBoundary: LocalizedText
  -> typescriptOutput: String
  -> Editorial =
  Editorial {
    identity,
    namespace: "value",
    itemKind: "function",
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-operation", localized "Use this operation" "この操作を使う"),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        CodeExample (exampleId, localized "A complete program" "そのまま実行できるプログラム"),
        Paragraph (
          [Words (
            localized
              "import gives a module a local name such as char, text, or unicode; let names a value. Arguments follow a function name separated by spaces, and parentheses group a call used inside another expression. pub effect fn main is the output entry. println prints the resulting string and a newline. Backticks form a string with the ${...} values inserted, including the line breaks shown. These operations compute values without printing or changing their inputs."
              "importはモジュールにchar、text、unicodeなどの名前を付け、letは値に名前を付けます。関数名の後ろに空白で区切って引数を書き、別の式の中で使う呼び出しは括弧で囲みます。pub effect fn mainは出力の実行入口です。printlnはできた文字列と改行を出力します。バッククォートで囲む文字列には${...}の値が入り、記述した改行も出力されます。各操作は、出力や入力の変更をせずに値を計算します。"
          )]
        ),
        Terminal (localized "Output" "実行結果", output),
        Heading ("reading-the-example", localized "Read the example" "例を順に読む"),
        Paragraph ([Words (localized english.reading japanese.reading)]),
        Paragraph ([Words (localized english.boundaries japanese.boundaries)]),
        Heading ("operation-rules", localized "Rules and boundaries" "規則と境界"),
        Paragraph ([Words (localized english.rules japanese.rules)]),
        Heading (
          "typescript-comparison",
          localized "Compare the TypeScript task" "TypeScriptで同じ目的の処理を書く"
        ),
        Paragraph ([Words comparison]),
        CodeExample (
          exampleId + "-typescript",
          localized "TypeScript counterpart and its limits" "TypeScriptの対応する処理と制限"
        ),
        Terminal (localized "TypeScript output" "TypeScriptの実行結果", typescriptOutput),
        Paragraph ([Words comparisonBoundary]),
        Heading ("operation-mistakes", localized "Choose the right rule" "目的に合う規則を選ぶ"),
        Paragraph ([Words (localized english.mistake japanese.mistake)]),
        Paragraph (
          [Words (
            localized
              "The operation is pure and available on process and browser targets without an external service. Console output belongs only to the example's main function."
              "この操作は外部サービスを必要とせず、processとbrowserの両方で使えます。コンソールへの出力は、例のmain関数が担当します。"
          )]
        ),
        Paragraph (
          [
            InternalLink (
              localized owner owner,
              "/docs/library/" + (if owner == "std/char" then
                "char/"
              else if owner == "std/text" then
                "text/"
              else
                "text/unicode/")
            ),
            Words (
              localized ": choose related operations and compare their result types."
              "：関連する操作と戻り値の違いを比べる。"
            )
          ]
        )
      ],
      related identity,
      [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
  }

fn related identity: String -> Array<Block> =
  if identity == "std/text/unicode::simpleCaseFold" then
    [Paragraph (
      [
        InternalLink (
          localized "fullCaseFold" "fullCaseFold",
          "/docs/library/text/unicode/function/fullcasefold/"
        ),
        Words (
          localized ": fold complete strings, including mappings that expand."
            "：文字数が増える変換も含め、文字列全体を比較用に変換する。"
        )
      ]
    )]
  else if identity == "std/text::trimStart"
    || identity == "std/text::trimEnd"
    || identity == "std/text::words" then
    [Paragraph (
      [
        InternalLink (
          localized "isWhitespace" "isWhitespace",
          "/docs/library/text/unicode/function/iswhitespace/"
        ),
        Words (
          localized ": inspect the White_Space property of one Char."
            "：Char一個がWhite_Spaceに含まれるかを調べる。"
        )
      ]
    )]
  else
    []
