import { ReferenceSymbol } from "../../../model/build"
import { Block } from "../../../model/page"
import { Editorial } from "../model"
import { blocks as charBlocks } from "./char-module/page"
import { editorial as codepointEditorial } from "./codepoint/page"
import { editorial as fromcodepointEditorial } from "./fromcodepoint/page"
import { editorial as tostringEditorial } from "./tostring/page"
import { editorial as trimstartEditorial } from "./trimstart/page"
import { editorial as trimendEditorial } from "./trimend/page"
import { editorial as wordsEditorial } from "./words/page"
import { editorial as generalcategoryEditorial } from "./generalcategory/page"
import { editorial as isalphabeticEditorial } from "./isalphabetic/page"
import { editorial as isdecimaldigitEditorial } from "./isdecimaldigit/page"
import { editorial as ismarkEditorial } from "./ismark/page"
import { editorial as iswhitespaceEditorial } from "./iswhitespace/page"
import { editorial as simplecasefoldEditorial } from "./simplecasefold/page"

pub fn charTextEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.namespace != "value"
    || symbol.itemKind != "function" then
    Nothing
  else
    match (symbol.module, symbol.identity) {
  ("std/char", "std/char::codePoint") -> Just (codepointEditorial ())
  ("std/char", "std/char::fromCodePoint") -> Just (fromcodepointEditorial ())
  ("std/char", "std/char::toString") -> Just (tostringEditorial ())
  ("std/text", "std/text::trimStart") -> Just (trimstartEditorial ())
  ("std/text", "std/text::trimEnd") -> Just (trimendEditorial ())
  ("std/text", "std/text::words") -> Just (wordsEditorial ())
  ("std/text/unicode", "std/text/unicode::generalCategory") -> Just (generalcategoryEditorial ())
  ("std/text/unicode", "std/text/unicode::isAlphabetic") -> Just (isalphabeticEditorial ())
  ("std/text/unicode", "std/text/unicode::isDecimalDigit") -> Just (isdecimaldigitEditorial ())
  ("std/text/unicode", "std/text/unicode::isMark") -> Just (ismarkEditorial ())
  ("std/text/unicode", "std/text/unicode::isWhitespace") -> Just (iswhitespaceEditorial ())
  ("std/text/unicode", "std/text/unicode::simpleCaseFold") -> Just (simplecasefoldEditorial ())
  _ -> Nothing
}

pub fn charTextModuleBlocks specifier: String -> Array<Block> = charBlocks specifier
