import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "一つのCharを一つのCharのまま比較用の形へ変える",
  purpose: "ギリシャ文字の大文字Σと語末の小文字ςを、文字の形の違いを除いて比べたいときに使います。simpleCaseFoldは両方をσという比較用の形へ変えます。この変換をcase foldingと呼びます。入力と結果はCharです。CharはUnicode scalarを一つ持ち、scalarはUnicodeの文字番号のうちサロゲート用の番号を除いたものです。単一引用符はChar、二重引用符はStringを作ります。見た目の一文字が複数のscalarでできる場合もあります。",
  reading: "letで'Σ'をcapital、'ς'をfinalFormと名付けます。==は値が等しいかを比べ、元の二つは別のscalarなのでsame scalarはFalseです。両方をsimpleCaseFoldへ渡すとσになり、same simple foldはTrueになります。capital foldとfinal foldの行は、比較結果だけでなく実際に返ったCharも表示します。元のcapitalやfinalFormの値は変わりません。",
  boundaries: "simpleは、必ず一つのscalarを一つのscalarへ変える規則です。ßはßのまま、ẞはßになります。ßを二つのsへ広げることはできません。点付き大文字İもİのままなので、iを変換した結果とは等しくありません。Char -> Charという型はこの一つから一つへの条件を表します。",
  rules: "Unicodeの既定のsimple foldingに従い、CaseFoldingデータのC（共通）とS（simple）の対応を使います。対応がなければ元のCharを返します。複数のscalarへ広がるfull専用の対応や、トルコ語系のTという特別な対応は使いません。言語設定を受け取らず、正規化も行いません。一回の呼び出しは固定されたUnicode 17.0.0の表で一つのscalarを調べ、出力も一つのscalarです。Σとςから同じσができるため、結果だけから元の表記は復元できません。",
  mistake: "表示用の小文字化とは条件が違います。例えばςを小文字化してもςのままですが、この関数はσへ変えます。元の表記を表示するならcapitalやfinalFormを残してください。String全体の比較やßからssへの展開が必要ならfullCaseFoldを選びます。simpleCaseFoldへ\"Σς\"を渡すと、StringはCharではないため型エラーになります。複数の文字を一つのCharに詰めず、目的に合うStringの操作を使ってください。",
}

pub fn comparison -> String =
  "TypeScriptでこの例の等値比較を行うなら、Unicode対応の大文字・小文字を区別しない正規表現が使えます。/^Σ$/iuのiが大文字・小文字を区別しない比較、uがUnicode対応の解釈を選びます。^と$は入力の先頭と末尾を指定します。ここでは改行を含まない、同じ既知の一scalar入力を使います。Σとς、ßとẞはそれぞれ同じと判定され、İとiは同じになりません。"

pub fn comparisonBoundary -> String =
  "この正規表現が返すのはbooleanで、変換後のCharではありません。JavaScriptの標準文字列メソッドには、simpleCaseFoldと同じ一scalarから一scalarへの結果を直接返すものはありません。toLowerCaseも代わりにはならず、ςはςのまま、İはiと結合点の二つのscalarになります。変換値が必要なら、版を確認できるUnicode case-foldデータやライブラリーが必要です。正規表現のデータは実行エンジンによるため、例の一致を全Unicode値の一致とは扱いません。"
