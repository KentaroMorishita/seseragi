import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "空白で区切られた文字列の部分を配列にする",
  purpose: "空白で区切られた入力をいくつかの部分として扱うときは、wordsを使います。結果はStringの配列Array<String>です。区切りはUnicodeのWhite_Spaceという空白の集合で、連続した空白や両端からは空の要素を作りません。句読点はそのまま残ります。",
  reading: "sentenceにはhello,と世界!の間にEM SPACEを置いています。\\u{2003}はその空白を番号で書いた表記です。piecesには二つのStringが入り、json.encodeStringは配列を引用符付きのJSON表記にして出力を読みやすくします。text.join \" | \" piecesは同じ二つの部分を縦棒でつなぎます。",
  boundaries: "hello,のカンマと世界!の感嘆符は削除されません。東京都渋谷区にはWhite_Spaceがないため一要素のままです。空文字列と空白だけの入力では空配列になります。FEFF preserved行は、White_Spaceに含まれない\\u{FEFF}が最初の要素の末尾に残ることを確かめています。",
  rules: "これは空白を境にした分割で、辞書を使った単語の判定や日本語の形態素解析ではありません。区切りに使うUnicodeの版はSeseragiで固定され、文字の綴りや正規化形式は変えません。処理は入力と出力のUTF-8バイト数に対して線形です。",
  mistake: "名前から見た目や言語に応じた単語を返すと考えないでください。特定の文字列を区切りにし、空の要素も残したいならsplitが対応します。入力が空白だけでも空要素一個が返るという前提は誤りで、この場合のwordsは[]を返します。",
}

pub fn comparison -> String =
  "TypeScriptの例では、\\p{White_Space}+という正規表現で空白の連続を区切り、filterで空の要素を除きます。\\p{...}がUnicodeの性質を選び、+が一個以上、uがUnicodeに対応した解釈の指定です。JSON.stringifyはSeseragi側のjson.encodeStringと同様に配列を表示しています。"

pub fn comparisonBoundary -> String =
  "よく使われる\\sは別の空白集合です。このホストではNELを空白にせず、FEFFは空白にするため、例の最後の二行で違いを示しています。White_Spaceを指定したTS例とSeseragiは、ここで使った入力の分割が一致します。すべての文字の振る舞いやホスト内部のUnicode版まで一致するとは、この例からは言えません。"
