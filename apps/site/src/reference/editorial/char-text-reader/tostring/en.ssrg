import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Use a Char in a String label",
  purpose: "To place a symbol held as Char into a String label, convert it with toString. Char represents one scalar, a permitted Unicode code point. Single-quoted '👍' is Char, while double-quoted \"Status: \" is String, so make their types agree before joining the text.",
  reading: "Pass symbol to char.toString and name the resulting String value. label joins \"Status: \" and value with +. After printing Status: 👍, the program prints the scalar count and UTF-8 byte count of value alone.",
  boundaries: "value contains exactly the original 👍 scalar, giving a count of 1. Encoding that same value as UTF-8 takes 4 bytes, so the counts differ. A visible character made of several scalars cannot be packed into one Char; use String for the whole piece.",
  rules: "The result is a String containing the same one scalar. This does not turn the character’s number into decimal digits. Use codePoint for that number, or fromCodePoint to construct a Char from a number. No normalization or letter-case conversion occurs.",
  mistake: "'e\\u{0301}' contains e and a combining accent, two scalars, so it is rejected as a Char literal. To preserve that spelling, use the String \"e\\u{0301}\". Rewriting it to the differently represented 'é' is not a representation-preserving conversion of the original data.",
}

pub fn comparison -> String =
  "In TypeScript, the same symbol is already a String. No special conversion is needed for this input; it can go straight into a template string. Array.from counts the scalar-side units of this well-formed text, and TextEncoder produces its UTF-8 bytes."

pub fn comparisonBoundary -> String =
  "Both versions print Status: 👍, scalar count 1, and UTF-8 byte count 4. This does not mean an arbitrary JS String contains exactly one scalar. Seseragi’s Char parameter expresses that single-scalar input requirement."
