import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Get the Unicode number of one Char",
  purpose: "To log the number behind a symbol, pass a Char to codePoint. Char represents one Unicode scalar, a permitted Unicode code point, and is written with single quotes. The example’s '👍' is one scalar. A visible character can contain several scalars, so Char does not always represent the entire visible piece.",
  reading: "symbol holds the Char for 👍. char.codePoint symbol returns its number, 128077, as an Int. The next line gets 65 for A, and the last gets 0 for the null character. The escape \\0 writes that null character; it is different from the digit character '0'.",
  boundaries: "128077 is neither a position inside a string nor one UTF-8 byte. Encoding 👍 as UTF-8 takes four bytes, while it still has one Unicode number. This operation inspects that number; it does not extract part of a String.",
  rules: "The argument must be Char, so an empty or multi-scalar String cannot be passed. Code points D800 through DFFF form the surrogate range used by UTF-16 encoding. They are not scalars and cannot occur in Char. The operation does not change spelling or letter case.",
  mistake: "Double-quoted \"👍\" is a String. Passing it directly to codePoint causes an argument type error because Char is required. Write '👍' for this known single-scalar literal. To inspect an arbitrary String, use scalarAt and handle the case where no value exists.",
}

pub fn comparison -> String =
  "In TypeScript, codePointAt(0) works on a String containing the same known symbol. The first three lines give the same Unicode numbers. charCodeAt(0) instead reads the first UTF-16 code unit, 55357, and String.length counts two UTF-16 code units."

pub fn comparisonBoundary -> String =
  "This TS symbol is known to contain one scalar. An arbitrary String can be empty or contain more text, and codePointAt returns undefined for an out-of-range position. JavaScript has no separate Char type; do not extend this example’s input assumption to every String."
