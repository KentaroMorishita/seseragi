import { localized } from "../../../../model/locale"
import { Editorial } from "../../model"
import { charTextEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  charTextEditorial "std/char::codePoint" "char-text-codepoint" "symbol: 128077\nletter: 65\nnull: 0" "std/char" (en.copy ()) (ja.copy ()) (localized (en.comparison ()) (ja.comparison ())) (localized (en.comparisonBoundary ()) (ja.comparisonBoundary ())) "symbol: 128077\nletter: 65\nnull: 0\nfirst UTF-16 unit: 55357\nUTF-16 units: 2"
