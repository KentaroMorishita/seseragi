import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Test whether one Char belongs to Unicode’s White_Space property",
  purpose: "When inspecting separators or padding, use isWhitespace to ask whether one character has Unicode’s White_Space property. Seseragi’s trim and words operations use the same condition. The input Char holds exactly one Unicode scalar: a Unicode code-point value excluding the numbers reserved for surrogates. Single-quoted ' ' is a Char containing one space, not an empty value. Double quotes make a String.",
  reading: "let names an ordinary space as space and passes it to unicode.isWhitespace space. The result type Bool has values True and False; the space gives True. '\\t' is an escape spelling a single tab Char, which also gives True. NEL means NEXT LINE, code point U+0085; EM SPACE is the wider space U+2003. Both satisfy the condition. The output labels name these hard-to-see inputs.",
  boundaries: "U+FEFF and zero-width space U+200B give False. The digits after U+ are hexadecimal code points, and escapes such as \\u{FEFF} write the corresponding scalar. Being invisible or having SPACE in a character’s name does not establish White_Space membership. The False result for U+FEFF is intentional. False is an ordinary property result, not invalid input.",
  rules: "Char -> Bool means that the function takes one Char and returns the test result. It uses the pinned Unicode 17.0.0 White_Space table. Each call inspects one scalar without scanning an entire String, removing, replacing, or normalizing anything. Char is not a visible group; multiple scalars cannot be passed as one Char.",
  mistake: "isWhitespace does not remove padding from a whole String. Choose trimStart or trimEnd to clean an edge, or words to split whitespace-separated parts. Using White_Space as a rule for removing every invisible character would leave U+FEFF and U+200B. Decide which characters the particular task should remove or preserve.",
}

pub fn comparison -> String =
  "TypeScript can test the same six inputs with /\\p{White_Space}/u.test(value). \\p{White_Space} names the Unicode property, u selects Unicode-aware interpretation, and test returns true or false, corresponding here to True and False. The familiar \\s uses a different set: JavaScript’s \\s returns false for NEL and true for U+FEFF."

pub fn comparisonBoundary -> String =
  "This comparison is restricted to known strings containing exactly one valid scalar. JavaScript string does not enforce that requirement; on arbitrary text the expression answers whether it contains a matching character. JavaScript’s trim also does not necessarily use the White_Space property’s set. Property data depends on the engine, so matching these examples does not guarantee equality for all Unicode values."
