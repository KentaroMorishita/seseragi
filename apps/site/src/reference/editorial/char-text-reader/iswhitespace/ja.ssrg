import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "一つのCharがUnicodeのWhite_Spaceに属するか調べる",
  purpose: "文字列の区切りや余白を調べるとき、一つの文字がUnicodeのWhite_Spaceという性質を持つか確認できます。isWhitespaceが使う条件は、Seseragiのtrimやwordsでも使います。入力のCharはUnicode scalarを一つだけ持ちます。scalarはUnicodeの文字番号のうちサロゲート用の番号を除いたものです。単一引用符の' 'は空白一つのCharで、空の値ではありません。二重引用符はStringを作ります。",
  reading: "letで普通の空白をspaceと名付け、unicode.isWhitespace spaceへ渡します。戻り値のBoolはTrueかFalseで、空白はTrueです。'\\t'はタブ一つをエスケープで書いたCharで、これもTrueです。NELはNEXT LINEの略で文字番号U+0085、EM SPACEは幅の広い空白U+2003で、両方ともこの条件に入ります。見えにくい入力なので、結果には名前を付けています。",
  boundaries: "U+FEFFとゼロ幅スペースU+200BはFalseです。U+の後ろは16進数の文字番号で、\\u{FEFF}などはそのscalarを書くエスケープです。画面上で見えにくいことや、名前にSPACEが入ることだけではWhite_Spaceになりません。U+FEFFがFalseなのも意図した規則です。Falseは入力の失敗ではなく、その性質に属さないという結果です。",
  rules: "Char -> Boolは、一つのCharを受け取り判定結果を返すという型です。判定には固定されたUnicode 17.0.0のWhite_Space表を使います。一回の呼び出しは一つのscalarを調べ、String全体を走査しません。入力を削除、置換、正規化することもありません。Charは見た目のまとまりという意味ではなく、複数のscalarを一度に判定する引数にはできません。",
  mistake: "isWhitespaceでString全体の余白が削れるわけではありません。先頭や末尾を整えるならtrimStartやtrimEnd、空白区切りの部分へ分けるならwordsを選びます。また、見えない文字をすべて削除する条件としてWhite_Spaceを使うと、U+FEFFとU+200Bは残ります。削除したい文字と残したい文字を用途に合わせて決めてください。",
}

pub fn comparison -> String =
  "TypeScriptでは/\\p{White_Space}/u.test(value)で同じ六つの入力を調べます。\\p{White_Space}はUnicodeの性質を指定し、uはUnicode対応の解釈を選びます。testのtrueとfalseは、ここではSeseragiのTrueとFalseに対応します。通常の\\sとは条件が違い、JavaScriptの\\sはNELにfalse、U+FEFFにtrueを返します。"

pub fn comparisonBoundary -> String =
  "この比較は、正しいscalar一つだけを持つ既知のstringに限定しています。JavaScriptのstringはその条件を保証せず、正規表現は任意の文字列なら該当する文字を含むかを答えます。JavaScriptのtrimもWhite_Spaceプロパティと同じ集合とは限りません。プロパティのデータは実行エンジンによるため、ここでの一致だけで全Unicode値の一致を保証しません。"
