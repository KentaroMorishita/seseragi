pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "共通の記法のパターンを作り、成功時はRightにRegex、拒否時はLeftにRegexCompileErrorを返します。",
  taskTitle: "検索する前にパターンを確認する",
  purpose: "パターンはデータなので、正しくない場合もあります。compileなら、その拒否を値として処理してからRegexを使えます。パターンを作れても、指定した入力に一致するとは限りません。",
  setup: "例では四つのパターン文字列をcompileに渡します。[0-9]+はASCIIの数字の一回以上の繰り返しです。checkのString入力をsourceと名付け、matchで作成の成功と失敗を扱います。",
  after: [
    "compileは、再利用できるRegexをRight patternに、正しくないパターンの情報をLeft errorに入れて返します。matchは形に合う分岐を選び、中の値に名前を付けます。バッククォートのエラー文では${error.offset}に位置が入り、0から数えたUTF-8のバイト数で表します。",
    "注文番号のパターンはORD-42に一致します。閉じていないé[はバイト位置3で拒否されます。éが2バイト、[が1バイトです。a(?=b)は未対応の先読みとして位置2で拒否されます。(?=b)は、後にbがあるかだけを確かめ、一致した文字列にはbを含めない記法です。ソースの文字列\"\\\\d+\"では、二つのバックスラッシュが、パターン\\d+に渡す一つのバックスラッシュを表します。",
    "pub effect fn mainが実行入口です。doの中でprintlnを順に実行します。呼び出しの引数は空白で区切ります。showは値を表示用の文字列にし、Seseragiの真偽値はTrueとFalseで表します。"
  ],
  comparisonBefore: "new RegExp(source, \"u\")は、JavaScriptとして不正なパターンならSyntaxErrorを投げます。try/catchを使えば、呼び出し元へ通常の結果として返せます。この例では、毎回新しい正規表現を作り、gは付けていません。",
  comparisonAfter: "JavaScriptはa(?=b)を受け付けるため、その行は作成失敗ではなく、一致しなかった結果です。エラー文や位置の示し方は実行環境によって異なり、Seseragiの型付きエラーとUTF-8の位置の規則とは別です。",
  details: [
    "Leftのerrorはkindとoffsetを持ちます。パターンの拒否は通常のEitherの結果で、コンパイラーの診断やcompileが投げる例外ではありません。Regexを要求する操作は、Rightの分岐で呼びます。",
    "compileは三つの設定がすべてFalseのdefaultOptionsを使います。設定を選ぶならcompileWith、入力を文字どおりに扱うならescapeを使ってください。先読み・後読み、後方参照、\\bなどの拒否を直す際は、JavaScriptのパターンをそのまま使えるとは考えず、対応するパターンと抽出後の確認処理に分けます。"
