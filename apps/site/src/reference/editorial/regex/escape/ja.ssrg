import { CorrectionCopy } from "../../correction-model"

pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "文字列を、その文字どおりに一致する共通のパターン断片へ変換します。",
  taskTitle: "記号を含むファイル名をそのまま探す",
  purpose: "a+b.txtのようなファイル名には、正規表現では繰り返しや任意の文字を表す記号が含まれます。escapeで引用すると、ファイル名の文字そのものを探せます。",
  setup: "探したいStringをescapeに渡し、その結果をcompileへ渡します。containsLiteralには、探す文字列、検索対象の順に渡します。escapeの戻り値はStringの断片で、まだRegexではありません。",
  after: [
    "a\\+b\\.txtという断片では、+と.が文字どおりの意味になります。a+b.txtは見つかり、aaabXtxtには一致しません。空文字列をescapeすると空のパターンになり、文字がある入力にも一致できます。",
    "compileは、再利用できるRegexをRight patternに、正しくないパターンの情報をLeft errorに入れて返します。matchは形に合う分岐を選び、中の値に名前を付けます。バッククォートのエラー文では${error.offset}に位置が入り、0から数えたUTF-8のバイト数で表します。",
    "pub effect fn mainが実行入口です。doの中でprintlnを順に実行します。呼び出しの引数は空白で区切ります。showは値を表示用の文字列にし、Seseragiの真偽値はTrueとFalseで表します。"
  ],
  comparisonBefore: "文字どおりの文字列が含まれるかだけなら、TypeScriptではString.includesを使えます。RegExpを作らず、+や.を普通の文字として扱います。この問いだけなら、直接の文字列検索で十分です。",
  comparisonAfter: "三つの真偽値は、Seseragi側の三つの文字列検索に対応します。String.includesは引用したパターン断片を作りません。文字列を大きなRegexパターンの一部にする場合にescapeを使います。文字どおりの検索だけなら、パターン記法は不要です。",
  details: [
    "escapeはパターンの記法を引用しますが、始端や終端の指定は加えません。そのため、長いメッセージの中にファイル名があっても見つかります。入力全体を同じ文字列に限定したい場合は、対応する位置指定を別に加えます。",
    "戻り値はRegexの記法用です。HTML・SQL・URL・置換文字列用のエスケープではありません。実行結果に見えるバックスラッシュはパターンの一部です。ソースの文字列内に書く場合は、バックスラッシュ自体をエスケープします。"
  ],
  codeTitle: "境界も確認する完全なプログラム",
  outputTitle: "Seseragiの実行結果",
  comparisonTitle: "TypeScriptで同じ処理を表す",
  detailTitle: "使うときに確かめたい規則"
}
