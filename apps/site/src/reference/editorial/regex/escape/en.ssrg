import { CorrectionCopy } from "../../correction-model"

pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "Turn text into a portable pattern fragment that matches those characters literally.",
  taskTitle: "Search for a filename containing punctuation",
  purpose: "A filename such as a+b.txt contains characters that mean repetition or any character in a regex. escape quotes those characters so the filename can be searched as text.",
  setup: "Pass the wanted String to escape, then pass its result to compile. In this example containsLiteral receives the wanted text first and the text to search second. escape returns a String fragment, not a Regex.",
  after: [
    "The fragment a\\+b\\.txt gives + and . their literal meanings. It finds a+b.txt and rejects aaabXtxt. Escaping an empty string produces an empty pattern, which can match even in nonempty input.",
    "compile returns Right pattern for a reusable Regex or Left error for an invalid pattern. match chooses a branch and names the value inside it. The backtick error message inserts error.offset at ${error.offset}; that offset counts UTF-8 bytes from zero.",
    "pub effect fn main is the program entry. do runs the println output steps in order. Calls separate arguments with spaces. show converts a value to display text; True/False are the Seseragi Boolean spellings."
  ],
  comparisonBefore: "For a literal contains check, TypeScript can simply use String.includes. It treats + and . as ordinary characters without building a RegExp. This is a smaller solution when the caller only needs literal containment.",
  comparisonAfter: "The three Booleans correspond to the three literal searches in the Seseragi example. String.includes does not produce an escaped pattern fragment. Use Seseragi escape when the text needs to become part of a larger Regex pattern; a literal text search needs no pattern syntax.",
  details: [
    "escape quotes pattern syntax; it does not add start/end anchors. Searching for an escaped filename still succeeds when the filename appears inside a longer message. Add supported anchors separately if the whole input must equal it.",
    "The returned fragment is for Regex syntax, not HTML, SQL, URL or replacement-text escaping. The backslashes visible in the output belong to the pattern; a backslash written inside a source string must itself be escaped."
  ],
  codeTitle: "Complete program and boundary cases",
  outputTitle: "Seseragi output",
  comparisonTitle: "The same task in TypeScript",
