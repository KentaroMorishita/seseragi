import { CorrectionCopy } from "../../correction-model"

pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "Return the first RegexMatch, including matched text, UTF-8 byte span and captures, or Nothing when no match exists.",
  taskTitle: "Extract the first order code and optional tag",
  purpose: "find returns more than a yes/no answer. Read found.text for the matched substring, and inspect optional captures when the order code may have an extra tag.",
  setup: "(?<code>...) names the order-code group. (?:...) groups syntax without adding a capture slot; the final ? makes the -tag part optional. (?<tag>[A-Z]+) names the uppercase tag. The example imports maps and arrays to inspect the named groups and capture count.",
  after: [
    "compile returns Right pattern for a reusable Regex or Left error for an invalid pattern. match chooses a branch and names the value inside it. The backtick error message inserts error.offset at ${error.offset}; that offset counts UTF-8 bytes from zero.",
    "The outer find result is Just found or Nothing. found.span.start and end are zero-based UTF-8 byte positions, with end excluded. The prefix é plus a space occupies three bytes, so ORD-42 spans 3..9. found.text already supplies that substring safely.",
    "found.captures has two slots, one for each capturing group in opening-parenthesis order. It excludes the whole-match group 0. maps.get \"tag\" found.named has two optional layers: Just (Just capture) means declared and matched, Just Nothing means declared but absent, and Nothing means no such group name was declared. capture.text reads the captured string.",
    "pub effect fn main is the program entry. do runs the println output steps in order. Calls separate arguments with spaces. show converts a value to display text; True/False are the Seseragi Boolean spellings."
  ],
  comparisonBefore: "JavaScript exec returns null or a match array. Its index and the matched string length count UTF-16 units. Element 0 is the whole match; groups.tag is undefined when this declared optional group did not participate. The pattern is recreated without g or y.",
  comparisonAfter: "Here JavaScript reports 2..8, while Seseragi reports bytes 3..9 for the same ORD-42. Neither range should be fed to the other string-indexing system. Use the supplied matching text when extracting; do not slice a JavaScript string by Seseragi byte offsets.",
  details: [
    "find selects the leftmost matching start. At that start, the earlier alternative wins, then greedy quantifiers consume as much as allowed within it. With a|aa on xaa, the first match is a, not aa.",
    "An unmatched capture is Nothing; a group that participates and captures an empty string is Just with empty text. Named keys remain present for declared groups even when they do not participate. For every non-overlapping match rather than the first, use findAll."
  ],
  codeTitle: "Complete program and boundary cases",
  outputTitle: "Seseragi output",
  comparisonTitle: "The same task in TypeScript",
  detailTitle: "Matching rules to keep in view"
}
