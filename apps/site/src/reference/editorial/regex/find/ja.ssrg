import { CorrectionCopy } from "../../correction-model"

pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "最初の一致をRegexMatchで返します。一致した文字列、UTF-8のバイト範囲、グループの値を持ち、一致しなければNothingです。",
  taskTitle: "最初の注文番号と任意のタグを取り出す",
  purpose: "findは有無だけでなく、一致の情報を返します。found.textで一致した部分を読み、注文番号にタグが付く場合は、任意のグループの値も調べられます。",
  setup: "(?<code>...)は注文番号のグループに名前を付けます。(?:...)は値を取り出す枠を増やさずに記法をまとめ、末尾の?は-tag部分を省略可能にします。(?<tag>[A-Z]+)は大文字のタグです。名前付きグループと個数を調べるため、mapsとarraysも読み込みます。",
  after: [
    "compileは、再利用できるRegexをRight patternに、正しくないパターンの情報をLeft errorに入れて返します。matchは形に合う分岐を選び、中の値に名前を付けます。バッククォートのエラー文では${error.offset}に位置が入り、0から数えたUTF-8のバイト数で表します。",
    "findの結果はJust foundかNothingです。found.span.startとendは、0から数えたUTF-8のバイト位置で、endは範囲に含めません。先頭のéと空白は合わせて3バイトなので、ORD-42は3..9です。切り出した文字列はfound.textから安全に読めます。",
    "found.capturesには、取り出すグループの左括弧順に二つの枠が入ります。一致全体のグループ0は含みません。maps.get \"tag\" found.namedには有無が二段階あります。Just (Just capture)は宣言されて一致した値、Just Nothingは宣言されているが一致しなかった場合、Nothingはその名前の宣言がない場合です。capture.textで中の文字列を読みます。",
    "pub effect fn mainが実行入口です。doの中でprintlnを順に実行します。呼び出しの引数は空白で区切ります。showは値を表示用の文字列にし、Seseragiの真偽値はTrueとFalseで表します。"
  ],
  comparisonBefore: "JavaScriptのexecはnullか一致の配列を返します。indexと一致文字列のlengthは、UTF-16の単位で数えます。0番目は一致全体で、宣言した任意のグループが使われなければgroups.tagはundefinedです。この例はgとyを使わず、毎回パターンを作ります。",
  comparisonAfter: "同じORD-42でも、JavaScriptでは2..8、Seseragiのバイト範囲では3..9です。一方の位置を、他方の文字列の添字として使わないでください。抽出には用意された一致文字列を使えます。Seseragiのバイト位置でJavaScriptの文字列をsliceすることはできません。",
  details: [
    "findは、最も左で始まる一致を選びます。同じ開始位置では先に書いた選択肢を優先し、その中で繰り返しをできるだけ長く取ります。xaaに対するa|aaの最初の一致は、aaではなくaです。",
    "一致しなかったグループはNothingです。グループが使われて空文字列を取り出した場合は、空のtextを持つJustになります。宣言した名前は、一致しなくてもnamedに残ります。重ならないすべての一致が必要ならfindAllを使います。"
  ],
