import { CorrectionCopy } from "../../correction-model"

pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "Return all non-overlapping RegexMatch records from left to right, advancing one scalar after an empty match.",
  taskTitle: "Collect every order code in a message",
  purpose: "Use findAll when one input can contain several references. The result is an Array, empty when no match exists. Each element has the same text, span and capture fields as a find result.",
  setup: "After compile succeeds, the comprehension [result | found <- values] computes one display string per match. This <- iterates an Array; it is not an Effect execution step. Each display string reads the match’s byte start, excluded end, and text.",
  after: [
    "compile returns Right pattern for a reusable Regex or Left error for an invalid pattern. match chooses a branch and names the value inside it. The backtick error message inserts error.offset at ${error.offset}; that offset counts UTF-8 bytes from zero.",
    "Two order references produce two records in source order; no reference produces []. An empty pattern on a👍 matches at byte positions 0, 1 and 5. The terminal empty match is included, and progress skips one scalar after each earlier empty match.",
    "The a|aa example chooses the first alternative at each leftmost start; a+ greedily takes both letters. Dot on 👍🏽 produces two matches: the emoji and its modifier are separate scalars even though they form one visible piece.",
    "pub effect fn main is the program entry. do runs the println output steps in order. Calls separate arguments with spaces. show converts a value to display text; True/False are the Seseragi Boolean spellings."
  ],
  comparisonBefore: "String.matchAll with a fresh gu RegExp provides non-overlapping JavaScript matches and handles empty-match progress. This avoids writing an exec loop that can get stuck on an empty match. Its displayed offsets still count UTF-16 units.",
  comparisonAfter: "ASCII positions agree. On a👍 the final JavaScript position is 3 instead of byte 5; for 👍🏽 the ranges are 0..2 and 2..4 rather than bytes 0..4 and 4..8. The same matched text can have different numeric spans.",
  details: [
    "Matches do not overlap. If the pattern can match empty text, findAll includes the end-of-input empty match before stopping. Empty input and an empty pattern therefore still yield one match.",
    "Ordering is deterministic for a pattern and input: leftmost start, earlier alternative, then greedy repetition within that choice. Use find when only the first match is needed; use the text field rather than re-slicing by incompatible offsets."
  ],
  codeTitle: "Complete program and boundary cases",
  outputTitle: "Seseragi output",
  comparisonTitle: "The same task in TypeScript",
  detailTitle: "Matching rules to keep in view"
}
