import { CorrectionCopy } from "../../correction-model"

pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "Replace every non-overlapping match with the supplied literal String; capture markers and backslashes are not expanded.",
  taskTitle: "Insert replacement text exactly as supplied",
  purpose: "Use replaceAll when the replacement is data, such as a label chosen by the caller. Its characters are inserted literally even if they look like capture references.",
  setup: "replace compiles the source pattern, then calls replaceAll with Regex, replacement String and input String in that order. ([0-9]+) captures a run of digits, but the literal replacement does not refer to that capture.",
  after: [
    "compile returns Right pattern for a reusable Regex or Left error for an invalid pattern. match chooses a branch and names the value inside it. The backtick error message inserts error.offset at ${error.offset}; that offset counts UTF-8 bytes from zero.",
    "The first replacement value contains $1 and a backslash. The source writes \"$1\\\\\" so one backslash reaches the function. Both matches become that exact value. With no matching digits, the input stays unchanged. An empty pattern inserts | at each scalar boundary, including both ends; on empty input it inserts one |.",
    "pub effect fn main is the program entry. do runs the println output steps in order. Calls separate arguments with spaces. show converts a value to display text; True/False are the Seseragi Boolean spellings."
  ],
  comparisonBefore: "JavaScript replacement strings expand $1 and other markers. To perform the same literal task, return the supplied string from a replacement callback. A fresh gu pattern handles all matches with Unicode-aware empty-match progress.",
  comparisonAfter: "The first four results agree. The final TypeScript line deliberately passes \"$1\\\\\" as a replacement string rather than using the callback; JavaScript expands $1 into the captured digits. This is a different contract, visible in a12\\b3\\.",
  details: [
    "Seseragi replaceAll never expands $1, $&, or backslashes in its replacement argument. Use replaceAllWith when the output depends on a capture or match position.",
    "Matches are non-overlapping and processed in source order. Replacement text is not scanned again for more matches. Both the input and Regex remain unchanged."
  ],
  codeTitle: "Complete program and boundary cases",
  outputTitle: "Seseragi output",
  comparisonTitle: "The same task in TypeScript",
