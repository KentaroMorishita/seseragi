import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "lengthは配列の要素数をIntで返します。0や同じ値が繰り返されても1要素ずつ数え、空の配列では0を返します。",
  taskTitle: "0の結果も含めて一覧の件数を数える",
  purpose: "一覧の横に表示する件数を求めます。例では空の結果、0という結果が1件ある場合、[0, 2, 0]の3件を比べます。合計値や異なる値の種類ではなく、一覧に何件あるかを数えます。",
  typescriptBefore: "TypeScriptでは配列の.lengthを読むだけです。none.length、one.length、several.lengthが、それぞれ0、1、3になります。例の前半には、同じ配列の空判定を.length === 0で書いた場合も含まれています。",
  benefit: "Seseragiもitems.length valuesという1回の呼び出しで件数を得られます。引数はArray<A>、結果は整数のIntです。TypeScriptの簡潔さを保ちながら、配列を渡す通常の関数として使えます。",
  setup: "itemsはstd/array、jsonはstd/jsonのimportの別名です。let none: Array<Int> = []は整数の配列だと明示した空の値です。oneとseveralは要素の0や2から整数の配列だとわかります。items.length oneのように、関数名の後へ配列を渡します。",
  after: [
    "最後の3行がlengthの結果です。noneは0、oneは1、severalは3になります。severalに0が2回出てきても、それぞれ別の要素として数えます。",
    "show (items.length one)は、lengthが返すIntを表示用のStringに変えます。括弧内の件数を先に求め、その結果をshowへ渡しています。",
    "前半のisEmptyは空かどうかをBoolで返します。[]だけが空で、[0]、[False]、[\"\"]は空ではありません。JSONの表示ではBoolが小文字のtrueまたはfalseになります。",
  ],
  details: [
    "lengthは値の合計を求めません。[0, 2, 0]は3件であり、合計の2でも、異なる値の種類数の2でもありません。Falseや空文字列も、配列に入っていれば1要素です。",
    "配列内の文字列の長さではなく、配列の要素数を返します。たとえば長いラベルが1個あれば1件です。文字列の文字数を調べる操作とは、入力も目的も異なります。",
    "必要なのが空かどうかだけならisEmptyを使えます。件数を得ても、その位置に要素があるとは限りません。要素数が3なら有効な位置は0から2で、get 3はNothingになります。",
  ],
}
