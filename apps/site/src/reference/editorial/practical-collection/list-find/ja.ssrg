import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "items.findは、条件の関数がTrueを返すListの最初の要素をJustで返します。一致する要素がなければNothingです。",
  taskTitle: "最初の急ぎのタスクを一件見つける",
  purpose: "急ぎのタスクを一件だけ取り出して表示します。ReviewとShipの両方が急ぎでも、元の順序で先にあるReviewを選びます。見つからない場合と空の一覧にも対応します。",
  typescriptBefore: "通常の配列のfindで最初の一致を探し、undefinedならnot found、それ以外ならtitleを表示します。ネイティブのfindで十分に簡潔です。この配列は同じ検索作業の比較用で、Listの内部表現や速度を再現するものではありません。",
  benefit: "Seseragiでは、検索の条件がTask -> Bool、結果がMaybe<Task>として表れます。見つかったTaskを使う前に、JustとNothingの二つの場合を分けて読めます。",
  setup: "struct Taskはtitleとurgentを持つレコードの型、Task { ... }はその値です。tasksの角括弧の前にあるバッククォートはListを作る印で、ない場合はArrayになります。itemsはstd/listの別名です。",
  after: [
    "fn urgent task: Task -> Boolはタスク一件を受け取り、task.urgentを返します。items.find urgent tasksは条件の関数、Listの順に渡します。ReadではFalse、ReviewではTrueなので、結果はReviewのTaskを持つJustです。",
    "describeのmatchは、Just taskならtask.title、Nothingならnot foundを返します。結果はまずReview、続いて存在しないタイトルを探したnot found、空のListを探したnot foundです。items.empty<Task> ()は要素の型を指定した空のListです。",
    "\\task -> task.title == \"Missing\"は、その場で作る関数です。taskが入力、->の右側の等値比較がBoolの結果です。最後の[task.title | task <- tasks]は元のListからタイトルのArrayを作る内包表記で、JSONの表示には三件とも残っています。",
  ],
  details: [
    "findは先頭から順に調べ、最初にTrueになった時点で止まります。この例ではShipまで調べる必要はありません。一件も一致しなければNothingで、空の入力では条件を一度も呼びません。",
    "0、False、空文字列も、条件に一致すればJustに入ります。「見つからない」はNothingで表し、値が小さい、偽である、文字がないといった内容とは分けます。",
    "Maybe<Task>はTaskそのものではないので、そのままTaskを必要とする処理へ渡せません。例のようにmatchでJustの中身を取り出し、Nothingの場合も決めておきます。条件の関数も、文字列ではなくBoolを返す必要があります。",
    "一致した全件が欲しい場合はfilterを選びます。findは最初の一件をMaybeで返し、filterは一致する要素をすべて元の順番でListに残します。どちらも入力のtasksの内容は変えません。",
  ],
}
