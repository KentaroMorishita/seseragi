import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "getは、0から数える位置にある配列の要素をMaybeで返します。負の位置や範囲外ならNothingになり、空文字列などの値と不在を区別できます。",
  taskTitle: "選んだ位置のラベルを、ない場合も含めて読む",
  purpose: "一覧の選択位置からラベルを読みます。例のラベルは空文字列とReviewの2件です。空欄のラベルも1件として扱い、位置が範囲外のときだけmissingと表示します。",
  typescriptBefore: "TypeScriptではlabels[index]で読み、=== undefinedで不在を判定します。この短い書き方で十分です。if (label)のような判定では、存在する空文字列まで不在と扱ってしまいます。例は通常の密な配列を使い、負の添字や範囲外でもundefinedになることを確かめます。",
  benefit: "Seseragiでは結果の型がMaybe<String>になり、Justに入ったラベルとNothingという不在を分けて扱います。配列の値を直接Stringとして使う前に、不在の場合の表示を決められる点が利点です。",
  setup: "itemsはstd/arrayを読み込むimportの別名、jsonはstd/jsonの別名です。[\"\", \"Review\"]はStringの配列です。items.get 1 labelsは、整数の位置1、配列labelsの順に、空白で引数を渡す呼び出しです。",
  after: [
    "fn describe value: Maybe<String> -> Stringは、値があるかもしれない結果valueを、表示用のStringに変える関数です。matchで分け、Just labelなら中の文字列をlabelとして使い、Nothingならmissingを返します。枝の->の右側が、その場合の結果です。",
    "最初の2行は位置0の空文字列と位置1のReviewです。json.encodeString labelが文字列を引用符付きで表示するため、present: \"\"が「存在する空欄」だとわかります。",
    "続く3行は負の位置、位置2、空の配列の位置0なので、いずれもmissingです。(0 - 1)は負の整数-1を作り、items.empty<String> ()は要素型をStringと指定した空の配列を作ります。",
    "最後の2行はheadによる先頭の読み取りです。同じdescribeで、labelsの先頭はpresent: \"\"、空の配列はmissingになります。先頭だけ必要なら、位置を渡さないheadも使えます。",
  ],
  details: [
    "位置は0から始まります。要素数が2なら使える位置は0と1です。負の位置や要素数以上の位置はNothingになり、末尾から数え直しません。JavaScriptのlabels.at(-1)は末尾のReviewを返すので、getの負の位置と同じ意味ではありません。",
    "値が0、False、空文字列でも、その位置に要素があればJustに入ります。この例で表示するのは空文字列の場合です。JustとNothingの区別は、値が「空っぽに見えるか」ではなく、その位置に要素があるかを表します。",
    "位置の型はIntです。1.5のようなFloatは渡せません。配列の引数はArray<A>で、List<A>を渡す場合はstd/listのgetを選びます。ここでAは配列の要素型で、結果にも同じ型が使われます。",
  ],
}
