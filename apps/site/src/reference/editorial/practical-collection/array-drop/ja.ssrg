import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "dropは指定数の先頭要素を飛ばした配列を返します。0や負の数なら全要素が残り、要素数以上なら空になります。元の配列は変更しません。",
  taskTitle: "表示済みのタスクを飛ばして、次のページを作る",
  purpose: "Read、Review、Shipのうち、Readはすでに表示済みだとします。先頭の1件を飛ばし、続く最大2件のReviewとShipを次の表示に使います。元の一覧は別の表示のために残します。",
  typescriptBefore: "TypeScriptのlabels.slice(1, 3)で、先頭1件を飛ばしたあとの2件を選べます。開始位置1は含み、終了位置3は含めません。sliceは元の配列を変更しません。負の件数もdropと同じ意味で比べるため、境界のループではslice(Math.max(0, count))を使います。",
  benefit: "Seseragiのitems.drop 1 labelsは、「先頭から1件を飛ばす」という意図を名前で表します。takeと組み合わせれば、飛ばす件数と表示件数を分けて読めます。どちらも元のArrayを変更せずに結果のArrayを返します。",
  setup: "itemsはstd/array、jsonはstd/jsonのimportの別名です。labelsはStringの配列です。items.drop 1 labelsは件数1、配列labelsの順で渡します。items.take 2 (items.drop 1 labels)は、括弧内の残りの配列から最大2件を取ります。",
  after: [
    "最初の結果は[\"Review\",\"Ship\"]です。dropの1は位置1の要素を消す指定ではなく、先頭から飛ばす要素数です。先頭のReadだけを飛ばし、残りの順序は変えません。",
    "前半のtakeの4行は、-1と0で[]、3と4で全件です。その次のdropの4行では、-1と0で全件、3と4で[]になります。dropでは、飛ばす件数が0以下なら何も飛ばしません。",
    "空の配列へdrop 2を使っても結果は空です。items.empty<String> ()は要素型がStringの空の配列を作ります。最後の表示では、元のlabelsはReadを含む全3件のままです。",
    "describeはArray<String>を受け取る表示用の関数です。[value | value <- values]は配列の各要素を順に並べる内包表記で、json.encodeStringでJSONの文字列にしてから表示しています。",
  ],
  details: [
    "drop -1は全要素を残します。JavaScriptのlabels.slice(-1)は末尾のShipだけを返すため、同じ意味ではありません。sliceへMath.max(0, count)を渡すと、負の件数を0としてこの例のdropとそろえられます。",
    "要素数が3のとき、drop 3でもdrop 4でも結果は空です。件数が足りなくてもエラーにはせず、残る要素がなければ空の配列を返します。途中の1要素だけを消す操作ではありません。",
    "件数にはIntを使い、1.5などのFloatは渡せません。先頭の値を読むだけならhead、先頭の何件かを残すならtakeを選びます。入力がListならstd/listのdropを使います。",
  ],
}
