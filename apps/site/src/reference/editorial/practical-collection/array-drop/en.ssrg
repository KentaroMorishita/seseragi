import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "drop returns the array remaining after a requested leading count. Zero or negative counts keep every element; counts at or above the length return empty. The original array is unchanged.",
  taskTitle: "Skip displayed tasks to prepare the next page",
  purpose: "Suppose Read has already been displayed from the list Read, Review, and Ship. Skip that first entry and use up to the next two, Review and Ship, for the next display. Keep the original list available for other views.",
  typescriptBefore: "TypeScript labels.slice(1, 3) selects two entries after skipping the first. It includes start position 1 and stops before end position 3. slice leaves the original array unchanged. To compare negative counts using the same policy as drop, the boundary loop uses slice(Math.max(0, count)).",
  benefit: "Seseragi’s items.drop 1 labels names the intent to skip one leading entry. Combine it with take to keep the skipped count separate from the displayed count. Both return an Array without changing the original Array.",
  setup: "items and json are import aliases for std/array and std/json. labels is an array of String values. items.drop 1 labels takes the count 1 first and the array labels second. items.take 2 (items.drop 1 labels) takes up to two entries from the parenthesized remaining array.",
  after: [
    "The first result is [\"Review\",\"Ship\"]. The 1 in drop is a count to skip from the start, not an instruction to remove the element at position 1. Only the leading Read is skipped, and the remaining order is unchanged.",
    "The earlier four take calls return [] for -1 and 0 and every entry for 3 and 4. The following four drop calls do the reverse: every entry for -1 and 0, and [] for 3 and 4. A drop count of zero or less skips nothing.",
    "Calling drop 2 on an empty array also returns empty. items.empty<String> () creates that empty array with String as its element type. The final display shows that the original labels still contains all three entries, including Read.",
    "describe is a display function accepting Array<String>. [value | value <- values] is a comprehension that lists each array element in order. json.encodeString turns the resulting array into a JSON string before it is printed.",
  ],
  details: [
    "drop with -1 keeps every element. JavaScript labels.slice(-1) instead returns only the final Ship, so it is not equivalent. Passing Math.max(0, count) to slice treats negative counts as zero and aligns it with drop for this example.",
    "With three elements, both drop 3 and drop 4 return empty. Running out of elements is not an error; it simply leaves an empty array. This operation does not remove just one element from the middle.",
    "The count must be Int, so a Float such as 1.5 is not accepted. Choose head to read the first value or take to retain a leading portion. For a List input, use drop from std/list.",
  ],
}
