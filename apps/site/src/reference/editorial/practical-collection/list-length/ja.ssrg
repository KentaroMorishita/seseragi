import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "items.lengthはListの要素数をIntで返します。値が0でも一件として数え、重複する値もそれぞれ数えます。",
  taskTitle: "一覧に何件あるかを表示する",
  purpose: "数値の結果を一覧にしたあと、その件数を表示します。空、一件、三件のListを比べ、値が0かどうかや、同じ値が繰り返されるかに関係なく数えることを確認します。",
  typescriptBefore: "通常の配列はlengthプロパティで件数を取得できます。この例のoneは[0]でも長さ1、severalは[0, 2, 0]なので長さ3です。同じ作業の比較であり、Listも配列と同じ方法や速度で長さを取得するという意味ではありません。",
  benefit: "TypeScriptのlengthはすでに短い書き方です。Seseragiではitems.lengthがListの要素数を求める関数で、結果はIntになります。どのコレクションを数えているかが呼び出しと型で分かります。",
  setup: "itemsはstd/listの別名です。`[0, 2, 0]のように[の前にバッククォートを付けてListを作ります。[0, 2, 0]だけならArrayです。空のnoneにはList<Int>と注釈を付け、整数のListだと指定しています。",
  after: [
    "件数が出るのは最後の三行です。items.length noneは0、items.length oneは1、items.length severalは3です。showは結果のIntを表示用のStringに変えます。",
    "最初の四行はisEmptyによる空判定です。空のListだけがtrueで、0、False、空文字列を一つ持つListはfalseになります。これらのBoolはJSONにして小文字で表示しています。",
    "items.length severalのように、数えたいListを関数名の後へ置きます。List<A>のAは要素の型で、この例の件数を数える三つのListではIntです。戻り値のIntは中身の値ではなく個数です。",
  ],
  details: [
    "Listのlengthは先頭から末尾まで全要素をたどって数えます。JavaScriptの配列のlengthプロパティと同じ一定時間の取得ではありません。",
    "空かどうかだけならisEmptyを使うと、Listの先頭の形を見るだけで済みます。先頭の要素が欲しいだけならheadがあるので、そのために全体のlengthを計算する必要はありません。",
    "0も重複した値も一つずつ数えます。FalseだけのListや空文字列だけのListも、それぞれ一件です。lengthは値の真偽や文字数を判定する操作ではありません。",
    "引数はListで、結果は0以上のIntです。Arrayを数える場合はstd/arrayのlengthを使います。List<String>を数える場合も、各文字列の文字数ではなく、文字列が何個あるかを返します。",
  ],
}
