import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "Filter Set elements while retaining their order and uniqueness.",
  taskTitle: "Keep only eligible identifiers",
  purpose: "From a deduplicated collection of identifiers, keep only numbers at least 3. Retain the original Set and receive another Set containing the eligible numbers.",
  typescriptBefore: "TypeScript can expand a Set with [...ids], use array filter, then construct a new Set. The original Set is unchanged. The repeated 4 was already deduplicated when the input Set was created.",
  benefit: "Seseragi’s sets.filter directly accepts and returns a Set. Put the predicate before the input without extracting an array and wrapping it again.",
  setup: "sets aliases std/set, while json aliases std/json for display. sets.fromIterable [4, 1, 4, 3, 0] creates a Set from an array and combines the repeated 4. Int is the integer type.",
  after: [
    "fn eligible value: Int -> Bool receives one identifier and returns whether value >= 3. sets.filter eligible ids retains only identifiers for which eligible returns True.",
    "sets.toArray exposes the result as an array for display. Retained first-insertion order produces 4 followed by 3. Filtering does not sort the identifiers numerically.",
    "The second output displays the original ids: 4, 1, 3, 0. Filtering has not removed its elements. The array’s second occurrence of 4 was already combined when the Set was created.",
    "sets.empty<Int> () creates an empty Set of Int. <Int> specifies the element type and () supplies Unit. Filtering an empty Set produces another empty Set.",
  ],
  details: [
    "The predicate runs once for each element present in the Set, in insertion order. It does not revisit duplicates from the original array. Retained elements keep their order.",
    "Zero, False and an empty string are not automatically removed. They remain whenever the predicate returns True. Zero is absent in this example because 0 >= 3 is False.",
    "The predicate must return Bool. It cannot return a display message or rely on an integer’s truthiness. Pass the function itself to filter, rather than a result obtained by calling it.",
    "This comparison uses integer elements. It does not establish identical duplicate detection for arbitrary objects in JavaScript and Seseragi.",
  ],
}
