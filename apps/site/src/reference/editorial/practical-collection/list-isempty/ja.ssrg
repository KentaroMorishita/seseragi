import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "items.isEmptyは、Listに要素が一つもなければTrueを返します。0、False、空文字列が一つ入っているListは空ではありません。",
  taskTitle: "結果がゼロ件かどうかを調べる",
  purpose: "結果がなければ空状態の案内を出し、一件でもあれば一覧を出したい場面です。例では、空のListと、0、False、空文字列を一つ持つListを比べます。",
  typescriptBefore: "通常の配列ではvalues.length === 0に相当する判定で十分です。配列内の値の真偽は調べません。ここでは同じ空判定の作業を比べていて、配列の内部表現や速度がListと同じとはしていません。",
  benefit: "items.isEmptyは「一件もないか」という問いを直接表します。List全体を数える必要も、要素の内容を調べる関数を渡す必要もありません。TypeScript側のlength === 0もすでに簡潔です。",
  setup: "itemsはstd/listの別名です。`[]のように[の前へバッククォートを付けるとListになり、[]だけならArrayです。let none: List<Int>は、要素のないnoneでも整数のListだと分かるように型を指定しています。",
  after: [
    "items.isEmpty noneはTrueで、items.isEmpty oneはFalseです。oneは`[0]なので、値は0でも要素は一つあります。呼び出しは関数名の後にListを一つ置きます。",
    "続く`[False]と`[\"\"]もそれぞれ一要素なのでFalseです。json.encodeStringを通すため、最初の四行はJSONの小文字でtrue、false、false、falseと表示されます。",
    "最後の三行はlengthによる件数の確認です。空のnoneは0、一要素のoneは1、`[0, 2, 0]のseveralは3になります。空判定と件数は別の問いなので、必要な方を選びます。",
  ],
  details: [
    "isEmptyはListが空か、先頭の要素を持つかだけを見ます。先頭に要素があればすぐFalseです。全要素をたどるlengthと異なり、空判定のために一覧全体を数えません。",
    "空文字列を含むことと、空のListであることは違います。また、全要素がFalseでもListに要素はあります。「条件に合う要素がないか」を知るなら、まずその条件で選んだ結果を調べます。",
    "結果の型はBoolで、TrueかFalseです。先頭の値そのものも使いたいなら、headが返すMaybeをmatchで分けると、空の場合と値のある場合を一緒に扱えます。",
    "引数はListです。同じ角括弧に見えても、バッククォートのないArrayはstd/listのisEmptyへ渡せません。Arrayを使っている場合はstd/arrayのisEmptyを選びます。",
  ],
}
