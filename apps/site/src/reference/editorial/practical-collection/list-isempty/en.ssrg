import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "items.isEmpty returns True when a List has no elements. A List containing one 0, False, or empty string is not empty.",
  taskTitle: "Check whether there are any results",
  purpose: "Choose an empty-state message when there are no results, or show a list when at least one result exists. Compare an empty List with Lists containing one zero, one False, or one empty string.",
  typescriptBefore: "For a normal array, a check equivalent to values.length === 0 is enough. It does not test the truthiness of the elements. This compares the same empty-state task without claiming that arrays and Lists have the same representation or performance.",
  benefit: "items.isEmpty directly asks whether there are no entries. It does not need to count the whole List or receive a function that inspects the contents. TypeScript’s length === 0 is already concise too.",
  setup: "items is the alias for std/list. A backtick before [ creates a List, as in `[]; [] alone creates an Array. let none: List<Int> supplies the element type explicitly, even though none contains no elements from which to infer it.",
  after: [
    "items.isEmpty none returns True, while items.isEmpty one returns False. one is `[0], so there is one element even though its value is zero. A call places the single List argument after the function name.",
    "The Lists `[False] and `[\"\"] also contain one element each, so both return False. json.encodeString makes the first four output lines use JSON’s lowercase true, false, false, false.",
    "The final three lines use length to check the counts: empty none has 0 elements, one has 1, and several, which is `[0, 2, 0], has 3. Emptiness and count answer different questions; choose the one the task needs.",
  ],
  details: [
    "isEmpty only checks whether the List has a first element. If one exists, it immediately returns False. Unlike length, it does not walk all the elements to determine emptiness.",
    "Containing an empty string is different from being an empty List. Likewise, a List whose elements are all False still contains elements. To ask whether nothing meets a condition, first select the elements that meet that condition and inspect that result.",
    "The result type is Bool: True or False. If the first value is needed too, match on the Maybe returned by head to handle absence and a present value together.",
    "The argument must be List. Similar-looking brackets without the leading backtick create Array, which does not fit std/list’s isEmpty. Use std/array’s isEmpty when working with an Array.",
  ],
}
