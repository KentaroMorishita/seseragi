import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "items.filterは、条件の関数がTrueを返すListの要素をすべて残します。元の順序を保ったListを返し、入力の内容は変えません。",
  taskTitle: "急ぎのタスクだけを一覧にする",
  purpose: "Read、Review、Shipの三件から、urgentがTrueのタスクをすべて選びます。ReviewとShipの両方を表示し、元の一覧と空の入力も確認します。",
  typescriptBefore: "通常の配列のfilterで急ぎのタスクを残し、mapで表示用のタイトルを取り出します。元の配列を変えずに書ける、自然なTypeScriptです。最後は型を付けた空の配列noneに同じ条件を使います。配列は作業の比較用で、Listの内部表現の再現ではありません。",
  benefit: "Seseragiでも、条件を一つの関数として渡して選別できます。条件の型Task -> Boolと結果のList<Task>が明確です。TypeScriptと同じく元の一覧を残しながら、Listに対して選別を行えます。",
  setup: "struct Taskはtitle: Stringとurgent: Boolを持つレコードの型を定義します。Task { ... }はその値です。tasksの[の前にあるバッククォートはListを作る印で、バッククォートのない角括弧はArrayを作ります。itemsはstd/listの別名です。",
  after: [
    "fn urgent task: Task -> Bool = task.urgentは、タスクを一件受け取り、そのurgentフィールドのBoolを返します。items.filter urgent tasksは条件の関数、Listの順で渡す呼び出しです。urgentをこの場で一回呼ぶのではなく、要素ごとに使う関数として渡します。",
    "selectedはList<Task>です。[task.title | task <- selected]は、selectedからtaskを一件ずつ受け取り、titleを並べたArrayを作る内包表記です。この角括弧にはバッククォートがありません。JSONにして表示すると[\"Review\",\"Ship\"]になります。",
    "次の行は元のtasksからタイトルを表示するため、Read、Review、Shipがすべて残っています。最後のitems.empty<Task> ()は空のList<Task>を作り、それをfilterした結果も空なので[]と表示されます。",
  ],
  details: [
    "filterは先頭からすべての要素に条件を適用し、Trueの要素を元の順番で残します。複数一致すればすべて残り、一件も一致しなければ空のListです。空の入力では条件の関数を呼びません。",
    "条件はTaskを受け取りBoolを返す必要があります。titleのStringをそのまま返して「文字があれば採用」とはできません。例ではtask.urgentがすでにBoolなので、そのまま使えます。",
    "0、False、空文字列の要素も、条件がTrueなら残ります。要素自身の値を自動的に真偽値へ変換して取り除く操作ではありません。Falseを選ぶ条件なら、結果にFalseが入ります。",
    "最初の一件だけが必要ならfindを使います。filterは一致した全件をListとして返し、findは最初の一件をMaybeとして返すので、使いたい結果の形に合わせて選びます。",
  ],
}
