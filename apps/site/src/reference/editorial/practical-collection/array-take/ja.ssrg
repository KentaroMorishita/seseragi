import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "takeは配列の先頭から指定数までを返します。0や負の数なら空、要素数以上なら全要素を返し、元の配列は変更しません。",
  taskTitle: "表示する件数を決めて、一覧の一部分を取り出す",
  purpose: "Read、Review、Shipの一覧で、最初の1件を飛ばして次の2件だけを表示します。dropで開始位置まで進み、takeで表示件数を制限します。結果はReviewとShipです。",
  typescriptBefore: "TypeScriptのlabels.slice(1, 3)でも同じ2件を取り出せます。位置1から始め、終了位置3は含めません。sliceも元の配列を変更しません。境界の比較ではMath.max(0, count)を使い、負の件数を0として扱います。",
  benefit: "Seseragiではitems.take 2 (items.drop 1 labels)と、飛ばす件数と残す件数を操作名で表せます。takeは件数の上限として読む関数です。Intの件数を渡し、元と同じ要素型のArrayを受け取ります。",
  setup: "itemsはstd/array、jsonはstd/jsonのimportの別名です。labelsは3個のStringを持つ配列です。takeとdropは、整数の件数、配列の順で呼びます。括弧内のitems.drop 1 labelsを先に求め、その結果をtakeへ渡します。",
  after: [
    "最初の呼び出しではdrop 1でReadを飛ばし、take 2でReviewとShipを残します。takeの2は終了位置ではなく、渡された配列から取り出す最大件数です。",
    "次の4行がtakeの境界です。件数-1と0では[]、3と4では全3件になります。(0 - 1)は整数の-1を表します。足りない要素を補って4件にすることはありません。",
    "続くdropの4行では、-1と0は全件を残し、3と4は[]になります。その後で空の配列にtakeとdropを使うと、どちらも[]です。最後には元のlabelsが全3件のまま表示されます。",
    "fn describe values: Array<String> -> Stringは文字列の配列を表示用に変える関数です。[value | value <- values]は要素を順に並べる配列内包表記で、json.encodeStringがその配列をJSONの文字列にします。",
  ],
  details: [
    "負の件数を末尾からの位置と考えないでください。take -1は空です。一方、JavaScriptのlabels.slice(0, -1)は末尾の1件を除いたReadとReviewを返します。比較例のMath.max(0, count)は、この違いをなくすために必要です。",
    "件数が要素数以上なら、ある要素をすべて順序どおりに返します。takeは配列の値を変更する操作ではなく、必要な先頭部分を得る操作です。元の配列はそのまま使えます。",
    "件数はIntなので1.5のようなFloatは渡せません。渡すコレクションもArrayである必要があります。Listの先頭部分を取り出すならstd/listのtakeを選びます。",
  ],
}
