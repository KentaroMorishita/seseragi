import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "take returns up to a requested number of leading array elements. Zero or negative counts return empty; counts at or above the length return every element. The original array is unchanged.",
  taskTitle: "Limit how many entries a page displays",
  purpose: "From Read, Review, and Ship, skip the first entry and display only the next two. Use drop to move past the leading entry and take to limit the count. The result is Review and Ship.",
  typescriptBefore: "TypeScript labels.slice(1, 3) selects the same two entries: start at position 1 and stop before position 3. slice also leaves the original array unchanged. The boundary comparisons use Math.max(0, count) so that a negative count is treated as zero.",
  benefit: "Seseragi writes items.take 2 (items.drop 1 labels), naming the skipped count and the retained count through the operations. Read take as a limit on the number of entries. It takes an Int count and returns an Array of the same element type.",
  setup: "items and json are import aliases for std/array and std/json. labels is an array of three String values. Both take and drop take the integer count first, then the array. Parentheses calculate items.drop 1 labels first and pass that result to take.",
  after: [
    "The first call skips Read with drop 1, then keeps Review and Ship with take 2. The 2 is a maximum count taken from the array it receives, rather than an ending position.",
    "The next four lines cover take boundaries. Counts -1 and 0 return [], while 3 and 4 return all three entries. (0 - 1) supplies the integer -1. A request for four does not invent an extra element.",
    "The following four drop calls keep every entry for -1 and 0 and return [] for 3 and 4. Next, take and drop on empty arrays both return []. The final line displays the original labels with all three entries still present.",
    "fn describe values: Array<String> -> String is a display helper. [value | value <- values] is an array comprehension that lists the elements in order, and json.encodeString turns that array into a JSON string.",
  ],
  details: [
    "Do not treat a negative count as a position from the end. take with -1 returns empty. JavaScript labels.slice(0, -1), however, returns Read and Review by omitting the final entry. Math.max(0, count) in the comparison is needed to align these policies.",
    "A count at or above the length returns every available element in order. take obtains the leading portion you need rather than modifying the array’s values. The original array remains available.",
    "The count must be Int; a Float such as 1.5 is a type mismatch. The collection must also be an Array. For the leading portion of a List, choose take from std/list.",
  ],
}
