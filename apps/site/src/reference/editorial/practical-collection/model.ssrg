import * as arrays from "std/array"
import { LocalizedText, localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { Editorial } from "../model"

pub struct PracticalCollectionCopy {
  summary: String,
  taskTitle: String,
  purpose: String,
  typescriptBefore: String,
  benefit: String,
  setup: String,
  after: Array<String>,
  details: Array<String>
}
fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  [Paragraph ([Words (localized en ja)]) | (en, ja) <- arrays.zip japanese english]
fn link title: String -> route: String -> english: String -> japanese: String -> Block =
  Paragraph (
    [
      InternalLink (localized title title, route),
      Words (localized (": " + english) ("：" + japanese))
    ]
  )

pub fn practicalCollectionEditorial identity: String
  -> source: String
  -> english: PracticalCollectionCopy
  -> japanese: PracticalCollectionCopy
  -> Editorial =
  Editorial {
    identity,
    namespace: "value",
    itemKind: "function",
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-operation", localized english.taskTitle japanese.taskTitle),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        Heading (
          "typescript-comparison",
          localized "Start with familiar TypeScript" "TypeScriptの処理から考える"
        ),
        Paragraph
          ([Words (localized english.typescriptBefore japanese.typescriptBefore)]),
        CodeExample (
          "practical-collection-" + source + "-ts",
          localized "TypeScript · Node 24.19.0 / Bun 1.3.9"
          "TypeScript・Node 24.19.0 / Bun 1.3.9"
        ),
        Terminal (localized "TypeScript output" "TypeScriptの実行結果", output source),
        Heading (
          "seseragi-example",
          localized "Write the same task in Seseragi" "Seseragiで同じ処理を書く"
        ),
        CodeExample (
          "practical-collection-" + source,
          localized "Complete Seseragi program" "Seseragiの完全なプログラム"
        ),
        Terminal (localized "Seseragi output" "Seseragiの実行結果", output source),
        Paragraph ([Words (localized english.benefit japanese.benefit)]),
        Heading ("reading-the-example", localized "Read the important lines" "大事な行を読む"),
        Paragraph ([Words (localized english.setup japanese.setup)])
      ],
      paragraphs english.after japanese.after,
      if source == "array-result-state" || source == "list-result-state" then
        [Paragraph (
          [Words (
            localized
          "show turns each integer count into display text. Unlike json.encodeString, it is not a JSON encoding operation."
          "showは整数の個数を表示用の文字列にします。json.encodeStringとは異なり、JSONへ変換する操作ではありません。"
          )]
        )]
      else
        [],
      [
        Paragraph (
          [Words (
            localized
          "pub effect fn main is the public program entry. do runs its output steps in order; _ <- finishes a step and discards its Unit result. Unit carries no meaningful information; () is its value. Writing () after a Seseragi function name passes that Unit value as its argument. println writes a String and a newline. The collection operations themselves return values without printing or changing their inputs."
          "pub effect fn mainはプログラムの公開された実行入口です。doは表示の処理を順番に実行し、_ <-は処理を終えてUnitの結果を使わずに次へ進みます。Unitは意味のある情報を持たない値の型で、()がその値です。Seseragiの関数名の後に()を書くと、このUnitの値を引数として渡します。printlnはStringと改行を表示します。コレクションの操作そのものは、表示や入力の変更をせずに値を返します。"
          )]
        ),
        Paragraph ([Words (comparisonNote source)]),
        Paragraph (
          [Words (
            localized
          "Save the complete Seseragi source with the filename below and run it locally, or open its Playground link. These examples use small in-memory values. Only printing needs Console; no file, network, browser storage or process-settings service is used. The TypeScript source uses the same native APIs on the two labelled runtimes."
          "Seseragiの完全なソースを下のファイル名で保存するとローカルで実行できます。Playgroundのリンクからも開けます。例で使うのはプログラム内の小さな値です。表示にだけConsoleを使い、ファイル・ネットワーク・ブラウザーの保存領域・プロセスの設定は使いません。TypeScriptのソースは、見出しに示した二つの実行環境で同じ標準APIを使います。"
          )]
        ),
        Terminal (
          localized "Run locally" "ローカルで実行する",
          "seseragi run " + source + ".ssrg --target process"
        ),
        Heading ("operation-rules", localized "Rules and common mistakes" "規則と間違いやすい点")
      ],
      paragraphs english.details japanese.details,
      [Heading ("choose-next", localized "Choose the next operation" "次に必要な操作を選ぶ")],
      related identity,
      [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
  }

fn output source: String -> String = match source {
  "array-optional-access" -> "present: \"\"\npresent: \"Review\"\nmissing\nmissing\nmissing\npresent: \"\"\nmissing\n"
  "array-result-state" -> "true\nfalse\nfalse\nfalse\n0\n1\n3\n"
  "array-filter-tasks" -> "[\"Review\",\"Ship\"]\n[\"Read\",\"Review\",\"Ship\"]\n[]\n"
  "array-find-task" -> "Review\nnot found\nnot found\n[\"Read\",\"Review\",\"Ship\"]\n"
  "array-page-records" -> "[\"Review\",\"Ship\"]\n[]\n[]\n[\"Read\",\"Review\",\"Ship\"]\n[\"Read\",\"Review\",\"Ship\"]\n[\"Read\",\"Review\",\"Ship\"]\n[\"Read\",\"Review\",\"Ship\"]\n[]\n[]\n[]\n[]\n[\"Read\",\"Review\",\"Ship\"]\n"
  "list-optional-access" -> "present: \"\"\npresent: \"Review\"\nmissing\nmissing\nmissing\npresent: \"\"\nmissing\n"
  "list-result-state" -> "true\nfalse\nfalse\nfalse\n0\n1\n3\n"
  "list-filter-tasks" -> "[\"Review\",\"Ship\"]\n[\"Read\",\"Review\",\"Ship\"]\n[]\n"
  "list-find-task" -> "Review\nnot found\nnot found\n[\"Read\",\"Review\",\"Ship\"]\n"
  "list-page-records" -> "[\"Review\",\"Ship\"]\n[]\n[]\n[\"Read\",\"Review\",\"Ship\"]\n[\"Read\",\"Review\",\"Ship\"]\n[\"Read\",\"Review\",\"Ship\"]\n[\"Read\",\"Review\",\"Ship\"]\n[]\n[]\n[]\n[]\n[\"Read\",\"Review\",\"Ship\"]\n"
  "map-filter-stock" -> "[[\"tea\",2],[\"coffee\",3]]\n[[\"tea\",2],[\"hold\",5],[\"coffee\",3],[\"empty\",0]]\n[]\n"
  "map-empty-state" -> "true\nfalse\nfalse\nfalse\n"
  "set-filter-ids" -> "[4,3]\n[4,1,3,0]\n[]\n"
  "set-empty-state" -> "true\nfalse\nfalse\nfalse\n"
  _ -> ""
}

