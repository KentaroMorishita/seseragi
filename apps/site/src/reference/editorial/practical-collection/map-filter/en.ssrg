import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "Filter Map entries by key and value while preserving their order.",
  taskTitle: "Keep only stock that can be sold",
  purpose: "Remove held products and products with no stock from a product-to-quantity lookup. Keep the original lookup available and create a separate Map of saleable entries.",
  typescriptBefore: "TypeScript can turn a Map into an entry array with [...stock], select entries with filter, and construct a new Map. ([sku, quantity]) reads the key and value from each pair. This idiomatic version also leaves the original Map unchanged.",
  benefit: "Seseragi’s maps.filter takes a predicate and a Map and directly returns a Map. No conversion to an array and back is needed. Giving the condition a readable function name is useful in either language.",
  setup: "maps is the import alias for std/map; json names std/json for display. maps.fromEntries builds a Map from key/value pairs such as (\"tea\", 2). The keys here are String and the values are Int. let stock names that lookup.",
  after: [
    "fn available sku: String -> quantity: Int -> Bool receives the product key first and its quantity second. sku != \"hold\" excludes the held product; quantity > 0 checks stock. && requires both conditions to hold.",
    "maps.filter available stock passes each key and value to available. Only entries producing True remain in selected. The declaration’s K -> V -> Bool likewise means key, then value, then the Boolean decision.",
    "maps.entries selected exposes pairs for display. The result has tea with 2, followed by coffee with 3. The next output still contains all four original stock entries, confirming that filtering did not delete them.",
    "The final maps.empty<String, Int> () creates an empty Map. <String, Int> specifies the key and value types; () supplies Unit when no meaningful input value is needed. Filtering that empty Map still produces an empty Map.",
  ],
  details: [
    "The predicate runs once for each entry in insertion order. Retained entries keep that order. This operation does not stop at the first match.",
    "Do not reverse the key and value parameters. A function taking Int before String has the wrong type in this example. Even a condition that ignores the key still has a key-parameter position.",
    "Zero, False and an empty string are not automatically removed. The predicate’s Bool decides what remains. This example removes zero stock because it explicitly tests quantity > 0.",
    "This comparison uses string keys. It does not establish equivalent key identity for arbitrary object keys in JavaScript and Seseragi.",
  ],
}
