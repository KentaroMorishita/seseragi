import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "Check whether a Set has no elements. Zero, False and empty text are still elements.",
  taskTitle: "Recognize when nothing is selected",
  purpose: "Show guidance when a set of selected identifiers is empty; continue when at least one exists. Do not mistake identifier zero or an empty label for no selection.",
  typescriptBefore: "For a TypeScript Set, use size === 0. new Set([0]), new Set([false]) and new Set([\"\"]) each contain one element and are not empty.",
  benefit: "sets.isEmpty returns a Bool describing whether elements are absent. TypeScript’s size check is also concise, and neither approach needs truthiness. Use the resulting Bool in an if to choose what to display.",
  setup: "sets is the import alias for std/set. sets.empty<Int> () creates an empty Set of integers. sets.fromIterable creates a Set from a square-bracket array, combining duplicate values when present.",
  after: [
    "The first Set contains no elements, so sets.isEmpty returns True. The Set created from [0] contains integer zero, so its result is False.",
    "The Sets created from [False] and [\"\"] also each contain one element. Their element types are Bool and String, but isEmpty is called in the same way.",
    "json.encodeString converts each Boolean to JSON text before printing. This produces lowercase true, false, false, false. True and False in Seseragi source name Bool values.",
    "The only argument to isEmpty is the Set. No value to find or predicate is needed. Choose contains when the question is whether one particular identifier is present.",
  ],
  details: [
    "isEmpty uses the Set’s stored count. There is no need to convert elements to an array or inspect them one by one.",
    "Deduplicating input still leaves a nonempty Set when one distinct value remains. For example, [0, 0] produces a Set containing one zero.",
    "If filter removes every element, its result is empty. Checking that result with isEmpty still leaves the original Set unchanged.",
    "Use sets.size to display the actual count. Choose isEmpty when you only need the condition that no elements exist.",
  ],
}
