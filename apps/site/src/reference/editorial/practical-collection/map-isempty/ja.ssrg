import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "Mapに項目が一つもないか調べます。値が0、False、空文字列でも、項目は存在します。",
  taskTitle: "項目がないときの表示を選ぶ",
  purpose: "在庫や設定の一覧に項目がなければ「まだありません」と表示し、項目があれば通常の表示を選びます。ここで知りたいのは、値の内容ではなく項目が存在するかどうかです。",
  typescriptBefore: "TypeScriptのMapではsize === 0で空かどうかを調べられます。値が0、false、空文字列の項目を持つMapでもsizeは1です。値を取り出して真偽値に変換する必要はありません。",
  benefit: "maps.isEmptyは空かどうかをBoolで直接返すため、そのままifの条件として使えます。TypeScriptのsize === 0も十分短い書き方です。この例は同じ判定を並べて確かめます。",
  setup: "mapsはstd/mapを読み込む別名です。maps.empty<String, Int> ()は、StringのキーとIntの値を持つ空のMapを作ります。型が指定されていても、項目はまだありません。",
  after: [
    "maps.fromEntries [(\"stock\", 0)]は、stockというキーに整数0を対応させた一項目のMapです。(\"stock\", 0)は二つの値を位置で区別する組で、配列の角括弧がその組の一覧を囲みます。",
    "maps.isEmptyは空のMapではTrue、一項目でもあればFalseです。残りの例は値がFalseの設定と、空文字列のラベルですが、どちらも一項目を持つため空ではありません。",
    "json.encodeStringはBoolをJSONの小文字trueまたはfalseへ変えます。そのため出力はtrue、false、false、falseの順です。Seseragiのソース内で書く真偽値はTrueとFalseです。",
    "引数はMap一つだけです。条件用の関数や検索するキーは渡しません。特定のキーがあるかを調べる処理とは、質問が異なります。",
  ],
  details: [
    "isEmptyはMapが保持している項目数を使って判定し、値を順に調べません。表示用の配列へ変換して数える必要はありません。",
    "空のMapと、空文字列を値に持つMapを混同しないでください。空文字列のキー自体を持つ場合も、その項目は存在します。",
    "絞り込みの結果に対しても使えます。maps.filterが一項目も残さなかったときにisEmptyはTrueになります。元のMapは変わりません。",
    "件数そのものを表示するならmaps.sizeを使います。空かどうかだけならisEmptyで意図をそのまま表せます。",
  ],
}
