import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "items.takeは、Listの先頭から指定した個数までを返します。個数が0以下なら空で、残りが足りなければある分だけを返します。",
  taskTitle: "一覧から一ページ分だけを表示する",
  purpose: "すでに表示した一件を飛ばし、続く二件を一ページとして表示します。例ではReadを飛ばしてReviewとShipを取り、件数が負、0、全件以上の場合も確認します。",
  typescriptBefore: "通常の配列ならslice(1, 3)で同じページを作れます。開始位置1は含み、終了位置3は含めません。境界の確認ではMath.max(0, count)を使い、負の件数を0として扱います。素のsliceは負の数を末尾からの位置として扱うため、方針が違います。配列は同じ作業の比較用で、Listの内部表現や速度を再現していません。",
  benefit: "takeは終了位置ではなく「最大何件か」を渡す関数です。dropで飛ばす件数とtakeで表示する件数を分けると、ページの意図をそのまま書けます。TypeScriptのsliceも元の配列を変更しません。",
  setup: "itemsはstd/listの別名です。labelsの[の直前にあるバッククォートはListを作る印で、ない場合はArrayになります。items.take 2 valuesの引数は、Intの件数、Listの順です。",
  after: [
    "items.take 2 (items.drop 1 labels)は、括弧内で先頭のReadを飛ばしてから、残りを最大二件取ります。最初の出力は[\"Review\",\"Ship\"]です。dropが開始位置を作り、takeが表示件数を決めています。",
    "describeはList<String>を受け取り、[value | value <- values]で各値を並べたArrayにしてJSON表示します。この内包表記にはバッククォートがなく、表示用のArrayを作ります。take自体の戻り値はListのままです。",
    "続く四つのtakeは件数-1、0、3、4です。最初の二つは[]、後の二つは全三件になります。(0 - 1)は整数の-1を作る式です。その後はdropの境界、空の入力、最後に変更されていない元のlabelsを表示します。",
  ],
  details: [
    "件数が負でも0でも結果は空のListです。件数がListの長さ以上なら全要素を返し、足りない分を埋めたり失敗にしたりしません。空の入力からは何件取ろうとしても空の結果になります。",
    "件数はIntです。1.5のようなFloatは渡せません。0、False、空文字列も一要素として数えるため、takeは値の内容で飛ばす操作ではありません。",
    "Listのtakeは先頭から必要な要素をたどり、取った部分のListを作ります。入力の内容は変えません。元のlabelsが残ることは、最後のJSON出力でも確認できます。",
    "「先頭から二件取る」と「先頭の二件を飛ばす」は違います。後者にはdropを使います。ページを作るときは、例のようにdropした残りへtakeを適用します。",
  ],
}
