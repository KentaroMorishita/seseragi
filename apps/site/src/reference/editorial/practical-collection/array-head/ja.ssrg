import { PracticalCollectionCopy } from "../model"

pub fn copy -> PracticalCollectionCopy = PracticalCollectionCopy {
  summary: "headは配列の先頭をMaybeで返します。空の配列ならNothing、先頭が空文字列や0でも要素があればJustになります。",
  taskTitle: "一覧の先頭ラベルを、空の一覧でも安全に読む",
  purpose: "一覧の最初のラベルを表示し、一覧そのものが空ならmissingと表示します。先頭のラベルが空欄の場合と、ラベルが1件もない場合を区別するのが目的です。例の最後の2行で、その違いを比べます。",
  typescriptBefore: "TypeScriptではlabels[0]で先頭を読み、=== undefinedで不在を判定できます。長さを先に調べなくても書ける簡潔な方法です。空文字列を残すため、真偽値への変換では判定しません。最初の5行は同じ判定関数で位置指定の読み取りも比べています。",
  benefit: "Seseragiのheadは位置を指定せず、先頭のJustか空のNothingを返します。長さの確認と要素の読み取りを別々に書かず、Maybeの2つの場合として表示を決められます。",
  setup: "itemsはstd/array、jsonはstd/jsonのimportの別名です。角括弧で作るlabelsはArray<String>です。items.head labelsは配列を1個渡す呼び出しで、items.empty<String> ()はString用の空の配列を作ります。",
  after: [
    "describeはMaybe<String>を受け取ってStringを返す関数です。matchのJust labelは存在する文字列を取り出し、Nothingは要素がない場合を扱います。どちらの枝も表示用の文字列を返します。",
    "例の最後から2番目の呼び出しでは、headが空文字列をJustに入れて返します。json.encodeStringで引用符が付き、present: \"\"と表示されます。最後の呼び出しは空の配列なのでmissingです。",
    "前半のgetは、位置0、1、負の位置、範囲外、空の配列を調べています。headはこのうち位置0を読みたい場面に使えます。どちらの結果もMaybeなので、同じdescribeで処理できます。",
  ],
  details: [
    "headは先頭の1件を調べます。空文字列を飛ばして次のReviewを探す処理ではありません。先頭が0やFalseでもJustとして返します。条件に合う最初の要素を探すならfindを使います。",
    "Just \"\"とNothingは別の値です。headの戻り値をそのままStringとして扱わず、matchで中身を取り出してから使います。この例では不在をmissingと表示していますが、表示文は用途に合わせて選べます。",
    "headは配列を短くせず、元の要素を変更しません。先頭を読み取るheadと、先頭の何件かを除いた配列を返すdropは別の操作です。入力がListならstd/listのheadを使います。",
  ],
}
