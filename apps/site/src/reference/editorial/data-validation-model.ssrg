import * as arrays from "std/array"
import * as text from "std/text"
import { localized } from "../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../model/page"
import { Editorial } from "./model"
import { CorrectionCopy } from "./correction-model"
fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  [Paragraph ([Words (localized en ja)]) | (en, ja) <- arrays.zip japanese english]
fn choice title: String
  -> route: String
  -> english: String
  -> japanese: String
  -> Block =
  Paragraph (
    [
      InternalLink (localized title title, route),
      Words (localized (": " + english) ("：" + japanese))
    ]
  )
fn choices identity: String -> Array<Block> =
  if identity == "std/maybe" then
    [
      choice "withDefault" "/docs/library/maybe/function/withdefault/"
        "get a display value even when the nickname is missing."
        "ニックネームがない場合も表示する値を得ます。",
      choice "orElse" "/docs/library/maybe/function/orelse/"
        "try another optional source while keeping absence visible."
        "別の候補を試し、値がない可能性を残します。",
      choice "traverse" "/docs/library/maybe/function/traverse/"
        "look up every requested seat and return one complete result."
        "席のコードをすべて調べ、一つの結果にまとめます。"
    ]
  else if identity == "std/either" then
    [
      choice "fold" "/docs/library/either/function/fold/"
        "turn either outcome into one display message." "成功と失敗のどちらからも表示文を作ります。",
      choice "mapLeft" "/docs/library/either/function/mapleft/"
        "add field context to a failure reason." "失敗理由に入力欄の情報を加えます。",
      choice "flatMap" "/docs/library/prelude/function/flatmap/"
        "continue with a check that needs the successful value; this shared operation lives in Prelude."
        "成功した値を使って次の確認へ進みます。Preludeの共通操作です。"
    ]
  else if identity == "std/validation" then
    [
      choice "valid" "/docs/library/validation/function/valid/"
        "return an accepted value." "受け入れた値を返します。",
      choice "invalid" "/docs/library/validation/function/invalid/"
        "report one input error." "入力のエラーを一つ返します。",
      choice "invalidMany" "/docs/library/validation/function/invalidmany/"
        "retain an existing nonempty group of errors." "すでにある一つ以上のエラーを保ちます。",
      choice "fromEither" "/docs/library/validation/function/fromeither/"
        "bring a single-result check into independent validation."
        "成功か一つの失敗を返す確認を、独立した検証に加えます。",
      choice "toEither" "/docs/library/validation/function/toeither/"
        "hand success or all errors to the next failure-aware step."
        "成功した値か全エラーを、次の失敗を扱う処理へ渡します。"
    ]
  else if identity == "std/prelude::Monad::flatMap" then
    [
      choice "std/either" "/docs/library/either/"
        "review how a caller handles success and a failure reason."
        "成功した値と失敗理由を呼び出し側で扱う方法を確認できます。",
      choice "std/validation" "/docs/library/validation/"
        "collect independent input errors when a later check does not need an earlier value."
        "前の成功した値を必要としない入力確認で、複数のエラーを集めます。"
    ]
  else if text.startsWith "std/maybe::" identity then
    [choice "std/maybe" "/docs/library/maybe/"
        "choose between a fallback, another optional source, and a collection-wide lookup."
        "既定値、別の候補、コレクション全体の検索から操作を選べます。"]
  else if text.startsWith "std/either::" identity then
    [
      choice "std/either" "/docs/library/either/"
        "choose how to display a result, add error context, or continue a successful check."
        "結果の表示、失敗理由の補足、成功後の確認から操作を選べます。",
      if identity == "std/either::traverse" then
        choice "reduceUntil" "/docs/library/collection/function/reduceuntil/"
        "stop later callback evaluations when that is the requirement."
        "後の要素で関数を呼ばずに終了したい場合に使います。"
      else
        choice "std/validation" "/docs/library/validation/"
        "collect errors from independent checks." "独立した確認のエラーをまとめます。"
    ]
  else
    [choice "std/validation" "/docs/library/validation/"
        "combine independent form checks and display all their errors."
        "独立した入力確認を組み合わせ、全エラーを表示します。"]
pub fn dataValidationEditorial identity: String
  -> slug: String
  -> output: String
  -> english: CorrectionCopy
  -> japanese: CorrectionCopy
  -> Editorial =
  Editorial {
    identity,
    namespace: "value",
    itemKind: "function",
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-operation", localized english.taskTitle japanese.taskTitle),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        Paragraph ([Words (localized english.setup japanese.setup)]),
        CodeExample (
          "data-validation-reader-" + slug,
          localized english.codeTitle japanese.codeTitle
        ),
        Terminal (localized english.outputTitle japanese.outputTitle, output)
      ],
      paragraphs english.after japanese.after,
      [
        Heading (
          "typescript-comparison",
          localized english.comparisonTitle japanese.comparisonTitle
        ),
        Paragraph
          ([Words (localized english.comparisonBefore japanese.comparisonBefore)]),
        CodeExample
          ("data-validation-reader-" + slug + "-ts", localized "TypeScript" "TypeScript"),
        Terminal (localized "TypeScript output" "TypeScriptの実行結果", output),
        Paragraph ([Words (localized english.comparisonAfter japanese.comparisonAfter)]),
        Heading ("operation-rules", localized english.detailTitle japanese.detailTitle)
      ],
      paragraphs english.details japanese.details,
      choices identity,
      if identity == "std/maybe" || identity == "std/either" || identity == "std/validation" then
        []
      else
        [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
  }
