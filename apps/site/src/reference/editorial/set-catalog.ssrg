import { ReferenceSymbol } from "../../model/build"
import { Editorial } from "./model"
import { editorial as emptyEditorial } from "./set/empty/page"
import { editorial as singletonEditorial } from "./set/singleton/page"
import { editorial as fromIterableEditorial } from "./set/fromiterable/page"
import { editorial as containsEditorial } from "./set/contains/page"
import { editorial as insertEditorial } from "./set/insert/page"
import { editorial as removeEditorial } from "./set/remove/page"
import { editorial as sizeEditorial } from "./set/size/page"
import { editorial as mapEditorial } from "./set/map/page"
import { editorial as unionEditorial } from "./set/union/page"
import { editorial as intersectionEditorial } from "./set/intersection/page"
import { editorial as differenceEditorial } from "./set/difference/page"
import { editorial as isSubsetOfEditorial } from "./set/issubsetof/page"

pub fn setEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.module != "std/set"
    || symbol.namespace != "value"
    || symbol.itemKind != "function" then
    Nothing
  else
    match symbol.identity {
  "std/set::empty" -> Just (emptyEditorial ())
  "std/set::singleton" -> Just (singletonEditorial ())
  "std/set::fromIterable" -> Just (fromIterableEditorial ())
  "std/set::contains" -> Just (containsEditorial ())
  "std/set::insert" -> Just (insertEditorial ())
  "std/set::remove" -> Just (removeEditorial ())
  "std/set::size" -> Just (sizeEditorial ())
  "std/set::map" -> Just (mapEditorial ())
  "std/set::union" -> Just (unionEditorial ())
  "std/set::intersection" -> Just (intersectionEditorial ())
  "std/set::difference" -> Just (differenceEditorial ())
  "std/set::isSubsetOf" -> Just (isSubsetOfEditorial ())
  _ -> Nothing
}
