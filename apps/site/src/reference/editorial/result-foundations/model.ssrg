import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { Editorial } from "../model"
import { CorrectionCopy } from "../correction-model"
fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  [Paragraph ([Words (localized en ja)]) | (en, ja) <- arrays.zip japanese english]
fn link title: String -> route: String -> english: String -> japanese: String -> Block =
  Paragraph (
    [
      InternalLink (localized title title, route),
      Words (localized (": " + english) ("：" + japanese))
    ]
  )
fn related identity: String -> family: String -> Array<Block> =
  if family == "maybe" then
    [
      if identity == "std/prelude::Maybe" then
        link "Just" "/docs/library/prelude/constructor/just/"
        "construct a present value, including zero or an empty string."
        "0や空文字列も含め、値がある結果を作ります。"
      else
        link "Maybe" "/docs/library/prelude/type/maybe/"
        "read the present and missing alternatives." "値がある場合とない場合の扱いを確認できます。",
      link "std/maybe" "/docs/library/maybe/"
        "choose a fallback, another optional source, or collection lookup."
        "既定値、別の候補、コレクション全体の検索から選べます。"
    ]
  else if family == "validation" then
    [
      if identity == "std/validation::Validation" then
        link "Invalid" "/docs/library/validation/constructor/invalid/"
        "construct a failure from an existing error group." "すでにあるエラー群から失敗の結果を作ります。"
      else
        link "Validation" "/docs/library/validation/opaque-type/validation/"
        "read an accepted value or every ordered error." "成功した値か、順序を保った全エラーを読みます。",
      link "std/validation" "/docs/library/validation/"
        "combine independent form checks and display their errors."
        "独立したフォームの確認を組み合わせ、エラーを表示します。",
      link "NonEmptyList" "/docs/library/non-empty-list/opaque-type/nonemptylist/"
        "construct a group with a guaranteed first error." "先頭のエラーが必ずあるまとまりを作れます。"
    ]
  else
    [
      if identity == "std/prelude::Either" then
        link "Right" "/docs/library/prelude/constructor/right/"
        "return an accepted value without adding an implicit check."
        "暗黙の確認を加えず、受け入れた値を返します。"
      else
        link "Either" "/docs/library/prelude/type/either/"
        "read a checked value and its failure alternative." "確認した値と失敗理由の扱いを確認できます。",
      link "std/either" "/docs/library/either/"
        "choose how to display or transform a returned result." "返された結果の表示や変換の操作を選べます。",
      link "flatMap" "/docs/library/prelude/function/flatmap/"
        "continue with a check that needs the successful value." "成功した値を使う次の確認へ進めます。"
    ]
pub fn resultFoundationEditorial identity: String
  -> namespace: String
  -> itemKind: String
  -> family: String
  -> slug: String
  -> output: String
  -> english: CorrectionCopy
  -> japanese: CorrectionCopy
  -> Editorial =
  Editorial {
    identity,
    namespace,
    itemKind,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-operation", localized english.taskTitle japanese.taskTitle),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        Paragraph ([Words (localized english.setup japanese.setup)]),
        CodeExample
          ("result-foundation-" + slug, localized english.codeTitle japanese.codeTitle),
        Terminal (localized english.outputTitle japanese.outputTitle, output)
      ],
      paragraphs english.after japanese.after,
      [
        Heading (
          "typescript-comparison",
          localized english.comparisonTitle japanese.comparisonTitle
        ),
        Paragraph
          ([Words (localized english.comparisonBefore japanese.comparisonBefore)]),
        CodeExample
          ("result-foundation-" + slug + "-ts", localized "TypeScript" "TypeScript"),
        Terminal (localized "TypeScript output" "TypeScriptの実行結果", output),
        Paragraph ([Words (localized english.comparisonAfter japanese.comparisonAfter)]),
        Heading ("operation-rules", localized english.detailTitle japanese.detailTitle)
      ],
      paragraphs english.details japanese.details,
      related identity family,
      [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
}
