import { FilesystemReaderCopy } from "../model"

pub fn copy -> FilesystemReaderCopy = FilesystemReaderCopy {
  summary: "Pathが保持する書き方を、表示やログに使えるStringへ戻します。",
  taskTitle: "保存先をメッセージに埋め込む",
  purpose: "検査済みの保存先からSaving reports/report.txtという表示を作ります。renderはPathを文字列へ戻す操作です。ファイルを保存したり、パスの行き先を調べたりする操作ではありません。",
  setup: "importでstd/pathをpathsという名前にします。paths.parse \"reports/report.txt\"は入力を検査し、問題があればLeft reason、Pathを得られればRight fileを返します。matchはその二つの形から該当する行を選びます。Rightの行では、paths.render fileという空白区切りの呼び出しでfileを渡します。",
  after: [
    "paths.render fileの戻り値はStringのreports/report.txtです。バッククォートの${...}がその文字列をSavingの後へ埋め込み、printlnが改行付きで表示します。Pathの値を直接変更する処理はありません。",
    "pub effect fn mainは実行の開始点です。表示のためにeffectを使いますが、parseとrender自体はファイル操作を行いません。Leftの行はshow reasonで問題を文字列にして表示するので、不正な入力からrenderへ進むこともありません。",
    "入力をreports/./report.txtに変えると、renderもreports/./report.txtを返します。renderは保持した表記を返す関数で、余分に見える.を取り除く関数ではありません。"
  ],
  details: [
    "宣言のarg1: Pathが入力、-> Stringが戻り値の型です。すでにStringである\"report.txt\"をrenderへ渡す必要はありません。Pathが必要な場面ではparseを使い、Stringが必要な表示の場面ではrenderを使います。",
    "出力の区切りはPathの/のままです。Windows向けのバックスラッシュへの変換、大文字と小文字の統一、Unicodeの正規化は行いません。",
    "renderした文字列が同じでも、後で読み書きする際のファイルや権限の状態は変わり得ます。renderの成功を、ファイルの存在確認や保存完了の記録として扱わないでください。"
  ],
  comparisonBefore: "TSでパスをstringとして保持していれば、そのままテンプレート文字列へ埋め込めます。この表示だけなら追加の変換は不要です。",
  comparisonAfter: "SeseragiではPathをファイル操作へ渡し、表示にはrenderでStringを得ます。型を分けた分の明示的な変換であり、表示処理そのものが短くなる例ではありません。"
}
