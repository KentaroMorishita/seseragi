import { FilesystemReaderCopy } from "../model"

pub fn copy -> FilesystemReaderCopy = FilesystemReaderCopy {
  summary: "モード、本文、Pathを受け取り、UTF-8で書き込みます。実行して完了するとUnitを返します。",
  taskTitle: "既存のレポートを上書きせずに保存する",
  purpose: "caféとこんにちはを含む本文を、新しいreport.txtへ保存します。書き込み時にCreateNewを指定するので、同じ場所にファイルがあれば上書きせず失敗します。例では書いた本文を読み戻して結果を確かめます。",
  setup: "importでeffects、fs、pathsを使えるようにします。effect fn report directory: paths.Path -> Stringは、directory内で働き、実行後に本文のStringを返す処理です。with FileSystemは必要なサービス、fails ReportErrorは通常の失敗の型です。let textで変更しない本文に名前を付け、文字列内の\\nで改行を表します。",
  after: [
    "paths.child \"report.txt\" directoryは、パスの問題を持つLeftか、完成したPathを持つRightを返します。|>は値を次の関数へ渡し、effects.fromEitherでその結果を処理へ変えます。file <-が処理を実行してPathを受け取ります。",
    "fs.writeTextUtf8 fs.CreateNew text fileの順序は、モード、本文、保存先です。CreateNewは引数のない値なので()を付けません。_ <-は書き込みを実行し、完了まで待ちます。書き込みの成功値Unitは、追加の結果がないことを表す()です。",
    "ReportErrorはPathFailure、WriteFailure、ReadFailureという三つの失敗の形を定義します。effects.mapErrorは元の問題を対応する形に包みます。deriving Showはshowで表示できる指定です。最後のreadTextUtf8が読み戻したStringを返すため、report全体の成功値はUnitではなくStringです。",
    "mainからwithTemporaryDirectoryを実行すると、専用のdirectory内でreportが動き、後で片付けられます。effects.attemptが通常の失敗をLeft problem、成功をRight textとして受け取り直します。matchで選んだmessageをprintlnで表示するので、本文にない最後の改行も表示時に付きます。"
  ],
  details: [
    "writeTextUtf8を呼んだだけでは書き込みません。返ったEffectを実行すると、指定のモードでファイルを開き、UTF-8のバイトを書きます。同じEffectをもう一度実行すると、操作ももう一度行います。CreateNewなら二度目は既存ファイルのため失敗し得ます。",
    "CreateNewは既存ファイルを守り、Replaceは既存内容を切り詰め、Appendは末尾に加えます。ReplaceとAppendはファイルがなければ作成します。いずれも親ディレクトリーを自動で作る指定ではありません。改行が必要なら本文へ明示します。",
    "この実装は書き込み後のflushとcloseを終えてから成功します。flushは保留した出力を送り出す処理で、その失敗やcloseの失敗もFileSystemErrorになります。停電後も保存内容が残る保証とは別です。普通の書き込みは、失敗するまでに書けた内容を残すことがあります。",
    "保存先にStringを直接渡すのではなく、parseやchildが成功したPathを渡します。パスの書き方が正しくても、アクセス権や保存先の状態による失敗は起きます。書き込んだ文字数やバイト数をUnitから得ることもできません。"
  ],
  comparisonBefore: "TSでもwriteFileへUTF-8の本文とflag: \"wx\"を渡せば、既存ファイルを上書きせずに書けます。awaitで完了を待ちます。",
  comparisonAfter: "ここではCreateNewとPathで入力の役割を示し、FileSystemErrorとUnitで失敗と成功値を示します。保存したEffectは実行前の処理であり、すでに始まったPromiseとは同じではありません。"
}
