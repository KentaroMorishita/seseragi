import { FilesystemReaderCopy } from "../model"

pub fn copy -> FilesystemReaderCopy = FilesystemReaderCopy {
  summary: "文字列で受け取った保存先を確かめ、ファイル操作に渡すPathや表示用の文字列を作ります。",
  taskTitle: "レポートの保存先を表示する",
  purpose: "設定から受け取ったreports/report.txtを、保存先として扱える値にして表示します。std/pathはパスの書き方を扱うモジュールです。この例はファイルを開かず、reportsというディレクトリーも作りません。",
  setup: "import * as pathsはstd/pathの公開する名前をpaths.parseのように使う指定です。paths.parse \"reports/report.txt\"は、文字列を一つ渡す関数呼び出しです。結果には、書き方に問題があるLeftと、Pathを得られたRightという二つの形があります。matchは結果に合う行を選びます。Left reasonは理由をreasonという名前で受け取り、Right fileはPathをfileという名前で受け取ります。",
  after: [
    "有効な入力なのでRight fileの行を実行し、Saving reports/report.txtを表示します。paths.render fileはPathをStringに戻します。バッククォートで囲んだ文字列の${...}には、その式の結果を埋め込みます。",
    "pub effect fn mainはプログラムの開始点です。printlnが文字列を改行付きで出力します。失敗側のshow reasonは、エラーの値を表示用の文字列にします。二つの行を用意したため、入力を空文字列に変えても、その理由を表示できます。",
    "Pathは、検査済みのパスの書き方を保持する値です。文字列と区別されるので、ファイルを読む関数にはparseの成功側で得たfileを渡します。表示やログにはrenderを使い、任意のStringをそのままPathの代わりには渡しません。"
  ],
  details: [
    "区切りはOSにかかわらず/です。相対パスreports/report.txt、POSIXの/、WindowsのC:/、共有先の//server/share/という根を区別します。空文字列、文字コード0のNUL、バックスラッシュ、不正なドライブや共有先の根はparseが拒否します。",
    "parseは.や..を取り除かず、renderは保持した書き方を返します。大文字と小文字の統一やUnicodeの正規化も行いません。書き方が有効でも、ファイルの存在、読み書きの許可、シンボリックリンクの行き先は分かりません。",
    "ディレクトリーに一つのファイル名を足す場合はchildを使います。ファイルの内容を読む場合はstd/fsを使います。文字列の検査と実際のファイル操作を分けると、入力の間違いと実行時の失敗を別々に扱えます。"
  ],
  comparisonBefore: "TSでも保存先は文字列で表せます。入力を検査してから表示するだけなら短いコードで書けます。",
  comparisonAfter: "この例で変わるのは、検査後の値がStringとは別のPathになる点です。以後の関数で検査済みの値を受け取れますが、ディスク上の状態まで保証する型ではありません。"
}
