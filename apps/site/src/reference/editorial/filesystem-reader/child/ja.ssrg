import { FilesystemReaderCopy } from "../model"

pub fn copy -> FilesystemReaderCopy = FilesystemReaderCopy {
  summary: "ディレクトリーのPathに一つのファイル名を足します。階層を含む名前は拒否します。",
  taskTitle: "レポートのファイル名を一つ足す",
  purpose: "reportsという保存先にreport.txtを足します。呼び出し側からはファイル名だけを受け取りたいので、../report.txtのように階層を移る入力は拒否します。report.v2.txtのような、名前の一部としてのドットは使えます。",
  setup: "std/pathをpathsとして読み込みます。fn addFilename base: paths.Path -> name: String -> Stringは、baseというPathとnameというStringを受け取り、表示用のStringを返す関数です。最初の->は二つの引数を区切り、最後の->は戻り値の型を示します。paths.child name baseの引数順は名前、保存先です。関数の引数順と同じだと思って逆にしないでください。matchは戻り値のLeftかRightを選び、Right fileで完成したPathを受け取ります。",
  after: [
    "最初の二つの入力はreports/report.txtとreports/report.v2.txtになります。../report.txt、空文字列、.、..は拒否されます。Left _の_は失敗理由をこの表示には使わない指定で、入力のnameをrejected:の後へ表示します。",
    "paths.parse \"reports\"も、失敗のLeft reasonと成功のRight baseを返します。成功して初めてaddFilenameを呼びます。paths.render fileは完成したPathを文字列にし、show reasonは検査の問題を文字列にします。バッククォート内の${name}はnameを文字列へ埋め込みます。",
    "pub effect fn mainが実行の開始点です。do内の_ <- println (...)は一行の表示を終えて次へ進み、最後のprintlnも同じ順序で実行されます。addFilename base \"report.txt\"は二つの引数を空白で渡す呼び出しです。パスを作るだけなので、reportsディレクトリーは不要です。"
  ],
  details: [
    "childは空文字列、.、..を拒否します。また、/、バックスラッシュ、文字コード0のNULを含む名前もInvalidPathSegmentで拒否します。report.v2.txtは名前全体が.や..ではなく、区切りもないため受理します。ディレクトリーを含む入力を意図する場合は、単一の名前を受け取るこの関数とは区別してください。",
    "戻り型Either<PathError, Path>は失敗側Leftの理由と成功側RightのPathを表します。基準となるbaseは検査済みのPathを渡します。StringをPathへ変えるには、例と同じくparseの結果を処理します。",
    "一つの名前に制限しても、安全な領域から出られない保証にはなりません。baseの選び方、アクセス権、シンボリックリンクによって実際の行き先は決まります。childは存在確認やディレクトリー作成を行いません。"
  ],
  comparisonBefore: "TSの例も同じ六つの入力を試します。ifで空文字列、.、..を、正規表現で区切りとNULを拒否してから文字列を組み立てます。Nodeのpath.joinだけでは../report.txtも受け取るため、この条件の比較にはなりません。",
  comparisonAfter: "どちらも同じファイル名の条件と表示結果です。Seseragiではchildが検査を受け持ち、成功時にPathを返します。TSの短い検査関数でもこの仕事はでき、主な違いは結果の型と共通のライブラリー操作です。"
}
