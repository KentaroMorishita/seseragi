import { FilesystemReaderCopy } from "../model"

pub fn copy -> FilesystemReaderCopy = FilesystemReaderCopy {
  summary: "ファイル全体を読み、正しいUTF-8ならStringを返します。アクセスの問題と文字コードの問題を分けて報告します。",
  taskTitle: "日本語を含むレポートを読み戻す",
  purpose: "report.txtに書いたcaféとこんにちはを、そのままStringとして読み戻します。例の前半で既知の本文を新規作成するので、読み込みだけを試すためのファイルを先に用意する必要はありません。",
  setup: "importしたfsがファイル操作、pathsがパス、effectsが処理の組み立てを担当します。effect fn report directory: paths.Path -> Stringは、directoryを受け取り、実行時にStringを返す処理です。with FileSystemは必要なサービス、fails ReportErrorは通常の失敗の型です。do内の<-は処理の結果を受け取り、_ <-は完了だけを待ちます。",
  after: [
    "paths.child \"report.txt\" directoryの結果は、失敗のLeftかPathを持つRightです。|>でeffects.fromEitherへ渡すと、その結果に従って成功か失敗になる処理を得ます。file <-で成功したPathに名前を付けます。任意のStringを読み込み先として渡してはいません。",
    "let textでcaféとこんにちはを改行で結ぶ変更しない本文を定義し、CreateNewで書き込みます。最後のfs.readTextUtf8 fileが本文を読みます。この行はdoの最後なので、成功したStringがreportの結果です。本文を途中で使うなら、同じ処理を<-の右側に置いて名前を付けます。",
    "ReportErrorはこの例の失敗の形です。PathFailureはパスの問題、WriteFailureは書き込みの問題、ReadFailureは読み込みの問題を保持します。effects.mapErrorがその形に包み、deriving Showで表示を可能にします。読み込みの元の問題はReadFailureの中に残ります。",
    "mainでwithTemporaryDirectoryが専用の作業場所を用意し、reportが終わると削除します。effects.attemptは成功をRight text、通常の失敗をLeft problemへ変え、matchでmessageを選びます。printlnが読み戻した本文と最後の改行を表示します。"
  ],
  details: [
    "呼び出しはEffectという処理の値を返します。ファイルを開くのはその処理を実行するときで、構築した時点ではありません。成功のStringは内容全体を保持するため、大きなファイルにはその分のメモリーが必要です。読み込み用のファイルを閉じ終えるまで成功せず、閉じる際の失敗も通常の失敗になります。",
    "失敗型FileTextErrorには二つの形があります。FileAccessFailureはFileSystemErrorを持ち、存在しないファイルならkindがFileNotFoundになります。FileUtf8FailureはUTF-8の解読の問題を持ちます。不正なバイトを置換文字へ変えて成功する読み方ではありません。",
    "確認したバイト列[65, 195, 40, 66]はInvalidUtf8のoffset: 1で失敗します。位置は先頭を0としたバイト位置です。空のファイルは空のStringになり、先頭のUTF-8 BOMはU+FEFFとして残ります。BOMはファイル先頭に付くことがある文字コードの目印です。",
    "ファイルが存在するか先に調べても、読み込み時の成功は保証できません。readTextUtf8の結果を処理してください。Pathが必要な場所へ文字列を渡した場合は、paths.parseで検査し、Rightで得たPathを渡す形に直します。"
  ],
  comparisonBefore: "TSでもreadFileでバイトを読み、TextDecoderで厳密なUTF-8として解読できます。fatal: trueが不正なUTF-8を失敗にし、ignoreBOM: trueがこのAPIと同じくBOMを文字として残します。",
  comparisonAfter: "readTextUtf8はこの読み方を一つの操作にし、アクセスと解読の問題をFileTextErrorで区別します。Nodeの文字列読み込みの既定動作は不正なバイトを置換するため、そのまま同じ読み方とは言えません。"
}
