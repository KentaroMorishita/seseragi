import { FilesystemReaderCopy } from "../model"

pub fn copy -> FilesystemReaderCopy = FilesystemReaderCopy {
  summary: "文字列のパス表記を検査し、問題を持つLeftか、Pathを持つRightを返します。",
  taskTitle: "保存先の入力を受理するか決める",
  purpose: "設定画面から受け取る保存先を確かめます。reports/./report.txt、空文字列、バックスラッシュを使ったWindows風の文字列を順に試し、受理した書き方か拒否の理由を表示します。ファイルの存在は調べません。",
  setup: "std/pathをpathsとして読み込みます。fn describe text: String -> Stringは、textというStringの引数を受け取り、Stringを返す関数です。=の後が戻り値になる式です。paths.parse textの結果にはLeftとRightの二つの形があり、matchが対応する行を選びます。Left reasonは問題を、Right fileは検査済みのPathを受け取ります。",
  after: [
    "最初の入力はaccepted: reports/./report.txtになります。parseは.を削らないため、renderしても入力の書き方を保ちます。空文字列はEmptyPath、三つ目の入力はPathContainsBackslashの理由で拒否され、後者のoffsetは2です。このASCII文字だけの入力では、先頭を0と数えた位置2にある最初のバックスラッシュを指します。",
    "show reasonは問題を文字列にし、paths.render fileはPathを文字列へ戻します。バッククォート内の${...}で、その結果をaccepted:やrejected:の後へ入れます。ソースの\\\\は、一つのバックスラッシュを文字列に書くための記法です。",
    "pub effect fn mainが実行の開始点です。doは表示の処理を上から順に実行します。_ <- println (...)は表示を完了させ、戻り値を使わずに次へ進む指定です。最後のprintlnがブロックの最後の処理になります。describe自体は文字列を返すだけです。"
  ],
  details: [
    "戻り型Either<PathError, Path>は、LeftがPathErrorを持つか、RightがPathを持つという意味です。例では両方を処理します。失敗を空のPathへ置き換えるのではなく、入力を直すか、その操作を止める判断ができます。",
    "区切りには/を使います。相対パス、/から始まるパス、C:/のようなドライブ、//server/share/のような共有先を表せます。空文字列、文字コード0のNUL、バックスラッシュ、不正なドライブや共有先の根は拒否します。文字列の前後の空白を勝手に取り除く処理でもありません。",
    "parseは.や..を保ち、ファイルの存在やアクセス権を調べません。受理したパスを安全な保存領域の中に閉じ込める保証もありません。表示を整理するためのnormalizeや、実在するリンク先の確認は、それぞれ別の操作です。"
  ],
  comparisonBefore: "TSでも入力検査の関数から、受理した文字列かエラーを返せます。検査の条件と呼び出し側の対応は、どちらの言語でも必要です。",
  comparisonAfter: "parseでは失敗の理由と成功したPathが戻り型に現れます。matchの二つの行に、それぞれの対応を書けます。入力が正しくてもファイル操作が成功するとは限りません。"
}
