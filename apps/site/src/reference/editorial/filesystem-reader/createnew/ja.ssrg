import { FilesystemReaderCopy } from "../model"

pub fn copy -> FilesystemReaderCopy = FilesystemReaderCopy {
  summary: "ファイルを新しく作る書き込みモードです。保存先がすでに存在すれば上書きせず失敗します。",
  taskTitle: "同じ名前のレポートを守る",
  purpose: "最初にreport.txtへoriginalを書き、次に同じ場所へreplacementを書こうとします。二度目をFileAlreadyExistsとして受け取り、ファイルにoriginalが残っていることを読み戻して確かめます。",
  setup: "fs、paths、effectsはimportで付けた名前です。effect fn report directory: paths.Path -> Stringは、directoryで処理を行い、説明のStringを返します。with FileSystemが必要なサービス、fails ReportErrorが通常の失敗の型です。do内で<-は結果を受け取り、_ <-は結果を捨てて完了を待ちます。fs.CreateNewはwriteTextUtf8の第一引数です。",
  after: [
    "paths.childはreport.txtをdirectoryに足し、Leftに問題かRightにPathを返します。|>は次の関数へ値を渡し、effects.fromEitherで処理に変えます。ReportErrorのPathFailure、WriteFailure、ReadFailureは元の問題を入れる形で、effects.mapErrorが対応する形に包みます。deriving Showによりshowで表示できます。",
    "最初のwriteTextUtf8はCreateNew、\"original\"、fileの順で呼びます。二度目もCreateNewなので、effects.attemptの結果secondはLeft errorになります。attemptは通常の失敗を値として受け取り直す操作です。matchはLeftかRightを選び、失敗側ではdescribe error fileで説明文を作ります。",
    "fn describeはerrorとfileを受け取りStringを返す関数です。error.operationはWriteFile、error.kindはFileAlreadyExistsです。error.pathとfileをrenderして==で比べるとTrueになります。otherPathは二つ目のパスがあればJust other、なければNothingで、この書き込みではnoneと表示します。",
    "letは変更しない値の名前を定義し、describeのブロックの最後の文字列が戻り値です。${...}で値を埋め込み、effects.succeedで完成した説明文を成功値にします。mainはwithTemporaryDirectoryで作業場所を用意し、終了後に削除します。attemptとmatchで選んだ文字列をprintlnが表示し、最後のcontents: originalで保護できた内容を確認できます。"
  ],
  details: [
    "CreateNewはWriteModeの三つの選択肢の一つで、引数を取りません。fs.CreateNewと書き、fs.CreateNew ()とは呼びません。作成の判断をファイルを開く際に行うので、事前のexists確認で代用しないでください。",
    "既存のファイルを置き換える意図ならReplace、内容を残して末尾へ足す意図ならAppendを選びます。CreateNewの失敗を無視してReplaceへ切り替えると、ここで守ろうとした既存のレポートを失います。",
    "このモードは重複作成を拒否しますが、新規ファイルの書き込み全体が失敗しない保証ではありません。権限、出力、ファイルを閉じる処理などでも失敗します。途中まで作られたファイルが残る可能性と、既存ファイルを上書きしない性質は分けて扱います。"
  ],
  comparisonBefore: "NodeのTSコードでもwriteFileへflag: \"wx\"を渡せば、保存先がすでにあるとEEXISTで失敗します。存在確認と通常の上書きを組み合わせる必要はありません。",
  comparisonAfter: "Seseragiではfs.CreateNewという名前で意図を選び、FileSystemErrorのkindからFileAlreadyExistsを得ます。TSでも同じ保護は可能で、ここでの違いはモードと失敗が型に表れる点です。"
}
