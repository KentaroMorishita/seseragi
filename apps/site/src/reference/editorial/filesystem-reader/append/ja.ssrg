import { FilesystemReaderCopy } from "../model"

pub fn copy -> FilesystemReaderCopy = FilesystemReaderCopy {
  summary: "既存の内容の末尾へ書くモードです。改行は本文に指定し、ファイルがなければ新しく作ります。",
  taskTitle: "レポートに行と末尾の文字列を足す",
  purpose: "report.txtへfirst、second、tailを順に追記します。最初の二つだけに改行を含めることで、Appendが改行を足さず、渡した本文をそのまま末尾へ書くことを確かめます。",
  setup: "fs、paths、effectsはimportしたモジュールです。effect fn report directory: paths.Path -> Stringはdirectoryを受け取り、実行後にStringを返します。with FileSystemは必要なサービス、fails ReportErrorは通常の失敗の型です。doは処理を順に実行し、<-で結果を受け取り、_ <-で結果を使わず完了を待ちます。",
  after: [
    "paths.child \"report.txt\" directoryはLeftに問題かRightにPathを返します。|>で次の関数へ渡し、effects.fromEitherで処理へ変えて、file <-でPathを受け取ります。ReportErrorのPathFailure、WriteFailure、ReadFailureは元の問題を保持する形で、effects.mapErrorが包みます。deriving Showはshowで表示するための指定です。",
    "writeTextUtf8の引数はfs.Append、本文、fileの順です。最初の呼び出しは存在しないファイルを作り、firstの後に\\nで指定した改行を書きます。二度目もsecondと改行を加え、三度目はtailだけを加えます。fs.Appendは値なので()は付けません。",
    "最後のreadTextUtf8が返す内容は正確にfirst\\nsecond\\ntailです。mainのprintlnが表示の最後に改行を加えますが、その改行はファイルの末尾にはありません。ファイルの内容と、表示のための改行を区別してください。",
    "mainはwithTemporaryDirectoryで専用の作業場所を用意し、reportが終わると削除します。effects.attemptは成功をRight text、通常の失敗をLeft problemとして受け取り直します。letで変更しない値に名前を付けます。matchで表示するmessageを選び、printlnで出力します。"
  ],
  details: [
    "AppendはWriteModeの三つの選択肢の一つです。既存の内容を消したいならReplace、同名ファイルがある場合に失敗させたいならCreateNewを選びます。モードによる違いは、文字列を渡す側が明示します。",
    "行ごとの追記にしたいなら、各本文に\\nを含めます。\"first\"と\"second\"だけを続けて書けばfirstsecondになります。Appendはレコードや行を解釈する機能ではありません。",
    "この例ではdoが三回の書き込みを順に実行します。別の処理も同時に書いている場合の順番や、一連の追記がまとめて成功することまでは保証しません。失敗やキャンセルまでに書けた内容が残る可能性があります。"
  ],
  comparisonBefore: "NodeのTSコードでもwriteFileのflag: \"a\"やappendFileで末尾へ追記できます。改行はTSでも本文に含めます。",
  comparisonAfter: "Seseragiではfs.Appendを同じ書き込み関数へ渡して選択を明示します。どちらも、並行する書き手の順序や複数回の書き込み全体を一括成功させる仕組みを、このモードだけで得るわけではありません。"
}
