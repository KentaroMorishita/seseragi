import { FilesystemReaderCopy } from "../model"

pub fn copy -> FilesystemReaderCopy = FilesystemReaderCopy {
  summary: "専用の一時ディレクトリーを作って処理へ渡し、処理後に片付けます。必要な結果はその処理から返します。",
  taskTitle: "レポートを一時的に作り、本文だけを持ち帰る",
  purpose: "一時ディレクトリー内でreport.txtへreadyを書き、読み戻した本文を返します。続けて、通常の失敗を返す別の処理を実行し、その結果も表示します。処理後に必要なのは本文であり、一時ファイルを後から開くためのパスではありません。",
  setup: "fs、paths、effectsはimportしたモジュールです。effect fn report directory: paths.Path -> Stringは、directoryを受け取り、実行時にStringを得る処理です。with FileSystemはファイルサービスの要件、fails ReportErrorは通常の失敗の型です。withTemporaryDirectoryは先頭に付ける名前と、作ったPathを受け取る関数を引数に取ります。この関数をコールバックと呼びます。",
  after: [
    "reportはpaths.childでreport.txtのPathを作ります。結果のLeftは問題、RightはPathで、|>を通じてeffects.fromEitherへ渡すと処理になります。do内の<-でfileを受け取り、_ <-でCreateNewの書き込みを終えるまで待ち、最後に本文を読みます。ReportErrorのPathFailure、WriteFailure、ReadFailureは元の各問題を保持し、mapErrorが包みます。deriving Showはshowでの表示を可能にします。",
    "mainの最初の呼び出しでは、fs16-success-に一意な末尾を付けたディレクトリーを用意します。\\directory -> ...は、directoryを一つ受け取る名前なしの関数です。report directory |> effects.mapError showで通常の失敗を表示用のStringへ変え、成功時の本文readyはそのまま返します。",
    "rejectもdirectoryを受け取る処理ですが、ファイルを作らず、effects.fail \"report rejected\"でStringの通常の失敗を返します。二度目のwithTemporaryDirectoryにはrejectを渡します。成功の処理でも、この失敗の処理でも、確認した実行では用意したディレクトリーが片付けられます。",
    "effects.attemptは全体の成功をRight、通常の失敗をLeftという値に変えます。describeの引数Either<Either<fs.FileSystemError, String>, String>は、この結果の形です。外側のRight textなら全体の成功です。外側のLeft failureなら失敗で、その中のLeft errorは準備か片付けの問題、中のRight reasonはコールバックの失敗を表します。",
    "内側のRightは全体の成功ではありません。describeの二段階のmatchが失敗の出どころを分け、成功ならsuccess: ready、rejectならcallback failure: report rejectedを返します。showは値を表示用に変え、${...}で文字列に埋め込みます。mainの_ <- printlnは最初の表示を終えて次へ進み、最後のprintlnが二つ目を表示します。"
  ],
  details: [
    "prefixには一つの名前を指定します。空文字列、.、..、区切り、文字コード0のNULなど不正な指定はCreateTemporaryのPathNotSupportedとして失敗します。名前の末尾はランダムに生成し、既存のものと重ならないように作成します。作成先はFileSystemサービスが設定した一時領域です。作成に失敗すればコールバックは呼ばれません。",
    "成功したコールバックの後で片付けだけが失敗すると、全体は失敗し、その値のLeftにFileSystemErrorを持ちます。コールバックの通常の失敗はRightに入ります。宣言のEはそのコールバックの失敗型、Aは成功値の型です。R & { fileSystem: FileSystem }は、コールバックに必要なサービスにFileSystemも加わることを示します。",
    "一時ディレクトリーの中のPathを返しても、そのファイルの寿命は延びません。通常の完了後には削除されるので、例の本文のように必要な値を処理中に得て返します。削除対象はこの操作で作ったディレクトリーとその中身で、別の場所を指すシンボリックリンクはたどりません。すでに削除済みなら片付けは成功し、同じパスに置かれた別のものは削除しません。使用中の一時領域の根を標準のファイル操作で移動しようとするとPermissionDeniedになります。処理を構築しただけでは作成せず、返されたEffectを実行したときに作成します。",
    "同時失敗については、上の通常の例とは別の確認があります。Node/Bunのサービス実装で、一時領域を同じパスの別のものに置き換えると、誤削除を防ぐため片付けが拒否されました。コールバックも失敗させた場合、直接の結果はRight内の元の失敗を保ちましたが、後のサービス終了で別のProviderPackageDefectが発生しました。仕様にある片付けの診断の添付は、確認した戻り値や警告出力では観測していません。",
    "そのため、同時失敗でも診断が必ず添付されることや、プロセス終了まで元の失敗だけが報告されることは、ここでは実装の保証として示しません。キャンセル、予期しない実行時の問題、強制終了での片付けも、この例の成功と通常の失敗の確認からは保証できません。"
  ],
  comparisonBefore: "TSのwithWorkspaceはmkdtempで場所を作り、awaitでコールバックを待ち、finallyでrmを実行します。async関数はPromiseとして結果を返します。通常の成功とコールバックの失敗のどちらでも、片付け自体が成功すれば同じ本文と失敗メッセージを得ます。",
  comparisonAfter: "Seseragiの関数は、作成、コールバック、片付けを一つの操作として提供し、通常の失敗がどの段階から来たかを値で分けます。TSでもtry/finallyで片付けは書けます。ただしfinallyの失敗が先の失敗を置き換えるため、同時失敗の挙動まで同じ比較ではありません。後述する特殊な確認で見られた結果も、この短い比較の対象外です。"
}
