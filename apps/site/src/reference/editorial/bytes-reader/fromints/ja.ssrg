import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "fromIntsは、整数を入力順に確認してBytesへコピーします。0から255以外の値があれば、最初の値をエラーで返します。",
  taskTitle: "数値の配列を確認してバイト列にする",
  purpose: "0、127、255のような数値の配列から、保存や通信に使うバイト列を作ります。1バイトに入るのは0から255の整数です。入力の値を黙って丸めず、すべて確認してから使います。",
  typescriptBefore: "TypeScriptではnumberに小数も入るため、Number.isIntegerと0から255の範囲を先に調べます。そのあとでUint8Array.fromを呼びます。先に検証しないと、型付き配列への変換で値が変わることがあります。",
  benefit: "Seseragiの引数はArray<Int>なので、小数の配列とは型で区別されます。さらにfromIntsがバイトの範囲を調べ、成功したBytesか、最初の範囲外の整数を返します。型がIntでも、256が入るかどうかの実行時の確認は必要です。",
  setup: "bytesはstd/bytesを読み込むimportの別名です。fn describe values: Array<Int> -> Stringは、整数の配列valuesから文字列を返す関数です。呼び出しは関数名と引数を空白で並べます。角括弧の[0, 127, 255]は配列の値です。",
  after: [
    "bytes.fromInts valuesの結果はEither<ByteError, Bytes>です。これはエラーを持つLeftか、確認済みのBytesを持つRightのどちらかを表します。matchが結果に合う枝を選び、枝の->の右側が戻り値になります。",
    "Left (bytes.ByteOutOfRange value)は、失敗の中から範囲外の整数をvalueとして取り出します。バッククォートで囲んだ文字列の${value}が、その整数を表示文に埋め込みます。",
    "Right contentで取り出したBytesだけをbytes.toIntsへ渡します。toIntsは整数の配列へコピーし、showはその配列を表示用のStringにします。括弧内のbytes.toInts contentを先に計算して、showへ渡しています。",
    "[0, 127, 255]は順序を保って成功します。[1, 256, -1]は256で止まり、[-1]も失敗します。空の配列は有効で、空のBytesができます。",
  ],
  details: [
    "fromIntsは成功時に新しいバイト列を作ります。入力順に一度ずつ調べ、最初の不正な整数で失敗するため、エラーの一覧や途中までのBytesは返しません。処理と必要なコピーは入力の長さに応じて増えます。",
    "fromIntsの結果全体をBytes用の関数に渡すのは間違いです。EitherはBytesそのものではありません。先にmatchで分け、Rightの中身だけを使います。",
    "範囲外の値を丸める処理はありません。意図した0から255の整数に入力を直します。1.5のようなFloatはIntと別の型で、その配列を渡すと型が合いません。",
    "成功は、各値が1バイトに収まったという意味です。そのバイト列がUTF-8の文字列として正しいかどうかは、decodeUtf8で別に確認します。",
  ],
  nodeNote: "このTypeScript例はNode 24.19.0でも同じAPIで動きます。Uint8Array.from自体に入力の検証を任せず、Number.isIntegerと範囲の確認を先に行う点も同じです。",
}
