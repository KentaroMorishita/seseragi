import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "hex.encodeはBytesの各バイトを2桁の小文字で表します。ログや保存用の文字列を、0xや空白のない一定の形で作れます。",
  taskTitle: "ログ用の十六進文字列を作る",
  purpose: "0、15、16、171、255というバイト値を、ログへ000f10abffとして残します。十六進表記は0–9とa–fを使い、1バイトを必ず2桁で表します。元の0や桁の境目を失わずに書き出すための変換です。",
  typescriptBefore: "TypeScriptでは、既知の範囲内の値をUint8Array.fromでバイト列にし、toHex()で小文字の文字列を作ります。空配列も同じ呼び出しで空文字列になります。この固定入力の例に、追加の検査や例外処理は不要です。",
  benefit: "どちらの変換も短く書けます。SeseragiのencodeはBytesだけを受け取るため、文字列や未確認の整数配列をそのまま渡す間違いを型の検査で見つけられます。数値の検査はfromInts、表記の変換はencodeが担当します。",
  setup: "bytesはstd/bytes、hexはstd/bytes/hexの別名です。Bytesは書き換えられないバイト列で、1バイトの値は0から255です。例は整数配列をfromIntsで確認してからencodeへ渡します。",
  after: [
    "fn render values: Array<Int> -> Stringは、整数配列valuesから文字列を返す関数の定義です。fnは関数、:の後ろは引数の型、->の後ろは戻り値の型を示します。Intは整数、Array<Int>は整数の配列です。",
    "bytes.fromInts valuesでは、空白の後ろに引数valuesを渡します。戻り値のEitherは、失敗理由を持つLeftか、成功したBytesを持つRightのどちらかです。matchがその二つを分けます。",
    "Right contentでは、成功した値をcontentと呼んでhex.encode contentへ渡します。Left errorではshow errorが失敗理由を文字列にします。各枝の->の右側がrenderの戻り値です。",
    "最初の行は000f10abffです。0と15も00と0fになり、先頭の0が残ります。次の空配列は空文字列になるため、空行が表示されます。println (render values)の括弧はrenderの結果を表示へ渡すためのものです。",
  ],
  details: [
    "encodeの引数はBytes、戻り値はStringです。確認済みのバイト列からの変換なので、Left/Rightの失敗結果は返しません。例のmatchはencodeではなく、整数配列からBytesを作るfromIntsの結果を処理しています。",
    "各バイトを小文字のASCII数字2桁にし、新しい文字列を作ります。0x、空白、改行、区切りは入りません。nバイトの入力なら出力は2n桁です。空のBytesは空文字列になります。",
    "ここでいう標準の表記は、同じバイト列に対してencodeが選ぶ一つの綴りです。decodeは大文字も受け入れますが、再びencodeすると小文字になります。元の文字の大文字・小文字を保存する操作ではありません。",
    "文字列をencodeへ直接渡すのは型の不一致です。文章なら先にstd/textのencodeUtf8でBytesへ変換します。十六進表記は内容を隠さず、暗号化や圧縮は行いません。",
  ],
  nodeNote: "検証したNode 24にはtoHex()がありません。Node/Bunではimport { Buffer } from \"node:buffer\"を使い、Buffer.from(content).toString(\"hex\")でも同じ小文字の表記を得られます。Bufferは文字列表記を変換する操作を持つUint8Arrayの一種です。",
}
