import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "hex.encode writes each byte in Bytes as two lowercase hexadecimal digits. Produce a consistent string for logging or storage without a 0x prefix or whitespace.",
  taskTitle: "Write hexadecimal text for a log",
  purpose: "Record byte values 0, 15, 16, 171, and 255 as 000f10abff in a log. Hexadecimal uses 0–9 and a–f, with exactly two digits for each byte. This preserves zeros and byte boundaries in the written representation.",
  typescriptBefore: "TypeScript converts the known in-range numbers into bytes with Uint8Array.from and produces lowercase text with toHex(). The same call on an empty array produces an empty string. These fixed inputs need no additional validation or exception handling.",
  benefit: "Both conversions are concise. Seseragi’s encode accepts only Bytes, so passing a string or an unchecked integer array directly is a type error. fromInts validates the numbers; encode converts the representation.",
  setup: "bytes aliases std/bytes and hex aliases std/bytes/hex. Bytes is an immutable byte sequence, with each byte holding a value from 0 through 255. The example checks an integer array with fromInts before passing the result to encode.",
  after: [
    "fn render values: Array<Int> -> String defines a function from an integer array named values to a string. fn introduces the function, the type after : describes the argument, and the type after -> describes the result. Int is an integer; Array<Int> is an array of integers.",
    "bytes.fromInts values passes values as an argument after a space. Its Either result is one of two possibilities: Left with a failure reason, or Right with successful Bytes. match chooses between them.",
    "Right content names the successful value content and passes it to hex.encode content. Left error uses show error to turn a failure reason into a string. The expression to the right of each branch’s -> supplies the result of render.",
    "The first line is 000f10abff. Even 0 and 15 become 00 and 0f, preserving their leading zeros. The next, empty array produces an empty string and therefore a blank output line. Parentheses in println (render values) pass the result of render to printing.",
  ],
  details: [
    "encode takes Bytes and returns String. Since its input is already a byte sequence, it does not return a Left/Right failure result. The example’s match handles fromInts, which constructs Bytes from integers, rather than encode.",
    "Each byte becomes two lowercase ASCII digits in a new string. No 0x, whitespace, newline, or separator is added. An input of n bytes produces 2n digits. Empty Bytes becomes an empty string.",
    "Canonical means the one spelling encode chooses for a given byte sequence. decode also accepts uppercase, but encoding the result again produces lowercase. This does not preserve the capitalization of an original string.",
    "Passing a string directly to encode is a type mismatch. For text, first use encodeUtf8 from std/text to create Bytes. Hexadecimal does not hide the contents, encrypt them, or compress them.",
  ],
  nodeNote: "The inspected Node 24 runtime has no toHex(). With Node/Bun, import { Buffer } from \"node:buffer\" and use Buffer.from(content).toString(\"hex\") for the same lowercase representation. Buffer is a Uint8Array subclass with text-conversion methods.",
}
