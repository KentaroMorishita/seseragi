import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "hex.decodeは十六進文字列全体を調べ、成功したBytesかHexDecodeErrorを返します。大文字も読めますが、0xや空白は受け入れません。",
  taskTitle: "貼り付けた十六進文字列を確認する",
  purpose: "テキスト欄から受け取った00FFをバイト列に戻し、読めた値だけを使いたいとします。途中まで読めた値を採用せず、入力全体が十六進表記として正しいかを確かめます。",
  typescriptBefore: "TypeScriptのUint8Array.fromHex(input)は十六進文字列を読み、不正なら例外を投げます。readHexはtry/catchで成功と拒否を分け、成功時だけtoHex()で小文字に書き直します。ここでは失敗の分類ではなく、同じ入力を受け入れるかどうかを比較します。",
  benefit: "Seseragiでは失敗も戻り値に含まれます。decodeが返すEither<HexDecodeError, Bytes>は、Leftに失敗理由、Rightに成功したBytesを持つ二つの結果です。成功したバイト列を使う場所がRightの枝に現れます。",
  setup: "hexはimport * asで付けたstd/bytes/hexの別名です。decodeは文字列を読み、encodeはバイト列を表示用の十六進文字列にします。Bytesは0から255までの値を並べた、書き換えられないバイト列です。",
  after: [
    "fn read input: String -> Stringは、入力の文字列inputを受け取り、表示用の文字列を返す関数です。fnが定義を始め、: Stringは引数の型、-> Stringは戻り値の型を表します。hex.decode inputは空白で引数を渡す呼び出しです。",
    "matchはLeftとRightのどちらが返ったかで枝を選びます。Left _の_は、ここでは詳しい理由を使わない印です。Right contentは成功したBytesにcontentという名前を付けます。+はAccepted:  とhex.encode contentの文字列をつなぎます。",
    "00FFは受け入れられ、Accepted: 00ffと表示されます。空文字列も空のBytesとして受け入れられます。残りの例は、桁の不足、不正な文字、接頭辞、空白があるためRejectedになります。println (read input)はreadの結果を表示します。",
    "Right contentのcontentは文章ではなくバイト列です。中身を文章として使う場合は、std/textのdecodeUtf8でさらに確認し、その成功結果からStringを取り出します。",
  ],
  details: [
    "受け入れる数字はASCIIの0–9、a–f、A–Fです。2桁で1バイトを表し、大文字と小文字が混ざっていても読めます。0xや区切り文字を自動で取り除くことはありません。",
    "最初の検査は、入力をUTF-8で表したときのバイト数が偶数かどうかです。奇数ならOddHexLengthにその長さが入ります。その後の数字の検査で失敗すると、InvalidHexDigitのoffsetに0から数えたバイト位置が入ります。",
    "é0はUTF-8では3バイトなのでOddHexLengthの長さは3です。éは2バイトなので長さの検査を通り、位置0のInvalidHexDigitになります。長さをJavaScriptのString.lengthや画面上の文字数と読み替えないでください。",
    "失敗したときは有効な先頭部分を返しません。0x00を渡す間違いは、送り側の仕様を確認し、必要なら許可された接頭辞の処理を別に行って直します。入力を読めたことは、データの意味や安全性を確認したことにはなりません。",
  ],
  nodeNote: "検証したNode 24にはfromHex()/toHex()がありません。Node/BunのBufferを使うならimport { Buffer } from \"node:buffer\"を追加します。Buffer.from(input, \"hex\")は不正な部分で切り詰めることがあるため、先に偶数の長さとASCIIの十六進数字だけであることを検査します。この検査で受け入れる入力は合わせられますが、Seseragiのエラー分類や検査順序までは再現していません。",
}
