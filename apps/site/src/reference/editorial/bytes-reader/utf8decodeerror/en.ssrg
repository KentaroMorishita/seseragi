import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "Utf8DecodeError describes a failure to read Bytes as UTF-8 text. InvalidUtf8 provides the byte position where the first invalid sequence begins.",
  taskTitle: "Report where UTF-8 decoding failed",
  purpose: "Check that incoming bytes are valid UTF-8 before reading them as prose. The sequence [97, 226, 40, 161] is damaged. Display where to start inspecting the bytes.",
  typescriptBefore: "TextDecoder with fatal: true throws for malformed UTF-8. try/catch can report failure, but its public error does not supply the invalid byte position. This TypeScript example therefore prints the general message Invalid UTF-8.",
  benefit: "Seseragi returns a Utf8DecodeError on failure, and InvalidUtf8 exposes its offset. The example prints Invalid UTF-8 at byte 1. That additional information is the difference here; the two examples intentionally do not print identical strings.",
  setup: "bytes and text are import aliases for std/bytes and std/text. fn explain -> String defines a function with no parameters that returns a string; explain () calls it. bytes.fromInts [97, 226, 40, 161] passes an integer array and checks that each value fits in one byte.",
  after: [
    "fromInts returns Either<ByteError, Bytes>: either a failed Left or a Right with Bytes. Only the outer match branch Right content calls text.decodeUtf8 content. Left error converts an error to a display string with show.",
    "decodeUtf8 returns Either<Utf8DecodeError, String>, again two outcomes. Right value holds decoded text. Left (text.InvalidUtf8 { offset }) reads the offset field carried by InvalidUtf8 and binds it to the name offset.",
    "The expression after a branch’s -> is its result. The backtick string inserts the position at ${offset}. An offset counts input bytes from zero; it is not a position in a decoded string.",
    "97 is a. The following 226 starts a multibyte character, but 40 is not a valid continuation byte. The returned position is 1, where 226 started that invalid sequence, rather than position 2 of the bad continuation.",
    "fatal: true makes TextDecoder throw on invalid UTF-8. A BOM is a marker that can use the U+FEFF character at the start of text. ignoreBOM: true keeps that character instead of removing it, matching Seseragi’s decoding policy.",
  ],
  details: [
    "Strict decoding fails on the first invalid sequence and does not return even the readable a prefix as a success. If the intended text were a(, encoding that text with encodeUtf8 would produce [97, 40]. Establish the intended content before repairing received data.",
    "InvalidUtf8 also covers truncated characters, lone continuation bytes, unnecessarily long encodings, surrogate values reserved for UTF-16 pairs, and values above Unicode’s limit U+10FFFF. Utf8DecodeError keeps its representation private while exposing this public form for reading the position.",
    "For a best-effort display, decodeUtf8Lossy can produce a preview with replacement characters. That does not establish input validity. Do not use offset as a string index or assume the received data has been repaired automatically.",
  ],
  nodeNote: "Node 24.19.0 supports the same Uint8Array and TextDecoder calls. Even with fatal: true, it does not provide a byte offset.",
}
