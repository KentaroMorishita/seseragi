import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "decodeUtf8Lossyは、読めないUTF-8の並びを置換文字に変え、プレビュー用のStringを返します。入力の正しさを確認する関数ではありません。",
  taskTitle: "壊れた文字データを、確認用に表示する",
  purpose: "診断用の画面などで、一部が壊れたバイト列からも読める部分を表示したい場合があります。[97, 226, 40, 161]を読み、読めない部分を�で示します。元のデータが直ったわけではありません。",
  typescriptBefore: "TypeScriptではTextDecoderの通常の読み取りが、不正なUTF-8を置換文字に変えます。fatal: trueは付けず、先頭のU+FEFFを残すためにignoreBOM: trueを指定します。例はa�(�を表示します。",
  benefit: "両方とも短く書けます。SeseragiではdecodeUtf8Lossyという名前とStringを直接返す型から、失敗を返すdecodeUtf8とは目的が違うと分かります。表示用の代替文字を許す場所で、この操作を選べます。",
  setup: "bytesはstd/bytes、textはstd/textのimportの別名です。fn preview -> Stringは引数なしで文字列を返す関数で、preview ()で呼び出します。bytes.fromInts [97, 226, 40, 161]は、整数の配列を渡す呼び出しです。",
  after: [
    "fromIntsは各整数が0から255かを確認し、Either<ByteError, Bytes>を返します。Leftは失敗、Rightは成功です。matchでRight contentを選べたときだけ、作れたBytesをtext.decodeUtf8Lossy contentへ渡します。",
    "Left errorの枝はshow errorで失敗をStringにします。各枝の->の右側が戻り値です。decodeUtf8Lossy自体の戻り値はStringなので、もう一度LeftとRightを分ける必要はありません。",
    "97はa、40は(として読めます。226の始めた並びと、単独の161は読めないため、U+FFFDという置換文字�になります。この入力を厳密なdecodeUtf8へ渡すと、位置1を持つInvalidUtf8で失敗します。",
  ],
  details: [
    "置換は、不正な並びのうち一まとまりとして扱われる部分ごとに行います。不正な1バイトにつき必ず一つの�になるとは限りません。また、元から�を含む正しい文章もあるため、表示に�があるかどうかで入力の正しさを判定できません。",
    "置換後のStringから元の壊れたバイト列を復元することはできません。署名の確認や、元の内容を正確に受け入れる必要がある処理には、プレビューではなく元のBytesと厳密なdecodeUtf8の結果を使います。",
    "先頭の印に使うU+FEFF（BOM）は取り除かず、文字として残します。空のBytesは空文字列になります。処理は全体を読んで新しい文字列を作るため、入力の大きさに応じた時間とメモリーが必要です。",
  ],
  nodeNote: "Node 24.19.0でも、このUint8ArrayとTextDecoderの例をそのまま使えます。ignoreBOM: trueを省くと先頭のBOMを取り除くため、Seseragiと同じ保持の方針にはなりません。",
}
