import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "bytes.lengthはBytesのバイト数を返します。文字数を数える操作ではなく、バイナリデータの大きさを確認するために使います。",
  taskTitle: "小さなバイナリデータのバイト数を数える",
  purpose: "保存や送信の前に、データが何バイトあるかを確認します。例では0、15、255の3個のバイトを作り、中身と長さを表示します。文字列への変換は必要ありません。",
  typescriptBefore: "Uint8Arrayのcontent.lengthは要素数を返し、1要素が1バイトなので、そのままバイト数になります。Array.fromとjoinは中身を見やすく表示するためだけに使います。",
  benefit: "TypeScriptのlengthもすでに簡潔です。Seseragiではbytes.lengthの引数がBytesなので、文字列や通常の配列と取り違えずに、バイナリデータの長さを数えられます。",
  setup: "bytesはstd/bytesを使うimportの別名です。fn inspect -> Stringは、引数なしでStringを返す関数を定義します。inspect ()で呼び出します。bytes.fromInts [0, 15, 255]は、配列を引数として渡す呼び出しです。",
  after: [
    "fromIntsは各整数が0から255かを確認します。戻り値Either<ByteError, Bytes>は、失敗のLeftか成功のRightです。matchはその枝を選び、Right contentは作成できたBytesにcontentという名前を付けます。",
    "bytes.length contentの結果はInt、つまり整数です。この例では3になります。bytes.toInts contentは表示用に整数の配列へコピーし、showはその配列をStringにします。長さを求める処理自体には、このコピーは不要です。",
    "バッククォートの${...}は式の結果を文字列に埋め込みます。show (bytes.toInts content)は括弧内の呼び出しを先に計算します。Left errorでは失敗をshowで文字列にします。それぞれの枝の->の右側が戻り値です。",
  ],
  details: [
    "bytes.lengthは全要素を数え直さず、一定時間でバイト数を返します。空のBytesの長さは0です。長さだけが必要なら、toIntsで配列を作る必要はありません。",
    "バイト数は文字数ではありません。caféをUTF-8にすると5バイト、🌊は4バイトです。文字列の見た目の長さや、JavaScriptの文字列のlengthと同じだと考えると、サイズ制限の判断を誤ります。",
    "Stringをbytes.lengthへ直接渡すと型が合いません。保存時のUTF-8のサイズを知りたい場合は、std/textのencodeUtf8でBytesに変えてから数えます。すでにBytesなら文字として読めるかに関係なく数えられます。",
  ],
  nodeNote: "このTypeScript例はNode 24.19.0でもそのまま使えます。Uint8ArrayではlengthとbyteLengthが同じ値になりますが、1要素が複数バイトの別の型付き配列まで同じとは限りません。",
}
