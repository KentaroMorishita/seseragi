import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "base64.encode turns Bytes into standard Base64 text. It adds exactly the required trailing = padding and gives the same bytes the same spelling every time.",
  taskTitle: "Write standard Base64 text",
  purpose: "Put a short label’s bytes into a text field that requires standard Base64. Base64 represents bytes with a limited set of ASCII characters. Convert inputs from the empty string through foobar to see when trailing = padding is needed.",
  typescriptBefore: "TypeScript’s TextEncoder turns each label into a UTF-8 Uint8Array, and toBase64() produces standard Base64 text. The standard alphabet and required trailing = padding are defaults, so this example needs no options.",
  benefit: "Both versions use short calls. Seseragi’s types mark the boundary between encodeUtf8, which converts String to Bytes, and encode, which converts Bytes to a Base64 String. Passing text directly to encode is a type error.",
  setup: "text aliases std/text and base64 aliases std/bytes/base64. UTF-8 is a way to turn text into byte values; Bytes is an immutable sequence of those values. Each letter in this example uses one byte.",
  after: [
    "for label <- [...] names each string label and processes them in order. text.encodeUtf8 label is a call with a space between the function and its argument. Parentheses pass that result to the outer base64.encode call.",
    "The initial empty string becomes empty Bytes and then an empty Base64 string. f becomes Zg==, fo becomes Zm8=, and foo becomes Zm9v. The trailing = is padding that makes the output length a multiple of four, rather than a character from the original text.",
    "A complete group of three bytes needs no =. One leftover byte needs ==; two need =. The outputs for foob, fooba, and foobar demonstrate the same rule.",
  ],
  details: [
    "encode takes one Bytes value and returns a new String. It does not return a success/failure choice or reject particular byte contents. It leaves the input unchanged.",
    "The standard alphabet is A–Z, a–z, 0–9, +, and /. The encoder adds only the required trailing = and inserts no whitespace or line breaks. Canonical means the one spelling the encoder produces for those bytes.",
    "Use encodeUrl if the receiver requires URL-safe Base64. Simply removing = from standard Base64 is insufficient when + and / also need to change. Use the matching decode operation to read standard output back.",
    "Passing a string directly to encode fails because the argument must be Bytes. Pass it to encodeUtf8 first, as in the example. Base64 does not keep the contents secret, encrypt them, or compress them.",
  ],
  nodeNote: "The inspected Node 24 runtime has no toBase64(). With Node/Bun, import { Buffer } from \"node:buffer\" and use Buffer.from(content).toString(\"base64\") for the same standard format. Buffer is a Uint8Array subclass with text-conversion methods.",
}
