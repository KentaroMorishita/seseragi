import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { Editorial } from "../model"

pub struct BytesReaderCopy {
  summary: String,
  taskTitle: String,
  purpose: String,
  typescriptBefore: String,
  benefit: String,
  setup: String,
  after: Array<String>,
  details: Array<String>,
  nodeNote: String
}
fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  [Paragraph ([Words (localized en ja)]) | (en, ja) <- arrays.zip japanese english]
fn link title: String -> route: String -> english: String -> japanese: String -> Block =
  Paragraph (
    [
      InternalLink (localized title title, route),
      Words (localized (": " + english) ("：" + japanese))
    ]
  )

pub fn bytesReaderEditorial identity: String
  -> namespace: String
  -> itemKind: String
  -> source: String
  -> english: BytesReaderCopy
  -> japanese: BytesReaderCopy
  -> Editorial =
  Editorial {
    identity,
    namespace,
    itemKind,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-operation", localized english.taskTitle japanese.taskTitle),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        Heading (
          "typescript-comparison",
          localized "Start with familiar TypeScript" "TypeScriptの処理から考える"
        ),
        Paragraph
          ([Words (localized english.typescriptBefore japanese.typescriptBefore)]),
        CodeExample (
          "bytes-reader-" + source + "-ts",
          localized "TypeScript · Bun 1.3.9" "TypeScript・Bun 1.3.9"
        ),
        Terminal
          (localized "TypeScript output" "TypeScriptの実行結果", typescriptOutput source),
        Heading (
          "seseragi-example",
          localized "Write the same task in Seseragi" "Seseragiで同じ処理を書く"
        ),
        CodeExample (
          "bytes-reader-" + source,
          localized "Complete Seseragi program" "Seseragiの完全なプログラム"
        ),
        Terminal (localized "Seseragi output" "Seseragiの実行結果", output source),
        Paragraph ([Words (localized english.benefit japanese.benefit)]),
        Heading ("reading-the-example", localized "Read the important lines" "大事な行を読む"),
        Paragraph ([Words (localized english.setup japanese.setup)])
      ],
      paragraphs english.after japanese.after,
      [
        Paragraph (
          [Words (
            localized
          "The TypeScript line export {} keeps this example file separate from other files during checking; it does not change the printed result."
          "TypeScriptのexport {}は、型を確認するときにこの例のファイルをほかのファイルと分けるための宣言です。表示結果は変えません。"
          )]
        ),
        Paragraph (
          [Words (
            localized
          "pub effect fn main is the public program entry; effect allows this entry to perform output. println prints its string and a newline; the byte conversions themselves return values without printing. In a main written as for item <- [...], each array item is named in turn and the body prints one result. show converts a value to display text; it is not a binary encoding."
          "pub effect fn mainはプログラムの公開された実行入口です。effectを付けることで、この入口から表示を行えます。printlnは文字列と改行を表示し、バイト列の変換そのものは表示せずに値を返します。mainにfor item <- [...]がある例では、配列の要素に順番に名前を付け、各結果を表示します。showは値を表示用の文字列にします。バイナリ形式への変換ではありません。"
          )]
        ),
        Paragraph (
          [Words (
            localized
          "Save the complete Seseragi source under the filename below and run it locally, or open its Playground link. These examples use only small values inside the program. Console is needed for printing; no file, network, navigation or storage service is used."
          "Seseragiの完全なソースを下のファイル名で保存してローカルで実行できます。Playgroundのリンクからも開けます。例で使うのはプログラム内の小さな値だけです。表示にはConsoleを使い、ファイル・ネットワーク・画面移動・保存先のサービスは使いません。"
          )]
        ),
        Terminal (
          localized "Run locally" "ローカルで実行する",
          "seseragi run " + source + ".ssrg --target process"
        ),
        Heading ("operation-rules", localized "Rules and common mistakes" "規則と間違いやすい点")
      ],
      paragraphs english.details japanese.details,
      [
        Heading
          ("node-alternative", localized "Using Node instead of Bun" "Nodeで実行する場合"),
        Paragraph ([Words (localized english.nodeNote japanese.nodeNote)])
      ],
      if needsNodeCodec source then
        [
          Paragraph (
            [Words (
              localized
          "The first TypeScript panel uses Bun 1.3.9 and its type declarations. The Node 24.19.0 comparison below uses node:buffer because that runtime does not provide the Uint8Array hex/Base64 methods. Buffer is a Uint8Array-based byte container with methods for converting to and from strings. This alternative has the same displayed result as the first TypeScript panel."
          "最初のTypeScript例はBun 1.3.9とBunの型定義を使います。下のNode 24.19.0向けの例はnode:bufferを使います。このNodeにはUint8Arrayの十六進・Base64変換メソッドがないためです。Bufferは、文字列との変換メソッドを持つUint8Arrayの一種です。表示結果は最初のTypeScript例と同じです。"
            )]
          ),
          CodeExample (
            "bytes-reader-" + source + "-node-ts",
            localized "TypeScript · Node 24.19.0" "TypeScript・Node 24.19.0"
          )
        ]
      else
        [],
      [Heading ("choose-next", localized "Choose the next operation" "次に必要な操作を選ぶ")],
      related identity,
      if itemKind == "module" then
        []
      else
        [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
}

fn needsNodeCodec source: String -> Bool = match source {
  "validate-byte-input" -> False
  "inspect-binary-payload" -> False
  "explain-utf8-failure" -> False
  "preview-damaged-text" -> False
  _ -> True
}

fn related identity: String -> Array<Block> =
  if identity == "std/bytes/hex"
    || identity == "std/bytes/hex::encode"
    || identity == "std/bytes/hex::decode"
    || identity == "std/bytes/hex::HexDecodeError" then
    [
      link "encode" "/docs/library/bytes/hex/function/encode/"
        "write bytes as lowercase hex." "バイト列を小文字の十六進表記にします。",
      link "decode" "/docs/library/bytes/hex/function/decode/"
        "check hexadecimal input before using its bytes." "十六進表記を確認してからバイト列を使います。",
      link "decodeUtf8" "/docs/library/text/function/decodeutf8/"
        "check whether decoded bytes represent UTF-8 text."
        "取り出したバイト列がUTF-8の文字列かどうかを確認します。"
    ]
  else if identity == "std/bytes/base64"
    || identity == "std/bytes/base64::encode"
    || identity == "std/bytes/base64::decode"
    || identity == "std/bytes/base64::encodeUrl"
    || identity == "std/bytes/base64::decodeUrl"
    || identity == "std/bytes/base64::Base64DecodeError" then
    [
      if identity == "std/bytes/base64::decode" then
        link "encode" "/docs/library/bytes/base64/function/encode/"
        "produce standard padded Base64." "末尾の埋め合わせを含む標準のBase64を作ります。"
      else
        link "decode" "/docs/library/bytes/base64/function/decode/"
        "read standard Base64 back into bytes." "標準のBase64をバイト列へ戻します。",
      link "decodeUrl" "/docs/library/bytes/base64/function/decodeurl/"
        "read unpadded URL-safe Base64." "末尾に埋め合わせを付けないURL向けBase64を読み取ります。",
      link "decodeUtf8" "/docs/library/text/function/decodeutf8/"
        "turn the resulting bytes into checked text." "取り出したバイト列を確認して文字列にします。"
    ]
  else
    [
      link "fromInts" "/docs/library/bytes/function/fromints/"
        "check numeric byte values before constructing Bytes." "整数の範囲を確認してBytesを作ります。",
      link "encodeUtf8" "/docs/library/text/function/encodeutf8/"
        "turn an ordinary string into bytes." "通常の文字列をバイト列にします。",
      link "decodeUtf8" "/docs/library/text/function/decodeutf8/"
        "reject invalid UTF-8 rather than silently replacing it."
        "不正なUTF-8を代替文字に置き換えず、失敗として受け取ります。"
    ]

fn output source: String -> String = match source {
  "text-to-portable-payload" -> "5\n636166c3a9\nY2Fmw6k=\nY2Fmw6k\ncafé\n"
  "validate-byte-input" -> "[0, 127, 255]\nOut of range: 256\nOut of range: -1\n[]\n"
  "inspect-binary-payload" -> "[0, 15, 255]\n3\n"
  "encode-text-utf8" -> "41:1\n636166c3a9:5\nf09f8c8a:4\n:0\n"
  "decode-text-utf8" -> "Text: café\nText: 🌊\nText: \nInvalid UTF-8\n"
  "explain-utf8-failure" -> "Invalid UTF-8 at byte 1\n"
  "preview-damaged-text" -> "a�(�\n"
  "hexadecimal-payload" -> "000f10abff\n\n"
  "read-hexadecimal-payload" -> "Accepted: 00ff\nAccepted: \nRejected\nRejected\nRejected\nRejected\nRejected\nRejected\n"
  "standard-base64-payload" -> "\nZg==\nZm8=\nZm9v\nZm9vYg==\nZm9vYmE=\nZm9vYmFy\n"
  "read-standard-base64" -> "Accepted: 66\nAccepted: \nRejected\nRejected\nRejected\nRejected\nRejected\nRejected\nAccepted: 666f6f\n"
  "url-safe-base64-payload" -> "-_8\nAccepted: fbff\nAccepted: \nRejected\nRejected\nRejected\nRejected\n"
  "hex-decode-errors" -> "Decoded: 00ff\nOdd byte length: 1\nInvalid hex at byte 2\nOdd byte length: 3\n"
  "base64-decode-errors" -> "Decoded: 66\nInvalid byte length: 2\nInvalid digit at byte 2\nInvalid padding at byte 2\nUnused bits at byte 1\n"
  _ -> ""
}

fn typescriptOutput source: String -> String = match source {
  "explain-utf8-failure" -> "Invalid UTF-8\n"
  "hex-decode-errors" -> "Decoded: 00ff\nInvalid hex\nInvalid hex\nInvalid hex\n"
  "base64-decode-errors" -> "Decoded: 66\nInvalid Base64\nInvalid Base64\nInvalid Base64\nInvalid Base64\n"
  _ -> output source
}
