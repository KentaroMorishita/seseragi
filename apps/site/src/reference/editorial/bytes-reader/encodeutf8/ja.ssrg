import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "encodeUtf8は、文字列をUTF-8のBytesへ変換します。保存や通信に必要なバイト列を作り、そのバイト数を確認できます。",
  taskTitle: "文字列をUTF-8にしてサイズを確認する",
  purpose: "A、café、🌊、空文字列を、保存や送信に使うバイト列へ変換します。UTF-8は、文字を1個以上のバイトで表す方式です。変換後の中身を16進数で表示し、実際のバイト数も並べます。",
  typescriptBefore: "TypeScriptではnew TextEncoder().encode(label)がUTF-8のUint8Arrayを返します。BunのtoHexで各バイトを16進数2桁にし、lengthでサイズを読みます。文字列のlengthからバイト数を推測する必要はありません。",
  benefit: "どちらも専用の変換関数一つで書けます。Seseragiでは結果が不変のBytesになり、Stringと区別された状態で、バイト数の確認やBase64への変換に渡せます。",
  setup: "textはstd/text、bytesはstd/bytes、hexはstd/bytes/hexのimportの別名です。text.encodeUtf8 labelは、空白の後にlabelを渡す呼び出しです。戻り値はBytesで、失敗と成功を分けるmatchは必要ありません。",
  after: [
    "for label <- [...]は、配列の文字列を一つずつlabelと呼び、{ }の中の表示を順番に行います。",
    "hex.encode (text.encodeUtf8 label)では、括弧内でUTF-8のBytesを作ってから、hex.encodeで16進数の文字列にします。bytes.lengthもBytesを受け取り、そのバイト数をIntという整数で返します。",
    "バッククォートの${...}は式の結果を文字列に埋め込みます。二つの結果の間の:は表示用の区切りです。出力の41:1はAが1バイト、636166c3a9:5はcaféが5バイトであることを示します。",
    "🌊はf09f8c8aという4バイトになります。空文字列は空のBytesなので、16進数部分が空の:0を表示します。文字の見た目の個数と、保存に必要なバイト数は別の量です。",
  ],
  details: [
    "encodeUtf8は新しいBytesを作り、入力の文字列を変えません。この例は同じlabelを表示用と長さ用に2回変換します。大きな入力では一度変換したBytesに名前を付け、両方で使うと重複した変換を避けられます。",
    "バイト列を文字列に戻す操作はdecodeUtf8です。encodeUtf8へBytesを渡すと型が合いません。元が文字列か、すでにバイト列なのかを分けて扱ってください。",
    "encodeUtf8は先頭の印に使う文字U+FEFF（BOM）を勝手に付けません。入力にU+FEFFがあれば、その文字もUTF-8で表します。値0の文字NULや、前の文字に付くアクセントなどの結合文字も保持し、文字の表記を正規化しません。",
    "SeseragiのStringはUnicodeの文字の値を扱い、UTF-16でペアに使うサロゲートの値を除きます。JavaScriptの文字列には単独のサロゲートも入り、TextEncoderはそれを置換します。通常のSeseragiのJavaScript連携では、そのようなString入力を拒否するため、任意のJavaScript文字列すべてで同じ扱いだとはいえません。",
  ],
  nodeNote: "Node 24.19.0でもTextEncoderは使えます。16進数の表示にはimport { Buffer } from \"node:buffer\"を追加し、content.toHex()をBuffer.from(content).toString(\"hex\")に置き換えます。Bufferは変換用メソッドを持つUint8Arrayの一種です。",
}
