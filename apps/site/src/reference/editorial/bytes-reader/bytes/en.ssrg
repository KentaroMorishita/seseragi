import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "Bytes is an immutable sequence of bytes, distinct from a string or an ordinary integer array. Use its public functions to read or convert the value.",
  taskTitle: "Keep text separate from its stored bytes",
  purpose: "Convert café into bytes for storage or transport, then make hexadecimal and Base64 spellings from the same value. One byte holds an integer from 0 through 255; Bytes holds a sequence of those values.",
  typescriptBefore: "TextEncoder returns a Uint8Array in TypeScript. Giving it a const name does not make its elements immutable. Read length for the byte count and use Bun’s toHex/toBase64 for printable spellings.",
  benefit: "TypeScript is concise for this task too. Seseragi’s Bytes can be passed between functions as an immutable value. Keeping String, Array<Int>, and Bytes as distinct types lets type checking catch a value passed before the required conversion.",
  setup: "bytes, text, hex, and base64 are import aliases for std/bytes, std/text, std/bytes/hex, and std/bytes/base64. let content names the calculated value. text.encodeUtf8 \"café\" passes a string argument after a space.",
  after: [
    "encodeUtf8 returns Bytes, so content’s type follows without an explicit annotation. bytes.length content is 5: é takes two bytes, so this is not the visible length of the text.",
    "hex.encode, base64.encode, and base64.encodeUrl read content without changing it. Hexadecimal represents each byte with two digits. Base64 represents bytes using text; encodeUrl uses its URL-safe alphabet and adds no trailing = padding.",
    "fn decoded -> String defines a function with no parameters that returns a string; decoded () calls it. text.decodeUtf8 returns Either<Utf8DecodeError, String>, meaning Left with an error or Right with a string.",
    "match handles Left and Right separately. Right value names the returned string, while Left _ ignores the detailed error and returns Rejected. The expression after a branch’s -> is its result. A backtick string uses ${...} to insert expression results into the output.",
    "fatal: true makes TextDecoder throw on invalid UTF-8. A BOM is a marker that can use the U+FEFF character at the start of text. ignoreBOM: true keeps that character instead of removing it, matching Seseragi’s decoding policy.",
  ],
  details: [
    "Bytes keeps its representation private. This does not mean freezing a JavaScript typed array. Seseragi code uses public construction, reading, and conversion operations rather than assigning directly to an element.",
    "For an integer array, fromInts checks the range before creating Bytes. The Array<Int> returned by toInts is a copy, not a view for changing the original Bytes. The default JavaScript interoperation also copies in both directions between Bytes and Uint8Array.",
    "Passing a string straight to base64.encode is a type mismatch: the operation needs Bytes. First use text.encodeUtf8. In the other direction, having Bytes does not establish that the content is text. Use the successful string returned by decodeUtf8.",
    "These conversions allocate complete results. Hexadecimal and Base64 are different spellings of data, not encryption or compression. The final decoded call reads the original content. To return from a Base64 string, first decode Base64 to Bytes.",
  ],
  nodeNote: "On Node 24.19.0, add import { Buffer } from \"node:buffer\" and use Buffer.from(content).toString(\"hex\"), with \"base64\" or \"base64url\" for the other spellings. TextEncoder/TextDecoder are available as shown.",
}
