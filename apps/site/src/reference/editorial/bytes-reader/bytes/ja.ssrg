import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "Bytesは、不変のバイト列を表す型です。文字列や通常の整数配列と区別し、読み取りや変換には公開された関数を使います。",
  taskTitle: "文字と、その保存用バイト列を分けて持つ",
  purpose: "caféを保存や通信に使うバイト列に変え、その同じ値から16進数とBase64の表記を作ります。1バイトは0から255までの整数一つ分です。Bytesはそうした値の並びを保持します。",
  typescriptBefore: "TypeScriptではTextEncoderの結果がUint8Arrayです。constで名前を付けても、その要素まで不変になるわけではありません。lengthでバイト数を読み、BunのtoHex/toBase64で表示用の表記を作れます。",
  benefit: "この用途ではTypeScriptも簡潔です。SeseragiのBytesは、要素を書き換えない値として関数間で渡せます。String、Array<Int>、Bytesを別の型にすることで、まだ変換していない値を誤って渡した箇所を型検査で見つけられます。",
  setup: "bytes、text、hex、base64は、それぞれstd/bytes、std/text、std/bytes/hex、std/bytes/base64のimportの別名です。let contentは計算した値に名前を付けます。text.encodeUtf8 \"café\"は、空白の後に文字列の引数を渡す呼び出しです。",
  after: [
    "encodeUtf8の戻り値はBytesなので、contentの型は書かなくても決まります。bytes.length contentは5です。éに2バイトを使うため、文字列の見た目の長さとは一致しません。",
    "hex.encode、base64.encode、base64.encodeUrlはcontentを読むだけで、元のBytesを書き換えません。16進数は各バイトを2桁で表します。Base64は文字だけでバイト列を表す形式で、encodeUrlはURL用の文字集合を使い、末尾の=を付けません。",
    "fn decoded -> Stringは、引数なしで文字列を返す関数です。decoded ()で呼び出します。text.decodeUtf8の戻り値Either<Utf8DecodeError, String>は、エラーを持つLeftか、文字列を持つRightです。",
    "matchはLeftとRightを分けて処理します。Right valueは取り出した文字列をvalueと呼び、Left _は詳しいエラーを使わずRejectedを返します。枝の->の右側が戻り値です。バッククォートの${...}は、式の結果を出力用の文字列に埋め込みます。",
    "fatal: trueは不正なUTF-8を例外にします。BOMは文章の先頭の印に使われるU+FEFFという文字です。ignoreBOM: trueはこの文字を取り除かず、Seseragiと同じように残す指定です。",
  ],
  details: [
    "Bytesの内部の表現は非公開です。これはJavaScriptの型付き配列を凍結する説明ではありません。Seseragiでは要素への直接代入を行わず、公開された作成・読み取り・変換の関数を使います。",
    "整数の配列ならfromIntsで範囲を確認してBytesを作ります。toIntsで得るArray<Int>はコピーであり、元のBytesを書き換えるための窓口ではありません。標準のJavaScript連携でもBytesとUint8Arrayの受け渡しは両方向でコピーします。",
    "文字列をそのままbase64.encodeに渡すと、必要なBytesと型が合いません。先にtext.encodeUtf8で変換します。逆にBytesを持っているだけでは文字としての正しさは分かりません。decodeUtf8に成功した文字列を使ってください。",
    "この例の変換は結果全体を新しく作ります。16進数やBase64は同じデータの別の表記で、暗号化や圧縮ではありません。最後のdecodedは元のcontentを読みます。Base64文字列から戻す場合は、先にBase64をBytesへ戻す処理が必要です。",
  ],
  nodeNote: "Node 24.19.0ではimport { Buffer } from \"node:buffer\"を追加し、Buffer.from(content).toString(\"hex\")、\"base64\"、\"base64url\"で表記を作れます。TextEncoder/TextDecoderはそのまま使えます。",
}
