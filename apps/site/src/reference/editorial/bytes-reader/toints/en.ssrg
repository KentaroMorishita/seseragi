import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "toInts copies every byte from Bytes into an array of integers from 0 through 255. Inspect the original numeric values even when the content is not text.",
  taskTitle: "Inspect binary content as numbers",
  purpose: "Inspect a small byte sequence without converting it to text. The values 0, 15, and 255 form three bytes. Because it contains 255, this payload cannot simply be read as UTF-8 prose.",
  typescriptBefore: "Array.from(content) copies a Uint8Array’s elements to an ordinary TypeScript array. join adds separators for display, and content.length returns the byte count. The fixed input here already fits in the 0–255 range.",
  benefit: "Both versions are short. Seseragi lets you turn Bytes into Array<Int> only where numeric inspection is needed. The result of toInts is a copy, rather than a way to operate directly on the byte sequence’s internal storage.",
  setup: "import * as bytes names the std/bytes operations bytes. fn inspect -> String defines a function with no parameters that returns a string; inspect () calls it. bytes.fromInts [0, 15, 255] passes an integer array after a space.",
  after: [
    "fromInts checks the range and returns Either<ByteError, Bytes>. Left is failure; Right holds successful Bytes. match separates them, and Right content gives the byte sequence the name content.",
    "bytes.toInts content returns Array<Int>, an integer array. Values and order stay the same, so show turns it into [0, 15, 255]. The parentheses in show (bytes.toInts content) obtain the array before converting it to a display String.",
    "A backtick string inserts calculated results at ${...}. The first line is the array; the second is 3 from bytes.length content. The Left error branch turns a failure into a string with show error. The expression after each branch’s -> is its result.",
  ],
  details: [
    "The returned array is not a reference for operating on the original Bytes storage. Copying all bytes to a new array takes time and additional memory proportional to the byte count. Empty Bytes produces an empty array.",
    "If you only want numeric values, do not force the payload through decodeUtf8. The number 255 is a valid byte but is not valid UTF-8 on its own. toInts neither checks nor converts a text encoding.",
    "If you only need the length, call bytes.length without going through toInts. To construct Bytes again from an integer array, check the range with fromInts.",
  ],
  nodeNote: "Node 24.19.0 also provides Uint8Array, Array.from, and length as shown. This example does not use Bun-specific conversion helpers.",
}
