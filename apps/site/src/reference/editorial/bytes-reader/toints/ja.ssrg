import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "toIntsは、Bytesの各バイトを0から255の整数として配列にコピーします。文字として読めないデータも、元の数値のまま確認できます。",
  taskTitle: "バイナリデータの中身を数値で確認する",
  purpose: "受け取った小さなバイト列の中身を、文字へ変換せずに確認します。例の0、15、255は3バイトです。255を含むため、そのままUTF-8の文章として読む用途には向きません。",
  typescriptBefore: "TypeScriptではArray.from(content)でUint8Arrayの要素を通常の配列にコピーします。joinは数値の間に区切りを入れる表示用の処理です。content.lengthはバイト数を返します。この例の入力はすでに0から255に収まっています。",
  benefit: "両方とも短い処理です。SeseragiではBytesを数値で使いたい場所でだけArray<Int>に変えられます。toIntsの結果はコピーなので、バイト列の内部を直接操作する値として扱いません。",
  setup: "import * as bytesはstd/bytesの操作をbytesという名前で使います。fn inspect -> Stringは引数なしで文字列を返す関数で、inspect ()で呼び出します。bytes.fromInts [0, 15, 255]は、空白の後に整数の配列を渡す呼び出しです。",
  after: [
    "fromIntsは範囲を確認し、Either<ByteError, Bytes>を返します。Leftは失敗、Rightは成功したBytesです。matchで分け、Right contentではバイト列にcontentという名前を付けます。",
    "bytes.toInts contentはArray<Int>、つまり整数の配列を返します。値も順序も同じなので、showで文字列にすると[0, 15, 255]になります。show (bytes.toInts content)の括弧は、配列を得てから表示用のStringへ変える順番を表します。",
    "バッククォートの文字列の${...}は計算結果を埋め込みます。1行目は配列、2行目はbytes.length contentの3です。Left errorの枝では、show errorで失敗を文字列にします。枝の->の右側が、その枝で返す値です。",
  ],
  details: [
    "返された配列は、元のBytesと同じ領域を操作するための参照ではありません。全バイトを新しい配列へコピーするため、時間と追加のメモリーはバイト数に応じて増えます。空のBytesなら空の配列になります。",
    "数値を見たいだけなら、decodeUtf8で無理に文字列へ変換しないでください。バイトとして有効な255も、単独では正しいUTF-8ではありません。toIntsは文字コードの検査や変換を行いません。",
    "長さだけが必要ならtoIntsを経由せず、bytes.lengthを使います。整数の配列からBytesを作り直す場合はfromIntsで範囲を確認します。",
  ],
  nodeNote: "Node 24.19.0でもUint8Array、Array.from、lengthをそのまま使えます。この例にはBun専用の変換メソッドはありません。",
}
