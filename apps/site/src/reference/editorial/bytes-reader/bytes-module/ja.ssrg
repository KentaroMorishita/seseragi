import { BytesReaderCopy } from "../model"

pub fn copy -> BytesReaderCopy = BytesReaderCopy {
  summary: "std/bytesは、ファイルや通信の中身を、不変のバイト列として扱うモジュールです。文字列や整数の配列とは分けて持ち、必要なところで変換します。",
  taskTitle: "短い文字列を、文字だけで運べるデータにする",
  purpose: "caféという文字列をUTF-8のバイト列に変え、長さを数えてから、16進数やBase64の文字列で表示します。1バイトは0から255までの整数一つ分です。バイト列はその並びで、文字以外のデータにも使えます。",
  typescriptBefore: "TypeScriptではTextEncoderが文字列をUTF-8のUint8Arrayに変えます。Uint8Arrayは各要素を書き換えられるバイトの入れ物です。BunのtoHexとtoBase64は、その同じ中身を表示用の文字列にします。最後のTextDecoderは、元のバイト列を文字列に戻します。",
  benefit: "TypeScriptの変換も短く書けます。Seseragiでは、得た値を不変のBytesとして渡し、文字列のStringと区別できます。文字として読むときの失敗も戻り値に含まれるため、成功した文字列を使う場所が分かります。",
  setup: "import * as bytesはstd/bytesの操作をbytesという名前で使う宣言です。textは文字とUTF-8、hexは16進数、base64はBase64の変換に使う別名です。letは値に名前を付けます。text.encodeUtf8 \"café\"は、関数名の後に空白で引数を渡す呼び出しです。",
  after: [
    "contentはStringではなくBytesです。bytes.length contentは5を返します。éはUTF-8では2バイトなので、caféの見た目の文字数とバイト数は異なります。",
    "hex.encodeは各バイトを16進数2桁にします。base64.encodeはBase64の標準の表記を作り、base64.encodeUrlはURL用の文字集合を使って末尾の=を省きます。どれも同じ5バイトの別の表記です。暗号化や圧縮は行いません。",
    "fn decoded -> Stringは、引数なしでStringを返す関数を定義します。decoded ()の()は、引数なしで呼び出す印です。decodeUtf8のEither<Utf8DecodeError, String>は、失敗のLeftか、成功した文字列のRightのどちらかです。",
    "matchはその結果に合う枝を選びます。Right valueは成功した文字列にvalueという名前を付けます。Left _の_は、この例では詳しいエラーを使わない印です。枝の->の右側が、その枝で返す値です。",
    "バッククォートで囲んだ文字列の${...}には、式の結果を埋め込みます。例はバイト数、16進数、標準Base64、URL用Base64、元の文字列を順に表示します。最後の変換はBase64を読んでいるのではなく、contentを直接UTF-8として読んでいます。",
    "fatal: trueは不正なUTF-8を例外にします。BOMは文章の先頭の印に使われるU+FEFFという文字です。ignoreBOM: trueはこの文字を取り除かず、Seseragiと同じように残す指定です。",
  ],
  details: [
    "Bytesの要素を直接書き換える操作は公開されていません。不変とはSeseragiの値としての約束であり、JavaScriptのUint8ArrayをObject.freezeで固定するという意味ではありません。",
    "整数の配列から作るときはfromIntsで0から255の範囲を確認します。中身を整数で確認したいときはtoIntsを使います。Bytesを作れたこと自体は、UTF-8として正しいことを意味しません。",
    "encodeUtf8、16進数、Base64の変換は結果全体を新しく作ります。この例は小さなデータを一度に扱います。Base64の読み取りに成功しても、文字として使う前には別途decodeUtf8で確認します。",
  ],
  nodeNote: "Node 24.19.0には、この例のUint8ArrayのtoHex/toBase64がありません。import { Buffer } from \"node:buffer\"でBufferを読み込み、Buffer.from(content).toString(\"hex\")、\"base64\"、\"base64url\"を使えます。TextEncoderとTextDecoderはNodeでも使えます。",
}
