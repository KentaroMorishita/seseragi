import { editorial as case0 } from "./non-empty-list/module/page"
import { editorial as case1 } from "./non-empty-list/cons/page"
import { editorial as case2 } from "./non-empty-list/fromlist/page"
import { editorial as case3 } from "./non-empty-list/reduce1/page"
import { editorial as case4 } from "./non-empty-list/singleton/page"
import { editorial as case5 } from "./iterator/module/page"
import { editorial as case6 } from "./iterator/next/page"
import { editorial as case7 } from "./iterator/unfold/page"
import { ReferenceSymbol } from "../../model/build"
import { Block } from "../../model/page"
import { Editorial, editorialBlocks } from "./model"
pub fn nonemptyIteratorEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.namespace != "value"
    || symbol.itemKind != "function" then
    Nothing
  else if symbol.module == "std/non-empty-list" then
    match symbol.identity {
  "std/non-empty-list::cons" -> Just (case1 ())
  "std/non-empty-list::fromList" -> Just (case2 ())
  "std/non-empty-list::reduce1" -> Just (case3 ())
  "std/non-empty-list::singleton" -> Just (case4 ())
  _ -> Nothing
} else if symbol.module == "std/iterator" then match symbol.identity {
  "std/iterator::next" -> Just (case6 ())
  "std/iterator::unfold" -> Just (case7 ())
  _ -> Nothing
} else Nothing
pub fn nonemptyIteratorModuleBlocks specifier: String -> Array<Block> =
  editorialBlocks (
    if specifier == "std/non-empty-list" then
      Just (case0 ())
    else if specifier == "std/iterator" then
      Just (case5 ())
    else
      Nothing
  )
