import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "型付きの値をJSON文字列へ書き出します。設定のnameとretriesを出力し、名前に含まれる改行や引用符はJSONで読める形に書き換えます。",
  taskTitle: "設定をJSON文字列として書き出す",
  purpose: "アプリ内にある通知設定を、保存や送信に使えるJSON文字列へ変えたいとします。普通の名前に加えて、改行と二重引用符が入った名前も書き出し、そのままJSONとして読める表記になることを確かめます。",
  typescriptBefore: "TypeScriptのwriteSettingsはname、retriesの順に出力用オブジェクトを作り、JSON.stringifyを呼びます。引用符や改行の書き換えはJSON.stringifyが担当します。この例の入力はコード内で作った設定なので、外部のunknownを読み取る検証は行っていません。",
  benefit: "encodeStringは、選んだ型のJSON変換と文字列への書き出しをまとめます。このSettingsでは、宣言した項目とその順番を使えます。引用符を手作業でつないでJSONを作る必要はありません。",
  setup: "import * as json from \"std/json\" はモジュールをjsonという名前で使う宣言です。struct Settingsが名前付きの型を作り、name: Stringとretries: Intが各項目の型を指定します。deriving JsonEncodeは、この型からJSONを作る処理をコンパイラに用意してもらう指定です。",
  after: [
    "Settings { name: \"Mio\", retries: 2 }は、その型の値を作る式です。json.encodeStringの後ろにこの値を渡すとStringが返ります。関数の引数は空白で区切って後ろに置き、括弧で内側の式や呼び出しをまとめます。printlnへ渡しているのは完成した文字列です。",
    "二つ目のnameには本物の改行と二重引用符が含まれます。ソース内の\\nが改行、\\\"が引用符を表します。encodeStringの出力にはJSON用の\\nや\\\"として現れるため、名前の改行で表示が途中の行に分かれることはありません。",
    "pub effect fn mainは結果を表示する実行入口です。-> Unitは利用する戻り値がないこと、with Console fails ConsoleErrorはコンソールを使い表示が失敗する可能性があることを示します。これはJSONへの変換の失敗を宣言しているわけではありません。",
    "doは二つのprintlnを順番に実行します。最初の_ <- は表示処理の戻り値を使わず次へ進む書き方です。encodeStringは文字列を返すだけで、ファイルへの保存やAPIへの送信は行いません。",
  ],
  details: [
    "宣言のencodeString<A>にあるAは、渡す値の型です。where JsonEncode<A>は、その型にJSONへの変換処理が必要という条件です。この例ではSettingsのderiving JsonEncodeがそれを用意し、StringとIntにも対応する処理があります。",
    "この名前付きSettingsは宣言順のname、retriesで出力します。任意の項目を辞書順に並べ替える機能ではありません。この比較は例の文字列と小さい整数を対象にしており、TypeScriptのあらゆるnumberや任意の実行時の値まで同じように書けるという意味ではありません。",
    "戻り値はJsonではなくStringです。中間のJsonが必要ならencodeJsonを使い、手元のJsonを文字列にするならjson.stringifyを使います。JSONの書き出し自体は、名前が空でないことなどアプリ独自の条件を確認しません。",
  ],
}
