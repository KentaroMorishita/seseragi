import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "設定を読み込めなかったとき、JSONの文字列が壊れているのか、値が設定の形に合わないのかをJsonReadErrorで分けられます。成功した場合だけ、確認済みのSettingsを使います。",
  taskTitle: "設定の読み込み失敗を二つに分ける",
  purpose: "設定には文字列のnameと整数のretriesが必要です。正常な設定なら名前を表示し、nameがfalseならデータの形の問題、文字列が{だけならJSONの問題と伝えます。同じ読み込み画面でも、直してほしい内容を分けて案内できます。",
  typescriptBefore: "TypeScript版はまずJSON.parseをtry/catchで囲み、構文の失敗ならJSON text rejectedを返します。読めた値はunknownとして、オブジェクトであること、余分なフィールドがないこと、nameの文字列、retriesの安全な整数を確認します。確認に失敗した場合はSettings shape rejectedです。",
  benefit: "decodeStringは、文字列の解析とSettingsの確認を一つの呼び出しで行い、失敗の段階をJsonReadErrorに残します。呼び出し側は同じ結果から、確認済みの設定を使うか、二種類の案内を表示するかを選べます。",
  setup: "jsonはstd/jsonの別名です。struct Settingsはname: Stringとretries: Intというフィールドを持つ型を定義します。deriving JsonDecodeは、この型をJSONから確認して読み取る関数をコンパイラに用意してもらう指定です。",
  after: [
    "fn readSettings source: String -> Either<json.JsonReadError, Settings>は通常の関数です。コロンは入力の型、-> は戻り値の型を示します。戻り値にSettingsと書くことで、json.decodeString sourceがどの型を読み取るかを選びます。呼び出しは関数と引数を空白で並べます。",
    "Eitherはここでは、Leftに読み込み失敗、RightにSettingsが入る結果です。describeのmatchは最初にこの二つを分けます。Right settingsならsettings.nameを使ってReady: Mioを作れます。",
    "Left errorの内側のmatchが、失敗した段階を分けます。JsonSyntaxFailureはJSONの解析での失敗、JsonDecodeFailureは解析済みの値がSettingsに合わなかった失敗です。どちらの_も詳しい理由をこの例では使わないことを表します。表示は成功、形の失敗、構文の失敗の順です。",
    "mainのdoはprintlnを順に実行し、_ <- は先の表示の戻り値を使わず次へ進みます。effectとwith Console fails ConsoleErrorは表示に必要なコンソールとその失敗可能性を宣言します。Unitは使う戻り値がないことを示し、readSettingsとdescribeは通常の関数のままです。",
  ],
  details: [
    "このSettingsの確認は、必須フィールドの不足、型違い、余分なフィールドを拒否します。retriesが整数でも、アプリのルールとして零以上であることまでは確認しません。そのルールが必要なら、読み込めたSettingsをさらに確認します。",
    "詳しい案内が必要なら、JsonSyntaxFailureからJsonParseErrorを、JsonDecodeFailureからDecodeErrorを受け取って調べます。エラー全体をshowで表示する機能はないため、必要な理由やフィールドを取り出して文章にします。",
    "この比較の一致は、表示した三つの入力での読み込み結果です。JSON.parseでnumberになった後の確認と、Seseragiの正確なJSON数値の確認は、すべての数値入力で同じとは限りません。数値の桁を保つ必要があるときは、parseの数値表現も確認してください。",
  ],
}
