import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "型付きの設定などの値を、文字列にする前のJsonへ変えます。できたJsonは別の操作へ渡せ、文字列が必要になればstringifyで書き出せます。",
  taskTitle: "設定から中間のJSON値を作る",
  purpose: "設定の変換と文字列への書き出しを別の段階にしたいとします。まずnameとretriesを持つSettingsからJsonを作り、次に文字列として表示します。後半の読み取りも、JSONを読む段階とSettingsを確認する段階に分けます。",
  typescriptBefore: "TypeScriptのencodeSettingsはnameとretriesを持つ出力用オブジェクトを作り、呼び出し側がJSON.stringifyで文字列にします。decodeSettingsはunknownの値を確認し、ok: trueとvalueか、ok: falseとreasonを返します。JSON.parseの入力はこのコードに書かれた正しい固定文字列です。",
  benefit: "encodeJsonは、アプリの値からJSONの値へ変える位置を明確にします。その場で文字列を作る必要がないので、Jsonを受け取る処理へ渡す用途にも使えます。文字列を作るstringifyとは戻り値の型が違います。",
  setup: "jsonはstd/jsonの別名です。struct Settingsはname: Stringとretries: Intを持つ名前付きの型です。deriving JsonEncode, JsonDecodeは、この型のJSONへの変換とJSONからの確認処理を用意する指定です。encodeJsonとdecodeJsonはstd/preludeから使えるため、例では個別にimportしていません。",
  after: [
    "let encodeSettings: json.Encoder<Settings> = encodeJsonは、Settings用に選んだencodeJsonをencodeSettingsという名前で保存します。コロンの後ろのEncoder<Settings>はSettings -> Jsonの別名で、-> は受け取る型から返す型への関数を表します。この行ではまだ設定の変換を実行していません。",
    "Settings { name: \"Mio\", retries: 2 }は設定の値を作ります。encodeSettingsの後ろにこの値を渡すとJsonになります。関数の引数は空白で区切って後ろに置きます。括弧で内側の呼び出しをまとめ、次にjson.stringifyへ渡すことで、ようやく表示するStringになります。",
    "let decodeSettings: json.Decoder<Settings> = decodeJsonは逆向きの確認関数を保存します。Decoder<Settings>はJson -> Either<DecodeError, Settings>です。Eitherは、Leftに失敗理由、Rightに成功したSettingsを入れる二つの結果の型です。",
    "fn readParsed source: String -> Stringは文字列を受け取る通常の関数で、-> の後ろが戻り値の型です。match json.parse sourceは文字列を読めたかを調べ、Right valueなら次のmatchでdecodeSettings valueを確認します。Right settings -> はsettings.nameを+で文章につなぎます。Left _ -> は詳細を使わず失敗の文章を返し、_ は無視する指定です。",
    "pub effect fn mainは表示の入口です。Unitは使う戻り値がないこと、with Console fails ConsoleErrorはコンソール利用と表示の失敗可能性を示します。doはprintlnを順に実行し、_ <- は最初の表示の戻り値を無視します。JSON文字列とReady: Mioが一行ずつ表示されます。文字列内の\\\"はJSONの二重引用符の表記です。",
  ],
  details: [
    "encodeJson<A>のAは変換元の型です。where JsonEncode<A>はその型にJSON変換処理が必要という意味で、この例のderiving JsonEncodeがSettings用の処理を用意します。この名前付きSettingsは宣言順に項目を出力し、StringとIntにも変換処理が必要です。",
    "encodeJsonはStringを返しません。Jsonをそのまま使う必要がなく、文字列だけが欲しいならjson.encodeStringで変換と書き出しをまとめられます。encodeJsonはファイル保存や通信も行いません。",
    "設定をJSONへ変えることは、アプリ独自の業務条件を検証することではありません。空の名前や負の再試行回数を禁止するなら、別に確認してください。この比較が示すのは、例の文字列と小さい整数の出力です。",
    "TypeScriptで固定文字列の代わりに外部のJSON文字列を受け取る場合は、JSON.parseにもtry/catchなどの失敗処理が必要です。SeseragiのreadParsedは、解析と型の確認のそれぞれに失敗の分岐を置いています。",
  ],
}
