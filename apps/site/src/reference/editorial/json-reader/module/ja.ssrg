import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "JSONの設定文字列を読み、必要な項目と型を確認してから使うためのモジュールです。設定からJSON文字列を書き出す操作や、アプリの型を決めずにJSONを読む操作もあります。",
  taskTitle: "設定を読んで、確認できた名前を使う",
  purpose: "通知の設定として、名前nameと再試行回数retriesを受け取るとします。JSONとして読めるだけでなく、名前が文字列で回数が整数かを確かめてからReady: Mioと表示します。不正な設定はSettings rejectedと表示します。",
  typescriptBefore: "TypeScriptのreadSettingsはJSON.parseの結果をunknownで受け取り、try/catchで壊れたJSONを扱います。続いて、nullや配列でないオブジェクトか、余分な項目がないか、nameが文字列か、retriesが安全に扱える整数かを調べます。返すSettingsかnullをdescribeが分岐して使うため、確認前の値から名前を取り出しません。",
  benefit: "Seseragiでは、設定の型にderiving JsonDecodeを付けると、その項目を確認する関数をコンパイラが用意します。設定の宣言と基本的な読み取り規則を一緒に保ち、確認に成功した場合だけSettingsを受け取れます。TypeScriptの例も同じ入力を実際に検証しています。",
  setup: "import * as json from \"std/json\" は、このモジュールの操作をjsonという名前で使う宣言です。struct Settingsは名前付きのデータ型を作り、name: Stringとretries: Intが項目名と型を指定します。deriving JsonDecodeは、この型をJSONから読み取るための確認処理を作る指定です。",
  after: [
    "fn readSettings source: String -> Either<json.JsonReadError, Settings>は、sourceという文字列を受け取る通常の関数です。-> の後ろは戻り値の型です。Eitherは二つの結果のどちらかで、ここではLeftに読み取りの失敗、Rightに確認済みのSettingsが入ります。この戻り値の指定で、decodeStringが作る型をSettingsに決めています。",
    "json.decodeString sourceは、文字列をJSONとして読み、続いてSettingsの形を確認します。関数名の後に空白で区切って引数を書きます。describeもStringを受け取ってStringを返す関数で、match readSettings sourceが読み取りの結果を調べます。",
    "matchのRight settings -> は成功時の値にsettingsという名前を付け、その後ろの式を選びます。settings.nameは確認済みの名前、+ は文字列の連結です。Left _ -> は失敗時の分岐で、_ は今回は詳しい理由を使わないという意味です。",
    "最初の入力はReady: Mio、nameがfalseの入力と途中で切れたJSONはSettings rejectedになります。ソース中の\\\"は、文字列にJSONの二重引用符を含める書き方です。",
    "pub effect fn mainは表示を行う実行入口です。Unitは利用する戻り値がないこと、with Console fails ConsoleErrorはコンソールを使い表示が失敗する可能性があることを示します。doは表示を順番に並べ、_ <- は各printlnの戻り値を使わず次へ進みます。JSONの確認はreadSettingsが行い、表示はmainが担当します。",
  ],
  details: [
    "このSettingsの読み取りでは、nameとretriesの両方が必要で、余分な項目も拒否します。Intには整数と安全な範囲の確認があります。ただし、空の名前や負のretriesを禁止する製品上の規則までは含みません。必要なら読み取り成功後に別の条件を確認します。",
    "設定を文字列へ書き出すにはderiving JsonEncodeを付けた型とjson.encodeStringを使います。読み取り用のJsonDecodeと書き出し用のJsonEncodeは別々に選べます。",
    "アプリの型をまだ決めないならjson.parseで文字列をJsonという値にし、json.stringifyで文字列へ戻せます。parseの成功はJSONの文法の確認であり、Settingsの項目の確認ではありません。すでにJsonがあればdecodeJsonでアプリの型へ読み取り、encodeJsonでアプリの値からJsonを作れます。",
    "大きなAPI応答から必要な項目だけを取り出すならfield、欠けてもよい項目ならoptionalField、配列ならarrayが入口になります。この例の操作はメモリ上の文字列を扱います。ファイルの読み込みやAPIへの通信は行いません。",
  ],
}
