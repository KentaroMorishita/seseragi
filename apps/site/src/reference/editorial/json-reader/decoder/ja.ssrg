import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "Decoder<A>は、Jsonを一つ受け取り、確認したAかDecodeErrorを返す関数の別名です。名前の確認処理を変数に保存し、必要な項目の読み取りに使い回せます。",
  taskTitle: "名前を確認する関数に名前を付ける",
  purpose: "API応答から必須のnameだけを読みたいとします。他の項目があっても構いませんが、nameが欠けている場合と文字列でない場合は分けて表示します。Stringを確認する関数を用意し、nameの読み取りに組み合わせます。",
  typescriptBefore: "TypeScriptのreportはJSON.parseをtry/catchで囲み、unknownの値がオブジェクトであることを確認します。Object.hasOwnでnameの有無を調べ、typeofで文字列かを確認してから使います。activeなどの無関係な項目は拒否しません。",
  benefit: "Decoderという別名で「一つのJSON値を確認する関数」の入力と結果を明示できます。文字列そのものの確認と、オブジェクトのnameを探す処理を組み合わせても、できるものは同じ形の普通の関数です。",
  setup: "jsonはstd/jsonの別名です。json.Decoder<String>を展開すると、json.Json -> Either<json.DecodeError, String>です。-> はJsonを受け取って結果を返す関数、EitherはLeftのエラーかRightの文字列を表します。Jsonは解析済みのJSON値で、まだStringと決まっているわけではありません。",
  after: [
    "let stringDecoder: json.Decoder<String> = decodeJsonは、Stringを確認する関数にstringDecoderという名前を付けます。コロンの型指定が、std/preludeから使えるdecodeJsonの読み取り先をStringに決めています。ここで値の確認を実行しているのではなく、関数を保存しています。",
    "入力のJsonをvalueとすると、すべての引数を渡す呼び出しはjson.field \"name\" stringDecoder valueです。関数名の後ろに引数を空白で区切って並べます。fieldはnameを探し、あればstringDecoderにその値を渡します。",
    "例のlet nameDecoder: json.Decoder<String> = json.field \"name\" stringDecoderでは、最後のvalueをまだ渡していません。これでJsonを受け取る関数ができ、後のnameDecoder valueで実行できます。Decoderという新しいオブジェクトを作る構文ではありません。",
    "fn report source: String -> Stringは文字列を受け取って表示文を返す通常の関数です。外側のmatchはjson.parse sourceのLeftとRightを分け、Right valueなら内側のmatchでnameDecoder valueの結果を調べます。Right name -> なら+で名前を文章につなぎます。",
    "Left error -> ならerror.kindを調べます。json.MissingJsonField _は項目がない場合で、_ はその中の項目名を使わない指定です。最後の_ -> はそれ以外の理由をまとめます。parseのLeft _も詳しい理由を使いません。各matchの -> は選んだ場合の式へ続きます。",
    "結果はName: Mio、Name is missing、Name must be textです。pub effect fn mainが表示の入口で、Unitは利用する戻り値がないこと、with Console fails ConsoleErrorはコンソール利用と表示の失敗可能性を表します。doはprintlnを順に実行し、_ <- は戻り値を捨てます。println (report ...)の括弧は内側の呼び出しをまとめ、文字列中の\\\"は二重引用符です。",
  ],
  details: [
    "Decoderは関数型の別名なので、コンストラクターを呼んだり、実行サービスを用意したりする必要はありません。入力はJsonでありStringではありません。生の文字列はまずparseするか、選んだ型でdecodeStringを使って読み取ります。",
    "このnameDecoderは必須のnameだけを確認し、activeのような余分な項目を許します。String用なので、存在するnullやfalseは失敗です。空文字列は文字列として成功します。",
    "失敗するとDecodeErrorが返り、pathとkindを読めます。この例は理由だけを短い表示へ変換します。欠けた項目と、不正な値が入った項目ではエラーの位置の扱いも異なります。場所まで表示したい場合はDecodeErrorの例へ進んでください。",
  ],
}
