import { Editorial } from "../../model"
import { jsonReaderEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  jsonReaderEditorial "std/json::Decoder" "type" "alias" "required-name" "Name: Mio\nName is missing\nName must be text\n" (en.copy ()) (ja.copy ())
