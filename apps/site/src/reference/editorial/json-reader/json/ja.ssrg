import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "Jsonは、文法を確認して読めたJSONの値です。設定オブジェクトだけでなく配列や文字列なども表し、アプリが必要とする項目の確認はまだ行っていません。",
  taskTitle: "設定の形を決めずにJSONを読み直す",
  purpose: "受け取ったJSONを、余分な空白のない文字列に整えたいとします。設定のオブジェクトと配列の両方を読み直して表示し、壊れた入力にはInvalid JSON textを返します。この段階では、名前や再試行回数を取り出しません。",
  typescriptBefore: "TypeScriptではJSON.parseで読んだ値をJSON.stringifyへ渡します。try/catchが文法エラーを受け止め、代わりの文章を返します。JSONの値をそのまま書き戻すため、この例はSettingsの項目チェックをしていません。",
  benefit: "SeseragiのJsonは、文字列を読む段階とアプリ用のデータを確認する段階の間に置ける値です。成功したJSONを保管したり文字列に戻したりしてから、必要になった場所でSettingsや特定の項目として確認できます。",
  setup: "import * as json from \"std/json\" はモジュールにjsonという別名を付けます。fn normalize source: String -> Stringは、sourceという文字列を受け取り、文字列を返す通常の関数です。コロンの後ろは引数の型、-> の後ろは戻り値の型です。",
  after: [
    "json.parse sourceはsourceをJSONとして読みます。関数の引数は空白で区切って後ろに置きます。この戻り値はEither<json.JsonParseError, json.Json>で、Leftに読めなかった理由、Rightに読めたJsonが入ります。Eitherは、この二つの結果のどちらかを持つ型です。",
    "matchはその結果を調べます。Right value -> は成功したJsonにvalueという名前を付け、json.stringify valueで文字列へ戻します。Left _ -> は失敗時の文章を選び、_ は詳しいエラーを使わないという意味です。各 -> の後ろがその分岐の式です。",
    "最初の入力では外側の空白がなくなり、二つ目では配列内の余分な空白がなくなります。true、null、文字列readyはそのままJSONの値として残ります。最後の { は文法が不正なのでInvalid JSON textです。ソースの\\\"は文字列の中に二重引用符を書く表記です。",
    "pub effect fn mainは表示の実行入口で、Unitは使う戻り値がないことを表します。with Console fails ConsoleErrorはコンソールの利用と表示の失敗可能性の宣言です。doはprintlnを順番に実行し、_ <- は途中の表示の戻り値を使わず進みます。println (normalize ...)の括弧は、先に計算した文字列を表示へ渡すために呼び出しをまとめています。",
  ],
  details: [
    "Jsonが表す形は六つです。JsonNullはnull、JsonBoolは真偽値、JsonNumberは数、JsonStringは文字列、JsonArrayはJsonの配列、JsonObjectは名前とJsonの組を持つオブジェクトです。これらの名前は値の形を表す公開の名前で、必要ならmatchで形ごとに分岐できます。parse成功だけでは、オブジェクトであることすら決まりません。",
    "JsonNumberは数をDecimalで保持し、JavaScriptのnumberへ丸めず扱います。JsonObjectの項目は順序を持つMapに保存されます。これはJavaScriptのオブジェクトをそのまま渡したものではありません。大きな数や整数に見える項目名では、標準のJSON.parseと結果が異なることがあります。",
    "読み取り時に重複した項目名は拒否されます。書き戻す際は空白や数の元の書き方を保存せず、同じJSONの値を簡潔な表記にします。元の文書の見た目を再現する用途には向きません。二つの例の出力が一致しても、すべての入力でJavaScriptと同じ動作をするという意味ではありません。",
    "nameをアプリで使うにはfieldとString用の確認処理、Settings全体を使うにはdecodeJsonとSettings用の確認処理を続けます。最初から文字列をSettingsとして読みたいならdecodeStringがその二段階をまとめます。",
  ],
}
