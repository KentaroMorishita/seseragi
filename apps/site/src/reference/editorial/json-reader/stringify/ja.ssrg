import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "手元のJsonを余分な空白のない文字列にするにはstringifyを使います。この例では、貼り付けたJSONをparseで読み、成功した値だけを整えて表示します。",
  taskTitle: "JSONの値を表示用の文字列にする",
  purpose: "設定のオブジェクトや配列を、一行のJSONとして表示したいとします。文字列の空白を直接削除するのではなく、まずJSONとして読み、その値から文字列を作り直します。読めない入力には短い説明を返します。",
  typescriptBefore: "TypeScript版はJSON.stringify(JSON.parse(source))で同じ三つの入力を試します。オブジェクトと配列は一行の文字列になり、閉じられていない{はcatchでInvalid JSON textになります。成功時に返すのはJSONの値そのものではなくstringです。",
  benefit: "stringifyはJsonからStringへの変換です。解析できた値を受け取って文字列にする段階が分かれ、ここでアプリのフィールドをもう一度確認したり、入力の文字列を手で加工したりする必要はありません。",
  setup: "jsonはstd/jsonの別名です。fn normalize source: String -> Stringは、sourceを文字列として受け取り、文字列を返す通常の関数です。コロンは引数の型、-> は戻り値の型です。json.stringify valueのように空白で引数を渡します。",
  after: [
    "normalizeはまずjson.parse sourceを呼びます。結果のLeftは解析の失敗、Rightは解析できたJsonです。matchはこの二つから分岐を選び、Left _の_は詳しい失敗理由を使わないことを表します。",
    "Right valueの分岐では、json.stringify valueが直接Stringを返します。stringifyの戻り値をさらにLeftやRightで調べる必要はありません。最初の表示は{\"name\":\"Mio\",\"retries\":2}です。",
    "二つ目の配列は[true,null,\"ready\"]となり、要素の順番はそのままです。最後の{ではparseが失敗するのでstringifyまで進まず、Invalid JSON textが表示されます。",
    "mainのdoはprintlnを順に実行し、_ <- は先の表示の戻り値を使わず次へ進みます。Unitは使う戻り値がないこと、effectとwith Console fails ConsoleErrorはコンソールの利用と表示の失敗可能性を宣言します。normalizeやstringifyは通常の関数です。",
  ],
  details: [
    "stringifyが受け取るのはJsonです。Settingsのようなアプリの値をそのまま文字列にするならencodeStringを使い、まずJsonを作りたいならencodeJsonを使います。JSONの文字列をさらにstringifyへ渡す操作とは分けて考えます。",
    "空白や数値の元の書き方は保存されません。たとえば1.00は1に、-0は0になります。入力の見た目をそのまま保存する用途では、元の文字列も残してください。",
    "同じ順序を持つJsonからは同じ文字列ができます。オブジェクトのフィールドはその値が持つ順序で出力され、名前順への並べ替えはしません。キーの順序を無視した同一性の判定や、そのための共通ハッシュを作る機能とは異なります。",
  ],
}
