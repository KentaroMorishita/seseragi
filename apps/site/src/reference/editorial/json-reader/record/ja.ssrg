import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "決めたフィールドだけを持つJSONオブジェクトを確認するにはrecordを使います。各値を同じ結果型へ読み取り、宣言した順番の名前と値のペアを返します。",
  taskTitle: "二つの表示ラベルを決まった順番で読む",
  purpose: "ラベル設定にはfirstとsecondという二つの文字列だけを許可します。JSON内の順番がsecond、firstであっても、結果はfirst、secondの順にそろえます。フィールドの不足、余分なフィールド、値の型違いは拒否します。",
  typescriptBefore: "TypeScript版はJSON.parseの結果をunknownに置き、オブジェクトかを確認してから、許可した二つ以外のキーがないかを先に調べます。その後first、secondを文字列として確認し、[名前, 値]のペアを決めた順番で配列にします。例の入力はすべてJSONとして構文が正しいものです。",
  benefit: "recordには、読み取るフィールド名と確認関数の一覧を渡します。その一か所で許可するフィールドと結果の並びを示せるため、未知のキーの確認やペアの組み立てを呼び出し側に重ねて書かずに済みます。",
  setup: "jsonはstd/jsonの別名です。let stringDecoder: json.Decoder<String> = decodeJsonの型注釈で、文字列の確認関数を選びます。(\"first\", stringDecoder)は名前と関数のペアで、角括弧の一覧にfirst、secondの順に並べてjson.recordへ渡します。",
  after: [
    "labelsDecoderの型json.Decoder<Array<(String, String)>>は、Jsonから名前と文字列のペアの配列を読み取る関数です。外側の結果は失敗のLeftか成功のRightで、成功側にこの配列が入ります。Stringが二つあるのは、ペアの名前と読み取った値の型です。",
    "fn report source: String -> Stringは通常の関数です。コロンは引数の型、-> は戻り値の型を示し、labelsDecoder valueのように空白で引数を渡します。matchはparseの結果を調べ、Right valueのときだけlabelsDecoderへ渡します。",
    "確認が成功したRight labelsではencodeStringでペアの配列を表示します。JSON内でsecondが先でも、結果は[[\"first\",\"A\"],[\"second\",\"B\"]]です。Left _は理由を使わずLabels rejectedを返し、残る二つの入力はどちらも拒否されます。",
    "mainのdoはprintlnを順に実行し、_ <- は先の表示の戻り値を使いません。Unitは使う戻り値がないこと、effectとwith Console fails ConsoleErrorはコンソールの利用と表示の失敗可能性を示します。recordによる確認自体は通常の関数です。",
  ],
  details: [
    "recordの各確認関数は、成功時に同じ型Aの値を返す必要があります。この例のAはStringです。name: Stringとretries: Intのように異なる型のフィールドを持つ設定には、JsonDecodeをderivingした名前付き構造体を使えます。recordの結果はそのような構造体ではなく、名前と値のペアの配列です。",
    "未知のフィールドは、宣言したフィールドを確認するより先に拒否します。最後の入力にはextra、型の違うfirst、不足したsecondがありますが、最初の理由はextraです。この短い例では理由を使わず、どの失敗も同じ表示にしています。",
    "未知のフィールドがなければ、宣言した一覧の順に確認し、最初の失敗で止まります。すべての宣言フィールドが必須です。ほかのフィールドを許可しながら一つだけ取り出したい場合はfieldを使います。",
  ],
}
