import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "型ごとに、JSONの値からその型を読み取る確認処理を提供する仕組みです。Settingsにderiving JsonDecodeを付けると、項目と型を確認してからSettingsを受け取れます。",
  taskTitle: "設定の宣言からJSONの確認処理を用意する",
  purpose: "アプリではnameを文字列、retriesを整数として使いたいとします。そのSettingsの宣言を使って、保存されたJSON文字列を読み取ります。確認に成功した名前だけで準備完了のメッセージを作ります。",
  typescriptBefore: "TypeScriptのSettingsはアプリ内で使う型です。外から来る値には、readSettingsがJSON.parseのtry/catchとunknownへの型チェックを別途行います。余分な項目や不正な値ならnull、必要な項目を確認できたらSettingsを返し、describeがその二つを分けて扱います。",
  benefit: "deriving JsonDecodeを指定すると、このSettingsの項目に対応した基本的な確認処理をコンパイラが用意します。同じ確認処理をdecodeStringからも、すでにJSONを読んだ後のdecodeJsonからも使えます。どこで読み取っても、選んだ型の規則が使われます。",
  setup: "このページのJsonDecodeはstd/preludeのtraitです。ここでtraitとは、型ごとに「JSONからこの型を読む」処理を提供する共通の約束です。struct Settingsが名前付きの型を作り、name: Stringとretries: Intが項目の型、deriving JsonDecodeがその約束に沿う確認処理を作る指定です。JsonDecodeはこの例ではimportせず使えます。",
  after: [
    "import * as json from \"std/json\" はjson.decodeStringを使うための別名を付けます。fn readSettings source: String -> Either<json.JsonReadError, Settings>は文字列を受け取る通常の関数で、-> の後ろが戻り値の型です。Settingsの指定が、どの型の確認処理を使うかを決めます。",
    "Eitherは二つの結果のどちらかを持ちます。ここではLeftに読み取りエラー、Rightに確認済みのSettingsが入ります。json.decodeString sourceは空白の後ろに引数を置く呼び出しで、まずJSONを読み、それからSettingsの確認処理を使います。",
    "fn describeもStringからStringへの関数です。match readSettings sourceは結果を調べ、Right settings -> ならその成功値をsettingsと呼び、settings.nameを取り出します。+ は文字列の連結です。Left _ -> は失敗を選び、_ は詳しい理由を無視します。各 -> の後ろがその場合に返す式です。",
    "結果はReady: Mioと二つのSettings rejectedです。二つ目の入力はnameの型が違い、三つ目はJSON自体が壊れています。ソースの\\\"は、JSONの二重引用符を文字列の中に書く表記です。",
    "pub effect fn mainは表示用の実行入口です。Unitは使う戻り値がないこと、with Console fails ConsoleErrorはコンソールの使用と表示の失敗可能性を示します。doはprintlnを順に実行し、_ <- は表示の戻り値を使わない書き方です。この表示の処理と、JsonDecodeによる値の確認は別です。",
  ],
  details: [
    "JsonDecode<A>は、Aという型をJSONから読み取れるという条件です。たとえばJsonDecode<Settings>はSettings用の確認処理があることを示します。ページの宣言見出しはtrait JsonDecodeと表示されていますが、ここで説明するAは読み取り先の型です。関数のwhere JsonDecode<A>も同じ条件を表します。",
    "このtraitが提供する関数decodeJsonはJsonを受け取り、Either<DecodeError, A>を返します。文字列を直接受け取る関数ではありません。例のdecodeStringは、文字列の解析とこの確認をまとめて行います。",
    "この名前付きSettingsの導出では、両方の項目が必須で、余分な項目も拒否されます。StringとIntには対応する確認処理があります。項目の型に確認処理がなければ、この導出も使えません。JsonEncodeだけを導出しても読み取り用にはなりません。",
    "導出するのは項目と型の確認です。Intの整数・範囲の条件は確認しますが、空の名前や負の再試行回数を禁止する規則は作りません。そうしたアプリ固有の条件は、読み取ったSettingsに対して別途確認します。",
  ],
}
