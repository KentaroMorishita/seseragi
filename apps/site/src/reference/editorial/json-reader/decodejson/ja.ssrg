import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "すでに読んだJsonを、指定したアプリの型として確認します。成功時はその型の値、失敗時はどこで確認できなかったかを表すDecodeErrorを返します。",
  taskTitle: "解析済みのJSONからSettingsを確認する",
  purpose: "JSON文字列を読む処理と、通知設定のnameとretriesを確認する処理を分けたいとします。parseで読めた値をSettings用のdecodeJsonへ渡し、成功した場合だけ名前をメッセージに使います。例の前半は逆方向の書き出しも示します。",
  typescriptBefore: "TypeScriptは正しい固定文字列をJSON.parseで読み、結果をunknownと注釈します。decodeSettingsがオブジェクトか、余分な項目がないか、必須の項目と型が正しいかを調べます。返るオブジェクトのokを見て、成功のvalueか失敗のreasonを表示します。前半のencodeSettingsとJSON.stringifyは書き出し側です。",
  benefit: "decodeJsonは、文法が正しいJSONと、アプリが使えるSettingsとの間に確認の段階を置きます。すでにJsonを持っているなら、文字列へ戻して読み直す必要はありません。戻り値の成功側には確認済みの型が入ります。",
  setup: "jsonはstd/jsonの別名です。struct Settingsはname: Stringとretries: Intを持つ名前付きの型を作ります。deriving JsonEncode, JsonDecodeはJSONへの変換とJSONからの確認処理を用意する指定です。decodeJsonはstd/preludeから使える関数で、ここでは直接importする必要がありません。",
  after: [
    "let decodeSettings: json.Decoder<Settings> = decodeJsonはSettings用の確認関数を保存します。コロンの型指定が読み取り先を選びます。Decoder<Settings>はJson -> Either<DecodeError, Settings>の別名で、-> は関数の入力と戻り値を区切ります。EitherはLeftの失敗理由かRightの確認済みSettingsのどちらかです。",
    "fn readParsed source: String -> Stringは文字列を受け取って表示文を返す通常の関数です。match json.parse sourceは最初に文法の読み取り結果を調べます。Left _ -> は失敗の文章を返し、_ は詳しい理由を使わない指定です。Right value -> で手に入るのはJsonであり、まだSettingsではありません。",
    "内側のmatch decodeSettings valueで、初めてSettingsの項目と型を確認します。関数の引数は空白で区切って後ろに置きます。Right settings -> ならsettings.nameを使い、+で文章につなぎます。Left _ -> ならSettings rejectedです。各matchの -> はその場合に返す式へ続きます。",
    "前半のlet encodeSettings: json.Encoder<Settings> = encodeJsonは逆方向の関数を保存します。Encoder<Settings>はSettings -> Jsonです。Settings { name: \"Mio\", retries: 2 }で設定の値を作り、encodeSettingsでJson、json.stringifyでStringにします。括弧は内側の式や呼び出しをまとめます。",
    "pub effect fn mainは表示の入口です。Unitは使う戻り値がないこと、with Console fails ConsoleErrorはコンソール利用と表示の失敗可能性を示します。doがprintlnを順に実行し、_ <- が最初の表示の戻り値を無視します。JSON文字列の次にReady: Mioが表示されます。ソース内の\\\"は、文字列にJSONの引用符を含める表記です。",
  ],
  details: [
    "decodeJsonの入力はJsonであり、生のStringではありません。文字列を直接Settingsとして読みたいならjson.decodeStringを使います。parseに成功しただけでは、必要な項目があるとも、その値の型が正しいとも分かりません。",
    "where JsonDecode<A>は、読み取り先の型AにJSONの確認処理が必要という条件です。この例のderiving JsonDecodeはSettings用の処理を用意します。どの型を読みたいか分からない場所では、例のDecoder<Settings>のように型を指定します。",
    "この名前付きSettingsでは、nameとretriesの両方が必要で、余分な項目も拒否します。Intには整数と範囲の確認がありますが、負の再試行回数や空の名前を禁止する業務条件までは含みません。",
    "TypeScriptのdecodeSettingsは失敗を結果オブジェクトで返しますが、この例のJSON.parseは固定文字列用です。外部の文字列に置き換えるなら、parseの失敗もtry/catchなどで扱ってください。Seseragiの例では外側のmatchがその失敗、内側が型の確認失敗を扱っています。",
  ],
}
