import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "nameの指定がない場合も受け入れたいときはoptionalFieldを使います。指定なしと、空文字列を含む指定された値を分け、存在する値は渡した関数で確認します。",
  taskTitle: "名前の指定なしと空文字列を区別する",
  purpose: "任意のnameを持つ設定を読み取ります。フィールドがない場合はName is missing、文字列がある場合はPresent: に続けて表示します。空文字列にも指定があり、nullが入っている場合には文字列の確認が必要です。",
  typescriptBefore: "TypeScript版はJSON.parseの結果をunknownとして、まずオブジェクトかを確認します。Object.hasOwnで指定なしを調べ、その後で文字列かを調べます。真偽値としての判定を使わないため、空文字列を指定なしと混同しません。四つの入力はすべてJSONとして構文が正しいものです。",
  benefit: "optionalFieldは、指定なしを正常な結果にしながら、存在する値の確認を省きません。戻り値のMaybe<String>を見るだけで、呼び出し側は名前がない場合と、確認済みの文字列がある場合を分けられます。",
  setup: "jsonはstd/jsonの別名です。let stringDecoder: json.Decoder<String> = decodeJsonの型注釈で、文字列を読み取る関数を選びます。json.optionalField \"name\" stringDecoderはフィールド名と確認関数を空白で渡し、あとでJsonを受け取る関数を作ります。",
  after: [
    "optionalNameの型はjson.Decoder<Maybe<String>>です。DecoderはJsonを確認し、Leftに失敗理由、Rightに成功した値を返す関数です。その成功値がMaybe<String>で、Nothingなら指定なし、Just valueなら文字列があることを表します。",
    "fn report source: String -> Stringは、sourceを文字列として受け取り文字列を返す通常の関数です。コロンは入力の型、-> は戻り値の型です。matchは結果に応じた分岐を選び、Left _の_は詳しい失敗理由をこの表示では使わないことを示します。",
    "parseが成功したRight valueだけをoptionalNameへ渡します。そこでLeftならName must be textです。Right nameではさらにmatchし、NothingならName is missing、Just valueならPresent: にvalueを加えます。",
    "表示は指定なし、空の文字列、Mio、nullの順です。空の文字列はJustに入るのでPresent: まで表示され、nullはStringではないため拒否されます。mainのdoがprintlnを順に実行し、_ <- は先の表示の戻り値を使いません。Unitは使う戻り値がないこと、with Console fails ConsoleErrorは表示用のコンソールとその失敗可能性を示します。",
  ],
  details: [
    "optionalFieldがそのままNothingにするのは、フィールドが存在しない場合だけです。値があればnullも含めて渡した関数で確認します。Stringの確認ではnullを拒否しますが、nullを受け入れる確認関数を渡すこともできます。",
    "たとえばMaybe<String>を読み取る関数を渡すと、成功値はMaybe<Maybe<String>>になります。指定なしはNothing、存在するnullはJust Nothingです。外側がフィールドの有無、内側がその値を表すため、両者は区別されたままです。",
    "入力そのものがオブジェクトでなければ失敗します。存在する値の確認に失敗した場合も、指定なしとして処理を続けるわけではありません。この例では余分なフィールドは許可します。",
  ],
}
