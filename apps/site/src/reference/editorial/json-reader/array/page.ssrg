import { Editorial } from "../../model"
import { jsonReaderEditorial } from "../model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  jsonReaderEditorial "std/json::array" "value" "function" "array-counts" "[2,0,5]\n[]\nCounts rejected\n" (en.copy ()) (ja.copy ())
