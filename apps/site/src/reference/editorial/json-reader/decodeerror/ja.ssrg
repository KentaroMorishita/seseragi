import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "APIデータのどこで確認に失敗したかを伝えるには、DecodeErrorのpathとkindを読みます。この例では、peopleの何番目のnameに問題があるかを表示します。",
  taskTitle: "読み取れなかった名前の場所を伝える",
  purpose: "APIから届いたpeopleの配列から、文字列の名前だけを取り出します。途中で名前の型が違ったり、名前自体がなかったりした場合は、呼び出し側が直す場所を分かるようにします。空の配列は問題のない結果です。",
  typescriptBefore: "TypeScript版はJSON.parseの結果をunknownとして受け取り、オブジェクト、peopleの有無、配列、各要素のnameを順に調べます。forループは最初の問題で戻り、そこで組み立てた場所と理由を返します。この比較で渡す文字列はすべてJSONとして構文が正しく、型やフィールドの確認に焦点を当てています。",
  benefit: "Seseragiではfieldとarrayを組み合わせると、失敗した場所がDecodeErrorに入ります。名前を確認する部分は表示文を組み立てずに再利用でき、decodeErrorTextが場所と理由の表示をまとめて受け持ちます。",
  setup: "jsonとtextはインポートしたモジュールの別名です。fn segment value: json.JsonPathSegment -> Stringは、valueの型をコロンの後に書き、戻り値の型を -> の後に書く通常の関数です。segment itemのように、関数と引数を空白で並べて呼び出します。",
  after: [
    "let stringDecoder: json.Decoder<String> = decodeJsonの型注釈で、JSONの文字列を確認する関数を選びます。Decoder<String>は、Jsonを受け取り、失敗理由のLeftか、確認済みのStringを入れたRightを返す関数です。nameDecoderはnameを、peopleDecoderはpeopleの配列にある各nameを確認します。",
    "reportのmatchは結果に応じた行を選びます。parseのLeft _では構文の失敗理由を使わず、Right valueでは解析できた値をpeopleDecoderへ渡します。そのLeft errorだけを表示関数へ渡し、Right namesなら確認済みの名前をJSON文字列にします。",
    "error.pathには、根元から順にJsonFieldのフィールド名やJsonIndexの添字が入ります。segmentのmatchがそれぞれを.nameや[1]にし、[segment item | item <- path]で各要素を表示用の文字列に変えます。text.joinがそれを連結し、先頭に$を付けます。showはここでは整数の添字だけを文字列にします。",
    "error.kindは失敗理由です。kindTextのmatchは、ExpectedJsonTypeなら期待した型、MissingJsonFieldなら不足した名前などを取り出して文章にします。二人目のnameがfalseなら$.people[1].name | expected JsonString、nameがなければ$.people[1] | missing nameとなります。",
    "mainだけが表示のためのeffect関数です。doはprintlnを順に実行し、_ <- は先の表示の戻り値を使わない書き方です。Unitは使う戻り値がないこと、with Console fails ConsoleErrorはコンソールの利用と表示の失敗可能性を示します。JSONの確認関数自体は通常の関数です。",
  ],
  details: [
    "見つからないフィールドの名前はkindに入ります。そのため、nameがない場合のpathは親のpeople[1]で終わります。nameが存在し、その値の確認で失敗した場合にだけnameがpathへ加わります。空のpathは根元を表し、この表示では$になります。",
    "arrayは最初に失敗した要素で止まります。falseの名前に続くnullの名前は確認されず、この例はすべての問題を一覧にするものではありません。$、.name、[1]という表示は例の単純なフィールド名向けの規則で、一般的なJSONPath規格の実装ではありません。",
    "DecodeErrorのpathとkindは読めますが、DecodeError { ... }での直接作成や、その名前を使う構造体パターンは非公開です。またDecodeError、DecodeErrorKind、JsonReadError、JsonParseError、JsonPathSegmentにはEq、Show、Debugがありません。show errorで全体を表示しようとせず、この例のように公開されたフィールドや選択肢から表示文を作ります。",
  ],
}
