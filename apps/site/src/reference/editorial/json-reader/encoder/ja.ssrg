import { JsonReaderCopy } from "../model"

pub fn copy -> JsonReaderCopy = JsonReaderCopy {
  summary: "Encoder<A>は、Aを受け取ってJsonを作る関数の別名です。設定をJSONの値へ変える処理と、その値を文字列に書き出す処理を分けられます。",
  taskTitle: "設定をJsonにする関数を保存する",
  purpose: "設定をすぐ文字列へ書き出す前に、JSONの値へ変える段階を分けたいとします。Settings用の変換関数をencodeSettingsとして保存し、できたJsonをstringifyで表示します。後半では逆に、読んだJsonからSettingsを確認します。",
  typescriptBefore: "TypeScriptのencodeSettingsは出力したい項目を並べたオブジェクトを返し、JSON.stringifyはその後で呼びます。逆方向のdecodeSettingsはunknownを実際に確認し、ok: trueならvalue、ok: falseならreasonを返します。ここでJSON.parseへ渡すのは、コード内の正しい固定文字列です。",
  benefit: "Encoderという別名により、設定からJsonへの変換を、文字列への出力とは独立した関数として扱えます。できたJsonを別の処理へ渡してもよく、文字列が必要になった時点でstringifyを呼べます。",
  setup: "jsonはstd/jsonの別名です。struct Settingsはname: Stringとretries: Intを持つ型を宣言します。deriving JsonEncode, JsonDecodeは、JSONへ変換する処理とJSONから確認して読む処理をコンパイラに用意してもらう指定です。二つを付けているのは、この例が両方向を示すためです。",
  after: [
    "json.Encoder<Settings>はSettings -> json.Jsonという関数型の別名です。-> は左の値を受け取り右の型の値を返すことを表します。JsonはJSONを表す値で、Stringではありません。let encodeSettings: json.Encoder<Settings> = encodeJsonは、コロンの型指定によってSettings用に選んだ関数を保存します。encodeJsonはstd/preludeから使えます。",
    "Settings { name: \"Mio\", retries: 2 }は設定の値を作る式です。encodeSettingsの後ろにその値を置いて呼び出し、できたJsonをjson.stringifyへ渡します。引数は空白で区切り、括弧で内側の呼び出しをまとめます。結果はname、retriesの順のJSON文字列です。",
    "let decodeSettings: json.Decoder<Settings> = decodeJsonは逆方向の確認関数を保存します。Decoder<Settings>はJson -> Either<DecodeError, Settings>という意味で、Leftには失敗、Rightには確認済みのSettingsが入ります。",
    "fn readParsed source: String -> Stringは通常の関数で、コロンは引数の型、-> の後ろは戻り値の型です。外側のmatchはjson.parse sourceの結果を調べ、Right valueなら内側のmatchでdecodeSettings valueを調べます。Right settings -> ではsettings.nameを+で文章につなぎ、Left _ -> では詳しい理由を使わず失敗の文章にします。matchの -> は各場合の式へ続きます。",
    "pub effect fn mainは表示の入口です。Unitは利用する戻り値がないこと、with Console fails ConsoleErrorはコンソール利用と表示の失敗可能性を表します。doはprintlnを順に実行し、_ <- は最初の表示の戻り値を捨てます。二行目はReady: Mioです。文字列内の\\\"はJSONの引用符を書く表記です。",
  ],
  details: [
    "Encoderは関数の別名であり、Encoderという値を構築する必要はありません。SettingsのJsonEncodeを使うencodeJsonも、同じ入力と出力の型を持つ自分の関数も、この型に合います。変換自体はコンソールやネットワークを使いません。",
    "encodeSettingsだけでは文字列になりません。Jsonが必要ならその結果を使い、文字列だけが必要ならjson.encodeStringで変換と書き出しをまとめられます。",
    "この名前付きSettingsは宣言順のname、retriesで出力します。deriving JsonEncodeを使うには、各項目の型にもJSONへの変換処理が必要です。JSONにすること自体は、名前や再試行回数がアプリの業務条件に合うかを確認しません。",
    "TypeScriptの固定文字列を外部入力に置き換えるなら、JSON.parseの失敗もtry/catchなどで扱ってください。Seseragi側のreadParsedは、parseの失敗とSettingsの確認失敗を別々のmatchで扱っています。比較する出力は、この例の文字列と小さい整数についてのものです。",
  ],
}
