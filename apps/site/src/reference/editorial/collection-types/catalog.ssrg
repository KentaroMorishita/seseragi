import { ReferenceSymbol } from "../../../model/build"
import { Editorial } from "../model"
import { editorial as map } from "./map/page"
import { editorial as set } from "./set/page"
import { editorial as nonempty } from "./nonempty/page"
import { editorial as iterator } from "./iterator/page"
import { editorial as sizeerror } from "./sizeerror/page"
import { editorial as nonpositivesize } from "./nonpositivesize/page"
import { editorial as reducestep } from "./reducestep/page"
import { editorial as next } from "./next/page"
import { editorial as done } from "./done/page"

// Match canonical identity, route owner, namespace and kind together.
pub fn collectionTypeEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.identity == "std/map::Map"
    && symbol.module == "std/map"
    && symbol.namespace == "type"
    && symbol.itemKind == "opaque-type" then
    Just (map ())
  else if symbol.identity == "std/set::Set"
    && symbol.module == "std/set"
    && symbol.namespace == "type"
    && symbol.itemKind == "opaque-type" then
    Just (set ())
  else if symbol.identity == "std/non-empty-list::NonEmptyList"
    && symbol.module == "std/non-empty-list"
    && symbol.namespace == "type"
    && symbol.itemKind == "opaque-type" then
    Just (nonempty ())
  else if symbol.identity == "std/prelude::Iterator"
    && symbol.module == "std/iterator"
    && symbol.namespace == "type"
    && symbol.itemKind == "opaque-type" then
    Just (iterator ())
  else if symbol.identity == "std/collection::SizeError"
    && symbol.module == "std/collection"
    && symbol.namespace == "type"
    && symbol.itemKind == "opaque-type" then
    Just (sizeerror ())
  else if symbol.identity == "std/collection::NonPositiveSize"
    && symbol.module == "std/collection"
    && symbol.namespace == "value"
    && symbol.itemKind == "constructor" then
    Just (nonpositivesize ())
  else if symbol.identity == "std/collection::ReduceStep"
    && symbol.module == "std/collection"
    && symbol.namespace == "type"
    && symbol.itemKind == "opaque-type" then
    Just (reducestep ())
  else if symbol.identity == "std/collection::Next"
    && symbol.module == "std/collection"
    && symbol.namespace == "value"
    && symbol.itemKind == "constructor" then
    Just (next ())
  else if symbol.identity == "std/collection::Done"
    && symbol.module == "std/collection"
    && symbol.namespace == "value"
    && symbol.itemKind == "constructor" then
    Just (done ())
  else
    Nothing
