import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { Editorial } from "../model"
import { CorrectionCopy } from "../correction-model"
fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  [Paragraph ([Words (localized en ja)]) | (en, ja) <- arrays.zip japanese english]
fn link title: String -> route: String -> english: String -> japanese: String -> Block =
  Paragraph (
    [
      InternalLink (localized title title, route),
      Words (localized (": " + english) ("：" + japanese))
    ]
  )
fn sequences -> Block = Paragraph (
  [
    InternalLink (
      localized "Tuples, arrays, and lists" "タプル・配列・リスト",
      "/docs/language/data/tuples-arrays-and-lists/"
    ),
    Words (
      localized ": compare the literal spelling and types of an Array and a List."
        "：ArrayとListの値の書き方と型の違いを確認できます。"
    )
  ]
)
fn related identity: String -> Array<Block> =
  if identity == "std/map::Map" then
    [
      link "std/map" "/docs/library/map/"
        "Choose how to construct, look up or update a table." "表を作る・検索する・更新する操作を選べます。",
      link "fromEntries" "/docs/library/map/function/fromentries/"
        "Build a table from key/value pairs." "キーと値の組から表を作れます。",
      link "get" "/docs/library/map/function/get/"
        "Read a value and handle an absent key." "値を読み、キーがない場合も扱えます。",
      link "insert" "/docs/library/map/function/insert/"
        "Update one entry while keeping the earlier table." "元の表を残して一件を更新できます。"
    ]
  else if identity == "std/set::Set" then
    [
      link "std/set" "/docs/library/set/"
        "Choose a construction or membership operation." "集合を作る操作や要素の有無を調べる操作を選べます。",
      link "fromIterable" "/docs/library/set/function/fromiterable/"
        "Remove duplicates while constructing a Set." "Setを作るときに重複をまとめられます。",
      link "insert" "/docs/library/set/function/insert/"
        "Keep the earlier Set when adding a member." "要素を加えても元のSetを残せます。",
      sequences ()
    ]
  else if identity == "std/non-empty-list::NonEmptyList" then
    [
      link "std/non-empty-list" "/docs/library/non-empty-list/"
        "Choose operations that use a guaranteed first element." "必ずある先頭要素を使う操作を選べます。",
      link "fromList" "/docs/library/non-empty-list/function/fromlist/"
        "Check a possibly empty List." "空かもしれないListを確認できます。",
      link "cons" "/docs/library/non-empty-list/function/cons/"
        "Construct a value from a head and a List tail." "先頭と残りのListから値を作れます。",
      link "tail" "/docs/library/non-empty-list/function/tail/"
        "Read the remainder, which may be empty." "空になることもある残りのListを読めます。",
      sequences ()
    ]
  else if identity == "std/prelude::Iterator" then
    [
      link "std/iterator" "/docs/library/iterator/"
        "Choose how to construct or read a sequence position." "数列の位置を作る・読む操作を選べます。",
      link "unfold" "/docs/library/iterator/function/unfold/"
        "Construct an Iterator from a state and a step." "状態と次の値を決める関数からIteratorを作れます。",
      link "next" "/docs/library/iterator/function/next/"
        "Read one value and the separate Iterator for the rest."
        "一件の値と、続き用の別のIteratorを読めます。",
      link "reduceUntil" "/docs/library/collection/function/reduceuntil/"
        "Stop a traversal when its callback returns Done." "渡した関数がDoneを返したら走査を止められます。"
    ]
  else if identity == "std/collection::SizeError"
    || identity == "std/collection::NonPositiveSize" then
    [
      link "std/collection" "/docs/library/collection/"
        "Find the shared collection types and operations." "コレクションで共通に使う型と操作を確認できます。",
      if identity == "std/collection::SizeError" then
        link "NonPositiveSize" "/docs/library/collection/constructor/nonpositivesize/"
        "Construct or read the reason's integer payload." "理由が持つ整数を指定したり読み取ったりできます。"
      else
        link "SizeError" "/docs/library/collection/opaque-type/sizeerror/"
        "Read the type returned as the failure reason." "失敗理由として返る型を確認できます。",
      link "chunksOf" "/docs/library/array/function/chunksof/"
        "See how Array batching checks its requested size." "Arrayを分割するときのサイズ確認を読めます。",
      link "windows" "/docs/library/list/function/windows/"
        "See the same size policy for overlapping List groups."
        "Listの重なるまとまりでも同じサイズの規則を確認できます。"
    ]
  else
    [
      link "std/collection" "/docs/library/collection/"
        "Choose a collection-wide operation." "複数のコレクションで使う操作を選べます。",
      link "reduceUntil" "/docs/library/collection/function/reduceuntil/"
        "Use the decision in a running calculation." "途中の計算で、続けるか止めるかの判断を使えます。",
      if identity == "std/collection::ReduceStep" then
        link "Next" "/docs/library/collection/constructor/next/"
        "Return the updated total and continue." "更新した合計を返して続けられます。"
      else
        link "ReduceStep" "/docs/library/collection/opaque-type/reducestep/"
        "Read the common type of both decisions." "二つの判断に共通する型を確認できます。",
      if identity == "std/collection::Done" then
        link "Next" "/docs/library/collection/constructor/next/"
        "Choose to continue instead of ending this reduction." "この集計を終えずに続ける場合を確認できます。"
      else
        link "Done" "/docs/library/collection/constructor/done/"
        "Return a final result without processing later elements."
        "後の要素を処理せず、最終結果を返せます。"
    ]
pub fn collectionTypeEditorial identity: String
  -> namespace: String
  -> itemKind: String
  -> slug: String
  -> output: String
  -> typescriptOutput: String
  -> english: CorrectionCopy
  -> japanese: CorrectionCopy
  -> Editorial =
  Editorial {
    identity,
    namespace,
    itemKind,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("using-this-type", localized english.taskTitle japanese.taskTitle),
        Paragraph ([Words (localized english.purpose japanese.purpose)]),
        Paragraph ([Words (localized english.setup japanese.setup)]),
        CodeExample
          ("collection-type-" + slug, localized english.codeTitle japanese.codeTitle),
        Terminal (localized "Seseragi output" "Seseragiの実行結果", output),
        Paragraph (
          [Words (
            localized
          "pub effect fn main is the program entry. do runs its output operations in order. println writes a value and a newline; show turns a value into display text. The collection operations return values; calling them does not itself print."
          "pub effect fn mainはプログラムの実行入口です。doでは出力操作を上から順に実行します。printlnは値と改行を出力し、showは値を表示用の文字列にします。コレクションの操作は結果の値を返し、呼び出すだけでは出力しません。"
          )]
        )
      ],
      paragraphs english.after japanese.after,
      [
        Heading (
          "typescript-comparison",
          localized english.comparisonTitle japanese.comparisonTitle
        ),
        Paragraph
          ([Words (localized english.comparisonBefore japanese.comparisonBefore)]),
        CodeExample
          ("collection-type-" + slug + "-ts", localized "TypeScript" "TypeScript"),
        Terminal (localized "TypeScript output" "TypeScriptの実行結果", typescriptOutput),
        Paragraph ([Words (localized english.comparisonAfter japanese.comparisonAfter)]),
        Heading ("type-rules", localized english.detailTitle japanese.detailTitle)
      ],
      paragraphs english.details japanese.details,
      related identity,
      [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
}
