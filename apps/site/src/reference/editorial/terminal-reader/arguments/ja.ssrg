import { TerminalCopy } from "../model"

pub fn copy -> TerminalCopy = TerminalCopy {
  summary: "argumentsは、プログラムに渡された引数をArray<String>で返します。実行ファイルの名前を含まず、空文字列も一つの引数として残します。",
  taskTitle: "空白や空文字列を含む引数を順に表示する",
  purpose: "alpha、two words、空文字列、--preview、設定という五つの値をコマンドに渡します。各値を角括弧で囲んで表示し、引数がどこで区切られているかを確かめます。",
  typescriptBefore: "Node.jsやBunのTypeScriptではprocess.argv.slice(2)で実行コマンドとエントリーファイルの部分を除き、プログラム用の引数を読みます。空なら案内を出し、それ以外はfor...ofで順に表示します。",
  benefit: "Seseragiのargumentsは、最初からアプリケーション用の値だけを返します。返り値のArray<String>に対して空かどうかを確認し、各文字列をそのまま使えます。読み取りが失敗した場合も明示的に扱います。",
  reading: [
    "process.arguments ()の()は、渡す値のない呼び出しです。成功したRight valuesのvaluesはStringの配列で、実行ファイルやentry.jsのパスを取り除く追加の処理は要りません。",
    "arrays.isEmpty valuesが空かどうかを調べます。空ならNo argumentsを表示し、それ以外はfor value <- valuesで各引数を順番にvalueとして使います。",
    "各行の角括弧は、引数の内容ではなくこのプログラムが加えた目印です。two wordsは一行に、空文字列はArgument: []に、--previewと設定もそれぞれ一行になります。"
  ],
  details: [
    "引数はビルドしたentry.jsをNode.jsかBunで起動するときに渡します。seseragi runはアプリケーション引数を転送しません。ここではreleaseビルドと、そのentry.jsを使う起動コマンドに従います。",
    "起動コマンドの\"two words\"と\"\"はシェルに区切り方を伝える引用符です。プログラムに渡る値に、その引用符自体は含まれません。argumentsが後から空白で文字列を分割するわけではありません。",
    "--previewもただの文字列です。この操作だけではフラグの解釈、必須項目の検査、型への変換は行いません。必要なら受け取った一覧を確認してから処理します。",
    "引数を一つも付けずに起動すると空の配列になり、No argumentsを一行表示します。空文字列の引数を一つ渡した場合とは違います。"
  ]
}
