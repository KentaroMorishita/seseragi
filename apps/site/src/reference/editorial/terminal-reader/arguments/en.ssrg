import { TerminalCopy } from "../model"

pub fn copy -> TerminalCopy = TerminalCopy {
  summary: "arguments returns the program’s application arguments as Array<String>. It excludes the executable name and preserves an empty string as one argument.",
  taskTitle: "Display arguments containing spaces and empty strings",
  purpose: "Pass five values to a command: alpha, two words, an empty string, --preview, and 設定. Display each between brackets to see where one argument ends and the next begins.",
  typescriptBefore: "In Node.js or Bun TypeScript, process.argv.slice(2) removes the runtime command and entry-file portions to obtain the application arguments. Print a message if the array is empty; otherwise, use for...of to display each value in order.",
  benefit: "Seseragi’s arguments returns application values directly. Check whether the resulting Array<String> is empty and use each string as supplied, while explicitly handling a possible read failure.",
  reading: [
    "The () in process.arguments () marks a call with no input value to supply. On success, Right values contains an array of strings; you do not need another step to remove the executable or entry.js path.",
    "arrays.isEmpty values checks for an empty array. If empty, the program prints No arguments. Otherwise, for value <- values visits each argument in order, naming it value for that iteration.",
    "The brackets on each line are markers added by this program, not part of the arguments. two words stays on one line, the empty string prints as Argument: [], and --preview and 設定 each get their own line."
  ],
  details: [
    "Pass arguments when launching the built entry.js with Node.js or Bun. seseragi run does not forward application arguments. Follow the release build and entry.js launch commands shown here.",
    "The quotes in \"two words\" and \"\" tell the shell how to separate arguments; the quotes themselves are not in the values passed to the program. arguments does not split the strings again at spaces.",
    "--preview is an ordinary string. This operation does not parse flags, check required inputs, or convert values to other types. Inspect the returned array before using it if your command needs those steps.",
    "Launching with no arguments returns an empty array and prints one line, No arguments. That differs from passing one empty-string argument."
  ]
}
