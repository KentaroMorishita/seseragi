import { TerminalCopy } from "../model"

pub fn copy -> TerminalCopy = TerminalCopy {
  summary: "printlnは、文字列の後に改行を付けて出力します。処理の完了を一行で知らせるときに使います。",
  taskTitle: "保存が終わったことを一行で知らせる",
  purpose: "ファイルを保存した後に、Saved 3 filesと表示します。次のメッセージは次の行から始めたいので、文字列と改行を一緒に出すprintlnを使います。",
  typescriptBefore: "Node.jsやBunのTypeScriptなら、console.logに文字列を渡すだけです。この短い書き方で同じ一行を出力できます。ここでは端末での出力を比べます。ブラウザーの開発者コンソールは表示方法が異なります。",
  benefit: "Seseragiでは出力をeffect fnの処理として書きます。printlnにはConsoleという出力サービスが必要で、書き込みはConsoleErrorで失敗する可能性があります。短くするためというより、外部への出力を、必要なサービスと失敗も含めて扱える点が利点です。",
  reading: [
    "pub effect fn mainは、プログラムが実行する入出力の処理を定義します。=の右にあるprintlnが、mainを実行したときの処理です。printlnはPreludeに含まれるため、この例にimportは要りません。",
    "println \"Saved 3 files\"は、空白で区切って文字列を一つ渡す呼び出しです。表示する文字列の末尾に改行が加わり、出力はSaved 3 filesという一行になります。"
  ],
  details: [
    "一つの行を複数の出力から組み立てるなら、途中はprint、最後はprintlnにすると改行の位置を決められます。printlnは渡した文字列にすでに改行があっても、末尾にさらに改行を加えます。",
    "数値などをその型の表示規則で出したいときはprintValueも使えます。ただしprintValueは末尾に改行を加えません。文字列を一行出すこの例にはprintlnが合っています。"
  ]
}
