import { editorial as case0 } from "./prelude-println/page"
import { editorial as case1 } from "./prelude-print/page"
import { editorial as case2 } from "./prelude-printvalue/page"
import { editorial as case3 } from "./process-module/page"
import { editorial as case4 } from "./process-type/page"
import { editorial as case5 } from "./process-error/page"
import { editorial as case6 } from "./environment/page"
import { editorial as case7 } from "./arguments/page"
import { editorial as case8 } from "./current-directory/page"
import { ReferenceSymbol } from "../../../model/build"
import { Block } from "../../../model/page"
import { Editorial, editorialBlocks } from "../model"

fn guarded symbol: ReferenceSymbol
  -> owner: String
  -> namespace: String
  -> kind: String
  -> value: Editorial
  -> Maybe<Editorial> =
  if symbol.module == owner
    && symbol.namespace == namespace
    && symbol.itemKind == kind then
    Just value
  else
    Nothing

pub fn terminalReaderEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match symbol.identity {
    "std/prelude::println" -> guarded symbol "std/prelude" "value" "function" (case0 ())
    "std/prelude::print" -> guarded symbol "std/prelude" "value" "function" (case1 ())
    "std/prelude::printValue" -> guarded symbol "std/prelude" "value" "function" (case2 ())
    "std/process::Process" -> guarded symbol "std/process" "type" "opaque-type" (case4 ())
    "std/process::ProcessError" -> guarded symbol "std/process" "type" "opaque-type" (case5 ())
    "std/process::environment" -> guarded symbol "std/process" "value" "effect-function" (case6 ())
    "std/process::arguments" -> guarded symbol "std/process" "value" "effect-function" (case7 ())
    "std/process::currentDirectory" -> guarded symbol "std/process" "value" "effect-function" (case8 ())
    _ -> Nothing
  }

pub fn terminalReaderModuleBlocks specifier: String -> Array<Block> =
  editorialBlocks (match specifier {
    "std/process" -> Just (case3 ())
    _ -> Nothing
  }
)
