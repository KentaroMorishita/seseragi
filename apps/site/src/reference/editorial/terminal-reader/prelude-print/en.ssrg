import { TerminalCopy } from "../model"

pub fn copy -> TerminalCopy = TerminalCopy {
  summary: "print writes a string without adding a newline. Use it when the next write should continue on the same line.",
  taskTitle: "Write a label and its result as one line",
  purpose: "Write the label Status: first, then append the result saved. Keep the line open after the label and end it after writing the result.",
  typescriptBefore: "In Node.js or Bun, process.stdout.write writes text without a newline, and a following console.log can finish the line. process.stdout.write is a standard-output API for these runtimes; it is not available in browser JavaScript.",
  benefit: "Seseragi also lets you separate a partial write from the end of a line. A do block runs print and println in the order shown, making the newline boundary explicit. The output operations also carry their service requirement and possible write failure in their types.",
  reading: [
    "The operations inside do { ... } run from top to bottom. First, print \"Status: \" writes just the label, with no added newline. Then println \"saved\" writes the rest and the ending newline.",
    "The result is one line: Status: saved. The space after the colon belongs to the first string. print does not insert a separating space automatically."
  ],
  details: [
    "Two calls to print do not insert a newline between them. Include any separating text or spaces in the strings you pass. Choose println for a message that should occupy a complete line.",
    "This do block runs its two output operations in order. It does not combine them into a single write protected from output by other concurrent work."
  ]
}
