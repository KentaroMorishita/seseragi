import { TerminalCopy } from "../model"

pub fn copy -> TerminalCopy = TerminalCopy {
  summary: "std/process reads the running program’s environment variables, arguments, and working directory.",
  taskTitle: "Read one startup setting for a command",
  purpose: "Read the mode supplied when a command-line program starts. Begin with one non-secret example environment variable, SESERAGI_DOCS_MODE, and choose preview only when the setting is absent.",
  typescriptBefore: "In Node.js or Bun TypeScript, read process.env.SESERAGI_DOCS_MODE. Testing === undefined distinguishes an absent setting from a present empty string. This small task is concise in TypeScript too.",
  benefit: "Seseragi makes the required Process service explicit. An absent value is represented by Maybe, while a failed read is represented by ProcessError, so missing settings and unsuccessful reads can be handled separately.",
  reading: [
    "import * as process from \"std/process\" makes the module’s names available under the alias process. process.environment \"SESERAGI_DOCS_MODE\" reads only that named setting.",
    "A successful read gives Just mode when a value exists, or Nothing when the setting is absent. A value of preview prints Mode: [preview], while an empty string prints Mode: []. Only Nothing produces Mode: preview (default).",
    "This program reads a setting and prints the result with println. Its main therefore requires both process: process.Process for the read and Console for output."
  ],
  details: [
    "environment reads a named environment variable, arguments reads the values passed to the program, and currentDirectory reads its current working directory. Choose the next operation according to the input you need.",
    "This example runs on the process target. Launch the built entry.js with Node.js or Bun to read that process’s environment, arguments, and working directory. These operations do not read browser page settings.",
    "When displaying settings, choose only names and values that are safe to show. Checking a mode like this does not require printing the entire environment or any credentials."
  ]
}
