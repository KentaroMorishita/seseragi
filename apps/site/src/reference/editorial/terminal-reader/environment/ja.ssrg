import { TerminalCopy } from "../model"

pub fn copy -> TerminalCopy = TerminalCopy {
  summary: "environmentは、名前を指定した環境変数を読みます。値があればJust、未設定ならNothingになり、空文字列も設定済みの値として区別できます。",
  taskTitle: "設定がない場合だけ既定の動作モードを選ぶ",
  purpose: "起動時にSESERAGI_DOCS_MODEが渡されていれば、その値を表示します。未設定の場合だけpreviewを既定値にし、明示的に空文字列が渡された場合は空のまま扱います。",
  typescriptBefore: "Node.jsやBunのTypeScriptではprocess.envの値を読み、=== undefinedで未設定を判定できます。mode || \"preview\"では、設定済みの空文字列まで既定値に変えてしまいます。ここでは未設定だけを選ぶ比較を使います。",
  benefit: "Maybe<String>が、設定済みのJustと未設定のNothingを分けて表します。空文字列かどうかではなく「設定があるか」で分岐でき、読み取りが失敗した場合も別の結果として扱えます。",
  reading: [
    "process.environment \"SESERAGI_DOCS_MODE\"は、名前を一つ渡す呼び出しです。環境変数の一覧を取得するのではなく、この設定だけを読みます。",
    "Right (Just mode)では、読み取りが成功し、値があるので、その文字列をmodeとして使います。previewならMode: [preview]、空文字列ならMode: []です。角括弧はこのプログラムが、空の値も見えるように付けています。",
    "Right Nothingでは読み取りは成功していますが、設定がありません。その場合だけMode: preview (default)と表示します。Left reasonは設定の不在ではなく読み取りの失敗で、show reasonを説明に加えます。"
  ],
  details: [
    "値をStringとして使う前に、JustとNothingを扱います。Maybe<String>は文字列そのものではなく、文字列がある場合とない場合をまとめた型です。",
    "設定が未設定の場合と、値を空文字列にして起動した場合を分けて試せます。空文字列を設定して起動するとMode: []になり、既定値には置き換わりません。",
    "空の設定名やNULを含む名前はInvalidEnvironmentNameによる失敗になります。有効な名前が環境に存在しない場合のNothingとは別です。",
    "この例は秘密でない動作モードだけを表示します。環境変数には認証情報が入ることもあるので、実際のプログラムで読む名前と、画面に出してよい値は意識して選びます。"
  ]
}
