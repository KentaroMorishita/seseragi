import { TerminalCopy } from "../model"

pub fn copy -> TerminalCopy = TerminalCopy {
  summary: "printValue writes a value using its Show display rule. You do not need an explicit string conversion, but it does not add a newline.",
  taskTitle: "Display a file count after a label",
  purpose: "Write the label Files: followed by the integer 3. This example produces Files: 3 without a final newline, building a short status message that includes a number.",
  typescriptBefore: "In Node.js or Bun, process.stdout.write takes a string. Converting the integer with String(3) before writing it produces the same Files: 3 here. process.stdout.write is not a browser API.",
  benefit: "printValue uses the display rule called Show provided for the value’s type. It combines formatting and output in one call while keeping output order, the required service, and possible write failure in an effect operation.",
  reading: [
    "First, print \"Files: \" writes the label with its trailing space. Next, printValue 3 displays the integer on the same line. Neither call adds a newline.",
    "The argument to printValue must have a Show display rule. Here 3 has type Int and displays as 3. The caller does not need to construct a string for that display."
  ],
  details: [
    "printValue does not mean println with a value argument, and it does not always end a line like console.log. If the next output should start on a new line, follow it with a newline through println.",
    "The matching output in this comparison is for the integer 3. Show, TypeScript’s String, and console.log need not use the same formatting for arrays, custom types, or other values."
  ]
}
