import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.appendは二つのArrayをつなぎます。第2引数の要素の後に第1引数の要素が並び、元のArrayは変わりません。",
  taskTitle: "次のタスクを、今あるタスクの後につなぐ",
  purpose: "先にあるReadとReviewの後に、次の作業Shipを並べます。元の二つの一覧も残して、結合後の一覧を作ります。",
  typescriptBefore: "[...firstBatch, ...nextBatch]は、それぞれの要素を左から順に新しい配列へ並べます。firstBatch.concat(nextBatch)でも同じ結果です。どちらも元の配列を変えず、表示の後半でその内容を確認できます。",
  benefit: "Seseragiでも、二つのArrayを残したまま結合できます。appendは後ろに足すArrayを先に受け取るため、続く行では今あるArrayから処理を読む|>の形でも書けます。",
  setup: "itemsはstd/arrayの別名です。letは値に名前を付け、[\"Read\", \"Review\"]はStringの要素を持つArrayを作ります。items.append nextBatch firstBatchは、関数の後へ二つの引数を空白で区切って渡す呼び出しです。",
  after: [
    "appendには、後ろに足すnextBatch、先頭側のfirstBatchの順で渡します。結果はfirstBatchのRead、ReviewにnextBatchのShipを続けたArrayです。呼び出しに書く引数の順と、結果で並ぶ順を区別してください。",
    "firstBatch |> items.append nextBatchの|>は、左の値を右の関数へ渡します。items.append nextBatchは、後ろに足すArrayを決めて、先頭側のArrayを待つ関数です。firstBatchを渡すと最初の呼び出しと同じ結果になります。",
    "[value | value <- ...]は、...の各要素をvalueとして受け取り、同じ順序で表示用のArrayを作る内包表記です。最初の二行は同じ結合結果、後の二行は変わっていないfirstBatchとnextBatchを表示します。",
  ],
  details: [
    "items.append firstBatch nextBatchと引数を逆にすると、Ship、Read、Reviewの順になります。firstBatchの後へ足したい場合は、items.append nextBatch firstBatchと書きます。",
    "片方が空なら、もう片方の要素がそのまま結果に並びます。両方が空なら空のArrayです。同じ値が複数あっても、重複を取り除かずにすべて残します。",
    "二つの引数は同じ要素型のArrayです。Listをそのまま渡すことはできません。二つのListをつなぐときはstd/listのappendを選びます。",
    "appendは元のArrayへ要素を書き足しません。戻り値を使って、結合後の一覧を表示したり次の処理へ渡したりします。すでに複数のArrayを一つにまとめて持っている場合はconcatが使えます。",
  ],
}
