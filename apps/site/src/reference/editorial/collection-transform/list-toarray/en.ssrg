import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.toArray converts a List to an Array. It preserves element values and order so the result can be passed to a function that accepts Array.",
  taskTitle: "Pass tasks to a function that requires Array",
  purpose: "The available tasks are a List, but the rendering helper renderTasks accepts Array<String>. Convert with toArray before calling it, then confirm that the original List remains in the same order.",
  typescriptBefore: "TypeScript can pass a normal array directly to a readonly string[] parameter and display it as JSON. This compares the task of rendering ordered tasks. It does not suggest that JavaScript has a native type or conversion equivalent to Seseragi List.",
  benefit: "Seseragi distinguishes List and Array by type. The toArray call makes the conversion point explicit and supplies the type required by the receiving function. The element strings need no separate conversion.",
  setup: "items is the alias for std/list, and let tasks names a value. The backtick before [ in `[\"Read\", \"Review\", \"Ship\"] creates a List. Brackets without a backtick create an Array, which is a separate type.",
  after: [
    "fn renderTasks tasks: Array<String> -> String declares a function receiving tasks as Array<String> and returning String. The type after : belongs to the parameter; the type after -> is the return type. The expression after = is its body.",
    "let converted: Array<String> = items.toArray tasks passes the List to toArray and names the result converted. : Array<String> checks the result’s type. The annotation alone does not convert anything; the toArray call performs the conversion.",
    "renderTasks converted uses the converted Array. The comprehension [task | task <- tasks] reads each element in order and creates a display Array. Brackets without a backtick create an Array; the last line uses the same display form with the original List.",
    "Both lines show [\"Read\",\"Review\",\"Ship\"]. Although the JSON displays match, converted is Array<String>, and the original tasks is List<String>. The original List’s contents remain available.",
  ],
  details: [
    "Passing the original List with renderTasks tasks does not match the required Array<String>. Pass converted, the result of toArray, instead. Use std/array toList for the opposite conversion from Array to List.",
    "An empty List becomes an empty Array. Multiple elements retain their order, including duplicate values. toArray does not sort or remove duplicates.",
    "The original List’s contents remain unchanged. toArray changes the collection type; it does not serialize the data to JSON or another string format. The later json.encodeString performs the JSON encoding.",
    "The reason for this conversion is to meet renderTasks’ parameter type. Do not read a deep-copy guarantee or a promise of better performance into toArray.",
  ],
}
