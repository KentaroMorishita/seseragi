import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.toArrayはListをArrayへ変換します。要素の値と順序を保ち、Arrayを受け取る関数へ渡せるようにします。",
  taskTitle: "Arrayを受け取る関数へタスクを渡す",
  purpose: "手元のタスクはListですが、表示用のrenderTasksはArray<String>を受け取ります。toArrayで必要な型へ変換して渡し、元のListも同じ順序で残ることを確認します。",
  typescriptBefore: "TypeScriptでは、通常の配列をreadonly string[]の引数へそのまま渡してJSONで表示できます。この比較は順序付きのタスクを表示する作業を示しています。JavaScriptにSeseragiのListと同じ標準の型や、この変換があるという意味ではありません。",
  benefit: "SeseragiではListとArrayを型で区別します。toArrayを使う行で変換の場所を示し、Arrayを要求する関数に合う値を渡せます。要素の文字列を変換し直す必要はありません。",
  setup: "itemsはstd/listの別名で、let tasksは値に名前を付けます。`[\"Read\", \"Review\", \"Ship\"]は[の前のバッククォートでListを作ります。バッククォートなしの[ ... ]はArrayで、Listとは別の型です。",
  after: [
    "fn renderTasks tasks: Array<String> -> Stringは、Array<String>のtasksを受け取り、Stringを返す関数です。:の後が引数の型、->の後が戻り値の型で、=の右側が実行する式です。",
    "let converted: Array<String> = items.toArray tasksは、ListをtoArrayへ渡して結果にconvertedと名前を付けます。: Array<String>は結果の型を確認する指定です。型の指定だけで変換するのではなく、toArrayの呼び出しが変換を行います。",
    "renderTasks convertedは変換後のArrayを使います。[task | task <- tasks]は各要素を順に読み、表示用のArrayを作る内包表記です。バッククォートのない角括弧なのでArrayを作り、最後の行では元のListからも同じ形の表示を作れます。",
    "二行とも[\"Read\",\"Review\",\"Ship\"]を表示します。JSONの表示が同じでも、convertedの型はArray<String>、元のtasksの型はList<String>です。元のListの内容も残っています。",
  ],
  details: [
    "renderTasks tasksと元のListを直接渡すと、要求されたArray<String>と型が合いません。toArrayで変換したconvertedを渡してください。逆にArrayからListが必要ならstd/arrayのtoListを使います。",
    "空のListは空のArrayになります。複数の要素は同じ順序で移り、重複した値もそのまま残ります。toArrayは並べ替えや重複の除去を行いません。",
    "変換後も元のListの内容は変わりません。toArrayはコレクションの型を変える操作で、JSONなどの文字列へ保存する操作ではありません。JSONへの変換は、後のjson.encodeStringが担当します。",
    "この例で変換する理由はrenderTasksの引数の型に合わせるためです。要素を深くコピーする保証や、常に高速になるという保証をtoArrayの意味に含めないでください。",
  ],
}
