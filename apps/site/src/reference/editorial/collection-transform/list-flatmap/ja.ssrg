import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.flatMapは各要素からListを作り、そのListを一段だけつなぎます。入力の順序と、各Listの中の順序を保ちます。",
  taskTitle: "グループのタスクを一つの一覧に集める",
  purpose: "Today、Waiting、Tomorrowの各グループからtasksを取り出します。Waitingにはタスクがありません。ほかのタスクを順につなぎ、Read、Review、Shipを表示します。",
  typescriptBefore: "通常の配列ではgroups.flatMap(group => group.tasks)で、各オブジェクトからtasksを取り出して一段つなげます。空のtasksからは何も増えません。同じ作業を比べており、JavaScriptの配列とSeseragiのListを同じデータ構造として扱う例ではありません。",
  benefit: "Seseragiでも、取り出し方を一つの関数として渡せます。関数が返すList<String>の要素をつなぐため、結果はList<List<String>>ではなく、一つのList<String>です。",
  setup: "itemsはstd/listの別名です。struct Groupはtitle: Stringとtasks: List<String>を持つレコードの型を定義し、Group { ... }で値を作ります。let groupsは三つのGroupを並べたListに名前を付けます。groupsと各tasksの[の前にあるバッククォートはListを作る印です。",
  after: [
    "\\group -> group.tasksは、groupを一件受け取り、そのtasksフィールドを返す名前のない関数です。\\が引数の始まり、->の右側が返す値を表します。items.flatMapには、この関数、groupsの順で渡します。",
    "Todayから`[\"Read\", \"Review\"]、Waitingから`[]、Tomorrowから`[\"Ship\"]を受け取り、順につなぎます。Waitingも関数へ渡されますが、返ったListが空なので結果に要素は増えません。",
    "[value | value <- ...]は、flatMapの結果を一件ずつvalueとして読み、表示用のArrayを作る内包表記です。バッククォートのない角括弧なのでArrayですが、flatMap自体の結果はListです。JSON表示は[\"Read\",\"Review\",\"Ship\"]で、グループのtitleは含みません。",
  ],
  details: [
    "関数は先頭から各Groupに一回ずつ適用されます。各結果の要素は元の順に並び、groupsや各tasksの内容は変わりません。空のgroupsでは関数を呼ばず、空のListを返します。この例の関数はフィールドを読むだけで、外部の処理は行いません。",
    "つなぐのは関数が返したListの一段です。二つの入力からそれぞれ`[`[1], `[11]]と`[`[2], `[12]]が返る場合、結果は`[`[1], `[11], `[2], `[12]]です。さらに内側のListはそのまま残ります。",
    "関数はListを返す必要があります。group.titleのStringだけを返すと型が合いません。一つのタイトルを加えたいなら`[group.title]を返してください。バッククォートなしの[group.title]はArrayなので、このList用のflatMapには合いません。",
    "すでにList<List<String>>を持っていて、各要素を変換する必要がなければconcatを使えます。一件から最大一つの値を採用し、欠けた結果をNothingで表したい場合はfilterMapを選びます。",
  ],
}
