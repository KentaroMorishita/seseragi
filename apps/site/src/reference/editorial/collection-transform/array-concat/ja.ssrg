import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.concatはArrayの中のArrayを一段だけつなぎます。外側と内側の順序を保ち、空のArrayからは要素を追加しません。",
  taskTitle: "分かれたタスクの一覧を一つにまとめる",
  purpose: "Readの一覧、空の一覧、ReviewとShipの一覧を順につなぎます。三つのまとまりから、Read、Review、Shipが並ぶ一つのArrayを作ります。",
  typescriptBefore: "batches.flat()は、入れ子の配列を一段だけ平らにします。途中の空の配列からは要素が増えず、ほかの要素は元の順序で並びます。この作業にはTypeScriptでも短い一行で十分です。",
  benefit: "Seseragiのconcatも、すでにまとまっている複数のArrayを一つにします。入力はArray<Array<String>>、結果はArray<String>なので、取り除く入れ子が一段だと型からも読み取れます。",
  setup: "itemsはstd/arrayの別名で、let batchesはタスクのまとまりに名前を付けます。外側の[ ... ]の各要素もArrayです。真ん中の[]は空のArrayで、前後のまとまりの間に置いています。",
  after: [
    "items.concat batchesは、関数名の後へbatchesを空白で区切って渡します。最初の[\"Read\"]、空の[]、最後の[\"Review\", \"Ship\"]から順に要素を取り出すので、結果は[\"Read\",\"Review\",\"Ship\"]です。",
    "[value | value <- ...]は、concatの結果から各要素をvalueとして受け取り、表示用のArrayを作る内包表記です。要素の順序や値は変えず、そのArrayをJSONで表示します。",
    "concatはbatches自体や、その中のArrayを変更しません。結合した結果を戻り値として受け取り、表示や次の処理に使います。",
  ],
  details: [
    "取り除く入れ子は一段です。たとえば[[[1], [2]], [], [[3]]]を渡すと、結果は[[1], [2], [3]]になります。内側の[1]、[2]、[3]まで自動的に整数へほどく操作ではありません。",
    "外側が空なら、結果も空のArrayです。中身が空のArrayばかりでも、結果は空になります。同じ値が複数のまとまりにあれば、その回数だけ残ります。",
    "concatにはArrayを要素とするArrayが必要です。[1, 2, 3]のような整数だけのArrayは渡せません。型が合わない場合は、入力がすでに一つの一覧になっていないか確認してください。",
    "二つのArrayだけをつなぐならappend、レコードから各Arrayを取り出してつなぐならflatMapを使えます。concat自身には取り出し方を決める関数を渡しません。",
  ],
}
