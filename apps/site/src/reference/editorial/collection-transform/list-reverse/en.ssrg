import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.reverse returns a List with its elements in reverse order. It leaves the original List’s order unchanged.",
  taskTitle: "Show newest tasks first while keeping the original order",
  purpose: "Display the oldest-first list Read, Review, Ship with the newest task first. Then display the original List so its stored order remains available too.",
  typescriptBefore: "For normal arrays, [...oldestFirst].reverse() reverses a copy. JavaScript reverse() changes the array it is called on, so the copy preserves the original array. This compares the display task without reproducing List’s internal representation.",
  benefit: "Seseragi reverse returns a List without changing its input List. There is no need to write a protective copy first to keep the original list when changing the display order.",
  setup: "items is the alias for std/list, and let oldestFirst names a value. The backtick before [ in `[\"Read\", \"Review\", \"Ship\"] creates a List; without it, the brackets create an Array. items.reverse oldestFirst calls the function with one List.",
  after: [
    "The first output uses the return value of items.reverse oldestFirst. Ship moves from last to first, followed by Review and then Read. The characters within each string are unchanged.",
    "The next line reads oldestFirst directly. Its order remains Read, Review, Ship, so both the reversed view and the original order are available.",
    "The comprehension [value | value <- ...] takes each element as value and creates a display Array. These brackets have no backtick. The reverse result remains a List; the comprehension puts its elements into an Array to show their order as JSON.",
  ],
  details: [
    "Reversing an empty List gives an empty List. A one-element List keeps that element, and repeated values are retained when their order is reversed.",
    "reverse does not compare dates or string values. This example becomes newest-first because its input is already oldest-first. Unordered timestamps need an operation that sorts by time instead.",
    "Calling reverse without using its return value does not change oldestFirst. Name the returned value or pass it to the next operation, as this example does.",
    "This function accepts a List. Use std/array reverse to reverse the order of an Array.",
  ],
}
