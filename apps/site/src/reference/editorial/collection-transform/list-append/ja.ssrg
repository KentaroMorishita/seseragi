import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.appendは二つのListをつなぎます。第2引数の要素の後に第1引数の要素が並び、元のListは変わりません。",
  taskTitle: "次のタスクを、今あるタスクの後につなぐ",
  purpose: "先にあるReadとReviewの後に、次の作業Shipを並べます。元の二つのListも残して、結合後の一覧を作ります。",
  typescriptBefore: "通常の配列では、[...firstBatch, ...nextBatch]やfirstBatch.concat(nextBatch)で二つの一覧をつなげます。どちらも元の配列を変えません。同じ作業を比べるために配列を使っており、SeseragiのListと同じデータ構造を再現しているわけではありません。",
  benefit: "Seseragiでも、二つのListを残したまま結合できます。appendは後ろに足すListを先に受け取るため、続く行では今あるListから処理を読む|>の形でも書けます。",
  setup: "itemsはstd/listの別名です。letは値に名前を付けます。`[\"Read\", \"Review\"]のように[の前へバッククォートを付けるとListを作ります。付けずに[\"Read\", \"Review\"]と書くと別の型のArrayになります。",
  after: [
    "items.append nextBatch firstBatchは、関数の後へ引数を空白で区切って渡す呼び出しです。後ろに足すnextBatchが第1引数、先頭側のfirstBatchが第2引数なので、結果はRead、Review、Shipの順になります。",
    "firstBatch |> items.append nextBatchの|>は、左の値を右の関数へ渡します。items.append nextBatchは、後ろに足すListを決めて、先頭側のListを待つ関数です。firstBatchを渡すと最初の呼び出しと同じ結果になります。",
    "[value | value <- ...]は各要素をvalueとして受け取り、表示用のArrayを作る内包表記です。この角括弧にはバッククォートがありません。appendの結果はListのままで、JSONで要素順を見せるときだけArrayに並べています。",
    "最初の二行は同じ結合結果を表示します。後の二行にはfirstBatchのRead、ReviewとnextBatchのShipがそれぞれ残り、元のListが変わっていないことを確認できます。",
  ],
  details: [
    "items.append firstBatch nextBatchと引数を逆にすると、Ship、Read、Reviewの順になります。firstBatchの後へ足したい場合は、items.append nextBatch firstBatchと書きます。",
    "片方が空なら、もう片方の要素がそのまま結果に並びます。両方が空なら空のListです。同じ値が複数あっても、重複を取り除かずにすべて残します。",
    "二つの引数は同じ要素型のListです。Arrayをそのまま渡すことはできません。二つのArrayをつなぐときはstd/arrayのappendを選びます。",
    "appendは元のListへ要素を書き足しません。戻り値を使って、結合後の一覧を表示したり次の処理へ渡したりします。すでに複数のListを一つにまとめて持っている場合はconcatが使えます。",
  ],
}
