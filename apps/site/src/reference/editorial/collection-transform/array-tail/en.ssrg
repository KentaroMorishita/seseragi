import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.tail returns Just containing an Array without its first element. Empty input gives Nothing; one-element input gives Just containing an empty Array.",
  taskTitle: "Remove the first task and distinguish an already-empty input",
  purpose: "Read what remains after processing one task. Distinguish “there were no tasks” from “removing the last task left none,” using empty, one-element, and three-element inputs.",
  typescriptBefore: "The TypeScript tail helper returns undefined for empty input, or slice(1) otherwise. T stands for the element type, and readonly T[] | undefined means either an array or no value. slice(1) alone returns [] for both empty and one-element inputs, losing the distinction needed here.",
  benefit: "Seseragi tail uses Maybe<Array<String>> to distinguish a remainder from having no first element to remove. Even an empty remainder is returned in Just, recording that the input had a first element.",
  setup: "items is the alias for std/array. fn describe value: Maybe<Array<String>> -> String declares a function receiving the tail result as value and returning a display String. Maybe means either Just containing a value or Nothing without one.",
  after: [
    "match value selects the branch for the result. Nothing -> \"missing\" returns the text for empty input. The Just rest branch names the contained Array rest and puts its displayed contents after \"present: \".",
    "items.empty<String> () creates an empty Array<String>. <String> specifies the element type, and () is the Unit value passed to empty. Its tail is Nothing, displayed as missing. The tail of [\"Read\"] is Just [], displayed as present: [].",
    "The tail of [\"Read\", \"Review\", \"Ship\"] is Just [\"Review\", \"Ship\"]. The comprehension [value | value <- rest] creates a display Array with rest’s elements in order, so the final line is present: [\"Review\",\"Ship\"].",
  ],
  details: [
    "The result is Maybe<Array<String>> and cannot be used directly as Array<String>. Use match to decide what happens for Nothing and work with the remaining Array in the Just branch.",
    "Just [] means there was a first element but the remainder is empty. Nothing means the input was empty, so there was no first element to remove. Keep these separate when the application needs that distinction.",
    "tail returns the result of removing exactly one leading element, without changing the input. It preserves the remaining values and their order; it does not mean reading only the last element.",
    "Use drop when you only need an Array after skipping a specified count, without distinguishing an originally empty input. Use head to read the first value itself.",
  ],
}
