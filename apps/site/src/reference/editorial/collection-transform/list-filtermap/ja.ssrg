import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.filterMapは各要素を変換し、Justの中の値を順に集めます。Nothingは結果に加えず、Just 0の0は残します。",
  taskTitle: "件数に変換できた値だけを残す",
  purpose: "文字列の2、oops、0、3から、整数に変換できた2、0、3をListに集めます。変換できない入力は飛ばしますが、件数0は有効な結果として残します。",
  typescriptBefore: "通常の配列ではNumberで変換し、Number.isIntegerがtrueなら[count]、それ以外なら[]をflatMapから返します。この四つの入力で成功した変換を集める作業の比較で、Listの表現の再現ではありません。Numberが受け付ける表記や数値範囲も、SeseragiのIntの解析規則とは異なります。",
  benefit: "Seseragiでは、変換の関数が「一つ残す」か「残さない」かをMaybe<Int>で返します。filterMapがJustの中身だけをList<Int>に集めるので、0を真偽値として誤って落とさずに扱えます。",
  setup: "itemsはstd/list、intsはstd/intの別名です。let inputsは値に名前を付けます。`[\"2\", \"oops\", \"0\", \"3\"]の[の前のバッククォートでListを作り、バッククォートがなければArrayになります。",
  after: [
    "fn parseCount value: String -> Maybe<Int>は、文字列valueを受け取り、整数があればJust、なければNothingを返す関数です。ints.parse valueはEitherを返し、成功は整数を持つRight count、失敗はエラー情報を持つLeftで表します。",
    "matchは結果に合う枝を選びます。Right count -> Just countで整数を残し、Left _ -> Nothingで失敗した入力を外します。_はエラー情報を使わない印です。items.filterMap parseCount inputsには、この変換の関数、入力Listの順で渡します。",
    "\"oops\"からのNothingは結果に入りません。その後の\"0\"はJust 0になるため残り、\"3\"の変換も続きます。結果はList<Int>で、JustやNothingを要素として並べたListではありません。",
    "[value | value <- ...]は、各要素をvalueとして読み、表示用のArrayを作る内包表記です。この角括弧にはバッククォートがありません。Listの結果をJSONで表示すると[2,0,3]となり、次の行には変わっていない元の四つの文字列が並びます。",
  ],
  details: [
    "変換の関数は先頭から各入力に一回ずつ適用され、採用された値もその順に並びます。入力が空なら関数を呼ばず、空のListを返します。すべてNothingでも結果は空です。この例の関数は値を返すだけで、表示や外部の処理は行いません。",
    "filterMapに渡す関数の戻り値はMaybeです。Intをそのまま返す関数や、Eitherを返すints.parseは直接渡せません。例のparseCountでRightをJustへ、LeftをNothingへ変えています。",
    "この例では解析エラーの詳細を捨てています。どの入力がなぜ失敗したかも表示したい場合は、入力とEitherの結果を残す処理を選んでください。Nothingを省く規則は、例外やEffectの失敗を自動的に捕まえる規則ではありません。",
    "Justの値なら0も空文字列もFalseも残ります。採用するかどうかはJustとNothingで決まり、中身を真偽値へ変換して判断しません。",
  ],
}
