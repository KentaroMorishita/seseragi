import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.toListはArrayをListへ変換します。要素の値と順序を保ち、Listを受け取る関数へ渡せるようにします。",
  taskTitle: "Listを受け取る関数へタスクを渡す",
  purpose: "手元のタスクはArrayですが、表示用のrenderTasksはList<String>を受け取ります。toListで必要な型へ変換して渡し、元のArrayも同じ順序で残ることを確認します。",
  typescriptBefore: "TypeScriptでは、通常の配列をreadonly string[]の引数へそのまま渡してJSONで表示できます。この比較は順序付きのタスクを表示する作業を示しています。JavaScriptにSeseragiのListと同じ標準の型や、この変換があるという意味ではありません。",
  benefit: "SeseragiではArrayとListを型で区別します。toListを使う行で変換の場所を示し、Listを要求する関数に合う値を渡せます。要素の文字列を変換し直す必要はありません。",
  setup: "itemsはstd/arrayの別名で、let tasksは[\"Read\", \"Review\", \"Ship\"]というArrayに名前を付けます。Listも複数の要素を順に持つ型ですが、Arrayとは別の型です。Listの値を直接書く場合は[の前にバッククォートを付けます。",
  after: [
    "fn renderTasks tasks: List<String> -> Stringは、List<String>のtasksを受け取り、Stringを返す関数です。:の後が引数の型、->の後が戻り値の型で、=の右側が実行する式です。",
    "let converted: List<String> = items.toList tasksは、ArrayをtoListへ渡して結果にconvertedと名前を付けます。: List<String>は結果の型を確認する指定です。型の指定だけで変換するのではなく、toListの呼び出しが変換を行います。",
    "renderTasks convertedは変換後のListを使います。その中の[task | task <- tasks]は、Listの各要素を順に読み、表示用のArrayを作る内包表記です。バッククォートのない角括弧なので、この表示用の値はArrayです。",
    "最後の行は元のArrayを表示します。二行とも[\"Read\",\"Review\",\"Ship\"]ですが、JSONの表示が同じでも、convertedの型はList<String>、元のtasksの型はArray<String>です。",
  ],
  details: [
    "renderTasks tasksと元のArrayを直接渡すと、要求されたList<String>と型が合いません。toListで変換したconvertedを渡してください。逆にListからArrayが必要ならstd/listのtoArrayを使います。",
    "空のArrayは空のListになります。複数の要素は同じ順序で移り、重複した値もそのまま残ります。toListは並べ替えや重複の除去を行いません。",
    "変換後も元のArrayの内容は変わりません。toListはコレクションの型を変える操作で、JSONなどの文字列へ保存する操作ではありません。JSONへの変換は、後のjson.encodeStringが担当します。",
    "この例で変換する理由はrenderTasksの引数の型に合わせるためです。要素を深くコピーする保証や、常に高速になるという保証をtoListの意味に含めないでください。",
  ],
}
