import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.reverse returns an Array with its elements in reverse order. It leaves the original Array’s order unchanged.",
  taskTitle: "Show newest tasks first while keeping the original order",
  purpose: "Display the oldest-first list Read, Review, Ship with the newest task first. Then display the original list so its stored order remains available too.",
  typescriptBefore: "[...oldestFirst].reverse() first copies the elements into a new array, then reverses that array. JavaScript reverse() changes the array it is called on, so the copy in this example preserves the original oldestFirst.",
  benefit: "Seseragi reverse returns a result without changing its input Array. There is no need to write a protective copy first to keep the original list when changing the display order.",
  setup: "items is the alias for std/array. let oldestFirst names an Array of Strings. items.reverse oldestFirst calls the function with one Array after its name; the result is also Array<String>.",
  after: [
    "The first output uses the return value of items.reverse oldestFirst. Ship moves from last to first, followed by Review and then Read. The characters within each string are unchanged.",
    "The next line reads oldestFirst directly. Its order remains Read, Review, Ship, so both the reversed view and the original order are available.",
    "The comprehension [value | value <- ...] takes each element as value and creates a display Array. Whether given the original or reversed result, it displays JSON in that collection’s current element order.",
  ],
  details: [
    "Reversing an empty Array gives an empty Array. A one-element Array keeps that element, and repeated values are retained when their order is reversed.",
    "reverse does not compare dates or string values. This example becomes newest-first because its input is already oldest-first. Unordered timestamps need an operation that sorts by time instead.",
    "Calling reverse without using its return value does not change oldestFirst. Name the returned value or pass it to the next operation, as this example does.",
    "This function accepts an Array. Use std/list reverse to reverse the order of a List.",
  ],
}
