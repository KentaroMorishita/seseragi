import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.reverseはArrayの要素を逆順にしたArrayを返します。元のArrayの順序は変えません。",
  taskTitle: "元の順序を残して、新しいタスクから表示する",
  purpose: "古い順にRead、Review、Shipが入った一覧を、新しい順に表示します。保存してある順序も使えるように、元の一覧を続けて表示します。",
  typescriptBefore: "[...oldestFirst].reverse()は、まず要素を新しい配列へコピーし、その配列を反転します。JavaScriptのreverse()は呼び出した配列を変更するため、元のoldestFirstを残すには、この例のコピーが必要です。",
  benefit: "Seseragiのreverseは結果を返し、入力のArrayを変えません。表示する順序を変えるために、元の一覧を保護するコピーを先に書く必要はありません。",
  setup: "itemsはstd/arrayの別名です。let oldestFirstはStringのArrayに名前を付けます。items.reverse oldestFirstは、関数名の後にArrayを一つ渡す呼び出しで、結果もArray<String>です。",
  after: [
    "最初の表示はitems.reverse oldestFirstの戻り値を使います。最後にあったShipが先頭になり、次はReview、最後はReadです。文字列そのものの文字順は変わりません。",
    "次の行はoldestFirstをそのまま読みます。Read、Review、Shipの順が残るので、逆順の表示と元の順序の表示を両方作れます。",
    "[value | value <- ...]は、各要素をvalueとして受け取り、表示用のArrayを作る内包表記です。元の値でも反転後の値でも、その時点の要素順でJSONを表示します。",
  ],
  details: [
    "空のArrayを反転すると空のArrayです。一要素なら同じ一要素が返り、同じ値が複数あれば重複したまま逆順に並びます。",
    "reverseは日付や文字列の大小を調べません。この例で新しい順になるのは、入力がすでに古い順だからです。ばらばらの日時から順序を決めたい場合は、日時で並べ替える処理が必要です。",
    "戻り値を使わずにreverseを呼んでも、oldestFirstは変わりません。反転した結果に名前を付けるか、この例のように次の処理へ渡してください。",
    "この関数はArrayを受け取ります。Listの順序を反転する場合はstd/listのreverseを使います。",
  ],
}
