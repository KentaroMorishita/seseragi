import { CollectionTransformCopy } from "../model"

pub fn copy -> CollectionTransformCopy = CollectionTransformCopy {
  summary: "items.tailは先頭を除いたListをJustで返します。入力が空ならNothing、一要素なら空のListを持つJustです。",
  taskTitle: "先頭のタスクを除き、最初から空だった場合も分ける",
  purpose: "一件処理した後の残りを読みます。「もともと一件もなかった」と「最後の一件を除いて空になった」を区別し、空、一要素、三要素の入力で確認します。",
  typescriptBefore: "通常の配列用にtailを定義し、空ならundefined、それ以外ならslice(1)を返します。Tは要素の型で、readonly T[] | undefinedは配列か値なしのどちらかです。slice(1)だけでは空と一要素を区別できません。この配列は作業を比べるためのもので、SeseragiのListの表現とは異なります。",
  benefit: "Seseragiのtailは、先頭を除けた結果と、入力が空で先頭を除けなかった結果をMaybe<List<String>>で分けます。残りが空でもJustとして受け取るため、入力に先頭があったことが分かります。",
  setup: "itemsはstd/listの別名です。`[\"Read\"]の[の前にあるバッククォートでListを作り、付けずに書けばArrayになります。fn describe value: Maybe<List<String>> -> Stringは、tailの結果をvalueで受け取り、表示用のStringを返す関数です。",
  after: [
    "Maybeは値を持つJustか、値のないNothingを表します。match valueは結果に合う枝を選びます。Nothingの枝は\"missing\"を返し、Just restの枝は中のListをrestと名付けて\"present: \"の後へ内容をつなぎます。",
    "items.empty<String> ()は空のList<String>を作ります。<String>は要素の型、()はemptyへ渡すUnitの値です。そのtailはNothingなのでmissingになります。`[\"Read\"]のtailはJust `[]なのでpresent: []です。",
    "`[\"Read\", \"Review\", \"Ship\"]のtailはJust `[\"Review\", \"Ship\"]です。[value | value <- rest]は各要素を順に並べる内包表記で、バッククォートがないため表示用のArrayを作ります。残りのListをJSON表示にした最終行はpresent: [\"Review\",\"Ship\"]です。",
  ],
  details: [
    "このtailの結果はMaybe<List<String>>で、そのままList<String>としては使えません。matchでNothingの場合を決め、Justの枝で残りのListを使ってください。",
    "Just `[]は「先頭はあったが、残りは空」という結果です。Nothingは「入力が空で、除く先頭がなかった」という結果なので、二つを同じ状態と決めつけないようにします。",
    "出力の[]はJSONの表示です。Justの中身がArrayに変わったという意味ではありません。入力が空でなければ、tailは先頭を一件除いたListをJustで返します。空ならNothingです。入力を変えず、残った要素の値と順序を保ちます。",
    "入力が空だったかを分けず、指定した件数を飛ばしたListだけが必要ならdropを使えます。先頭の値そのものを読みたい場合はheadを選びます。",
  ],
}
