import { ApiCopy, Editorial } from "./model"
import { localized } from "../../model/locale"
import {
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../model/page"

pub fn listEditorial identity: String
  -> exampleId: String
  -> output: String
  -> english: ApiCopy
  -> japanese: ApiCopy
  -> Editorial =
  Editorial {
    identity,
    namespace: "value",
    itemKind: "function",
    summary: localized english.summary japanese.summary,
    blocks: [
      Heading ("using-this-operation", localized "Use this operation" "この操作を使う"),
      Paragraph ([Words (localized english.purpose japanese.purpose)]),
      Paragraph (
        [Words (
          localized
            "import * as lists names std/list as lists. A leading backtick makes `[10, 20] a List; [10, 20] alone is an Array. let names a value. Function calls separate arguments with spaces. In fn positive value: Int -> Bool, the colon gives the input type and -> gives the result type; = introduces the expression that returns the result. The examples name their functions for the task at hand."
            "import * as listsはstd/listをlistsという名前で読み込みます。先頭のバッククォートで`[10, 20]はListになり、[10, 20]だけならArrayです。letは値に名前を付けます。関数呼び出しの引数は空白で区切ります。fn positive value: Int -> Boolなら、:の後が入力の型、->の後が結果の型で、=の後の式が結果を返します。例では目的に合った名前を関数に付けています。"
        )]
      ),
      CodeExample
            (exampleId, localized "Complete program and boundary cases" "完全なプログラムと境界の例"),
      Paragraph (
        [Words (
          localized
            "pub effect fn main is the entry function. do runs these output operations in order. println displays a value and adds a newline; show turns a collection or other value into display text. List<Int> means a List of integers. lists.empty<Int> () calls the empty-list function with Unit, spelled (), and supplies its element type explicitly. A record List may instead use a named type annotation for its empty value. The List operations themselves do not print or modify the input."
            "pub effect fn mainは実行入口です。doの中で出力操作を順に実行します。printlnは値を表示して改行し、showはコレクションなどの値を表示用の文字列にします。List<Int>は整数のListです。lists.empty<Int> ()は、意味のある入力を持たないUnitの値()を渡し、要素の型をIntと明示して空のListを作ります。レコードのListでは、空の値を持つ名前に型を付ける書き方もあります。Listの操作自体は出力も入力の変更もしません。"
        )]
      ),
      Terminal (localized "Output" "実行結果", output),
      Heading ("reading-the-example", localized "Read the example" "例を順に読む"),
      Paragraph ([Words (localized english.reading japanese.reading)]),
      Paragraph ([Words (localized english.boundaries japanese.boundaries)]),
      Heading ("operation-rules", localized "Rules and cost" "規則と処理量"),
      Paragraph ([Words (localized english.rules japanese.rules)]),
      Heading
            ("operation-mistakes", localized "Choose the right operation" "使い分けと間違いやすい点"),
      Paragraph ([Words (localized english.mistake japanese.mistake)]),
      Paragraph (
        [InternalLink (
          localized "Use a present value or handle absence" "値がある場合とない場合を扱う",
          "/docs/library/list/#consume-maybe"
        )]
      ),
      Paragraph (
        [InternalLink (
          localized "Use success or a size error" "成功した値とサイズの誤りを扱う",
          "/docs/library/list/#consume-either"
        )]
      ),
      Paragraph (
        [
          InternalLink (localized "std/list" "std/list", "/docs/library/list/"),
          Words
            (localized ": choose another operation by its result." "：必要な結果から操作を選べます。")
        ]
      ),
      Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")
    ]
  }
