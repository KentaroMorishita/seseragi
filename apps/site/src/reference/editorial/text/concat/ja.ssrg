import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "文字列の配列を、区切りなしで一つにつなぐ",
  purpose: "複数の文字列をそのまま続けて表示したいときにconcatを使います。引数はArray<String>、つまり文字列を並べた配列一つです。結果は配列ではなく、一つのStringになります。",
  reading: "text.concat [\"A\", \"B\", \"\"]は、左からA、B、空文字列をつなぎ、ABを返します。例では結果を[と]で囲んで出力し、空文字列も目で確認できるようにしています。角括弧はconcatが追加したものではありません。",
  boundaries: "空配列を渡した2行目は空文字列を返すため、囲みだけの[]を表示します。配列内の空文字列も文字を加えません。元の文字列や配列は変更しません。",
  rules: "要素の順番を保ち、区切り文字を入れずにつなぎます。処理量は入力と出力のバイト数に応じます。文字列に含まれる空白や改行を勝手に削除したり、正規化したりしません。",
  mistake: "配列の入れ子を一段平らにするSeseragiのstd/arrayにあるconcatとは戻り値が違います。ここで受け取るのはStringです。要素の間にカンマなどを入れたいならjoinを使ってください。",
}
