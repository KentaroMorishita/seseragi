import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Join an array of strings without a separator",
  purpose: "Use concat to put several strings directly next to each other. Its single argument is Array<String>, an array of strings. The result is one String rather than an array.",
  reading: "text.concat [\"A\", \"B\", \"\"] joins A, B, and the empty string to produce AB. The example surrounds the result with [ and ] so an empty result is visible. concat itself does not add those brackets.",
  boundaries: "The second call receives an empty array and returns an empty string, so only [] is printed. An empty string inside the array also adds no characters. Neither the input strings nor the array is changed.",
  rules: "Elements are joined in source order without a separator. Work depends on input and output byte counts. Whitespace and line endings are neither removed nor normalized automatically.",
  mistake: "Unlike concat in Seseragi’s std/array module, which flattens one array level, this operation returns a String. Use join to insert commas or another separator between entries.",
}
