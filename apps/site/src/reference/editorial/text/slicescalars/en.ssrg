import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Slice a string using a checked scalar range",
  purpose: "Pass the start index, end index, and string in that order. A scalar is one Unicode code-point value. Indexes start at zero; the end scalar is excluded. The result is Right with a successful substring or Left with an invalid-range reason.",
  reading: "Positions one up to but not including three in Aé😀e\\u{301} contain é and 😀, so the first output is slice: [é😀]. The Right part branch names the contained string part and surrounds it with display brackets.",
  boundaries: "Start and end both equal to two form a valid empty range, giving slice: []. End four on a three-scalar input and start two after end one are invalid. The Left error branch displays InvalidScalarRange with the original start and end and actual length. The final range from zero to zero on empty input is a valid empty slice.",
  rules: "A valid range satisfies 0 <= start <= end <= scalar count. Indexes are not silently clamped. The input remains unchanged, and counting and checking the range means constant-time slicing is not guaranteed.",
  mistake: "Use scalar positions, not UTF-8 byte counts or TypeScript UTF-16 indexes. Slicing can separate a combining accent from its base; consider grapheme slicing when preserving user-perceived characters.",
}
