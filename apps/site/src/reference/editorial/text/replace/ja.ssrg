import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "最初に見つかった文字列だけを置き換える",
  purpose: "replaceには探す文字列、置き換える文字列、対象文字列の順で三つの引数を渡します。左から最初の一致だけを置き換えた、新しい文字列を返します。",
  reading: "bananaの最初のaをXにするため、最初の結果はbXnanaです。残りのaはそのままです。すべて置き換えたい場合はreplaceAllを使います。",
  boundaries: "2行目の$&は特別な記号に展開されず、そのまま入るのでc$&tになります。空の検索文字列なら先頭に一度挿入して:ABになります。一致しない4行目はcatのままです。最後の空入力は空文字列になり、囲みだけの[]を表示します。",
  rules: "検索も置換後の文字列もliteral、つまり書いた文字そのものです。元の対象文字列は変更せず、結果を返します。処理量は入力と出力のバイト数に応じます。",
  mistake: "TypeScriptのString.replaceで使える正規表現や$&による一致文字列の参照を想定しないでください。ここでは$&も普通の文字列です。",
}
