import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "指定した位置のUnicode scalarを一つ取り出す",
  purpose: "scalarAtは位置、文字列の順で呼びます。位置は先頭が0のscalar単位です。scalarはUnicodeの番号一つに対応し、見た目の一文字が複数の番号でできる場合もあります。結果のMaybe<Char>は、一つ取り出せたJustと、範囲外だったNothingの二つの場合を表します。",
  reading: "Aé😀e\\u{301}の位置0はA、1はé、2は😀です。atLabelのmatchはJust letterで中のCharにletterという名前を付け、chars.toStringでStringにして表示文へつなぎます。charsはstd/charを読み込んだ名前です。",
  boundaries: "Nothingの分岐はout of rangeを返します。負の位置も、長さと同じ位置も範囲外なので、空文字列も含め、後の3行はこの分岐へ進みます。どちらの場合も処理を用意し、存在しない文字を読もうとしません。",
  rules: "Charは一つのUnicode scalarです。eと結合アクセントのように複数scalarが一つに見える場合、画面の一文字とは一致しません。先頭から数えるため、一定時間での取得は保証しません。",
  mistake: "TypeScriptの文字列の添字が使うUTF-16単位や、lengthBytesのバイト数をそのまま位置へ持ち込まないでください。見た目のまとまりを取り出すならstd/text/graphemeのatを調べます。",
}
