import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "決まった文字列で始まるか調べる",
  purpose: "startsWithには先頭に期待する文字列、対象文字列の順に渡します。対象の先頭だけを比べてBoolを返します。途中に含まれているだけではTrueになりません。",
  reading: "prefixはpreで始まるので最初はTrueです。fixは末尾にはありますが先頭ではないため、2行目はFalseです。",
  boundaries: "空の先頭文字列は空の対象にも一致するので3行目はTrueです。Preとpreは大文字小文字が違うため、最後はFalseになります。",
  rules: "文字列そのものを比較し、正規表現や自動の大文字小文字変換は使いません。入力を変えず、対象と検索文字列の大きさに応じた処理を行います。",
  mistake: "引数を逆にしないでください。期待するprefixが先、調べるtextが後です。入力のどこかに含まれていればよいならcontainsを使います。",
}
