import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Split lines while handling line-ending conventions",
  purpose: "lines splits a string into an array of lines. It treats Windows CRLF as one line ending and preserves empty lines inside the text. json.encodeString displays JSON so empty lines remain visible as quoted strings.",
  reading: "In a\\r\\n\\r\\nb\\n, \\r\\n means CRLF. One empty line separates a and b, producing [\"a\",\"\",\"b\"]. No extra empty entry is appended after the final line ending.",
  boundaries: "An empty string gives [], while one newline, \\n, gives one empty line, [\"\"]. The final \\u{2028} is a Unicode line separator and separates a from b.",
  rules: "Besides CRLF, separators include CR, LF, NEL U+0085, LS U+2028, and PS U+2029. Whitespace within a line is retained. Input stays unchanged; work depends on input and output byte counts.",
  mistake: "This differs from split \"\\n\" in CRLF and trailing-empty-entry handling. Empty text and one empty line are also distinct. Choose the operation matching the input format.",
}
