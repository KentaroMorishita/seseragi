import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "改行の種類を扱いながら行へ分ける",
  purpose: "linesは文字列を行ごとの配列に分けます。WindowsのCRLFを一つの改行として扱い、途中の空行は残します。結果をjson.encodeStringでJSONにして、空の行も引用符で見えるようにしています。",
  reading: "最初の入力a\\r\\n\\r\\nb\\nでは、\\r\\nがCRLFです。aとbの間には空行が一つあり、出力は[\"a\",\"\",\"b\"]です。最後の改行の後ろに、余分な空項目は追加しません。",
  boundaries: "空文字列は[]ですが、改行一個の\\nは空の行一つの[\"\"]になります。最後の\\u{2028}はUnicodeの行区切りで、aとbを別の行に分けます。",
  rules: "CRLFのほか、CR、LF、NEL U+0085、LS U+2028、PS U+2029も区切りです。行の中の空白は削除しません。入力を変更せず、入力と出力のバイト数に応じた処理を行います。",
  mistake: "単純にsplit \"\\n\"する場合とは、CRLFや末尾の空項目の扱いが違います。空文字列と一行の空行も別です。使う入力形式に合わせて選んでください。",
}
