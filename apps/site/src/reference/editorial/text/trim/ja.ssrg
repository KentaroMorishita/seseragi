import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "文字列の両端の空白だけを取り除く",
  purpose: "入力欄の値の前後から空白を外したい場合にtrimを使います。引数は文字列一つで、両端のUnicode White_Spaceに当たる文字を除いた文字列を返します。中の空白は保ちます。",
  reading: "最初の入力は先頭の空白二個、A B、末尾の改行です。\\nは改行を表すため、出力は[A B]になります。外側の[と]は空の結果も見えるように例で付けた目印です。",
  boundaries: "\\u{3000}は全角空白で、2行目は[A]です。空白とタブだけなら空文字列なので[]です。一方、\\u{FEFF}は除去しません。U+FEFFを含む例では、U+FEFF、A、U+FEFFの三つのscalarのままで、長さ3を出力します。scalarはUnicodeの番号一つに対応する単位です。",
  rules: "Unicode White_Spaceという決まった文字の集合で判断し、画面で空白に見える文字を何でも消すわけではありません。入力は変えず、入力と出力のバイト数に応じた処理を行います。",
  mistake: "TypeScriptのString.trimと全ての文字で同じだと想定しないでください。U+FEFFの扱いなど、必要な入力で確認します。前だけならtrimStart、後ろだけならtrimEndです。",
}
