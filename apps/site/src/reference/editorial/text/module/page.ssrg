import { localized } from "../../../../model/locale"
import {
  Block,
  BulletList,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"
pub fn blocks specifier: String -> Array<Block> =
  if specifier != "std/text" then
    []
  else
    [
      Heading ("working-with-text", localized "Choose a text operation" "文字列の操作を選ぶ"),
      Paragraph ([Words (localized (en.purpose ()) (ja.purpose ()))]),
      Paragraph ([Words (localized (en.choose ()) (ja.choose ()))]),
      BulletList (
        [
          [
            InternalLink
              (localized "concat" "concat", "/docs/library/text/function/concat/"),
            Words (
              localized ": Join an array of strings without a separator"
              "：文字列の配列を、区切りなしで一つにつなぐ"
            )
          ],
          [
            InternalLink (localized "join" "join", "/docs/library/text/function/join/"),
            Words (localized ": Join strings with a separator" "：文字列の間に区切りを入れてつなぐ")
          ],
          [
            InternalLink
              (localized "split" "split", "/docs/library/text/function/split/"),
            Words (
              localized ": Split a string into an array using a literal separator"
              "：指定した区切りで文字列を配列へ分ける"
            )
          ],
          [
            InternalLink
              (localized "contains" "contains", "/docs/library/text/function/contains/"),
            Words (
              localized ": Check whether literal text occurs in a string"
              "：文字列がそのまま含まれているか調べる"
            )
          ],
          [
            InternalLink (
              localized "startsWith" "startsWith",
              "/docs/library/text/function/startswith/"
            ),
            Words (localized ": Check a string’s prefix" "：決まった文字列で始まるか調べる")
          ],
          [
            InternalLink
              (localized "endsWith" "endsWith", "/docs/library/text/function/endswith/"),
            Words (localized ": Check a string’s suffix" "：決まった文字列で終わるか調べる")
          ],
          [
            InternalLink
              (localized "replace" "replace", "/docs/library/text/function/replace/"),
            Words (
              localized ": Replace only the first literal occurrence"
              "：最初に見つかった文字列だけを置き換える"
            )
          ],
          [
            InternalLink (
              localized "replaceAll" "replaceAll",
              "/docs/library/text/function/replaceall/"
            ),
            Words (
              localized ": Replace all non-overlapping literal matches"
              "：一致する文字列を左からすべて置き換える"
            )
          ],
          [
            InternalLink (localized "trim" "trim", "/docs/library/text/function/trim/"),
            Words
              (localized ": Remove whitespace only at both ends" "：文字列の両端の空白だけを取り除く")
          ],
          [
            InternalLink
              (localized "lines" "lines", "/docs/library/text/function/lines/"),
            Words (
              localized ": Split lines while handling line-ending conventions"
              "：改行の種類を扱いながら行へ分ける"
            )
          ],
          [
            InternalLink (
              localized "lengthScalars" "lengthScalars",
              "/docs/library/text/function/lengthscalars/"
            ),
            Words (localized ": Count Unicode scalar values" "：Unicodeの番号の単位で文字列を数える")
          ],
          [
            InternalLink (
              localized "lengthBytes" "lengthBytes",
              "/docs/library/text/function/lengthbytes/"
            ),
            Words
              (localized ": Count bytes in the UTF-8 encoding" "：UTF-8で送るときのバイト数を数える")
          ],
          [
            InternalLink
              (localized "scalarAt" "scalarAt", "/docs/library/text/function/scalarat/"),
            Words (
              localized ": Read one Unicode scalar at a checked position"
              "：指定した位置のUnicode scalarを一つ取り出す"
            )
          ],
          [
            InternalLink (
              localized "sliceScalars" "sliceScalars",
              "/docs/library/text/function/slicescalars/"
            ),
            Words (
              localized ": Slice a string using a checked scalar range"
              "：scalar単位の範囲を確認して文字列を切り出す"
            )
          ],
        ]
      ),
      Heading
              ("text-units", localized "Count the same text in different units" "同じ文字列を違う単位で数える"),
      Paragraph ([Words (localized (en.units ()) (ja.units ()))]),
      Paragraph ([Words (localized (en.bytes ()) (ja.bytes ()))]),
      CodeExample ("text-units", localized "Seseragi: name the unit" "Seseragiで単位を指定する"),
      Paragraph ([Words (localized (en.seseragi ()) (ja.seseragi ()))]),
      Terminal (localized "Output" "実行結果", "scalars: 5\nUTF-8 bytes: 10\ngraphemes: 4"),
      CodeExample (
        "text-units-typescript",
        localized "TypeScript: name the unit" "TypeScriptで単位を指定する"
      ),
      Paragraph ([Words (localized (en.typescript ()) (ja.typescript ()))]),
      Terminal (
        localized "Output" "実行結果",
        "UTF-16 units: 6\nscalars: 5\nUTF-8 bytes: 10\ngraphemes: 4"
      ),
      Heading
              ("consume-maybe", localized "Use a scalar or handle absence" "scalarを取り出して不在も扱う"),
      Paragraph ([Words (localized (en.maybe ()) (ja.maybe ()))]),
      CodeExample
              ("text-scalarat", localized "Handle both Maybe cases" "Maybeの両方の場合を処理する"),
      Terminal
              (localized "Output" "実行結果", "found: 😀\nout of range\nout of range\nout of range"),
      Heading
              ("consume-either", localized "Use a slice or explain its failure" "切り出した値か失敗理由を使う"),
      Paragraph ([Words (localized (en.either ()) (ja.either ()))]),
      CodeExample
              ("text-slicescalars", localized "Handle both Either cases" "Eitherの両方の場合を処理する"),
      Terminal (
        localized "Output" "実行結果",
        "slice: [é😀]\nslice: []\ninvalid: InvalidScalarRange { start: 0, end: 4, length: 3 }\ninvalid: InvalidScalarRange { start: 2, end: 1, length: 3 }\nslice: []"
      ),
      Heading ("text-api-index", localized "Browse the complete module" "モジュール全体を調べる")
    ]
