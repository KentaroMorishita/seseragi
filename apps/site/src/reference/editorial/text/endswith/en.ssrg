import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Check a string’s suffix",
  purpose: "Use endsWith for a task such as checking whether a filename ends in .csv. Pass the expected suffix first and the input string second, and receive Bool.",
  reading: "report.csv ends in .csv, so the first result is True. report appears at the beginning, not the end, giving False on the second line.",
  boundaries: "An empty suffix matches even an empty input, giving True. .CSV and .csv differ in case, so the final result is False.",
  rules: "This uses neither regular expressions nor automatic case conversion. The input is unchanged; work depends on input and search-text size.",
  mistake: "A .csv suffix does not validate CSV file contents. Keep name checks separate from content validation. Use startsWith to inspect the beginning.",
}
