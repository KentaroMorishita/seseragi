import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "決まった文字列で終わるか調べる",
  purpose: "ファイル名が.csvで終わるか調べるような場合にendsWithを使います。末尾に期待する文字列、対象文字列の順に渡し、Boolを受け取ります。",
  reading: "report.csvは.csvで終わるのでTrueです。reportという文字列は先頭にありますが末尾ではないため、2行目はFalseです。",
  boundaries: "空の末尾文字列は空の対象にも一致するので3行目はTrueです。.CSVと.csvは大文字小文字が違うため、最後はFalseになります。",
  rules: "正規表現や大文字小文字の自動変換は使いません。対象の値は変更せず、対象と検索文字列の大きさに応じた処理を行います。",
  mistake: "末尾が.csvでも、ファイルの内容が正しいCSVかどうかは分かりません。名前の判定と内容の検証は分けてください。先頭を調べるならstartsWithです。",
}
