import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "UTF-8で送るときのバイト数を数える",
  purpose: "lengthBytesは文字列をUTF-8で表すために必要なバイト数を返します。文字数や画面幅を返す関数ではありません。送信や保存のサイズを考えるときに使います。",
  reading: "Aé😀e\\u{301}では、Aが1、éが2、😀が4、eが1、結合アクセントが2バイトなので合計10です。\\u{301}は結合アクセントU+0301を書く表記です。",
  boundaries: "éだけの2行目は2、空文字列は0です。同じ最初の文字列はscalarなら5、graphemeなら4です。TypeScriptのString.lengthはUTF-16の単位なので6で、TextEncoderを使えば同じUTF-8サイズ10を得られます。",
  rules: "数えるのはUTF-8のサイズです。別の文字コードやファイル形式のヘッダーなどは含めません。処理量はUTF-8バイト数に対して線形です。",
  mistake: "この数を文字列の切り出し位置としてscalarAtやsliceScalarsへ渡さないでください。その二つはscalar単位です。見た目の文字数や表示幅を知る用途とも分けて使います。",
}
