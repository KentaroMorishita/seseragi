import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "指定した区切りで文字列を配列へ分ける",
  purpose: "splitには区切り文字列、対象の文字列の順に渡します。区切りは正規表現ではなく、その文字列そのものです。結果は区切りの前後の文字列を並べた配列になります。",
  reading: "text.split \",\" \"a,,b,\"には、カンマの間の空項目と末尾の空項目があります。出力の[\"a\",\"\",\"b\",\"\"]では、空項目も残っていることが分かります。json.encodeStringは配列をJSONの文字列にし、空文字列の引用符も表示します。",
  boundaries: "カンマで空文字列を分けると、項目が一つの[\"\"]です。一方、区切りが空文字列の場合はUnicode scalarごとに分けます。A😀はAと😀の二つになり、空の対象文字列なら[]です。",
  rules: "Unicode scalarは文字に割り当てられた番号の単位です。見た目の一文字が複数のscalarからできる場合もあるため、空区切りでの分割が画面上の文字単位になるとは限りません。空項目を自動で取り除かず、入力を変更しません。",
  mistake: "区切りに\".\"を渡すと点そのものを探します。TypeScriptで正規表現を渡すsplitの代わりとしては使えません。改行の種類をまとめて扱いたいならlines、空白で分けて空項目を除きたいならwordsを選びます。",
}
