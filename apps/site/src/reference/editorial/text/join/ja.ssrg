import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "文字列の間に区切りを入れてつなぐ",
  purpose: "項目をカンマ区切りで表示するならjoinを使います。最初の引数が区切り文字列、次の引数が文字列の配列です。配列の要素順に、一つの文字列へつなぎます。",
  reading: "text.join \",\" [\"A\", \"\", \"B\"]では三つの要素の間にカンマを置くため、A,,Bになります。空の項目を削除しないので、カンマが二つ並びます。出力の外側の[と]は例で付けた目印です。",
  boundaries: "空配列では区切りも入らず、空文字列を返します。最後の例は区切りそのものが空文字列なので、AとBが直接つながってABになります。一要素だけなら区切りを加えません。",
  rules: "区切りは要素の間だけに入れ、最初や最後に追加しません。入力を変更せず、必要な出力を作るため、処理量は入力と出力のバイト数に応じます。",
  mistake: "joinはCSVの引用符や改行をエスケープする関数ではありません。表示用に区切りたい場合に使い、CSVなどの形式が必要ならその形式の規則を別途扱ってください。区切りなしの結合はconcatでも書けます。",
}
