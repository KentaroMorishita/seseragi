import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Join strings with a separator",
  purpose: "Use join to display items separated by commas. Pass the separator first and the array of strings second. Entries are joined into one string in their original order.",
  reading: "text.join \",\" [\"A\", \"\", \"B\"] puts commas between all three entries, producing A,,B. The empty entry is preserved, so two commas appear together. The outer [ and ] are markers added by the example.",
  boundaries: "An empty array produces an empty string with no separator. The last example uses an empty separator, producing AB. A single entry also has no separator added.",
  rules: "Separators appear only between entries, not at the beginning or end. Inputs stay unchanged; work depends on input and output byte counts.",
  mistake: "join does not quote or escape CSV fields or line breaks. Use it for simple separated display, and handle format rules separately when producing CSV or another structured format. concat also joins without a separator.",
}
