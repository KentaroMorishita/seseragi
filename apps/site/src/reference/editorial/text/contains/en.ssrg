import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Check whether literal text occurs in a string",
  purpose: "Pass the text to find first and the input string second. contains returns True when found and False otherwise; it does not return the position or matching substring.",
  reading: "A literal dot occurs in a.b, so that call returns True. It does not occur in abc, so the next call returns False. A dot is not the regular-expression wildcard here.",
  boundaries: "An empty search string is always considered present, giving True on the third line. Lowercase a differs from uppercase A, so the fourth line is False. The final empty input contains no a, also giving False. Transform both strings appropriately first if your task requires another comparison policy.",
  rules: "Case and alternative Unicode representations are not equated automatically. Inputs stay unchanged, and searching depends on the byte counts of the input and search text.",
  mistake: "If an empty query should mean no search condition, check for emptiness before calling contains. Use startsWith for the beginning only, or endsWith for the end.",
}
