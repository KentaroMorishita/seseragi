import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "文字列がそのまま含まれているか調べる",
  purpose: "containsには探す文字列、対象文字列の順に渡します。見つかればTrue、見つからなければFalseです。位置や一致した部分そのものは返しません。",
  reading: "\".\"はa.bには含まれるのでTrue、abcにはないのでFalseです。点を「任意の一文字」として扱う正規表現の検索ではありません。",
  boundaries: "空の検索文字列は常に含まれる扱いなので、3行目はTrueです。4行目では小文字aと大文字Aが違うためFalseになります。空の対象文字列にはaが含まれないので、最後もFalseです。必要なら検索する両方の文字列を目的に合う方法で変換してから比較します。",
  rules: "大文字小文字やUnicodeの別表現を自動で同一視しません。入力は変更せず、対象と検索文字列のバイト数に応じた検索を行います。",
  mistake: "空の検索語を「検索条件なし」として除外したい場合は、containsを呼ぶ前に空かどうかを確かめてください。先頭だけの一致ならstartsWith、末尾だけならendsWithを使います。",
}
