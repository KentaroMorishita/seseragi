import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "一致する文字列を左からすべて置き換える",
  purpose: "replaceAllには検索文字列、置換文字列、対象文字列の順に渡します。左から見つかった一致を、重ならないように順に置き換えます。",
  reading: "bananaのaをXにするとbXnXnXです。aaaのaaをXにする例は、最初の二文字を使い終えてから続けるのでXaになります。重なった位置のaaをもう一度数えません。",
  boundaries: "空の検索文字列は先頭・Unicode scalarの間・末尾に一致します。A😀へ:を挿入すると:A:😀:で、😀の途中は分けません。4行目の$&は展開せずそのまま入るためc$&tです。最後の空入力は空文字列になり、囲みだけの[]を表示します。",
  rules: "Unicode scalarは文字コードの番号の単位で、見た目の一文字と常に同じとは限りません。置換後の文字列を検索し直さず、元の文字列を左から処理します。入力は変更せず、入力と出力のバイト数に応じた処理を行います。",
  mistake: "正規表現や$で始まる参照記法を渡す機能ではありません。検索対象はliteralの文字列です。最初の一致だけを変えたいならreplaceを使います。",
}
