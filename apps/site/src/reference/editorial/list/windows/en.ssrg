import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Read overlapping runs of neighboring elements",
  purpose: "Use windows to inspect neighboring values, such as consecutive pairs. Pass the width first and the List second. Each next window starts one element later.",
  reading: "describe uses match to read the result. Right groups contains all complete windows; Left error contains NonPositiveSize with the rejected size. At width 2, the middle values appear in two windows. Returning Left is an ordinary value, not a thrown exception.",
  boundaries: "Width 5 on two values succeeds with no windows. Width 1 gives one window per value. Empty input with a positive width also succeeds with no windows. Width 0 or -2 is invalid, including on empty input.",
  rules: "The result is Either<SizeError, List<List<Int>>>: a size error or a List of Lists. Only full-width windows are kept. Order is preserved and the input is unchanged. Work depends on the input and the number of output elements.",
  mistake: "chunksOf makes non-overlapping batches and keeps a short final batch; windows does neither. A TypeScript loop with slice can express these windows too: decide explicitly whether to keep incomplete final slices and how to reject invalid widths.",
}
