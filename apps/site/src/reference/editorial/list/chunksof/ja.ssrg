import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Listを重複しないまとまりに分ける",
  purpose: "一度に2件ずつ処理するなど、各要素を一つのまとまりに入れるときにchunksOfを使います。正のサイズ、Listの順に渡します。",
  reading: "describeはsizeとvaluesを受け取ります。matchは、成功したRight groupsか、サイズが不正なLeft errorを選びます。各分岐は表示用の文字列を返します。Leftを返すこと自体は例外を投げません。5要素をサイズ2で分けると、2要素のまとまり二つと最後の1要素になります。",
  boundaries: "サイズ8では、2要素の入力全体が一つのまとまりになります。サイズ1では1要素ずつです。正のサイズで空の入力なら、空のListとして成功します。0や負のサイズは、入力が空でも失敗します。",
  rules: "Rightに入るList<List<Int>>は、整数のListを要素に持つListです。要素の順序を保ち、入力を変更しません。処理量は入力と出力の要素数に応じます。",
  mistake: "隣り合うまとまりを重ねたい場合はwindowsを使います。TypeScriptでもforとsliceで同じ処理を書けますが、不正なサイズをどう扱うかは決める必要があります。ここではEitherのRightに結果、LeftにNonPositiveSizeという理由が入ります。",
}
