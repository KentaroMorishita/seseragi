import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "要素があれば最後の値を読む",
  purpose: "Listを変更せずに最後の値を読みたいときにlastを使います。空のListには最後の値がないため、結果はMaybeです。",
  reading: "matchはJustの中の値に名前を付けて表示し、Nothingならempty inputという文を選びます。List<Int>は整数のList、Maybe<Int>は整数が一つあるか、値がないかを表します。",
  boundaries: "3要素の入力は30、1要素の入力は10を返し、空の入力ではNothingを選びます。要素の値が0でも、値が存在するJust 0であって、値がない場合にはなりません。",
  rules: "Listのlastは末尾までたどるので、要素数に応じて処理量が増えます。値を取り除いたり、入力を変更したりはしません。",
  mistake: "TypeScriptでは長さを確認してvalues[values.length - 1]を読めます。ここでは値がない場合が結果の形に現れます。Arrayのlastは一定の処理量ですが、Listのlastは違います。よく使う読み方に応じて選んでください。",
}
