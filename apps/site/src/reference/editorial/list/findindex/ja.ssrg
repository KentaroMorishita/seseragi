import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "最初に条件を満たす位置を探す",
  purpose: "値そのものではなく位置が必要ならfindIndexを使います。isLargeはIntを受け取り、30以上かどうかをBoolで返します。",
  reading: "describeが受け取るMaybe<Int>には、位置が見つかったJust indexか、見つからなかったNothingが入ります。matchで分岐を選び、見つかった位置にindexという名前を付けて文字列を返します。位置は0から数えます。",
  boundaries: "最初の入力では位置0、次は位置1で見つかります。一致する要素がない場合も空のListもNothingになり、not foundと表示します。",
  rules: "先頭から条件を調べ、最初に一致した時点で止めます。その後の要素には条件関数を呼びません。入力は変えず、後ろの位置を探すには手前の要素をたどります。",
  mistake: "TypeScriptのfindIndexも簡潔に書けますが、見つからない場合は-1です。SeseragiではNothingなので、位置を使って計算する前に二つの場合を分けてください。要素自体が欲しい場合はfindを使います。",
}
