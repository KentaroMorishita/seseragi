import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Find the position of the first matching value",
  purpose: "Use findIndex when you need a position rather than the value itself. isLarge accepts an Int and returns Bool: whether it is at least 30.",
  reading: "describe receives Maybe<Int>. Just index means a position was found; Nothing means none matched. match chooses the appropriate branch, names the position index and returns text. Positions start at 0.",
  boundaries: "The first input matches at 0 and the second at 1. An input with no match and an empty List both produce Nothing and print not found.",
  rules: "The predicate is tested from the start and stops at the first match. Later values are not tested. No input is changed. Finding a later position requires walking past earlier List elements.",
  mistake: "TypeScript findIndex already solves this concisely but uses -1 for absence. Seseragi uses Nothing, so handle the two shapes before doing arithmetic with the position. Use find when you want the element instead.",
}
