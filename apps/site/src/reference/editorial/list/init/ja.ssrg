import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "末尾を除いた要素を残す",
  purpose: "Listの最後の要素を除き、残りを順番どおりに使うときにinitを使います。入力自体は変わりません。",
  reading: "戻り値Maybe<List<Int>>をmatchで処理します。Just remainingでは結果のListにremainingという名前を付け、Nothingでは取り除く要素が入力になかったことを扱います。showがListを表示用の文字列にします。",
  boundaries: "3要素なら先頭の2要素が残ります。1要素なら、空のListを持つJustとして成功し、remaining: `[]と表示します。空の入力はNothingで、empty inputと表示します。この二つは別の結果です。",
  rules: "Listのinitは入力をたどるため、要素数が増えると処理量も増えます。成功した結果には、最後より前の要素が元の順序で入ります。",
  mistake: "TypeScriptのslice(0, -1)は、空の入力と1要素の入力のどちらも空配列にします。Maybeが示す区別が必要なら、入力の長さも確認してください。initは末尾を除き、tailは先頭を除きます。",
}
