import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "一つの値だけを持つListを作ります。",
  purpose: "一件だけの結果を、複数件と同じListの形で扱いたいときに使います。singletonの後ろに包む値を一つ渡してください。値の中身が空でも、外側には一つの要素が入ります。",
  reading: "42は整数、\"Aki\"は文字列なので、最初の二つはList<Int>とList<String>です。次のlists.empty<Int> ()は空の整数のListで、singletonがそれ全体を一つの要素として包みます。showの表示では文字列の引用符は省かれます。",
  boundaries: "三つ目は空のListを一つ含む入れ子です。最後の\"\"は空文字列ですが、singletonで包んだ後のlengthは1です。lengthは外側の要素数を数えます。文字数や内側の要素数ではありません。",
  rules: "渡された値への参照を一つ持つ入れ物を作ります。値の内部を走査せず、入力値も変更しません。処理量は一定です。",
  mistake: "singletonは中身を平らにしません。最初から要素を0個にしたい場合はempty ()を使います。すでに複数の値を持つ入力を変換したい場合はfromIterableを選びます。"
}
