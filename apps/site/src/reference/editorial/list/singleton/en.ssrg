import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Create a List containing exactly one value.",
  purpose: "Use singleton when a single result needs the same List shape as multiple results. Pass the value to wrap. Even when that value is empty inside, the outer container has one element.",
  reading: "42 is an integer and \"Aki\" a string, so the first two results are List<Int> and List<String>. Next, lists.empty<Int> () creates an empty integer List; singleton wraps that entire value as one element. show omits quotes around displayed strings.",
  boundaries: "The third result contains one empty List. The final input \"\" is an empty string, but length after wrapping it is 1. length counts outer elements, not characters or inner elements.",
  rules: "It creates a container holding one reference to the supplied value. Work is constant: it neither traverses that value nor changes it.",
  mistake: "singleton does not flatten its input. Use empty () for zero elements, or fromIterable to convert an input that already holds multiple values."
}
