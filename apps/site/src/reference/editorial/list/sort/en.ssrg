import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Return values in their standard order",
  purpose: "Use sort to order a List of values that have a defined ordering. For Int, the order is numeric ascending order.",
  reading: "numbers contains 30, 2, 10 and another 2. sort returns 2, 2, 10, 30. Printing numbers afterwards confirms the original order is still 30, 2, 10, 2.",
  boundaries: "An empty List returns an empty List. Equal values remain in their original relative order; sorting does not remove duplicates.",
  rules: "Ord<A> means the element type has a defined comparison. Sorting is stable and takes O(n log n) comparisons for n elements. List results are fully produced before the call returns.",
  mistake: "A fair TypeScript equivalent for these integers is values.slice().sort((a, b) => a - b): slice preserves the input and the callback requests numeric order. Use sortBy when records should be ordered by one field.",
}
