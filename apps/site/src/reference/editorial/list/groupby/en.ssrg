import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Collect values under matching keys",
  purpose: "Use groupBy to organize values by a category. parity returns the remainder after division by 2. For the positive integers in this example, odd numbers have key 1 and even numbers key 0. The result is a Map from each key to its List of values.",
  reading: "The first key encountered is 1, then 0, so maps.keys prints [1, 0], an Array. maps.get 1 groups returns Just containing the odd-number List. describe uses match to print that List or handle Nothing when a key is absent.",
  boundaries: "The odd group is 3, 5, 7 and the even group is 2, 4. Key 9 is absent. Grouping empty input creates a Map with size 0; it does not pre-create empty groups.",
  rules: "Each key is computed once in input order. Keys stay in first-appearance order; values within each group retain input order. Eq<K> and Hash<K> identify equal keys. With suitable hashing, work is expected to grow linearly.",
  mistake: "This groups by the chosen key, not by adjacent runs. TypeScript can use a loop and Map of arrays for the same task. Here Map<K, List<A>> makes the group collection type explicit; a missing lookup remains Maybe, not an empty group.",
}
