import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Combine values starting at the end",
  purpose: "Use reduceRight when the order of combining matters. Pass the initial result, then the step function, then the List. subtract takes the current element first and the accumulated result second.",
  reading: "With initial 0, the steps are 3 - 0 = 3, then 2 - 3 = -1, then 1 - (-1) = 2. The second call uses empty input and returns its initial value 10.",
  boundaries: "Empty input never calls subtract. The initial value is required, so there is a defined result even with no elements.",
  rules: "The step runs once per element from last to first. Type A is the element type and B is the accumulated result type; initial and every step result must both be B. They are Int in this example. Work grows with the List length.",
  mistake: "TypeScript reduceRight passes accumulator before element. Its equivalent callback here is (total, value) => value - total. Do not copy that parameter order into Seseragi, which calls step element accumulator.",
}
