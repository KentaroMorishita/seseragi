import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "要素を持たないListを作ります。",
  purpose: "まだ項目がない一覧をList<Int>などの型で用意する操作です。emptyは関数なので、lists.empty ()と書いて呼び出します。()はUnitという「意味のある情報を持たない値」で、ここでは必要な引数です。",
  reading: "noNumbers: List<Int>は整数のListという型注釈です。その注釈からemptyの要素型が決まります。noNamesはString、つまり文字列のListで、`[]を直接書いた同じ空の値です。最後の<Int>は呼び出し側で要素型を指定するもう一つの書き方です。",
  boundaries: "三つとも要素数は0で、`[]と表示されます。要素型が違っても空の表示は同じです。空の値だけでは整数用か文字列用か決まらないため、型注釈か<Int>のような型指定を添えてください。",
  rules: "空の入れ物を返すだけなので、要素を走査する処理はありません。作成にかかる処理量は要素数に依存しません。",
  mistake: "lists.emptyとだけ書くと、まだUnitを待つ関数です。値が欲しい場所では()を渡します。一つの値を入れたい場合はsingletonを使います。"
}
