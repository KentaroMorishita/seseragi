import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Create a List with no elements.",
  purpose: "Use empty to prepare a List<Int>, for example, before any items exist. It is a function: call lists.empty (). The argument () is the Unit value, which carries no meaningful information but is required here.",
  reading: "noNumbers: List<Int> annotates an integer List; that annotation determines the element type of empty. noNames is a List of String values, created directly with `[]. The final <Int> shows the other way to specify the element type at the call.",
  boundaries: "All three values have zero elements and display as `[]. Empty values of different element types look the same. With no elements to infer a type from, supply an annotation or a type argument such as <Int>.",
  rules: "Creating the empty container does not traverse any elements. Its work does not depend on a collection size.",
  mistake: "Writing only lists.empty leaves a function waiting for Unit. Pass () when you need its value. Use singleton to include one value."
}
