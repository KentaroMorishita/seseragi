import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "条件を満たす先頭部分を除く",
  purpose: "先頭から条件を満たす間の要素を除きます。positiveはIntを受け取り、0より大きいかをBoolで返します。",
  reading: "最初の結果は0から始まり、0と3が残ります。0で条件の確認を止め、後ろの3からやり直すことはありません。",
  boundaries: "先頭で条件を満たさなければ入力全体が残り、全部が満たせば空になります。空の入力は空のListを返します。",
  rules: "条件関数は、先頭から最初に満たさない要素まで呼びます。その後の要素には呼びません。入力は変えず、先頭部分をたどる処理量はその長さに応じます。",
  mistake: "filterは全要素を調べて一致したものを残します。この操作は先頭部分の境目を一つ見つけます。TypeScriptでもwhileで境目を求め、sliceでその位置から後ろを取り出せば同じ要素を得られます。",
}
