import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Keep the matching prefix",
  purpose: "Keep consecutive values from the start while the condition is true. positive receives an Int and returns whether it is greater than 0.",
  reading: "The first result keeps 1 and 2. Testing stops at 0; the later 3 does not restart the matching prefix.",
  boundaries: "When the first value fails, the result is empty. If every value matches, all are kept. Empty input returns an empty List.",
  rules: "The condition is called from the start through the first failing value only. Later elements are not tested. The input is unchanged; walking the prefix takes work proportional to that prefix.",
  mistake: "filter tests all elements and keeps all matches. This operation instead finds one prefix boundary. A TypeScript while loop can find that boundary, then slice before it to get the same elements.",
}
