import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "選んだ項目でレコードを並べる",
  purpose: "レコードの項目や計算した値を基準にするならsortByを使います。scoreはnameとscoreを持つレコードを受け取り、Intの点数を返します。",
  reading: "点数1のMioが先頭に来ます。AkiとRenはどちらも2なので、元の順序を保ちます。次の出力でpeopleが変わっていないことも確認できます。nobodyは同じレコード型のListと明示した、要素のない値です。",
  boundaries: "nobodyを並べ替えると空のListになり、scoreは一度も呼びません。キーが同じなら、レコードの内容が違っても元の順序を保ちます。",
  rules: "キーを得る関数は入力順に各要素で一度だけ呼びます。Ord<K>はキーの型に順序があるという条件です。同順位の順序を保ち、比較回数はO(n log n)で増えます。",
  mistake: "sortByに渡すのは1要素からキーを得る関数であり、2要素を比較する関数ではありません。TypeScriptのpeople.slice().sort((a, b) => a.score - b.score)も、この整数の点数を同じ順序に並べ、入力を保ちます。",
}
