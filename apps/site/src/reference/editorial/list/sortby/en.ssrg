import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Order records by a selected value",
  purpose: "Use sortBy to order records by a field or another computed key. score receives a record with name and score fields, and returns its Int score.",
  reading: "Mio has score 1 and moves first. Aki and Ren both have score 2, so their original order is preserved. The following print shows people unchanged. nobody is explicitly a List of the same record type, with no elements.",
  boundaries: "Sorting nobody produces an empty List and never calls score. Equal keys preserve the input order even when the records themselves differ.",
  rules: "The key function runs exactly once per element, in input order. Ord<K> requires an order for that key type. Sorting is stable; comparisons grow as O(n log n).",
  mistake: "sortBy takes a one-input key function, not a two-input comparator. TypeScript people.slice().sort((a, b) => a.score - b.score) expresses the same ordering for these integer scores and preserves the input.",
}
