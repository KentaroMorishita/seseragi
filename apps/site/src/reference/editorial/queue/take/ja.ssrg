import { CorrectionCopy } from "../../correction-model"

pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "キューの先頭から値を一つ取り出します。開いていて空のキューでは値を待ちます。閉じたキューでは残りの値を取り出し、なくなるとQueueClosedで失敗します。",
  taskTitle: "届いた順に処理を受け取る",
  purpose: "Queueは、先に入れた値から順に処理へ渡すキューです。この例では10と20を入れ、キューを閉じてから三度取り出します。閉じても中の値は残るので、最初の二回は成功し、三回目は閉じたことを知らせます。",
  setup: "import * as queuesとimport * as effectsで、各モジュールに名前を付けます。unbounded<Int> ()は容量の上限がない整数のキューを作ります。()は追加の入力がないことを表すUnitです。takeに渡すのはキューだけで、個数は指定しません。",
  codeTitle: "閉じたキューの値を取り出す完全なプログラム",
  outputTitle: "実行結果",
  after: [
    "takeTextはEffectを作ります。\\value: Int -> show valueは、受け取った整数を文字列にする関数です。<$>は成功した結果にその関数を適用します。|>は左のEffectを右のrecoverへ渡します。recoverはQueueClosedを受け取り、成功した文字列\"closed\"に置き換えます。",
    "mainのdoはEffectを順に実行します。queue <-はキューを作って結果に名前を付け、first <- takeText queueは一度取り出した結果をfirstと名付けます。offerとprintlnも、この順序で実行します。AppErrorはQueueFailureかConsoleFailureを表す型で、mapErrorは各処理の失敗を対応する形で包みます。deriving Showによって、このエラーを表示できるようになります。",
    "Effect<{}, Never, String>は、サービスが不要で、処理すべき型付きの失敗が残っておらず、文字列を返すという意味です。Neverでもキャンセルや実行時の不具合は起こりえます。また、mainのコンソール出力には型付きの失敗が残ります。"
  ],
  comparisonTitle: "TypeScriptで非同期キューから受け取る",
  comparisonBefore: "TypeScriptに非同期のQueue型は組み込まれていません。アプリやライブラリがtake(): Promise<T>を提供する場合、次のように一つの値を待ち、閉じたキューのエラーを処理できます。これは受け取る側の関数で、キュー自体の実装ではありません。",
  comparisonAfter: "TypeScriptの関数は呼び出すと処理を始めます。Seseragiの関数は後で実行するEffectを作ります。どちらも想定外の失敗を残し、すべての失敗を「閉じた」に置き換えることはしません。エラーの形やキャンセルの規則は、使うキューの実装に従います。",
  detailTitle: "空・閉鎖・キャンセルの違い",
  details: [
    "開いていて空のキューに対するtakeは、値が入るまで待ちます。閉じた後も、残っている値は先に入れた順に取り出せます。残りがなくなるとQueueClosedです。待ちたくない場合はtryTakeを使い、値がある場合、開いていて空の場合、閉じた場合を分けて扱えます。",
    "待機中のtakeをキャンセルしても、後から入る値は消費しません。値の受け取りとキャンセルが同じ実行単位で起きる場合、登録順によってどちらが先に成立するかを決めます。キューの閉鎖とキャンセルは別の操作で、キャンセルがQueueClosedになるわけではありません。"
  ]
}
