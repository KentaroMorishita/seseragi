import { editorial as case0 } from "./map/get/page"
import { editorial as case1 } from "./transformer/state/get/page"
import { editorial as case2 } from "./queue/take/page"
import { editorial as case3 } from "./web/storage/get/page"
import { editorial as case4 } from "./non-empty-list/head/page"
import { editorial as case5 } from "./non-empty-list/tail/page"
import { editorial as case6 } from "./non-empty-list/tolist/page"
import { editorial as case7 } from "./set/toarray/page"
import { editorial as case8 } from "./set/tolist/page"
import { ReferenceSymbol } from "../../model/build"
import { Editorial } from "./model"
pub fn correctionEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.namespace != "value" then
    Nothing
  else if symbol.identity == "std/map::get"
    && symbol.module == "std/map"
    && symbol.itemKind == "function" then
    Just (case0 ())
  else if symbol.identity == "std/transformer/state::get"
    && symbol.module == "std/transformer/state"
    && symbol.itemKind == "function" then
    Just (case1 ())
  else if symbol.identity == "std/queue::take"
    && symbol.module == "std/queue"
    && symbol.itemKind == "effect-function" then
    Just (case2 ())
  else if symbol.identity == "std/web/storage::get"
    && symbol.module == "std/web/storage"
    && symbol.itemKind == "effect-function" then
    Just (case3 ())
  else if symbol.identity == "std/non-empty-list::head"
    && symbol.module == "std/non-empty-list"
    && symbol.itemKind == "function" then
    Just (case4 ())
  else if symbol.identity == "std/non-empty-list::tail"
    && symbol.module == "std/non-empty-list"
    && symbol.itemKind == "function" then
    Just (case5 ())
  else if symbol.identity == "std/non-empty-list::toList"
    && symbol.module == "std/non-empty-list"
    && symbol.itemKind == "function" then
    Just (case6 ())
  else if symbol.identity == "std/set::toArray"
    && symbol.module == "std/set"
    && symbol.itemKind == "function" then
    Just (case7 ())
  else if symbol.identity == "std/set::toList"
    && symbol.module == "std/set"
    && symbol.itemKind == "function" then
    Just (case8 ())
  else
    Nothing
