import { localized } from "../../../../model/locale"
import {
  Block,
  BulletList,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"
pub fn blocks specifier: String -> Array<Block> =
  if specifier != "std/set" then
    []
  else
    [
      Heading ("working-with-sets", localized "Choose a Set operation" "Setの操作を選ぶ"),
      Paragraph ([Words (localized (en.purpose ()) (ja.purpose ()))]),
      Paragraph ([Words (localized (en.order ()) (ja.order ()))]),
      Heading ("create-and-check", localized "Create and check membership" "作成と要素の確認"),
      BulletList (
        [
          [
            InternalLink
              (localized "empty" "empty", "/docs/library/set/function/empty/"),
            Words (localized ": Start with no members" "：要素0個から始める")
          ],
          [
            InternalLink
              (localized "singleton" "singleton", "/docs/library/set/function/singleton/"),
            Words (localized ": Start with one member" "：1要素から始める")
          ],
          [
            InternalLink (
              localized "fromIterable" "fromIterable",
              "/docs/library/set/function/fromiterable/"
            ),
            Words (localized ": Remove duplicates" "：重複を除いて集める")
          ],
          [
            InternalLink
              (localized "contains" "contains", "/docs/library/set/function/contains/"),
            Words (localized ": Check one member" "：要素があるか確かめる")
          ],
          [
            InternalLink (localized "size" "size", "/docs/library/set/function/size/"),
            Words (localized ": Count members" "：要素数を読む")
          ],
          [
            InternalLink
              (localized "isEmpty" "isEmpty", "/docs/library/set/function/isempty/"),
            Words (localized ": Check for no members" "：空かを確かめる")
          ]
        ]
      ),
      Heading ("update-members", localized "Return changed membership" "要素を変えた結果を得る"),
      BulletList (
        [
          [
            InternalLink
              (localized "insert" "insert", "/docs/library/set/function/insert/"),
            Words (localized ": Include a member" "：要素を含める")
          ],
          [
            InternalLink
              (localized "remove" "remove", "/docs/library/set/function/remove/"),
            Words (localized ": Omit a member" "：要素を除く")
          ],
          [
            InternalLink
              (localized "filter" "filter", "/docs/library/set/function/filter/"),
            Words (localized ": Keep members passing a condition" "：条件を満たす要素を残す")
          ],
          [
            InternalLink (localized "map" "map", "/docs/library/set/function/map/"),
            Words (localized ": Transform and deduplicate" "：変換して重複を除く")
          ]
        ]
      ),
      Heading
              ("combine-members", localized "Combine and compare membership" "要素の組み合わせと確認"),
      BulletList (
        [
          [
            InternalLink
              (localized "union" "union", "/docs/library/set/function/union/"),
            Words (localized ": Keep either side" "：どちらかにあれば残す")
          ],
          [
            InternalLink (
              localized "intersection" "intersection",
              "/docs/library/set/function/intersection/"
            ),
            Words (localized ": Keep shared members" "：両方にあれば残す")
          ],
          [
            InternalLink (
              localized "difference" "difference",
              "/docs/library/set/function/difference/"
            ),
            Words (localized ": Exclude specified members" "：指定の要素を除く")
          ],
          [
            InternalLink (
              localized "isSubsetOf" "isSubsetOf",
              "/docs/library/set/function/issubsetof/"
            ),
            Words (localized ": Check every required member" "：必要な要素をすべて確かめる")
          ]
        ]
      ),
      Heading
              ("convert-members", localized "Read another collection form" "別のコレクションにする"),
      BulletList (
        [
          [
            InternalLink
              (localized "toArray" "toArray", "/docs/library/set/function/toarray/"),
            Words (localized ": Read an Array in insertion order" "：挿入順のArrayで読む")
          ],
          [
            InternalLink
              (localized "toList" "toList", "/docs/library/set/function/tolist/"),
            Words (localized ": Read a List in insertion order" "：挿入順のListで読む")
          ]
        ]
      ),
      Heading
              ("set-example", localized "Keep the source while adding members" "元の値を保って要素を加える"),
      Paragraph ([Words (localized (en.example ()) (ja.example ()))]),
      Paragraph ([Words (localized (en.reading ()) (ja.reading ()))]),
      CodeExample
              ("set-insert", localized "Duplicate, new member, and empty input" "重複・新しい要素・空の入力"),
      Terminal (localized "Output" "実行結果", "[3,1,2]\n[3,1,2,4]\n[3,1,2]\n[0]"),
      Paragraph ([Words (localized (en.outcomes ()) (ja.outcomes ()))]),
      Paragraph ([Words (localized (en.comparison ()) (ja.comparison ()))]),
      Paragraph ([Words (localized (en.combining ()) (ja.combining ()))]),
      Paragraph ([Words (localized (en.limits ()) (ja.limits ()))]),
      Heading ("set-api-index", localized "Browse the complete module" "モジュール全体を調べる")
    ]
