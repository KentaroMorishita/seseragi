import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Remove the members listed by another Set",
  purpose: "Use difference when one Set says which values to exclude. The call is difference removed values: excluded members first, source values last.",
  reading: "sets.difference right left removes 2 and 1 from the left, leaving [3]. Reversing the arguments removes left members from right and leaves [4].",
  boundaries: "Removing an empty Set leaves the source membership and order. An empty source produces an empty result. Both input Sets remain unchanged.",
  rules: "Remaining source members retain their order. This operation is directional: swapping arguments generally changes the membership, not just its order. Eq/Hash determine which members match.",
  mistake: "The TS comparison filters source values with !removed.has(value). Its helper names these inputs left and right and is called with source first; follow the Seseragi argument order shown rather than copying that order.",
}
