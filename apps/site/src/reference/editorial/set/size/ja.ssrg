import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "異なる要素の数を数える",
  purpose: "Setに今ある要素の数が必要ならsizeを使います。過去の挿入回数ではなく、異なる値の数を数えます。",
  reading: "入力で3が重複していても一つだけ保存するので、sizeは3です。既存の1を入れても3、新しい4を入れると4になります。",
  boundaries: "空ならsizeは0です。異なる挿入履歴でも同じ件数になり得るため、件数だけではどの値があるか分かりません。",
  rules: "保持している要素数を一定の処理量で読みます。走査や入力の変更は不要です。",
  mistake: "TypeScriptはsizeプロパティを読み、Seseragiはsets.size valuesと呼びます。空かどうかだけならisEmpty、特定の値があるかならcontainsを使います。",
}
