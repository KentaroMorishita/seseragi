import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Count distinct members",
  purpose: "Use size when you need the number of members currently in a Set. It counts distinct values, not the number of past insertions.",
  reading: "The repeated 3 in the input is stored once, so the size is 3. Inserting existing 1 leaves 3 members, while inserting new 4 makes 4.",
  boundaries: "Empty input has size 0. Different insertion histories can lead to the same count, so size alone does not tell you which values are present.",
  rules: "The stored member count is read with constant work. No traversal or input change is needed.",
  mistake: "TypeScript uses the size property; Seseragi calls sets.size values. For a boolean emptiness check use isEmpty, and for a particular member use contains.",
}
