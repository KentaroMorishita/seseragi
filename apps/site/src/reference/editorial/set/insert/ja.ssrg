import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "指定した値を含むSetを返す",
  purpose: "値が集合に入っている状態を作るときにinsertを使います。値、元のSetの順に渡し、返されたSetを使います。",
  reading: "既存の1を入れても[3,1,2]のままです。新しい4なら[3,1,2,4]になります。originalの表示で、元の値が変わっていないことも確認できます。",
  boundaries: "空のSetに0を入れると[0]です。重複した値を入れても要素数は増えず、既存要素の位置も変わりません。",
  rules: "同じ値があれば位置を保ち、新しい値は末尾に加えます。EqとHashで等しさを決めます。元の値を変更せず、新しいSetを返します。",
  mistake: "TSのaddは対象を変更するため、比較例はnew Set(original)でコピーしてからaddします。どちらも元の集合を保つ処理です。Seseragiの戻り値を使わなければ、元のSetは更新されません。",
}
