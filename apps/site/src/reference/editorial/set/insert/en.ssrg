import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Return a Set that includes a value",
  purpose: "Use insert to ensure a value belongs to a Set. Pass the value first and the original Set second; use the returned Set.",
  reading: "Inserting existing member 1 keeps [3,1,2]. Inserting new member 4 gives [3,1,2,4]. Printing original confirms it is unchanged.",
  boundaries: "Inserting 0 into an empty Set gives [0]. Inserting a duplicate does not grow the set or move the existing member.",
  rules: "An equal existing value keeps its position; a new value appends. Eq/Hash determine equality. The operation returns a new Set rather than modifying the source.",
  mistake: "TS add mutates its receiver, so the comparison copies new Set(original) before add to preserve the same original. Ignoring the returned Seseragi Set does not update the old value.",
}
