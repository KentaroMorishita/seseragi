import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "両方にある要素を残す",
  purpose: "二つのSetに共通する値が必要ならintersectionを使います。右を先、左を後に渡し、結果は左の順序で並びます。",
  reading: "共通する要素は1と2です。sets.intersection right leftは[1,2]、交換するともう一方の順序に従って[2,1]になります。",
  boundaries: "どちらかが空なら結果も空です。両方の元のSetは変わりません。",
  rules: "左のうち右にもある要素だけを、左の挿入順に残します。交換しても要素の有無は同じですが、表示順序が同じとは限りません。EqとHashで要素の有無を確認します。",
  mistake: "TSの比較例は[...left]をright.hasで絞り、同じ元の順序を使います。関数は左、右の順で受け取り、Seseragiは右、左の順です。通常のArrayとSetの操作で処理を明示しています。",
}
