import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "要素が0個のSetを作る",
  purpose: "まだ要素がない集合を作るときにemptyを使います。Set<Int>は整数を要素に持つ集合です。",
  reading: "valuesにsets.Set<Int>という型を付け、sets.empty ()の要素型を指定しています。引数()は追加の情報を持たないUnitです。結果のArrayは[]、sizeは0で、0という要素も含みません。",
  boundaries: "周囲の型から分かれば、呼び出しで型引数を明示する必要はありません。sets.empty<Int> ()も同じ空の集合を作る書き方です。",
  rules: "要素はなくても要素の型はあります。insertは新しいSetを返し、元の空の値に要素を入れることはありません。",
  mistake: "TypeScriptならnew Set<number>()が対応します。TSのSetは変更できますが、Seseragiの更新は新しいSetを返します。型を決めるためだけの仮の要素は不要です。",
}
