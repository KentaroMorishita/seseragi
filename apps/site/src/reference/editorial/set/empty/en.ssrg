import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Start with no members",
  purpose: "Use empty to start a collection of distinct values before any member is known. Set<Int> is a set whose members are integers.",
  reading: "values has the type sets.Set<Int>, which supplies the element type for sets.empty (). The () argument is Unit: no additional input. The resulting Array is [], its size is 0, and it does not contain 0.",
  boundaries: "Explicit type arguments are optional when the surrounding type supplies them. sets.empty<Int> () is another way to write the same empty set.",
  rules: "The result has no members but still has an element type. insert returns a new Set; it does not populate this original value.",
  mistake: "TypeScript new Set<number>() is the corresponding empty collection. TS Sets can be mutated; Seseragi updates return a new Set. Neither needs a dummy member to establish its type.",
}
