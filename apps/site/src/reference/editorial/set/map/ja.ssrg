import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "要素を変換し、同じ結果を一つにする",
  purpose: "各要素を別の値に変え、同じ結果を一つにまとめるときにsets.mapを使います。関数、Setの順に渡します。",
  reading: "parityはIntを受け取り、2で割った余りを返します。この例の正の整数では奇数が1、偶数が0になります。最初の結果は1、次は0なので、出力は[1,0]です。",
  boundaries: "3と5は同じ1、2と4は同じ0になるため、入力4要素が結果2要素になります。空の入力ならparityを呼ばずに空のSetを返します。",
  rules: "入力の挿入順に各要素で一度関数を呼びます。同じ出力は最初の結果の位置を保ちます。Eq<B>とHash<B>は出力の型に必要な条件で、入力のSetは変えません。",
  mistake: "TSの比較例は要素のArrayを変換してからSetを作り、重複を除きます。Seseragiではsets.mapと明示して使います。汎用のmapでSetの要素数が保たれるという説明ではありません。",
}
