import { Editorial } from "../../model"
import { setEditorial } from "../../set-model"
import * as en from "./en"
import * as ja from "./ja"
pub fn editorial -> Editorial =
  setEditorial "std/set::union" "set-union" "[3,1,2,4]\n[2,4,1,3]\n[3,1,2]\n[2,4,1]\n[3,1,2]\n[2,4,1]" (en.copy ()) (ja.copy ())
