import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "どちらかにある要素を集める",
  purpose: "左右どちらかに含まれる要素をすべて集めるときにunionを使います。呼び出しは右のSet、左のSetの順です。",
  reading: "sets.union right leftは左の3,1,2を保ち、右にだけある4を末尾に足します。引数を交換すると2,4,1から始まり、3が最後に入ります。",
  boundaries: "右が空なら左の要素、左が空なら右の要素になります。両方の元の値は変わりません。共通の要素は一つだけ残ります。",
  rules: "左の順序を保ち、右だけの要素を右の順で末尾へ追加します。交換しても含まれる要素は同じですが、見える順序は変わる場合があります。EqとHashで共通の要素を識別します。",
  mistake: "TSの例はnew Set([...left, ...right])を作ります。その関数は左を先に受け取り、Seseragiの呼び出しとは順が違います。どちらも並べ替えは行わず、要素の有無と順序を分けて確認します。",
}
