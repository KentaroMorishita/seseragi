import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "要素が一つのSetを作る",
  purpose: "最初の要素が分かっているときにsingletonを使います。整数0など、その値を直接渡します。",
  reading: "0を含むのでtoArrayは[0]、sizeは1、contains 0はtrueです。もう一度0を挿入しても[0]のままです。",
  boundaries: "0も通常の要素であり、空の集合や値がない状態ではありません。結果には異なる要素が一つあります。",
  rules: "Eq<A>とHash<A>は、要素の型に整合した等しさとハッシュがあるという条件です。後から入れる値が同じ要素かを決めます。Intには用意されています。",
  mistake: "TypeScriptのnew Set([0])も同じ要素を持ちます。繰り返し挿入しても二つにはなりません。最初に要素が不要ならempty ()を使います。",
}
