import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Return a Set without a value",
  purpose: "Use remove to omit a member. Pass the value, then the Set; the result is another Set.",
  reading: "Removing 1 from [3,1,2] leaves [3,2]. Inserting 1 into that result puts it last, giving [3,2,1]. The original still prints [3,1,2].",
  boundaries: "Removing missing member 9 leaves the same membership and order. Removing from an empty Set returns an empty Set; no missing-member error is raised.",
  rules: "Remaining members keep their order. Removing and reinserting starts a new final position for that member. Eq/Hash determine which value matches, and the input is unchanged.",
  mistake: "TS delete mutates a Set and returns a boolean. The comparison keeps a copy and reads it after delete. Seseragi remove directly returns the new Set; do not expect a boolean from it.",
}
