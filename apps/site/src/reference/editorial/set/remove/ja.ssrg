import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "指定した値を除いたSetを返す",
  purpose: "要素を除くときにremoveを使います。値、Setの順に渡し、別のSetを結果として受け取ります。",
  reading: "[3,1,2]から1を除くと[3,2]です。その結果に1を入れると末尾に付き、[3,2,1]になります。元の値は[3,1,2]のままです。",
  boundaries: "存在しない9を除いても、要素と順序は変わりません。空のSetから除けば空のSetで、要素がないというエラーにはなりません。",
  rules: "残った要素の順序を保ちます。削除してから挿入し直すと、その要素は新たに末尾に入ります。EqとHashで一致する値を決め、入力は変えません。",
  mistake: "TSのdeleteはSetを変更してbooleanを返すため、比較例はコピーを持ち、deleteの後にそれを読みます。Seseragiのremoveが返すのは新しいSetであり、booleanではありません。",
}
