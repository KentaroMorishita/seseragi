import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Check that every required member is allowed",
  purpose: "Use isSubsetOf when every member of one Set must occur in another. Pass the allowed superset first and the values to check second.",
  reading: "Required members 2 and 1 both occur in allowed, so sets.isSubsetOf allowed required is true. Reversing the arguments is false because required does not contain 3.",
  boundaries: "An empty set of required values is always a subset, including of an empty Set. A nonempty required Set cannot be a subset of empty. The output demonstrates all three cases.",
  rules: "Order is irrelevant to this membership question. The check stops when a required member is absent, or succeeds after all are found. Inputs remain unchanged.",
  mistake: "The TS helper uses every(value => superset.has(value)) and takes values first. Seseragi takes superset first. Subset allows equality: it does not mean the required Set must be smaller.",
}
