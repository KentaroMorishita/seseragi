import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "値が含まれているかを確認する",
  purpose: "要素の有無を確かめるときにcontainsを使います。探す値、Setの順に渡します。",
  reading: "0は含まれるのでtrue、9は含まれずfalseです。空のSetを探してもfalseになります。",
  boundaries: "保存された0も、存在する要素です。保存された値との等しさを調べる操作であり、値を真偽として扱ったり、位置で要素を読んだりはしません。",
  rules: "Eq<A>とHash<A>で同じ要素を識別します。適切なハッシュなら平均的に一定の処理量で探せますが、多数の衝突があると走査が必要です。Setは変えません。",
  mistake: "TypeScriptではSet.hasが直接対応します。要素の有無が必要ならcontainsを使います。Arrayへ変換して位置を探すと、余分な処理が加わり、求める結果も変わります。",
}
