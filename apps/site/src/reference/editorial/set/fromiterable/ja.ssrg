import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "最初に現れた順序で重複を除く",
  purpose: "有限の入力から異なる値を集めるときにfromIterableを使います。各要素が最初に現れた位置で、結果の順序を決めます。",
  reading: "Arrayの[3, 1, 3, 2, 1]は[3,1,2]になります。次の入力は先頭にバッククォートを付けたListで、同じ順序の結果になります。",
  boundaries: "noValuesはArray<Int>と型を付けた空配列で、結果は空のSetです。同じ値が繰り返し現れても、先の要素を移動しません。",
  rules: "Iterable<C,A>は要素を順に読める入力という条件です。最後まで読むため、無限の入力では終了しません。EqとHashで同じ要素を識別し、元の入力は変えません。",
  mistake: "この整数の例ではTypeScriptのnew Set(sequence)も初出順を保ちます。TS側は二つの入力に通常の配列を使っており、SeseragiのList記法がTSにもあるという比較ではありません。",
}
