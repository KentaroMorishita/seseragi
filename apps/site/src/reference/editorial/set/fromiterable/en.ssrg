import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Remove duplicates while keeping first-seen order",
  purpose: "Use fromIterable to collect distinct values from a finite input. The first appearance of each member determines its output position.",
  reading: "The Array [3, 1, 3, 2, 1] becomes [3,1,2]. The second input is a List, written with a leading backtick, and gives the same order.",
  boundaries: "noValues is an explicitly typed empty Array<Int>; it produces an empty Set. Repeated values do not move earlier members.",
  rules: "Iterable<C,A> means the input can be read element by element. Reading continues to its end, so an endless input never finishes. Eq/Hash determine equal members; the source is unchanged.",
  mistake: "TypeScript new Set(sequence) also keeps first-seen order for these integers. The TS comparison uses ordinary arrays for both source sequences; it does not imply that TS has Seseragi List syntax.",
}
