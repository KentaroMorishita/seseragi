import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Read key/value pairs as an Array",
  purpose: "Use entries to keep each key beside its value when processing a Map as a sequence. The result is Array<(K, V)>: an Array of two-position tuples.",
  reading: "b is paired with 2, a with 2, and c with 3, in insertion order. A tuple (key, value) uses position to keep two different roles together.",
  boundaries: "Empty input returns an empty Array. Repeated values do not remove a pair because the keys are different.",
  rules: "Each entry is returned once in insertion order. The source Map is unchanged and work grows with its size. JSON displays each tuple as a two-element array in this output.",
  mistake: "TypeScript [...map.entries()] is the direct array-form counterpart. Seseragi returns a complete Array rather than an iterator. A tuple is still one pair; do not treat the outer array as alternating keys and values.",
}
