import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Compute a value for either a present or missing key",
  purpose: "Use upsert when the next value depends on whether a key already exists. Pass the key, the update function and the Map.",
  reading: "update receives Maybe<String>. Just value means the key exists, including when value is empty text; Nothing means it is absent. match chooses one branch and returns the String to store.",
  boundaries: "The empty key becomes existing:, name becomes existing:Aki, and missing is added with new. These are separate results derived from original, which stays unchanged.",
  rules: "The update function runs exactly once. An existing key keeps its position; a new key goes last. Returning a value stores it; this callback cannot request removal by returning Nothing because its result type is String here.",
  mistake: "The TS comparison uses has before get, so present empty text stays distinct from absence. It copies the Map before setting the computed value. Use remove for deletion and insert when the value does not need the old entry. In the presence-checked branch, the ! after get tells TypeScript that the value exists; it adds no runtime check. The preceding has call establishes presence.",
}
