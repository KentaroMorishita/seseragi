import { Editorial } from "../../model"
import { mapEditorial } from "../../map-model"
import * as en from "./en"
import * as ja from "./ja"

pub fn editorial -> Editorial =
  mapEditorial "std/map::upsert" "map-upsert" "[[\"empty\",\"existing:\"],[\"name\",\"Aki\"]]\n[[\"empty\",\"\"],[\"name\",\"existing:Aki\"]]\n[[\"empty\",\"\"],[\"name\",\"Aki\"],[\"missing\",\"new\"]]\n[[\"empty\",\"\"],[\"name\",\"Aki\"]]" (en.copy ()) (ja.copy ())
