import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Build a Map from key/value pairs",
  purpose: "Use fromEntries to turn a finite sequence of pairs into a lookup table. Each pair is written (key, value); the surrounding [] is an Array of pairs.",
  reading: "The input contains b twice, with values 2 then 9. The result keeps b first but gives it the final value 9; a remains second with value 1.",
  boundaries: "noPairs is an explicitly typed empty Array<(String, Int)>. It produces an empty Map. Duplicate keys do not add extra entries.",
  rules: "The input is read in order to its end. The last value for an equal key wins, while its first position is retained. Eq/Hash identify keys and Iterable means the input can be read element by element. Endless input does not finish.",
  mistake: "TypeScript new Map(pairs) has the same duplicate-key behavior for these String keys. This function expects pairs, not object properties; first convert an object to pairs if that is your source.",
}
