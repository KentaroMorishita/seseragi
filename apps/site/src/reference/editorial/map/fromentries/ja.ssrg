import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "キーと値の組からMapを作る",
  purpose: "有限の値の組を対応表にするときにfromEntriesを使います。各組は(key, value)と書き、外側の[]はその組を入れたArrayです。",
  reading: "bが値2、値9の順で二度現れます。結果ではbの先頭の位置を保ち、値を最後の9にします。aは二番目で値1です。",
  boundaries: "noPairsはArray<(String, Int)>と型を明示した空配列です。結果は空のMapになります。キーが重複しても項目数は増えません。",
  rules: "入力を順番に最後まで読みます。同じキーの値は最後のものを採用し、位置は最初のままです。EqとHashでキーを識別し、Iterableは要素を順に読める入力という条件です。無限の入力では終了しません。",
  mistake: "このStringキーの例ではTypeScriptのnew Map(pairs)も同じ重複処理です。受け取るのは値の組であり、オブジェクトのプロパティではありません。必要なら先にプロパティを組へ変換してください。",
}
