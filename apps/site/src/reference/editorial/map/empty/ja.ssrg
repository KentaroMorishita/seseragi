import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "キーと値が0組のMapを作る",
  purpose: "まだ項目がない対応表を作るときにemptyを使います。Map<String, Int>はキーがString、値がIntという型です。",
  reading: "valuesにMap<String, Int>という型を付けています。maps.empty ()には、意味のある情報を持たないUnitの値()を渡します。entriesは[]、sizeは0、teaというキーの確認はfalseになります。",
  boundaries: "空でもキーと値の型はあります。この例では型注釈で指定し、後から行う操作によって型が分かる場合もあります。",
  rules: "空の対応表を返します。後でinsertを呼ぶと新しいMapを返し、この空の値自体に項目を追加することはありません。",
  mistake: "TypeScriptならnew Map<string, number>()が対応します。TSのMapは後から変更できますが、Seseragiの更新は新しい値を返します。型を決めるためだけの仮の項目は不要です。",
}
