import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "保存された値をArrayで読む",
  purpose: "キーは不要で、保存された値をすべて使うときにvaluesを使います。結果はArray<V>です。",
  reading: "bとaはどちらも2、cは3を持つので、結果は[2,2,3]です。キーの挿入順に並び、同じ値も残します。",
  boundaries: "空のMapなら[]です。異なる値だけを集める操作ではなく、別のキーにある同じ値は別の要素として残ります。",
  rules: "Mapを変更せず、挿入順のArrayを作ります。処理量は項目数に応じて増えます。",
  mistake: "TypeScriptの[...map.values()]はiteratorを配列に集めます。SeseragiのvaluesはArrayを直接返します。どのキーにあった値かも必要ならentriesを使ってください。",
}
