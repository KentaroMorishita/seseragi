import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Mapのキーの数を数える",
  purpose: "キーと値の項目数が必要ならsizeを使います。異なる値の数や、これまで挿入した回数ではなく、キーの数を数えます。",
  reading: "入力にbは二度ありますが、残るキーはbとaなので2です。bの値を置き換えても2、新しいcを加えると3になります。",
  boundaries: "空のMapのsizeは0です。違うキーに同じ値が入っていても、それぞれ1項目として数えます。",
  rules: "sizeは一定の処理量で項目数を読みます。全項目をたどる必要はなく、Mapも変えません。",
  mistake: "TypeScriptはmap.sizeというプロパティを読み、Seseragiはmaps.size valuesと呼びます。空かどうかだけが必要なら、件数を取る代わりにisEmptyを使えます。",
}
