import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "キーがあるかを確認する",
  purpose: "保存された値は不要で、キーの有無だけを確認したいときにcontainsKeyを使います。キー、Mapの順に渡します。",
  reading: "zeroの値は0ですがキーは存在するので、最初はtrueです。missingは存在せずfalseになります。空のMapで探してもfalseです。",
  boundaries: "値が0、false、空文字列でも、キーがあれば存在する扱いです。キー自体がない場合とは区別します。",
  rules: "Eq<K>とHash<K>で同じキーを識別します。適切なハッシュなら平均的に一定の処理量で探せますが、ハッシュがすべて衝突する場合は走査が必要です。Mapは変えません。",
  mistake: "TypeScriptではMap.hasが対応します。Boolean(map.get(key))で代用すると、保存された0もないものとして扱ってしまいます。値も必要ならgetを使ってください。",
}
