import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "項目を追加する・値を置き換える",
  purpose: "キーと値を対応付けるときにinsertを使います。キー、値、元のMapの順に渡し、返されたMapを更新後の値として使います。",
  reading: "bを9に置き換えても、bはaの前のままです。cを追加すると最後に入ります。originalの表示はb=2とa=1のままで、元の値は変わりません。",
  boundaries: "空のMapへの挿入は1項目を作ります。既存キーの値を置き換えても、キーの数と位置は変わりません。",
  rules: "EqとHashで同じキーを探します。既存キーの位置を保ち、新しいキーを末尾に加えます。元のMapを変更せず、新しい対応表を返します。",
  mistake: "TypeScriptのMap.setは対象を変更するため、比較例ではnew Map(original)でコピーしてからsetします。どちらもoriginalを保つ例です。Seseragiのinsertの戻り値を使わなければ、元のMapは更新されません。",
}
