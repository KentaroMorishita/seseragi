import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Add an entry or replace its value",
  purpose: "Use insert to associate a key with a value. Pass key, value and source Map; keep the returned Map as the updated result.",
  reading: "Replacing b with 9 keeps b before a. Adding c puts it last. Printing original confirms it still contains b=2 and a=1.",
  boundaries: "Inserting into an empty Map creates one entry. Replacing an existing key does not change the number of keys or move its position.",
  rules: "Equal keys are found using Eq/Hash. Existing positions are preserved and new keys append. Updates return a new mapping without changing the source.",
  mistake: "TypeScript Map.set mutates its receiver, so the comparison copies new Map(original) before set. Both versions therefore preserve original. Ignoring the return of Seseragi insert does not update the old Map.",
}
