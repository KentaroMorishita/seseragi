import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "キーを保って値を変換する",
  purpose: "検索用のキーを保ったまま、保存された値を一つずつ変えるときにmapValuesを使います。centsはユーロ単位の整数を受け取り、100倍した整数を返します。",
  reading: "teaとcakeの値は200と500になります。次の表示で、元の値が2と5のままであることも確認できます。",
  boundaries: "空のMapなら空のMapを返し、centsは呼びません。結果の値の型は、入力の値の型と違っていても構いません。",
  rules: "関数には値だけを渡し、挿入順に各項目で一度呼びます。キーとその順序を保ち、処理量は項目数に応じます。",
  mistake: "TSの例は項目の組を変換して新しいMapにし、キーも明示的に引き継ぎます。Seseragiの関数が受け取るのは値だけです。ここでは小さな整数だけを使い、小数の金額や丸め方は扱っていません。",
}
