import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "重複するキーの扱いを決めてMapを合わせる",
  purpose: "二つのMapに同じキーがあり得るときにmergeWithを使います。呼び出す順は、まとめる関数、右のMap、左のMapです。関数には左の値、右の値の順に渡します。",
  reading: "combineは二つの文字列を/でつなぎます。mergeWith combine right leftではbを先頭に保ち、aをL-a/R-aにまとめてからcを追加します。Mapの引数を交換すると開始順序も変わり、aはR-a/L-aになります。",
  boundaries: "右が空なら左と同じ対応関係、左が空なら右と同じ対応関係になります。両方の元のMapも表示し、変わっていないことを確認します。",
  rules: "左の順序を保ち、右だけのキーを右の順番で末尾に追加します。共通キーごとに関数を一度呼び、leftValue、rightValueの順に渡して、結果を左の位置に保存します。",
  mistake: "TSの関数はmerged(left, right)と呼びますが、Seseragiはrightを先に渡します。明示したforとMapのコピーで同じ処理をしています。項目を展開するだけでは、文字列をまとめずに重複キーを上書きします。 getの後の!は、その分岐では値があるとTypeScriptに伝える記号で、実行時の確認は追加しません。直前のhasで存在を確かめています。",
}
