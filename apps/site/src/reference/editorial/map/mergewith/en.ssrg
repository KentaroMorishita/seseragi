import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "Combine two Maps with an explicit duplicate-key rule",
  purpose: "Use mergeWith when both Maps may contain the same key. The call order is resolver, right Map, left Map. The resolver receives the left value first, then the right value.",
  reading: "combine joins two strings with /. mergeWith combine right left keeps b first and combines a as L-a/R-a, then appends c. Swapping the Map arguments changes both the starting order and a to R-a/L-a.",
  boundaries: "An empty right leaves the left mapping; an empty left gives the right mapping. Both original Maps are printed unchanged.",
  rules: "The left order is preserved. Right-only keys append in right order. Each shared key calls the resolver once with leftValue and rightValue, and its result stays in the left position.",
  mistake: "The TS helper is intentionally called merged(left, right), while Seseragi takes right before left. Its explicit loop and copied Map preserve the same semantics. Spreading entries alone would overwrite duplicates rather than combine the strings. In the presence-checked branch, the ! after get tells TypeScript that the value exists; it adds no runtime check. The preceding has call establishes presence.",
}
