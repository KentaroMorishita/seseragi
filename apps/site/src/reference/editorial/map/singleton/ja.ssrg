import { ApiCopy } from "../../model"

pub fn copy -> ApiCopy = ApiCopy {
  summary: "キーと値を1組入れてMapを作る",
  purpose: "最初の項目が分かっているときにsingletonを使います。キー、その値の順に渡します。",
  reading: "maps.singleton \"tea\" 2はteaに2を対応付けます。entriesは1組、sizeは1を表示します。次のMapはemptyというキーに空文字列を入れます。",
  boundaries: "空文字列も保存された値であり、項目がない場合とは違います。singletonは必ずキーが一つあるMapを作ります。項目0個ならempty ()を使います。",
  rules: "キーの等しさとハッシュで同じキーを識別します。Eq<K>とHash<K>は、その二つの方法がそろっているという条件です。標準のStringキーには用意されています。",
  mistake: "TypeScriptならnew Map([[\"tea\", 2]])で同じ項目を表せます。Mapはキーと値の対応表であり、位置で読む値の組や、自由なプロパティを持つオブジェクトとは使い方が違います。",
}
