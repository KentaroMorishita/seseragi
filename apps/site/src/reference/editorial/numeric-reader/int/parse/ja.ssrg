import { CorrectionCopy } from "../../../correction-model"

pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "十進整数の文字列全体を読みます。成功はRight Int、形や範囲の誤りはLeft IntParseErrorです。",
  taskTitle: "個数の入力を最後まで読む",
  purpose: "設定欄の12pxを12個として受け入れないようにします。parseは途中まで読めた整数を返すのではなく、文字列全体を検査します。この例は失敗理由を一つの表示文にまとめます。",
  setup: "import * as intsでstd/intの操作をints.parseのように呼べます。fnは関数の宣言です。describeCountのtext: Stringは入力文字列、-> Stringは表示文の型です。関数名の後ろに引数を空白で区切って書きます。",
  after: [
    "Either<IntParseError, Int>には、成功したIntを持つRightと、失敗理由を持つLeftがあります。matchが枝を選び、Right countで中の整数をcountと名付けます。Left _は理由を使わず同じ文を返します。",
    "+12は12に、-0は0になります。012と12pxは失敗し、最大値を1超えた入力も失敗します。ints.formatは整数を文字列にし、+で表示文につなげます。pub effect fn mainが実行入口です。fnは関数の宣言で、effectは表示のような処理を実行する指定です。do内のprintlnを上から順に実行し、文字列と改行を表示します。"
  ],
  comparisonBefore: "TypeScriptは正規表現で同じ十進表記に限定し、Number.isSafeIntegerで範囲を確かめます。number | undefinedは数値か不在のどちらかという意味で、この例のundefinedは入力の失敗を表します。",
  comparisonAfter: "表示する六行は同じです。parseIntは12pxの先頭を読めるため、この入力検査の代わりにはなりません。Seseragiのparseには検査と失敗理由が用意されていますが、この比較は詳細な診断まで同一とは主張しません。",
  details: [
    "受け入れる形は、任意の+か-に続く0、または1から9で始まるASCIIの十進数字です。空文字、前後の空白、012、12.0、1_000、0x10は受け入れません。必要なら空白を取り除く処理を呼び出し側で先に選びます。",
    "Intの範囲は-9007199254740991から9007199254740991までです。小数、NaN、無限大、負のゼロは入りません。負の整数は有効なので、個数を正数に限る条件は別に確かめます。",
    "空文字の失敗はEmptyInt、不正な文字はInvalidIntDigit、範囲外はIntOutsideRangeです。InvalidIntDigitのoffsetはUTF-8のバイト位置、radixは基数で、このparseでは10です。共通のIntParseErrorにあるInvalidIntRadixは基数を受け取る別のAPIで使います。",
    "Leftは投げられた例外ではありません。matchで表示、再入力などを選べます。文字の誤りと範囲外が同じ入力にあるとき、常に文字の誤りが先に報告されるとは限りません。"
  ],
  codeTitle: "完全なプログラム",
  outputTitle: "Seseragiの実行結果",
  comparisonTitle: "TypeScriptの例と比べる",
  detailTitle: "入力と結果、間違いやすい点"
