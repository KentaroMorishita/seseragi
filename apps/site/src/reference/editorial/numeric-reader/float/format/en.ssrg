import { CorrectionCopy } from "../../../correction-model"

pub fn copy -> CorrectionCopy = CorrectionCopy {
  summary: "Turn a Float into short decimal text that can be read back. Preserve negative zero and represent special values without choosing fixed precision or locale formatting.",
  taskTitle: "Write Float text that can be read back",
  purpose: "Use format when a measurement needs a text representation for storage. It takes one Float and returns a String that can be read back as the same value. Rather than choosing two decimal places for presentation, it chooses a spelling that identifies the value.",
  setup: "import * as floats names std/float. floats.format 12.5 is a call with a space separating the function name and its argument. Both 12.5 and 12.0 are Float values. pub effect fn main declares the public entry point that runs output operations; fn declares a function. do runs println in order, printing each string returned by format on its own line.",
  after: [
    "The first two lines are 12.5 and 12.0. A Float without a fractional part gets .0 when the output does not use an exponent. The third line, -0.0, is negative zero. Float distinguishes positive and negative zero, and format preserves the sign. Parentheses group the negative value as one argument.",
    "1e21 means one times ten to the power 21. Exponent notation uses lowercase e, omits + for positive exponents, and has no unnecessary leading zeroes in the exponent. format displays this value as 1e21.",
    "floats.nan (), floats.positiveInfinity () and floats.negativeInfinity () produce NaN, positive infinity and negative infinity. () is a Unit value, used when no ordinary input data is needed. NaN is a value indicating that a calculation did not produce a valid number. The last three lines show that these also have text representations."
  ],
  comparisonBefore: "String(value) is the concise ordinary TypeScript way to turn a number into text. The comparison uses standard string conversion on the same numeric values. It does not add a custom formatter just to reproduce Seseragi spelling. The final export {} makes this example an independent module without changing the calculation.",
  comparisonAfter: "12.5, NaN and both infinities have the same output. TypeScript String displays 12 as 12, negative zero as 0, and 1e21 as 1e+21. Seseragi format produces 12.0, -0.0 and 1e21 respectively. These are different spelling rules, not a change to the supplied numbers. However, String(-0) does not preserve the sign for reading back.",
  details: [
    "For finite values, format uses the shortest decimal representation that reads back to the same 64-bit binary value. Integer-shaped output without an exponent gets .0. Reading back means preserving the Float value; it does not establish that the decimal arithmetic before formatting was exact.",
    "The original text passed to parse is not retained. For example, parsing 001.5 and then formatting it gives 1.5. The sign of -0.0 is preserved, but different internal NaN representations and signs all become the single output NaN.",
    "format does not reject non-finite values. Check isFinite first if storing NaN or an infinity would be inappropriate for a measurement. format itself returns a String directly from a Float, without a separate failure alternative.",
    "A common mistake is expecting 12.5 to become 12.50. Fixed decimal places, digit grouping, currency signs and localized decimal separators are outside this function. Distinguish it from presentation operations such as TypeScript toFixed or Intl.NumberFormat."
  ],
  codeTitle: "Complete program",
  outputTitle: "Seseragi output",
  comparisonTitle: "Read the TypeScript counterpart",
  detailTitle: "Input and result rules, and common mistakes",
}
