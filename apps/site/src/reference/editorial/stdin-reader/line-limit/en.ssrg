import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "LineLimit holds a checked maximum number of UTF-8 bytes for one line. Create it with lineLimit or defaultLineLimit and pass it to readLineWith.",
  taskTitle: "Reuse a checked four-byte limit",
  purpose: "Read abcd, abcde, and ok in order, reporting only the line that exceeds four bytes. Focus on the difference between the integer 4 and the LineLimit obtained after checking it.",
  typescriptBefore: "The TypeScript comparison counts UTF-8 bytes with TextEncoder after node:readline has returned a string. It compares ordinary input with a limit, but does not bound the read before that string is built or detect malformed input bytes.",
  benefit: "Pass a value checked by lineLimit as a LineLimit. The reading operation can focus on the input line rather than rechecking whether a raw integer is a valid configuration.",
  reading: [
    "The Right limit branch of stdin.lineLimit 4 receives the value representing a four-byte limit. Left problem means the configuration is invalid, so the input-reading branch is not entered.",
    "The argument in reportLine limit: stdin.LineLimit is not an Int. Pass the same limit to reportLine three times to apply the same maximum to every line.",
    "abcd is accepted at four bytes; abcde fails at five bytes. The following ok can still be read, giving Line: abcd, Line exceeds 4 bytes, and Line: ok."
  ],
  details: [
    "LineLimit keeps its representation private. Use the successful value from lineLimit 4 rather than accessing an internal field or passing the integer 4 directly to readLineWith.",
    "The limit counts UTF-8 bytes, not characters. The single character 😀 occupies four bytes and is accepted by this limit. An LF or CRLF line ending is excluded from the count.",
    "lineLimit accepts values from 1 through 67,108,864 bytes. If the standard 1,048,576-byte limit is suitable, defaultLineLimit () supplies that checked value."
  ]
}
