import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "LineLimitは、一行に許すUTF-8のバイト数を確認済みの形で持つ型です。lineLimitかdefaultLineLimitで作り、readLineWithへ渡します。",
  taskTitle: "確認した四バイトの上限を繰り返し使う",
  purpose: "abcd、abcde、okを順に読み、四バイトを超えた行だけを報告します。ここでは整数の4と、確認後に得られるLineLimitの違いを見ます。",
  typescriptBefore: "TypeScriptの比較では、node:readlineが文字列を返してからTextEncoderでUTF-8のバイト数を数えます。通常の入力で上限を比較する例ですが、文字列を作る前の読み込み量を制限したり、壊れたバイトを検出したりする処理ではありません。",
  benefit: "一度lineLimitで確認した値をLineLimitとして渡せます。読み取る側は、生の整数について上限の妥当性を毎回確認する代わりに、入力の行を処理することに集中できます。",
  reading: [
    "stdin.lineLimit 4のRight limitで、四バイトの上限を表す値を受け取ります。Left problemなら上限の設定が不正なので、入力を読む分岐には入りません。",
    "reportLine limit: stdin.LineLimitの引数は、整数のIntではありません。同じlimitを三回のreportLineへ渡し、すべての行に同じ上限を使います。",
    "abcdは四バイトで受け付けられ、abcdeは五バイトで失敗します。その後のokは読めるので、表示はLine: abcd、Line exceeds 4 bytes、Line: okです。"
  ],
  details: [
    "LineLimitの内部の表現は非公開です。フィールドから数値を取り出したり、readLineWithに整数の4を直接渡したりせず、lineLimit 4の成功値を使います。",
    "上限は文字数ではなくUTF-8のバイト数です。😀は一文字でも四バイトなので、この上限で受け付けられます。LFまたはCRLFの行末は数に含みません。",
    "lineLimitが受け付ける範囲は1から67,108,864バイトまでです。標準の1,048,576バイトでよければdefaultLineLimit ()で確認済みの値を得られます。"
  ]
}
