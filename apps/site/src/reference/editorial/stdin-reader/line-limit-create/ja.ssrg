import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "lineLimitは、整数のバイト数を確認し、使えるLineLimitかStdinConfigErrorを返します。1から67,108,864までを受け付けます。",
  taskTitle: "入力を読む前に上限の設定を確認する",
  purpose: "0、-1、1、67,108,864、67,108,865を順に確認し、使える範囲の両端と、範囲外の理由を表示します。この例は標準入力を読みません。",
  typescriptBefore: "TypeScriptでは数値が整数か、下限と上限の間かを条件分岐で確認できます。この比較も標準入力を使わず、五つの候補を順に検査してメッセージを返します。",
  benefit: "Seseragiでは、確認に通った結果をLineLimit型として持てます。設定の誤りを先に報告し、成功した値だけをreadLineWithに渡す流れを書けます。",
  reading: [
    "describeはIntを受け取り、stdin.lineLimit valueをmatchします。Right _は受け付けられた設定です。この例では読む処理に渡さないので、LineLimitの値そのものは使いません。",
    "0と-1はNonPositiveLineLimitになり、最低1バイトという案内を表示します。1と67,108,864はAccepted、67,108,865はLineLimitTooLargeになります。",
    "describe (-1)の括弧は負の整数を引数として渡す書き方です。lineLimitの引数はIntなので、小数のFloatをそのまま渡すことはできません。"
  ],
  details: [
    "lineLimitは設定を確認する普通の関数です。標準入力を消費せず、Stdinサービスも要求しません。このmainにConsoleがあるのは、結果を表示するためです。",
    "成功のRight limitを受け取ったら、そのlimitをreadLineWithへ渡せます。失敗のLeft側では、無効な設定値を修正してから読むようにできます。",
    "範囲の1と67,108,864はどちらも含まれます。ここで確認するのは一行の内容のバイト数であり、これから読む行が必ずその範囲に収まるという保証ではありません。"
  ]
}
