import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "lineLimit checks an integer byte count and returns either a usable LineLimit or a StdinConfigError. It accepts values from 1 through 67,108,864.",
  taskTitle: "Check the limit before reading input",
  purpose: "Check 0, -1, 1, 67,108,864, and 67,108,865 in order, displaying the accepted endpoints and the reasons for rejection. This example does not read standard input.",
  typescriptBefore: "In TypeScript, conditions can check whether a number is an integer between the minimum and maximum. This comparison also checks five candidates and returns messages without reading standard input.",
  benefit: "Seseragi gives the accepted result the type LineLimit. Report a configuration problem first, and pass only the successful value to readLineWith.",
  reading: [
    "describe accepts an Int and matches stdin.lineLimit value. Right _ is an accepted configuration. The example does not pass it to a reader, so it does not use the LineLimit value itself.",
    "0 and -1 produce NonPositiveLineLimit and a message requiring at least one byte. 1 and 67,108,864 produce Accepted; 67,108,865 produces LineLimitTooLarge.",
    "The parentheses in describe (-1) pass a negative integer as the argument. lineLimit takes an Int, so you cannot pass a Float directly."
  ],
  details: [
    "lineLimit is an ordinary function that checks configuration. It consumes no standard input and requires no Stdin service. This main needs Console to display its results.",
    "After receiving Right limit, pass that limit to readLineWith. The Left branch gives you a place to correct an invalid setting before reading.",
    "Both 1 and 67,108,864 are included in the accepted range. This checks a limit for line-content bytes; it does not guarantee that the next input line will fit within it."
  ]
}
