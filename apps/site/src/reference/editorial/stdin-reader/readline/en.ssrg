import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "readLine reads the next line of standard input with the default limit. It returns Just \"\" for a blank line and Nothing when no line remains.",
  taskTitle: "Read a label, a blank line, and end-of-input in order",
  purpose: "Pass parcel followed by one blank line and check the results of three reads. Each read returns one line, and the next call continues from that position.",
  typescriptBefore: "Node.js and Bun also let node:readline take successive lines from the same input. This comparison distinguishes an empty string yielded by the loop from the loop ending, then prints EOF for any remaining reads.",
  benefit: "Seseragi returns the presence or absence of a line as Maybe<String>. You use text only in the branch that has a string, handling missing input before displaying a label.",
  reading: [
    "The () in stdin.readLine () is its Unit argument. Executing the operation produces a result for one line. The Effect in its declaration identifies the required Stdin, possible StdinError, and successful Maybe<String>.",
    "Three executions of reportLine () advance through parcel, the blank line, and end-of-input. The _ in _ <- means the report’s return value is unused; it does not instruct the reader to skip an input line.",
    "The Just text branch is where text becomes available as a string. You cannot use the entire Maybe<String> as a String. Placing the blank-line branch first lets you choose its message separately."
  ],
  details: [
    "The ending LF and any CR immediately before it are removed from the returned string. A bare CR remains content. If input ends without a newline, any remaining content is returned as the final line.",
    "After the last line is consumed, a further call returns Nothing. Additional calls after end-of-input keep returning Nothing rather than replaying the last line.",
    "The content limit is 1,048,576 bytes per line. Use readLineWith for another limit. This qualified std/stdin example is for the process target; see the Prelude readLine page for the shorter spelling."
  ]
}
