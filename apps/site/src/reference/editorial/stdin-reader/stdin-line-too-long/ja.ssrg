import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "StdinLineTooLongは、一行の内容が設定したバイト数を超えた場合のStdinErrorです。limitBytesには、超えた上限の値が入ります。",
  taskTitle: "長すぎる行に許される上限を伝える",
  purpose: "四バイトまでのラベルを受け付け、abcdeには上限を伝えます。続くokも読むことで、長すぎた行の報告後に次の入力を扱う流れを確認します。",
  typescriptBefore: "TypeScriptでは、node:readlineの文字列をTextEncoderで数えてから上限を比べます。この比較は通常の入力に同じ案内を付けますが、すでに文字列になった後のチェックであり、読み取り中のバイト制限を再現しません。",
  benefit: "上限超過の形をmatchで選び、limitBytesから具体的な案内を作れます。空行や入力終了に対して、誤って短くするよう求めることも避けられます。",
  reading: [
    "stdin.lineLimit 4で作った上限を三回のreadLineWithに渡します。abcdは四バイトで通り、abcdeは五バイトなのでStdinLineTooLongになります。",
    "Left (stdin.StdinLineTooLong { limitBytes })で取り出すのは、設定した4です。実際の行の長さである5ではありません。表示はLine exceeds 4 bytesです。",
    "長すぎた行は、その行末または入力終了まで消費されています。次の読み取りはokに進みます。同じ呼び出しを繰り返しても、拒否された行を取り戻すことはできません。"
  ],
  details: [
    "上限は文字数ではありません。😀はUTF-8で四バイトなので、この例の上限に収まります。行末のLFやCRLFは内容の長さに含みません。",
    "この分岐は上限超過だけを扱います。UTF-8が不正な場合の分岐や、その他の入力失敗を扱うLeft _も残します。一行についてすべての問題が同時に返るという意味ではありません。",
    "StdinLineTooLong { limitBytes: 4 }はエラー値を作る式です。それだけでは入力を消費せず、読み取りを失敗させることもありません。この例のエラーはreadLineWithの実行結果から受け取ります。"
  ]
}
