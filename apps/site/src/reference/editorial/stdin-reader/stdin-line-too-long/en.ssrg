import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "StdinLineTooLong is the StdinError for line content exceeding the configured byte limit. Its limitBytes field carries that limit.",
  taskTitle: "Tell the user the allowed size of an oversized line",
  purpose: "Accept labels up to four bytes long and report the limit for abcde. Continue to read ok to show how the next input is handled after an oversized line.",
  typescriptBefore: "TypeScript counts the string returned by node:readline with TextEncoder and then compares it with the limit. This gives the same message for ordinary input, but checks an already-created string rather than reproducing the byte limit during reading.",
  benefit: "Match the size-failure shape and use limitBytes to give a concrete message. A blank line or end-of-input can keep its own message instead of incorrectly asking for shorter input.",
  reading: [
    "Pass the limit made by stdin.lineLimit 4 to three calls of readLineWith. abcd fits at four bytes; abcde produces StdinLineTooLong at five bytes.",
    "Left (stdin.StdinLineTooLong { limitBytes }) extracts the configured 4. It does not report the actual line length of 5. The message is Line exceeds 4 bytes.",
    "The oversized line has already been consumed through its line ending or end-of-input. The next read advances to ok. Repeating the call cannot recover the rejected line."
  ],
  details: [
    "This is not a character limit. 😀 occupies four UTF-8 bytes and fits the example’s maximum. An LF or CRLF line ending is excluded from the content length.",
    "This branch handles only a size failure. Keep the malformed-UTF-8 branch and the Left _ fallback for other input failures. This does not mean every problem in one line is reported simultaneously.",
    "StdinLineTooLong { limitBytes: 4 } constructs an error value. It does not itself consume input or cause a read to fail. This example receives the error from executing readLineWith."
  ]
}
