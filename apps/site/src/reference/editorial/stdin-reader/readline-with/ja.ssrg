import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "readLineWithは、指定したLineLimitの範囲で次の一行を読みます。長すぎる行を報告した後、続く行を読むこともできます。",
  taskTitle: "長すぎるラベルを報告し、次のラベルへ進む",
  purpose: "四バイトの上限でabcd、abcde、okを順に読みます。二行目だけを長すぎると報告し、三行目のokまで読む処理を作ります。",
  typescriptBefore: "TypeScriptでも、node:readlineが返した文字列をTextEncoderで数えれば、通常のUTF-8入力に同じ四バイトの判定を付けられます。ただし文字列を得てからの判定なので、行を読み込む途中の上限や不正なバイトの検出は含みません。",
  benefit: "Seseragiでは、確認済みの上限を読む操作に渡せます。読み取りが上限超過をStdinLineTooLongとして返すため、受け付けた行と失敗した行を同じmatchで扱えます。",
  reading: [
    "mainはstdin.lineLimit 4で上限を確認し、Right limitの場合だけ三回の読み取りへ進みます。reportLineは、そのlimitをstdin.readLineWithへ渡します。",
    "一行目のabcdは受け付けられます。二行目のabcdeはLeft (stdin.StdinLineTooLong { limitBytes })になり、Line exceeds 4 bytesと表示します。",
    "失敗した行の残りは行末または入力終了まで消費されます。三回目は二行目の続きをやり直すのではなく、次のokを読み、Line: okと表示します。"
  ],
  details: [
    "数えるのはUTF-8の内容のバイト数です。abcdも😀も四バイトで受け付けられます。行末のLF、またはCRLFは除かれますが、単独のCRは内容として数えます。",
    "上限内でも、壊れたUTF-8ならInvalidStdinUtf8になります。空行はJust \"\"、残りの行がなければNothingであり、どちらも上限超過ではありません。",
    "設定の上限だけを変えるならlineLimitに渡す整数を変えます。標準の1,048,576バイトでよければreadLine ()、またはreadLineWith (defaultLineLimit ())を使えます。"
  ]
}
