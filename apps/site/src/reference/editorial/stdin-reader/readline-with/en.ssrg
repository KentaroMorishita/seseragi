import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "readLineWith reads the next line within a supplied LineLimit. After reporting an oversized line, you can continue with the following line.",
  taskTitle: "Report an oversized label and move to the next one",
  purpose: "Read abcd, abcde, and ok with a four-byte limit. Report only the second line as too long and continue far enough to read the third label, ok.",
  typescriptBefore: "TypeScript can apply the same four-byte check to ordinary UTF-8 input by counting a node:readline string with TextEncoder. Because the check happens after a string is available, it does not limit buffering while the line is read or detect malformed bytes.",
  benefit: "Pass a checked limit to the reading operation. It returns an oversized line as StdinLineTooLong, allowing one match to handle both accepted lines and read failures.",
  reading: [
    "main checks the limit with stdin.lineLimit 4 and starts three reads only in the Right limit branch. reportLine passes that limit to stdin.readLineWith.",
    "The first line, abcd, is accepted. The second, abcde, produces Left (stdin.StdinLineTooLong { limitBytes }) and displays Line exceeds 4 bytes.",
    "The remainder of a rejected line is consumed through its line ending or end-of-input. The third read does not retry the rest of the second line: it reads ok and displays Line: ok."
  ],
  details: [
    "The count measures UTF-8 content bytes. Both abcd and 😀 occupy four bytes and are accepted. An LF or CRLF line ending is excluded, but a bare CR counts as content.",
    "A line within the limit can still fail with InvalidStdinUtf8 if its UTF-8 is malformed. A blank line gives Just \"\" and no remaining line gives Nothing; neither is a size failure.",
    "Change the integer passed to lineLimit to choose another maximum. For the standard 1,048,576-byte limit, use readLine () or readLineWith (defaultLineLimit ())."
  ]
}
