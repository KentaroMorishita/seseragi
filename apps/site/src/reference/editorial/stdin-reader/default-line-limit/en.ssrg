import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "defaultLineLimit returns the standard per-line limit of 1,048,576 bytes as a LineLimit. Use it to pass the readLine policy explicitly.",
  taskTitle: "Accept a label using the standard limit",
  purpose: "Read the short line parcel and display Line accepted. Instead of configuring a custom number, pass the standard LineLimit directly to readLineWith.",
  typescriptBefore: "The TypeScript comparison counts a string from node:readline with TextEncoder and compares it with 1,048,576 bytes. This checks an already-read string; it does not reproduce Seseragi’s limit during reading or its strict UTF-8 checks.",
  benefit: "Name the standard policy instead of repeating its numeric limit at each call. The result is a LineLimit ready for readLineWith, so no configuration-error branch is needed.",
  reading: [
    "The () in stdin.defaultLineLimit () is its Unit argument. Its returned LineLimit is passed directly to stdin.readLineWith.",
    "Right (Just _) handles a nonempty line here. The preceding Just \"\" branch already handles a blank line with Blank line, leaving other present lines to display Line accepted.",
    "For an oversized line, the StdinLineTooLong branch displays its limitBytes. End-of-input displays EOF, and other read failures display Input failed."
  ],
  details: [
    "The default is 1 MiB, or 1,048,576 bytes. Content of exactly that size is accepted; one byte more fails. An LF or CRLF line ending is excluded.",
    "This is a UTF-8 byte limit for each line. It is not a limit on the total input, waiting time, or memory used by the entire process.",
    "readLine () uses the same default limit. For a smaller application-specific limit, check a value with lineLimit and pass it to readLineWith."
  ]
}
