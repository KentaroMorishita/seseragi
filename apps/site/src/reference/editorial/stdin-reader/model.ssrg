import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { Editorial } from "../model"

pub struct StdinCopy {
  summary: String,
  taskTitle: String,
  purpose: String,
  typescriptBefore: String,
  benefit: String,
  reading: Array<String>,
  details: Array<String>
}

fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  [Paragraph ([Words (localized en ja)]) | (en, ja) <- arrays.zip japanese english]

fn paragraph english: String -> japanese: String -> Block =
  Paragraph ([Words (localized english japanese)])

fn link title: String -> route: String -> english: String -> japanese: String -> Block =
  Paragraph (
    [
      InternalLink (localized title title, route),
      Words (localized (": " + english) ("：" + japanese))
    ]
  )

pub fn stdinReaderEditorial identity: String
  -> namespace: String
  -> itemKind: String
  -> source: String
  -> english: StdinCopy
  -> japanese: StdinCopy
  -> Editorial =
  Editorial {
    identity,
    namespace,
    itemKind,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("stdin-task", localized english.taskTitle japanese.taskTitle),
        paragraph english.purpose japanese.purpose,
        Heading (
          "typescript-comparison",
          localized "Start with familiar TypeScript" "TypeScriptの処理から考える"
        ),
        paragraph english.typescriptBefore japanese.typescriptBefore,
        CodeExample (
          "stdin-reader-" + source + "-ts",
          localized "TypeScript · Node 24.19.0 / Bun 1.3.9"
            "TypeScript・Node 24.19.0 / Bun 1.3.9"
        ),
        Terminal (localized "TypeScript output" "TypeScriptの出力", output source),
        Heading (
          "seseragi-example",
          if source == "limit-config" then
            localized "Validate the setting in Seseragi" "Seseragiで設定を検証する"
          else
            localized "Read the input in Seseragi" "Seseragiで入力を読む"
        ),
        CodeExample (
          "stdin-reader-" + source,
          localized "Complete Seseragi program" "Seseragiの完全なプログラム"
        ),
        Terminal (localized "Seseragi output" "Seseragiの出力", output source),
        paragraph english.benefit japanese.benefit,
        Heading ("reading-the-example", localized "Read the important lines" "大事な行を読む")
      ],
      paragraphs english.reading japanese.reading,
      executionExplanation source,
      [
        Heading (
          "run-this-program",
          if source == "limit-config" then
            localized "Run the program" "プログラムを実行する"
          else
            localized "Supply input and run the program" "入力を渡して実行する"
        ),
        paragraph
            "Save each program with the filename used below. These commands use a POSIX shell. The TypeScript comparison runs with Bun; the separately compiled TypeScript was also checked with Node.js."
            "それぞれのプログラムを、下のコマンドにあるファイル名で保存します。コマンドはPOSIXシェル用です。TypeScriptの比較例はBunで実行でき、コンパイル後のコードはNode.jsでも確認しています。",
        Terminal (localized "Run locally" "ローカルで実行する", command source)
      ],
      inputExplanation source,
      boundaryRecipes identity,
      browserExplanation source,
      [Heading ("operation-rules", localized "Rules and common mistakes" "規則と間違いやすい点")],
      paragraphs english.details japanese.details,
      [Heading ("choose-next", localized "Choose the next operation" "次に必要な操作を選ぶ")],
      related identity,
      if itemKind == "module" then
        []
      else
        [Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")]
    ]
}

fn executionExplanation source: String -> Array<Block> =
  if source == "limit-config" then
    [paragraph
        "lineLimit checks a number immediately and returns Either: Right contains a checked LineLimit, while Left contains a configuration error. This check consumes no input. main only needs Console to print the results; its output can fail with ConsoleError."
        "lineLimitは数値をその場で調べ、Eitherを返します。Rightには検証済みのLineLimit、Leftには設定のエラーが入ります。この検証では入力を読みません。mainが必要とするのは結果を表示するConsoleだけで、出力はConsoleErrorで失敗する可能性があります。"]
  else
    [paragraph
        "pub effect fn main is the program entry. with declares the services supplied by the runner. In a do block, result <- effects.attempt (...) executes the read and makes its outcome available to match: Right contains the successful Maybe value; Left contains an input error. Within Right, Just text means a line is present and Nothing means EOF. The final println can still fail, so main declares fails ConsoleError. A handled input failure in these examples prints a report and exits successfully."
        "pub effect fn mainはプログラムの実行入口です。withには実行側が用意するサービスを書きます。doの中のresult <- effects.attempt (...)は読み取りを実行し、その結果をmatchで扱える形にします。Rightには成功時のMaybeの値、Leftには入力のエラーが入ります。Rightの中では、Just textが存在する行、Nothingが入力の終わりです。最後のprintln自体は失敗する可能性があるため、mainはfails ConsoleErrorと宣言します。この例で入力の失敗を処理した場合は、状況を表示して正常終了します。"]

fn output source: String -> String = match source {
  "one-line" -> "Line: parcel\n"
  "qualified-one-line" -> "Line: parcel\n"
  "three-lines" -> "Line: parcel\nBlank line\nEOF\n"
  "limited-lines" -> "Line: abcd\nLine exceeds 4 bytes\nLine: ok\n"
  "default-limit" -> "Line accepted\n"
  "limit-config" -> "Use at least 1 byte: 0\nUse at least 1 byte: -1\nAccepted\nAccepted\nUse at most 67108864 bytes: 67108865\n"
  _ -> ""
}

fn pipe source: String -> String = match source {
  "one-line" -> "printf 'parcel\\nignored\\n' | "
  "qualified-one-line" -> "printf 'parcel\\nignored\\n' | "
  "three-lines" -> "printf 'parcel\\n\\n' | "
  "limited-lines" -> "printf 'abcd\\nabcde\\nok\\n' | "
  "default-limit" -> "printf 'parcel\\n' | "
  _ -> ""
}

fn command source: String -> String =
  pipe source + "bun " + source + ".ts\n" + "seseragi build " + source + ".ssrg --target process --profile release --out-dir dist\n" + pipe source + "node dist/entry.js"

fn inputExplanation source: String -> Array<Block> =
  if source == "limit-config" then
    [paragraph
        "This program validates fixed numbers and does not read stdin. The release build records entry.js as its entry. Replace node with bun to run the generated program with Bun."
        "このプログラムは決めておいた数値を検証するだけで、標準入力は読みません。releaseビルドの実行入口はentry.jsです。生成されたプログラムをBunで実行するには、nodeをbunに替えます。"]
  else
    [
      paragraph
        "printf writes the shown synthetic text; \\n becomes a newline, and | connects that text to the program's standard input. printf then closes its end of the pipe. The release build records entry.js as its entry; replace node with bun to use Bun. Application arguments are not needed here."
        "printfは例にある架空の文字列を出力します。\\nは改行になり、|がその出力をプログラムの標準入力につなぎます。printfは出力後にパイプの送信側を閉じます。releaseビルドの実行入口はentry.jsです。Bunを使う場合はnodeをbunに替えます。この例ではアプリへの引数は必要ありません。",
      paragraph
        "Try a present blank line and no input separately. A blank line produces Blank line; an empty closed pipe produces EOF. The three-read examples also print EOF for each later read after the input ends."
        "空の行がある場合と、入力が一切ない場合を分けて試せます。空の行はBlank line、空のまま閉じたパイプはEOFになります。3回読む例では、入力が終わった後の読み取りでも毎回EOFを表示します。",
      Terminal (
        localized "Blank line, then empty input" "空の行、次に入力なしで実行",
        "printf '\\n' | node dist/entry.js\nprintf '' | node dist/entry.js"
      )
    ]

fn browserExplanation source: String -> Array<Block> =
  if source == "one-line" then
    [paragraph
        "The Playground link opens this exact source. It does not fill Input. Enter parcel on the first line and ignored on the second line in Input, then run: the result is Line: parcel. For Blank line, supply one newline; for EOF, clear Input completely. This browser input is finite text supplied by the host, not an interactive terminal or a way to submit arbitrary malformed UTF-8 bytes. The displayed output trims trailing whitespace."
        "Playgroundのリンクは、このソースを開きます。Input欄には自動で入力されません。Inputの1行目にparcel、2行目にignoredを入れて実行すると、Line: parcelと表示されます。Blank lineを試すには改行だけを一つ入れ、EOFを試すにはInputを完全に空にします。ブラウザーの入力は実行環境が渡す有限の文字列で、対話型ターミナルではありません。不正なUTF-8の生バイト列を渡すための欄でもありません。表示される出力は末尾の空白や改行が除かれます。"]
  else
    [paragraph
        "These std/stdin examples target a process host and have no browser Playground launch link. Use the Prelude readLine page for the separately verified finite-text Playground example."
        "これらのstd/stdinの例はprocess向けで、ブラウザーのPlaygroundで起動するリンクはありません。Playgroundで有限の文字列を読む検証済みの例は、PreludeのreadLineのページにあります。"]

fn boundaryRecipes identity: String -> Array<Block> =
  if identity == "std/stdin::InvalidStdinUtf8" then
    [
      paragraph
        "This process-only check supplies malformed bytes using octal escapes. The first line uses three bytes including its newline; the next line starts with a, so the invalid sequence starts at absolute byte offset 4. The handler reports it, and the following read reaches ok. This output belongs to the Seseragi program; native readline replaces these malformed bytes instead."
        "このprocess向けの確認では、8進数のエスケープで不正なバイト列を渡します。最初の行は改行を含めて3バイト、次の行はaで始まるため、不正な列の開始位置は入力全体の先頭から数えて4です。エラーを表示した後、次の読み取りでokに進みます。以下はSeseragiのプログラムの出力です。通常のreadlineは、この不正なバイト列を置換して文字列にします。",
      Terminal (
        localized "Supply malformed bytes to the process program"
        "process向けのプログラムに不正なバイト列を渡す",
        "printf 'ok\\na\\300\\200\\nok\\n' | node dist/entry.js"
      ),
      Terminal (
        localized "Seseragi error report and following line" "Seseragiでのエラーと次の行",
        "Line: ok\nInvalid UTF-8 at byte 4\nLine: ok\n"
      )
    ]
  else if identity == "std/stdin::LineLimit"
    || identity == "std/stdin::readLineWith"
    || identity == "std/stdin::StdinLineTooLong" then
    [
      paragraph
        "Try UTF-8 text at the four-byte boundary: 😀 occupies four bytes, éé occupies four, and ééa occupies five. Both complete comparison programs produce the following result for this valid text."
        "4バイトの境界をUTF-8の文字列で試します。😀は4バイト、ééも4バイト、ééaは5バイトです。この正しい文字列については、二つの完全な比較プログラムが次の結果を返します。",
      Terminal (
        localized "Try content byte counts" "内容のバイト数を試す",
        "printf '😀\\néé\\nééa\\n' | node dist/entry.js"
      ),
      Terminal (
        localized "Output at the four-byte boundary" "4バイトの境界での出力",
        "Line: 😀\nLine: éé\nLine exceeds 4 bytes\n"
      )
    ]
  else
    []

fn related identity: String -> Array<Block> = match identity {
  "std/prelude::readLine" -> [
    link "std/stdin" "/docs/library/stdin/"
      "choose an explicit line limit in a process program." "process向けのプログラムで行の上限を選びます。",
    link "readLine" "/docs/library/stdin/effect-function/readline/"
      "read successive lines with an explicit module import." "モジュールを明示して、続きの行を読みます。"
  ]
  "std/stdin::lineLimit" -> [
    link "LineLimit" "/docs/library/stdin/opaque-type/linelimit/"
      "use the checked limit." "検証済みの上限を使います。",
    link "StdinConfigError" "/docs/library/stdin/opaque-type/stdinconfigerror/"
      "explain an invalid setting." "設定が不正な理由を扱います。",
    link "readLineWith" "/docs/library/stdin/effect-function/readlinewith/"
      "apply the limit to input." "入力に上限を適用します。"
  ]
  "std/stdin::StdinConfigError" -> [
    link "lineLimit" "/docs/library/stdin/function/linelimit/" "validate a byte count."
      "バイト数を検証します。",
    link "StdinError" "/docs/library/stdin/opaque-type/stdinerror/"
      "handle a failure during reading." "読み取り中の失敗を扱います。"
  ]
  "std/stdin::LineLimit" -> limitLinks identity
  "std/stdin::defaultLineLimit" -> limitLinks identity
  "std/stdin::readLineWith" -> limitLinks identity
  "std/stdin::StdinLineTooLong" -> limitLinks identity
  "std/stdin::InvalidStdinUtf8" -> errorLinks identity
  "std/prelude::StdinError" -> errorLinks identity
  "std/prelude::Stdin" -> inputLinks identity
  "std/stdin::readLine" -> inputLinks identity
  "std/stdin" -> arrays.concat [inputLinks identity, limitLinks identity]
  _ -> []
}

fn inputLinks identity: String -> Array<Block> = arrays.concat [
  if identity == "std/prelude::readLine" then
    []
  else
    [link "readLine" "/docs/library/prelude/function/readline/"
        "start with the shorter Prelude form and finite Playground input."
        "短いPreludeの書き方と、Playgroundの有限の入力から試します。"],
  if identity == "std/prelude::Stdin" then
    []
  else
    [link "Stdin" "/docs/library/stdin/opaque-type/stdin/"
        "understand the input service." "入力サービスの宣言を読みます。"],
  if identity == "std/prelude::StdinError" then
    []
  else
    [link "StdinError" "/docs/library/stdin/opaque-type/stdinerror/"
        "distinguish failed input from EOF." "読み取りの失敗と入力の終わりを分けます。"]
]

fn limitLinks identity: String -> Array<Block> = arrays.concat [
  if identity == "std/stdin::lineLimit" then
    []
  else
    [link "lineLimit" "/docs/library/stdin/function/linelimit/"
        "validate the maximum content bytes per line." "1行の内容の最大バイト数を検証します。"],
  if identity == "std/stdin::defaultLineLimit" then
    []
  else
    [link "defaultLineLimit" "/docs/library/stdin/function/defaultlinelimit/"
        "keep the standard 1 MiB limit." "標準の1 MiBの上限を使います。"],
  if identity == "std/stdin::readLineWith" then
    []
  else
    [link "readLineWith" "/docs/library/stdin/effect-function/readlinewith/"
        "read using a checked limit." "検証した上限で読み取ります。"],
  if identity == "std/stdin::StdinLineTooLong" then
    []
  else
    [link "StdinLineTooLong" "/docs/library/stdin/constructor/stdinlinetoolong/"
        "handle an oversized line." "上限を超えた行を扱います。"]
]

fn errorLinks identity: String -> Array<Block> = arrays.concat [
  if identity == "std/stdin::InvalidStdinUtf8" then
    []
  else
    [link "InvalidStdinUtf8" "/docs/library/stdin/constructor/invalidstdinutf8/"
        "locate a malformed byte sequence." "不正なバイト列の位置を確認します。"],
  if identity == "std/stdin::StdinLineTooLong" then
    []
  else
    [link "StdinLineTooLong" "/docs/library/stdin/constructor/stdinlinetoolong/"
        "handle a line beyond its byte limit." "バイト数の上限を超えた行を扱います。"],
  if identity == "std/stdin::readLine" then
    []
  else
    [link "readLine" "/docs/library/stdin/effect-function/readline/"
        "continue with the next line after handling a failure." "失敗を処理した後、次の行を読みます。"]
]
