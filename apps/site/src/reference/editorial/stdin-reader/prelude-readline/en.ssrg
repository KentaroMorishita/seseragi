import { StdinCopy } from "../model"

pub fn copy _unit: Unit -> StdinCopy = StdinCopy {
  summary: "The Prelude readLine reads one line from standard input. Without importing std/stdin, you can distinguish a line of text, a blank line, and end-of-input.",
  taskTitle: "Read and display only the first label",
  purpose: "Pass parcel and ignored on separate lines and display only the first label, parcel. Also check what happens with empty input and with a single blank line.",
  typescriptBefore: "In Node.js or Bun, leaving a node:readline loop after the first line lets you handle that line before all input ends. This comparison also distinguishes an empty string from a missing line and closes readline after reading.",
  benefit: "Seseragi makes readLine available through the Prelude. Extract text only when a line was read, and choose separate messages for a blank line, end-of-input, and a read failure.",
  reading: [
    "The import in this example is for effects.attempt, which receives an input failure as a result. readLine, println, and Stdin come from the Prelude, so there is no std/stdin import.",
    "There is just one read. A parcel line displays Line: parcel, a blank line displays Blank line, and empty input displays EOF. Even if ignored follows parcel, the second line is not displayed.",
    "In Right (Just text), text is available as a string. The Left reason branch uses show reason to convert a failure from this Prelude readLine to its displayed form."
  ],
  details: [
    "The default limit is 1,048,576 content bytes per line. An LF or CRLF ending is removed from the returned string; a bare CR remains. Final content without a newline can also be read as a line.",
    "Just \"\" also fits the Just text pattern. Placing the blank-line branch first gives it the dedicated Blank line message instead of displaying an empty string after Line: .",
    "The ordinary input supplied here produces the same display as the TypeScript comparison. node:readline also treats a bare CR as a line separator and replaces malformed UTF-8. Seseragi preserves a bare CR and treats malformed UTF-8 as a read failure."
  ]
}
