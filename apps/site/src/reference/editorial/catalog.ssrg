import { editorial as windowsEditorial } from "./array/windows/page"
import { editorial as dropWhileEditorial } from "./array/dropwhile/page"
import { editorial as takeWhileEditorial } from "./array/takewhile/page"
import { editorial as findIndexEditorial } from "./array/findindex/page"
import { editorial as initEditorial } from "./array/init/page"
import { editorial as lastEditorial } from "./array/last/page"
import { editorial as reduceRightEditorial } from "./array/reduceright/page"
import { editorial as sortEditorial } from "./array/sort/page"
import { editorial as sortByEditorial } from "./array/sortby/page"
import { editorial as groupByEditorial } from "./array/groupby/page"

// Only exact compiler identities receive copy; shared description strings are untouched.
pub fn editorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match correctionEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterCorrectionEditorialFor symbol
  }

fn editorialAfterCorrectionEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match mapEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterMapEditorialFor symbol
  }

fn editorialAfterMapEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match unicodeReaderEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterUnicodeReaderEditorialFor symbol
  }

fn editorialAfterUnicodeReaderEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match regexEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterRegexEditorialFor symbol
  }

fn editorialAfterRegexEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match setEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterSetEditorialFor symbol
  }

fn editorialAfterSetEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match nonemptyIteratorEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterNonemptyIteratorEditorialFor symbol
  }

fn editorialAfterNonemptyIteratorEditorialFor symbol: ReferenceSymbol
  -> Maybe<Editorial> =
  match charTextEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterCharTextEditorialFor symbol
  }

fn editorialAfterCharTextEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match collectionTypeEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterCollectionTypeEditorialFor symbol
  }

fn editorialAfterCollectionTypeEditorialFor symbol: ReferenceSymbol
  -> Maybe<Editorial> =
  match dataValidationEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterDataValidationEditorialFor symbol
  }

fn editorialAfterDataValidationEditorialFor symbol: ReferenceSymbol
  -> Maybe<Editorial> =
  match numericReaderEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterNumericReaderEditorialFor symbol
  }

fn editorialAfterNumericReaderEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match resultFoundationEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterResultFoundationEditorialFor symbol
  }

fn editorialAfterResultFoundationEditorialFor symbol: ReferenceSymbol
  -> Maybe<Editorial> =
  match webReaderEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterWebReaderEditorialFor symbol
  }

fn editorialAfterWebReaderEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match filesystemReaderEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterFilesystemReaderEditorialFor symbol
  }

fn editorialAfterFilesystemReaderEditorialFor symbol: ReferenceSymbol
  -> Maybe<Editorial> =
  match effectSequencingEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> editorialAfterEffectSequencingEditorialFor symbol
  }

fn editorialAfterEffectSequencingEditorialFor symbol: ReferenceSymbol
  -> Maybe<Editorial> =
  match jsonReaderEditorialFor symbol {
    Just editorial -> Just editorial
    Nothing -> collectionEditorialFor symbol
  }

fn collectionEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  if symbol.namespace != "value"
    || symbol.itemKind != "function" then
    Nothing
  else if symbol.module == "std/array" then
    match symbol.identity {
  "std/array::empty" -> Just (arrayemptySequenceEditorial ())
  "std/array::singleton" -> Just (arraysingletonSequenceEditorial ())
  "std/array::fromIterable" -> Just (arrayfromIterableSequenceEditorial ())
  "std/array::zip" -> Just (arrayzipSequenceEditorial ())
  "std/array::zipWith" -> Just (arrayzipWithSequenceEditorial ())
  "std/array::unzip" -> Just (arrayunzipSequenceEditorial ())
  "std/array::chunksOf" -> Just (chunksOfEditorial ())
  "std/array::windows" -> Just (windowsEditorial ())
  "std/array::dropWhile" -> Just (dropWhileEditorial ())
  "std/array::takeWhile" -> Just (takeWhileEditorial ())
  "std/array::findIndex" -> Just (findIndexEditorial ())
  "std/array::init" -> Just (initEditorial ())
  "std/array::last" -> Just (lastEditorial ())
  "std/array::reduceRight" -> Just (reduceRightEditorial ())
  "std/array::sort" -> Just (sortEditorial ())
  "std/array::sortBy" -> Just (sortByEditorial ())
  "std/array::groupBy" -> Just (groupByEditorial ())
  _ -> Nothing
} else if symbol.module == "std/list" then match symbol.identity {
  "std/list::empty" -> Just (listemptySequenceEditorial ())
  "std/list::singleton" -> Just (listsingletonSequenceEditorial ())
  "std/list::fromIterable" -> Just (listfromIterableSequenceEditorial ())
  "std/list::zip" -> Just (listzipSequenceEditorial ())
  "std/list::zipWith" -> Just (listzipWithSequenceEditorial ())
  "std/list::unzip" -> Just (listunzipSequenceEditorial ())
  "std/list::chunksOf" -> Just (listchunksOfEditorial ())
  "std/list::windows" -> Just (listwindowsEditorial ())
  "std/list::dropWhile" -> Just (listdropWhileEditorial ())
  "std/list::takeWhile" -> Just (listtakeWhileEditorial ())
  "std/list::findIndex" -> Just (listfindIndexEditorial ())
  "std/list::init" -> Just (listinitEditorial ())
  "std/list::last" -> Just (listlastEditorial ())
  "std/list::reduceRight" -> Just (listreduceRightEditorial ())
  "std/list::sort" -> Just (listsortEditorial ())
  "std/list::sortBy" -> Just (listsortByEditorial ())
  "std/list::groupBy" -> Just (listgroupByEditorial ())
  _ -> Nothing
} else if symbol.module == "std/text" then match symbol.identity {
  "std/text::concat" -> Just (textconcatEditorial ())
  "std/text::join" -> Just (textjoinEditorial ())
  "std/text::split" -> Just (textsplitEditorial ())
  "std/text::contains" -> Just (textcontainsEditorial ())
  "std/text::startsWith" -> Just (textstartsWithEditorial ())
  "std/text::endsWith" -> Just (textendsWithEditorial ())
  "std/text::replace" -> Just (textreplaceEditorial ())
  "std/text::replaceAll" -> Just (textreplaceAllEditorial ())
  "std/text::trim" -> Just (texttrimEditorial ())
  "std/text::lines" -> Just (textlinesEditorial ())
  "std/text::lengthScalars" -> Just (textlengthScalarsEditorial ())
  "std/text::lengthBytes" -> Just (textlengthBytesEditorial ())
  "std/text::scalarAt" -> Just (textscalarAtEditorial ())
  "std/text::sliceScalars" -> Just (textsliceScalarsEditorial ())
  _ -> Nothing
} else Nothing

pub fn moduleEditorial specifier: String -> Array<Block> = arrays.concat [
  arrayModuleBlocks specifier,
  textModuleBlocks specifier,
  listModuleBlocks specifier,
  mapModuleBlocks specifier,
  unicodeReaderModuleBlocks specifier,
  regexModuleBlocks specifier,
  setModuleBlocks specifier,
  nonemptyIteratorModuleBlocks specifier,
  charTextModuleBlocks specifier,
  dataValidationModuleBlocks specifier,
  numericReaderModuleBlocks specifier,
  webReaderModuleBlocks specifier,
  filesystemReaderModuleBlocks specifier,
  effectSequencingModuleBlocks specifier,
  jsonReaderModuleBlocks specifier
]
