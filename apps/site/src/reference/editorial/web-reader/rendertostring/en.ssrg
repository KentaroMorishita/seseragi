import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "Serialize Html to a String with escaped text and attribute values.",
  taskTitle: "Obtain HTML text for a release card",
  purpose: "Convert an Html description to a String for a file or response. This example uses a quoted title attribute and text containing <script> and & so you can see where escaping happens.",
  setup: "The import provides html. fn paragraph takes no arguments and returns Html<Unit>; Unit means there is no useful event payload here. paragraph () calls it, and renderToString receives the resulting Html.",
  after: [
    "The result is a String. Text characters <, > and &, and attribute quotes and &, are escaped at output. The characters in café remain intact. The original String does not need to be changed first.",
    "Serialization does not print or insert anything into the DOM. println executed by pub effect fn main writes the result and a newline."
  ],
  details: [
    "If you first replace & with &amp;, that & will be escaped again. Pass the original text and attribute values rather than already HTML-escaped strings.",
    "The output omits event information such as onClick. Serializing a button does not start its event handling. Run app or another browser operation to handle clicks.",
    "The result contains the supplied structure without a doctype. Use renderDocument when you need the document preamble. Neither operation starts a web server or deploys a page."
  ],
  comparisonBefore: "TS templates can produce the same string. A correct helper or template library can supply the required escaping. Browser textContent does not parse its input as HTML.",
  comparisonAfter: "Seseragi provides a standard conversion from structured Html to String. This example establishes serialization rules, not browser rendering or security of an entire page."
}
