import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "childrenと任意の属性を持つ、要素への入力レコードを表します。",
  taskTitle: "本文と属性を名前付きの項目で渡す",
  purpose: "段落にclassとtitleを付け、hiddenを省略した場合、Falseの場合、Trueの場合を比べます。ElementPropsは共通の項目を持つレコードの型の別名です。",
  setup: "importでhtmlを読み込みます。fnは三つの引数なしの関数を定義し、-> html.Html<Unit>は有用なイベントの値を持たないHTMLを返す型注釈です。html.pへ{ ... }で名前付きの項目を渡します。Stringは文字列、BoolはTrueかFalseです。",
  after: [
    "childrenは必須で、段落の本文になります。classとtitleは指定したときに属性へ出力されます。項目の形を示す例として、hidden?: Boolの?は省略可能な真偽値、children: Cは型Cの必須項目を表します。下の「正確な宣言」は、項目を展開せず型の別名だけを表示しています。省略は、空文字列を渡すこととは異なります。",
    "hiddenを省略するかFalseにすると、hidden属性は出力されません。Trueではhidden属性が出力されます。文字列の\"false\"を書くのではなく、BoolのFalseを使います。mainのprintlnがrenderToStringの結果を順に出力します。 omitted ()、visible ()、hidden ()で各関数を呼び、doの中の出力を順に実行します。"
  ],
  details: [
    "hidden: \"false\"はBoolの欄にStringを渡すため、SES-T0101で拒否されます。hidden: Falseに直してください。見た目を隠す規則はブラウザが属性を読んだときに適用し、Htmlの作成自体は画面を変えません。",
    "ElementProps<Action, C>のActionはイベントで送る値の型、Cはchildrenに渡す値の型です。childrenにはStringやHtmlの配列などを使えます。何も入れない場合もchildren: ()と明示します。",
    "buttonのdisabledなど、要素固有の項目はその関数の宣言を確認します。共通項目の型だけで、すべての要素に任意の属性を指定できるわけではありません。"
  ],
  comparisonBefore: "TSのinterfaceにも必須の項目と?付きの省略可能な項目があります。型を読む考え方は同じです。",
  comparisonAfter: "ここではレコードを標準のHTML関数に渡すと、共通のシリアライザーがBoolの属性や文字列のエスケープを処理します。属性の並びを自分で組み立てる必要はありません。"
}
