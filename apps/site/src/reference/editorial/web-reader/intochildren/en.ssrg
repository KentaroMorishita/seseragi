import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "Choose no children, a String, one Html, an array of Html or a list of Html.",
  taskTitle: "Find what can go inside children",
  purpose: "children can receive plain text or elements you have already built. IntoChildren is the requirement that makes an input usable as ordered children. You can use these five supported forms without writing a custom definition.",
  setup: "The import provides html. Html<Unit> describes HTML with no useful event payload. children: () means no children, a String means one text child, and an Html means one child. Arrays use [ ... ]; lists use a leading backtick, as in `[ ... ].",
  after: [
    "Every element in an array or list is Html, and source order is preserved. html.text converts a String to Html when text needs to sit beside elements in the same collection. Empty input produces no children.",
    "let names a value, and its annotation fixes the Html type. pub effect fn main is the program entry; do runs the println operations in order to print the serialized results. Neither the IntoChildren conversion nor tag construction creates browser elements by itself."
  ],
  details: [
    "An array such as children: [\"Release\", detail] mixes String and Html and gets SES-T0101. The example fixes it with let label: html.Html<Unit> = html.text \"Release\", then children: [label, detail]. Keep the typed local: the tested CLI also rejects the directly nested text call in this mixed shape.",
    "Arbitrary numbers and records are not automatically converted to text. Use show to convert a printable number to a String, then html.text when an Html child is needed.",
    "In an element function’s declaration, such as p, where IntoChildren<C, Action> means the children input type C must be convertible to ordered children. Action is the type a later event may send; it does not change child order."
  ],
  comparisonBefore: "TS browser code can set textContent or append nodes and strings in order. That API has different accepted inputs from the array type used here.",
  comparisonAfter: "Seseragi accepts a String as the entire children value, but every item in a children array must be Html. Knowing where to insert html.text makes the mixed-array error straightforward to fix."
}
