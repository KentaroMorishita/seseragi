import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "childrenに渡せる値を、空・文字列・Html・Htmlの配列・Htmlのリストから選べます。",
  taskTitle: "子要素として何を渡せるか",
  purpose: "childrenには、本文だけでも、組み立てた要素でも渡せます。IntoChildrenは、その入力を順序付きの子要素として扱えることを示す条件です。独自の定義を覚えなくても、ここに示す五種類を使えます。",
  setup: "importでhtmlを読み込みます。Html<Unit>はイベントで有用な値を送らないHTMLです。children: ()は子なし、Stringは一つの本文、Htmlは一つの要素です。配列は[ ... ]、リストは先頭にバッククォートを付けた`[ ... ]で書きます。",
  after: [
    "配列とリストの要素はすべてHtmlで、書いた順に出力されます。html.textはStringをHtmlにするので、文字列と要素を同じ並びへ入れるときに使います。空の入力からは空の子要素列ができます。",
    "letで値に名前を付け、型注釈で各Htmlの型を確定します。pub effect fn mainが実行開始点で、doの中のprintlnが文字列化した結果を順に表示します。IntoChildrenの変換も、タグの構築も、それだけでブラウザに要素を作りません。"
  ],
  details: [
    "children: [\"Release\", detail]のようにStringとHtmlを混ぜるとSES-T0101になります。例ではlet label: html.Html<Unit> = html.text \"Release\"を定義し、children: [label, detail]に直しています。この型注釈付きの値を残してください。確認したCLIでは、textの呼び出しを直接配列へ入れる形も拒否されます。",
    "任意の数値やレコードを自動で文字列にはしません。数を本文にするならshowで文字列へ変換し、必要に応じてhtml.textで包みます。",
    "pなどの要素を作る関数の宣言で、where IntoChildren<C, Action>は、childrenに渡す型Cを順序付きの子要素へ変換できる必要がある、という意味です。Actionは後でイベントが送る値の型であり、子要素の順序を変える指定ではありません。"
  ],
  comparisonBefore: "TSのDOMではtextContentで本文を設定したり、appendでノードと文字列を順に追加したりできます。そのAPIと、ここで使う配列の型は異なります。",
  comparisonAfter: "Seseragiではchildren全体のStringは受け取れますが、配列の各要素はHtmlにそろえます。html.textを挟む場所を区別すると、混在の型エラーを直せます。"
}
