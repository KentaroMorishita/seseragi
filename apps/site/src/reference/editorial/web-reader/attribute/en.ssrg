import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "Validate an additional attribute name and return either an Attribute or a rejection reason.",
  taskTitle: "Add a data-release attribute and handle rejection",
  purpose: "Add a data-release marker to the card. attribute checks the name before returning an Attribute. Quotes and & in its value are still escaped when the HTML string is produced.",
  setup: "fn withTracking takes value: String and returns the final String. Supply attribute with the name and value separated by spaces. Its result has two possible forms: Right contains a usable attribute; Left contains a rejection reason.",
  after: [
    "match chooses the line matching the result. Right tracking names the contained attribute tracking. Pass it to section as attributes: [tracking] and serialize the section. Left error converts the reason to String with show. Writing both branches handles failure too.",
    "The second call uses the reserved name onclick and returns ReservedAttributeName onclick. The _ in Right _ means the contained value is unused. do in main executes each println in order."
  ],
  details: [
    "Use typed fields such as class: ... and title: ... for reserved attributes, and onClick for events. attribute does not bypass the reserved-name restrictions.",
    "The generic show conversion cannot print an Attribute itself; it has no Show instance. Instead of applying show to the whole result, consume Right by putting its attribute on an element, or display the reason in Left.",
    "Checking an attribute name is not validation of arbitrary CSS or URLs. attribute is not a raw-HTML escape hatch either. Pass the original value and let the serializer escape it at output."
  ],
  comparisonBefore: "TS browser code can use setAttribute for data-release. A handwritten string template needs correct quote escaping for attribute values as well as escaping for text content.",
  comparisonAfter: "This API reports name acceptance through Right or Left and delegates output escaping to the standard serializer. The caller still decides how to display a rejection."
}
