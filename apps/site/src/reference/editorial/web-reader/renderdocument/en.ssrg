import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "Prepend one doctype to the serialized Html you supply.",
  taskTitle: "Know what document rendering adds",
  purpose: "renderDocument performs the same HTML serialization as renderToString and prefixes <!doctype html>. It does not construct html, head or body elements for you.",
  setup: "The import provides html. fn paragraph takes no arguments and returns event-free Html<Unit>. Pass the result of paragraph () to renderDocument and print it with println in main.",
  after: [
    "The output is <!doctype html><p>Release</p>. One doctype is added, followed by the paragraph you supplied. This makes clear that the caller still supplies any complete document structure.",
    "For a full document, use functions such as html, head and body to construct the required elements before calling renderDocument. Supply the document title and other content yourself."
  ],
  details: [
    "Passing only a paragraph does not add html, head or body. A browser may insert elements while parsing; that is different from this function’s returned string. Inspect the string itself.",
    "The input is Html, not a previously rendered String. Pass the original Html once rather than concatenating repeated doctype-prefixed strings. Text and attribute escaping, and event omission, follow renderToString.",
    "The function only returns a string. It does not start a web server, mount a DOM tree or attach click handlers."
  ],
  comparisonBefore: "TS can produce the same result by prefixing <!doctype html> to correctly serialized HTML. The serialization still needs to be provided.",
  comparisonAfter: "Seseragi renderDocument combines that preamble with standard serialization. The caller decides which document elements to include."
}
