import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "HTMLの値を普通の関数で組み立て、文字列へ変換します。ブラウザでの表示は別の処理です。",
  taskTitle: "リリース案内を組み立てて出力する",
  purpose: "まず一つの段落を作り、HTML文字列を出力します。HTMLを文字列へ変換する処理を、ここではサーバー側レンダリング（SSR）と呼びます。この例はローカルで実行でき、Webサーバーもブラウザも使いません。",
  setup: "import * as htmlはstd/web/htmlをhtmlという名前で読み込みます。html.pの後の{ children: ... }は名前付きの項目を持つレコードです。childrenに段落の本文を渡します。関数の引数は空白で区切ります。",
  after: [
    "fn paragraphは引数を取らない関数の定義です。-> html.Html<Unit>は戻り値の型で、Unitはこの例に有用なイベントの値がないことを表します。=の後の式が戻り値です。paragraph ()で関数を呼び、html.pで構造を作り、renderToStringでStringへ変換します。どちらも出力や配置は行いません。",
    "pub effect fn mainは実行開始点です。printlnが文字列と改行を出力します。元の文字列の<notes>は、出力では&lt;notes&gt;になります。本文をHTMLタグとして解釈させないための変換です。",
    "次は同じ形を二回使います。fn cardはtitleとdetailという二つのStringを受け取り、-> html.Html<Unit>で示した型の値を返す関数です。ブロックの最後の式が戻り値になります。headingとdescriptionの型注釈は、この例で使うCLIが子要素の型を確定するために必要です。",
    "cardを二回呼び、fragmentで元の順序のまま並べます。fragment自体のタグは増えません。page ()は引数を取らないpageを呼び、二枚をまとめたHtmlを返します。再利用する部品は、特別な構文ではなく普通の関数です。"
  ],
  details: [
    "この静的な例では、入れ子のh2とpを型注釈なしで配列へ直接書くと、確認したCLI 0.61.19ではSES-T0201になります。上のheadingとdescriptionのHtml<Unit>を残してください。イベントを追加しなくても、この形なら実行できます。",
    "文字列をHtmlの子要素と配列に並べる場合は、先にlet label: html.Html<Unit> = html.text \"Release\"と定義し、配列の項目にlabelを使います。この型注釈付きの値を残してください。確認したCLI 0.61.19では、textの呼び出しを直接配列に入れる形は拒否されます。children全体がStringなら、そのまま渡せます。",
    "propsの型はhiddenに文字列を渡すような間違いを検出します。ただし、すべてのHTMLの入れ子やアクセシビリティを保証するものではありません。クリックで表示を変える場合は、下のappへ進めます。"
  ],
  comparisonBefore: "TypeScriptでも、interfaceでカードの項目を表し、普通の関数で再利用できます。次の例は同じ二枚を同じ順序で返します。escapeTextは本文の&、<、>を変換する小さな関数です。",
  comparisonAfter: "両方の実行結果は同じです。Seseragiでは標準のHtmlとrenderToStringが構造とエスケープを受け持ち、このTS例では文字列の組み立てとescapeTextを自分で書きます。TSのテンプレートライブラリにもエスケープを任せられます。ブラウザのtextContentも本文を安全に設定できます。"
}
