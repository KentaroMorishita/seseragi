import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "本文の文字列や子要素を持つ段落を作ります。",
  taskTitle: "リリースの説明文を段落にする",
  purpose: "「Search & navigation improvements」をp要素にします。説明文を渡してHtmlを得るだけなので、カードの中でも別の表示用の関数でも再利用できます。",
  setup: "importでhtmlという名前を付けます。fn descriptionは引数なしの関数で、-> html.Html<Unit>は有用なイベントの値を持たないHTMLを返す型注釈です。html.pへ{ children: ... }というレコードで本文を渡します。レコードは、TSのオブジェクトのように名前付きの項目を持つ値です。=の後の式が戻り値で、description ()で関数を呼びます。",
  after: [
    "段落を作った時点ではHtmlです。renderToStringは<p>と</p>を含むStringへ変換します。mainで実行するprintlnが、その文字列を改行付きで出力します。&は出力時に&amp;になります。",
    "childrenがStringなら、一つの本文としてそのまま渡せます。子なしの段落を意図するならchildren: ()を指定します。"
  ],
  details: [
    "宣言のActionは後でイベントから送る値の型、Cはchildrenに渡す入力の型です。where IntoChildren<C, Action>は、その入力を順序付きの子要素へ変換できる必要があることを示します。この例のActionはUnit、CはStringです。",
    "childrenを省略するのは、子なしの指定と同じではありません。pのchildrenは必須です。文字列をHtmlの子要素と配列に並べる場合は、先にlet label: html.Html<Unit> = html.text \"Release\"と定義し、配列の項目にlabelを使います。この型注釈付きの値を残してください。確認したCLI 0.61.19では、textの呼び出しを直接配列に入れる形は拒否されます。children全体がStringなら、そのまま渡せます。",
    "pの関数が受け取れる型と、ブラウザが許すHTMLの入れ子は別の規則です。別のpやsectionを段落内へ入れても、コンパイラがすべての不適切な構造を拒否するとは限りません。"
  ],
  comparisonBefore: "TSではp要素のtextContentへ同じ説明文を入れられます。テンプレートを使う場合も、本文を適切にエスケープする仕組みを選びます。",
  comparisonAfter: "ここでは標準のp関数とrenderToStringが、構造の値と文字列化を分けて扱います。元の文字列を書き換える必要はありません。"
}
