import { editorial as case0 } from "./html-module/page"
import { editorial as case1 } from "./html/page"
import { editorial as case2 } from "./elementprops/page"
import { editorial as case3 } from "./intochildren/page"
import { editorial as case4 } from "./section/page"
import { editorial as case5 } from "./h2/page"
import { editorial as case6 } from "./p/page"
import { editorial as case7 } from "./text/page"
import { editorial as case8 } from "./fragment/page"
import { editorial as case9 } from "./button/page"
import { editorial as case10 } from "./attribute/page"
import { editorial as case11 } from "./rendertostring/page"
import { editorial as case12 } from "./renderdocument/page"
import { editorial as case13 } from "./dom-module/page"
import { editorial as case14 } from "./app/page"

import { ReferenceSymbol } from "../../../model/build"
import { Block } from "../../../model/page"
import { Editorial, editorialBlocks } from "../model"

fn guarded symbol: ReferenceSymbol
  -> owner: String
  -> namespace: String
  -> kind: String
  -> value: Editorial
  -> Maybe<Editorial> =
  if symbol.module == owner
    && symbol.namespace == namespace
    && symbol.itemKind == kind then
    Just value
  else
    Nothing

pub fn webReaderEditorialFor symbol: ReferenceSymbol -> Maybe<Editorial> =
  match symbol.identity {
    "std/web/html::Html" -> guarded symbol "std/web/html" "type" "opaque-type" (case1 ())
    "std/web/html::ElementProps" -> guarded symbol "std/web/html" "type" "alias" (case2 ())
    "std/web/html::trait(IntoChildren)" -> guarded symbol "std/web/html" "trait" "trait" (case3 ())
    "std/web/html::section" -> guarded symbol "std/web/html" "value" "function" (case4 ())
    "std/web/html::h2" -> guarded symbol "std/web/html" "value" "function" (case5 ())
    "std/web/html::p" -> guarded symbol "std/web/html" "value" "function" (case6 ())
    "std/web/html::text" -> guarded symbol "std/web/html" "value" "function" (case7 ())
    "std/web/html::fragment" -> guarded symbol "std/web/html" "value" "function" (case8 ())
    "std/web/html::button" -> guarded symbol "std/web/html" "value" "function" (case9 ())
    "std/web/html::attribute" -> guarded symbol "std/web/html" "value" "function" (case10 ())
    "std/web/html::renderToString" -> guarded symbol "std/web/html" "value" "function" (case11 ())
    "std/web/html::renderDocument" -> guarded symbol "std/web/html" "value" "function" (case12 ())
    "std/web/dom::app" -> guarded symbol "std/web/dom" "value" "function" (case14 ())
    _ -> Nothing
  }

pub fn webReaderModuleBlocks specifier: String -> Array<Block> =
  editorialBlocks (match specifier {
    "std/web/html" -> Just (case0 ())
    "std/web/dom" -> Just (case13 ())
    _ -> Nothing
  }
)
