import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "Construct a second-level heading from text or child values.",
  taskTitle: "Give the card a real heading",
  purpose: "Make “Release <notes>” an h2 heading. The result describes an HTML h2 element rather than merely text intended to look bold.",
  setup: "html is the imported module name. fn heading defines a no-argument function; -> html.Html<Unit> states its return type as HTML without a useful event payload. children receives the String title. The expression after = supplies the result, and heading () calls the function. The { children: ... } is a record of named fields, like a TS object.",
  after: [
    "html.h2 { children: ... } returns Html. renderToString turns it into a String containing <h2> and </h2>; println in pub effect fn main prints it. The title’s < and > are escaped as text.",
    "Pass the result of heading () to a section’s children to give a card its title. Creating h2 alone does not create a browser element."
  ],
  details: [
    "In the declaration, Action is the type of value a later event may send; C is the children input type. where IntoChildren<C, Action> requires that input to be convertible to ordered children. Here Action is Unit and C is String.",
    "Passing \"<em>Release</em>\" as children will not create an em tag: a String is text content. If you need a nested element, build an Html with the corresponding HTML function.",
    "h2 is a second-level heading. Choose it in relation to the surrounding h1 and other headings, not just for text size. The compiler does not decide the document’s heading hierarchy for you."
  ],
  comparisonBefore: "TS browser code can also create an h2 with document.createElement(\"h2\") and set its title through textContent. That likewise inserts text without interpreting it as markup.",
  comparisonAfter: "This example instead builds a description and then serializes it. Browser display is a separate operation."
}
