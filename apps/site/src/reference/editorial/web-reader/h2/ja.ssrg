import { WebReaderCopy } from "../model"

pub fn copy -> WebReaderCopy = WebReaderCopy {
  summary: "文字列や子要素から、二段階目の見出しを作ります。",
  taskTitle: "カードのタイトルを見出しにする",
  purpose: "「Release <notes>」をh2見出しにします。単に太字に見える文字列ではなく、HTMLのh2要素を出力するための値を作ります。",
  setup: "htmlはimportで読み込んだモジュールの名前です。fn headingは引数なしの関数、-> html.Html<Unit>は有用なイベントの値を持たないHTMLを返す型注釈です。childrenにStringのタイトルを渡します。=の後の式が戻り値で、heading ()が関数の呼び出しです。 { children: ... }はレコードで、TSのオブジェクトのように名前付きの項目を持ちます。",
  after: [
    "html.h2 { children: ... }はHtmlを返します。renderToStringが<h2>と</h2>を含むStringに変換し、pub effect fn mainのprintlnが出力します。元のタイトルの<と>は本文としてエスケープされます。",
    "heading ()の戻り値をsectionのchildrenへ渡せば、カードの見出しにできます。h2を作るだけでは、ブラウザの要素はまだ作られません。"
  ],
  details: [
    "宣言のActionは後でイベントから送る値の型、Cはchildrenに渡す入力の型です。where IntoChildren<C, Action>は、その入力を順序付きの子要素へ変換できる必要があることを示します。この例のActionはUnit、CはStringです。",
    "childrenに\"<em>Release</em>\"を渡しても、emタグにはなりません。文字列は本文として扱います。入れ子の要素が必要なら、対応するHTML関数でHtmlを組み立てて渡します。",
    "h2は文書の二段階目の見出しです。文字の大きさだけで選ばず、周囲のh1や他の見出しとの関係を考えます。コンパイラが文書全体の見出し順を決めるわけではありません。"
  ],
  comparisonBefore: "TSのDOMでも、document.createElement(\"h2\")にtextContentでタイトルを設定できます。文字列をHTMLとして解釈せずに見出しへ入れる点は同じです。",
  comparisonAfter: "この例は実要素を作らず、h2の構造を値にしてから文字列へ変換します。ブラウザの表示は別の処理です。"
}
