import { localized, LocalizedText } from "../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  InternalLink,
  Paragraph,
  Terminal,
  Words
} from "../../model/page"
import { ApiCopy, Editorial } from "./model"

fn setup module: String -> LocalizedText =
  if module == "list" then
    localized "import * as lists gives std/list the name lists. let names a value. Calls separate arguments with spaces. `[10, 20] is a List literal: the backtick before the square bracket distinguishes it from the Array literal [10, 20]. A List keeps values in order and links each element to the rest. List<Int> holds integers; List<String> holds strings." "import * as listsはstd/listをlistsという名前で読み込みます。letで値に名前を付けます。呼び出しでは、引数を空白で区切ってください。`[10, 20]はListの値を直接書く記法で、角括弧の前のバッククォートがArrayの[10, 20]との違いです。Listは値を順番に持ち、各要素から残りの部分へつながります。List<Int>は整数、List<String>は文字列の一覧です。"
  else
    localized "import * as arrays gives std/array the name arrays. let names a value. Calls separate arguments with spaces. [10, 20] writes an Array value directly; Array<Int> holds integers and Array<String> holds strings. A List is a different ordered collection, written with a backtick as `[10, 20]." "import * as arraysはstd/arrayをarraysという名前で読み込みます。letで値に名前を付けます。呼び出しでは、引数を空白で区切ってください。[10, 20]はArrayの値を直接書く記法です。Array<Int>は整数、Array<String>は文字列の配列を表します。Listも値を順番に持つ別の型で、`[10, 20]のようにバッククォートを付けて書きます。"

pub fn sequenceEditorial identity: String
  -> module: String
  -> exampleId: String
  -> output: String
  -> english: ApiCopy
  -> japanese: ApiCopy
  -> Editorial =
  Editorial {
    identity,
    namespace: "value",
    itemKind: "function",
    summary: localized english.summary japanese.summary,
    blocks: [
      Heading ("using-this-operation", localized "Use this operation" "この操作を使う"),
      Paragraph ([Words (localized english.purpose japanese.purpose)]),
      Paragraph ([Words (setup module)]),
      CodeExample (exampleId, localized "A normal case and its boundaries" "通常の入力と境界の例"),
      Paragraph (
        [Words (
          localized
            "pub effect fn main is the entry function. do runs the output steps in order. _ <- finishes a print before continuing; println writes a value and a newline. show converts a value to display text. The collection operations compute values without changing their inputs."
            "pub effect fn mainは実行入口です。doの中は出力の順に並び、_ <-は出力を終えて次へ進みます。printlnは値と改行を出力し、showは値を表示用の文字列に変えます。一覧を扱う操作そのものは、入力を変更しない計算です。"
        )]
      ),
      Terminal (localized "Output" "実行結果", output),
      Heading ("reading-the-example", localized "Read the example" "例を順に読む"),
      Paragraph ([Words (localized english.reading japanese.reading)]),
      Paragraph ([Words (localized english.boundaries japanese.boundaries)]),
      Heading ("operation-rules", localized "Rules and cost" "規則と処理量"),
      Paragraph ([Words (localized english.rules japanese.rules)]),
      Heading
            ("operation-mistakes", localized "Choose the right operation" "使い分けと間違いやすい点"),
      Paragraph ([Words (localized english.mistake japanese.mistake)]),
      Paragraph (
        [InternalLink (
          localized "Choose by the collection and result you need" "必要な一覧の型と結果から操作を選ぶ",
          "/docs/library/" + module + "/"
        )]
      ),
      Heading ("canonical-declaration", localized "Exact declaration" "正確な宣言")
    ]
  }
