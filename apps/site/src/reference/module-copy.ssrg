import { LocalizedText, localized } from "../model/locale"

pub fn modulePurpose specifier: String -> LocalizedText = match specifier {
  "std/prelude" -> localized "Everyday types, operators, and collection operations available without an import." "importを書かずに使える、基本の型・演算子・コレクション操作です。"
  "std/number" -> localized "Choose how a numeric operation rounds its result." "数値の計算で結果を丸める方法を指定します。"
  "std/int" -> localized "Calculate with bounded integers, parse text, and handle checked arithmetic failures." "範囲が定まった整数を計算・解析します。範囲外や0除算を値として扱う検査付き操作もあります。"
  "std/float" -> localized "Work with floating-point numbers and make conversions explicit." "浮動小数点数を計算・解析・分類し、他の数値型へ明示的に変換します。"
  "std/math" -> localized "Use mathematical functions on Float values." "Floatに対する数学関数を使います。三角関数の角度はラジアンです。"
  "std/array" -> localized "Transform ordered Array values, look up elements, and create new arrays without changing the original." "順序付きのArrayの要素を調べ、変換します。操作は元の配列を書き換えず、新しい値を返します。"
  "std/list" -> localized "Build and transform immutable lists whose tails can be shared." "末尾を共有できる不変のListを作り、要素を調べたり変換したりします。"
  "std/web/html" -> localized "Build HTML as typed values, then render it or use it in a browser application." "HTMLを型付きの値として組み立て、文書へ変換したりブラウザで表示したりします。"
  "std/web/svg" -> localized "Build SVG scenes and identify attributes that a browser application can update." "SVGの図形を組み立てます。ブラウザから更新する属性の指定も行えます。"
  "std/web/file" -> localized "Read browser File and Blob values and manage temporary object URLs." "ブラウザのFileやBlobを読み取り、データを指す一時的なURLを管理します。"
  "std/web/navigation" -> localized "Read and change browser location, history, and query parameters." "ブラウザの現在位置、履歴、URLのクエリーを取得・変更します。"
  "std/web/storage" -> localized "Read and write browser storage while representing missing keys and failures in the result type." "ブラウザの保存領域を読み書きします。キーがない場合や読み書きの失敗は、戻り値の型で区別します。"
  "std/web/dom" -> localized "Mount an application and connect typed updates to live browser elements." "アプリケーションをブラウザに配置し、型付きの更新を実際の要素へ反映します。"
  "std/signal" -> localized "Represent a current value that changes over time, derive other values, and manage subscriptions." "時間とともに変わる現在値を扱い、派生する値や購読を管理します。"
  "std/clock" -> localized "Read a monotonic clock and wait without blocking the whole application." "後戻りしない時計を読み、アプリケーション全体を止めずに指定時間を待ちます。"
  "std/time" -> localized "Represent durations and time values with explicit units and checked conversions." "時間の長さや時刻を表します。単位を明示し、値の範囲を検査して変換します。"
  "std/http" -> localized "Construct validated requests and send them through an HTTP client service." "検証済みのリクエストを作り、HTTPクライアントのサービスを通じて送信します。"
  "std/http/server" -> localized "Serve HTTP requests using a server service and explicit response values." "HTTPサーバーのサービスを使い、リクエストを受けて明示的なレスポンスを返します。"
  "std/http/multipart" -> localized "Build and read multipart HTTP bodies composed of separate fields or files." "複数のフィールドやファイルを持つ、multipart形式のHTTP本文を作成・読み取りします。"
  "std/sse" -> localized "Read server-sent event messages and represent their fields explicitly." "サーバーから送られるイベント（SSE）を読み、メッセージの各項目を扱います。"
  "std/websocket" -> localized "Exchange typed messages over a WebSocket connection and manage its lifetime." "WebSocket接続でメッセージを送受信し、接続の寿命を管理します。"
  "std/websocket/server" -> localized "Accept server-side WebSocket connections." "サーバー側でWebSocket接続を受け付けます。"
  "std/benchmark" -> localized "Measure repeated computations using explicit benchmark configuration." "計測条件を指定し、処理を繰り返して性能を測定します。"
  "std/big-int" -> localized "Use exact integers beyond the range of Int." "Intの範囲を超える整数を、丸めずに正確に扱います。"
  "std/bytes" -> localized "Represent immutable binary data and make copies or slices explicitly." "不変のバイナリデータを扱います。コピーや切り出しは明示的な操作で行います。"
  "std/bytes/base64" -> localized "Encode binary data as Base64 text or decode strict standard and URL-safe formats." "バイナリデータをBase64文字列に変換します。標準形式とURL向け形式を厳密に復号できます。"
  "std/bytes/hex" -> localized "Convert binary data to or from hexadecimal text." "バイナリデータと十六進文字列を相互に変換します。"
  "std/char" -> localized "Inspect and convert single Unicode scalar values." "Unicodeスカラー値一個を表すCharを調べたり変換したりします。"
  "std/child-process" -> localized "Start child processes and handle their input, output, exit, and lifetime." "子プロセスを起動し、入出力・終了結果・寿命を扱います。"
  "std/collection" -> localized "Share collection traversal and support reductions that can stop early." "コレクションを共通の方法でたどります。必要な結果が得られた時点で集計を止める操作もあります。"
  "std/console" -> localized "Write text to a console through an explicit service." "明示的なサービスを通じてコンソールへ文字列を出力します。"
  "std/decimal" -> localized "Use exact decimal numbers with explicit precision and rounding for inexact operations." "正確な十進数を扱います。有限桁で表せない計算には、精度と丸め方を明示します。"
  "std/deferred" -> localized "Share a result that will be supplied later between concurrent computations." "後で確定する一つの結果を、並行する処理の間で受け渡します。"
  "std/effect" -> localized "Describe computations with required services, recoverable failures, and success values." "必要なサービス・回復可能な失敗・成功値を持つ処理を表し、組み合わせます。"
  "std/either" -> localized "Represent and transform a failure value or a success value." "失敗のLeftと成功のRightを区別して、値を取り出したり変換したりします。"
  "std/entropy" -> localized "Obtain unpredictable bytes through an explicit entropy service." "予測できないバイト列を、明示的な乱数源のサービスから取得します。"
  "std/fs" -> localized "Read and write files through a filesystem service." "ファイルシステムのサービスを通じて、ファイルを読み書きします。"
  "std/iterator" -> localized "Produce and consume one value at a time." "値を一つずつ生成し、必要な分だけ取り出します。"
  "std/transformer/maybe" -> localized "Add the possibility of a missing result to another computation type." "別の種類の処理に、結果がない場合を扱う仕組みを加えます。"
  "std/transformer/either" -> localized "Add an explicit failure result to another computation type." "別の種類の処理に、明示的な失敗値を扱う仕組みを加えます。"
  "std/transformer/reader" -> localized "Read a shared environment while using another computation type." "別の種類の処理を使いながら、共通の環境を読み取ります。"
  "std/transformer/state" -> localized "Thread a state value through another computation type without implicit mutation." "別の種類の処理の中で状態を次へ受け渡します。通常の値を暗黙に書き換える操作ではありません。"
  "std/transformer/writer" -> localized "Accumulate output alongside values in another computation type." "別の種類の処理の中で、結果の値と合わせて追加の出力を蓄積します。"
  "std/json" -> localized "Parse, inspect, encode, and decode JSON with explicit failures and exact decimal numbers." "JSONを解析・構築し、値と相互に変換します。失敗を型で表し、数値は正確な十進数で扱います。"
  "std/log" -> localized "Write structured events with a level and named data fields." "重要度と名前付きの情報を持つ、構造化したログを出力します。"
  "std/map" -> localized "Store values by keys and create new maps when adding or removing entries." "キーで値を探すMapを扱います。追加や削除は元のMapを変えず、新しいMapを返します。"
  "std/maybe" -> localized "Represent a present or missing value without using null." "nullを使わず、値があるJustと値がないNothingを区別します。"
  "std/non-empty-list" -> localized "Work with lists guaranteed to contain at least one element." "要素が必ず一個以上あるリストを扱います。先頭を取り出す際に空の場合を考える必要がありません。"
  "std/path" -> localized "Validate and combine filesystem paths as values before using them." "ファイルシステムのパスを値として検証・結合してから使います。"
  "std/process" -> localized "Read process arguments, environment variables, and the working directory." "プロセスの引数、環境変数、作業ディレクトリを取得します。"
  "std/queue" -> localized "Exchange values between computations with optional capacity limits." "処理の間で値をキューに入れて受け渡します。容量の上限を設けることもできます。"
  "std/random" -> localized "Generate random values through a service, with checked ranges." "乱数のサービスから値を生成します。範囲指定が不正な場合は失敗として扱います。"
  "std/ref" -> localized "Keep mutable state inside Effect through explicit read and update operations." "Effectの中で変更できる状態を持ちます。読み取りと更新は明示的な操作です。"
  "std/regex" -> localized "Compile and use portable regular expressions with explicit compile errors." "移植可能な正規表現をコンパイルし、検索や置換に使います。不正なパターンはエラーの値になります。"
  "std/semaphore" -> localized "Limit how many concurrent computations may enter a protected operation." "特定の操作に同時に入れる処理の数を制限します。"
  "std/set" -> localized "Store unique values and combine or filter sets." "重複しない値の集合を扱い、結合・絞り込み・集合演算を行います。"
  "std/stdin" -> localized "Read process input with explicit byte limits and decoding failures." "プロセスの標準入力を読みます。バイト数の制限と文字の復号に失敗する場合を明示します。"
  "std/stream" -> localized "Produce a sequence of values through Effect and consume it incrementally." "Effectを使って値を順に生成し、すべてを待たずに少しずつ処理します。"
  "std/test" -> localized "Assert expected results and expected failures inside tests." "テストで、期待した結果や期待した失敗になったかを検査します。"
  "std/text" -> localized "Inspect, transform, and encode Unicode strings." "Unicodeの文字列を調べ、変換し、バイト列と相互に変換します。"
  "std/text/grapheme" -> localized "Handle user-perceived characters such as letters with combining marks." "結合文字などを含む、人が一文字と認識する単位で文字列を扱います。"
  "std/text/unicode" -> localized "Inspect Unicode categories and properties of characters." "文字のUnicode分類や属性を調べます。"
  "std/validation" -> localized "Validate independent inputs and collect multiple errors in source order." "独立した入力を検証し、複数のエラーを元の順序で集めます。"
  _ -> localized "Public operations from this standard module." "この標準モジュールが提供する公開操作です。"
}
