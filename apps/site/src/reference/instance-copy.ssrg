import * as arrays from "std/array"
import * as text from "std/text"
import { ReferenceSymbol } from "../model/build"
import { LocalizedText, localized } from "../model/locale"

fn operation name: String -> LocalizedText = match name {
  "Eq" -> localized "Compare two values for equality." "二つの値が等しいか調べられます。"
  "Ord" -> localized "Compare values and determine their order." "値を比較し、大小の順序を調べられます。"
  "Hash" -> localized "Compute a hash value for a value." "値のハッシュ値を計算できます。"
  "Show" -> localized "Convert a value to text for display." "値を表示用の文字列に変換できます。"
  "Debug" -> localized "Convert a value to text for debugging." "値をデバッグ用の文字列に変換できます。"
  "JsonEncode" -> localized "Convert a value to Json." "値をJsonに変換できます。"
  "JsonDecode" -> localized "Decode Json into a value of this type." "Jsonからこの型の値を読み取れます。"
  "Add" -> localized "Use + to add or combine values of these types." "この型の値を+で加算・結合できます。"
  "Sub" -> localized "Use - to subtract values." "値を-で減算できます。"
  "Mul" -> localized "Use * to multiply values." "値を*で乗算できます。"
  "Div" -> localized "Use / to divide values." "値を/で除算できます。"
  "Rem" -> localized "Use % to calculate a remainder." "値を%で割った余りを求められます。"
  "Pow" -> localized "Use ** to raise a value to a power." "値を**で累乗できます。"
  "Zero" -> localized "Obtain the zero value for this type." "この型の0に相当する値を取得できます。"
  "One" -> localized "Obtain the one value for this type." "この型の1に相当する値を取得できます。"
  "Semigroup" -> localized "Combine two values into one." "二つの値を一つに結合できます。"
  "Monoid" -> localized "Combine values and obtain an empty value that leaves another value unchanged when combined." "値を結合し、結合しても相手の値を変えない空の値を取得できます。"
  "Iterable" -> localized "Obtain the elements through an Iterator." "Iteratorを使って要素を順に取り出せます。"
  "Reducible" -> localized "Combine collection elements with an accumulated result." "コレクションの各要素を蓄積した値と組み合わせ、一つの結果を求められます。"
  "Functor" -> localized "Transform a contained value while preserving the outer kind and structure." "外側の種類と構造を保ち、中の値を変換できます。"
  "Applicative" -> localized "Wrap a value and apply a wrapped function to a wrapped argument." "値を包み、包まれた関数を同じ種類の引数に適用できます。"
  "Monad" -> localized "Choose a following computation from the value produced by a previous computation." "前の処理で得た値から、次に行う処理を選べます。"
  "Traversable" -> localized "Process the elements and combine their results while preserving the collection's structure." "要素ごとに処理を行い、元のコレクションの構造を保って結果をまとめられます。"
  _ -> localized "Use the operations declared by this trait for these types." "この型でtraitが定める操作を使えます。"
}

pub fn instanceSummary symbol: ReferenceSymbol -> LocalizedText = {
  let traitName = match arrays.head (text.split "<" symbol.name) {
    Just name -> name
    Nothing -> symbol.name
  }
  let purpose = operation traitName
  let japanese = symbol.name + "は、" + traitName + "の操作をこの型で使うための実装です。" + purpose.ja
  let english =
    symbol.name + " implements " + traitName + " for these types. " + purpose.en
  let condition = match symbol.instanceClass {
    "conditional" -> localized " The where clause lists additional implementations that the selected types must provide." "where節にある制約も満たす必要があります。型を当てはめて、そこで指定されたtraitの実装を確認してください。"
    "structural" -> localized " The compiler constructs this implementation from the operations available for the record fields or tuple elements." "レコードのフィールドやタプルの要素の型に対する実装を使い、コンパイラが全体の操作を組み立てます。"
    _ -> localized "" ""
  }
  localized (english + condition.en) (japanese + condition.ja)
}
