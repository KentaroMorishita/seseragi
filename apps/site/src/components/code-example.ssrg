import * as arrays from "std/array"
import * as html from "std/web/html"
import { Messages } from "../i18n/model"
import { BuildInput, ExampleSource, ReferenceSymbol } from "../model/build"
import { En, Ja, Locale, LocalizedText, localized, translate } from "../model/locale"
import { referenceSummary } from "../reference/catalog"
import { itemKindLabel } from "../reference/labels"
import { anchor } from "./primitives"

fn exampleMatches id: String -> example: ExampleSource -> Bool = example.id == id

fn referenceMatches identity: String
  -> namespace: String
  -> itemKind: String
  -> reference: ReferenceSymbol
  -> Bool =
  reference.identity == identity
  && reference.namespace == namespace
  && reference.itemKind == itemKind

fn renderValues locale: Locale -> values: Array<String> -> String =
  if arrays.length values == 0 then
    translate locale (localized "None" "なし")
  else
    join ", " values

fn referenceDescription<Action> locale: Locale
  -> reference: ReferenceSymbol
  -> html.Html<Action> =
  if reference.itemKind == "instance" then
    html.p {
      children: translate locale (referenceSummary reference)
}
  else
    match locale {
  En -> html.p { children: reference.description }
  Ja -> html.p { children: reference.descriptionJa }
}

fn renderExample<Action> messages: Messages
  -> locale: Locale
  -> title: LocalizedText
  -> example: ExampleSource
  -> html.Html<Action> =
  html.section {
    class: "code-panel",
    children: [
      html.div {
        class: "code-panel-header",
        children: arrays.concat [
          [html.span { class: "code-panel-title", children: translate locale title }],
          if example.playgroundUrl == "" then
            []
          else
            [html.div {
              class: "code-actions",
              children: anchor messages.openPlayground example.playgroundUrl
                "playground-link"
            }]
        ]
      },
      html.pre {
        children: [html.code {
          class: "seseragi-highlight",
          children: [html.span { class: part.className, children: part.text } | part <- example.highlighted]
        }]
      }
    ]
  }

pub fn codeExample<Action> input: BuildInput
  -> messages: Messages
  -> locale: Locale
  -> id: String
  -> title: LocalizedText
  -> html.Html<Action> =
  match arrays.find (exampleMatches id) input.examples {
    Nothing -> html.p {
      class: "site-build-error",
      children: "Missing canonical example: " + id
    }
    Just example -> renderExample messages locale title example
  }

fn renderReference<Action> locale: Locale
  -> reference: ReferenceSymbol
  -> html.Html<Action> =
  html.section {
    class: "api-reference",
    children: [
      html.div {
        class: "api-reference-heading",
        children: [html.div {
          children: [
            html.p {
              class: "api-reference-kind",
              children: translate locale (itemKindLabel reference.itemKind)
            },
            html.h2 { children: reference.name }
          ]
        }]
      },
      html.p { class: "api-reference-identity", children: reference.identity },
      html.div {
        class: "api-reference-metadata",
        children: [
          html.p {
            children: [
              html.strong { children: translate locale (localized "Module" "モジュール") },
              html.code { children: reference.module }
            ]
          },
          html.p {
            children: [
              html.strong {
                children: translate locale (localized "Type parameters" "型パラメーター")
              },
              html.code { children: renderValues locale reference.typeParameters }
            ]
          },
          html.p {
            children: [
              html.strong { children: translate locale (localized "Constraints" "制約") },
              html.code { children: renderValues locale reference.constraints }
            ]
          }
        ]
      },
      html.pre {
        children: [html.code {
          class: "seseragi-highlight",
          children: [html.span { class: part.className, children: part.text } | part <- reference.highlighted]
        }]
      },
      referenceDescription locale reference,
      html.h3 {
        children: translate locale (localized "How to read this declaration" "この宣言の読み方")
      },
      html.p {
        class: "reference-reading",
        children: translate locale (localized reference.reading.en reference.reading.ja)
      }
    ]
  }

pub fn apiReference<Action> input: BuildInput
  -> locale: Locale
  -> identity: String
  -> namespace: String
  -> itemKind: String
  -> html.Html<Action> =
  match arrays.find (referenceMatches identity namespace itemKind) (arrays.concat [value.items | value <- input.referenceModules]) {
    Nothing -> html.p {
      class: "site-build-error",
      children: "Missing compiler reference: " + identity + " · " + namespace + " · " + itemKind
    }
    Just reference -> renderReference locale reference
  }
