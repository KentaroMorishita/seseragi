import * as arrays from "std/array"
import * as html from "std/web/html"
import { Messages } from "../i18n/model"
import { BuildInput, ExampleSource, ReferenceSymbol } from "../model/build"
import { Locale, LocalizedText, translate } from "../model/locale"
import { referenceSummary } from "../reference/catalog"
import { anchor } from "./primitives"

fn exampleMatches id: String -> example: ExampleSource -> Bool = example.id == id

fn referenceMatches identity: String
  -> namespace: String
  -> itemKind: String
  -> reference: ReferenceSymbol
  -> Bool =
  reference.identity == identity
  && reference.namespace == namespace
  && reference.itemKind == itemKind

fn renderValues values: Array<String> -> String =
  if arrays.length values == 0 then "None" else join ", " values

fn renderExample<Action> messages: Messages
  -> locale: Locale
  -> title: LocalizedText
  -> example: ExampleSource
  -> html.Html<Action> =
  html.section {
    class: "code-panel",
    children: [
      html.div {
        class: "code-panel-header",
        children: arrays.concat [
          [html.span { class: "code-panel-title", children: translate locale title }],
          if example.playgroundUrl == "" then
            []
          else
            [html.div {
              class: "code-actions",
              children: anchor messages.openPlayground example.playgroundUrl
                "playground-link"
            }]
        ]
      },
      html.pre {
        children: [html.code {
          class: "seseragi-highlight",
          children: [html.span { class: part.className, children: part.text } | part <- example.highlighted]
        }]
      }
    ]
}

pub fn codeExample<Action> input: BuildInput
  -> messages: Messages
  -> locale: Locale
  -> id: String
  -> title: LocalizedText
  -> html.Html<Action> =
  match arrays.find (exampleMatches id) input.examples {
    Nothing -> html.p {
      class: "site-build-error",
      children: "Missing canonical example: " + id
    }
    Just example -> renderExample messages locale title example
  }

fn renderReference<Action> locale: Locale
  -> reference: ReferenceSymbol
  -> html.Html<Action> =
  html.section {
    class: "api-reference",
    children: [
      html.div {
        class: "api-reference-heading",
        children: [html.div {
          children: [
            html.p {
              class: "api-reference-kind",
              children: reference.category + " · " + reference.namespace + " · " + reference.itemKind
            },
            html.h2 { children: reference.name }
          ]
        }]
      },
      html.p { class: "api-reference-identity", children: reference.identity },
      html.div {
        class: "api-reference-metadata",
        children: [
          html.p {
            children: [
              html.strong { children: "Module" },
              html.code { children: reference.module }
            ]
          },
          html.p {
            children: [
              html.strong { children: "Type parameters" },
              html.code { children: renderValues reference.typeParameters }
            ]
          },
          html.p {
            children: [
              html.strong { children: "Constraints" },
              html.code { children: renderValues reference.constraints }
            ]
          }
        ]
      },
      html.pre {
        children: [html.code {
          class: "seseragi-highlight",
          children: [html.span { class: part.className, children: part.text } | part <- reference.highlighted]
        }]
      },
      html.p { children: translate locale (referenceSummary reference) }
    ]
  }

pub fn apiReference<Action> input: BuildInput
  -> locale: Locale
  -> identity: String
  -> namespace: String
  -> itemKind: String
  -> html.Html<Action> =
  match arrays.find (referenceMatches identity namespace itemKind) (arrays.concat [value.items | value <- input.referenceModules]) {
    Nothing -> html.p {
      class: "site-build-error",
      children: "Missing compiler reference: " + identity + " · " + namespace + " · " + itemKind
    }
    Just reference -> renderReference locale reference
  }
