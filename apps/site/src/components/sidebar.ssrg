import * as html from "std/web/html"
import * as arrays from "std/array"
import { Locale, localizedRoute, translate } from "../model/locale"
import {
  FlatSection,
  NavigationArea,
  NavigationGroup,
  NavigationSection,
  NestedSection,
  PageDefinition
} from "../model/page"
import { anchor } from "./primitives"

fn pageLink<Action> locale: Locale
  -> current: String
  -> page: PageDefinition
  -> html.Html<Action> =
  anchor (translate locale page.title) (localizedRoute locale page.path) (if page.id == current then
    "sidebar-link current"
  else
    "sidebar-link")

fn isCurrent current: String -> page: PageDefinition -> Bool = page.id == current

fn sectionIsCurrent current: String -> value: NavigationSection -> Bool =
  if value.overview.id == current then
    True
  else
    match arrays.find (isCurrent current) value.pages {
  Nothing -> False
  Just _ -> True
}

fn groupIsCurrent current: String -> value: NavigationGroup -> Bool =
  match arrays.find (sectionIsCurrent current) value.sections {
    Nothing -> False
    Just _ -> True
  }

fn areaIsCurrent current: String -> value: NavigationArea -> Bool =
  if value.landing.id == current then
    True
  else
    match arrays.find (groupIsCurrent current) value.groups {
  Nothing -> False
  Just _ -> True
}

fn sectionIsOpen current: String -> value: NavigationSection -> Bool =
  match value.kind {
    FlatSection -> True
    NestedSection -> sectionIsCurrent current value
  }

fn sectionChildLinks<Action> locale: Locale
  -> current: String
  -> value: NavigationSection
  -> Array<html.Html<Action>> =
  if sectionIsOpen current value then
    [pageLink locale current page | page <- value.pages]
  else
    {
  let empty: Array<html.Html<Action>> = []
  empty
}

fn section<Action> locale: Locale
  -> current: String
  -> value: NavigationSection
  -> html.Html<Action> =
  html.details {
    open: sectionIsOpen current value,
    class: "sidebar-section",
    children: [
      html.summary { children: translate locale value.title },
      html.nav {
        children: [
          pageLink locale current value.overview,
          html.div { children: sectionChildLinks locale current value }
        ]
      }
    ]
  }

fn group<Action> locale: Locale
  -> current: String
  -> value: NavigationGroup
  -> html.Html<Action> =
  html.details {
    open: groupIsCurrent current value,
    class: "sidebar-group",
    children: [
      html.summary { children: translate locale value.title },
      html.div { children: [section locale current item | item <- value.sections] }
    ]
  }

fn area<Action> locale: Locale
  -> current: String
  -> value: NavigationArea
  -> html.Html<Action> =
  html.details {
    open: areaIsCurrent current value,
    class: "sidebar-area",
    children: [
      html.summary { children: translate locale value.title },
      pageLink locale current value.landing,
      html.div { children: [group locale current item | item <- value.groups] }
    ]
  }

fn currentAreas current: String
  -> areas: Array<NavigationArea>
  -> Array<NavigationArea> =
  match arrays.find (areaIsCurrent current) areas {
    Nothing -> []
    Just value -> [value]
  }

pub fn sidebar<Action> locale: Locale
  -> current: String
  -> areas: Array<NavigationArea>
  -> html.Html<Action> =
  html.aside {
    class: "docs-sidebar",
    children: navigationTree locale current areas
  }

pub fn navigationTree<Action> locale: Locale
  -> current: String
  -> areas: Array<NavigationArea>
  -> Array<html.Html<Action>> =
  [area locale current item | item <- currentAreas current areas]
