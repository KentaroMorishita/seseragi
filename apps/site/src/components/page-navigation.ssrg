import * as arrays from "std/array"
import * as html from "std/web/html"
import { Messages } from "../i18n/model"
import { Locale, localizedRoute, translate } from "../model/locale"
import {
  NavigationArea,
  NavigationGroup,
  NavigationSection,
  PageDefinition
} from "../model/page"
import { anchor } from "./primitives"

fn isCurrent current: String -> page: PageDefinition -> Bool = page.id == current

fn sectionIsCurrent current: String -> value: NavigationSection -> Bool =
  value.overview.id == current
  || match arrays.find (isCurrent current) value.pages {
  Nothing -> False
  Just _ -> True
}

fn groupIsCurrent current: String -> value: NavigationGroup -> Bool =
  match arrays.find (sectionIsCurrent current) value.sections {
    Nothing -> False
    Just _ -> True
  }

fn areaIsCurrent current: String -> value: NavigationArea -> Bool =
  value.landing.id == current
  || match arrays.find (groupIsCurrent current) value.groups {
  Nothing -> False
  Just _ -> True
}

fn sectionPages value: NavigationSection -> Array<PageDefinition> = arrays.concat [
  [value.overview],
  value.pages
]

fn groupPages value: NavigationGroup -> Array<PageDefinition> =
  arrays.concat [sectionPages section | section <- value.sections]

fn areaPages value: NavigationArea -> Array<PageDefinition> = arrays.concat [
  [value.landing],
  arrays.concat [groupPages group | group <- value.groups]
]

fn separator<Action> unit: Unit -> html.Html<Action> = html.span {
  class: "breadcrumb-separator",
  children: "/"
}

fn currentLabel<Action> locale: Locale -> page: PageDefinition -> html.Html<Action> =
  html.span {
    class: "breadcrumb-current",
    children: translate locale page.title
  }

fn sectionTrail<Action> locale: Locale
  -> page: PageDefinition
  -> area: NavigationArea
  -> group: NavigationGroup
  -> section: NavigationSection
  -> Array<html.Html<Action>> =
  if section.overview.id == page.id then
    [
      anchor (translate locale area.title) (localizedRoute locale area.landing.path) "",
      separator (),
      html.span { children: translate locale group.title },
      separator (),
      currentLabel locale page
    ]
  else
    [
      anchor (translate locale area.title) (localizedRoute locale area.landing.path) "",
      separator (),
      html.span { children: translate locale group.title },
      separator (),
      anchor (translate locale section.title)
        (localizedRoute locale section.overview.path) "",
      separator (),
      currentLabel locale page
    ]

fn groupTrail<Action> locale: Locale
  -> page: PageDefinition
  -> area: NavigationArea
  -> group: NavigationGroup
  -> Array<html.Html<Action>> =
  match arrays.find (sectionIsCurrent page.id) group.sections {
    Nothing -> [currentLabel locale page]
    Just section -> sectionTrail locale page area group section
  }

fn areaTrail<Action> locale: Locale
  -> page: PageDefinition
  -> area: NavigationArea
  -> Array<html.Html<Action>> =
  if area.landing.id == page.id then
    [currentLabel locale page]
  else
    match arrays.find (groupIsCurrent page.id) area.groups {
  Nothing -> [currentLabel locale page]
  Just group -> groupTrail locale page area group
}

pub fn breadcrumbs<Action> locale: Locale
  -> page: PageDefinition
  -> areas: Array<NavigationArea>
  -> html.Html<Action> =
  html.nav {
    class: "breadcrumbs",
    children:
      match arrays.find (areaIsCurrent page.id) areas {
      Nothing -> [currentLabel locale page]
      Just area -> areaTrail locale page area
    }
}

fn adjacentPages current: String
  -> pages: Array<PageDefinition>
  -> (Maybe<PageDefinition>, Maybe<PageDefinition>) =
  match arrays.findIndex (isCurrent current) pages {
    Nothing -> (Nothing, Nothing)
    Just index -> (arrays.get (index - 1) pages, arrays.get (index + 1) pages)
  }

fn sequenceLink<Action> locale: Locale
  -> label: String
  -> className: String
  -> page: Maybe<PageDefinition>
  -> html.Html<Action> =
  match page {
    Nothing -> html.span { class: "reference-sequence-spacer", children: "" }
    Just target -> match html.parseWebUrl (localizedRoute locale target.path) {
      Left error -> html.span { class: "site-build-error", children: show error }
      Right url -> html.a {
        href: url,
        class: className,
        children: [
          html.span { children: label },
          html.strong { children: translate locale target.title }
        ]
      }
    }
  }

pub fn pageSequence<Action> messages: Messages
  -> locale: Locale
  -> page: PageDefinition
  -> areas: Array<NavigationArea>
  -> html.Html<Action> =
  match arrays.find (areaIsCurrent page.id) areas {
    Nothing -> {
      let empty: Array<html.Html<Action>> = []
      html.div { class: "reference-sequence", children: empty }
    }
    Just area -> match adjacentPages page.id (areaPages area) {
      (previous, next) -> html.nav {
        class: "reference-sequence",
        children: [
          sequenceLink locale messages.previousPage "reference-previous" previous,
          sequenceLink locale messages.nextPage "reference-next" next
        ]
      }
    }
  }
