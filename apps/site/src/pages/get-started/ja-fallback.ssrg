import { GuideCopy } from "./guide"

pub fn incomplete title: String -> summary: String -> GuideCopy = GuideCopy {
  title,
  summary,
  prerequisites: "このページの日本語本文は#630で整備中です。現時点では英語版を正本として参照してください。",
  actionTitle: "英語版の手順",
  expected: "コマンド・source・期待結果は英語版と同じ検証済みartifactを使います。",
  troubleshooting: "日本語版の不足は内容の省略を意味しません。英語版には前提、失敗時の確認項目、次の導線があります。",
  nextSummary: "次のページも同じroute identityで提供し、日本語本文は#630で完成させます。"
}

pub fn body -> String =
  "日本語本文は#630で整備中です。以下のcodeとcommandは英語版と同じ検証済みartifactです。"
