import { localized } from "../../../model/locale"
import {
  Article,
  BulletList,
  ExternalLink,
  InternalLink,
  PageDefinition,
  Words
} from "../../../model/page"
import { guideBlocks } from "../guide"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition = {
  let english = en.copy ()
  let japanese = ja.copy ()
  PageDefinition {
    id: "get-started.next",
    path: "/docs/get-started/next/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: guideBlocks english japanese [
      BulletList [
        [
          InternalLink (localized "Language Reference" "Language Reference", "/docs/language/"),
          Words (localized " for exact syntax, typing, and evaluation rules." " で構文・型付け・評価規則を確認します。")
        ],
        [
          InternalLink (localized "Standard Library" "標準ライブラリ", "/docs/library/"),
          Words (localized " for compiler-owned module and symbol signatures." " でmoduleとsymbolのsignatureを確認します。")
        ],
        [
          InternalLink (localized "Examples" "Examples", "/examples/"),
          Words (localized " for runnable source organized by task." " で目的別の実行可能sourceを確認します。")
        ],
        [
          ExternalLink (localized "Playground" "Playground", "https://seseragi.vercel.app/"),
          Words (localized " for editing and running a source file in the browser." " でbrowser上のsourceを編集・実行します。")
        ]
      ]
    ] (localized "Language Reference" "Language Reference")
      "/docs/language/"
  }
}
