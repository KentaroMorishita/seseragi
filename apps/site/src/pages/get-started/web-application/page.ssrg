import { localized } from "../../../model/locale"
import {
  Article,
  CodeExample,
  PageDefinition,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"
import { guideBlocks } from "../guide"
import { body as japaneseFallback } from "../ja-fallback"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition = {
  let english = en.copy ()
  let japanese = ja.copy ()
  PageDefinition {
    id: "get-started.web-application",
    path: "/docs/get-started/web-application/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: guideBlocks english japanese [
      Paragraph ([Words (localized (en.boundaryBody ()) (japaneseFallback ())) ]),
      CodeExample ("web-starter-main", localized "src/main.ssrg" "src/main.ssrg"),
      Terminal (localized "Start the development server" "development serverを起動", "seseragi dev --open")
    ] (localized "Where to go next" "次に進む")
      "/docs/get-started/next/"
  }
}
