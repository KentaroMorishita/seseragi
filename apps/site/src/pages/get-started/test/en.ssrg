import { GuideCopy } from "../guide"

pub fn copy -> GuideCopy = GuideCopy {
  title: "Test a project",
  summary: "Expose a typed test tree from the tests root and execute it with deterministic discovery and reporting.",
  prerequisites: "A package needs seseragi.toml, a tests directory, and a test target. The example below is the repository's executable test-discovery fixture.",
  actionTitle: "Run the canonical test project",
  expected: "The runner discovers the exported test.Test tree, executes the two cases, prints PASS lines in canonical discovery order, and exits with status 0.",
  troubleshooting: "If no case is selected, the command exits with a configuration error instead of succeeding vacuously. Duplicate full names, compile errors, and an incompatible target also stop before test execution.",
  nextSummary: "Compile a release-profile artifact and inspect the self-contained output directory."
}

pub fn treeBody -> String =
  "Tests are ordinary typed values. The runner executes a test body only after every test module compiles and discovery succeeds."
