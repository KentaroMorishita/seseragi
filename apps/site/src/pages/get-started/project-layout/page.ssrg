import { localized } from "../../../model/locale"
import { Article, PageDefinition, Paragraph, Terminal, Words } from "../../../model/page"
import { guideBlocks } from "../guide"
import { body as japaneseFallback } from "../ja-fallback"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition = {
  let english = en.copy ()
  let japanese = ja.copy ()
  PageDefinition {
    id: "get-started.project-layout",
    path: "/docs/get-started/project-layout/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: guideBlocks english japanese [
      Terminal (
        localized "Generated files" "生成されるfile",
        "hello-web/\n├── seseragi.toml\n├── seseragi.lock\n└── src/\n    ├── app.ssrg\n    └── main.ssrg"
      ),
      Paragraph ([Words (localized (en.manifestBody ()) (japaneseFallback ())) ]),
      Terminal (
        localized "Target and entry" "targetとentry",
        "[run]\nentry = \"main\"\ntarget = \"web\""
      )
    ] (localized "Run a program" "programを実行する")
      "/docs/get-started/run/"
  }
}
