import { GuideCopy } from "../guide"

pub fn copy -> GuideCopy = GuideCopy {
  title: "Project layout",
  summary: "Understand the manifest, lockfile, source root, application module, and host entry module as separate responsibilities.",
  prerequisites: "Create hello-web in the previous step. The layout below is the exact output contract of seseragi new web.",
  actionTitle: "Read the package from the root inward",
  expected: "seseragi.toml selects the main module and Web target. seseragi.lock fixes the resolved package and provider graph. app.ssrg owns state and view logic; main.ssrg connects the completed application to the DOM runtime.",
  troubleshooting: "Do not move source files without updating manifest paths and the lock. If the manifest or dependency graph changes, run seseragi lock update explicitly; build commands never rewrite the lock for you.",
  nextSummary: "See how run selects a process program and how Web packages use the dedicated development server."
}

pub fn manifestBody -> String =
  "The default source root is src. run.entry names a module path without the .ssrg suffix, and run.target records the package's logical target."
