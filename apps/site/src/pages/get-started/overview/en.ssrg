import { GuideCopy } from "../guide"

pub fn copy -> GuideCopy = GuideCopy {
  title: "Getting Started",
  summary: "Install Seseragi, run a real program, understand a package, and take the same source through testing and production.",
  prerequisites: "You do not need prior Seseragi experience. The journey starts with the host tools required to install the official CLI.",
  actionTitle: "Follow one executable path",
  expected: "At the end you will have run a console program, inspected a package, checked and tested source, and produced a self-contained Web build.",
  troubleshooting: "Do not skip ahead by copying generated output. Each step starts from source or a manifest and uses the official CLI boundary.",
  nextSummary: "Install the official CLI and confirm which version you are running."
}

pub fn pathBody -> String =
  "The guide is deliberately linear, but every step remains a stable page you can return to independently."
