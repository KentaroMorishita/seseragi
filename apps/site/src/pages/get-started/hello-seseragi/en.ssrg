import { GuideCopy } from "../guide"

pub fn copy -> GuideCopy = GuideCopy {
  title: "Hello, Seseragi",
  summary: "Run a public effectful entry point and observe its exact console output.",
  prerequisites: "The seseragi command must be available. Create an empty directory, save the canonical source below as main.ssrg, and run the command from that directory.",
  actionTitle: "Save and run the program",
  expected: "The process writes Hello, Seseragi! followed by one newline and exits successfully. main is public because it is the program entry point; println makes the console capability visible in its inferred type.",
  troubleshooting: "Run the command beside main.ssrg. A parse or type diagnostic names the source range that differs from the example; seseragi run does not execute a program that failed compilation.",
  nextSummary: "Move from a single file to a package with an explicit manifest and lockfile."
}

pub fn sourceBody -> String =
  "This is the exact source used by the canonical hello-world sample, not a screenshot or editor mockup."
