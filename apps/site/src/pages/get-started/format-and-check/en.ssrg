import { GuideCopy } from "../guide"

pub fn copy -> GuideCopy = GuideCopy {
  title: "Format and check code",
  summary: "Apply the canonical formatter and run semantic lint checks without conflating either command with execution.",
  prerequisites: "Point format at a Seseragi source file. Point lint at either a source file or package root; lint compiles the relevant program and reports configured warnings.",
  actionTitle: "Check first, then apply formatting",
  expected: "format --check exits successfully only when the file is already canonical. format rewrites that source deterministically. lint --deny-warnings makes either an error or warning fail the command.",
