import * as arrays from "std/array"
import { LocalizedText, localized } from "../../model/locale"
import {
  Block,
  Callout,
  CommonMistake,
  Heading,
  NextStep,
  Paragraph,
  Words
} from "../../model/page"

pub struct GuideCopy {
  title: String,
  summary: String,
  prerequisites: String,
  actionTitle: String,
  expected: String,
  troubleshooting: String,
  nextSummary: String
}

pub fn text english: String -> japanese: String -> LocalizedText =
  localized english japanese

pub fn guideBlocks english: GuideCopy
  -> japanese: GuideCopy
  -> action: Array<Block>
  -> nextTitle: LocalizedText
  -> nextPath: String
  -> Array<Block> =
  arrays.concat [
    [
      Heading ("before-you-begin", text "Before you begin" "始める前に"),
      Paragraph ([Words (text english.prerequisites japanese.prerequisites)]),
      Heading ("do-this", text english.actionTitle japanese.actionTitle)
    ],
    action,
    [
      Heading ("expected-result", text "Expected result" "確認できること"),
      Paragraph ([Words (text english.expected japanese.expected)]),
      Callout (
        CommonMistake,
        text "If it does not work" "うまくいかない場合",
        [Words (text english.troubleshooting japanese.troubleshooting)]
      ),
      NextStep (
        nextTitle,
        text english.nextSummary japanese.nextSummary,
        nextPath
      )
    ]
  ]
