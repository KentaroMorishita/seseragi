import { localized } from "../../../model/locale"
import { Article, PageDefinition, Terminal } from "../../../model/page"
import { guideBlocks } from "../guide"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition = {
  let english = en.copy ()
  let japanese = ja.copy ()
  PageDefinition {
    id: "get-started.install",
    path: "/docs/get-started/install/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: guideBlocks english japanese [
      Terminal (
        localized "Install from the canonical repository" "canonical repositoryからinstall",
        "cargo install \\\n+  --git https://github.com/KentaroMorishita/seseragi \\\n+  --locked \\\n+  seseragi-cli"
      ),
      Terminal (localized "Verify the executable" "CLIを確認", "seseragi --version")
    ] (localized "Hello, Seseragi" "Hello, Seseragi")
      "/docs/get-started/hello-seseragi/"
  }
}
