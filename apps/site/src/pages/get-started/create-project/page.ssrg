import { localized } from "../../../model/locale"
import { Article, PageDefinition, Paragraph, Terminal, Words } from "../../../model/page"
import { guideBlocks } from "../guide"
import { body as japaneseFallback } from "../ja-fallback"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition = {
  let english = en.copy ()
  let japanese = ja.copy ()
  PageDefinition {
    id: "get-started.create-project",
    path: "/docs/get-started/create-project/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: guideBlocks english japanese [
      Terminal (
        localized "Create and enter the package" "packageを作成して移動",
        "seseragi new web hello-web\ncd hello-web"
      ),
      Paragraph ([Words (localized (en.canonicalBody ()) (japaneseFallback ()))])
    ] (localized "Project layout" "project layout")
      "/docs/get-started/project-layout/"
  }
}
