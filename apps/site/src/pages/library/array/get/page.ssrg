import { LocalizedText, localized } from "../../../../model/locale"
import {
  ApiReference,
  Heading,
  PageDefinition,
  Paragraph,
  Reference,
  Words
} from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"

fn text english: String -> japanese: String -> LocalizedText =
  localized english japanese

pub fn page -> PageDefinition = PageDefinition {
  id: "library.array.get",
  path: "/docs/library/array/get/",
  kind: Reference,
  title: text (en.title ()) (ja.title ()),
  summary: text (en.summary ()) (ja.summary ()),
  blocks: [
    ApiReference "std/array::get",
    Heading ("behavior", text (en.behaviorTitle ()) (ja.behaviorTitle ())),
    Paragraph ([Words (text (en.behaviorBody ()) (ja.behaviorBody ()))])
  ]
}
