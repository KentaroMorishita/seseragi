pub fn title -> String = "標準ライブラリ"

pub fn summary -> String =
  "配列を絞り込む、JSONを読む、ファイルを保存する。やりたい処理から標準モジュールを選べます。下の一覧には、全63モジュールの役割と対象環境を載せています。"

pub fn chooseTitle -> String = "やりたい処理から選ぶ"

pub fn chooseBody -> String =
  "JavaScriptやTypeScriptで配列、文字列、関数を使っていれば、まず処理の目的から選べます。モジュール名は関連する操作をまとめた名前です。たとえばstd/textには、文字列を調べたり変換したりする関数があります。APIページでは引数の順序、戻り値、失敗する条件を確認してください。"

pub fn collectionsTitle -> String = "要素を探す、変換する、まとめる"

pub fn collectionsBody -> String =
  "順番のある値にはstd/arrayやstd/list、キーで値を探すならstd/map、重複を除くならstd/setを選びます。追加や変換で元のコレクションを書き換えるのではなく、新しい値を受け取ります。要素がない場合を表すMaybeは、値があるJustと値がないNothingを区別します。"

pub fn collectionsLinks -> String = " モジュールを比べる: "

pub fn collectionsCore -> String = " 配列とリストの書き方を確認する: "

pub fn collectionsGet -> String = " 位置を指定して要素を探す例: "

pub fn textTitle -> String = "文字列を処理する、JSONを読み取る"

pub fn textBody -> String =
  "文字列の分割や変換はstd/text、パターン検索はstd/regex、JSONの解析と値への変換はstd/jsonを使います。人が一文字と見る単位を数えたい場合はstd/text/graphemeを確認してください。JSONを読めたことと、必要な項目が正しい型で入っていることは別です。型に合わせて読み取る処理の失敗も扱います。"

pub fn textLinks -> String = " 文字列のモジュール: "

pub fn jsonLinks -> String = " JSONのモジュール: "

pub fn textCore -> String = " 失敗と成功の戻り値を読む: "

pub fn numbersTitle -> String = "数値の範囲を検査する、バイト列を扱う"

pub fn numbersBody -> String =
  "TypeScriptのnumberだけで考えず、整数のIntと浮動小数点数のFloatを分けて選びます。std/intやstd/floatには、範囲外をNothingで返す操作や、失敗の理由をLeftで返す操作があります。それぞれ成功時にはJustやRightに値が入るので、戻り値の型を確認してください。大きな整数にはstd/big-int、正確な十進数にはstd/decimal、バイナリデータにはstd/bytesとBase64・十六進数の変換モジュールを確認できます。"

pub fn numbersLinks -> String = " 数値と変換のモジュール: "

pub fn numbersCore -> String = " 値と型の使い分けを確認する: "

pub fn stateTitle -> String = "変わる状態を持つ、複数の処理を調整する"

pub fn stateBody -> String =
  "読み取りと更新を明示した状態にはstd/ref、処理間の値の受け渡しにはstd/queueやstd/deferred、同時に進める数の制限にはstd/semaphoreを使います。これらはEffectの中で使う操作です。Effectは実行する処理を表す値で、作っただけでは実行されません。通常の不変の値を、JavaScriptのオブジェクトのように直接書き換える仕組みではありません。"

pub fn stateLinks -> String = " 状態と並行処理のモジュール: "

pub fn stateCore -> String = " 実行の入口と成功・失敗を確認する: "

pub fn filesTitle -> String = "ファイルを使う、プロセスを動かす"

pub fn filesBody -> String =
  "std/pathでパスを検証・結合し、std/fsでファイルを読み書きします。std/fsはprocessとbrowserの両方が対象ですが、実行環境がFileSystemサービスを提供する必要があります。サービスは、その環境で使える機能を表す値です。ブラウザーで使えるという表示だけで、OS上の任意のファイルを読めるわけではありません。引数や環境変数にはstd/process、標準入力にはstd/stdin、別のプログラムの起動にはstd/child-processを使います。この三つはprocess専用です。"

pub fn filesLinks -> String = " ファイルとプロセスのモジュール: "

pub fn filesCore -> String = " 必要なサービスを渡す方法を確認する: "

pub fn webTitle -> String = "Web画面を作る、ネットワークで通信する"

pub fn webBody -> String =
  "std/web/htmlとstd/web/svgは画面の内容を値として組み立てるためのモジュールで、processでもbrowserでも使えます。実際のブラウザーの要素、移動、保存領域、ファイルを扱うstd/web/dom・navigation・storage・fileはbrowser専用です。HTTPクライアントのstd/httpは両方が対象で、HttpClientサービスが必要です。HTTPやWebSocketの接続を受け付けるserverモジュールはprocess専用です。"

pub fn webLinks -> String = " Webと通信のモジュール: "

pub fn webCore -> String = " 実行環境とサービスの境界を確認する: "

pub fn targetsTitle -> String = "対象環境と必要な知識を確認する"

pub fn targetsBody -> String =
  "下の「対象」はモジュールを使えるコンパイル先です。processはCLIから動かすプログラム、browserはブラウザー向けのプログラムを指します。両方の表示があっても、外部への読み書きには必要なサービスの提供が別途必要です。モジュールをimportしただけでは、そのサービスを用意したことにはなりません。"

pub fn prereqBody -> String =
  "まだ実行したことがなければ、最初のプログラムの手順を使えます。呼び出しの書き方だけ知りたい場合は、関数呼び出しの説明へ進めます。状態や入出力を扱うときにはEffectの説明が役立ちますが、文字列や配列の操作を探す前に全記事を読む必要はありません。"

pub fn runLink -> String = " 動かす: "

pub fn callLink -> String = " 呼び出しを読む: "
