pub fn body -> String =
  "2026年10月1日時点で確認した最新のGitHub Releaseはv0.61.19です。2026年9月30日に公開され、リリースのコミットはa8641b5a81a4です。このページは確認時点を固定しており、以後のリリースを自動追跡するものではありません。"
pub fn releaseLabel -> String = "v0.61.19の正式リリースを開く"
pub fn allLabel -> String = "すべての公開リリース"
pub fn changesTitle -> String = "このバージョンで修正されたこと"
pub fn typesChange -> String =
  "配列などのコレクションや名前付きの型について、型引数の異なる値を同じ型として受け入れてしまう問題を修正しました。レコードのフィールドやEffect・Streamの中身にも関係します。以前通っていた代入が、正しく型エラーになる場合があります。"
pub fn exportsChange -> String =
  "モジュールの値を別のモジュールから公開し直す再エクスポートを修正しました。名前空間を経由した再公開を保ち、生成されたTypeScriptの重複したexportや、下線を含む名前との衝突を防ぎます。"
pub fn docsChange -> String =
  "対応する英日リファレンスの制限説明を、検証済みの例と拒否される代入例へ更新しました。また、日本語の24記事と関連リンクの表現を改稿しました。詳しい範囲は、このリリースに固定した変更履歴で確認できます。"
pub fn changelogLabel -> String = "0.61.19に含まれる変更履歴"
pub fn downloadsTitle -> String = "OSとCPUに合う配布物を選ぶ"
pub fn downloadsBody -> String =
  "nativeアーカイブにはCLIとLSP（エディターへ型情報などを返すプログラム）が入っています。CLIの実行にはBunも使います。導入とPATHの設定は、最初の実行の案内にまとめています。各アーカイブは対応するSHA-256を確認してから展開してください。"
pub fn checksumLabel -> String = "SHA-256"
pub fn nativeLabel -> String = "CLI / LSP"
pub fn vsixLabel -> String = "VS Code拡張"
pub fn macArm -> String = "macOS Apple Silicon"
pub fn macIntel -> String = "macOS Intel"
pub fn linux -> String = "Linux x64"
pub fn windows -> String = "Windows x64"
pub fn platformLimits -> String =
  "Linux x64版はglibc 2.34以降が必要です。最初の実行の検証はDebian 13・glibc 2.41で行いました。macOSとWindowsの配布物の存在と手順は確認しましたが、こちらの検証では実行していません。このリリースにはLinux ARM64、Windows ARM64、musl向けのnativeアーカイブはありません。"
pub fn extensionBody -> String =
  "VS Code拡張は、OS・CPUが合うVSIXを選び、Extensions: Install from VSIX...で導入します。正式な拡張IDはseseragi-dev.seseragiです。同じ0.61.19のCLIと拡張を選ぶと、別バージョンの組み合わせを避けられます。VSIXにはLSPが同梱されています。"
pub fn extensionLabel -> String = "VS Codeへの導入手順"
pub fn updateTitle -> String = "更新前後に確認すること"
pub fn updateBody -> String =
  "既存のプロジェクトを更新する前に、使っているバージョンと、このリリースの変更履歴を確認してください。Seseragiは開発初期の言語で、将来のバージョンとの互換性を保証していません。更新後はプロジェクトの型検査とテストを実行し、新しい診断を確認します。"
pub fn versionCaption -> String = "現在使っているCLIを確認する"
pub fn versionBody -> String =
  "0.61.19という番号だけでなく、表示にreleaseが含まれることも確認します。Gitのmainから作った開発用ビルドは、同じ番号でもdevelopmentと表示される場合があります。公開済みの配布物と混同しないでください。"
pub fn lockBody -> String =
  "既存のseseragi.tomlプロジェクトで更新後にSES-K0102が出たら、変更した内容を確認した上でseseragi lock updateを明示的に実行し、lockfileの差分を確認します。通常の実行やビルドはlockfileを自動更新しません。詳しいプロジェクト手順はWebアプリの案内から確認できます。"
pub fn siteBody -> String =
  "このサイトには、正式リリースの後にmainへ入った文書の改稿が含まれることがあります。サイトの文章が新しくなったこと自体は、新しいCLIの正式リリースを意味しません。配布物はGitHub Releaseのタグと対象コミットで確認してください。"
pub fn firstRunLabel -> String = "最初のプログラムを実行する"
pub fn webLabel -> String = "ローカルWebアプリの手順"
pub fn contractLabel -> String = "配布物とバージョンの規則"
