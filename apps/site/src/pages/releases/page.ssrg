import { LocalizedText, localized } from "../../model/locale"
import {
  BulletList,
  ExternalLink,
  Heading,
  Inline,
  InternalLink,
  PageDefinition,
  Paragraph,
  SiteLanding,
  Terminal,
  Words
} from "../../model/page"
import * as en from "./en"
import * as ja from "./ja"

fn text english: String -> japanese: String -> LocalizedText =
  localized english japanese

fn asset name: String -> String =
  "https://github.com/KentaroMorishita/seseragi/releases/download/v0.61.19/" + name

fn downloads label: LocalizedText
  -> target: String
  -> archive: String
  -> Array<Inline> =
  [
    Words label,
    Words (localized ": " ": "),
    ExternalLink (text (en.nativeLabel ()) (ja.nativeLabel ()), asset archive),
    Words (localized " · " " · "),
    ExternalLink
      (text (en.checksumLabel ()) (ja.checksumLabel ()), asset (archive + ".sha256")),
    Words (localized " · " " · "),
    ExternalLink (
      text (en.vsixLabel ()) (ja.vsixLabel ()),
      asset ("seseragi-v0.61.19-vscode-" + target + ".vsix")
    )
  ]

pub fn page -> PageDefinition = PageDefinition {
  id: "releases",
  path: "/releases/",
  kind: SiteLanding,
  title: text (en.title ()) (ja.title ()),
  summary: text (en.summary ()) (ja.summary ()),
  blocks: [
    Heading ("release-record", text (en.heading ()) (ja.heading ())),
    Paragraph ([Words (text (en.body ()) (ja.body ()))]),
    BulletList (
      [
        [ExternalLink (
          text (en.releaseLabel ()) (ja.releaseLabel ()),
          "https://github.com/KentaroMorishita/seseragi/releases/tag/v0.61.19"
        )],
        [ExternalLink (
          text (en.allLabel ()) (ja.allLabel ()),
          "https://github.com/KentaroMorishita/seseragi/releases"
        )]
      ]
    ),
    Heading ("changes", text (en.changesTitle ()) (ja.changesTitle ())),
    BulletList (
      [
        [Words (text (en.typesChange ()) (ja.typesChange ()))],
        [Words (text (en.exportsChange ()) (ja.exportsChange ()))],
        [Words (text (en.docsChange ()) (ja.docsChange ()))]
      ]
    ),
    Paragraph (
      [ExternalLink (
        text (en.changelogLabel ()) (ja.changelogLabel ()),
        "https://github.com/KentaroMorishita/seseragi/blob/v0.61.19/CHANGELOG.md"
      )]
    ),
    Heading ("downloads", text (en.downloadsTitle ()) (ja.downloadsTitle ())),
    Paragraph ([Words (text (en.downloadsBody ()) (ja.downloadsBody ()))]),
    Paragraph (
      [InternalLink
          (text (en.firstRunLabel ()) (ja.firstRunLabel ()), "/docs/first-run/")]
    ),
    BulletList (
      [
        downloads (text (en.macArm ()) (ja.macArm ())) "darwin-arm64"
          "seseragi-v0.61.19-darwin-arm64.tar.gz",
        downloads (text (en.macIntel ()) (ja.macIntel ())) "darwin-x64"
          "seseragi-v0.61.19-darwin-x64.tar.gz",
        downloads (text (en.linux ()) (ja.linux ())) "linux-x64"
          "seseragi-v0.61.19-linux-x64.tar.gz",
        downloads (text (en.windows ()) (ja.windows ())) "win32-x64"
          "seseragi-v0.61.19-win32-x64.zip"
      ]
    ),
    Paragraph ([Words (text (en.platformLimits ()) (ja.platformLimits ()))]),
    Paragraph ([Words (text (en.extensionBody ()) (ja.extensionBody ()))]),
    Paragraph (
      [ExternalLink (
        text (en.extensionLabel ()) (ja.extensionLabel ()),
        "https://github.com/KentaroMorishita/seseragi/blob/v0.61.19/extensions/seseragi/README.md"
      )]
    ),
    Heading ("update", text (en.updateTitle ()) (ja.updateTitle ())),
    Paragraph ([Words (text (en.updateBody ()) (ja.updateBody ()))]),
    Terminal (text (en.versionCaption ()) (ja.versionCaption ()), "seseragi --version"),
    Paragraph ([Words (text (en.versionBody ()) (ja.versionBody ()))]),
    Paragraph ([Words (text (en.lockBody ()) (ja.lockBody ()))]),
    Paragraph ([Words (text (en.siteBody ()) (ja.siteBody ()))]),
    BulletList (
      [
        [ExternalLink (
          text (en.webLabel ()) (ja.webLabel ()),
          "https://github.com/KentaroMorishita/seseragi/blob/main/docs/GETTING_STARTED.md"
        )],
        [ExternalLink (
          text (en.contractLabel ()) (ja.contractLabel ()),
          "https://github.com/KentaroMorishita/seseragi/blob/v0.61.19/docs/RELEASE.md"
        )]
      ]
    )
  ]
}
