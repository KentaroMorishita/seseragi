import { LocalizedText, localized } from "../../model/locale"
import {
  BulletList,
  CodeExample,
  ExternalLink,
  Heading,
  InternalLink,
  PageDefinition,
  Paragraph,
  SiteLanding,
  Terminal,
  Words
} from "../../model/page"
import * as en from "./en"
import * as ja from "./ja"

fn text english: String -> japanese: String -> LocalizedText =
  localized english japanese

pub fn page -> PageDefinition = PageDefinition {
  id: "examples",
  path: "/examples/",
  kind: SiteLanding,
  title: text (en.title ()) (ja.title ()),
  summary: text (en.summary ()) (ja.summary ()),
  blocks: [
    Heading ("executable-sources", text (en.heading ()) (ja.heading ())),
    Paragraph ([Words (text (en.body ()) (ja.body ()))]),
    Paragraph (
      [InternalLink
          (text (en.firstRunLabel ()) (ja.firstRunLabel ()), "/docs/first-run/")]
    ),
    Terminal (
      text (en.runCaption ()) (ja.runCaption ()),
      "seseragi lint main.ssrg\nseseragi run main.ssrg"
    ),
    Heading ("shipping-total", text (en.shippingTitle ()) (ja.shippingTitle ())),
    Paragraph ([Words (text (en.shippingTask ()) (ja.shippingTask ()))]),
    CodeExample
          ("comparison-shipping-total-seseragi", localized "main.ssrg" "main.ssrg"),
    Paragraph ([Words (text (en.shippingReading ()) (ja.shippingReading ()))]),
    Terminal (text (en.outputCaption ()) (ja.outputCaption ()), "3700, 5000"),
    Paragraph ([Words (text (en.shippingResult ()) (ja.shippingResult ()))]),
    Paragraph ([Words (text (en.shippingLimit ()) (ja.shippingLimit ()))]),
    Paragraph (
      [InternalLink (
        text (en.introLabel ()) (ja.introLabel ()),
        "/docs/language/model/what-is-seseragi/"
      )]
    ),
    Heading ("record-update", text (en.recordsTitle ()) (ja.recordsTitle ())),
    Paragraph ([Words (text (en.recordsTask ()) (ja.recordsTask ()))]),
    CodeExample ("reader-records", localized "main.ssrg" "main.ssrg"),
    Paragraph ([Words (text (en.recordsReading ()) (ja.recordsReading ()))]),
    Paragraph ([Words (text (en.recordsEffect ()) (ja.recordsEffect ()))]),
    Terminal (text (en.outputCaption ()) (ja.outputCaption ()), "10\n42\nAki"),
    Paragraph ([Words (text (en.recordsResult ()) (ja.recordsResult ()))]),
    BulletList (
      [
        [InternalLink (
          text (en.recordsLabel ()) (ja.recordsLabel ()),
          "/docs/language/data/records/"
        )],
      ]
    ),
    Heading ("connect-functions", text (en.pipelinesTitle ()) (ja.pipelinesTitle ())),
    Paragraph ([Words (text (en.pipelinesTask ()) (ja.pipelinesTask ()))]),
    CodeExample ("reader-pipelines", localized "main.ssrg" "main.ssrg"),
    Paragraph ([Words (text (en.pipelinesReading ()) (ja.pipelinesReading ()))]),
    Terminal (text (en.outputCaption ()) (ja.outputCaption ()), "7\n7\n7"),
    Paragraph ([Words (text (en.pipelinesResult ()) (ja.pipelinesResult ()))]),
    BulletList (
      [
        [InternalLink (
          text (en.functionsLabel ()) (ja.functionsLabel ()),
          "/docs/language/syntax/function-application/"
        )],
        [InternalLink (
          text (en.pipelinesLabel ()) (ja.pipelinesLabel ()),
          "/docs/language/syntax/pipelines-and-low-precedence-application/"
        )],
        [ExternalLink (
          text (en.sourceLabel ()) (ja.sourceLabel ()),
          "https://github.com/KentaroMorishita/seseragi/blob/ab42da841d76d322584fac096c249d586ae539ec/apps/site/examples/src/language/reader-pipelines.ssrg"
        )]
      ]
    ),
    Heading ("larger-projects", text (en.moreTitle ()) (ja.moreTitle ())),
    Paragraph ([Words (text (en.moreBody ()) (ja.moreBody ()))]),
    BulletList (
      [
        [ExternalLink (
          text (en.webLabel ()) (ja.webLabel ()),
          "https://github.com/KentaroMorishita/seseragi/blob/main/docs/GETTING_STARTED.md"
        )],
        [ExternalLink (
          text (en.catalogLabel ()) (ja.catalogLabel ()),
          "https://github.com/KentaroMorishita/seseragi/blob/main/examples/samples/README.md"
        )]
      ]
    ),
    Paragraph ([Words (text (en.verification ()) (ja.verification ()))])
  ]
}
