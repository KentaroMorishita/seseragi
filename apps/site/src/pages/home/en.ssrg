pub fn title -> String = "Seseragi"
pub fn summary -> String =
  "Build terminal programs and web UIs from small functions. Update data by making a new value rather than changing the original. Seseragi checks types before execution. Start by comparing a calculation you might write in everyday TypeScript."
pub fn exampleTitle -> String = "One shipping policy, many orders"
pub fn task -> String =
  "Shipping is free from ¥5,000, otherwise ¥500. Two orders of ¥3,200 and ¥5,000 print 3700, 5000. Inputs here are whole yen from 0 through 1,000,000; validation is omitted."
pub fn codeTitle -> String = "Seseragi: calculate totals with shipping"
pub fn reading -> String =
  "fn declares a function; : Int means integer. Arrows separate arguments and the result type. if chooses the returned value. Calls separate arguments with spaces: totalWithShipping 5000 500 3200 returns 3700."
pub fn reuse -> String =
  "let names standardTotal, a function with the first two arguments fixed. Give it a subtotal to get a total. TypeScript uses an arrow function for this; Seseragi uses ordinary call syntax."
pub fn output -> String =
  "pub exposes main, the entry point. effect marks external work, here output. println prints a string and newline; ${...} inserts the calculated values."
pub fn compare -> String =
  "Compare the TypeScript version, read each line and check the limits: "
pub fn try -> String = "Create your own file and try it: "
pub fn limits -> String =
  "The language is in development. Check supported environments and available features before deciding to adopt it."
