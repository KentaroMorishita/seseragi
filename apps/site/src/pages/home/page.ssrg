import { LocalizedText, localized } from "../../model/locale"
import {
  CodeExample,
  Heading,
  Home,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words
} from "../../model/page"
import * as en from "./en"
import * as ja from "./ja"
import * as introEn from "../language/model/what-is-seseragi/en"
import * as introJa from "../language/model/what-is-seseragi/ja"
import * as firstEn from "../docs/first-run/en"
import * as firstJa from "../docs/first-run/ja"

fn text english: String -> japanese: String -> LocalizedText =
  localized english japanese

pub fn page -> PageDefinition = PageDefinition {
  id: "home",
  path: "/",
  kind: Home,
  title: text (en.title ()) (ja.title ()),
  summary: text (en.summary ()) (ja.summary ()),
  blocks: [
    Heading ("shipping-example", text (en.exampleTitle ()) (ja.exampleTitle ())),
    Paragraph ([Words (text (en.task ()) (ja.task ()))]),
    CodeExample
      ("comparison-shipping-total-seseragi", text (en.codeTitle ()) (ja.codeTitle ())),
    Paragraph ([Words (text (en.reading ()) (ja.reading ()))]),
    Paragraph ([Words (text (en.reuse ()) (ja.reuse ()))]),
    Paragraph ([Words (text (en.output ()) (ja.output ()))]),
    Paragraph (
      [
        Words (text (en.compare ()) (ja.compare ())),
        InternalLink (
          text (introEn.title ()) (introJa.title ()),
          "/docs/language/model/what-is-seseragi/"
        )
      ]
    ),
    Paragraph (
      [
        Words (text (en.try ()) (ja.try ())),
        InternalLink (text (firstEn.title ()) (firstJa.title ()), "/docs/first-run/")
      ]
    ),
    Paragraph ([Words (text (en.limits ()) (ja.limits ()))])
  ]
}
