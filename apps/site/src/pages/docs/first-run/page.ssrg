import { LocalizedText, localized } from "../../../model/locale"
import {
  BulletList,
  Callout,
  CodeExample,
  ExternalLink,
  Heading,
  InternalLink,
  Note,
  PageDefinition,
  Paragraph,
  SiteLanding,
  Terminal,
  Words
} from "../../../model/page"
import * as commands from "./commands"
import * as en from "./en"
import * as ja from "./ja"
import * as valuesEn from "../../language/model/immutable-by-default/en"
import * as valuesJa from "../../language/model/immutable-by-default/ja"
import * as annotationsEn from "../../language/types/annotations-and-inference/en"
import * as annotationsJa from "../../language/types/annotations-and-inference/ja"
import * as functionsEn from "../../language/syntax/function-application/en"
import * as functionsJa from "../../language/syntax/function-application/ja"

fn text english: String -> japanese: String -> LocalizedText =
  localized english japanese

pub fn page -> PageDefinition = PageDefinition {
  id: "docs.first-run",
  path: "/docs/first-run/",
  kind: SiteLanding,
  title: text (en.title ()) (ja.title ()),
  summary: text (en.summary ()) (ja.summary ()),
  blocks: [
    Heading ("requirements", text (en.platformTitle ()) (ja.platformTitle ())),
    Paragraph ([Words (text (en.platform ()) (ja.platform ()))]),
    Paragraph ([Words (text (en.prerequisites ()) (ja.prerequisites ()))]),
    BulletList (
      [
        [InternalLink
            (localized "Linux x64" "Linux x64", "/docs/first-run/#install-linux")],
        [InternalLink (localized "macOS" "macOS", "/docs/first-run/#install-macos")],
        [InternalLink
            (localized "Windows x64" "Windows x64", "/docs/first-run/#install-windows")]
      ]
    ),
    Callout (
      Note,
      text (en.otherPlatformsTitle ()) (ja.otherPlatformsTitle ()),
      [Words (text (en.otherPlatforms ()) (ja.otherPlatforms ()))]
    ),
    BulletList (
      [
        [ExternalLink
            (text (en.bunLink ()) (ja.bunLink ()), "https://bun.com/docs/installation")],
        [ExternalLink (
          text (en.releaseLink ()) (ja.releaseLink ()),
          "https://github.com/KentaroMorishita/seseragi/releases/tag/v0.61.19"
        )],
        [ExternalLink (
          text (en.archiveLink ()) (ja.archiveLink ()),
          "https://github.com/KentaroMorishita/seseragi/blob/v0.61.19/docs/RELEASE.md#native-archiveからinstall"
        )]
      ]
    ),
    Heading ("install-linux", text (en.bunTitle ()) (ja.bunTitle ())),
    Paragraph ([Words (text (en.linuxRequirements ()) (ja.linuxRequirements ()))]),
    Terminal (localized "Linux x64" "Linux x64", commands.platform ()),
    Paragraph ([Words (text (en.bun ()) (ja.bun ()))]),
    Terminal (localized "Bun 1.3.9" "Bun 1.3.9", commands.installBun ()),
    Paragraph ([Words (text (en.cli ()) (ja.cli ()))]),
    Terminal (text (en.cliCaption ()) (ja.cliCaption ()), commands.installCli ()),
    Terminal
            (text (en.versionCaption ()) (ja.versionCaption ()), commands.versionOutput ()),
    Heading ("install-macos", text (en.macTitle ()) (ja.macTitle ())),
    Paragraph ([Words (text (en.macBody ()) (ja.macBody ()))]),
    Terminal (localized "macOS" "macOS", commands.macPlatform ()),
    Paragraph ([Words (text (en.macCli ()) (ja.macCli ()))]),
    Terminal (localized "Bun 1.3.9" "Bun 1.3.9", commands.installBun ()),
    Terminal (
      localized "macOS: Seseragi 0.61.19" "macOS: Seseragi 0.61.19",
      commands.installMac ()
    ),
    Heading ("install-windows", text (en.windowsTitle ()) (ja.windowsTitle ())),
    Paragraph ([Words (text (en.windowsBody ()) (ja.windowsBody ()))]),
    Terminal
            (text (en.windowsCaption ()) (ja.windowsCaption ()), commands.installWindows ()),
    Paragraph ([Words (text (en.windowsResult ()) (ja.windowsResult ()))]),
    Paragraph ([Words (text (en.path ()) (ja.path ()))]),
    Heading ("create-file", text (en.fileTitle ()) (ja.fileTitle ())),
    Paragraph ([Words (text (en.directory ()) (ja.directory ()))]),
    Terminal (text (en.unixCaption ()) (ja.unixCaption ()), commands.createDirectory ()),
    Terminal (
      text (en.windowsCaption ()) (ja.windowsCaption ()),
      commands.createWindowsDirectory ()
    ),
    Paragraph ([Words (text (en.file ()) (ja.file ()))]),
    CodeExample ("hello-world", localized "main.ssrg" "main.ssrg"),
    Paragraph ([Words (text (en.reading ()) (ja.reading ()))]),
    Heading ("check-and-run", text (en.checkTitle ()) (ja.checkTitle ())),
    Paragraph ([Words (text (en.lint ()) (ja.lint ()))]),
    Terminal (text (en.lintCaption ()) (ja.lintCaption ()), commands.lint ()),
    Paragraph ([Words (text (en.run ()) (ja.run ()))]),
    Terminal (text (en.runCaption ()) (ja.runCaption ()), commands.run ()),
    Terminal (text (en.outputCaption ()) (ja.outputCaption ()), commands.output ()),
    Paragraph ([Words (text (en.success ()) (ja.success ()))]),
    Heading ("troubleshooting", text (en.recoveryTitle ()) (ja.recoveryTitle ())),
    Paragraph ([Words (text (en.missingCommand ()) (ja.missingCommand ()))]),
    Terminal (text (en.pathCaption ()) (ja.pathCaption ()), commands.restorePath ()),
    Terminal
            (text (en.windowsCaption ()) (ja.windowsCaption ()), commands.restoreWindowsPath ()),
    BulletList (
      [
        [Words (text (en.wrongFile ()) (ja.wrongFile ()))],
        [Words (text (en.badSource ()) (ja.badSource ()))],
        [Words (text (en.badArchive ()) (ja.badArchive ()))]
      ]
    ),
    Callout (
      Note,
      text (en.scopeTitle ()) (ja.scopeTitle ()),
      [Words (text (en.scope ()) (ja.scope ()))]
    ),
    Heading ("next", text (en.nextTitle ()) (ja.nextTitle ())),
    Paragraph ([Words (text (en.next ()) (ja.next ()))]),
    BulletList (
      [
        [InternalLink (
          text (valuesEn.title ()) (valuesJa.title ()),
          "/docs/language/model/immutable-by-default/"
        )],
        [InternalLink (
          text (annotationsEn.title ()) (annotationsJa.title ()),
          "/docs/language/types/annotations-and-inference/"
        )],
        [InternalLink (
          text (functionsEn.title ()) (functionsJa.title ()),
          "/docs/language/syntax/function-application/"
        )]
      ]
    ),
    Paragraph ([Words (text (en.web ()) (ja.web ()))]),
    Paragraph (
      [ExternalLink (
        text (en.webLink ()) (ja.webLink ()),
        "https://github.com/KentaroMorishita/seseragi/blob/main/docs/GETTING_STARTED.md"
      )]
    )
  ]
}
