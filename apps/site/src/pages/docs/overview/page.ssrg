import { LocalizedText, localized } from "../../../model/locale"
import {
  BulletList,
  DocumentationIndex,
  ExternalLink,
  Heading,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words
} from "../../../model/page"
import * as en from "./en"
import * as ja from "./ja"
import * as firstRunEn from "../first-run/en"
import * as firstRunJa from "../first-run/ja"
import * as introEn from "../../language/model/what-is-seseragi/en"
import * as introJa from "../../language/model/what-is-seseragi/ja"
import * as valuesEn from "../../language/model/immutable-by-default/en"
import * as valuesJa from "../../language/model/immutable-by-default/ja"
import * as functionsEn from "../../language/types/annotations-and-inference/en"
import * as functionsJa from "../../language/types/annotations-and-inference/ja"

fn text english: String -> japanese: String -> LocalizedText =
  localized english japanese

pub fn page -> PageDefinition = PageDefinition {
  id: "docs.overview",
  path: "/docs/",
  kind: DocumentationIndex,
  title: text (en.title ()) (ja.title ()),
  summary: text (en.summary ()) (ja.summary ()),
  blocks: [
    Heading ("start-here", text (en.startTitle ()) (ja.startTitle ())),
    Paragraph (
      [
        Words (text (en.introPurpose ()) (ja.introPurpose ())),
        InternalLink (
          text (introEn.title ()) (introJa.title ()),
          "/docs/language/model/what-is-seseragi/"
        )
      ]
    ),
    Heading ("first-run", text (en.firstRunTitle ()) (ja.firstRunTitle ())),
    Paragraph ([Words (text (en.firstRunBody ()) (ja.firstRunBody ()))]),
    Paragraph (
      [InternalLink
          (text (firstRunEn.title ()) (firstRunJa.title ()), "/docs/first-run/")]
    ),
    BulletList [
      [
        Words (text (en.valuesPurpose ()) (ja.valuesPurpose ())),
        InternalLink (
          text (valuesEn.title ()) (valuesJa.title ()),
          "/docs/language/model/immutable-by-default/"
        )
      ],
      [
        Words (text (en.functionsPurpose ()) (ja.functionsPurpose ())),
        InternalLink (
          text (functionsEn.title ()) (functionsJa.title ()),
          "/docs/language/types/annotations-and-inference/"
        )
      ]
    ],
    Heading ("learn-by-doing", text (en.tourTitle ()) (ja.tourTitle ())),
    Paragraph (
      [
        Words (text (en.tourBody ()) (ja.tourBody ())),
        ExternalLink
          (text " Open the Tour" " Tourを開く", "https://seseragi.vercel.app/tour/")
      ]
    ),
    Heading ("find-reference", text (en.referenceTitle ()) (ja.referenceTitle ())),
    Paragraph ([Words (text (en.referenceBody ()) (ja.referenceBody ()))])
  ]
}
