import { LocalizedText, localized } from "../../../model/locale"
import {
  DocumentationIndex,
  ExternalLink,
  Heading,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words
} from "../../../model/page"
import * as en from "./en"
import * as ja from "./ja"

fn text english: String -> japanese: String -> LocalizedText =
  localized english japanese

pub fn page -> PageDefinition = PageDefinition {
  id: "docs.overview",
  path: "/docs/",
  kind: DocumentationIndex,
  title: text (en.title ()) (ja.title ()),
  summary: text (en.summary ()) (ja.summary ()),
  blocks: [
    Heading ("language", text (en.languageTitle ()) (ja.languageTitle ())),
    Paragraph (
      [
        Words (text (en.languageBody ()) (ja.languageBody ())),
        InternalLink
          (text " Browse the language reference" " 言語リファレンスを見る", "/docs/language/")
      ]
    ),
    Heading ("standard-library", text (en.libraryTitle ()) (ja.libraryTitle ())),
    Paragraph (
      [
        Words (text (en.libraryBody ()) (ja.libraryBody ())),
        InternalLink
          (text " Browse the standard library" " 標準ライブラリを見る", "/docs/library/")
      ]
    ),
    Heading ("learn-by-doing", text (en.tourTitle ()) (ja.tourTitle ())),
    Paragraph (
      [
        Words (text (en.tourBody ()) (ja.tourBody ())),
        ExternalLink
          (text " Open the Tour" " Tourを開く", "https://seseragi.vercel.app/tour/")
      ]
    )
  ]
}
