import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { syntaxPage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  syntaxPage "language.syntax.optional-record-fields" "/docs/language/syntax/optional-record-fields/" (en.copy ()) (ja.copy ()) [
    CodeExample (
      "syntax-optional-record-field",
      localized "Optional presence and Maybe access" "フィールドの不在と、Maybeを返す参照"
    ),
    BulletList [
      [
        InlineCode "id?: String",
        Words
          (localized " permits the id field to be absent." " はidフィールドのないレコードも受け取れます。")
      ],
      [
        InlineCode "id: Maybe<String>",
        Words (
          localized " requires the field itself to be present."
          " ではフィールド自体が必ず必要です。値がNothingでも、フィールドは存在します。"
        )
      ],
      [
        InlineCode "props.id",
        Words (
          localized " has type Maybe<String> for an optional String field."
          " は、String型の省略可能なフィールドを参照した場合、Maybe<String>を返します。"
        )
      ]
    ]
  ] [CodeExample (
    "syntax-invalid-record-fields",
    localized "Rejected record field and pattern operations" "フィールド参照や分解の型が合わない場合"
  )] [
    [InternalLink (
      localized "Operator precedence" "演算子の優先順位",
      "/docs/language/syntax/operator-precedence/"
    )],
    [InternalLink (
      localized "Reserved words and naming" "予約語と名前の規則",
      "/docs/language/syntax/reserved-words-and-names/"
    )],
    [InternalLink (localized "Literals" "リテラル", "/docs/language/syntax/literals/")]
  ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
