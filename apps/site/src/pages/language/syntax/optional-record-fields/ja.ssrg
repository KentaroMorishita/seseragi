import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "省略可能なレコードフィールドの構文",
  summary: (explanation ()).summary,
  formsTitle: "フィールド名の直後に?を付ける",
  formsBody: "id?: Stringのように、フィールド名の直後に?を付けます。この?はレコードの型とレコードのパターンに使う記号です。通常の式や関数の引数に付ける演算子ではありません。",
  typingBody: "id?: Stringはid自体を省略できるという意味です。id: Maybe<String>はidが必ずあり、その中身がJustまたはNothingという意味です。省略可能なフィールドを読むとMaybe<String>が返ります。id: Stringという必須フィールドを持つ値も、id?: Stringを要求する関数へ渡せます。",
  evaluationBody: "フィールドを省略したレコードには、そのフィールド自体がありません。必須のMaybe型フィールドにNothingを格納する場合とは異なります。レコードのパターンでは、省略可能なフィールドの有無を調べられます。指定したフィールドの値を作る式は、一度だけ計算します。",
  invalidTitle: "?を付けられる場所を確認する",
  invalidBody: "この形式は構造的レコードに使います。structのフィールド、関数の引数、ADTが保持する値には直接?を付けられません。省略可能なフィールドを、必ずあるものとして読むパターンも使えません。",
  diagnosticsBody: "?の位置が誤っている場合は構文エラーです。存在しないフィールドの参照や必須フィールドの不足は型エラーです。省略可能なフィールドと、必須のMaybe型フィールドを取り違えていないか確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "省略可能なフィールドの?は、どこに書くか",
  summary: "構造的なレコードの型で、フィールド名の後に?を書きます。field?: Typeは、そのフィールド自体を省略できるという意味です。",
  reading: "Propsのid?: Stringは省略可能、children: Stringは必須です。minimalとnamedはどちらもPropsの条件を満たします。props.idの結果はMaybe<String>で、Justなら文字列を取り出し、Nothingなら??の右側の\"anonymous\"を使います。",
  result: "label minimalは\"anonymous\"、label namedは指定した\"hero\"を返します。idを省略した場合と、文字列を指定した場合の違いです。必須のid: Maybe<String>では、値がNothingでもidフィールド自体は必要です。"
}
