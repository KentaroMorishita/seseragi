import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Optional record field syntax",
  summary: (explanation ()).summary,
  exampleTitle: "Use a name when no nickname is present",
  purpose: [
    "Represent a field that may be absent, such as a profile nickname. Its purpose resembles a TypeScript optional property, but reading it returns a Maybe value rather than undefined.",
    "Maybe distinguishes a present value, Just, from absence, Nothing. Here ?? uses name as the fallback only when no nickname is present.",
  ],
  reading: [
    "alias Profile names a record shape. name: String is required; nickname?: String can be omitted. Put ? immediately after the field name.",
    "display takes a Profile named profile. profile.nickname has type Maybe<String>, so the function handles absence with ?? instead of returning it directly as a String.",
    "absent contains only name, so display absent returns Aki. present also contains nickname: \"A\", so display present returns A.",
    "The output is Aki, A. The right side of ?? is evaluated only when the left is Nothing; otherwise the contained String from Just is used.",
  ],
  rules: [
    "field?: Type belongs to structural record types. Use this spelling rather than a variant with spaces between the field and ? or between ? and the colon. The formatter normalizes to field?: Type.",
    "nickname?: String permits the field itself to be absent. nickname: Maybe<String> is different: the field is required, even when its stored value is Nothing.",
    "A value with a required nickname: String can be passed to a function expecting nickname?: String. Reading the field through that declared parameter type still produces Maybe<String>.",
    "Each supplied field expression is evaluated once. Omitting a field is not the same as storing Nothing in a required field. Record patterns, which extract parts of a value, also have a form that queries optional presence.",
  ],
  mistakes: [
    "The display below tries to return Maybe<String> as String, producing SES-T0101. Use a fallback such as profile.nickname ?? profile.name or handle both presence and absence.",
    "You cannot attach ? directly to struct fields, function parameters, or the payload of an alternative declared with type. A record pattern also cannot unconditionally require an optional field to be present.",
    "An unknown field is different from an absent field permitted by the record type. The former is a type error. Check the record declaration and the field's spelling first.",
  ],
  related: [
    "Check how far a fallback expression extends when ?? is mixed with other operators.",
    "Check the names allowed for fields and types.",
    "Check how to write values such as String inside fields.",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I read a field that may not exist?",
  summary: "field?: Type permits a record field to be omitted. Reading it returns Maybe, which represents presence or absence.",
  reading: "The example uses name when nickname is absent. Handling presence with ?? means you do not need to know match first.",
  result: "The profile without a nickname displays Aki; the profile with one displays A.",
}
