import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "Optional record field syntax",
  summary: (explanation ()).summary,
  formsTitle: "Write ? immediately after the field name",
  formsBody: "Write id?: String, placing ? directly after the field name. This marker belongs to record types and record patterns. It is not an operator on an ordinary expression or function argument.",
  typingBody: "id?: String allows id itself to be absent. id: Maybe<String> requires the field to exist, holding either Just or Nothing. Reading an optional field returns Maybe<String>. A value with a required id: String field can also be passed to a function expecting id?: String.",
  evaluationBody: "When a field is omitted, that field is absent from the record. This differs from storing Nothing in a required Maybe field. Record patterns can query whether an optional field exists. Expressions for fields supplied in the record are evaluated once.",
  invalidTitle: "Check where the ? marker is allowed",
  invalidBody: "This form belongs to structural records. You cannot attach ? directly to struct fields, function parameters, or ADT payloads. A pattern cannot require an optional field to be present unconditionally.",
  diagnosticsBody: "A misplaced ? causes a syntax error. Reading an unknown field or omitting a required field causes a type error. Check whether you meant an optional field or a required field of type Maybe.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Where does the ? for an optional field go?",
  summary: "Write field?: Type inside a structural record type. The marker means that the field itself may be absent.",
  reading: "In Props, id?: String is optional and children: String is required. Both minimal and named satisfy Props. props.id returns Maybe<String>: Just supplies its string, while Nothing selects the \"anonymous\" fallback to the right of ??.",
  result: "label minimal returns \"anonymous\"; label named returns its supplied \"hero\". This distinguishes an omitted id from one containing a string. With a required id: Maybe<String>, the id field must exist even when it holds Nothing."
}
