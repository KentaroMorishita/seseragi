import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "レイアウトと行継続",
  summary: (explanation ()).summary,
  formsTitle: "処理のまとまりは波括弧で囲む",
  formsBody: "{と}でブロックを囲み、その中の宣言や式を改行またはセミコロンで区切ります。字下げだけではブロックになりません。丸括弧の中では自由に改行できます。丸括弧の外で式を続けられるのは、直前の記号が続きを必要とする場合か、次の行が|>、$、算術・比較演算子で始まる場合です。",
  typingBody: "字下げの幅を変えても、型や名前を使える範囲は変わりません。複数行の式では、継続する演算子を次の行の先頭に置くと、前の行から続く計算だと読み取れます。",
  evaluationBody: "改行の規則は、どこまでが一つの式かを決めます。式が決まった後の計算順は通常どおりです。セミコロンは常に区切りであり、次の行を字下げしても、その式の続きにはなりません。",
  invalidTitle: "字下げだけで式を続けない",
  invalidBody: "完成した式の次の行を右へずらしても、二つの式はつながりません。継続する条件に当てはまらない場合は、丸括弧で式全体を囲んでください。",
  diagnosticsBody: "改行した位置で構文エラーが出たら、直前の式がそこで完成していないかを確認してください。フォーマッターは二つの空白で字下げしますが、括弧やセミコロンの意味は変えません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "字下げだけでブロックになるか",
  summary: "波括弧でブロックを作ります。改行は宣言や式を区切りますが、未完成の式や演算子で継続する式は次の行へ続けられます。",
  reading: "複数行の関数では、=の後にまだ本体が必要なため、次の行へ式を続けられます。括弧内では自由に改行できます。パイプラインを折り返す場合は、次の行の先頭に|>を置いて継続を示します。",
  result: "ブロックには波括弧を使い、一つの式を自由に折り返したい場合は丸括弧を使います。字下げだけでは式を継続できません。セミコロンは常に区切りなので、その後を式の続きにはできません。"
}
