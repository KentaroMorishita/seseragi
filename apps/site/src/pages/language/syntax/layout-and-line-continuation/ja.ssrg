import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "レイアウトと行継続",
  summary: (explanation ()).summary,
  exampleTitle: "ブロックと、本当に複数行に分けた計算",
  purpose: [
    "長い式を複数行に分けると、処理の順番や引数を読み取りやすくなります。ただし、字下げしただけで前の行の続きになるわけではありません。",
    "ブロックの範囲は{と}で決めます。例ではaddOneの本体をブロックにし、resultのパイプラインとgroupedの括弧を使って、行の分け方を比較します。",
  ],
  reading: [
    "Intは整数の型です。doubleはその引数を二倍にし、addOneは引数に1を加えて返します。addOneの{...}には、incrementedを宣言する行と、その値を返す最後の行があります。",
    "let result =の右辺は次の行から始まります。3の後の行が|>で始まるので同じ式が続き、doubleで6、addOneで7になります。",
    "groupedでは、addOneに渡すdouble 3を括弧で囲んでいます。括弧内は改行できるため、閉じる)まで一つの引数として読めます。こちらも7です。",
    "mainは二つの結果を一つの文字列に入れて出力します。結果が7, 7なのは、行の分け方が違っても、どちらも3を二倍して1を加えるためです。",
  ],
  rules: [
    "ブロックは{と}で囲みます。ブロック内の宣言や式は改行またはセミコロンで区切ります。字下げを増やすことや、元の位置へ戻すことは、ブロックの開始・終了を意味しません。",
    "括弧内では改行を自由に置けます。関数へ渡す一つの式を何行にも分けたいときは、その式全体を括弧で囲むと、範囲が明確になります。",
    "括弧の外でも、直前の=や+などが右側の式をまだ必要とする場合は行が続きます。また、次の有効な記号が|>、$、算術演算子、比較演算子で始まる場合も前の式が続きます。判定には、コメントを除いた有効な記号を使います。",
    "セミコロンは常に明示的な区切りです。パイプラインを続けたい位置には置きません。新しい行を字下げしても、セミコロンを取り消すことはできません。",
    "字下げの幅は、型や名前を使える範囲を変えません。フォーマッターの標準は2スペースです。どの式がひとまとまりか決まった後は、通常の評価順序が適用されます。",
    "0.61.19では、セミコロンの後にある不正なトップレベルの断片を見逃す場合があります。確認した例では、3;の後の|> doubleは実行されず、3のままでした。これは行継続を許す規則ではありません。",
  ],
  mistakes: [
    "下の例はmainの{を閉じていません。現在のコンパイラはSES-P0001を返します。末尾へ}を追加してください。字下げを戻すだけでは直りません。",
    "前の式も次の式も完成している場合、字下げだけで一つにはできません。演算子を次の行の先頭へ置くか、意図した式全体を括弧で囲みます。",
    "0.61.19では、閉じる)がない一部の入力が型検査を通り、生成したプログラムの実行時に失敗することも確認しています。エラーの出方に頼らず、括弧と波括弧の対応を確認してください。",
  ],
  related: [
    "空白で渡す引数がどこまで続くか、通常の呼び出しから確認できます。",
    "コメント、文字コード、名前の区切りを確認できます。",
    "行の分け方を、処理の流れを読み取りやすくする目的と結び付けて考えられます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "長い式は、どこで改行できるか",
  summary: "ブロックは波括弧で囲みます。式の行を分けるときは、括弧か、式が続くことを示す演算子を使います。",
  reading: "字下げは読みやすさのための配置です。ブロックの境界や行継続は、実際に書いた括弧や記号で決まります。",
  result: "例では実際の複数行パイプラインと、括弧で分けた呼び出しを実行し、どちらも7になることを確認します。",
}
