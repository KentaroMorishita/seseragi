import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Layout and line continuation",
  summary: (explanation ()).summary,
  exampleTitle: "A block and calculations split across real lines",
  purpose: [
    "Splitting a long expression across lines can make its operations and arguments easier to follow. Indenting a line alone does not continue the preceding expression.",
    "Braces determine a block. The example uses a block for addOne, a multi-line pipeline for result, and parentheses for grouped so you can compare the forms.",
  ],
  reading: [
    "Int is the integer type. double takes an Int and doubles it; addOne takes an Int and adds 1. Its {...} body contains a declaration of incremented followed by the expression that returns that value.",
    "The right side of let result = starts on the next line. Each following |> begins a continuation, so 3 becomes 6 through double and then 7 through addOne.",
    "grouped puts double 3 inside parentheses as the argument to addOne. Newlines are allowed inside the parentheses; the closing ) marks the end of that one argument. Its result is also 7.",
    "main inserts the two results into a string and prints it. The output is 7, 7 because both forms double 3 and then add 1, despite their different layout.",
  ],
  rules: [
    "Use { and } to delimit a block. Separate its declarations or expressions with newlines or semicolons. Increasing indentation or returning to an earlier indentation does not start or end a block.",
    "Newlines are unrestricted inside parentheses. To divide one argument expression across several lines, surround the whole expression with parentheses to make its boundary explicit.",
    "Outside parentheses, a line continues if a preceding token such as = or + still needs an expression. It also continues when the next effective token begins with |>, $, an arithmetic operator, or a comparison operator. The decision uses tokens, not comment indentation.",
    "A semicolon is always an explicit separator. Do not put one where a pipeline should continue. Indenting the following line cannot undo that separator.",
    "Indentation width changes neither types nor name scope. The formatter uses two spaces as its standard layout. Once grouping is determined, ordinary evaluation rules apply.",
    "Version 0.61.19 can miss an invalid top-level fragment after a semicolon. In the checked example, |> double after 3; did not execute and the value stayed 3. That acceptance does not make it a valid continuation.",
  ],
  mistakes: [
    "The example below does not close main's {. The current compiler reports SES-P0001. Add the closing } at the end; decreasing indentation cannot repair it.",
    "Two complete expressions do not become one just because the second is indented. Put a continuing operator at the start of the next line or enclose the intended expression in parentheses.",
    "Some inputs missing a closing ) also pass checking in 0.61.19 and fail in the generated program at runtime. Check matching parentheses and braces rather than relying on that diagnostic behavior.",
  ],
  related: [
    "Check how far an argument extends in an ordinary space-separated function call.",
    "Check comments, source encoding, and name boundaries.",
    "Connect layout choices with the goal of making the processing flow readable.",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Where can I split a long expression across lines?",
  summary: "Braces delimit blocks. Parentheses or a continuing operator let one expression span several lines.",
  reading: "Indentation is a visual aid. The actual braces, parentheses, and tokens determine block boundaries and continuation.",
  result: "The example executes a genuinely multi-line pipeline and a parenthesized call; both produce 7.",
}
