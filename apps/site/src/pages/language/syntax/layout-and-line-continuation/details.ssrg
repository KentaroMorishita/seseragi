import { localized } from "../../../../model/locale"
import {
  Block,
  BulletList,
  CodeExample,
  InlineCode,
  Words
} from "../../../../model/page"

pub fn forms -> Array<Block> =
  [BulletList [
    [
      InlineCode "value +",
      Words (
        localized " continues because + still needs a right operand."
          " は+の右側がまだないため、次の行へ続きます。"
      )
    ],
    [
      InlineCode "|> transform",
      Words (
        localized
          " continues the previous expression because the next token is a continuation operator."
          " は次の行が継続できる演算子で始まるため、前の式の続きになります。"
      )
    ],
    [InlineCode ";", Words (localized " always separates forms." " は宣言や式の区切りを明示します。")]
  ]]

pub fn rejected -> Array<Block> =
  [BulletList [
    [Words (
      localized "Indenting a complete second expression does not join it to the first."
        "二つの完成した式は、二つ目を字下げしても一つにはなりません。"
    )],
    [Words (
      localized "A closing brace cannot be inferred from indentation."
        "字下げを戻しても、閉じる}を省略することはできません。"
    )],
    [Words (
      localized "Use parentheses when neither explicit continuation condition applies."
        "行を続ける条件に合わない場合は、括弧で式を囲みます。"
    )]
  ]]
