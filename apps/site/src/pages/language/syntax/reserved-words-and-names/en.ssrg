import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "Reserved words and naming",
  summary: (explanation ()).summary,
  formsTitle: "Reserved, contextual, and ordinary names",
  formsBody: "The reserved words are as, alias, deprecated, deriving, do, effect, else, fails, False, fn, for, foreign, from, if, impl, import, infix, infixl, infixr, instance, let, match, newtype, opaque, operator, pub, rec, struct, then, trait, True, type, when, where, and with. They are used in syntax and cannot name declarations.",
  typingBody: "Types, constructors that create values, and traits start with uppercase letters. Values, functions, fields, and import aliases start with lowercase letters. For example, the type name User and the value name user are different names.",
  evaluationBody: "constructor, method, property, value, pure, task, and namespace have special meanings only inside foreign declarations. since is special only in a deprecated clause. Words used specially in a particular syntax are called contextual keywords. self names the first parameter of an impl method.",
  invalidTitle: "A value discarded with _ cannot be read later",
  invalidBody: "_ discards a value without giving it a name. Reading _ later cannot recover that value. A reserved word used as a name, an uppercase value name, or a lowercase type name also causes an error.",
  diagnosticsBody: "For a naming error, check the declaration identified by the diagnostic and whether its first letter is uppercase or lowercase. Names such as User and user are different names.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Which names can I use for values and types?",
  summary: "Type and constructor names start uppercase; value and function names start lowercase. Reserved syntax words such as type and fn cannot be used as names.",
  reading: "Reading is a type name; Sample is a constructor that holds an Int. describe and value are value names. type, fn, and match introduce language constructs and cannot be used as ordinary names in their places.",
  result: "describe (Sample 42) returns the string \"42\". Reading and Sample start uppercase; describe and value start lowercase. A type parameter must appear in the declaration's parameter list, such as <A>."
}
