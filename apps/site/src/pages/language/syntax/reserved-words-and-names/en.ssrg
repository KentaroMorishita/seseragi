import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Reserved words and naming",
  summary: (explanation ()).summary,
  exampleTitle: "Distinguish type names from value names",
  purpose: [
    "Names distinguish types from values and functions. For letters with case, such as English letters, type names start uppercase and value or function names start lowercase. Uncased Japanese characters can also start value and function names, as in 次の値.",
    "In this example, UserName is an alias for String and userName names a value of that type. Think of the familiar distinction between a TypeScript type name and a variable name.",
  ],
  reading: [
    "alias UserName = String lets you refer to String by the name UserName. It does not change a string into a different runtime representation.",
    "In fn greeting name: UserName -> String, greeting is the function name and name is its parameter. Both start lowercase. UserName and String are type names and start uppercase.",
    "let userName: UserName = \"Aki\" supplies a value. greeting userName in main passes it to the function and receives a string.",
    "The output is Hello, Aki. UserName and userName are distinct because names are case-sensitive; similar spelling does not make them interchangeable.",
  ],
  rules: [
    "Types, constructors that create values, and traits that declare operations shared by types require an uppercase initial character. For values, functions, fields, and import aliases, a cased initial letter must be lowercase. Uncased characters such as 次 in 次の値 are also allowed when they satisfy the identifier-character rules.",
    "Reserved words belong to language syntax and cannot name ordinary declarations: as, alias, deprecated, deriving, do, effect, else, fails, False, fn, for, foreign, from, if, impl, import, infix, infixl, infixr, instance, let, match, newtype, opaque, operator, pub, rec, struct, then, trait, True, type, when, where, and with.",
    "constructor, method, property, value, pure, task, and namespace are special only inside foreign declarations. since is special only inside a deprecated clause. A word with a special role in a particular syntax is called a contextual keyword.",
    "self has a special role as the first parameter of an impl method: it receives the value before the dot at a call. Distinguish an ordinary value name from a name required by that syntax.",
    "_ discards a value without naming it for later use. Reading _ cannot recover the discarded value.",
  ],
  mistakes: [
    "The let UserName below incorrectly uses an uppercase name for a value. The current diagnostic is SES-N0001. Change both its declaration and its use to userName to print Aki.",
    "Version 0.61.19 can miss an invalid unused declaration such as let match. Passing checking does not authorize a reserved word as a name; follow the language's naming rules.",
  ],
  related: [
    "Check Unicode characters and apostrophes allowed in names, beyond casing.",
    "See which value self receives in a concrete dot-method call.",
    "Check operator names, which are managed separately from ordinary names.",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I name types, values, and functions?",
  summary: "Type names start uppercase. Value and function names can start with a lowercase letter or an uncased character such as 次. Reserved syntax words cannot name declarations.",
  reading: "UserName and userName are different names. The example uses a type alias and a value of that type to make the distinction visible.",
  result: "Calling the function with correctly named values prints Hello, Aki. Repair an uppercase value name in both the declaration and its use.",
}
