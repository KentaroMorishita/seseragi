import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "予約語と名前の規則",
  summary: (explanation ()).summary,
  exampleTitle: "型の名前と値の名前を分ける",
  purpose: [
    "名前を見たときに、型を指すのか、値や関数を指すのかを区別します。英字など大文字・小文字がある文字を使う場合、型名は大文字、値名や関数名は小文字から始めます。次の値のように、大文字・小文字の区別がない日本語でも値や関数に名前を付けられます。",
    "例のUserNameはStringに付けた型の別名です。userNameは、その型の値に付けた名前です。TypeScriptの型名と変数名を分けて考えると読みやすくなります。",
  ],
  reading: [
    "alias UserName = Stringは、StringをUserNameという名前でも参照できるようにします。この別名は文字列を別の実行時データへ変える指定ではありません。",
    "fn greeting name: UserName -> Stringでは、greetingが関数名、nameが引数名です。どちらも小文字から始まります。UserNameとStringは型なので大文字です。",
    "let userName: UserName = \"Aki\"で値を用意します。mainのgreeting userNameは、その値を引数に渡して文字列を受け取る呼び出しです。",
    "結果はHello, Akiです。UserNameとuserNameは、大文字・小文字が違うため別の名前です。名前が似ているから自動で同じものになるわけではありません。",
  ],
  rules: [
    "型、値を作るコンストラクター、複数の型で共有する操作を宣言するtraitの名前は、大文字から始める必要があります。値、関数、フィールド、importの別名では、大文字・小文字がある先頭文字は小文字にします。次の値の「次」のように区別がない文字も、識別子に使える文字の規則を満たせば使えます。",
    "予約語は言語の構文に使う語で、通常の宣言名にはできません。一覧はas、alias、deprecated、deriving、do、effect、else、fails、False、fn、for、foreign、from、if、impl、import、infix、infixl、infixr、instance、let、match、newtype、opaque、operator、pub、rec、struct、then、trait、True、type、when、where、withです。",
    "constructor、method、property、value、pure、task、namespaceは、foreign宣言の中だけで特別な意味になります。sinceはdeprecated節の中だけで特別です。このように特定の構文の中で役割が決まる語を、文脈依存のキーワードと呼びます。",
    "selfはimplメソッドの最初の引数として特別な名前です。そのメソッドを呼ぶとき、ドットの前の値を受け取ります。普通の値の名前と、構文の中で必要な名前を区別してください。",
    "_は値を捨てる指定で、その値に後から使える名前を付けません。_を参照して値を取り戻すことはできません。",
  ],
  mistakes: [
    "下のlet UserNameは、大文字から始まる名前を値に使っています。現在の診断はSES-N0001です。宣言と参照をどちらもuserNameへ変えると、Akiを出力できます。",
    "0.61.19では、使われないlet matchなどの不正な宣言を見逃す場合があります。型検査が成功したことを予約語の使用許可と解釈せず、構文で定める命名規則に従ってください。",
  ],
  related: [
    "大文字・小文字だけでなく、名前に使えるUnicode文字やアポストロフィーを確認できます。",
    "selfがどの値を受け取るのか、実際のドット呼び出しで確認できます。",
    "通常の名前とは別に管理される演算子の名前と、その宣言方法を確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "型、値、関数にはどんな名前を付けるか",
  summary: "型名は大文字から始めます。値名や関数名の先頭には、小文字や、「次」のように大文字・小文字の区別がない文字を使えます。予約語は宣言名にできません。",
  reading: "同じ綴りに見えても、UserNameとuserNameは違う名前です。例では型の別名と、その型の値を使って区別します。",
  result: "命名規則に合う名前で関数を呼ぶと、Hello, Akiを出力します。誤った大文字の値名は、宣言と参照を一緒に直します。",
}
