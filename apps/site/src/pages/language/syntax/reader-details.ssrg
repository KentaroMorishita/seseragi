import * as arrays from "std/array"
import { Block, Heading, PageDefinition } from "../../../model/page"

fn insertBeforeMistakes details: Array<Block> -> block: Block -> Array<Block> =
  match block {
    Heading (id, _) ->
      if id == "mistakes" then arrays.concat [details, [block]] else [block]
    _ -> [block]
  }

// Keep page-owned reference forms after the basic example and rules. The
// existing semantic Block renderer still owns all HTML and locale handling.
pub fn withDetails page: PageDefinition -> details: Array<Block> -> PageDefinition =
  PageDefinition {
    ...page,
    blocks: arrays.concat [insertBeforeMistakes details block | block <- page.blocks]
  }
