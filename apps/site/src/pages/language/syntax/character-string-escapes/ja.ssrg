import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "文字と文字列のエスケープ",
  summary: (explanation ()).summary,
  purpose: [
    "文字列の中に二重引用符を書きたいとき、そのまま書くと文字列を閉じる記号と区別できません。改行やバックスラッシュも、ソースにどう書くかを決める必要があります。",
    "エスケープは、バックスラッシュと決まった文字の組み合わせで、実際の文字を表す書き方です。たとえばソースの\\nはバックスラッシュとnの二文字ですが、文字列の値では改行一個になります。"
  ],
  exampleTitle: "引用符、バックスラッシュ、Unicode文字、改行を表示する",
  reading: [
    "letは値に名前を付ける宣言です。quoteの外側の二重引用符は文字列を囲み、中の\\\"は文字列に含める二重引用符を表します。そのため最初の出力行には、Seseragiの両側に二重引用符が表示されます。",
    "pathのソースに書いた\\\\は、値ではバックスラッシュ一個です。出力のdocs\\guideにはバックスラッシュが一個だけ入り、gは普通の文字として続きます。バックスラッシュを一個しか書かないと、\\gという未定義のエスケープになってしまいます。",
    "lambda: Charの: Charは、一つの文字を表す型Charであることを確かめる注釈です。一重引用符の中の\\u{03BB}は、Unicodeで番号03BBが付くギリシャ文字λを表します。出力はλそのもので、\\u{03BB}という綴りではありません。",
    "linesの\\nはfirstとsecondの間の改行になります。mainのテンプレートに書いた三つの\\nも改行です。quote、path、lambdaが一行ずつ、その後にfirstとsecondが別々の行で表示され、printlnが最後の改行を加えます。"
  ],
  rules: [
    "Charは一重引用符、Stringは二重引用符、テンプレート文字列はバッククォートで囲みます。三種類に共通のエスケープは、\\\\（バックスラッシュ）、\\n（改行LF）、\\r（復帰CR）、\\t（タブ）、\\0（ヌル）、\\u{...}（Unicodeの番号指定）です。",
    "内側に同じ区切り文字を書くときは、Charなら\\'、二重引用符のStringなら\\\"、テンプレートなら\\`を使います。別の種類の引用符をエスケープする書き方は使えません。テンプレート内の${は値の埋め込みを始めるので、その二文字を表示するには\\${と書きます。$だけならエスケープは不要です。",
    "Unicodeでは文字に付ける番号をコードポイントと呼びます。\\u{...}の中には、その番号を十六進数で一〜六桁書きます。使えるのは0から0x10FFFFまでで、サロゲート用に予約された0xD800から0xDFFFを除く番号です。この範囲の一個をUnicodeスカラー値と呼びます。",
    "エスケープは型を検査する前に実際の文字へ変換されます。Charに入るのはUnicodeスカラー値一個、Stringに入るのはその列です。éを一個のスカラー値として書いた'é'はCharですが、eと結合アクセントを並べた'e\\u{0301}'は二個なのでCharには入りません。画面で一文字に見えるかどうかとは別の規則です。",
    "Charと二重引用符のStringには、改行や制御文字をそのまま置けません。改行、U+0000からU+001F、U+007Fなどは、定義されたエスケープで書きます。テンプレート文字列には改行を直接書けます。ソースのCRLFは、値ではLF一個になります。区切り文字とバックスラッシュ自身は、それぞれのエスケープが必要です。"
  ],
  mistakes: [
    "下の\\qは定義されていないため、SES-P0201になります。qだけを表示するならバックスラッシュを削り、バックスラッシュとqの二文字を表示するならソースに\\\\qと書いてください。\\xNNのような十六進のバイト指定、八進数のエスケープ、Unicodeの文字名を指定する形式も使えません。",
    "Unicodeの指定が空の\\u{}、六桁を超える指定、0x10FFFFを超える番号、サロゲートの番号もSES-P0201です。診断が示す範囲はバックスラッシュからエスケープの末尾までなので、その全体を確認してください。",
    "閉じる引用符がない場合はSES-P0001です。Charが空、または変換後に複数のスカラー値を含む場合はSES-P0202で、文字リテラル全体が示されます。複数の文字を持たせたいなら二重引用符のStringにし、一文字だけが必要なら余分なスカラー値を取り除きます。"
  ],
  related: [
    "一重引用符と二重引用符など、値の書き方で型がどう決まるか調べます。",
    "UTF-8の保存形式、名前の末尾のアポストロフィ、コメントの規則を調べます。",
    "文字列の値の中の改行と、コードの行を折り返す書き方を区別します。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "文字列に引用符や改行を入れるには",
  summary: "バックスラッシュから始まるエスケープを使うと、引用符、改行、バックスラッシュ自身を値の中へ入れられます。ソースに書く記号と、出力される実際の文字を区別します。",
  reading: "quoteは二重引用符付きの\"Seseragi\"、pathはバックスラッシュ一個を含むdocs\\guide、lambdaはλ、linesは改行で区切ったfirstとsecondです。mainはそれらを順に表示します。",
  result: "出力は全部で五行です。\\nや\\u{03BB}という綴りは表示されず、実際の改行やλになります。printlnが五行目のsecondの後にも改行を加えます。"
}

pub fn title -> String = (copy ()).title
