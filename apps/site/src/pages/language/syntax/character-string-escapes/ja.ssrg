import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "文字と文字列のエスケープ",
  summary: (explanation ()).summary,
  formsTitle: "直接書けない文字をバックスラッシュで表す",
  formsBody: "バックスラッシュの後に決まった記号を書いて、改行やタブなどの文字を表します。復帰、ヌル、バックスラッシュ自身も書けます。Unicodeのコードポイントを指定する場合は一〜六桁を使います。Charは一重引用符、Stringは二重引用符、テンプレート文字列はバッククォートで囲みます。中に同じ区切り文字を書く場合はエスケープしてください。テンプレートで${を文字として書く場合も、直前にバックスラッシュが必要です。",
  typingBody: "CharはUnicodeスカラー値一個を表します。Unicodeスカラー値は、一つのコードポイントからサロゲート領域を除いたものです。é一文字は入れられますが、eと結合アクセントを別々に書いた二個の値は入れられません。画面で一文字に見えても、複数のスカラー値を使う場合があります。",
  evaluationBody: "エスケープは型を検査する前に実際の文字へ変換されます。StringはUnicodeスカラー値の列です。テンプレート文字列には改行を直接書けます。ソースのCRLFも一つのLFになります。Charと二重引用符のStringには、改行や制御文字を直接書けません。",
  invalidTitle: "他の言語のエスケープを流用しない",
  invalidBody: "八進数、十六進数のバイト、Unicodeの文字名を指定する形式は使えません。Unicode指定が空、六桁を超える、範囲外、サロゲートを指定する場合もエラーです。引用符の種類に合わないエスケープにも注意してください。",
  diagnosticsBody: "不正なエスケープはSES-P0201、閉じる引用符がない場合はSES-P0001です。Charの中身が空または複数個ならSES-P0202です。診断が指すバックスラッシュや引用符の位置を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "引用符・改行・Unicode文字を書くには",
  summary: "エスケープは、文字の前にバックスラッシュを付けて、引用符など直接書きにくい文字を表す書き方です。",
  reading: "例のvaluesには'a'、Unicodeエスケープで書いたギリシャ文字λ、'瀬'の三つが入ります。quoteでは一重引用符自体を、slashではバックスラッシュ自体をエスケープして書いています。",
  result: "エスケープから文字へ変換した後、Charの中身はUnicodeスカラー値一個でなければなりません。画面で一文字に見えるかどうかではなく、何個のスカラー値を使っているかで判断します。"
}
