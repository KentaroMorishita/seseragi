import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "文字と文字列のエスケープ",
  summary: (explanation ()).summary,
  formsTitle: "直接書けない文字をバックスラッシュで表す",
  formsBody: "バックスラッシュ（\\）の後に決まった記号を書き、改行、復帰、タブ、ヌル、バックスラッシュ自身を表します。Unicodeのコードポイントを指定する形式には一〜六桁を使えます。Charの区切りは一重引用符、Stringは二重引用符、テンプレート文字列はバッククォートです。中に同じ区切り文字を書く場合はエスケープします。テンプレートの中で${を文字として書く場合も、直前にバックスラッシュが必要です。",
  typingBody: "CharはUnicodeスカラー値一個を表します。é一文字は入れられますが、eと結合アクセントを別々に書いた二個の値は入れられません。見た目の一文字とUnicode上の一個は必ずしも同じではありません。サロゲート領域の値はUnicodeスカラー値ではないため使えません。",
  evaluationBody: "エスケープは、型を検査する前に実際の文字へ変換されます。StringはUnicodeスカラー値の列です。テンプレート文字列には改行を直接書けますが、Charと二重引用符のStringには改行や制御文字を直接書けません。",
  invalidTitle: "他の言語のエスケープを流用しない",
  invalidBody: "八進数、十六進数のバイト、Unicodeの文字名を指定する形式は使えません。Unicode指定が空、六桁を超える、範囲外、サロゲートを指定する場合もエラーです。引用符の種類に合わないエスケープにも注意してください。",
  diagnosticsBody: "不正なエスケープはSES-P0201、閉じる引用符がない場合はSES-P0001です。Charの中身が空または複数個ならSES-P0202です。診断が指すバックスラッシュや引用符の位置を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "引用符・改行・Unicode文字を書くには",
  summary: "エスケープは、文字の前にバックスラッシュを付けて、引用符など直接書きにくい文字を表す書き方です。",
  reading: "例のvaluesには'a'、Unicodeエスケープで書いたギリシャ文字λ、'瀬'の三つが入ります。quoteでは一重引用符自体を、slashではバックスラッシュ自体をエスケープして書いています。",
  result: "Charは、復号後にUnicodeスカラー値が一つだけ必要です。画面では一文字に見えても、複数のスカラー値からなる場合があります。見た目の幅だけではCharにできるか判断できません。"
}
