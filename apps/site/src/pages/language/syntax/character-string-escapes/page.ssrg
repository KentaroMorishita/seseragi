import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, PageDefinition } from "../../../../model/page"
import { readerPage } from "../../reader-article"
import { withDetails } from "../reader-details"
import * as details from "./details"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition = withDetails (
  readerPage "language.syntax.character-string-escapes"
    "/docs/language/syntax/character-string-escapes/" (en.copy ()) (ja.copy ())
    "syntax-reader-escapes" "\"Seseragi\"\ndocs\\guide\nλ\nfirst\nsecond" (
      arrays.concat [
        [CodeExample
    ("syntax-reader-escapes-invalid", localized "Rejected example" "受け付けられない例")],
        details.rejected ()
      ]
    ) [
      (localized "Literals" "リテラル", "/docs/language/syntax/literals/"),
      (
        localized "Source text and comments" "ソーステキストとコメント",
        "/docs/language/syntax/source-text/"
      ),
      (
        localized "Layout and line continuation" "レイアウトと行継続",
        "/docs/language/syntax/layout-and-line-continuation/"
      )
    ]
) (details.forms ())

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
