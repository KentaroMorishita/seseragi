import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "Character and string escapes",
  summary: (explanation ()).summary,
  formsTitle: "Use a backslash for characters you cannot write directly",
  formsBody: "A backslash followed by a supported symbol writes a newline, tab, carriage return, null, or backslash itself. A Unicode code-point escape uses one to six digits. Char uses single quotes, String double quotes, and a template String backticks. Escape the same delimiter when writing it inside the literal. In a template, place a backslash before ${ to write those characters literally.",
  typingBody: "Char contains exactly one Unicode scalar value: a code point outside the surrogate range. A precomposed é fits Char, but e followed by a separate combining accent contains two scalars and does not. A character that looks single on screen may use several scalars.",
  evaluationBody: "Escapes are converted to characters before type checking. String is a sequence of Unicode scalars. Templates may contain raw newlines; CRLF in source becomes a single LF. Char and double-quoted String cannot contain raw newlines or control characters.",
  invalidTitle: "Use only the supported escapes",
  invalidBody: "Octal escapes, hexadecimal byte escapes, and named Unicode escapes are not supported. An empty Unicode escape, more than six digits, an out-of-range value, or a surrogate value also causes an error. Check that an escaped quote matches the literal's delimiter.",
  diagnosticsBody: "An invalid escape reports SES-P0201. A missing closing quote reports SES-P0001. An empty Char or one containing several scalars reports SES-P0202. Check the backslash or quote identified by the diagnostic.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I write quotes, newlines, or Unicode characters?",
  summary: "An escape starts with a backslash and writes a character that is difficult to include directly in a literal.",
  reading: "The values array contains three Char values: 'a', the Greek letter lambda written as a Unicode escape, and '瀬'. quote writes a single quote inside single quotes; slash writes a backslash by escaping it.",
  result: "After converting escapes to characters, a Char must contain one Unicode scalar value. Count the scalars used, rather than deciding from whether the character looks single on screen."
}
