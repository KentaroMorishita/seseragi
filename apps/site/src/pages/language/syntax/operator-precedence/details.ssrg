import { localized } from "../../../../model/locale"
import {
  Block,
  BulletList,
  CodeExample,
  InlineCode,
  Words
} from "../../../../model/page"

pub fn forms -> Array<Block> =
  [BulletList [
    [
      InlineCode "9",
      Words (
        localized ". Field and method access with . and indexing with []. Groups left."
          "。フィールド・メソッドの参照 . と、要素の参照 []。左からまとめます。"
      )
    ],
    [
      InlineCode "8",
      Words (
        localized ". Space-separated function application. Groups left."
          "。空白で引数を渡す関数適用。左からまとめます。"
      )
    ],
    [
      InlineCode "7",
      Words (
        localized ". Prefix !, unary -, and Signal read unary *. Groups right."
          "。前置の !、単項の -、Signalを読む単項の *。右からまとめます。"
      )
    ],
    [InlineCode "6", Words (localized ". Power **. Groups right." "。累乗 **。右からまとめます。")],
    [
      InlineCode "5",
      Words (
        localized ". Multiplication *, division /, and remainder %. Groups left."
          "。乗算 *、除算 /、余り %。左からまとめます。"
      )
    ],
    [
      InlineCode "4",
      Words (
        localized ". Addition + and subtraction - group left; list cons : groups right."
          "。加算 + と減算 - は左から、リストの先頭追加 : は右からまとめます。"
      )
    ],
    [
      InlineCode "3",
      Words (
        localized ". Comparisons ==, !=, <, <=, >, and >=. Cannot be chained."
          "。比較 ==、!=、<、<=、>、>=。連鎖できません。"
      )
    ],
    [
      InlineCode "2",
      Words (
        localized ". Logical AND &&. Groups left and short-circuits."
          "。論理積 &&。左からまとめ、短絡評価します。"
      )
    ],
    [
      InlineCode "1",
      Words (
        localized ". Logical OR ||. Groups left and short-circuits."
          "。論理和 ||。左からまとめ、短絡評価します。"
      )
    ],
    [
      InlineCode "0",
      Words (
        localized ". Maybe fallback ??. Groups right and short-circuits."
          "。Maybeの代替値を指定する ??。右からまとめ、短絡評価します。"
      )
    ],
    [
      InlineCode "-1",
      Words (
        localized ". >>=, <$>, <*>, and pipeline |>. All group left."
          "。>>=、<$>、<*>、パイプライン |>。すべて左からまとめます。"
      )
    ],
    [
      InlineCode "-2",
      Words (
        localized ". Low-precedence application $. Groups right."
          "。低優先順位の関数適用 $。右からまとめます。"
      )
    ],
    [
      InlineCode "-3",
      Words (localized ". Signal update :=. Groups right." "。Signalの更新 :=。右からまとめます。")
    ]
  ]]

pub fn rejected -> Array<Block> =
  [BulletList [
    [
      InlineCode "a < b < c",
      Words (
        localized " is a rejected comparison chain."
          " は比較を二つつないでいるため、エラーになります。二つのBool式に分けて&&でつなぎます。"
      )
    ],
    [
      InlineCode "(&&)",
      Words (
        localized " cannot be referenced as a function because it short-circuits."
          " は短絡評価するため関数値として参照できません。"
      )
    ]
  ]]
