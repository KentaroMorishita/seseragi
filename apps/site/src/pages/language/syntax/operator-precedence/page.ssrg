import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, PageDefinition } from "../../../../model/page"
import { readerPage } from "../../reader-article"
import { withDetails } from "../reader-details"
import * as details from "./details"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition = withDetails (
  readerPage "language.syntax.operator-precedence"
    "/docs/language/syntax/operator-precedence/" (en.copy ()) (ja.copy ())
    "syntax-reader-precedence" "7, 9, True" (
      arrays.concat [
        [CodeExample
    ("syntax-reader-precedence-invalid", localized "Rejected example" "受け付けられない例")],
        details.rejected ()
      ]
    ) [
      (
        localized "Pipelines and low-precedence application" "パイプラインと低優先順位の適用",
        "/docs/language/syntax/pipelines-and-low-precedence-application/"
      ),
      (
        localized "Custom operators and fixity" "カスタム演算子と結合規則",
        "/docs/language/syntax/custom-operators/"
      ),
      (
        localized "Optional record field syntax" "省略可能なレコードフィールドの構文",
        "/docs/language/syntax/optional-record-fields/"
      )
    ]
) (details.forms ())

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
