import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "演算子の優先順位",
  summary: (explanation ()).summary,
  exampleTitle: "掛け算と足し算を、括弧の有無で比較する",
  purpose: [
    "演算子の優先順位は、式のどの部分がひとまとまりになるかを決めます。1 + 2 * 3は1 + (2 * 3)として読みます。",
    "まとまり方と評価順序は別の規則です。括弧はまとまりを明示しますが、引数や外部処理を好きな順番で実行する指定ではありません。",
  ],
  reading: [
    "arithmeticでは2 * 3が部分式になり、その6へ1を足して7になります。掛け算は足し算より強くまとまります。",
    "groupedでは(1 + 2)を一つにまとめています。その3を3倍するので、結果は9です。括弧によって計算の意味が変わっています。",
    "inRangeは0 < arithmeticとarithmetic < 10という二つの比較を&&でつなぎます。0 < 7と7 < 10は両方とも真なので、真を表すBoolの値Trueになります。",
    "mainは7, 9, Trueを出力します。比較を二つ続けるときも、一つの長い比較として書くのではなく、それぞれのBoolをつなげてください。",
  ],
  rules: [
    "大きな優先順位の値ほど強くまとまります。詳しい段の一覧は下にあります。ドットや添字による参照が最も強く、その次が空白による関数呼び出しです。自作演算子のinfixr 4は、+、-、:と同じ4の段に入り、右からまとまります。同じ段で左右のまとまり方が衝突する組み合わせには、括弧を付けてください。",
    "通常は同じ強さの演算子を左からまとめます。例外として**、リストの先頭へ要素を加える:、??、$、:=は右からまとめます。比較演算子は連鎖できません。",
    "&&は左側がFalseなら右側を計算しません。||は左側がTrueなら右側を計算しません。値の有無を表すMaybe用の??も、値があるなら右側の代替値を計算しません。このように不要な側を省くことを短絡評価と呼びます。",
    "それ以外の二項演算子では、左側、右側の順に値を計算します。演算子の優先順位が変わることと、すべての計算順序が逆転することを混同しないでください。",
    "算術、比較、リストの:、型に応じた操作を提供するtraitの二項演算子は、(+)のように括弧で囲むと関数として扱えます。型や操作の制約から候補が一つに決まらない場合は、型注釈を付けます。",
    "短絡評価する&&と||、パイプライン、$、Signalの読み書き、前置演算子は、この形で関数値にできません。前置の*や-と、二項の乗算・減算は、書かれた位置から区別します。",
  ],
  mistakes: [
    "下のlow < middle < highは、比較を連鎖するため仕様では許されません。現行0.61.19でこのIntの例を実行すると、SES-T0101（Boolが必要な位置にInt）で拒否されます。",
    "low < middle && middle < highへ直すと、それぞれの比較の結果を&&でつなげます。まとまりが読みにくい式は、意図する部分へ括弧を付け、各演算子へ渡す型も確認してください。",
  ],
  related: [
    "呼び出しとパイプラインが混ざる式を、具体例から読めます。",
    "自作した記号に優先順位や左右のまとまり方を与える方法を確認できます。",
    "??が扱う、フィールドの不在とMaybeの値を確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "括弧がない式は、どこでまとまるか",
  summary: "優先順位は式のまとまりを決めます。括弧を付けると、別のまとまりを明示できます。",
  reading: "まず足し算・掛け算・比較という見慣れた演算で確かめ、詳しい記号の一覧は後から参照します。",
  result: "1 + 2 * 3は7、(1 + 2) * 3は9です。二つの比較を&&でつないだinRangeはTrueになります。",
}
