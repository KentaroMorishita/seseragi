import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "演算子の優先順位",
  summary: (explanation ()).summary,
  formsTitle: "先にまとまる操作から読む",
  formsBody: "強い順に、フィールド・メソッド・添字の参照、関数呼び出し、単項の!・-・Signal読み取りの*、**、乗算・除算・余り、加算・減算・Listの:、比較、&&、||、Maybeの??、>>=・<$>・<*>・|>、$、Signal更新の:=です。先にまとまることと、先に実行されることは区別してください。",
  typingBody: "算術や比較、Listの:、型クラスで提供される二項演算子は、(+)のように丸括弧で囲んで関数として使えます。引数の型と必要なtraitが、その型での演算を決めます。&&や||、パイプライン、$、Signalの読み書き、単項演算子をこの形式の関数にはできません。",
  evaluationBody: "&&は左がFalseなら右を計算しません。||は左がTrueなら右を計算しません。??は左に値があれば右を計算しません。それ以外の二項演算子は左から右へ計算します。**、:、??、$、:=は右から、それ以外の組み込み演算子は左からまとまります。ただし比較の連続はできません。",
  invalidTitle: "優先順位で曖昧な連鎖は許されない",
  invalidBody: "a < b < cは書けません。a < b && b < cと書きます。演算子を関数にしたときに型を決められない場合は型注釈を付けてください。単項の*や-と、乗算や減算は置かれる位置で区別します。意図と違うまとまりになる場合は括弧を使います。",
  diagnosticsBody: "比較の連続は構文エラーです。型に対応する演算がない場合や、演算子の型が曖昧な場合は型エラーです。まず式を括弧で書き直し、各演算の引数の型を確認すると原因を絞れます。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "この式は、どこからひとまとまりになるか",
  summary: "優先順位は、式のどこがひとまとまりになるかを決めます。意図を明示したい場合は括弧を付けます。",
  reading: "1 + 2 * 3では乗算が先にまとまり、結果は7です。(1 + 2) * 3では括弧内の加算が先で、結果は9です。comparisonは二つの真偽値を&&で組み合わせます。",
  result: "comparisonはTrueです。式のまとまり方は、副作用のある処理を勝手な順序で実行してよいという意味ではありません。&&と||には短絡評価もあり、左側だけで結果が決まれば右側を評価しません。"
}
