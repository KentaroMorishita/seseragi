import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "Operator precedence",
  summary: (explanation ()).summary,
  formsTitle: "Read the operations that group most tightly first",
  formsBody: "An operation with higher precedence forms an expression first. Multiplication binds more tightly than addition, so 1 + 2 * 3 means 1 + (2 * 3). From strongest to weakest: field/method/index access; function application; prefix !, -, and Signal read *; **; multiplication/division/remainder; addition/subtraction and List :; comparisons; &&; ||; Maybe ??; >>=, <$>, <*>, and |>; $; Signal update :=. Grouping and evaluation order are separate rules.",
  typingBody: "Arithmetic, comparisons, List :, and trait-provided binary operators can be written as functions in parentheses, such as (+). The argument types and required traits determine which operation is used. &&, ||, pipelines, $, Signal reads and writes, and prefix operators cannot be written as function values in this form.",
  evaluationBody: "&& skips the right side when the left is False. || skips it when the left is True. ?? skips it when the left contains a value. Other binary operators evaluate left then right. **, :, ??, $, and := group right; the other built-in operators group left. Comparisons cannot be chained.",
  invalidTitle: "Split chained comparisons into Bool expressions",
  invalidBody: "a < b < c is not allowed; write a < b && b < c. Add a type annotation if an operator used as a function has an ambiguous type. Position distinguishes prefix * and - from multiplication and subtraction. Use parentheses when you need a different grouping.",
  diagnosticsBody: "A chained comparison causes a syntax error. An unavailable operation for the input type, or an ambiguous operator type, causes a type error. Rewrite the expression with parentheses, then check the input types of each operation.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Which part of this expression is computed together?",
  summary: "Precedence determines how an expression groups. Parentheses make your intended grouping explicit.",
  reading: "In 1 + 2 * 3, multiplication groups first, so the result is 7. In (1 + 2) * 3, the parenthesized addition groups first, so the result is 9. comparison combines two Bool tests with &&.",
  result: "comparison is True. After grouping is determined, ordinary binary operators evaluate their inputs left to right. && and || short-circuit, skipping the right side when the left already determines the result."
}
