import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Operator precedence",
  summary: (explanation ()).summary,
  exampleTitle: "Compare arithmetic with and without parentheses",
  purpose: [
    "Operator precedence determines which parts of an expression group together. Read 1 + 2 * 3 as 1 + (2 * 3).",
    "Grouping and evaluation order are separate. Parentheses make grouping explicit; they do not request an arbitrary order for evaluating inputs or external operations.",
  ],
  reading: [
    "In arithmetic, 2 * 3 forms a subexpression producing 6, then adding 1 produces 7. Multiplication groups more tightly than addition.",
    "grouped explicitly groups (1 + 2), then multiplies that 3 by 3 to produce 9. The parentheses change the calculation.",
    "inRange joins two comparisons with &&: 0 < arithmetic and arithmetic < 10. Both 0 < 7 and 7 < 10 are true, so the Bool result is True.",
    "main prints 7, 9, True. For two comparisons, join the separate Bool results instead of writing one chained comparison.",
  ],
  rules: [
    "Higher precedence groups more tightly; the complete levels appear below. Dot and index access are strongest, followed by space-separated function application. An infixr 4 custom operator shares level 4 with +, -, and :, but groups right. When equal-level operators have conflicting grouping directions, use parentheses.",
    "Operators of equal strength usually group left. **, list cons :, ??, $, and := instead group right. Comparison operators cannot be chained.",
    "&& skips its right side when the left is False; || skips it when the left is True. The Maybe fallback ?? skips its right-side fallback when a value is present. Skipping an unnecessary side is called short-circuit evaluation.",
    "Other binary operators evaluate left then right. A different precedence grouping does not mean all computations run in reverse order.",
    "Arithmetic, comparisons, list cons :, and trait-provided binary operations can be used as functions by parenthesizing the symbol, as in (+). If types and operation constraints do not identify one candidate, add a type annotation.",
    "Short-circuiting && and ||, pipelines, $, Signal reads/writes, and prefix operators cannot be referenced as function values this way. Position distinguishes prefix * and - from multiplication and subtraction.",
  ],
  mistakes: [
    "The low < middle < high below is prohibited by the language's no-chained-comparison rule. On current 0.61.19, this Int example is rejected with SES-T0101: Int appears where Bool is required.",
    "Write low < middle && middle < high to join the separate results. For an unclear expression, add parentheses around the intended groups and check each operator's input types.",
  ],
  related: [
    "Read concrete expressions mixing function calls and pipelines.",
    "Check how a custom operator declares precedence and left/right grouping.",
    "Check absent fields and the Maybe values handled by ??.",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How does an expression group without parentheses?",
  summary: "Precedence determines grouping. Parentheses can explicitly select a different grouping.",
  reading: "Start with familiar addition, multiplication, and comparison; use the complete operator list as a later reference.",
  result: "1 + 2 * 3 is 7, while (1 + 2) * 3 is 9. Joining the two comparisons in inRange with && produces True.",
}
