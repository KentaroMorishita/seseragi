import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Method calls",
  summary: (explanation ()).summary,
  exampleTitle: "Add five while keeping the original counter",
  purpose: [
    "A method is a function associated with a particular type. Call it with familiar dot notation, as in original.add 5.",
    "The example defines add for Counter. It returns a new Counter with the computed value rather than modifying the original.",
  ],
  reading: [
    "struct Counter { value: Int } declares a type with one integer field. Counter { value: 10 } creates a value, which let names original.",
    "impl Counter contains methods for that type. The first parameter of fn add, self: Counter, receives original from before the dot. amount: Int receives 5. The final Counter is the return type.",
    "The body computes self.value + amount, or 10 + 5, and puts it in a new Counter. updated.value is therefore 15. It does not assign into original.value.",
    "main inserts the original and updated fields into a string separated by a newline. It prints 10 and 15. The value before the dot is called the receiver; here that value is original.",
  ],
  rules: [
    "Method selection uses the type known at compile time. For original.add, the compiler looks for add in Counter's impl; it does not choose another method from the value's runtime contents.",
    "The first parameter of an inherent method must be named self and have the enclosing type. Pass further arguments with ordinary space-separated calls. Partial application and methods returning functions follow the remaining function type.",
    "The receiver expression is evaluated once. Field and method access group more tightly than ordinary function application. original.add 5 passes 5 to the method selected by original.add.",
    "Traits are a separate mechanism declaring operations shared by types, with implementations selected through instance declarations. Declaring a trait function does not by itself create an inherent dot method.",
  ],
  mistakes: [
    "original add 5 instead tries to call original as a function. Write original.add 5 for the method call. add (original, 5) also passes one tuple rather than two separate arguments.",
    "The declaration below calls its first parameter counter, producing SES-T0503. Rename it self and change counter.value in the body to self.value. Its type must also match the enclosing Counter type.",
  ],
  related: [
    "Check ordinary function calls before supplying further method arguments.",
    "Look up where impl declarations may appear and how methods are exposed.",
    "Check grouping when dot access, space-separated calls, and arithmetic occur together.",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Where does the value before the dot go?",
  summary: "A method is a function for a particular type. The value before the dot becomes its first parameter, self.",
  reading: "original.add 5 passes original to self and 5 to amount. This method returns a new Counter.",
  result: "The original value stays 10, while the new Counter has value 15.",
}
