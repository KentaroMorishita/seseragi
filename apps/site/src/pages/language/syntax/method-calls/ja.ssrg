import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "メソッド呼び出し",
  summary: (explanation ()).summary,
  exampleTitle: "元のカウンターを残して5を加える",
  purpose: [
    "メソッドは、特定の型に結び付けて定義する関数です。TypeScriptでも見慣れたドットを使い、original.add 5のように呼び出します。",
    "この例ではCounterという型にaddを定義します。addは元の値を変更せず、計算した得点を持つ新しいCounterを返します。",
  ],
  reading: [
    "struct Counter { value: Int }は、valueという整数フィールドを持つ型を宣言します。Counter { value: 10 }で値を作り、originalと名前を付けます。",
    "impl Counterの中に、この型のメソッドを書きます。fn addの最初の引数self: Counterには、呼び出しのドットより前のoriginalが渡ります。amount: Intには5が渡ります。最後のCounterは戻り値の型です。",
    "メソッド本体のself.value + amountは10 + 5です。その値を使って新しいCounterを作るので、updated.valueは15になります。original.valueへ代入しているのではありません。",
    "mainの文字列は、元の値と更新後の値を改行で分けて出力します。結果は10と15です。ドットの前に置く値をレシーバーと呼び、この例ではoriginalがそれに当たります。",
  ],
  rules: [
    "どのメソッドを使うかは、コンパイル時に分かる型から決まります。original.addではCounterのimplにあるaddを探します。実行時の値の中身から別のメソッドを選び直す仕組みではありません。",
    "この形式のメソッドの最初の引数はselfと書き、型はそのimplが属する型にします。後続の引数は普通の関数と同じように空白で渡します。引数の一部を渡したり、関数を返すメソッドを使ったりする場合も、残りの関数型に従います。",
    "レシーバーの式は一度だけ評価します。フィールド参照とメソッド参照は、通常の関数呼び出しより強くまとまります。original.add 5では、original.addで選んだメソッドへ5を渡します。",
    "traitは、複数の型で使える操作の約束を定義する別の仕組みです。その実装はinstance宣言などで選びます。traitに関数を宣言しただけで、このimpl形式のドットメソッドになるわけではありません。",
  ],
  mistakes: [
    "original add 5は、originalを関数として呼ぼうとする別の式です。メソッドにはoriginal.add 5と書きます。add (original, 5)も、二つの引数ではなく一つのタプルを渡しています。",
    "下の宣言は最初の引数をcounterと書いているため、SES-T0503になります。引数名をselfに直し、本体のcounter.valueもself.valueへ変えます。selfの型も、そのメソッドが属するCounterでなければなりません。",
  ],
  related: [
    "メソッドに追加の引数を渡す前提となる、通常の関数呼び出しを確認できます。",
    "implを置ける場所や、メソッドの公開範囲を調べられます。",
    "ドット、空白の呼び出し、算術演算を混ぜたときのまとまり方を確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "ドットの前の値は、どこへ渡るか",
  summary: "メソッドは特定の型のための関数です。ドットの前の値を、最初の引数selfとして受け取ります。",
  reading: "original.add 5では、originalをselfへ、5をamountへ渡します。例のメソッドは新しいCounterを返します。",
  result: "元のvalueは10のままで、新しいCounterのvalueは15になります。",
}
