import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "リテラル",
  summary: (explanation ()).summary,
  purpose: [
    "件数、価格、表示名など、コードの中に値を直接書きたいときにリテラルを使います。リテラルとは、3や\"Seseragi\"のように、計算や読み込みをせずに値を書く形です。",
    "Seseragiでは、整数のIntと小数を扱うFloatは別の型です。TypeScriptのnumberのように一つの型として扱うのではなく、まず値の書き方で区別します。例では五つの基本的な値を名前に結び付けて表示します。"
  ],
  exampleTitle: "整数、小数、真偽、文字、文字列を表示する",
  reading: [
    "let count: Int = 3は、3にcountという名前を付けます。名前の後の: Intは、値が整数の型Intに合うことを確かめる型注釈です。別の型へ変換する指定ではありません。priceの2.5には小数点があるため、型はFloatです。",
    "activeのTrueは真を表すBoolの値です。偽にはFalseを使います。initialの'S'は一文字を表すChar、labelの\"Seseragi\"は文字列を表すStringです。一重引用符と二重引用符で、値の型が変わります。",
    "mainのバッククォートは文字列のテンプレートを囲みます。${count}などの場所へ値の表示を入れ、間のカンマと空白を残します。引用符は値を囲む記号なので出力には入りません。結果は3, 2.5, True, S, Seseragiの一行です。"
  ],
  rules: [
    "整数として書いた42はInt、小数点または指数を含む42.0や4.2e1はFloatです。どれも数としては42ですが、書き方で型が決まり、周囲が求める型に合わせて別の数値型へ自動で変わることはありません。",
    "Intは十進数のほか、0bまたは0Bで始まる二進数、0oまたは0Oで始まる八進数、0xまたは0Xで始まる十六進数で書けます。たとえば0b1010は十進数の10です。桁区切りの_は値を変えず、1_000は1000と同じ整数になります。",
    "Floatは十進表記で書きます。指数のeまたはEの後には、必要なら+か-を付け、一桁以上の数字を書きます。6.022e23は6.022に10の23乗を掛けた数、1.0e-9は1.0を10の9乗で割った数です。NaNや無限大はリテラルではなく、std/numberが用意する名前付きの値です。",
    "Intの値の範囲は-9007199254740991から9007199254740991までです。負号は数の一部ではなく、値を負にする演算子です。負号を除いたリテラル自体は0から9007199254740991までなので、範囲を超えた数字は負号の後ろでも使えません。Intには負の0はなく、整数計算で生じても0になります。",
    "Floatは64ビットの浮動小数点数で、十進数をすべて正確に表せるわけではありません。最も近い表現へ丸め、ちょうど中間なら二進表現の末尾が偶数になる方を選びます。有限の数として書いた値が大きすぎて無限大になる場合はエラーです。小さすぎる数は符号を保った0になることがあり、-0.0は負の0です。",
    "テンプレートの${...}に書いた式は、左から右へ一度ずつ計算します。各値は、その型の表示方法を定めるShowという処理で文字列になります。表示方法が用意されていない型ならコンパイルエラーです。テンプレートを作るだけでは画面へ出力せず、この例ではprintlnに渡した文字列が出力されます。",
    "バッククォートの直後が[なら、文字列ではなくListの値を作ります。`[1, 2]は整数を順に並べたListです。それ以外のバッククォートはテンプレート文字列の開始になります。()はUnitという型の唯一の値で、渡したり返したりする内容がないことを表します。"
  ],
  mistakes: [
    "桁区切りの_は、その数の基数で使える数字と数字の間に一個だけ置けます。先頭、末尾、0xなどの直後、または連続した位置には置けません。下の1__0はSES-P0203になります。1_0または10へ直してください。現行の診断文が「範囲外」と説明していても、この例の原因は値の大きさではなく_の位置です。",
    "十進数は0だけの場合を除き、余分な0から始められません。00や01は使えず、0bなどの後には少なくとも一桁が必要です。各基数で使えない数字、十六進数の小数、型を示す接尾辞もエラーになります。",
    "小数点の両側には数字が必要です。1.や.5ではなく、1.0や0.5と書きます。指数の途中で終わる1eも使えません。不正な数値の書き方や範囲外のリテラルにはSES-P0203が出ます。不正な部分の手前だけを有効な数として受理することはありません。",
    "リテラルが範囲内でも、その後の整数計算がIntの範囲を超えると実行が停止します。このように、通常の戻り値で回復可能な失敗として扱わない実行上の問題を欠陥と呼びます。範囲を超えた値が小さな数へ戻ることはありません。"
  ],
  related: [
    "CharとStringに引用符、改行、Unicode文字を書く方法を調べます。",
    "値に付ける名前、UTF-8のソースファイル、コメントの規則を調べます。",
    "数値を扱う関数や、NaN・無限大などの名前付きの値を調べます。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "数値や文字列をソースへ直接書くには",
  summary: "リテラルは、3、True、\"Seseragi\"など、ソースに直接書く値です。整数はInt、小数点や指数のある数はFloatのように、書き方で型が決まります。",
  reading: "count、price、active、initial、labelに、それぞれ整数、小数、真偽、文字、文字列の値を付けています。:の後は型を確かめる注釈で、mainが五つの値を表示します。",
  result: "出力は3, 2.5, True, S, Seseragiと末尾の改行です。値を囲んだ引用符や型注釈は表示されず、テンプレートに書いたカンマと空白は表示されます。"
}

pub fn title -> String = (copy ()).title
