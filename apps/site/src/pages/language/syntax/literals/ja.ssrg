import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "リテラル",
  summary: (explanation ()).summary,
  formsTitle: "リテラルの形で型が決まる",
  formsBody: "整数はInt、小数点または指数を含む数はFloatです。TrueとFalseはBool、一重引用符で囲む文字はChar、二重引用符で囲む文字列はStringです。バッククォートの直後が[ならList、それ以外ならテンプレート文字列です。()はUnitという値です。",
  typingBody: "数値の書き方で型が決まり、周囲に合わせて別の数値型にはなりません。Intには十進・二進・八進・十六進の形式があり、値の範囲は-9007199254740991から9007199254740991です。負号は数値に含まれる文字ではなく、値を負にする演算子です。Floatは64ビットの浮動小数点数です。",
  evaluationBody: "テンプレート中の式は左から右へ一度ずつ計算します。Showという型ごとの文字列化の処理で値を文字列にします。文字列を作るだけなので、出力は行いません。Floatは最も近い表現へ丸め、ちょうど中間なら末尾が偶数になる方を選びます。有限の数の綴りが無限大になる場合はエラーです。小さすぎる数は符号を保った0になることがあります。",
  invalidTitle: "数値の区切りと小数点を確認する",
  invalidBody: "桁区切りの_は同じ基数の数字と数字の間に一個だけ置けます。十進数の余分な先頭の0、基数の後の数字不足、十六進の小数、型を示す接尾辞、未完成の指数、1.、.5は使えません。小数は1.0、0.5のように書きます。",
  diagnosticsBody: "不正な数値の書き方や値の範囲を超えたリテラルにはSES-P0203が出ます。正しいリテラルでも、後の整数計算が範囲を超えると実行時の欠陥として停止します。値が小さい数へ一周して戻ることはありません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "数値や文字列をソースに直接書くには",
  summary: "リテラルは、42、True、\"hello\"など、ソースに直接書く値です。その書き方によって型が決まります。",
  reading: "millionは数字の間を_で区切ったIntで、avogadroは指数を含むFloatです。一重引用符はChar、二重引用符はString、バッククォートは式の表示結果を埋め込めるテンプレート文字列です。",
  result: "42ではなく42.0と書くと、表示方法が違うIntではなくFloatになります。数字の区切りは値を変えません。不正な綴りや範囲外のリテラルは実行前に拒否されます。"
}
