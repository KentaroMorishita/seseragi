import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "Literals",
  summary: (explanation ()).summary,
  formsTitle: "A literal's spelling determines its type",
  formsBody: "Integers have type Int; numbers with a decimal point or exponent have type Float. True and False are Bool values. Single quotes enclose a Char and double quotes enclose a String. A backtick immediately followed by [ begins a List; otherwise it begins a template String. () is the Unit value.",
  typingBody: "A number's spelling determines its type without conversion to another numeric type from context. Int accepts decimal, binary, octal, and hexadecimal forms, with values from -9007199254740991 through 9007199254740991. Minus is an operator on the number, not part of the numeric token. Float is a 64-bit floating-point number.",
  evaluationBody: "Expressions in a template are evaluated once each, left to right. Show converts each value to text, which is inserted into the template. Constructing the template does not print it. Float rounds to the nearest representation, using ties to even. Finite spelling that becomes infinity is rejected; a very small value may become signed zero.",
  invalidTitle: "Check digit separators and decimal points",
  invalidBody: "An underscore may occur once between two digits of the same base. Extra leading decimal zeroes, missing digits after a base prefix, hexadecimal fractions, type suffixes, incomplete exponents, 1., and .5 are rejected. Write decimal fractions as 1.0 or 0.5.",
  diagnosticsBody: "Invalid numeric spelling or an out-of-range literal reports SES-P0203. Even with valid literals, later integer arithmetic stops execution if it leaves the supported range. Such a runtime problem is called a defect, rather than a recoverable failure. The value does not wrap around to a smaller number.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I write a value directly in source?",
  summary: "A literal is a value written directly, such as 42, True, or \"hello\". Its written form determines its initial type.",
  reading: "million uses underscores between digits and is still Int. avogadro includes an exponent and is Float. Single quotes enclose a Char, double quotes a String, and backticks a template that can insert an expression's displayed value.",
  result: "42 has type Int; 42.0 has type Float. Underscore digit separators do not change the numeric value. Invalid literal spelling or an out-of-range value causes an error before execution."
}
