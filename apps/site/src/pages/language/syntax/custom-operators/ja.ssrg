import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "カスタム演算子と結合規則",
  summary: (explanation ()).summary,
  formsTitle: "記号・式のまとまり方・処理を宣言する",
  formsBody: "operatorで演算子の記号と関数を宣言します。例のoperator<A> infixr 5 <+> left: A -> right: A -> A where Semigroup<A> = append left rightでは、<+>を優先順位5で右からまとめます。leftとrightをappendで組み合わせ、A型の値を返します。where Semigroup<A>は、A型にappendの実装が必要という条件です。他モジュールから使う場合はimport { operator <+> }で読み込みます。",
  typingBody: "left <+> rightは、(<+>) left rightと同じ関数呼び出しです。一方の引数だけを渡すこともできます。演算子名と通常の値の名前は別々に扱われます。既存の演算子を特定の型で使う場合は、新しい記号の宣言ではなくtraitやstruct・newtypeの演算子宣言を使います。",
  evaluationBody: "infixlは左から、infixrは右から式をまとめます。infixの演算子を続けて使う場合は、括弧でまとめ方を指定する必要があります。優先順位は0〜8で、数が大きい演算子を先にまとめます。関数呼び出しやドットによる参照は、それより先にまとまります。同じモジュール内では、演算子の宣言より前でも使えます。",
  invalidTitle: "予約済みの記号を再定義しない",
  invalidBody: "許可されたASCIIの演算子文字を二文字以上使います。標準演算子、->、<-、範囲やコメントの記号、??、:=は予約済みです。山括弧だけの記号も使えません。値の前や後ろだけに付けるカスタム演算子はありません。単独の&は要求をまとめるための記号です。",
  diagnosticsBody: "同じ記号を複数のimportから読み込むと、どちらを使うか決められません。また、同じ優先順位で左結合と右結合を混ぜる場合は、括弧で意図を明示してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "自分の処理に演算子の記号を付けるには",
  summary: "カスタム二項演算子は、二つの値の間に記号を書いて呼ぶ関数です。宣言では、続けて使う場合の式のまとまり方も指定します。",
  reading: "例の<+>は、leftとrightで受け取った二つのStringをappendでつなぎます。infixr 4は優先順位4で右からまとめる指定です。a <+> b <+> cのように続けると、a <+> (b <+> c)という式になります。",
  result: "labelは\"Seseragi docs\"になります。infixrが決めるのは式のまとまり方です。引数を評価する順番を右から左へ変える指定ではありません。他モジュールのカスタム演算子は、importでoperatorとして明示的に読み込みます。"
}
