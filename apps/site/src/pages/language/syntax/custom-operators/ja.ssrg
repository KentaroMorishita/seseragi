import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "カスタム演算子と結合規則",
  summary: (explanation ()).summary,
  exampleTitle: "二つの文字列を空白でつなぐ記号を定義する",
  purpose: [
    "自分で定義した二引数の関数を、left <+> rightのように二つの値の間へ置く記号として使えます。これがカスタム演算子です。",
    "まず通常の関数呼び出しと演算子の優先順位を理解してから使う機能です。この例は仕組みを見るための小さな文字列結合です。記号を増やす場合は、短さだけでなく、読む人に意味が伝わるかを考えてください。",
  ],
  reading: [
    "operatorが演算子を宣言します。<+>が新しい記号で、left: Stringとright: Stringが二つの引数です。最後のStringは戻り値が文字列であることを示します。",
    "本体のleft + \" \" + rightは、二つの文字列の間へ空白を一つ入れます。\"Seseragi\" <+> \"docs\"は、この本体へ二つの文字列を渡します。",
    "infixr 4は、優先順位4で右側からまとめる指定です。a <+> b <+> cならa <+> (b <+> c)と読みます。引数の評価順序を右からにする指定ではありません。",
    "labelはSeseragi docsになり、mainがその文字列を出力します。同じ演算は(<+>) \"Seseragi\" \"docs\"のように、記号を括弧で囲んだ関数としても呼べます。",
  ],
  rules: [
    "演算子はトップレベルに宣言します。left <+> rightは(<+>) left rightと同じ関数呼び出しです。一つ目の引数だけを渡して、次の値を待つ関数にすることもできます。",
    "infixlは左から、infixrは右からまとめます。infixは非結合で、同じ演算子の連鎖には括弧が必要です。優先順位は0〜8の整数で、大きいほど強くまとまります。関数呼び出しやドット・添字の参照より強い演算子は作れません。",
    "記号は、許可されたASCII文字! $ % & * + - . / : < = > ? @ ^ | ~を二文字以上組み合わせます。標準演算子、->、<-、..、...、//、??、:=は予約済みです。<と>だけの記号も使えません。前置・後置の自作演算子はありません。",
    "単独の&は、EffectやStreamの型で必要なサービスを組み合わせる場所に限った別の記号です。通常の値の演算子や、一般的な交差型として使うものではありません。",
    "演算子名は普通の値名とは別に管理されます。別のモジュールから使うときはimport { operator <+> }のように明示します。同じ記号を複数箇所から取り込むと曖昧になります。同じ優先順位でも左右の結合指定が違う演算子を混ぜる場合は、括弧で意図を示します。",
    "宣言はモジュールの先読みで収集されるので、同じソース内なら宣言より前でも使えます。標準の+などを特定の型へ実装することは、新しい記号の宣言とは別で、対応するtraitの実装やstruct内のoperator宣言を使います。",
    "複数の型で使う発展形では、operator<A>のAが型の引数です。where Semigroup<A>は、その型の二つの値をappendで合わせられることを要求します。append left rightで同じ型の値を返す宣言が、その例です。最初のString専用の例を読むために、この制約を先に学ぶ必要はありません。",
  ],
  mistakes: [
    "下の^は一文字なので、自作演算子の名前にできずSES-P0001になります。予約済みでない二文字以上の記号を選んでください。引数は二つ宣言します。",
    "infixrは右結合ですが、計算時に右の引数から評価するという意味ではありません。また、括弧が必要な連鎖や、複数モジュールからの同名の取り込みを、見た目の字下げだけで解決することはできません。",
  ],
  related: [
    "自作記号が、標準の演算子や関数呼び出しとどうまとまるかを確認できます。",
    "普通の名前、予約語、文脈で特別な名前との区別を確認できます。",
    "演算子を関数として呼ぶ場合や、一部の引数を先に渡す場合の基礎を確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "自分の処理に演算子の記号を付けるには",
  summary: "カスタム演算子は、二つの値の間に書ける関数です。記号だけでなく、優先順位と左右のまとまり方も宣言します。",
  reading: "通常の関数を読めるようになってから使う発展的な構文です。最初は型の引数やtraitを使わず、二つのStringをつなぐ例で確認します。",
  result: "\"Seseragi\" <+> \"docs\"は、定義した関数で間に空白を入れ、Seseragi docsを返します。",
}
