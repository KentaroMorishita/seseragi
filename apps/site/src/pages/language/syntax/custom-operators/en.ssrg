import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "Custom operators and fixity",
  summary: (explanation ()).summary,
  formsTitle: "Declare the symbol, grouping, and operation",
  formsBody: "operator declares an operator symbol and its function. In operator<A> infixr 5 <+> left: A -> right: A -> A where Semigroup<A> = append left right, <+> groups to the right at precedence 5. append combines left and right, returning an A value. where Semigroup<A> requires an append implementation for A. Import it from another module with import { operator <+> }.",
  typingBody: "left <+> right is the same function call as (<+>) left right. You can supply only its first argument. Operator names and ordinary value names are separate. To use an existing operator for a particular type, use the corresponding trait or a struct/newtype operator declaration rather than declaring a new symbol.",
  evaluationBody: "infixl groups left and infixr groups right. Repeated uses of an infix operator require parentheses to choose grouping. Precedence ranges from 0 to 8; larger numbers group more tightly. Function application and dot access group more tightly still. Within one module, an operator can be used before its declaration.",
  invalidTitle: "Do not redefine reserved symbols",
  invalidBody: "A symbol uses at least two permitted ASCII operator characters. Standard operators, ->, <-, range and comment symbols, ??, and := are reserved. A symbol made only of angle brackets is not allowed. Custom prefix and postfix operators are not supported. A single & combines requirements.",
  diagnosticsBody: "Importing the same symbol from several sources makes it ambiguous. When combining equal-precedence operators with left and right grouping, add parentheses to state the grouping.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I define a readable operator for my operation?",
  summary: "A custom binary operator names a function used between two operands. Its declaration also states how expressions with that operator group.",
  reading: "The example's <+> joins two String arguments, left and right, with append. infixr 4 selects right grouping at precedence 4. A chain a <+> b <+> c therefore means a <+> (b <+> c).",
  result: "label is \"Seseragi docs\". infixr determines grouping; it does not change argument evaluation from left-to-right to right-to-left. Import a custom operator explicitly with operator when using it from another module."
}
