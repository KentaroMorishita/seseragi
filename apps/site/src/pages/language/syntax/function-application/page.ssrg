import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { syntaxPage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  syntaxPage "language.syntax.function-application" "/docs/language/syntax/function-application/" (en.copy ()) (ja.copy ()) [
    CodeExample (
      "function-application",
      localized "Curried application in a complete program" "引数を一つずつ渡し、残りを待つ関数を作る"
    ),
    BulletList [
      [
        InlineCode "add 1 2",
        Words
          (localized " parses as (add 1) 2." " は(add 1) 2の意味です。先に1を渡し、その結果の関数へ2を渡します。")
      ],
      [
        InlineCode "add 1",
        Words (
          localized
          " has the remaining function type Int -> Int when add is Int -> Int -> Int."
          " はaddがInt -> Int -> Intなら残りのInt -> Int型を持ちます。"
        )
      ],
      [
        InlineCode "fn clock -> Instant",
        Words (
          localized " declares an anonymous Unit parameter; invoke it as clock ()."
          " は()を受け取り、Instant型の時刻を返す関数の宣言の形です。clock ()で呼びます。"
        )
      ],
      [
        InlineCode "identity<String> value",
        Words (
          localized " keeps the explicit type argument attached to the callee."
          " はidentityの型引数にStringを指定してから、値valueを渡します。"
        )
      ]
    ]
  ] [BulletList [
    [
      InlineCode "add(1, 2)",
      Words (
        localized " is not Seseragi's multi-argument call syntax."
          " は複数の引数を渡す形式ではありません。整数二つならadd 1 2と書きます。"
      )
    ],
    [
      InlineCode "identity < value",
      Words
          (localized " is comparison, not explicit type application." " は明示型適用ではなく比較です。")
    ]
  ]] [
    [InternalLink
          (localized "Method calls" "メソッド呼び出し", "/docs/language/syntax/method-calls/")],
    [InternalLink (
      localized "Pipelines and low-precedence application" "パイプラインと低優先順位の適用",
      "/docs/language/syntax/pipelines-and-low-precedence-application/"
    )],
    [InternalLink (
      localized "Operator precedence" "演算子の優先順位",
      "/docs/language/syntax/operator-precedence/"
    )]
  ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
