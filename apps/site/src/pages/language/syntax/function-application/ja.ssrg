import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "関数適用",
  summary: (explanation ()).summary,
  formsTitle: "空白で引数を一つずつ渡す",
  formsBody: "二つの引数を渡す場合はadd 1 2と書きます。この式は(add 1) 2とまとまり、引数を一つずつ渡します。括弧は式をまとめるほか、(1, 2)のようなタプルやUnitの値()を書くために使います。",
  typingBody: "関数の型A -> B -> Cは、A -> (B -> C)を意味します。A型の最初の引数を渡すと、B型の引数を待つ関数が返り、その型はB -> Cです。具体的な型を指定する場合は、identity<String> valueのように関数名へ空白なしで型引数を付けます。identity < valueのように空白を置くと、<は比較になります。",
  evaluationBody: "関数と引数を左から右へ一度ずつ計算してから、関数の本体を実行します。ただしEffectを返す関数の場合、呼び出して得られるのは後で実行する処理を表す値です。この呼び出しだけで入出力などが始まるわけではありません。",
  invalidTitle: "渡す値の型と式のまとまりを確認する",
  invalidBody: "関数でない値は呼び出せません。関数が要求する型と違う引数を渡した場合も型エラーです。if、match、do、ラムダ式の全体を一つの引数にするときは括弧で囲んでください。カスタム二項演算子の前後には空白が必要ですが、演算子を関数として書く(<+>)の中には空白を入れません。",
  diagnosticsBody: "型エラーが出たら、まず関数が受け取る引数の数と型を確認してください。add (1, 2)はタプル一個、add 1 2は整数二個を渡す書き方で、同じ意味ではありません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "関数に引数を渡すには",
  summary: "関数名の後に、空白で区切って引数を書きます。一部の引数だけを渡すと、残りの引数を受け取る関数を作れます。",
  reading: "宣言のleftとrightはIntの引数で、最後のIntは戻り値の型です。add 1でleftに1を渡すと、rightを待つ関数が返ります。その関数をaddOne 2で呼ぶと、1 + 2を計算します。",
  result: "answerは3です。add 1 2も(add 1) 2の意味なので3になります。add (1, 2)はタプルを一つ渡す書き方であり、addが必要とするIntの引数には合いません。"
}
