import { ArticleCopy } from "../../../../model/article"

pub fn copy -> ArticleCopy = ArticleCopy {
  title: "関数適用",
  summary: "fnで検索用の文字列を作り、名前を渡して呼んでみよう。計算と出力の境目も確認する。「関数と記法」の章の入口。"
}

pub fn title -> String = (copy ()).title

pub fn opening -> String =
  "コマンドパレットで「  Build  」と入力しても、buildを見つけたい。表示名はそのままにして、比較用の文字列だけ整えてみよう。"

pub fn roadmap -> String =
  "この章は三つの寄り道。まず計算に名前を付け、次に関数を手元に残し、最後に組み合わせる。呼び出しの細かい規則を調べたいときは、各ページの後半へ直接飛んでね。"

pub fn call -> String =
  "key \"  Build  \"は\"build\"を返す。関数の後ろに、空白で区切って引数を渡す。カンマや呼び出し用の括弧は要らない。keyの中の括弧は、text.trim nameの結果を丸ごとtext.toLowerへ渡すためのもの。"

pub fn declaration -> String =
  "fnで関数に名前を付ける。name: Stringが受け取る値、-> Stringが返す値の型。=の後の式が、そのまま結果になる。最後にreturnを書くための一行は要らない。ここではtext.trimで前後の空白を取り、text.toLowerでASCIIのコマンド名を小文字にしている。"

pub fn display -> String =
  "keyがするのはStringの計算。printlnは出力する処理をEffectという値で表し、mainが返したその値を実行機構が実行する。effectな関数を呼ぶだけでは、その処理は始まらない。この境目があるので、検索の計算はコンソールなしでも試せる。"

pub fn reuse -> String =
  "入力した検索文字にも、候補のラベルにもkeyを使える。整形・検索・表示・出力を全部詰めた大きな関数にせず、使い回せる一片ができた。次のページではmatchesへ検索文字を先に渡し、その条件を覚えた関数を作ってみよう。"

pub fn grouping -> String =
  "add 1 2は(add 1) 2としてまとまる。型も対応していて、Int -> Int -> IntはInt -> (Int -> Int)の意味。最初の整数を渡すと、Int -> Intという関数が残る。A -> B -> Cも同じで、ここでのA・B・Cは任意の型を表す説明用の名前だよ。 たとえばlet addOne = add 1ならInt引数が一つ残り、addOne 2で3を得る。"

pub fn unit -> String =
  "引数名のない宣言も、Unitという型の値を一つ受け取る。たとえばfn answer -> Int = 42はanswer ()と呼ぶ。Unitは渡す内容がないことを表し、()が唯一の値。answerという名前だけでは関数のままになる。"

pub fn generic -> String =
  "型を明示して呼ぶこともできる。fn identity<A> value: A -> A = valueは、受け取った値をそのまま返す関数。identity<String> \"ready\"ならAにStringを選ぶ。<String>は関数名へ空白なしで続けよう。identity < valueの<は比較の構文になる。"

pub fn evaluation -> String =
  "関数と引数は、左から右へ一度ずつ計算する。Effectを返す関数を呼ぶと、後で行う処理を表す値が得られる。その呼び出しだけでは入出力は始まらない。また、addの引数はどちらもIntなので、役割を取り違えて渡しても型だけでは検出できない。"

pub fn forms -> String =
  "複数の部分からなる式を丸ごと一つの引数に渡すときは、括弧で囲む。条件で値を選ぶif、データの形で選ぶmatch、処理を順につなぐdo、その場で関数を作るラムダが該当する。独自の二項演算子はleft <+> rightのように前後へ空白が必要。同じ演算子を関数として参照するなら(<+>)と書く。ここで<+>は、別途定義する演算子の表記例。"

pub fn tuple -> String =
  "add(1, 2)と書きたくなるかもしれないけど、ここでの(1, 2)はタプル一個。最初のInt引数へ(Int, Int)を渡そうとするので、SES-T0101になる。二つの引数を渡すなら、add 1 2へ直そう。"

pub fn repair -> String =
  "呼び出しが型エラーになったら、渡したものを宣言と比べてみよう。タプル一個なのか、型が違うのか、そもそも関数ではない値なのか。括弧を足しても、タプルが二つの引数に分かれるわけではない。"

pub fn partialExit -> String = "：章の次のページ。検索文字を固定した関数を、候補の絞り込みへ渡してみよう。"

pub fn typesExit -> String = "：型注釈をどこに書くか調べる。"

pub fn methodExit -> String = "：値の後ろにドットを付ける呼び方へ。"

pub fn compositionExit -> String = "：入れ子の呼び出しで、括弧・$・パイプラインを使い分ける。"

pub fn precedenceExit -> String = "：括弧を省いた式がどうまとまるか調べる。"
