import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "関数適用",
  summary: (explanation ()).summary,
  purpose: [
    "関数の宣言は一度書けば、add 20 2のように入力を変えて同じ計算を使えます。引数の順番と型は宣言から読めます。この例は両方ともIntなので、二つの値の順番を取り違えたかどうかは型では判定できません。",
    "さらに、一部の引数だけを渡して残りを受け取る関数を作れます。まず全部を渡す呼び方を確認し、その使い方が必要になったら下の部分適用の説明へ進んでください。"
  ],
  exampleTitle: "関数を定義し、必要な引数を全部渡す",
  reading: [
    "Intは整数の型です。引数の間の->と、戻り値の直前の->は、宣言を左から読む区切りです。呼び出し側では型や矢印を書かず、add 1 2のように値を並べます。単にaddと書けば、計算結果ではなく関数そのものを指します。",
    "println (show answer)は表示のための呼び出しです。show answerが整数を文字列にし、括弧がその計算全体を一つの引数にまとめます。printlnはその文字列と改行を出力します。pub effect fn mainは公開された実行入口で、返したEffect（実行する処理を表す値）を実行機構が開始します。"
  ],
  rules: [
    "add 1 2は(add 1) 2のまとまりです。先に1だけを渡したadd 1は、残りの整数を受け取る関数になります。let addOne = add 1と名前を付ければ、addOne 2で3を得られます。一部だけを渡す使い方を部分適用と呼びます。",
    "関数型Int -> Int -> IntはInt -> (Int -> Int)という意味です。一つの整数を渡した後にはInt -> Int、つまり整数を受け取って整数を返す関数が残ります。一般にA -> B -> Cと書く場合、A・B・Cはここでは任意の型を表す説明用の名前で、A -> (B -> C)と読みます。",
    "引数名を書かないfn answer -> Int = 42も、Unitという型の値()を一個受け取る関数です。answer ()で呼ぶと42を返します。Unitは渡す内容がないことを表し、()がその唯一の値です。answerだけでは関数のままです。",
    "具体的な型を指定する呼び方もあります。fn identity<A> value: A -> A = valueは、同じ型の値を受け取ってそのまま返す関数です。Aは呼び出しごとに選ぶ型の名前で、identity<String> \"ready\"はAにStringを指定します。<String>は関数名へ空白なしで続けます。identity < valueの<は比較として読まれ、型の指定にはなりません。",
    "関数と引数は左から右へ一度ずつ計算します。Effectを返す関数を呼ぶと、後で実行する処理を表す値が得られます。その呼び出しだけでは、表した入出力は始まりません。",
    "複数の部分からなる式全体を一つの引数にするときは、括弧で囲みます。if（条件で値を選ぶ式）、match（データの形に応じて選ぶ式）、do（処理を順につなぐ式）、ラムダ式（その場で作る関数）が該当します。独自の二項演算子はleft <+> rightのように前後へ空白が必要です。同じ演算子を関数として書く(<+>)では括弧の内側へ空白を入れません。ここで<+>は別途定義する演算子の表記例です。"
  ],
  mistakes: [
    "(1, 2)は二つの値をまとめたタプル一個です。次のadd(1, 2)は、そのタプルを最初のInt引数へ渡そうとするため、SES-T0101になります。期待する型はInt、実際は(Int, Int)です。add 1 2へ直してください。",
    "同じ型エラーでも、引数の型が合わない場合と、関数ではない値を呼んでしまった場合があります。まず宣言と対応させ、何を一つの引数として渡したかを確認します。"
  ],
  related: [
    "一部の引数を渡した後の関数と、その型を詳しく調べます。",
    "関数の型注釈を書く場所を調べます。",
    "値の後ろに.を付ける呼び方を調べます。",
    "入れ子の呼び出しを読みやすく並べる方法を調べます。",
    "括弧を省いた式がどの順にまとまるか調べます。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "二つの整数を関数へ渡して足すには",
  summary: "関数名の後に、引数を空白で区切って書きます。1と2を足す関数なら、add 1 2と呼びます。関数へ値を渡すことを、関数適用とも呼びます。",
  reading: "fnでaddという関数を定義しています。left: Intとright: Intは整数を受け取る引数で、途中の->は次の引数へ続き、最後の-> Intは整数を返す指定です。=の右側のleft + rightが返す値になります。",
  result: "add 1 2ではleftに1、rightに2を渡すため、結果は3です。let answer = ...がその結果にanswerという名前を付けます。TypeScriptのadd(1, 2)に相当する通常の二引数の呼び出しを、ここでは空白で書いています。"
}

pub fn title -> String = (copy ()).title
