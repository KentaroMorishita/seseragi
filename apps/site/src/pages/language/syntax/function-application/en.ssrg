import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "Function application",
  summary: "Whitespace application is curried, strict, left-associative, and distinct from grouping, tuples, and Effects.",
  formsTitle: "Whitespace applies one argument at a time",
  formsBody: "Write add 1 2, not add(1, 2). Application associates left, so add 1 2 means (add 1) 2. Parentheses group an expression, construct a tuple, or spell the sole Unit value; they are not a multi-argument call form.",
  typingBody: "A curried type A -> B -> C means A -> (B -> C). Applying the first argument returns B -> C. Explicit type arguments attach to the callee without whitespace: identity<String> value is type application followed by value application, while identity < value is comparison.",
  evaluationBody: "The callee and every argument are evaluated strictly, from left to right, exactly once, before the function body runs. Applying a function that returns Effect constructs the cold Effect value; ordinary application does not run its body.",
  invalidTitle: "Application does not infer a different call grammar",
  invalidBody: "A non-function callee, an unresolved generic constraint, or an argument outside the callee's parameter type is a type error. Group if an if, match, do, or lambda must be one ordinary argument. Custom infix operators require surrounding whitespace, while an operator value such as (<+>) has no inner whitespace.",
  diagnosticsBody: "Parser diagnostics own malformed application and type-argument boundaries. Type checking owns non-functions, argument mismatches, and incomplete constraints. Tooling preserves the same left-associated application tree used by the compiler.",
  provenanceBody: "This article covers specification sections 1.4, 2.7, and 3.1. The highlighted program is the canonical values-and-functions lesson and is compiled by the specification suite."
}
