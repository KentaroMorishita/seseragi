import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "Function application",
  summary: (explanation ()).summary,
  formsTitle: "Pass one argument at a time, separated by spaces",
  formsBody: "Write add 1 2 to pass two arguments. It groups as (add 1) 2, applying one argument at a time. Parentheses group an expression or write a tuple such as (1, 2), or the Unit value ().",
  typingBody: "The type A -> B -> C means A -> (B -> C). Supplying an A argument returns a function waiting for a B argument, with type B -> C. To choose a concrete type, attach type arguments without spaces: identity<String> value. With spaces, as in identity < value, < is comparison.",
  evaluationBody: "The function and its arguments are computed once, left to right, before the function body runs. When the function returns an Effect, the result describes work to execute later. That call alone does not start the described I/O.",
  invalidTitle: "Check argument types and expression grouping",
  invalidBody: "A value that is not a function cannot be called. An argument of the wrong type also causes a type error. Use parentheses when an entire if, match, do, or lambda expression must be one argument. Custom binary operators require surrounding spaces; an operator written as a function, such as (<+>), has no spaces inside.",
  diagnosticsBody: "For a type error, first check how many arguments the function takes and their types. add (1, 2) passes one tuple, whereas add 1 2 passes two integers. They are different calls.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I pass arguments to a function?",
  summary: "Write the function name followed by space-separated arguments. Supplying only some arguments creates a function that accepts the rest.",
  reading: "The declaration names left and right as Int parameters; the final Int is the result type. add 1 supplies left and returns a function. addOne 2 supplies right to that function, which computes 1 + 2.",
  result: "answer is 3. add 1 2 also computes 3, because it means (add 1) 2. add (1, 2) instead passes one tuple; that tuple does not match add's first Int parameter."
}
