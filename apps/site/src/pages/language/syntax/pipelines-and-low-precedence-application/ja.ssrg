import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "パイプラインと低優先順位の適用",
  summary: (explanation ()).summary,
  exampleTitle: "二倍して1を足す流れを左から読む",
  purpose: [
    "複数の関数を順に使うとき、前の結果を次へ渡す流れを左から書けるのがパイプラインです。x |> fはf xという普通の関数呼び出しと同じ意味です。",
    "例では整数3をdoubleで二倍し、addOneで1を加えます。普通の括弧による呼び出しや、右側を引数としてまとめる$とも比較します。",
  ],
  reading: [
    "doubleとaddOneは、どちらもIntという整数型の値を受け取り、整数を返します。fnの後が関数名、value: Intが引数とその型、最後の-> Intが戻り値の型です。",
    "pipedの3 |> doubleはdouble 3を呼び、6になります。次の行の|> addOneが6を渡すので、結果は7です。実際のソースも、|>を行頭に置いて複数行に分けています。",
    "nestedのaddOne (double 3)は、括弧の内側の6をaddOneへ渡します。withoutParenthesesのaddOne $ double 3も、右側のdouble 3を一つの引数にまとめます。",
    "mainは三つの値を改行で分けて出力します。どの書き方も同じ関数へ同じ値を渡すので、7が三行出ます。",
  ],
  rules: [
    "|>は左からまとまります。x |> f |> gはg (f x)です。複数の引数を取る関数では、先の引数をあらかじめ渡すと、パイプラインの左側の値がその次の引数になります。残りの引数まで自動で補うわけではありません。",
    "$は右からまとまります。f $ g $ xはf (g x)です。Signalへ値を書き込む:=を除く二項演算子は$より強くまとまるため、f $ x + 1ではx + 1全体がfの引数です。",
    "パイプラインは$より強くまとまります。render $ values |> transformはrender (transform values)です。この読み方ではtransformを一引数の関数とし、まずvaluesを変換してからrenderへ渡します。",
    "どちらも、普通の関数呼び出しと同じ型検査と評価順序です。渡す値の型は受け取る引数の型に合う必要があります。関数と引数を評価してから本体を呼びます。|>や$だけで計算が遅延したり、並列になったり、Effectの処理が実行されたりはしません。",
  ],
  mistakes: [
    "下のdecorateはStringを受け取るのに、3というIntを渡しているためSES-T0101になります。文字列を渡すか、show 3 |> decorateのように先に文字列へ変換してください。",
    "単独の|はパイプラインではありません。型の選択肢などで使う別の記号です。また、$は固定の呼び出し構文で、上書きできる演算子や関数値ではありません。($)を引数として渡すことはできません。",
  ],
  related: [
    "先にいくつかの引数を渡して、次の値を受け取る関数を作る方法を確認できます。",
    "パイプラインを改行しても同じ式になる条件を確認できます。",
    "$や|>が算術演算子などと混ざる場合のまとまり方を一覧で確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "変換の流れを左から右へ読むには",
  summary: "|>は左側の値を右側の関数へ渡します。$は右側の式を引数としてまとめます。",
  reading: "どちらも、普通の関数呼び出しを読みやすく書く方法です。まず一引数の関数で流れを追います。",
  result: "同じ3を二倍して1を足すため、パイプライン、括弧、$のどれでも7になります。",
}
