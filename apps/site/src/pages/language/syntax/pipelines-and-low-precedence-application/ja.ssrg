import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "パイプラインと低優先順位の適用",
  summary: (explanation ()).summary,
  purpose: [
    "パイプラインは、一つの関数の結果を次の関数へ渡す呼び出しの書き方です。x |> fはf xと同じ意味になります。",
    "例のdoubleは整数を2倍にし、addOneは1を足します。パイプライン、括弧、$の三通りで、同じ順番の計算を書いています。"
  ],
  exampleTitle: "同じ計算を三通りで書く",
  reading: [
    "3 |> doubleはdouble 3を呼び出し、6になります。続く|> addOneがその6を受け取り、7になります。連続したパイプラインは左端の値から読んでください。",
    "addOne (double 3)は括弧を使った同じ計算です。内側のdouble 3の結果が、外側のaddOneの引数になります。",
    "addOne $ double 3もaddOne (double 3)と同じです。$の右側をひとまとまりの引数にすることで、外側の括弧を省いています。",
    "三つの出力はすべて7です。どの書き方でも、doubleに整数の3を渡し、その結果の整数の6をaddOneへ渡します。"
  ],
  rules: [
    "|>は左からまとまります。x |> f |> gはg (f x)です。複数の引数を取る関数につなぐときは、先に渡す引数を指定しておき、次の引数としてパイプラインの値を渡します。",
    "$は右からまとまります。f $ g $ xはf (g x)です。Signalの更新記号:=以外の二項演算子は、$より先にまとまります。そのためf $ x + 1では、x + 1全体がfの引数です。",
    "render $ values |> transformはrender (transform values)です。ここではtransformは一つの引数を取る関数とします。先にtransformへvaluesを渡し、その結果をrenderへ渡します。",
    "どちらも通常の関数呼び出しの型検査と評価順を使います。関数と渡す引数を評価してから本体を実行します。パイプラインや$を使うだけで、遅延評価や並行処理が始まることはありません。"
  ],
  mistakes: [
    "|だけではパイプラインになりません。この記号は型の宣言や内包表記で別の用途に使います。処理をつなぐ場合は|>と書きます。",
    "$は関数呼び出し専用の構文であり、定義し直せる演算子や関数値ではありません。($)を関数の引数にすることはできません。型エラーが出たら、前の処理が返す型と次の処理が受け取る型を確認してください。"
  ],
  related: [
    "先に一部の引数を渡し、パイプラインで使う関数を作る方法を確認できます。",
    "パイプラインを複数行に分けるときの規則を確認できます。",
    "複数の種類の演算子を混ぜた式が、どこでまとまるかを確認できます。"
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "続けて呼ぶ処理を、左から右へ読みたいときは",
  summary: "パイプラインは、前の処理の結果を次の関数へ渡します。$は、右側の式全体を外側の括弧なしで引数にする書き方です。",
  reading: "doubleは2倍にし、addOneは1を足します。3 |> doubleで6になり、続く|> addOneで7になります。addOne (double 3)とaddOne $ double 3も同じ計算です。",
  result: "三つの出力はすべて7です。つなげる関数は、前の関数が返す型の値を受け取れなければなりません。例ではdoubleの戻り値も、addOneの引数もIntです。"
}
