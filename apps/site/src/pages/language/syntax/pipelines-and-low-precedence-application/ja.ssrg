import { ArticleCopy } from "../../../../model/article"

pub fn copy -> ArticleCopy = ArticleCopy {
  title: "パイプラインと低優先順位の適用",
  summary: "コマンドの絞り込みと表示を、普通の適用・$・|>でつなぐ。見つからない可能性は、<$>で残したまま扱おう。"
}

pub fn title -> String = (copy ()).title

pub fn opening -> String =
  "検索する関数ができた。今度は、合う候補だけを残し、表示用のラベルへ変換しよう。下の入れ子、$、パイプラインは、同じデータを同じ関数へ渡している。この作業が読みやすくなる形を選べばいい。"

pub fn flow -> String =
  "choicesはコマンドの集まりから始まり、条件に合うものを残して、残った名前をbadgeで表示用にする。各段に仕事があるので、ここではパイプラインが読みやすい。keyの中も、空白を取り、小文字にする同じ小さな流れ。|>そのものが新しい関数型や実行動作を追加するわけではない。"

pub fn choice -> String =
  "nestedは、絞り込んだ候補の集まりを括弧でまとめて渡す。compactの$は、右側の式をmap badgeへの引数としてまとめる。三つの結果が一致するのでsameはTrue。matches \"b\"のような短い呼び出しは、そのままで十分読める。何でもパイプラインへ直すと、記号が増えるだけだね。"

pub fn maybe -> String =
  "findの結果はMaybe<String>。候補が見つかればJustにラベルが入り、なければNothingになる。badge <$> pickedなら、見つかった場合のラベルだけを変換し、その「ないかもしれない」は残す。\"z\"の検索は見つからないので、badgeを写してもNothingのまま。pickedを直接badgeへ渡すと、String引数には合わない。"

pub fn effects -> String =
  "mainのdoは、四つの出力処理を順につなぐために使っている。検索とラベル作りはpureな計算のまま。doがEffectをつなぎ、返されたEffectを実行機構が実行する。printlnを飾るための構文でも、前の配列処理をeffectに変えるものでもない。"

pub fn pipelineRules -> String =
  "|>は左からまとまる。x |> f |> gはg (f x)。引数が複数ある関数なら、arrays.filter (matches \"b\")のように先の引数を渡しておく。左の値は次の引数になり、残りを自動で補うことはない。"

pub fn dollarRules -> String =
  "$は右からまとまる。f $ g $ xはf (g x)。Signalへの代入:=を除く二項演算子は$より強くまとまるので、f $ x + 1ではx + 1全体をfへ渡す。|>も$より強い。render $ values |> transformはrender (transform values)になる。"

pub fn evaluation -> String =
  "どちらも普通の適用と同じ型検査・評価順序。関数と引数を評価してから、本体を呼ぶ。|>や$だけで遅延計算、並列実行、Effectの実行が始まることはない。変わるのは、適用の書き方だ。"

pub fn rejected -> String =
  "下の例はStringを受け取るdecorateへIntを渡すので、SES-T0101になる。Stringを渡すか、show 3で明示的に文字列へ変えてからdecorateを使おう。パイプラインが型変換を補うことはない。"

pub fn syntaxBoundary -> String =
  "単独の|はパイプラインではない。$も固定の適用構文で、上書きや($)としての引数渡しはできない。短絡評価などの構文専用の記号も、何でも関数値になるわけではない。sectionとして使う前に、演算子のReferenceを確認しよう。"

pub fn bridge -> String =
  "この章の出口だけど、合成の終点ではない。<$>は文脈を保って中の値を変換する。<*>は文脈の中にある関数と引数を組み合わせる。>>=は中の結果を、次の文脈を返す処理へ渡す。最後の依存関係は、doで結果に名前を付けても書ける。次の入力が独立なのか、前の結果を必要とするのかで選ぼう。詳しい操作はリンク先で。圏論の予習は要らないよ。"

pub fn previousExit -> String = "：章の前のページ。matches \"b\"が返す関数を確認する。"

pub fn layoutExit -> String = "：改行したパイプラインが同じ式として続く条件を調べる。"

pub fn precedenceExit -> String = "：演算子が混ざった式のまとまり方を一覧で調べる。"

pub fn startExit -> String = "：章の見取り図と、小さなkey関数へ戻る。"

pub fn doExit -> String = "：pureな文脈も含め、doをbindの列として読む。"

pub fn operatorsExit -> String = "：入力同士の依存関係から、<$>・<*>・>>=を選ぶ。"
