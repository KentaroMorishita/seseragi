import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Pipelines and low-precedence application",
  summary: (explanation ()).summary,
  purpose: [
    "A pipeline writes a call that passes one function's result to the next function. x |> f has the same meaning as f x.",
    "In this example, double multiplies an integer by two and addOne adds one. The pipeline, parentheses, and $ forms all describe the same order of calculation."
  ],
  exampleTitle: "Three spellings of the same calculation",
  reading: [
    "3 |> double calls double 3, producing 6. The following |> addOne passes 6 to addOne, producing 7. Read a pipeline chain from its leftmost value.",
    "addOne (double 3) writes the same calculation with parentheses. The inner double 3 supplies the argument to the outer addOne.",
    "addOne $ double 3 also means addOne (double 3). $ groups the expression on its right as an argument without the outer pair of parentheses.",
    "The three outputs are all 7. Each spelling passes the integer 3 to double, then passes its resulting integer 6 to addOne."
  ],
  rules: [
    "|> groups to the left. x |> f |> g means g (f x). For a function taking several arguments, supply its earlier arguments first; the pipeline then supplies its next argument.",
    "$ groups to the right. f $ g $ x means f (g x). Binary operators other than the Signal update symbol := group more tightly than $. Thus f $ x + 1 passes the whole x + 1 to f.",
    "render $ values |> transform means render (transform values). Here transform takes one argument. Pass values to transform first, then pass its result to render.",
    "Both spellings use ordinary function-call type checking and evaluation order. The function and its arguments are evaluated before the body runs. A pipeline or $ alone does not start delayed evaluation or concurrent work."
  ],
  mistakes: [
    "A single | is not a pipeline. It has other roles in type declarations and collection comprehensions; write |> for a pipeline.",
    "$ is fixed call syntax, not an overloadable operator or a function value. You cannot pass ($) as an argument. If a chain gives a type error, inspect the result type of one stage and the parameter type of the following stage."
  ],
  related: [
    "Look up how supplying earlier arguments produces a function for a pipeline.",
    "Check where a pipeline may continue onto another line.",
    "Check the complete grouping rules when several operator kinds occur together."
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can I read a chain of transformations from left to right?",
  summary: "A pipeline passes one function's result to the next. The $ form groups a right-hand expression as an argument without outer parentheses.",
  reading: "double multiplies an integer by two; addOne adds one. Starting at 3, 3 |> double produces 6, then |> addOne produces 7. addOne (double 3) and addOne $ double 3 describe the same calculation.",
  result: "All three outputs are 7. The next function must accept the previous function's result type. Here double returns Int and addOne takes Int."
}
