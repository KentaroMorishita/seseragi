import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Pipelines and low-precedence application",
  summary: (explanation ()).summary,
  purpose: [
    "A pipeline is another way to write a function call, not a new kind of computation. x |> f means f x. It is useful when the result of one operation becomes the input of the next.",
    "The example has two ordinary functions: double multiplies an integer by two, and addOne adds one. Three different spellings call those functions in the same order."
  ],
  exampleTitle: "Three spellings of the same calculation",
  reading: [
    "3 |> double calls double 3, producing 6. The following |> addOne passes that result to addOne, producing 7. Follow a chain from its leftmost value.",
    "addOne (double 3) is the same calculation written with parentheses. The inner call finishes first; its value becomes the argument of the outer call.",
    "addOne $ double 3 is also equivalent to addOne (double 3). $ lets the expression on its right form the argument without that outer pair of parentheses.",
    "The three printed values are all 7. Neither symbol delays work, starts a task, or changes the parameter and result types of the functions."
  ],
  rules: [
    "Pipelines group to the left: x |> f |> g means g (f x). A function needing several arguments must already have its earlier arguments supplied before the pipeline supplies its next argument.",
    "$ groups to the right: f $ g $ x means f (g x). Ordinary binary operators bind more tightly than $, except the Signal update operator :=. Thus f $ x + 1 passes x + 1 to f.",
    "A mixed expression render $ values |> transform means render (transform values). Here transform takes one argument. This describes grouping; the usual function-call type checks still apply.",
    "Both forms use ordinary strict evaluation: the function and the supplied argument are evaluated before the function body uses that argument. These spellings do not make a function lazy."
  ],
  mistakes: [
    "A single | is not a pipeline. It has other roles in type declarations and collection comprehensions; write |> for a pipeline.",
    "$ is fixed call syntax, not an overloadable operator or a function value. You cannot pass ($) as an argument. If a chain gives a type error, inspect the result type of one stage and the parameter type of the following stage."
  ],
  related: [
    "Look up how supplying earlier arguments produces a function for a pipeline.",
    "Check where a pipeline may continue onto another line.",
    "Check the complete grouping rules when several operator kinds occur together."
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can I read a chain of transformations from left to right?",
  summary: "A pipeline passes one function's result to the next. The $ form groups a right-hand expression as an argument without outer parentheses.",
  reading: "double multiplies an integer by two; addOne adds one. Starting at 3, 3 |> double produces 6, then |> addOne produces 7. addOne (double 3) and addOne $ double 3 describe the same calculation.",
  result: "All three printed results are 7. These forms do not add parallelism, delayed evaluation, or new error handling. Each connection still requires the previous result's type to match the next parameter."
}
