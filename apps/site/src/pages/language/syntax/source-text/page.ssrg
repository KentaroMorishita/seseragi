import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { syntaxPage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  syntaxPage "language.syntax.source-text" "/docs/language/syntax/source-text/" (en.copy ()) (ja.copy ()) [
    CodeExample (
      "syntax-source-text",
      localized "Unicode names, apostrophes, and Char boundaries"
        "Unicodeの名前と文字リテラルを区別する"
    ),
    BulletList [
      [
        InlineCode "userName",
        Words (localized " starts with ASCII XID_Start." " はASCIIの英字から始まる名前です。")
      ],
      [
        InlineCode "次の値",
        Words
        (localized " uses Unicode identifier properties." " はUnicodeで識別子に使える文字からなる名前です。")
      ],
      [
        InlineCode "account'",
        Words (
          localized " is one identifier with a trailing apostrophe."
        " は末尾のアポストロフィーを含めて、一つの名前です。"
        )
      ]
    ]
  ] [BulletList [
    [
      InlineCode "1value",
      Words (localized " cannot start with a digit." " は数字から始まるため、名前には使えません。")
    ],
    [
      InlineCode "/* text */",
      Words (localized " is not a block comment form." " は複数行のコメントの開始ではありません。")
    ]
  ]] [
    [InternalLink (
      localized "Character and string escapes" "文字と文字列のエスケープ",
      "/docs/language/syntax/character-string-escapes/"
    )],
    [InternalLink (localized "Literals" "リテラル", "/docs/language/syntax/literals/")],
    [InternalLink (
      localized "Layout and line continuation" "レイアウトと行継続",
      "/docs/language/syntax/layout-and-line-continuation/"
    )]
  ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
