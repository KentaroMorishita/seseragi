import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "ソーステキストとコメント",
  summary: (explanation ()).summary,
  purpose: [
    "変数に分かりやすい名前を付け、判断の理由をコメントに残すと、後からコードを読み直せます。この例では、利用者の名前、数値、アカウントの種類に名前を付けて、一行に表示します。",
    "ソースファイルはUTF-8で保存します。英字だけでなく、次の値のような日本語の名前も書けます。ただし、UTF-8で保存できる文字すべてを名前に使えるわけではありません。"
  ],
  exampleTitle: "名前とコメントを使って一行の案内を作る",
  reading: [
    "let 名前 = 値は、右側の値に左側の名前を付ける宣言です。userNameは文字列\"Aki\"、次の値は整数42、account'は文字列\"primary\"を指します。二重引用符は文字列を囲む記号で、文字列の中身には入りません。",
    "//で始まる一行目は、人に説明するためのコメントです。コンパイラは//からその行の末尾までを計算に使いません。この行を書き換えたり削ったりしても、下の三つの値は変わりません。",
    "mainのバッククォートで囲んだ部分は、文字列を組み立てるテンプレートです。${userName}、${次の値}、${account'}の場所に各値の表示が入ります。間のコロン、空白、丸括弧はそのまま残るため、Aki: 42 (primary)と出力されます。"
  ],
  rules: [
    "改行はLFでもCRLFでも同じ意味です。コメントを複数行に分けるときは、各行に//を書いてください。/* ... */で囲むブロックコメントはありません。",
    "値や関数に付ける名前を、識別子とも呼びます。先頭にはUnicodeのXID_Start、二文字目以降にはXID_Continueに分類される文字を使えます。これはUnicodeが定める「名前の先頭に使える文字」と「名前の続きを書ける文字」の区分です。数字や句読点からは始められません。数字は二文字目以降に使えます。",
    "先頭の文字の後にはアポストロフィ（'）も使えます。account'は末尾のアポストロフィを含めた一つの名前です。accountという名前の後に文字の値を置いた意味にはなりません。文字の値は'a'のように一重引用符で囲み、関数へ渡すなら関数名と値を空白で区切ります。",
    "大文字と小文字は区別します。Trueは真を表すBool型の値ですが、trueは別の名前です。letなど、言語で用途が決まっている予約語は、変数や関数の名前に使えません。キーワードはASCIIの文字で書きます。",
    "名前に使える文字かどうかと、その名前が指す値の型が合うかどうかは別の検査です。たとえば名前の綴りが正しくても、整数を受け取る場所に文字列を渡せば型のエラーになります。"
  ],
  mistakes: [
    "下の例ではprintlnと\"Hello\"の間に/* greeting */を置いています。これをコメントとして読まないため、SES-P0101（未知の演算子）になります。説明は別の行の// greetingへ移すか、println \"Hello\"の後ろに// greetingと書いてください。",
    "1valueのように数字から始まる名前は、言語の規則では使えません。ただし、現行の0.61.19には、使われないlet 1value = 1を受理する場合がある不具合があります。受理されたことを有効な書き方の根拠にせず、value1のように直してください。",
    "見た目が似ていても、Unicode上で違う文字なら別の名前になる場合があります。文字コードや名前に使えない文字の診断では、示された文字の位置を確認します。名前が見つからない場合は、大文字と小文字や予約語に加え、宣言と使用箇所の文字が一致しているか確かめてください。"
  ],
  related: [
    "名前の中のアポストロフィと文字の値を区別し、引用符や改行を文字列へ入れる方法を調べます。",
    "42や\"Aki\"のように、値をソースへ直接書いたときの型と書き方を調べます。",
    "改行が式の区切りになる場合と、一つの式を次の行へ続ける場合を調べます。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "日本語の名前とコメントを使ってコードを書くには",
  summary: "ソースはUTF-8で保存します。letで値に名前を付け、//から行末までに説明を書けます。コメントは、計算する値や出力を変えません。",
  reading: "userNameは\"Aki\"、次の値は42、account'は\"primary\"を指します。最初の行はコメントで、mainのテンプレートは三つの値を一行の文字列にまとめます。",
  result: "出力はAki: 42 (primary)と末尾の改行です。日本語の名前と末尾のアポストロフィは、この例でも宣言と参照の両方で同じ名前の一部として扱われます。"
}

pub fn title -> String = (copy ()).title
