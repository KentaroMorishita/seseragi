import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "ソーステキストとコメント",
  summary: (explanation ()).summary,
  formsTitle: "ファイルはUTF-8で保存する",
  formsBody: "ソースファイルはUTF-8で保存してください。改行はLFでもCRLFでも同じ意味です。名前の先頭には、UnicodeのXID_Startに分類される文字を使えます。二文字目以降にはXID_Continueの文字を使えます。末尾のアポストロフィ（'）も名前の一部です。",
  typingBody: "大文字と小文字は区別されます。Trueは真を表すBoolの値ですが、trueは別の名前です。予約語は変数や関数の名前に使えません。名前として使える文字かどうかと、その名前が指す値の型が合うかどうかは別々に検査されます。",
  evaluationBody: "//からその行の末尾まではコメントです。コメントには説明を書けますが、プログラムの実行結果には影響しません。複数行に説明を置くときは、各行の先頭に//を書きます。",
  invalidTitle: "コメントや名前の境界を確認する",
  invalidBody: "数字や句読記号で名前を始めることはできません。また、/* ... */形式の複数行コメントはありません。見た目が似ている文字でも、Unicode上で別の文字なら別の名前になる場合があります。",
  diagnosticsBody: "文字コードや名前として使えない文字のエラーは、その文字の位置を指します。account'は一つの名前であり、accountの後に文字リテラルを置いた意味にはなりません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "コメントやソースの文字は、どう扱われるか",
  summary: "SeseragiのソースはUTF-8です。コメントは人にコードを説明するもので、プログラムの値にはなりません。",
  reading: "userNameと次の値は、それぞれ値に名前を付ける宣言です。//の後の文章は行末までコメントになります。account'では、末尾のアポストロフィも含めて一つの名前を付けています。",
  result: "コメントを変えても、プログラムが計算する値は変わりません。UTF-8で表せる文字でも、名前の先頭などに使えない場合があります。名前にエラーが出たら、使用した文字と予約語の規則を確認してください。"
}
