import { ExplanationCopy } from "../../explanation"
import { SyntaxCopy } from "../article"

pub fn copy -> SyntaxCopy = SyntaxCopy {
  title: "Source text and comments",
  summary: (explanation ()).summary,
  formsTitle: "Save source files as UTF-8",
  formsBody: "Save source files as UTF-8. LF and CRLF line endings have the same meaning. The first character of a name must belong to the Unicode XID_Start category; later characters use XID_Continue. A trailing apostrophe (') is also part of the name.",
  typingBody: "Names are case-sensitive. True is the Bool value for true, while true is a different name. Reserved words cannot name a variable or function. The compiler checks whether a name uses valid characters separately from checking the type of the value it refers to.",
  evaluationBody: "A comment starts at // and extends to the end of that line. Comments explain code but do not affect the program's result. To write a comment over several lines, start each line with //.",
  invalidTitle: "Check where names and comments begin and end",
  invalidBody: "A name cannot start with a digit or punctuation. The /* ... */ form is not a block comment in Seseragi. Similar-looking characters may denote different names when they are different Unicode characters.",
  diagnosticsBody: "An encoding error or invalid name character points to the character involved. account' is one name; it does not mean account followed by a character literal.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How are comments and source characters treated?",
  summary: "Seseragi source is UTF-8. A comment explains code to readers without contributing a value to the program.",
  reading: "userName and 次の値 each declare a name for a value. Text after // is a comment until the end of the line. In account', the final apostrophe is part of the name.",
  result: "Changing a comment does not change the values the program computes. A character representable in UTF-8 may still be disallowed in a name, particularly at its beginning. When a name is rejected, check its characters and the reserved-word rules."
}
