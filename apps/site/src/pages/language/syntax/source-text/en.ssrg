import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Source text and comments",
  summary: (explanation ()).summary,
  purpose: [
    "Descriptive names and comments about your choices make code easier to revisit. This example names a user, a number, and an account category, then displays them on one line.",
    "Save source files as UTF-8. Names can use Japanese characters, as in 次の値, as well as English letters. However, not every character you can save in UTF-8 is allowed in a name."
  ],
  exampleTitle: "Use names and a comment to build a one-line message",
  reading: [
    "let name = value declares a name on the left for the value on the right. userName refers to the string \"Aki\", 次の値 to the integer 42, and account' to the string \"primary\". Double quotes enclose a string; they are not part of its contents.",
    "The first line starts with // and is a comment for the reader. The compiler does not use the text from // to the end of that line in the calculation. Editing or deleting that comment leaves the three values below it unchanged.",
    "The backticks in main enclose a string template. The displayed values replace ${userName}, ${次の値}, and ${account'}. The colon, spaces, and parentheses between them remain, producing Aki: 42 (primary)."
  ],
  rules: [
    "LF and CRLF line endings have the same meaning. For a comment spanning several lines, put // on each line. There are no /* ... */ block comments.",
    "A name for a value or function is also called an identifier. Its first character must belong to Unicode XID_Start; later characters may belong to XID_Continue. These are Unicode categories for characters allowed to start or continue a name. A name cannot start with a digit or punctuation. Digits can appear after the first character.",
    "An apostrophe (') is also allowed after the first character. account' is one name including the final apostrophe, not the name account followed by a character value. Write a character value in single quotes, as in 'a', and separate it from a function name with a space when passing it as an argument.",
    "Names are case-sensitive. True is the Bool value for true; true is a different name. Reserved words such as let already have a language-defined purpose and cannot name variables or functions. Keywords use ASCII characters.",
    "Whether a name uses valid characters and whether its value has the required type are separate checks. For example, a correctly spelled name can still refer to a string when an integer is needed, producing a type error."
  ],
  mistakes: [
    "The rejected example below places /* greeting */ between println and \"Hello\". Seseragi does not read this as a comment, so it reports SES-P0101 for an unknown operator. Move the explanation to a separate // greeting line, or put // greeting after println \"Hello\".",
    "The language rules do not allow a name beginning with a digit, such as 1value. However, version 0.61.19 currently has a bug that can accept an unused let 1value = 1 declaration. Acceptance in that case does not make the spelling valid; change it to a name such as value1.",
    "Similar-looking characters may denote different names when they are different Unicode characters. For an encoding or invalid-name-character diagnostic, check the character position it identifies. If a name cannot be found, check case and reserved words, and compare the characters in its declaration and use."
  ],
  related: [
    "Distinguish an apostrophe in a name from a character value, and find out how to include quotes or newlines in a string.",
    "Find out which types and spellings apply when you write values such as 42 or \"Aki\" directly in source.",
    "Find out when a newline separates expressions and when one expression continues onto the next line."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I use Unicode names and comments in source?",
  summary: "Save source as UTF-8. Use let to name values and // to explain code through the end of a line. A comment does not change the values computed or printed.",
  reading: "userName refers to \"Aki\", 次の値 to 42, and account' to \"primary\". The first line is a comment, and the template in main combines the three values into one line of text.",
  result: "The output is Aki: 42 (primary) followed by a newline. The Japanese characters and trailing apostrophe are part of the same names in both their declarations and their uses."
}

pub fn title -> String = (copy ()).title
