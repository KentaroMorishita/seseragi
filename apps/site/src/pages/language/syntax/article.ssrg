import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Article,
  Block,
  BulletList,
  Callout,
  CommonMistake,
  Heading,
  Inline,
  PageDefinition,
  Paragraph,
  Words
} from "../../../model/page"

pub struct SyntaxCopy {
  title: String,
  summary: String,
  formsTitle: String,
  formsBody: String,
  typingBody: String,
  evaluationBody: String,
  invalidTitle: String,
  invalidBody: String,
  diagnosticsBody: String,
}

fn blocks english: SyntaxCopy
  -> japanese: SyntaxCopy
  -> formDetails: Array<Block>
  -> invalidDetails: Array<Block>
  -> related: Array<Array<Inline>>
  -> Array<Block> =
  arrays.concat [
    [
      Heading ("accepted-forms", localized english.formsTitle japanese.formsTitle),
      Paragraph ([Words (localized english.formsBody japanese.formsBody)])
    ],
    formDetails,
    [
      Heading ("typing-and-values", localized "Typing and values" "型と値"),
      Paragraph ([Words (localized english.typingBody japanese.typingBody)]),
      Heading (
        "evaluation",
        localized "When and in what order values are computed" "いつ、どの順番で計算するか"
      ),
      Paragraph ([Words (localized english.evaluationBody japanese.evaluationBody)]),
      Callout (
        CommonMistake,
        localized english.invalidTitle japanese.invalidTitle,
        [Words (localized english.invalidBody japanese.invalidBody)]
      )
    ],
    invalidDetails,
    [
      Heading ("diagnostics", localized "Diagnostics and tools" "エラーの確認"),
      Paragraph ([Words (localized english.diagnosticsBody japanese.diagnosticsBody)]),
      Heading ("related-rules", localized "Related rules" "関連する規則"),
      BulletList related
    ]
  ]

pub fn syntaxPage id: String
  -> path: String
  -> english: SyntaxCopy
  -> japanese: SyntaxCopy
  -> formDetails: Array<Block>
  -> invalidDetails: Array<Block>
  -> related: Array<Array<Inline>>
  -> PageDefinition =
  PageDefinition {
    id,
    path,
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: blocks english japanese formDetails invalidDetails related
  }
