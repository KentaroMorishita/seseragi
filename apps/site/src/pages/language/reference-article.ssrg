import * as arrays from "std/array"
import { localized } from "../../model/locale"
import {
  Article,
  Block,
  BulletList,
  Callout,
  CommonMistake,
  Heading,
  Inline,
  PageDefinition,
  Paragraph,
  Words
} from "../../model/page"

pub struct ReferenceCopy {
  title: String,
  summary: String,
  ruleTitle: String,
  ruleBody: String,
  typingBody: String,
  evaluationBody: String,
  invalidTitle: String,
  invalidBody: String,
  diagnosticsBody: String,
  provenanceBody: String
}

fn blocks english: ReferenceCopy
  -> japanese: ReferenceCopy
  -> ruleDetails: Array<Block>
  -> invalidDetails: Array<Block>
  -> related: Array<Array<Inline>>
  -> Array<Block> =
  arrays.concat [
    [
      Heading ("rule", localized english.ruleTitle japanese.ruleTitle),
      Paragraph ([Words (localized english.ruleBody japanese.ruleBody)])
    ],
    ruleDetails,
    [
      Heading ("typing", localized "Typing and scope" "型とスコープ"),
      Paragraph ([Words (localized english.typingBody japanese.typingBody)]),
      Heading ("evaluation", localized "Evaluation" "評価"),
      Paragraph ([Words (localized english.evaluationBody japanese.evaluationBody)]),
      Callout (
        CommonMistake,
        localized english.invalidTitle japanese.invalidTitle,
        [Words (localized english.invalidBody japanese.invalidBody)]
      )
    ],
    invalidDetails,
    [
      Heading ("diagnostics", localized "Diagnostics and tools" "診断とツール"),
      Paragraph ([Words (localized english.diagnosticsBody japanese.diagnosticsBody)]),
      Heading ("specification", localized "Specification source" "仕様の出典"),
      Paragraph ([Words (localized english.provenanceBody japanese.provenanceBody)]),
      Heading ("related-rules", localized "Related rules" "関連する規則"),
      BulletList related
    ]
  ]

pub fn referencePage id: String
  -> path: String
  -> english: ReferenceCopy
  -> japanese: ReferenceCopy
  -> ruleDetails: Array<Block>
  -> invalidDetails: Array<Block>
  -> related: Array<Array<Inline>>
  -> PageDefinition =
  PageDefinition {
    id,
    path,
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: blocks english japanese ruleDetails invalidDetails related
  }
