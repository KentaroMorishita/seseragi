import * as arrays from "std/array"
import { LocalizedText, localized } from "../../model/locale"
import {
  Article,
  Block,
  CodeExample,
  Heading,
  InternalLink,
  PageDefinition,
  Paragraph,
  Terminal,
  Words
} from "../../model/page"

// Page-owned explanations, not a one-sentence specification digest.
pub struct ReaderCopy {
  title: String,
  summary: String,
  purpose: Array<String>,
  exampleTitle: String,
  reading: Array<String>,
  rules: Array<String>,
  mistakes: Array<String>,
  related: Array<String>
}

fn paragraph pair: (String, String) -> Block = match pair {
  (english, japanese) -> Paragraph ([Words (localized english japanese)])
}

fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  map paragraph (arrays.zip japanese english)

fn readingLink pair: ((LocalizedText, String), (String, String)) -> Block = match pair {
  ((title, path), (english, japanese)) -> Paragraph ([
    InternalLink (title, path),
    Words (localized (" — " + english) ("：" + japanese))
  ])
}

pub fn readerPage id: String
  -> path: String
  -> english: ReaderCopy
  -> japanese: ReaderCopy
  -> exampleId: String
  -> output: String
  -> rejected: Array<Block>
  -> related: Array<(LocalizedText, String)>
  -> PageDefinition =
  PageDefinition {
    id,
    path,
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [Heading ("purpose", localized "What this is for" "何のための機能か")],
      paragraphs english.purpose japanese.purpose,
      [
        CodeExample (exampleId, localized english.exampleTitle japanese.exampleTitle),
        Paragraph (
          [Words (
            localized
              "pub exposes main as the entry function. effect fn means it returns an Effect describing external work. The runner executes that work; println writes each displayed value followed by a newline. This program produces:"
              "pubはmainを実行入口として公開する指定です。effect fnは外部処理を表すEffectを返す関数で、実行機構がその処理を開始します。printlnは表示する値と改行を出力します。このプログラムの実行結果は次のとおりです。"
          )]
        ),
        Terminal (localized "Output" "実行結果", output),
        Heading ("reading-the-example", localized "Reading the example" "例を順に読む")
      ],
      paragraphs english.reading japanese.reading,
      [Heading ("rules", localized "Rules and boundaries" "詳しい規則と制限")],
      paragraphs english.rules japanese.rules,
      [Heading ("mistakes", localized "Common mistakes" "間違いやすい点")],
      paragraphs english.mistakes japanese.mistakes,
      rejected,
      [Heading ("related-rules", localized "Look up a specific question" "必要なことを詳しく調べる")],
      map readingLink (arrays.zip (arrays.zip japanese.related english.related) related)
    ]
  }
