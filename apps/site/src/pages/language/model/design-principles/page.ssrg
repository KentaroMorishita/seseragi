import * as arrays from "std/array"
import { localized } from "../../../../model/locale"
import {
  Article,
  BulletList,
  Heading,
  Inline,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words
} from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"
import { OverviewCopy } from "../principle"

fn entry pair: ((String, String, String), (String, String)) -> Array<Inline> =
  match pair {
    ((label, translated, path), (description, translatedDescription)) -> [
      InternalLink (localized label translated, path),
      Words (localized description translatedDescription)
    ]
  }

pub fn page -> PageDefinition = {
  let english: OverviewCopy = en.copy ()
  let japanese: OverviewCopy = ja.copy ()
  let labels = [
    ("Expression-oriented", "式指向", "/docs/language/model/expression-oriented/"),
    ("Immutable by default", "デフォルトで不変", "/docs/language/model/immutable-by-default/"),
    ("No hidden danger", "危険を暗黙に隠さない", "/docs/language/model/no-hidden-danger/"),
    (
      "Backend-independent semantics",
      "生成先に依存しない意味",
      "/docs/language/model/backend-independent-semantics/"
    ),
    ("Diagnosable behavior", "説明可能な振る舞い", "/docs/language/model/diagnosable-behavior/"),
    ("Visible costs", "コストを見えるようにする", "/docs/language/model/visible-costs/"),
    ("Readable density", "読みやすい密度", "/docs/language/model/readable-density/")
  ]
  let descriptions = arrays.zip japanese.descriptions english.descriptions
  PageDefinition {
    id: "language.model.design-principles",
    path: "/docs/language/model/design-principles/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: [
      Paragraph ([Words (localized english.introduction japanese.introduction)]),
      Heading ("principles", localized english.section japanese.section),
      BulletList (map entry (arrays.zip descriptions labels)),
      Heading ("together", localized english.closingTitle japanese.closingTitle),
      Paragraph ([Words (localized english.closing japanese.closing)])
    ]
  }
}
