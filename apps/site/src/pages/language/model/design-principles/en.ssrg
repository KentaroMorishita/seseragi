import { ExplanationCopy } from "../../explanation"
import { OverviewCopy } from "../principle"

pub fn copy -> OverviewCopy = OverviewCopy {
  title: "Design principles",
  summary: (explanation ()).summary,
  introduction: "These pages explain decisions you make when writing Seseragi: how to return a value, update data, and handle a failure. Each principle includes code and its result.",
  section: "What each principle explains",
  closingTitle: "Several principles apply to the same code",
  closing: "Reading an Array element returns Maybe: Just when the element exists, Nothing otherwise. A match handles both cases. The Array is immutable, so passing it to another function does not change its elements. Types and immutability let you determine what this code does.",
  descriptions: [
    ". Use the result of if or match as a function result or another calculation's input.",
    ". Keep the previous value and construct a changed value.",
    ". Check types for missing values and possible failures.",
    ". Preserve Seseragi's calculation rules in generated code.",
    ". Use a diagnostic to identify missing type information and supply it.",
    ". Check work that grows with element count and the data an operation creates.",
    ". Choose code that makes values and processing order clear, rather than merely short."
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What guides the way you write Seseragi code?",
  summary: "Seseragi combines expressions through their results. Ordinary data is immutable, and types represent missing values and failures. Each principle explains how those choices affect the code you write.",
  reading: "An Array may have no element at a requested index. Matching its Maybe result distinguishes Just, which contains an element, from Nothing, which does not. Reading the element leaves the immutable Array unchanged.",
  result: "Read Expression-oriented for using a branch's result, or Immutable by default for updating data. No hidden danger explains why types represent missing values and failed operations."
}
