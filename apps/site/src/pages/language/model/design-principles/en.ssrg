import { ExplanationCopy } from "../../explanation"
import { OverviewCopy } from "../principle"

pub fn copy -> OverviewCopy = OverviewCopy {
  title: "Design principles",
  summary: (explanation ()).summary,
  introduction: "Choose a principle from a question that arises while writing code: using a branch result in the next calculation, updating while retaining an original value, or handling an absent result. You do not need to read every page in order.",
  section: "Choose a principle for your current question",
  closingTitle: "Several principles apply to the same code",
  closing: "Several principles can apply to one calculation. Passing the value chosen by a condition to another function involves expression-oriented code; retaining values before and after an update involves immutability. Check the relevant article through its concrete example and result.",
  descriptions: [
    ". Use a value chosen by if or match as a function result or the next input.",
    ". Use an updated value while retaining the original data.",
    ". Check for absent results and operations that can fail.",
    ". Check Seseragi’s numeric and evaluation rules even when code is generated as TypeScript.",
    ". Read a type error or identify missing inference information and repair the code.",
    ". Consider how input size changes required work and stored results.",
    ". Decide whether to name intermediate values or continue a transformation pipeline.",
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "When should I consult each design principle?",
  summary: "Start from everyday coding decisions to explore Seseragi’s design principles. Choose a question about branches, updates, absence, type errors or the work a calculation needs.",
  reading: "Each link says what its article explains. Those articles introduce unfamiliar terms through concrete examples; this overview assumes no type-theory knowledge.",
  result: "Each article uses a concrete example to establish what the code calculates, what its types tell you and which limits apply. Use that evidence to choose an approach suited to your task."
}

pub fn title -> String = (copy ()).title
