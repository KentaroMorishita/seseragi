import { ExplanationCopy } from "../../explanation"
import { OverviewCopy } from "../principle"

pub fn copy -> OverviewCopy = OverviewCopy {
  title: "Design principles",
  summary: (explanation ()).summary,
  introduction: "These pages explain the reason for a language rule, using a small example and its result. For the exact syntax or type rules, follow the related reference links at the end of each article. You can read the principles in any order; this is not a second lesson sequence alongside the Tour.",
  section: "What each principle explains",
  closingTitle: "The principles work together",
  closing: "A short calculation should still make its result and possible failure clear. For example, an array lookup returns Maybe so you must handle the missing case; match turns those cases into a value; immutable data keeps other code from changing the input behind your back. Concise syntax does not remove these guarantees.",
  descriptions: [
    " — Use the value returned by an if, a match, or a block directly.",
    " — Update data by creating a new value, without changing the old one.",
    " — Handle missing values and failures because the types make them visible.",
    " — Rely on Seseragi's calculation rules, not accidental rules of generated code.",
    " — Supply enough type information for the compiler to make an unambiguous choice.",
    " — Distinguish concise notation from the processing and memory an operation needs.",
    " — Show the data and processing order clearly, rather than aiming for the fewest characters."
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Why do these language rules fit together?",
  summary: "The design principles explain practical choices: branches return values, ordinary data stays immutable, and possible absence or failure remains visible.",
  reading: "For example, an array lookup returns Maybe because the requested position may not exist. You must handle Just and Nothing, and the array cannot be changed behind your back by an ordinary field assignment. These rules support each other rather than merely sharing a slogan.",
  result: "Read the principle that answers your current question; the list is not a second Tour. Each detailed principle contains a small program, its result, the reason for the rule, and what the rule does not guarantee."
}
