import { ExplanationCopy } from "../../explanation"
import { OverviewCopy } from "../principle"

pub fn copy -> OverviewCopy = OverviewCopy {
  title: "設計原則",
  summary: (explanation ()).summary,
  introduction: "この一覧では、Seseragiでコードを書くときの判断基準を説明します。例えば、関数から値を返す方法、データを更新する方法、失敗を扱う方法を調べられます。各ページには、その原則を示すコードと実行結果があります。",
  section: "各原則で分かること",
  closingTitle: "同じコードに複数の原則が適用される",
  closing: "配列の要素を取得すると、結果はMaybeになります。要素があればJust、なければNothingなので、matchで両方を扱います。配列は不変のため、別の関数に渡しても元の要素は変わりません。型と不変性の規則から、コードの結果を判断できます。",
  descriptions: [
    "。ifやmatchが返す値を、関数の戻り値や次の計算に使います。",
    "。更新前の値を残し、変更した新しい値を作ります。",
    "。値がない場合や処理が失敗する場合を、型から確認します。",
    "。生成されたコードでも、Seseragiで定めた計算規則を保ちます。",
    "。型を決められない原因を診断から確認し、必要な情報を補います。",
    "。要素数に応じた処理量や、新しく作るデータを確認します。",
    "。短さだけでなく、値と処理の順序を読み取れる書き方を選びます。"
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Seseragiでは、どんな基準でコードを書くか",
  summary: "Seseragiでは、式の結果を使って処理を組み立てます。通常のデータは不変で、値がない場合や処理の失敗は型に表します。各原則では、この方針がコードの書き方にどう影響するかを説明します。",
  reading: "例えば、配列の指定した位置に要素があるとは限りません。取得結果のMaybeをmatchで分ければ、Justには要素があり、Nothingには要素がないと分かります。配列自体は不変なので、取得後も元の要素は変わりません。",
  result: "分岐を組み立てたいときは「式指向」、更新方法を知りたいときは「デフォルトで不変」を参照してください。「危険を暗黙に隠さない」では、値の不在や処理の失敗を型で表す理由を説明します。"
}
