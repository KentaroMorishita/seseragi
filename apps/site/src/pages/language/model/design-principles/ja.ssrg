import { ExplanationCopy } from "../../explanation"
import { OverviewCopy } from "../principle"

pub fn copy -> OverviewCopy = OverviewCopy {
  title: "設計原則",
  summary: (explanation ()).summary,
  introduction: "各ページでは、小さなコードとその結果を使って、規則の意味と理由を説明します。正確な構文や型の規則を調べたいときは、記事の最後にある関連ページへ進んでください。どの原則から読んでも構いません。Tourと並ぶ別の学習コースではありません。",
  section: "各原則で分かること",
  closingTitle: "原則は、互いに組み合わさる",
  closing: "短く書く場合も、どんな結果が得られ、どんな失敗があり得るかを分かるようにします。例えば、配列の要素取得はMaybeを返すので、見つからない場合を扱う必要があります。matchでその場合も含めて結果を作れます。また、配列が不変なので、別の処理が元の要素を勝手に書き換えることはありません。簡潔な構文でも、こうした規則を省略しません。",
  descriptions: [
    " — if、match、ブロックが返す値を、そのまま使います。",
    " — 元の値を書き換えず、新しい値を作って更新を表します。",
    " — 型に表れた「値がない」「失敗する」の場合を扱います。",
    " — 生成コードの言語の都合ではなく、Seseragiの計算規則で判断します。",
    " — コンパイラが型や実装を一つに決められるよう、必要な情報を与えます。",
    " — 記述の短さと、操作に必要な処理量やメモリを区別します。",
    " — 最短の記述より、データと処理の順番が伝わる書き方を重視します。"
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "個々の規則は、どういう考え方でつながっているか",
  summary: "設計原則は、分岐が値を返すこと、通常のデータが不変なこと、不在や失敗を型に残すことなど、普段の書き方の理由を説明します。",
  reading: "例えば、配列の指定した位置に要素がない可能性があるため、取得結果はMaybeです。JustとNothingを扱い、元の配列も通常の代入で勝手に変わりません。規則が互いに支え合う、具体的な例です。",
  result: "調べたい理由に合う原則を選んでください。この一覧は別のTourではありません。個々の原則では、小さなコードと結果、規則の理由、その規則が保証しないことを説明します。"
}
