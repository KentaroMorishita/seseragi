import { ExplanationCopy } from "../../explanation"
import { OverviewCopy } from "../principle"

pub fn copy -> OverviewCopy = OverviewCopy {
  title: "設計原則",
  summary: (explanation ()).summary,
  introduction: "コードを書いていて迷うことから、必要な原則を選べます。例えば「条件の結果を次の計算へ渡す」「元の値を残して更新する」「値がなかった場合も扱う」という疑問です。全ページを順に読む必要はありません。",
  section: "今の疑問から原則を選ぶ",
  closingTitle: "同じコードに複数の原則が適用される",
  closing: "一つの計算に複数の原則が関わります。条件で選んだ値を次の関数へ渡すなら「式指向」、更新前後を別々に残すなら「デフォルトで不変」が関係します。必要な規則は各記事の例と結果で確かめてください。",
  descriptions: [
    "。ifやmatchで選んだ値を、そのまま関数の結果や次の入力にしたいとき。",
    "。元のデータを保ちながら、変更した新しい値を使いたいとき。",
    "。値が見つからない場合や、処理が失敗する場合を先に確認したいとき。",
    "。TypeScriptへ生成されたコードでも、Seseragiの数値や実行順序の規則を確認したいとき。",
    "。型エラーや推論に足りない情報を読み取り、コードを直したいとき。",
    "。要素数が増えると必要な処理や保存する結果がどう変わるかを考えるとき。",
    "。途中の値に名前を付けるか、変換をパイプラインで続けるかを選ぶとき。",
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "いつ、どの設計原則を参照すればよいか",
  summary: "日常のコードの選び方から、Seseragiの設計原則を調べる入口です。分岐、更新、不在、型のエラー、処理量など、必要な疑問に合う記事を選べます。",
  reading: "各リンクには、その記事で分かることを書いています。初めて見る用語は各記事の具体例で説明し、ここでは型理論の知識を前提にしません。",
  result: "選んだ記事では、コードが何を計算するか、型から何を確認できるか、どんな制限があるかを具体例で確かめられます。知りたい目的に合う書き方を判断するために使ってください。"
}

pub fn title -> String = (copy ()).title
