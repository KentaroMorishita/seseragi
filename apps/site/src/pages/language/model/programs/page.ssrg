import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { conceptPage } from "../concept"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  conceptPage "language.model.programs" "/docs/language/model/programs/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "language-program-entry",
        localized "Declare the entry point and required console service"
      "実行入口と必要なコンソールを宣言する"
      )] [
        [InternalLink (
          localized "Function application" "関数適用",
          "/docs/language/syntax/function-application/"
        )],
        [InternalLink (
          localized "Backend-independent semantics" "生成先に依存しない意味",
          "/docs/language/model/backend-independent-semantics/"
        )],
        [InternalLink (
          localized "What Seseragi is" "Seseragiとは",
          "/docs/language/model/what-is-seseragi/"
        )]
      ]
