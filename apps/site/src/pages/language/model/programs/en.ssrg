import { ExplanationCopy } from "../../explanation"
import { ConceptCopy } from "../concept"

pub fn copy -> ConceptCopy = ConceptCopy {
  title: "Programs and entry points",
  summary: (explanation ()).summary,
  ruleTitle: "Files define code; main starts the program",
  ruleBody: "Modules contain declarations, such as functions and types, and imports of other modules. Importing makes definitions available; it is not a place to write application actions. An executable package selects its entry module in seseragi.toml, and that module exports main.",
  consequencesTitle: "Read the entry point in the example",
  consequenceOne: "pub makes main available outside its module. effect fn declares a function returning an Effect. Unit means successful completion has no further result to return.",
  consequenceTwo: "with Console says the work needs a console service. fails ConsoleError names the possible console error type. println writes Hello, Seseragi! followed by a newline.",
  consequenceThree: "The runtime supplies the declared services and executes main's Effect. If main can report errors, they need a Show implementation so the host can display an unhandled failure.",
  boundaryTitle: "Libraries do not need main",
  boundaryBody: "A library exports definitions for other code and needs no executable entry point. A package may offer both a library and an executable. The selected execution target, such as a process or browser, must provide the services the executable needs."
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How does a file become an executable program?",
  summary: "A source file is a module declaring functions and types. To run a package, select a module with a public main. The Effect returned by main describes operations such as console output.",
  reading: "pub makes main public. -> Unit means there is no result data to use after success. with Console requires the Console service for output. fails ConsoleError states that the operation may fail with a ConsoleError.",
  result: "The runner supplies the service and executes the returned operation, printing Hello, Seseragi! followed by a newline. Importing a module only makes its definitions available; it is not the program's execution command."
}
