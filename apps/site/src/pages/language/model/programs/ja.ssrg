import { ExplanationCopy } from "../../explanation"
import { ConceptCopy } from "../concept"

pub fn copy -> ConceptCopy = ConceptCopy {
  title: "プログラムと実行入口",
  summary: (explanation ()).summary,
  ruleTitle: "計算する関数と、表示を始める入口を分ける",
  ruleBody: "文字列を作ることと、それを端末へ表示することは別の処理です。greetingは文字列を返し、mainはその文字列を出力する処理を返します。ファイルを実行すると、実行機構がmainの返した処理を開始します。",
  consequencesTitle: "明示した成功値・サービス・失敗を読む",
  consequenceOne: "明示形式でもpubはmainを公開し、effect fnは実行する処理を表すEffectを返す関数です。-> Unitは、成功後に使う追加の結果がないことを表します。Unitの値は()です。",
  consequenceTwo: "with Consoleは、出力先となるConsoleサービスが必要だという指定です。fails ConsoleErrorは、その出力処理がConsoleErrorという型の失敗を返し得るという指定です。短い形式では、これらを本体から推論します。",
  consequenceThree: "実行機構は必要なサービスを用意してEffectを実行します。mainが通常の失敗を返し得る場合、その失敗を表示するShowの実装が必要です。Showは値を表示用の文字列へ変える操作を定める仕組みです。",
  boundaryTitle: "ライブラリにはmainは不要",
  boundaryBody: "ライブラリは、他のコードが使う定義を公開するもので、実行入口のmainは不要です。一つのパッケージがライブラリと実行可能なプログラムを兼ねることもできます。パッケージではseseragi.tomlが入口のモジュールを選び、そのモジュールのmainを公開します。選んだ実行環境が、必要なサービスを提供できることも必要です。",
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "計算するだけの関数を、実行して表示するプログラムにするには",
  summary: "普通の関数が値を計算し、公開mainが入出力などの実行する処理を返します。実行機構がその処理を開始することで、結果が画面に表示されます。",
  reading: "greetingへAkiを渡して作った文字列をmessageに保存し、mainのprintlnで表示します。関数の戻り値と、出力する処理を分けて読みます。",
  result: "main.ssrgとして保存して実行すると、Hello, Aki!と改行が出力されます。greetingを定義しただけでは画面へ表示しません。",
}

pub fn caption -> String = "挨拶の文字列を作り、mainから表示する"

pub fn readingTitle -> String = "例を順に読む"

pub fn runTitle -> String = "この一ファイルを確認して実行する"

pub fn runNotice -> String =
  "新しい作業フォルダーにmain.ssrgとして保存します。lintは名前や型を検査し、runは実行入口の条件も確認してから動かします。CLIの準備がまだなら、下の「最初のプログラムを実行する」で確認できます。"

pub fn invalidTitle -> String = "文字列を返すだけのmainは、実行入口にはならない"

pub fn invalidCaption -> String = "定義としては有効でも、実行入口の条件を満たさない例"

pub fn invalid -> String =
  "下のpub fn mainはStringを返す普通の関数です。lintは成功しますが、runはinvalid entry pointとして拒否します。表示したいならpub effect fn main = println (greeting \"Aki\")へ直します。これで実行するEffectを返し、Hello, Aki!を出力できます。"

pub fn contractTitle -> String = "必要な情報を明示する書き方"

pub fn contractCaption -> String = "同じ入口の条件を明示する別の完全なプログラム"

pub fn contractNotice -> String =
  "この別の例はHello, Seseragi!を出力します。先ほどの短い形式と同じ実行方式ですが、成功値・サービス・失敗を宣言へ書いています。"

pub fn reading -> Array<String> = [
  "fn greeting name: String -> Stringは、nameという文字列を受け取り、文字列を返す関数です。=の後では+で文字列をつなぎます。greeting \"Aki\"の戻り値はHello, Aki!です。",
  "let message = greeting \"Aki\"は、その戻り値をmessageという名前で使えるようにします。ファイルの一番外側にあるこの計算は、入口を呼ぶ前の初期化で行われます。まだ入出力はしていません。",
  "pub effect fn mainは実行入口として公開する関数です。println messageは、messageと改行を出力するEffectを作ります。Effectは後で実行する処理を表す値で、作っただけでは出力を開始しません。",
  "実行機構がmainを呼び、返されたEffectへ必要なサービスを供給して実行します。そのときprintlnの出力が行われます。TypeScriptのトップレベルにconsole.logを書く場合と違い、どの処理を実行するかをmainから返しています。",
]

pub fn related -> Array<String> = [
  "CLIの準備、保存場所、検査と実行の手順を確認できます。",
  "複数ファイルのパッケージで、どのmainを入口に選ぶかを確認できます。",
  "Effectを実行する仕組みと、失敗や後片付けの扱いを詳しく確認できます。",
]

pub fn moduleBoundary -> String =
  "一つのソースファイルをモジュールと呼び、関数や型の宣言、ほかのモジュールを使うimportを書きます。import先の純粋な初期化計算は行われますが、そのファイルのmainを呼んだり、保存されたEffectを自動実行したりはしません。"
