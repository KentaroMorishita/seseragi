import { ConceptCopy } from "../concept"

pub fn copy -> ConceptCopy = ConceptCopy {
  title: "プログラムと実行入口",
  summary: "ソースファイル一つがモジュール一つに対応します。実行するプログラムは、パッケージで選んだモジュールの公開main関数から始めます。",
  ruleTitle: "ファイルでコードを定義し、mainから実行する",
  ruleBody: "モジュールには、関数や型などの宣言と、他のモジュールを使うためのimportを書きます。importは定義を使えるようにするもので、アプリケーションの処理を書く場所ではありません。実行可能なパッケージでは、seseragi.tomlで実行入口のモジュールを選び、そのモジュールからmainを公開します。",
  consequencesTitle: "例のmainを、上から読む",
  consequenceOne: "pubはmainをモジュールの外へ公開します。effect fnはEffectを返す関数の宣言です。Unitは、成功して完了した後に、別の結果を返す必要がないことを表します。",
  consequenceTwo: "with Consoleは、コンソールのサービスが必要だという指定です。fails ConsoleErrorは、その処理でこの型のエラーが起こり得るという指定です。printlnはHello, Seseragi!と改行を出力します。",
  consequenceThree: "実行時の仕組みが必要なサービスを用意し、mainのEffectを実行します。mainがエラーを返す可能性がある場合、そのエラーにはShowによる表示処理が必要です。処理されなかったエラーを、実行環境が表示できるようにするためです。",
  boundaryTitle: "ライブラリにはmainは不要",
  boundaryBody: "ライブラリは、他のコードが使う定義を公開するもので、実行入口のmainは不要です。一つのパッケージがライブラリと実行可能なプログラムの両方を提供することもできます。プロセスやブラウザなど、選んだ実行環境は、プログラムに必要なサービスを提供する必要があります。"
}
