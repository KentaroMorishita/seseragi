import { ConceptCopy } from "../concept"

pub fn copy -> ConceptCopy = ConceptCopy {
  title: "What Seseragi is",
  summary: "Seseragi builds programs from functions and immutable values. Types are checked before execution, and missing values and failures are explicit.",
  ruleTitle: "Three ideas to start with",
  ruleBody: "Expression-oriented means a decision such as if produces a value. Statically typed means the compiler checks types before the program runs. Immutable means an ordinary value cannot be changed after creation. The example's function chooses a String based on an Int score; each design-principle page explains a rule with its own example.",
  consequencesTitle: "How this appears in code",
  consequenceOne: "Functions take arguments in sequence. Supplying the first argument makes a function waiting for the next, so you can reuse a transformation with some inputs already supplied.",
  consequenceTwo: "Data types list the different cases a value may have. Maybe distinguishes a present value from an absent one. match handles the cases, and the compiler checks that none is forgotten.",
  consequenceThree: "Effect describes work such as file or console access. Its type states the required services, possible errors, and successful result. Creating this description is separate from executing it.",
  boundaryTitle: "Reference or Tour?",
  boundaryBody: "Use the reference to understand one concept and check its rules. The interactive Tour is the step-by-step learning path. You do not need to read every reference article in order; follow the links from the concept you are investigating."
}
