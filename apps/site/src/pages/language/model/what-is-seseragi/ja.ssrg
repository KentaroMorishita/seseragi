import { ExplanationCopy } from "../../explanation"
import { ConceptCopy } from "../concept"

pub fn copy -> ConceptCopy = ConceptCopy {
  title: "Seseragiとは",
  summary: (explanation ()).summary,
  ruleTitle: "まず押さえる三つの考え方",
  ruleBody: "式指向とは、ifのような分岐も値を返すことです。静的型付きとは、実行前にコンパイラが型を検査することです。不変とは、一度作った通常の値を書き換えられないことです。この例は、整数の点数に応じて文字列を返す関数です。各設計原則のページで、こうした規則の理由と具体例を説明します。",
  consequencesTitle: "普段のコードでは、どう表れるか",
  consequenceOne: "関数には引数を順に渡します。最初の引数だけを渡すと、次の引数を待つ関数ができます。よく使う変換に値をあらかじめ渡して、別の処理でも使えます。",
  consequenceTwo: "データ型では、値が取り得る場合を列挙できます。例えばMaybeは、値がある場合とない場合を区別します。matchでそれぞれの場合を扱い、扱い忘れがないかをコンパイラが検査します。",
  consequenceThree: "コンソールやファイルに働きかける処理はEffectで表します。その型には、必要なサービス、起こり得るエラー、成功時の結果が表れます。処理を表す値を作ることと、その処理を実行することは別です。",
  boundaryTitle: "リファレンスとTourの使い分け",
  boundaryBody: "このリファレンスは、一つの概念を理解し、詳しい規則を調べるためのサイトです。順を追ってコードを動かしながら学ぶ場合は、既存のTourを使います。すべての記事を先頭から読む必要はありません。調べたい概念から関連ページへ進んでください。"
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "他の言語から来たとき、何が違って見えるか",
  summary: "Seseragiは、実行前に型を検査する式指向の言語です。不変の値と関数を組み合わせ、外部処理はEffectとして明示します。",
  reading: "resultは整数の点数を受け取り、ifで選んだStringを返します。if自体が値を返す式なので、関数の本体に直接使えます。mainのprintlnは、その結果を表示する外部処理です。",
  result: "点数85ではpassを出力します。仕様全体を先に読む必要はなく、各記事で必要な用語と規則を説明します。順を追って実践する学習経路は、別に用意されたTourです。"
}
