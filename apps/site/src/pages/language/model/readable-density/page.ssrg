import { localized } from "../../../../model/locale"
import { InternalLink, PageDefinition } from "../../../../model/page"
import { principlePage } from "../principle"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  principlePage "language.model.readable-density" "/docs/language/model/readable-density/" (en.copy ()) (ja.copy ()) "principle-readable-density" "7" [
    [InternalLink (
      localized "Function application" "関数適用",
      "/docs/language/syntax/function-application/"
    )],
    [InternalLink (
      localized "Pipelines and low-precedence application" "パイプラインと低優先順位の適用",
      "/docs/language/syntax/pipelines-and-low-precedence-application/"
    )],
    [InternalLink (
      localized "Ranges and comprehensions" "範囲と内包表記",
      "/docs/language/expressions/ranges-and-comprehensions/"
    )]
  ]
