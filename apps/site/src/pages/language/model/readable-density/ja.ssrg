import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "読みやすい密度",
  summary: (explanation ()).summary,
  meaningTitle: "読む順番で、処理の流れを書く",
  meaningBody: "Seseragiには、関数の引数を一部だけ渡したり、値を次の処理へ渡したりするための簡潔な書き方があります。目的は、補助的な記述を減らして、処理そのものを見やすくすることです。記号が多いか少ないかではなく、何をするコードなのかが伝わるかを重視します。",
  exampleTitle: "値を2倍してから、1を足す",
  reasonTitle: "専用の書き方を使う理由",
  reason: [
    "変換がいくつも続くとき、括弧を深く入れ子にするより、パイプラインの方が順番を追いやすい場合があります。配列やリストのリテラルはデータの形を示し、内包表記はコレクションの作り方を示します。単なる省略記号ではなく、よく使う考え方を直接表す構文です。",
    "短い構文にも、型、評価順序、通常の操作との対応を定めます。値がない可能性、失敗、副作用、変換を隠してよいわけではありません。短く書けても、扱うべき場合がなくなるわけではありません。"
  ],
  boundaryTitle: "行数を増やした方が読みやすいこともある",
  boundary: [
    "判断の理由を示したいときや、値を何度も使うときは、中間の結果に名前を付けます。各段階に説明が必要なら、長いパイプラインを分けます。フォーマッターは配置を整えますが、分かりやすい名前や説明の分量まで決めてはくれません。",
    "最短のコードが最善、という原則ではありません。また、任意の構文を作るマクロを導入するという意味でもありません。専用の構文も、言語の規則から意味を理解できる必要があります。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "短い式でも、処理の流れを読み取れるようにするには",
  summary: "パイプラインを使うと、値をどの順に変換するかを左から読めます。途中の値に説明が必要なら、名前を付けて式を分けてください。短さより、何を計算しているかが伝わることを優先します。",
  reading: "doubleは2倍にし、add 1は次の引数に1を足す関数です。最初の引数だけ渡し、残りを待つ関数を作ることを部分適用と呼びます。3から始め、パイプラインで6、次に7になります。前の結果を次の処理の入力にするので、add 1 (double 3)と同じ計算です。",
  result: "出力は7です。3を2倍して6にし、1を足しています。変換が長くなり、途中の値の役割が分かりにくくなったら、letで結果に名前を付けてください。"
}
