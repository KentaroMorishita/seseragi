import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"
import { PrincipleReaderCopy } from "../reader-principle"

pub fn title -> String = "読みやすい密度"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "読みやすい密度",
  summary: (explanation ()).summary,
  meaningTitle: "読む順番で、処理の流れを書く",
  meaningBody: "このパイプラインは、値を各段階へ順番に渡す書き方です。行を分けても一つの計算で、add 1 (double 3)と同じ結果になります。括弧の入れ子を追う代わりに、3、double、add 1の順に読めます。",
  exampleTitle: "値を2倍してから、1を足す",
  reasonTitle: "専用の書き方を使う理由",
  reason: [
    "変換がいくつも続くとき、括弧を深く入れ子にするより、パイプラインの方が順番を追いやすい場合があります。[1, 2]のように値を直接書く表記をリテラルと呼び、データの形を示します。要素の選択や変換を並べて新しいコレクションを作る内包表記も、作り方を直接示す記法です。単なる省略記号ではなく、よく使う考え方を直接表す構文です。",
    "短い構文にも、型、評価順序、通常の操作との対応を定めます。値がない可能性、失敗、副作用、変換を隠してよいわけではありません。短く書けても、扱うべき場合がなくなるわけではありません。"
  ],
  boundaryTitle: "行数を増やした方が読みやすいこともある",
  boundary: [
    "判断の理由を示したいときや、値を何度も使うときは、中間の結果に名前を付けます。各段階に説明が必要なら、長いパイプラインを分けます。フォーマッターは配置を整えますが、分かりやすい名前や説明の分量まで決めてはくれません。",
    "最短のコードが最善、という原則ではありません。また、任意の構文を作るマクロを導入するという意味でもありません。専用の構文も、言語の規則から意味を理解できる必要があります。"
  ],
}

pub fn reader -> PrincipleReaderCopy = PrincipleReaderCopy {
  question: "何段階かある計算を、上から順に読めるようにするには",
  before: [
    "まず普通の呼び出しなら、double 3は6、add 1 6は7です。引数を空白で区切って渡します。add 1は引数を一つだけ渡した形で、次の整数を待つ関数になります。これを部分適用と呼びます。",
    "|>は左で得た値を右の関数へ渡します。3 |> doubleの結果は6、その6を|> add 1へ渡すとadd 1 6になります。//で始まる行は説明用のコメントです。letは計算結果に再代入できない名前resultを付けます。show resultは結果を表示用の文字列にします。",
    "最後のpub effect fn mainは実行用の入口です。pubは入口を公開し、effect fnは実行する処理を表すEffectを返します。実行機構がその処理を開始し、printlnが値と改行を出力します。"
  ],
  reading: ["最初に3をdoubleへ渡し、その結果6をadd 1へ渡すので出力は7です。TypeScriptならadd(1, double(3))に相当する計算です。ここでの利点は、文字数ではなく変換の順番を行ごとに見られることです。"],
  mistakes: [
    "段階を入れ替えて3 |> add 1 |> doubleと書けば、4を2倍するため8になります。型が合っていても順番の間違いは検出できません。7が必要ならdoubleを先に戻します。",
    "途中の6に意味があるならlet doubled = double 3と名付け、次にlet result = add 1 doubledと書いても同じ7です。長いパイプラインを保つことより、途中の値の役割が分かることを優先してください。"
  ],
  details: [

  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "何段階かある計算を、上から順に読めるようにするには",
  summary: "3を2倍し、1を足す処理を複数行のパイプラインで表します。普通の関数呼び出しと対応を確かめ、途中の値が重要なら名前を付けます。",
  reading: "3を2倍して6にし、その後に1を足して7にします。以下では各段階を別の行に置き、入力から出力へ上から読みます。",
  result: "fnは関数の宣言です。addはleftとrightという二つの整数の引数を取り、足したIntを返します。各名前の: Intは引数の型、最後の-> Intは戻り値の型です。doubleは整数valueを一つ取り、value * 2を返します。=の右がそれぞれの本体です。"
}
