import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"
import { PrincipleReaderCopy } from "../reader-principle"

pub fn title -> String = "Readable density"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "Readable density",
  summary: (explanation ()).summary,
  meaningTitle: "Write the flow in the order you read it",
  meaningBody: "This pipeline passes a value through the stages in order. Across several lines it is still one calculation, equivalent to add 1 (double 3). Instead of following nested parentheses, read 3, double, and add 1 in sequence.",
  exampleTitle: "Double a value, then add one",
  reasonTitle: "Why use a dedicated form?",
  reason: [
    "When several transformations follow one another, a pipeline can show their order more directly than deeply nested parentheses. A literal writes a value directly, as in [1, 2], showing its shape. A comprehension describes selecting or transforming elements to form a new collection. These forms express recognizable ideas, not arbitrary shorthand.",
    "A concise form still has specified types, evaluation order, and meaning in terms of ordinary operations. It must not hide a possible missing result, a failure, an effect, or a conversion. A shorter expression is not an excuse to leave those cases unexplained."
  ],
  boundaryTitle: "Readability sometimes needs more lines",
  boundary: [
    "Name an intermediate value when it helps explain a decision or when the value is used more than once. Split a long pipeline when its individual steps need explanation. The formatter supplies consistent layout, but it cannot choose meaningful names or decide how much a reader needs to know.",
    "This principle is not a promise that the shortest program is the best program, and it does not introduce arbitrary syntax macros. Dedicated syntax must remain understandable from the language's stated rules."
  ],
}

pub fn reader -> PrincipleReaderCopy = PrincipleReaderCopy {
  question: "How can I read a multi-step calculation from top to bottom?",
  before: [
    "Start with ordinary calls: double 3 gives 6, and add 1 6 gives 7. Arguments are separated by spaces. add 1 supplies just one argument, giving a function that waits for the remaining integer. This is called partial application.",
    "|> passes the value on its left to the function on its right. 3 |> double gives 6; passing that 6 to |> add 1 makes the call add 1 6. Lines beginning with // are explanatory comments. let gives the calculation a name, result, which cannot be reassigned. show result converts it to display text.",
    "The final pub effect fn main is the executable entry point. pub exposes that entry; effect fn returns an Effect describing work to run. The runner starts that work, and println writes a value followed by a newline."
  ],
  reading: ["The first stage passes 3 to double; the next passes 6 to add 1, so the output is 7. In TypeScript, add(1, double(3)) expresses the same calculation. The benefit here is seeing transformation order one stage per line, rather than reducing character count."],
  mistakes: [
    "Reversing the stages to 3 |> add 1 |> double doubles 4 and produces 8. Matching types do not detect an incorrect order. Put double first again when the intended result is 7.",
    "If the intermediate 6 has an important role, write let doubled = double 3 and then let result = add 1 doubled instead. The result is still 7. Make the intermediate value’s role clear rather than preserving a long pipeline at all costs."
  ],
  details: [

  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can I read a multi-step calculation from top to bottom?",
  summary: "Use a multiline pipeline to double 3 and then add 1. Relate it to ordinary calls, and name an intermediate value when its role matters.",
  reading: "Double 3 to get 6, then add 1 to get 7. Put each stage on its own line so the example reads from input to output, top to bottom.",
  result: "fn declares a function. add takes two integer parameters, left and right, and returns their sum as Int. Each : Int gives a parameter’s type; the final -> Int is the result type. double takes one integer value and returns value * 2. Each body follows =."
}
