import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "Readable density",
  summary: (explanation ()).summary,
  meaningTitle: "Write the flow in the order you read it",
  meaningBody: "Seseragi offers concise forms for common ideas, such as applying part of a function's arguments and passing a value along a pipeline. Their purpose is to expose the processing steps without surrounding bookkeeping. More symbols are not automatically better or worse; what matters is whether the code communicates the operation.",
  exampleTitle: "Double a value, then add one",
  readingTitle: "How to read the example",
  reading: [
    "Read the last calculation from left to right: start with 3, pass it to double to obtain 6, then pass 6 to add 1 to obtain 7. The output is 7.",
    "add takes its two arguments in sequence. add 1 supplies the first argument and creates a function waiting for the second. This is partial application. The pipeline is equivalent to add 1 (double 3); it does not change the functions' behavior."
  ],
  reasonTitle: "Why use a dedicated form?",
  reason: [
    "When several transformations follow one another, a pipeline can show their order more directly than deeply nested parentheses. Array and list literals similarly show data, while comprehensions show how a collection is formed. These forms express recognizable ideas, not arbitrary shorthand.",
    "A concise form still has specified types, evaluation order, and meaning in terms of ordinary operations. It must not hide a possible missing result, a failure, an effect, or a conversion. A shorter expression is not an excuse to leave those cases unexplained."
  ],
  boundaryTitle: "Readability sometimes needs more lines",
  boundary: [
    "Name an intermediate value when it helps explain a decision or when the value is used more than once. Split a long pipeline when its individual steps need explanation. The formatter supplies consistent layout, but it cannot choose meaningful names or decide how much a reader needs to know.",
    "This principle is not a promise that the shortest program is the best program, and it does not introduce arbitrary syntax macros. Dedicated syntax must remain understandable from the language's stated rules."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "When is a compact expression still easy to follow?",
  summary: "Concise code should make the data flow visible. Prefer a small named function or a clear pipeline over compression that hides inputs and intermediate meaning.",
  reading: "double multiplies by two, and add 1 is the function adding one to its next argument. Starting at 3, the pipeline computes 6 and then 7. Each step's input is the preceding result.",
  result: "The output is 7. Compactness does not change evaluation or type rules. If the chain needs explanation at every symbol, name a meaningful intermediate value or split the expression instead of relying on cleverness."
}
