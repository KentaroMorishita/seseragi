import { localized } from "../../../../model/locale"
import { InternalLink, PageDefinition } from "../../../../model/page"
import { conceptPage } from "../concept"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  conceptPage "language.model.diagnosable-behavior" "/docs/language/model/diagnosable-behavior/" (en.copy ()) (ja.copy ()) [] [
    [InternalLink (
      localized "No hidden danger" "危険を暗黙に隠さない",
      "/docs/language/model/no-hidden-danger/"
    )],
    [InternalLink (
      localized "Backend-independent semantics" "生成先に依存しない意味",
      "/docs/language/model/backend-independent-semantics/"
    )],
    [InternalLink
        (localized "Readable density" "読みやすい密度", "/docs/language/model/readable-density/")]
  ]
