import { explainPage } from "../../explanation"
import { localized } from "../../../../model/locale"
import {
  Block,
  CodeExample,
  InternalLink,
  PageDefinition,
  Terminal,
  Words
} from "../../../../model/page"
import { readerPrinciplePage } from "../reader-principle"
import * as en from "./en"
import * as ja from "./ja"
import * as guide from "./guide"

fn leading -> Array<Block> = [
  CodeExample
    ("model-reader-diagnostics-invalid", localized "Rejected source" "エラーになるコード"),
  Terminal
    (localized "Diagnostic excerpt" "診断の抜粋", "SES-T0101\nexpected: Int\nactual: String")
]

fn rejected -> Array<Block> = []

fn advanced -> Array<Block> = [
  CodeExample (
    "principle-diagnosable-behavior",
    localized "A later case: choosing an empty list’s element type"
      "もう一つの例: 空のリストの要素型を決める"
  ),
  Terminal (localized "Output" "実行結果", "`[]")
]

fn content -> PageDefinition =
  readerPrinciplePage "language.model.diagnosable-behavior" "/docs/language/model/diagnosable-behavior/" (en.copy ()) (ja.copy ()) (en.reader ()) (ja.reader ()) "model-reader-diagnostics" "3" (leading ()) (rejected ()) (advanced ()) [
    [
      InternalLink (
        localized "Generic functions" "ジェネリック関数",
        "/docs/language/types/generic-functions/"
      ),
      Words (
        localized ". How does a function accept different element types?"
          "。関数で要素の型をどう指定するか"
      )
    ],
    [
      InternalLink (
        localized "Annotations and inference" "型注釈と推論",
        "/docs/language/types/annotations-and-inference/"
      ),
      Words (localized ". When should I add a type annotation?" "。いつ型注釈を足すべきか")
    ],
    [
      InternalLink (
        localized "Coherence and ownership" "インスタンスの一意性と所有権",
        "/docs/language/traits/coherence/"
      ),
      Words
          (localized ". How is one implementation chosen for a type?" "。型に対する実装をどう一つに決めるか")
    ]
  ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
