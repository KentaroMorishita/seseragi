import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "説明可能な振る舞い",
  summary: (explanation ()).summary,
  meaningTitle: "型を省略しても、適当に決めるわけではない",
  meaningBody: "型推論は、引数、戻り値、型の注釈から型を決める仕組みです。すべての型を書き直す必要はありませんが、型を一つに決められるだけの情報は必要です。実行してから中身を調べたり、候補の中から適当に選んだりはしません。",
  exampleTitle: "空のリストに、要素の型を指定する",
  reasonTitle: "なぜ既定の型を選ばないのか",
  reason: [
    "空の整数リストと空の文字列リストは、表示すると同じでも、後で使える操作が違います。実行時の見た目で型を決めると、コードを読んだ時点では意味を判断できなくなります。",
    "traitのメソッドも同じ考え方で選びます。traitは型が使える操作を定め、instanceは特定の型に対する実装を定めます。実装の選択は型から行います。どのtraitのメソッドかが決まらない場合はtrait名で修飾し、適用範囲が重なるinstanceは優先順位で選ばずエラーにします。"
  ],
  boundaryTitle: "エラーの説明には、直し方も必要",
  boundary: [
    "上の例なら、List<Int>と注釈するかempty<Int> ()と呼び出します。分岐の結果型が違うなら同じ型に揃え、名前が曖昧なら修飾します。エラーを無視するのではなく、どの意味で書いたのかをコードで明確にします。",
    "型が合っていても、計算式そのものを間違えることはあります。この原則は、コンパイラがアプリケーションの目的を理解するという意味ではありません。言語上の選択が、コードの情報から決まり、その理由を説明できるという意味です。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "型を推論できないとき、何を補えばよいか",
  summary: "コンパイラは、値や型注釈から式の型を決めます。空のコレクションなど、型を決める情報が足りない場合は、型注釈や明示的な型引数で補います。",
  reading: "empty<A>は空のList<A>を作り、中の要素からAを判断できません。valuesのList<Int>という注釈が整数の要素型を伝えます。empty<Int> ()と呼ぶ方法でも指定できます。",
  result: "出力は空のリストを表す`[]です。valuesの注釈によって、要素型はIntに決まります。List<String>を必要とする場所には、このList<Int>をそのまま渡せません。"
}
