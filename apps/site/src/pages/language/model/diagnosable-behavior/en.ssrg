import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "Diagnosable behavior",
  summary: (explanation ()).summary,
  meaningTitle: "Omitting a type does not mean choosing an arbitrary type",
  meaningBody: "Type inference works out types from arguments, results, and annotations. You do not have to repeat every type, but the program still needs enough information for a definite answer. The compiler does not use runtime values or an arbitrary priority to settle an unclear choice.",
  exampleTitle: "Tell the compiler what an empty list contains",
  reasonTitle: "Why stop instead of picking a default?",
  reason: [
    "An empty integer list and an empty string list look identical when printed, but later operations can require different types. Guessing from that runtime shape would move a type decision into execution and make the meaning harder to predict.",
    "The same idea applies to trait methods. A trait describes an operation supported by types; an instance supplies the implementation for a particular type. The compiler selects that implementation from the types. If multiple trait names remain possible, qualify the method with the trait name; overlapping instances are rejected, not ordered by priority."
  ],
  boundaryTitle: "A diagnostic still needs a concrete repair",
  boundary: [
    "For this example, supply List<Int> or call empty<Int> (). For conflicting branch types, change the branches to return the same type. For an unclear name, qualify it. Each repair makes the intended choice part of the program rather than suppressing the error.",
    "Inference is not a proof that the program meets your business requirements. A well-typed formula can still be the wrong formula. This principle concerns whether language choices can be determined and explained, not whether the compiler understands the application's intent."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What should I add when the compiler cannot infer a type?",
  summary: "The compiler determines expression types from values and annotations. When that information is insufficient, as with an empty collection, supply an annotation or explicit type argument.",
  reading: "empty<A> creates an empty List<A> and has no element that could reveal A. List<Int> on values tells the call to choose integer elements. empty<Int> () is another way to supply the same information.",
  result: "The output is `[], an empty List. The annotation on values fixes its element type to Int. This List<Int> cannot be passed directly where List<String> is required."
}
