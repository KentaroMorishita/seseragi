import { localized } from "../../../../model/locale"
import { InternalLink, PageDefinition } from "../../../../model/page"
import { principlePage } from "../principle"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  principlePage "language.model.no-hidden-danger" "/docs/language/model/no-hidden-danger/" (en.copy ()) (ja.copy ()) "principle-no-hidden-danger" "not found" [
    [InternalLink
        (localized "Maybe and absence" "Maybeと値の不在", "/docs/language/effects/maybe/")],
    [InternalLink (
      localized "Either and typed results" "Eitherによる成功と失敗",
      "/docs/language/effects/either/"
    )],
    [InternalLink (
      localized "Effect error channels" "Effectの回復可能な失敗",
      "/docs/language/effects/error-channels/"
    )]
  ]
