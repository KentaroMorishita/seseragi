import { localized } from "../../../../model/locale"
import { InternalLink, PageDefinition } from "../../../../model/page"
import { conceptPage } from "../concept"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  conceptPage "language.model.no-hidden-danger" "/docs/language/model/no-hidden-danger/" (en.copy ()) (ja.copy ()) [] [
    [InternalLink (
      localized "Immutable by default" "デフォルトで不変",
      "/docs/language/model/immutable-by-default/"
    )],
    [InternalLink (
      localized "Diagnosable behavior" "説明可能な振る舞い",
      "/docs/language/model/diagnosable-behavior/"
    )],
    [InternalLink (
      localized "Features the language does not have" "中核に存在しない機能",
      "/docs/language/model/non-features/"
    )]
  ]
