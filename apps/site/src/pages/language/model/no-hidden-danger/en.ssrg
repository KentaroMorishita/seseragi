import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"
import { PrincipleReaderCopy } from "../reader-principle"

pub fn title -> String = "No hidden danger"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "No hidden danger",
  summary: (explanation ()).summary,
  meaningTitle: "A missing result is a case to handle",
  meaningBody: "values has positions 0 and 1. Position 5 returns Nothing, and match selects \"not found\". Ordinary Seseragi values are never null or undefined; Maybe makes the possibility of no result visible in the type.",
  exampleTitle: "Look up an array element that does not exist",
  reasonTitle: "Why not just return null or throw?",
  reason: [
    "A function expecting Int cannot directly receive Maybe<Int>. First extract the integer from Just or choose a default for Nothing. You can instead handle absence by showing an error or choosing another action.",
    "Use Either<E, A> when the result also needs a failure reason: Left contains an E error, and Right contains an A success value. Effect<R, E, A> describes an operation to execute. R specifies required services such as file access, E the failures the caller can handle, and A the successful result type. Constructing an Effect does not start it. Task<A> denotes an Effect with no service requirements or recoverable failures."
  ],
  boundaryTitle: "This does not mean every operation is safe for every input",
  boundary: [
    "Programmer errors can still stop execution. For example, integer division by zero is a runtime defect, not an Either returned by /. When zero is an expected input, use std/int.checkedDivide, which reports the failure as an Either so you can handle it.",
    "Foreign code can still provide null or throw exceptions. Interop adapters must validate or translate those cases before exposing ordinary Seseragi values. Conditions also require Bool, and different numeric types are not silently converted."
  ],
}

pub fn reader -> PrincipleReaderCopy = PrincipleReaderCopy {
  question: "How do I handle a missing array element?",
  before: [
    "The result type Maybe<Int> means an integer may be present or absent. <Int> specifies the contained type. Just value names the contained integer value; Nothing has no contained value. match lists these cases inside braces, with each branch’s result after ->.",
    "\"not found\" is a string. `found: ${value}` is a backtick-delimited string that inserts the found value at ${value}. Just and Nothing are names provided by the type, so this example does not redefine them.",
    "The final pub effect fn main is the executable entry point. pub exposes that entry; effect fn returns an Effect describing work to run. The runner starts that work, and println writes a value followed by a newline."
  ],
  reading: ["Both Just value and Nothing return strings, and message names the selected result. println message prints not found for this lookup."],
  mistakes: [
    "Treating the lookup result directly as an integer produces SES-T0101 at an Int annotation. The result is Maybe<Int>, not Int. Handle both Just and Nothing with match, as in the first example. If an integer is needed, branches such as Just value -> value and Nothing -> 0 can select an integer default.",
    "The fn describe below declares a function taking values: Array<Int>, an array of integers, and returning String after ->. It omits Nothing and is rejected with SES-T0301. Add Nothing -> \"not found\" inside match to repair it; this call then prints not found.",
    "The language requires all cases to be handled. In the checked CLI 0.61.19, however, the same incomplete match in a top-level let passed lint and stopped on the out-of-range lookup at runtime. This is a current checking gap. Write both Just and Nothing regardless of where the match appears."
  ],
  details: [

  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I handle a missing array element?",
  summary: "Separate absence, a failure with a reason, and a programming defect. Start by treating an out-of-range lookup as an expected missing value.",
  reading: "Look for a nonexistent position in an array containing two numbers. Absence is an expected outcome here, so the caller chooses the string to display.",
  result: "import * as arrays from \"std/array\" makes the standard array functions available under arrays. let names a value without allowing reassignment, and [10, 20] creates an array. arrays.get 5 values passes position 5 and the array values as space-separated arguments. Positions start at 0."
}
