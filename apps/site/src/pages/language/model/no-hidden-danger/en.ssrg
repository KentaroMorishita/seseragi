import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "No hidden danger",
  summary: (explanation ()).summary,
  meaningTitle: "A missing result is a case to handle",
  meaningBody: "Ordinary Seseragi values are never null or undefined. An operation that might not find a value returns Maybe<A>: Just contains an A, and Nothing means no value was found. This makes absence visible before the program runs.",
  exampleTitle: "Look up an array element that does not exist",
  reasonTitle: "Why not just return null or throw?",
  reason: [
    "A function expecting Int cannot directly receive Maybe<Int>. First extract the integer from Just or choose a default for Nothing. You can instead handle absence by showing an error or choosing another action.",
    "Use Either<E, A> when the result also needs a failure reason: Left contains an E error, and Right contains an A success value. Effect<R, E, A> describes an operation to execute. R specifies its required services, E its recoverable failures, and A its successful result. Constructing an Effect does not start it. Task<A> denotes an Effect with no service requirements or recoverable failures."
  ],
  boundaryTitle: "This does not mean every operation is safe for every input",
  boundary: [
    "Programmer errors can still stop execution. For example, integer division by zero is a runtime defect, not an Either returned by /. When zero is an expected input, use std/int.checkedDivide, which reports the failure as an Either so you can handle it.",
    "Foreign code can still provide null or throw exceptions. Interop adapters must validate or translate those cases before exposing ordinary Seseragi values. Conditions also require Bool, and different numeric types are not silently converted."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What happens when an array position does not exist?",
  summary: "Maybe represents an operation that may produce no value, such as an out-of-range Array lookup. The caller handles presence and absence separately.",
  reading: "values has only positions 0 and 1. arrays.get 5 values therefore produces Nothing. match handles Just value with a found message and Nothing with \"not found\", so both paths return String.",
  result: "The output is not found. The lookup returns Maybe<Int>, so distinguish Just from Nothing before using an integer. Omitting the Nothing branch produces an error because the match does not handle every case."
}
