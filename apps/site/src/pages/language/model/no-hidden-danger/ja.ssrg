import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "危険を暗黙に隠さない",
  summary: (explanation ()).summary,
  meaningTitle: "「見つからない」を、扱うべき場合として表す",
  meaningBody: "Seseragiの通常の値にはnullやundefinedがありません。値が見つからない可能性のある操作はMaybe<A>を返します。JustはA型の値が見つかった場合、Nothingは見つからなかった場合です。結果がない可能性を、実行前に型から確認できます。",
  exampleTitle: "存在しない配列の要素を取り出そうとする",
  reasonTitle: "なぜnullや例外にしないのか",
  reason: [
    "Intを受け取る関数へ、Maybe<Int>をそのまま渡すことはできません。まずJustから整数を取り出すか、Nothingのときの既定値を選びます。値がなければエラーを表示するなど、別の対応も選べます。",
    "失敗の理由も必要ならEither<E, A>を使います。LeftはE型のエラー、RightはA型の成功結果を持ちます。Effect<R, E, A>は、実行する処理を表します。Rは必要なサービス、Eは回復可能な失敗、Aは成功時の結果です。Effectを作っただけでは処理は始まりません。サービスの要求と回復可能な失敗がない場合はTask<A>と書けます。"
  ],
  boundaryTitle: "どんな入力でも安全、という意味ではない",
  boundary: [
    "プログラムの誤りによって実行が停止することはあります。例えば整数の/で0除算をすると、Eitherが返るのではなく、実行時の異常になります。0が入力される可能性を通常のケースとして扱うなら、std/int.checkedDivideを使います。失敗をEitherで受け取って対応できます。",
    "外部コードからはnullや例外が来ることもあります。外部連携の処理で検査や変換を行い、そのまま通常のSeseragiの値として持ち込まないようにします。また、条件に使えるのはBoolだけで、異なる数値型の暗黙変換もありません。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "配列の指定した位置に値がない場合、どう分かるか",
  summary: "配列の範囲外など、値が得られない場合はMaybeで表します。呼び出した側は、値がある場合とない場合を分けて処理します。",
  reading: "valuesには位置0と1しかないため、arrays.get 5 valuesはNothingです。matchで、Just valueなら見つかった値を表示し、Nothingなら\"not found\"を返します。どちらもStringです。",
  result: "出力はnot foundです。取得結果はMaybe<Int>なので、整数として使う前にJustとNothingを分けます。Nothingの分岐を省くと、matchがすべての場合を扱っていないためエラーになります。"
}
