import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"
import { PrincipleReaderCopy } from "../reader-principle"

pub fn title -> String = "式指向"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "式指向",
  summary: (explanation ()).summary,
  meaningTitle: "分岐も値を作る",
  meaningBody: "式とは、1 + 2のように計算すると値が得られるコードです。ifも式なので、選んだ側の文字列がif全体の値になります。関数は本体の値を返すため、別のreturn文は書きません。",
  exampleTitle: "ifの結果を、そのまま関数の戻り値にする",
  reasonTitle: "なぜこの形にするのか",
  reason: [
    "計算の結果と分岐の結果を、同じように次の処理へ渡せるためです。ifをletの右側に置く、関数の引数に渡す、関数本体にする、といった書き方ができます。",
    "thenとelseは同じ型の値を返す必要があります。上の例で\"retry\"を0に変えると型エラーです。呼ぶ側が、文字列か整数か分からない結果を受け取らないようにします。また、どちらを選んでも結果が決まるようにelseは必須です。"
  ],
  boundaryTitle: "式が値を返すことと、プログラムの起動は別",
  boundary: [
    "意味のある結果がない処理では、Unitという型の値()を使います。宣言だけを含むブロックもUnitを返します。正常に戻らない処理の型Neverは例外です。片方の分岐がNeverなら、ifの型にはもう片方の型を使います。空の{}は空のレコードなので、Unitを返すブロックは{ () }と書きます。",
    "ファイルの一番外側に書けるのは宣言とimportです。アプリケーションの実行は公開されたmain関数から始めます。「式指向」は、importしたファイルの任意の行をそのまま実行するという意味ではありません。"
  ],
}

pub fn reader -> PrincipleReaderCopy = PrincipleReaderCopy {
  question: "点数によって文字列を返す関数を、どう書くか",
  before: [
    "ifの後のscore >= 80は、条件が成り立つかを表すBoolの値です。成り立てばthenの後、そうでなければelseの後を選びます。\"pass\"と\"retry\"は文字列です。result 85は空白の後に引数85を渡す呼び出しで、括弧はprintlnに渡す結果をまとめます。",
    "最後のpub effect fn mainは実行用の入口です。pubは入口を公開し、effect fnは実行する処理を表すEffectを返します。実行機構がその処理を開始し、printlnが値と改行を出力します。"
  ],
  reading: ["85 >= 80はTrueなので、この呼び出しは\"pass\"を返します。60なら条件がFalseとなり\"retry\"を返します。選ばれなかった側は実行しません。どちらもStringなので、宣言した戻り値の型に合います。"],
  mistakes: ["片方の分岐だけ0にすると、StringとIntが一致せずSES-T0101になります。下の例のelse 0をelse \"retry\"へ戻すと、最初の実行例になりpassを出力します。elseは省略できません。条件にも整数ではなくBoolが必要です。"],
  details: [
    "複数行の計算を{ }でまとめたブロックも、最後の式の値を返します。たとえば、let adjusted = score + 5を宣言し、最後の行にadjustedと書けば、そのadjustedがブロック全体の結果です。",
    "matchも、値の形に対応する分岐を選んでその値を返す式です。たとえば値がある場合とない場合の両方を分けます。ここではifだけで条件を表せるため、matchを覚える必要はありません。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "点数によって文字列を返す関数を、どう書くか",
  summary: "ifの選んだ値を、そのまま関数の結果にできます。点数から判定を返す例で、型の一致と分岐の読み方を確認します。",
  reading: "85点なら\"pass\"、80点未満なら\"retry\"という文字列を返します。TypeScriptで条件演算子をreturnする場合と同じく、先に結果用の変数を用意する必要はありません。",
  result: "fnは関数の宣言です。resultが名前、score: Intが整数の引数、-> Stringが文字列の戻り値の型を示します。:は型の指定で、値を変換する記号ではありません。=の右側が関数の本体です。"
}
