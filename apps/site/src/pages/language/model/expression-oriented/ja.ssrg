import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "式指向",
  summary: (explanation ()).summary,
  meaningTitle: "分岐も値を作る",
  meaningBody: "式とは、1 + 2のように、計算すると値が得られるコードのことです。Seseragiではifも式です。「どちらの処理を実行するか」を選ぶだけでなく、選んだ側の値をif全体の結果として返します。",
  exampleTitle: "ifの結果を、そのまま関数の戻り値にする",
  reasonTitle: "なぜこの形にするのか",
  reason: [
    "計算の結果と分岐の結果を、同じように次の処理へ渡せるためです。ifをletの右側に置く、関数の引数に渡す、関数本体にする、といった書き方ができます。",
    "thenとelseは同じ型の値を返す必要があります。上の例で\"retry\"を0に変えると型エラーです。呼ぶ側が、文字列か整数か分からない結果を受け取らないようにします。また、どちらを選んでも結果が決まるようにelseは必須です。"
  ],
  boundaryTitle: "式が値を返すことと、プログラムの起動は別",
  boundary: [
    "意味のある結果がない処理では、Unitという型の値()を使います。宣言だけを含むブロックもUnitを返します。正常に戻らない処理の型Neverは、分岐の型に関する特別な場合として扱います。",
    "ファイルの一番外側に書けるのは宣言とimportです。アプリケーションの実行は公開されたmain関数から始めます。「式指向」は、importしたファイルの任意の行をそのまま実行するという意味ではありません。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "ifだけを関数の本体にできるのはなぜか",
  summary: "ifやmatchは、選んだ分岐の値を返します。ブロックは最後の式の値を返します。その結果を関数の戻り値や別の計算に使う書き方を、式指向と呼びます。",
  reading: "resultのifは80以上なら\"pass\"、それ以外なら\"retry\"を選びます。85なら\"pass\"、60なら\"retry\"です。選ばれなかった側は実行しません。どちらもStringなので、関数の戻り値の型に合います。選んだ値を返すための別のreturn文は不要です。",
  result: "result 85の戻り値は文字列の\"pass\"で、printlnがpassを出力します。thenとelseはどちらもStringを返します。片方をIntの0に変えると、分岐の型が一致せずコンパイルエラーになります。"
}
