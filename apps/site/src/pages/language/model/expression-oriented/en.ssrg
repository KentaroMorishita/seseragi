import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"
import { PrincipleReaderCopy } from "../reader-principle"

pub fn title -> String = "Expression-oriented"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "Expression-oriented",
  summary: (explanation ()).summary,
  meaningTitle: "A branch chooses a value",
  meaningBody: "An expression is code that produces a value, such as 1 + 2. if is also an expression: the selected string becomes the value of the whole if. The function returns its body’s value, without a separate return statement.",
  exampleTitle: "An if provides the function's result",
  reasonTitle: "Why this is useful",
  reason: [
    "A calculation and a decision can be combined without changing how the result is passed along. You can put an if directly on the right of let, use it as an argument, or make it the body of a function.",
    "Both branches must return the same type. Replacing \"retry\" with 0 is a type error: the caller cannot receive a String sometimes and an Int at other times. An else is required, so the result is defined whichever branch is chosen."
  ],
  boundaryTitle: "Producing a value is not the same as executing an application",
  boundary: [
    "Expressions without a meaningful result use Unit, written (). A block containing only declarations also returns Unit. Never describes a branch that cannot return normally. If one branch has type Never, the if takes the other branch’s type. Empty {} is an empty record; write { () } for a block returning Unit.",
    "Source files still have declarations and imports at their top level. An executable application starts from its public main function; arbitrary top-level expressions are not allowed. Expression-oriented does not mean every line is executed when a module is imported."
  ],
}

pub fn reader -> PrincipleReaderCopy = PrincipleReaderCopy {
  question: "How do I return a different string for each score?",
  before: [
    "The score >= 80 after if produces a Bool saying whether the condition holds. Choose the value after then when it does, or after else otherwise. \"pass\" and \"retry\" are strings. result 85 calls the function with the space-separated argument 85; the parentheses group the result passed to println.",
    "The final pub effect fn main is the executable entry point. pub exposes that entry; effect fn returns an Effect describing work to run. The runner starts that work, and println writes a value followed by a newline."
  ],
  reading: ["85 >= 80 is True, so this call returns \"pass\". For 60 the condition is False and the result is \"retry\". The unselected branch does not run. Both results are String, matching the declared result type."],
  mistakes: ["Changing only one branch to 0 makes String disagree with Int and produces SES-T0101. Change else 0 below back to else \"retry\" to recover the first runnable example and its pass output. else cannot be omitted. The condition must also be Bool, rather than an integer."],
  details: [
    "A block groups a calculation in braces and returns its final expression. For example, a block can first declare let adjusted = score + 5 and then put adjusted on its final line. That final adjusted becomes the block’s result.",
    "match is also an expression: it chooses a branch for the shape of a value and returns that branch’s value. For example, separate branches can handle a present value and a missing one. This example only needs if, so match is not a prerequisite."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I return a different string for each score?",
  summary: "Use the value selected by if directly as a function result. A score-to-label example shows how to read the branches and why their types must agree.",
  reading: "Return \"pass\" for 85 points and \"retry\" for a score below 80. As with returning a conditional expression in TypeScript, you do not need a separate variable to hold the eventual result.",
  result: "fn declares a function. result is its name, score: Int is an integer parameter, and -> String gives its string result type. The colon specifies a type; it does not convert a value. The body follows =."
}
