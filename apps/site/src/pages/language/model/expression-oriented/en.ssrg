import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "Expression-oriented",
  summary: (explanation ()).summary,
  meaningTitle: "A branch chooses a value",
  meaningBody: "An expression is a piece of code that produces a value, such as 1 + 2. In Seseragi, choosing between branches is also an expression. An if does not just decide which statements to run: it produces the value of the chosen branch.",
  exampleTitle: "An if provides the function's result",
  reasonTitle: "Why this is useful",
  reason: [
    "A calculation and a decision can be combined without changing how the result is passed along. You can put an if directly on the right of let, use it as an argument, or make it the body of a function.",
    "Both branches must return the same type. Replacing \"retry\" with 0 is a type error: the caller cannot receive a String sometimes and an Int at other times. An else is required, so the result is defined whichever branch is chosen."
  ],
  boundaryTitle: "Producing a value is not the same as executing an application",
  boundary: [
    "Expressions without a meaningful result use Unit, written (). A block containing only declarations also returns Unit. The type Never is a separate special case for a branch that cannot return normally.",
    "Source files still have declarations and imports at their top level. An executable application starts from its public main function; arbitrary top-level expressions are not allowed. Expression-oriented does not mean every line is executed when a module is imported."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Why can if be the entire body of a function?",
  summary: "if and match return the selected branch's value; a block returns its last expression. Expression-oriented code uses those results as function results or inputs to other calculations.",
  reading: "result's if selects \"pass\" for scores at least 80 and \"retry\" otherwise. A score of 85 produces \"pass\"; 60 produces \"retry\". The unselected branch is not executed. Both branches return String, matching the function's result type. No separate return statement is needed.",
  result: "result 85 returns the String \"pass\", and println outputs pass. Both then and else return String. Replacing one branch with the Int value 0 makes their types disagree and causes a compile error."
}
