import { localized } from "../../../../model/locale"
import { InternalLink, PageDefinition } from "../../../../model/page"
import { conceptPage } from "../concept"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  conceptPage "language.model.visible-costs" "/docs/language/model/visible-costs/" (en.copy ()) (ja.copy ()) [] [
    [InternalLink (
      localized "Immutable by default" "default immutable",
      "/docs/language/model/immutable-by-default/"
    )],
    [InternalLink (
      localized "Backend-independent semantics" "backend-independent semantics",
      "/docs/language/model/backend-independent-semantics/"
    )],
    [InternalLink
        (localized "Readable density" "読める密度", "/docs/language/model/readable-density/")]
  ]
