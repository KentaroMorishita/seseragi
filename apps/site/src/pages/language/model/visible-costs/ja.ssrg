import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "コストを見えるようにする",
  summary: "短いコードでも、大量の処理をすることがあります。全要素の走査、新しい結果の作成、継続的な処理の管理など、必要な仕事をAPIの説明から判断できるようにします。",
  meaningTitle: "記述が短くても、必要な仕事はなくならない",
  meaningBody: "ここでいうコストは、操作に必要な処理量やメモリのことです。型の別名やパイプラインの記号は、それ自体で余分な実行時処理を必要としません。一方、配列の全要素を変換するなら、要素を処理する仕事は必要です。書きやすさと処理の少なさは別です。",
  exampleTitle: "一行の変換でも、すべての要素を処理する",
  readingTitle: "このコードで何が起きるか",
  reading: [
    "values |> map doubleは、map double valuesという関数適用と同じです。|>は左側の値を次の関数へ渡す記号で、処理を裏で始めたり、配列の計算を後回しにしたりするものではありません。",
    "mapは1、2、3にそれぞれdoubleを適用し、[2, 4, 6]を返します。このような単純な変換では、要素数がnなら処理量もnに比例します。結果は新しい配列で、元のvaluesは[1, 2, 3]のままです。"
  ],
  reasonTitle: "APIを選ぶとき、何を確認するか",
  reason: [
    "全要素を調べるのか、途中で終了できるのか、結果のコレクションを作るのか、入力データを保持するのか。こうした説明があれば、生成コードを読まなくても大きな入力での負担を考えられます。渡す関数の処理もコストに含まれます。重い変換を行うmapは、整数を2倍するmapより重くなります。",
    "型の別名は型の書き方を変えるだけなので、追加の実行時ラッパーは必要ありません。一方、部分適用した関数を保持すると、渡した引数を保存する場所が必要になることがあります。Effectや変更通知の購読にも、実行待ちの管理や後片付けが必要です。構文が短いから無料、とは考えません。"
  ],
  boundaryTitle: "速度の固定や、最適化の禁止ではない",
  boundary: [
    "コンパイラは、結果や外から見える振る舞いを保ちながら、不要な処理の層を取り除いたり、関数を呼び出し先へ展開したり、条件を満たす走査をまとめたりできます。不変のデータでも、毎回全体をコピーする必要はありません。",
    "ただし、速くするために処理の呼び出しを省略したり、順番に実行する処理を勝手に並行化したり、失敗や後片付けの規則を変えたりはできません。具体的な実行時間は入力や実行環境で変わるため、操作の説明と実測の両方で判断します。"
  ],
}
