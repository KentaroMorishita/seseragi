import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"
import { PrincipleReaderCopy } from "../reader-principle"

pub fn title -> String = "コストを見えるようにする"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "コストを見えるようにする",
  summary: (explanation ()).summary,
  meaningTitle: "記述が短くても、必要な仕事はなくならない",
  meaningBody: "mapは1、2、3のそれぞれにdoubleを適用し、結果を新しい配列として返します。valuesの中身は上書きしません。この説明でいうコストは必要な処理量と保存領域です。式の短さから、その量は判断できません。",
  exampleTitle: "一行の変換でも、すべての要素を処理する",
  reasonTitle: "APIを選ぶとき、何を確認するか",
  reason: [
    "全要素を調べるか、途中で終了するか、結果のコレクションを作るかを確認してください。渡す関数の処理量も必要です。例えばmapで各要素を単に2倍する場合と、各要素について別のコレクションを走査する場合では、必要な処理量が異なります。",
    "型の別名は、型の書き方を変えるだけで、追加の実行時ラッパーを必要としません。引数を一部だけ渡して残りを待つ関数を作ることを部分適用と呼びます。その関数には先に渡した引数を保存する領域が必要な場合があります。Effectは実行する処理を表す値です。Signalは変化を追う値で、購読すると更新を受け取ります。これらには実行の管理や後片付けの処理があります。"
  ],
  boundaryTitle: "速度の固定や、最適化の禁止ではない",
  boundary: [
    "コンパイラは、結果や外から見える振る舞いを保ちながら、不要な処理の層を取り除いたり、関数の本体を呼び出す場所へ展開したり、条件を満たす走査をまとめたりできます。不変のデータでも、毎回全体をコピーする必要はありません。",
    "ただし、速くするために外から見える振る舞いに必要な処理の呼び出しを省略したり、順番が決まった外から見える処理を勝手に並行化したり、失敗、キャンセルによる中断、必要な間リソースを保持してから後片付けする規則を変えたりはできません。具体的な実行時間は入力や実行環境で変わるため、操作の説明と実測の両方で判断します。"
  ],
}

pub fn reader -> PrincipleReaderCopy = PrincipleReaderCopy {
  question: "一行で配列を変換しても、要素ごとの処理は必要か",
  before: [
    "letは値に再代入できない名前を付け、[1, 2, 3]は配列を作ります。mapは各要素へ関数を適用した配列を作る組み込みの操作です。values |> map doubleの|>は左の値を右の処理へ渡す記号で、map double valuesと同じ呼び出しです。show doubledは結果を表示用の文字列にします。",
    "最後のpub effect fn mainは実行用の入口です。pubは入口を公開し、effect fnは実行する処理を表すEffectを返します。実行機構がその処理を開始し、printlnが値と改行を出力します。"
  ],
  reading: ["この例では、doubleへ渡す要素は3個で、結果にも3個の要素があります。|>を使っても計算を後回しにするわけではありません。単純な2倍の計算では、要素数が増えれば行う変換の数も同じ割合で増えます。これは要素数に関する説明であり、実行時間が必ず何倍になるという測定結果ではありません。"],
  mistakes: [
    "mapが元の配列を変えると思うと、後の処理で誤った値を使います。最初の例のmainでprintln (show values)を出力すれば[1, 2, 3]のままです。変換後の値を使うならdoubledを渡します。",
    "呼び出す関数の仕事も数えてください。各要素について別の配列を最初から最後まで調べる関数なら、doubleと同じ処理量ではありません。結果の配列を保存する領域と、内部で何回割り当てるかも別の話です。正確な時間や割り当て量は測定します。"
  ],
  details: [

  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "一行で配列を変換しても、要素ごとの処理は必要か",
  summary: "3個の値を2倍にするmapは、3個すべてを変換します。要素数、結果の保存領域、渡した関数の仕事を分けて考えます。",
  reading: "[1, 2, 3]から[2, 4, 6]を作ります。TypeScriptのvalues.mapで各要素を2倍にする場合と同じく、短いコードでも各要素を処理する仕事が必要です。",
  result: "fnは関数の宣言です。doubleが名前、value: Intが整数の引数、-> Intが整数の戻り値の型を表します。=の後のvalue * 2が、受け取った値を2倍にする本体です。double 3のように空白で引数を渡すと6になります。"
}
