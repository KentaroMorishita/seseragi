import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "コストを見えるようにする",
  summary: (explanation ()).summary,
  meaningTitle: "記述が短くても、必要な仕事はなくならない",
  meaningBody: "ここでいうコストは、操作に必要な処理量やメモリのことです。型の別名やパイプラインの記号は、それ自体で余分な実行時処理を必要としません。一方、配列の全要素を変換するなら、要素を処理する仕事は必要です。書きやすさと処理の少なさは別です。",
  exampleTitle: "一行の変換でも、すべての要素を処理する",
  reasonTitle: "APIを選ぶとき、何を確認するか",
  reason: [
    "全要素を調べるか、途中で終了するか、結果のコレクションを作るかを確認してください。渡す関数の処理量も必要です。例えばmapで各要素を単に2倍する場合と、各要素について別のコレクションを走査する場合では、必要な処理量が異なります。",
    "型の別名は、型の書き方を変えるだけで、追加の実行時ラッパーを必要としません。部分適用した関数には、先に渡した引数を保存する領域が必要な場合があります。Effectの実行やSignalの購読には、実行の管理や後片付けの処理があります。"
  ],
  boundaryTitle: "速度の固定や、最適化の禁止ではない",
  boundary: [
    "コンパイラは、結果や外から見える振る舞いを保ちながら、不要な処理の層を取り除いたり、関数を呼び出し先へ展開したり、条件を満たす走査をまとめたりできます。不変のデータでも、毎回全体をコピーする必要はありません。",
    "ただし、速くするために処理の呼び出しを省略したり、順番に実行する処理を勝手に並行化したり、失敗や後片付けの規則を変えたりはできません。具体的な実行時間は入力や実行環境で変わるため、操作の説明と実測の両方で判断します。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "短く書いた式なら、処理量も小さいのか",
  summary: "コレクションの操作では、処理する要素数と、結果を保存するメモリを確認します。一行のmapでも、各要素について関数を呼び、新しい配列を作ります。",
  reading: "values |> map doubleは、map double valuesと同じ関数適用です。1、2、3にそれぞれdoubleを適用し、valuesを上書きせず変換後のArrayを作ります。|>を使っても、この計算を後回しにするわけではありません。要素数が増えれば、変換関数の呼び出し回数も増えます。",
  result: "出力は[2, 4, 6]です。doubleを3回呼び、結果の配列を作ります。このdoubleのように一回の処理量が一定なら、map全体の処理量は要素数に比例します。変換関数の処理量も含めて判断してください。"
}
