import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "Visible costs",
  summary: (explanation ()).summary,
  meaningTitle: "Short syntax does not make work disappear",
  meaningBody: "Cost means the processing and memory an operation needs. A type name or a pipeline symbol need not introduce extra runtime work, but transforming an array still needs to process its elements. The language distinguishes a convenient spelling from the work that spelling asks for.",
  exampleTitle: "A one-line transformation visits every element",
  reasonTitle: "What to look for when choosing an API",
  reason: [
    "Check whether an operation visits every element, stops early, or creates a result collection. Include the function passed to it. Mapping a simple doubling function costs less than mapping a function that scans another collection for every element.",
    "A type alias changes how a type is written and requires no additional runtime wrapper. A partially applied function may need storage for the supplied arguments. Running an Effect or subscribing to a Signal also involves execution management and cleanup."
  ],
  boundaryTitle: "This is not a fixed-speed or no-optimization promise",
  boundary: [
    "The compiler may remove unnecessary layers, inline a function, or combine compatible traversals when the result and observable behavior stay the same. Immutability does not force a full copy on every operation.",
    "It cannot make sequential visible work concurrent, omit required calls, or change failure and resource cleanup merely to improve a benchmark. Exact running time depends on inputs and the runtime; use measurements as well as the documented operation costs."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Does a short expression mean little work?",
  summary: "For a collection operation, check how many elements it processes and the storage needed for its result. Even a one-line map calls a function for each element and creates a new Array.",
  reading: "values |> map double is the same application as map double values. It applies double separately to 1, 2, and 3 and constructs a new Array without overwriting values. The pipeline does not defer this calculation. With more elements, the transform is called correspondingly more times.",
  result: "The output is [2, 4, 6]. map calls double three times and creates the result Array. When each call takes constant work, as double does here, total work grows in proportion to element count. Include the callback's work when assessing an operation."
}
