import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"
import { PrincipleReaderCopy } from "../reader-principle"

pub fn title -> String = "Visible costs"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "Visible costs",
  summary: (explanation ()).summary,
  meaningTitle: "Short syntax does not make work disappear",
  meaningBody: "map applies double to 1, 2, and 3 and returns the results as a new array. It does not overwrite values. Cost here means the required work and storage; the expression’s length does not tell you either amount.",
  exampleTitle: "A one-line transformation visits every element",
  reasonTitle: "What to look for when choosing an API",
  reason: [
    "Check whether an operation visits every element, stops early, or creates a result collection. Include the function passed to it. Mapping a simple doubling function costs less than mapping a function that scans another collection for every element.",
    "A type alias changes how a type is written and requires no additional runtime wrapper. Supplying some arguments and leaving a function waiting for the rest is partial application. That function may need storage for the supplied arguments. An Effect represents work to run. A Signal represents a value whose updates can be followed by subscribing. Execution management and cleanup also require work."
  ],
  boundaryTitle: "This is not a fixed-speed or no-optimization promise",
  boundary: [
    "The compiler may remove unnecessary layers, inline a function, or combine compatible traversals when the result and observable behavior stay the same. Immutability does not force a full copy on every operation.",
    "It cannot make sequential visible work concurrent, omit required calls, or change failures, cancellation, or how long resources remain available before cleanup merely to improve a benchmark. Exact running time depends on inputs and the runtime; use measurements as well as the documented operation costs."
  ],
}

pub fn reader -> PrincipleReaderCopy = PrincipleReaderCopy {
  question: "Does a one-line array transformation still process every element?",
  before: [
    "let names a value without allowing reassignment; [1, 2, 3] constructs an array. The built-in map operation builds an array by applying a function to each element. In values |> map double, |> passes the left value into the right operation: the call is map double values. show doubled makes display text from the result.",
    "The final pub effect fn main is the executable entry point. pub exposes that entry; effect fn returns an Effect describing work to run. The runner starts that work, and println writes a value followed by a newline."
  ],
  reading: ["This example supplies three elements to double and has three elements in the result. |> does not defer the calculation. For simple doubling, more elements mean proportionally more transformations. That is a claim about element count, not a measurement promising that elapsed time increases by exactly the same factor."],
  mistakes: [
    "Assuming map changes the original array can make later code use the wrong values. Printing println (show values) in the first example’s main still gives [1, 2, 3]. Pass doubled when you need the transformed values.",
    "Count the supplied function’s work too. A function that scans another whole array for each element does more work than double. Storage for the result array and the number of internal allocations are also different questions. Measure exact time and allocation behavior."
  ],
  details: [

  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Does a one-line array transformation still process every element?",
  summary: "A map that doubles three values transforms all three. Consider element count, result storage, and the work inside the supplied function separately.",
  reading: "Build [2, 4, 6] from [1, 2, 3]. As with doubling each element using values.map in TypeScript, concise code still requests work for every element.",
  result: "fn declares a function. double is its name, value: Int is an integer parameter, and -> Int is the integer result type. The body value * 2 after = doubles the input. Passing a space-separated argument as double 3 gives 6."
}
