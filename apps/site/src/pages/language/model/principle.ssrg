import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Article,
  Block,
  BulletList,
  CodeExample,
  Heading,
  Inline,
  PageDefinition,
  Paragraph,
  Terminal,
  Words
} from "../../../model/page"

pub struct OverviewCopy {
  title: String,
  summary: String,
  introduction: String,
  section: String,
  closingTitle: String,
  closing: String,
  descriptions: Array<String>
}

// The reader-facing sequence is shared; each page owns its explanation.
pub struct PrincipleCopy {
  title: String,
  summary: String,
  meaningTitle: String,
  meaningBody: String,
  exampleTitle: String,
  readingTitle: String,
  reading: Array<String>,
  reasonTitle: String,
  reason: Array<String>,
  boundaryTitle: String,
  boundary: Array<String>
}

fn paragraph pair: (String, String) -> Block = match pair {
  (english, japanese) -> Paragraph ([Words (localized english japanese)])
}

fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  map paragraph (arrays.zip japanese english)

pub fn principlePage id: String
  -> path: String
  -> english: PrincipleCopy
  -> japanese: PrincipleCopy
  -> exampleId: String
  -> output: String
  -> related: Array<Array<Inline>>
  -> PageDefinition =
  PageDefinition {
    id,
    path,
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        Heading ("meaning", localized english.meaningTitle japanese.meaningTitle),
        Paragraph ([Words (localized english.meaningBody japanese.meaningBody)]),
        CodeExample (exampleId, localized english.exampleTitle japanese.exampleTitle),
        Paragraph (
          [Words (
            localized
              "main is the executable entry point; println writes one line of text. This example prints:"
              "mainは実行開始の関数で、printlnは一行の文字列を出力します。この例の出力は次のとおりです。"
          )]
        ),
        Terminal (localized "Output" "実行結果", output),
        Heading
              ("reading-the-example", localized english.readingTitle japanese.readingTitle)
      ],
      paragraphs english.reading japanese.reading,
      [Heading ("why", localized english.reasonTitle japanese.reasonTitle)],
      paragraphs english.reason japanese.reason,
      [Heading ("limits", localized english.boundaryTitle japanese.boundaryTitle)],
      paragraphs english.boundary japanese.boundary,
      [
        Heading ("related-rules", localized "Related reference pages" "詳しい規則を調べる"),
        BulletList related
      ]
    ]
  }
