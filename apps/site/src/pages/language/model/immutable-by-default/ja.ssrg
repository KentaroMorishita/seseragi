import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "デフォルトで不変",
  summary: (explanation ()).summary,
  meaningTitle: "更新は、別の値を作ること",
  meaningBody: "letは値に名前を付けます。一度宣言した名前に、別の値を再代入する構文はありません。レコード、構造体、代数的データ型、配列、リストの値も不変です。得点を増やすなどの更新では、元の値を残して新しい値を作ります。",
  exampleTitle: "元の点数を残して、新しい点数を作る",
  reasonTitle: "なぜ元の値を残すのか",
  reason: [
    "関数へ渡した値は、別の関数が使っていても変わりません。関数の入力と結果を確認すれば、データがどう変換されたかを追えます。更新前と更新後の値を比較することもできます。",
    "配列やリストの変換も、新しいコレクションを返します。元のコレクションは変わりません。ただし、実装が毎回全要素をコピーするとは限りません。変更されない部分の保存領域を共有する場合もあります。"
  ],
  boundaryTitle: "変化するアプリケーションは作れる",
  boundary: [
    "カウンターや入力フォームの値を変えるには、状態を扱うAPIを使います。Refでは、専用の操作で保存した値を読み書きします。Signalでは、時間とともに変わる値を扱い、その変更に応じて計算し直せます。",
    "ファイルへの書き込みなど、プログラムの外部に作用する処理はEffectで表します。RefやSignalを使っても、通常のletやレコードのフィールドに代入できるようにはなりません。データの変換には新しい値の構築、状態の変更には対応するAPIを使い分けます。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "不変な値を、どう更新するのか",
  summary: "letで付けた名前や、通常のデータの中身は後から書き換えられません。得点を増やす場合も、元の値を残して新しい値を作ります。",
  reading: "originalのscoreは10です。...originalは、元のフィールドを新しいレコードへ取り込みます。score: original.score + 1で、updatedのscoreを11にします。nameは元と同じです。",
  result: "出力は10 -> 11です。original.scoreは10のままで、updated.scoreは11です。カウンターなどの状態を変えるには、SignalやRefの操作を使います。"
}
