import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "Immutable by default",
  summary: (explanation ()).summary,
  meaningTitle: "An update creates a new value",
  meaningBody: "let names a value. There is no syntax to assign a different value to that name later. Records, structs, algebraic data values, Arrays, and Lists are also immutable. To update a score, construct a new value and keep the original.",
  exampleTitle: "Keep the original score and create the updated score",
  reasonTitle: "Why keep the old value?",
  reason: [
    "A value passed to a function remains unchanged even when another function uses it. Follow a function's inputs and result to see how it transforms data. You can also compare the previous and updated values.",
    "Transforming an Array or List returns a new collection and leaves the original unchanged. This does not require the implementation to copy every element: it may share storage for unchanged parts."
  ],
  boundaryTitle: "Applications can still have changing state",
  boundary: [
    "Use state APIs to change a counter or form value. Ref provides operations to read and write a stored value. Signal represents a value that changes over time and lets dependent calculations update when it changes.",
    "Effect describes operations that affect the outside world, such as writing a file. Using Ref or Signal does not permit assignment to ordinary let bindings or record fields. Construct new values for data transformations; use the appropriate API to change state."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I update data when values are immutable?",
  summary: "A let binding and the contents of ordinary data cannot be reassigned. Updating a score means constructing a new value while keeping the original.",
  reading: "original.score is 10. ...original brings the original fields into a new record. score: original.score + 1 sets updated.score to 11. name remains the same.",
  result: "The output is 10 -> 11: original.score stays 10, and updated.score is 11. Use Signal or Ref operations for changing state such as a counter."
}
