import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Immutable by default",
  summary: (explanation ()).summary,
  purpose: [
    "TypeScript const also prevents reassignment of the name. However, a regular object declared with const can still have its fields changed. In Seseragi, both the name and the contents of ordinary data are immutable.",
    "Passing original to one function does not let another function change original.score. You can compare the two versions or trace which calculation produced updated."
  ],
  exampleTitle: "Keep the original record and create one with a higher score",
  reading: [
    "let computes the right side of = and names its result. You can then use that value by name. To state the type, write let score: Int = 10: the colon and type name follow the name. Int is the integer type.",
    "The final pub effect fn main is the program entry point. pub exposes the entry; effect fn returns an Effect describing work such as output, which the runner executes. println writes text followed by a newline. Within the backticks, ${original.score} and ${updated.score} insert the displayed values."
  ],
  rules: [
    "Records, user-defined data values, structs, Arrays, and Lists are immutable. Transforming an Array or List returns a new collection without changing the original. This does not promise that every element is copied: the implementation may share storage for unchanged parts.",
    "Use dedicated APIs for changing state such as counters and form inputs. Ref provides operations to read and write a stored value. Signal represents a value that changes over time and updates calculations that depend on it.",
    "Effect describes operations that affect the outside world, such as writing files. Ref and Signal do not enable assignment to ordinary let bindings or record fields. Create new values to transform data; use the corresponding operations to change state."
  ],
  mistakes: ["The rejected example tries to assign to a field. This is not Seseragi assignment syntax; the current compiler reports SES-P0001, a syntax error saying it expected an expression. The location can point at the closing brace. Remove original.score = 11 and create let updated = { ...original, score: 11 }, as in the first example. To display the new score, also change the field passed to println to updated.score."],
  related: [
    "Find where to write a value’s type and how to declare a function.",
    "Find how to read, add, and update record fields.",
    "Look up collection transformations and their value behavior.",
    "Find how to represent values that change over time, such as counters."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I name a score and update it without losing the original?",
  summary: "Increase a score from 10 to 11 while keeping the previous score. let names a value; an update creates a separate value.",
  reading: "let original = ... names the value on the right original. The braces hold a record with named fields, name and score. Its shape resembles a TypeScript object; original.score reads the score field, whose value is 10.",
  result: "...original brings the original fields into a new record. The following score: original.score + 1 sets the new score to 11. updated still has the name \"Aki\". original.score remains 10, so the output is 10 -> 11."
}

pub fn title -> String = (copy ()).title
