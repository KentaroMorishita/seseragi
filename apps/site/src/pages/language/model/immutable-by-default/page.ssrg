import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { InternalLink, PageDefinition } from "../../../../model/page"
import { principlePage } from "../principle"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  principlePage "language.model.immutable-by-default" "/docs/language/model/immutable-by-default/" (en.copy ()) (ja.copy ()) "principle-immutable-by-default" "10 -> 11" [
    [InternalLink (localized "Records" "レコード", "/docs/language/data/records/")],
    [InternalLink (
      localized "Tuples, arrays, and lists" "タプル・配列・リスト",
      "/docs/language/data/tuples-arrays-and-lists/"
    )],
    [InternalLink (
      localized "Signals and transactions" "Signalとトランザクション",
      "/docs/language/effects/signals-and-transactions/"
    )]
  ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
