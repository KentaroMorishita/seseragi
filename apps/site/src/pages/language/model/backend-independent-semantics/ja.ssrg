import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "生成先に依存しない意味",
  summary: (explanation ()).summary,
  meaningTitle: "生成されたコードの言語に、規則を任せない",
  meaningBody: "コンパイラのバックエンドは、Seseragiを実行可能なコードへ変換します。現在のバックエンドはTypeScriptを生成します。生成したコードでも、整数の除算や評価順序にはSeseragiの規則を適用します。",
  exampleTitle: "整数の除算と、小数の除算を区別する",
  reasonTitle: "書いたコードから何を判断できるか",
  reason: [
    "整数の計算なら、実行に使う仕組みを調べる前に、整数の規則で結果を判断できます。関数の引数を左から右へ一度ずつ評価することや、レコードが不変であることも同じです。",
    "Effectも、実行されるまで処理を始めません。生成先で実装しやすいからといって、先に実行したり、外から見える処理の順序を変えたり、リソースの後片付けを省略したりはできません。これらは、特定の実行環境でたまたまそうなる挙動ではなく、言語の規則です。"
  ],
  boundaryTitle: "同じ意味でも、速度や使える機能は別",
  boundary: [
    "この原則は、複数の実用バックエンドがすでに存在するという説明ではありません。現在の実装はTypeScriptの実行時ライブラリを使います。また、ブラウザとプロセスでは提供できるサービスが違います。ファイルを使う処理には、そのサービスを提供する実行環境が必要です。",
    "実装がデータの内部表現や最適化方法を変えることはできます。実行速度やメモリ使用量まで同じになるわけではありません。外部コードの値は、Seseragiの型に合わせて明示的に検査・変換する必要があります。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "計算結果を、生成先の言語の規則で判断してよいか",
  summary: "コンパイラがTypeScriptのコードを生成しても、整数の計算や評価順序にはSeseragiの規則が適用されます。生成先の言語の規則だけで、結果を判断しないでください。",
  reading: "integerResultの-7 / 2は整数の除算で、0へ向かって端数を切り捨てます。decimalResultはFloat同士の除算で、小数の商を返します。二つの式は、異なる数値型の計算を明示しています。",
  result: "出力は-3, 3.5です。Int同士の除算は整数を返し、Float同士の除算は小数の商を返します。データの保存形式、実行速度、メモリ使用量は実装や実行環境によって変わります。"
}
