import { ExplanationCopy } from "../../explanation"
import { PrincipleCopy } from "../principle"
import { PrincipleReaderCopy } from "../reader-principle"

pub fn title -> String = "生成先に依存しない意味"

pub fn copy -> PrincipleCopy = PrincipleCopy {
  title: "生成先に依存しない意味",
  summary: (explanation ()).summary,
  meaningTitle: "生成されたコードの言語に、規則を任せない",
  meaningBody: "Intの除算は、商の小数部分を0に近い方向へ切り捨てます。-7 / 2は-3で、-4ではありません。Floatの-7.0 / 2.0は-3.5です。この違いはSeseragiの規則で決まります。",
  exampleTitle: "整数の除算と、小数の除算を区別する",
  reasonTitle: "書いたコードから何を判断できるか",
  reason: [
    "整数の計算なら、実行に使う仕組みを調べる前に、整数の規則で結果を判断できます。関数の引数を左から右へ一度ずつ計算することや、名前付きフィールドを持つレコードの構造や、作った後にフィールドを変更できない性質も同じです。",
    "Effectは実行する処理を値で表す仕組みで、実行されるまで処理を始めません。生成先で実装しやすいからといって、先に実行したり、外から見える処理の順序を変えたり、リソースの後片付けを省略したりはできません。これらは、特定の実行環境でたまたまそうなる挙動ではなく、言語の規則です。"
  ],
  boundaryTitle: "同じ意味でも、速度や使える機能は別",
  boundary: [
    "この原則は、複数の実用バックエンドがすでに存在するという説明ではありません。現在の実装はTypeScriptの実行時ライブラリを使います。また、ブラウザとプロセスでは提供できるサービスが違います。ファイルを使う処理には、そのサービスを提供する実行環境が必要です。",
    "実装がデータの内部表現や最適化方法を変えることはできます。実行速度やメモリ使用量まで同じになるわけではありません。外部コードの値は、Seseragiの型に合わせて明示的に検査・変換する必要があります。"
  ],
}

pub fn reader -> PrincipleReaderCopy = PrincipleReaderCopy {
  question: "同じ負の数を割ると、整数と小数でどう違うか",
  before: [
    "printlnに渡すバッククォートの文字列は、${integerResult}と${decimalResult}の位置に各結果を入れ、間をカンマと空白で区切ります。",
    "最後のpub effect fn mainは実行用の入口です。pubは入口を公開し、effect fnは実行する処理を表すEffectを返します。実行機構がその処理を開始し、printlnが値と改行を出力します。"
  ],
  reading: [
    "integerResultはIntの-3、decimalResultはFloatの-3.5です。TypeScriptのnumberによる-7 / 2なら-3.5ですが、SeseragiのIntの/は同じ結果にはなりません。Floatも任意の小数を正確に表せる型ではなく、この例の-3.5は正確に表せる値です。",
    "コンパイラのバックエンドとは、実行するコードを生成する部分です。現在はTypeScriptを生成しますが、整数除算などの意味は生成先に任せません。"
  ],
  mistakes: ["-7 / 2.0のようにIntとFloatを混ぜても、自動でFloatには変換しません。下の例はSES-T0201となります。診断のDivは/に使う演算の名前で、この型の組み合わせでは使えないという意味です。小数の商が必要なら-7.0 / 2.0にそろえると-3.5、整数の商なら-7 / 2にそろえると-3です。"],
  details: [

  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "同じ負の数を割ると、整数と小数でどう違うか",
  summary: "-7を2で割る例は、Intなら-3、Floatなら-3.5です。生成先のTypeScriptの数値規則だけで、Seseragiの結果を判断しないでください。",
  reading: "-7を2で割った結果を、整数と小数の両方で求めます。入力の符号と大きさをそろえ、数値型の違いだけを比べます。",
  result: "letは値に再代入できない名前を付けます。-7と2は整数型Intの値です。-7.0と2.0は小数点を持つFloatの値で、Floatは小数を含む数を浮動小数点で表します。/は除算です。型注釈がなくても、これらの書き方から型が決まります。"
}
