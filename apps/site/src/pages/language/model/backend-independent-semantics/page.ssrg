import { localized } from "../../../../model/locale"
import { InternalLink, PageDefinition } from "../../../../model/page"
import { principlePage } from "../principle"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  principlePage "language.model.backend-independent-semantics" "/docs/language/model/backend-independent-semantics/" (en.copy ()) (ja.copy ()) "principle-backend-independent-semantics" "-3, 3.5" [
    [InternalLink (localized "Literals" "リテラル", "/docs/language/syntax/literals/")],
    [InternalLink
        (localized "Evaluation order" "評価順序", "/docs/language/expressions/evaluation/")],
    [InternalLink (
      localized "Erasure and runtime representation" "型消去と実行時表現",
      "/docs/language/types/erasure-and-runtime-representation/"
    )]
  ]
