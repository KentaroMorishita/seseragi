import { ExplanationCopy } from "../../explanation"
import { ConceptCopy } from "../concept"

pub fn copy -> ConceptCopy = ConceptCopy {
  title: "Features the language does not have",
  summary: (explanation ()).summary,
  ruleTitle: "Replace operations familiar from another language",
  ruleBody: "Seseragi represents a data update by constructing a new value. A function returns its body expression. This page compares familiar syntax from other languages with the corresponding Seseragi forms.",
  consequencesTitle: "Three distinctions to keep clear",
  consequenceOne: "Maybe represents presence or absence; Either represents a successful or failed result value. Effect describes an operation to execute and the failures it can produce. Choose according to whether you are inspecting a value or executing an operation.",
  consequenceTwo: "An Effect type can list the services its operation requires. This combination rule applies to service requirements, not arbitrary union or intersection types for ordinary data. Seseragi has no perform or handle syntax for algebraic effects.",
  consequenceThree: "deriving generates instances for supported traits. Template strings insert expression values into text. Both have fixed behavior; neither is a macro for introducing arbitrary syntax.",
  boundaryTitle: "An absent construct is not a missing application capability",
  boundaryBody: "Changing application state, recovering from errors, and stopping collection traversal early are still possible. Use explicit state APIs, typed results, and reduceUntil or forEachUntil respectively. Interop adapts foreign constructs without changing ordinary Seseragi rules."
}

pub fn alternatives -> Array<String> = [
  "Reassignment and mutable fields: create a new value, or use an explicit state API when the operation really changes state.",
  "null, undefined, and implicit nullable types: use Maybe; decode potentially null foreign values before using them.",
  "Implicit numeric conversions and truthiness: convert numeric types explicitly; an if condition must be Bool.",
  "Non-exhaustive matches: handle every possible case, or explicitly handle remaining cases with a wildcard.",
  "Exceptions for recoverable failure: use Either for a result, or Effect for executable work with typed failure.",
  "Arbitrary union and intersection types: use a data type listing the cases you need. Combining Effect or Stream services is a separate, limited mechanism.",
  "perform/handle algebraic effects: Seseragi instead composes typed Effect values and the services they require.",
  "General syntax and procedural macros: use ordinary functions. deriving and template strings are defined features, not arbitrary code-rewriting tools.",
  "User-defined prefix or postfix operators: use a named function or a declared infix operator.",
  "return, break, and continue: use a function's result expression; use reduceUntil or forEachUntil to stop a collection traversal early."
]

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What should I use instead of familiar missing keywords?",
  summary: "Where another language uses assignment, null, or return, Seseragi uses new values, Maybe, and a function's body expression. This page compares the forms by the operation you want to perform.",
  reading: "Write { ...old, field: newValue } to construct an updated record. Just contains a present value, and Nothing represents absence. A function returns its body expression; a block returns its last expression.",
  result: "Use Either for a failed result represented as data and Effect for failure of an operation to execute. Use reduceUntil or forEachUntil to stop traversing a collection early."
}
