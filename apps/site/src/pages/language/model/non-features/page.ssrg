import * as arrays from "std/array"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  Inline,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { conceptPage } from "../concept"
import * as en from "./en"
import * as ja from "./ja"

fn alternative pair: (String, String) -> Array<Inline> = match pair {
  (english, japanese) -> [Words (localized english japanese)]
}

pub fn page -> PageDefinition =
  conceptPage "language.model.non-features" "/docs/language/model/non-features/" (en.copy ()) (ja.copy ()) [BulletList
      (map alternative (arrays.zip (ja.alternatives ()) (en.alternatives ())))] [
        [InternalLink (
          localized "No hidden danger" "危険を暗黙に隠さない",
          "/docs/language/model/no-hidden-danger/"
        )],
        [InternalLink (
          localized "Immutable by default" "デフォルトで不変",
          "/docs/language/model/immutable-by-default/"
        )],
        [InternalLink
      (localized "Readable density" "読みやすい密度", "/docs/language/model/readable-density/")]
      ]
