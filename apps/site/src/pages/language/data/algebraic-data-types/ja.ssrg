import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "代数的データ型",
  summary: (explanation ()).summary,
  ruleTitle: "選択肢と、それぞれに必要な値を宣言する",
  ruleBody: "typeでコンストラクターを列挙します。コンストラクターは、その選択肢の値を作る名前です。引数のない選択肢はそのまま値になり、引数のある選択肢には宣言した型の値を渡します。複数の値を持たせたいときは、一つのタプルにまとめます。例えば成功と失敗を別の選択肢にすると、成功した値と失敗理由を取り違えずに扱えます。",
  typingBody: "コンストラクターは、型を定義したモジュールの名前として使えます。<A>のような型パラメーターは、中身として渡した値や期待される結果型から具体的な型を決めます。matchでは、どの選択肢かを調べ、その選択肢が持つ中身を取り出せます。",
  evaluationBody: "コンストラクターへ渡す式は一度だけ計算します。matchは値を作ったコンストラクターを調べて分岐します。例えばLoadedで作った値なら、Loadedの分岐で中身を取り出します。",
  invalidTitle: "宣言した後に選択肢を追加することはできない",
  invalidBody: "選択肢はtypeの宣言で確定します。別のモジュールから追加することはできません。また、別々に宣言した型は、選択肢の名前が同じでも別の型です。違う用途の値を変換する場合は、matchで取り出して変換先のコンストラクターで作り直します。",
  diagnosticsBody: "コンストラクターの名前、渡す値の型と個数、公開範囲を確認してください。matchで必要な選択肢を扱っていない場合も、実行する前にエラーになります。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "値が取り得る場合を、型として列挙するには",
  summary: "代数的データ型は、値が取り得る選択肢を列挙する型です。選択肢ごとに、必要な中身を持たせられます。",
  reading: "LoadState<A>には、値を持たないIdleと、A型の値を持つLoadedがあります。Loaded \"ready\"ではAにStringが当てはまります。describeはIdleなら\"idle\"を返し、Loadedなら中の文字列を返します。",
  result: "messageは\"ready\"です。LoadStateの選択肢はIdleとLoadedに決まっているため、matchでLoadedなどを扱い忘れるとコンパイル時にエラーになります。"
}
