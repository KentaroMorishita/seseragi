import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "代数的データ型",
  summary: (explanation ()).summary,
  ruleTitle: "選択肢と、それぞれに必要な値を宣言する",
  ruleBody: "typeでコンストラクターを列挙します。コンストラクターは、その選択肢の値を作る名前です。引数のない選択肢はそのまま値になり、引数のある選択肢には宣言した型の値を渡します。複数の値を持たせたいときは、一つのタプルにまとめます。例えば成功と失敗を別の選択肢にすると、成功した値と失敗理由を取り違えずに扱えます。",
  typingBody: "コンストラクターは、型を定義したモジュールの名前として使えます。<A>のような型パラメーターは、中身として渡した値や期待される結果型から具体的な型を決めます。matchでは、どの選択肢かを調べ、その選択肢が持つ中身を取り出せます。",
  evaluationBody: "コンストラクターへ渡す式は一度だけ計算します。matchは値を作ったコンストラクターを調べて分岐します。例えばLoadedで作った値なら、Loadedの分岐で中身を取り出します。",
  invalidTitle: "宣言した後に選択肢を追加することはできない",
  invalidBody: "選択肢はtypeの宣言で確定します。別のモジュールから追加することはできません。また、別々に宣言した型は、選択肢の名前が同じでも別の型です。違う用途の値を変換する場合は、matchで取り出して変換先のコンストラクターで作り直します。",
  diagnosticsBody: "コンストラクターの名前、渡す値の型と個数、公開範囲を確認してください。matchで必要な選択肢を扱っていない場合も、実行する前にエラーになります。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "未発送と発送済みで、必要なデータを分けるには",
  summary: "発送状態をPendingかShippedのどちらかで表します。追跡番号が必要なのはShippedだけです。値の選択肢と、その選択肢に必要な中身を一緒に宣言できます。",
  reading: "type Deliveryの下の|は選択肢の区切りです。Pendingは中身のない値、Shipped Stringは文字列を一つ持つ選択肢です。Shipped \"JP42\"で発送済みの値を作ります。この値を作る名前をコンストラクターと呼びます。",
  result: "出力はnot shippedとtracking: JP42です。label内のmatchは、Pendingなら未発送の文、Shippedなら中の追跡番号を使った文を返します。成功・失敗の話を先に学ばなくても、選択肢の使い分けを確認できます。",
}

pub fn readerCaption -> String = "未発送と発送済みの値を作る"

pub fn readerBridgeOne -> String =
  "TypeScriptでも、kindという普通のフィールドでオブジェクトの形を区別できます。このTypeScript例の|は、二つの形のどちらかを許す指定です。kindが\"shipped\"の場合だけtrackingがあります。switchでkindを調べると、使えるフィールドが分かります。"

pub fn readerBridgeTwo -> String =
  "Seseragiでは、PendingとShippedという名前で選択肢を区別します。matchのShipped trackingは、その選択肢の中身にtrackingという名前を付けます。printlnが二つの結果を表示し、文字列内の\\nで改行します。こうした選択肢を持つ型を代数的データ型、略してADTと呼びます。"

pub fn readerInvalidCaption -> String = "追跡番号に整数を渡す"

pub fn readerMistake -> String =
  "Shipped 42は、Stringの追跡番号が必要なのにIntを渡しているためSES-T0101です。例ではShipped \"JP42\"のように文字列を渡してください。"

pub fn readerExecution -> String =
  "pub effect fn mainは、外部へ出力する公開された実行入口です。実行するとmainが開始され、printlnが文字列と改行を出力します。計算やデータの組み立ては、その前の通常の関数やletで行っています。"

pub fn readerDetailNote -> String =
  "ここからの宣言例は、詳しい規則を調べるための断片です。単独では実行入口を持ちません。動かす場合は、上に載せたmain付きの完全な例を使ってください。"

pub fn readerComparisonScope -> String =
  "TS例でもstrictな型検査と明示した戻り値の型により、未発送の分岐を消すとエラーになります。二つの言語で同じ状態と結果を表し、その書き方を比べています。"
