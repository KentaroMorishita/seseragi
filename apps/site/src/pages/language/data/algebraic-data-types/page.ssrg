import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.data.algebraic-data-types" "/docs/language/data/algebraic-data-types/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "data-algebraic-data-types",
        localized "A closed generic state" "選択肢を列挙した、型パラメーターを持つデータ"
      )] [] [
        [InternalLink
      (localized "Type constructors" "型構築子", "/docs/language/types/type-constructors/")],
        [InternalLink
      (localized "Match expressions" "パターン照合", "/docs/language/patterns/match/")],
        [InternalLink (
          localized "Nominal and structural types" "名前付き型と構造的な型",
          "/docs/language/types/nominal-and-structural-types/"
        )]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample (
          "data-reader-alternatives",
          localized (en.readerCaption ()) (ja.readerCaption ())
        ),
        CodeExample (
          "data-reader-delivery-typescript",
          localized "TypeScript: distinguish shapes with kind"
            "TypeScript：kindで二つの形を区別する"
        ),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Paragraph (
          [Words (localized (en.readerComparisonScope ()) (ja.readerComparisonScope ()))]
        ),
        Paragraph ([Words (localized (en.readerExecution ()) (ja.readerExecution ()))]),
        Terminal (localized "Output" "実行結果", "not shipped\ntracking: JP42"),
        CodeExample (
          "data-reader-alternatives-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))])
      ],
      [Paragraph ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))])],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
