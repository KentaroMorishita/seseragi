import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Inherent impls and methods",
  summary: (explanation ()).summary,
  ruleTitle: "The nominal type owns its methods",
  ruleBody: "impl T may appear only in the module that defines T. A method's first parameter is named self and has the impl target type; later parameters remain curried ordinary parameters.",
  typingBody: "Receiver type selects the impl and substitutes generic type arguments before ordinary method inference continues. Multiple impl blocks are allowed, but method names for one target must be unique.",
  evaluationBody: "Method syntax resolves statically and then applies an ordinary function to the receiver. It does not perform runtime class dispatch or mutate the receiver.",
  invalidTitle: "impl is not a trait instance",
  invalidBody: "Use instance Trait<T> for typeclass evidence. impl Trait<T>, impl of a foreign nominal type, a missing self name, and a mismatched self type are rejected.",
  diagnosticsBody: "Errors identify the non-local target, invalid self parameter, duplicate method, visibility violation, or receiver type that has no matching method.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Where do I put operations belonging to my type?",
  summary: "An impl groups methods for a named type. Define it in the module that owns the type and give each method its receiver as the first self parameter.",
  reading: "Box<A> has a value field. impl<A> Box<A> defines get, whose self: Box<A> receives the Box before the dot. It returns self.value with the same element type A.",
  result: "Box<Int> { value: 42 }.get returns 42. get reads an existing value; it neither mutates it nor creates a trait implementation. A trait promise must be fulfilled with instance separately."
}
