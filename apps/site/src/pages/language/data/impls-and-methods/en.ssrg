import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Inherent impls and methods",
  summary: (explanation ()).summary,
  ruleTitle: "Define methods in the module defining their type",
  ruleBody: "Write a type's methods inside impl T. The first parameter is named self and has type T. Calling value.method passes value to self. Supply later arguments in order, separated by spaces as for ordinary functions.",
  typingBody: "The type of the value passed to self determines which method is called. Generic parameters are replaced with concrete types before checking. Several impl blocks can target one type, but the same method name cannot be defined twice.",
  evaluationBody: "A method call passes the value before the dot as self to the function selected by its type. You cannot assign to self's fields. A method that changes a value returns a new value. With no parameters other than self, write value.get; do not pass () unless get requires a Unit argument.",
  invalidTitle: "Adding a method and implementing a trait use different declarations",
  invalidBody: "impl T belongs only in the module defining T. Use instance Trait<T> to implement a trait's operations. impl Trait<T> does not implement that trait.",
  diagnosticsBody: "Check the defining module of the type, the name and type of self, and duplicate method names. A method called from another module needs pub.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Where do I put operations belonging to my type?",
  summary: "An impl groups methods for a named type. Define it in the module that owns the type and give each method its receiver as the first self parameter.",
  reading: "Box<A> contains a field value of type A. get, defined in impl<A> Box<A>, receives the Box before the dot through self: Box<A>. It returns self.value, so its result type is also A.",
  result: "Box<Int> { value: 42 }.get returns the Int 42. get reads the contained value without changing the Box. An impl method and an instance trait implementation are separate declarations."
}
