import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  referencePage "language.data.impls-and-methods" "/docs/language/data/impls-and-methods/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "data-impls-and-methods",
        localized "A generic inherent method" "generic inherent method"
      )] [CodeExample (
        "data-invalid-impl-owner",
        localized "Rejected foreign impl target" "外部impl targetを拒否"
      )] [
        [InternalLink
      (localized "Method calls" "メソッド呼び出し", "/docs/language/syntax/method-calls/")],
        [InternalLink
      (localized "Polymorphism" "多相性", "/docs/language/types/polymorphism/")],
        [InternalLink (
          localized "Nominal and structural types" "名前付き型と構造的な型",
          "/docs/language/types/nominal-and-structural-types/"
        )]
      ]
