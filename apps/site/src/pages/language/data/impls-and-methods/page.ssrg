import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, PageDefinition } from "../../../../model/page"
import { readerPage } from "../../reader-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  readerPage "language.data.impls-and-methods" "/docs/language/data/impls-and-methods/" (en.copy ()) (ja.copy ()) "data-operations-methods" "2\n3" [CodeExample
      (
        "data-operations-methods-invalid",
        localized "A rejected example and its correction" "エラーになる例と直し方"
      )] [
        (localized "Method calls" "メソッド呼び出し", "/docs/language/syntax/method-calls/"),
        (
          localized "Generic impls and methods" "ジェネリックimplとメソッド",
          "/docs/language/types/generic-impls-and-methods/"
        ),
        (localized "Structs" "構造体", "/docs/language/data/structs/")
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
