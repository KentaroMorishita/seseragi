import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Operator overloads",
  summary: (explanation ()).summary,
  ruleTitle: "Define a standard operator for your own type",
  ruleBody: "An operator declaration inside impl defines an operation such as + for your type. The first parameter self has the impl's type. Declare later parameters and the result type as well. The compiler treats this declaration as an implementation of the corresponding standard trait.",
  typingBody: "Operand types determine which implementation is called. Generic operations may require trait constraints. A newtype does not inherit its contained type's operations, so addition of Scores needs an implementation for Score.",
  evaluationBody: "The operands are computed once each, left to right, before calling the implementation. The call target is determined during type checking, not selected during execution.",
  invalidTitle: "Defining an operation does not change its precedence",
  invalidBody: "This form supports only the corresponding standard operators. Their precedence and grouping stay unchanged. Declare a custom operator directly in a module for a new symbol. An operator declaration and an instance declaration cannot both implement the same operation.",
  diagnosticsBody: "Check that the operator is supported and that its parameters and result satisfy the corresponding trait. A comparison such as == must return the required result type. Duplicate implementations and a missing implementation both cause errors.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can + add values of my own type?",
  summary: "An operator overload gives a supported standard operator a meaning for your named type. It keeps that operator's existing precedence and grouping rules.",
  reading: "Score wraps Int. The + implementation unpacks both Scores, adds the integers, and wraps the sum back in Score. The first operand is received as self and the second as other.",
  result: "total is Score 42. Wrapping the result in Score keeps its type distinct from Int. This declaration defines + for Score. For a new symbol, declare a custom operator directly in the module."
}
