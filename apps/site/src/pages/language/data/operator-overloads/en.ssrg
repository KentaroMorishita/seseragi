import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Operator overloads",
  summary: (explanation ()).summary,
  exampleTitle: "Add the integers inside two Scores and return a Score",
  purpose: [
    "Keep scores distinct from ordinary Int values while allowing two Scores to be added with +. First define Score as a type containing one integer and a function that extracts it.",
    "Operator overloading supplies type-specific operations for the same symbol. Adding two Scores preserves the original values and returns a new Score.",
  ],
  reading: [
    "newtype Score = Int defines a Score containing one integer. Score 20 constructs one. The Score value pattern in points names the contained integer value and returns it.",
    "operator + inside impl Score declares Score addition. self receives the left value; other receives the right Score. The enclosing Score supplies the type of self. The final -> Score says that the addition result is also a Score.",
    "The body extracts the two integers with points self and points other. The + here adds Int values. Score (...) wraps that integer result to satisfy the declared return type.",
    "Score 20 + Score 22 in total selects this Score operation and produces Score 42. main extracts the integer with points total, so the printed result is 42.",
  ],
  rules: [
    "A trait specifies an operation required for a combination of types. This + corresponds to the standard Add<Score, Score, Score> contract: left type, right type, then result type. The operator declaration supplies that implementation, so this example needs no separate instance declaration.",
    "An operator declaration inside impl defines an operation such as + for your type. The first parameter self has the impl's type. Declare later parameters and the result type as well. The compiler treats this declaration as an implementation of the corresponding standard trait.",
    "Operand types determine which implementation is called. Generic operations may require trait constraints. A newtype does not inherit its contained type's operations, so addition of Scores needs an implementation for Score.",
    "The operands are computed once each, left to right, before calling the implementation. The call target is determined during type checking, not selected during execution.",
    "This form supports only the corresponding standard operators. Their precedence and grouping stay unchanged. Declare a custom operator directly in a module for a new symbol. An operator declaration and an instance declaration cannot both implement the same operation.",
    "Check that the operator is supported and that its parameters and result satisfy the corresponding trait. A comparison such as == must return the required result type. Duplicate implementations and a missing implementation both cause errors.",
    "Supported binary operators in this form are +, -, *, /, %, **, and ==. != is obtained by negating ==. Ordering comparisons such as < use an Ord instance defining a consistent order, rather than separate operator declarations.",
  ],
  mistakes: [
    "The declaration below promises Score but returns the integer sum directly, producing SES-T0101. Replace its body with Score (points self + points other) to wrap the result and print 42.",
    "A newtype does not automatically inherit operations from its contained type. Defining a separate instance for the same operation as this operator declaration also creates a duplicate implementation. Supply one definition for that combination.",
  ],
  related: [
    "Review constructors that wrap values and patterns that extract them.",
    "Check the rules for defining a new symbol instead of supplying a meaning for +.",
    "Check where ordinary methods and operators belonging to a type are defined.",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I add two values of my own type with +?",
  summary: "An operator declaration inside impl defines a standard operation such as + for your type. Choosing its input and output types does not change its precedence.",
  reading: "points extracts the integers from the Scores; the body adds them and wraps the result in Score. Operand types determine the operation selected.",
  result: "Score 20 + Score 22 produces Score 42. Extracting it with points for display prints the integer 42.",
}
