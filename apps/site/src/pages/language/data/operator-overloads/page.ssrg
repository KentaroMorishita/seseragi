import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, PageDefinition } from "../../../../model/page"
import { readerPage } from "../../reader-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  readerPage "language.data.operator-overloads" "/docs/language/data/operator-overloads/" (en.copy ()) (ja.copy ()) "data-operations-operators" "42" [CodeExample
      (
        "data-operations-operators-invalid",
        localized "A rejected example and its correction" "エラーになる例と直し方"
      )] [
        (localized "Newtype values" "newtypeの値", "/docs/language/data/newtypes/"),
        (
          localized "Custom operators and fixity" "カスタム演算子と結合規則",
          "/docs/language/syntax/custom-operators/"
        ),
        (
          localized "Inherent impls and methods" "固有implとメソッド",
          "/docs/language/data/impls-and-methods/"
        )
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
