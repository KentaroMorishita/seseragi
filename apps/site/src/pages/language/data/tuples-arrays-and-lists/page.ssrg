import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, PageDefinition } from "../../../../model/page"
import { readerPage } from "../../reader-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  readerPage "language.data.tuples-arrays-and-lists" "/docs/language/data/tuples-arrays-and-lists/" (en.copy ()) (ja.copy ()) "data-operations-collections" "answer\n42\nJust 20\nNothing\n20\n`[Ren, Aki, Mio]" [CodeExample
      (
        "data-operations-collections-invalid",
        localized "A rejected example and its correction" "エラーになる例と直し方"
      )] [
        (
          localized "Ranges and comprehensions" "範囲と内包表記",
          "/docs/language/expressions/ranges-and-comprehensions/"
        ),
        (
          localized "Irrefutable patterns" "反駁不能パターン",
          "/docs/language/patterns/irrefutable-patterns/"
        ),
        (localized "Built-in types" "組み込み型", "/docs/language/types/built-in-types/")
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
