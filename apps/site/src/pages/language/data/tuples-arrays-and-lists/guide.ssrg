import { localized } from "../../../../model/locale"
import { Explanation } from "../../explanation"

pub fn explanation -> Explanation = Explanation {
  question: localized "Which collection should I use, and how do I read an element?"
    "タプル・配列・リストを、どう使い分けるか",
  summary: localized
    "A tuple has fixed positions, possibly of different types. An Array or List has any number of elements of one type, with different access and construction operations."
    "タプルは固定した位置に、異なる型の値もまとめられます。ArrayとListは、同じ型の要素を任意の個数持ち、読み方や作り方が異なります。",
  exampleId: "reader-collections",
  reading: localized
    "(label, number) unpacks the tuple. Array indexes start at zero, so numbers[1] is Just 20 and numbers[9] is Nothing. The match for selected extracts value from Just, or chooses 0 for Nothing. selected is therefore an Int with value 20, ready for arithmetic."
    "(label, number)でタプルを分解します。配列の位置は0から数えるため、numbers[1]はJust 20、numbers[9]はNothingです。selectedのmatchはJustからvalueを取り出し、Nothingなら0を選びます。selectedはInt型の20となり、整数として計算に使えます。",
  result: localized
    "The list literal has a leading backtick, and \"Ren\" : names adds a new head without changing names. Array and List do not convert automatically. The printed Maybe values demonstrate safe lookup, not integers already usable in arithmetic."
    "リストの表記には先頭のバッククォートがあり、\"Ren\" : namesは元を変えずに先頭を追加します。ArrayとListは自動では変換されません。表示されたMaybeは検索結果であり、そのまま整数の計算には使えません。"
}
