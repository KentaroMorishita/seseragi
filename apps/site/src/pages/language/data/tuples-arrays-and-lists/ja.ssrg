import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "タプル・配列・リスト",
  summary: (explanation ()).summary,
  exampleTitle: "組の中身を読み、配列の不在を扱い、リストへ追加する",
  purpose: [
    "名前と数値を一組として返すならタプル、同じ型の値を何個も並べるならArrayやListを使います。TypeScriptでも配列やタプルを使えますが、SeseragiのArrayとListは別の不変な型です。",
    "この例では、ラベルと数値をタプルから取り出し、配列の指定位置を読み、名前のリストへ一人を追加します。配列に要素がない場合も、取得結果の値として確認できます。",
  ],
  reading: [
    "pairの(\"answer\", 42)は、StringとIntをこの順に持つタプルです。let (label, number) = pairで各位置の値に名前を付けるため、最初の二行はanswerと42になります。",
    "numbersの[10, 20, 30]はArray<Int>です。位置は0から数えるのでnumbers[1]は二番目の20を指します。取得結果のMaybe<Int>は、要素があればJust 20、なければNothingです。三行目と四行目がその二つの場合を表示します。",
    "selectedのmatchは取得結果を調べます。Just valueの分岐では中の整数をvalueとして返し、Nothingなら0を返します。selectedはIntの20になり、五行目へ出力されます。取得結果をそのまま整数とみなすのではなく、不在の場合もここで扱っています。",
    "namesの角括弧の前にあるバッククォートはListの記号です。\"Ren\" : namesは先頭にRenを足した新しいListを作り、namesを変更しません。showは値を表示用の文字列にします。mainのテンプレートの${...}が各値を埋め込み、\\nが出力の行を分けます。",
  ],
  rules: [
    "タプルは長さと各位置の型が決まっています。一要素のタプルはありません。ArrayとListでは、すべての要素が同じ型である必要があります。Array<Int>に文字列は入れられません。",
    "空のコレクションには、要素型を判断する材料がありません。let empty: Array<Int> = []や、let empty: List<String> = `[ ]のように型を指定します。括弧内に空白を置いても、リストの書き方は変わりません。",
    "配列の添字はIntです。負の添字や範囲外の添字はNothingになります。numbers[1]のように値の直後に括弧を置いてください。f [1]は、配列をfへ渡す関数呼び出しです。Listには添字で読む構文はありません。",
    "ArrayとListの変換には、std/arrayのtoList、std/listのtoArrayを明示的に使います。[head, ...tail]ではheadが先頭、tailが残りの配列です。この分解で毎回残りを作りながら最後まで再帰すると、処理量は要素数の二乗に比例します。Listは先頭追加や残りの取得で元の部分を共有でき、同じ走査の処理量は要素数に比例します。大量のArrayを走査するにはreduceなどを使えます。",
  ],
  mistakes: [
    "下の配列はArray<Int>と宣言したのに、二番目の\"20\"がStringなのでSES-T0101になります。引用符を外して20に直すと、[10, 20, 30]を出力できます。",
    "バッククォートのない[\"Aki\", \"Mio\"]はArrayで、Listへ暗黙に変換されません。また、固定個数へ分解するArrayやListのパターンには長さが合わない場合があります。位置数が型で決まるタプルの分解とは区別してください。",
  ],
  related: [
    "範囲やコレクションを走査し、新しいArrayやListを作る方法を確認できます。",
    "必ず成功する分解と、matchで不一致も扱う分解を区別します。",
    "要素の型と、取得結果に使うMaybeの基本を確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "役割の違う値と、同じ型の要素をどうまとめるか",
  summary: "タプルは位置ごとに役割と型が決まる組です。Arrayは位置で読み、Listは先頭への追加に向く列です。どれも元の値を変えずに扱います。",
  reading: "タプルの二つの位置、Arrayの0から始まる位置、Listの先頭追加をそれぞれ読みます。取得結果のJustとNothingは、要素がある場合とない場合です。",
  result: "出力にはタプルの二つの値、Just 20、Nothing、取り出した20、Renを加えたリストが並びます。元のnumbersとnamesは変わりません。",
}
