import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "タプル・配列・リスト",
  summary: (explanation ()).summary,
  purpose: [
    "タプルは、ラベルと数値のように役割の違う値をまとめるのに使います。(\"answer\", 42)は二つの位置を持ち、それぞれの型は違っていても構いません。",
    "整数の位置を指定して要素を読むならArray（配列）、先頭に要素を足したり先頭から順に取り出したりするならList（リスト）が使えます。どちらも不変ですが、同じコレクションの別名ではなく、別々の型です。"
  ],
  exampleTitle: "三つの形で値をまとめて読む",
  reading: [
    "pairの最初の位置にはString、次の位置にはIntが入っています。let (label, number) = pairで中身を取り出し、名前を付けます。そのため、最初の出力はanswer、次は42です。",
    "[10, 20, 30]はArray<Int>を作ります。位置は0から数えるので、numbers[1]が指すのは20です。ただし、添字で読んだ結果は整数そのものではなく、Maybe<Int>です。",
    "Just 20は「要素があり、その値は20」、Nothingは「その位置に要素がない」という結果です。numbers[9]は範囲外なのでNothingになります。範囲外のデータを読んだり、境界違反の例外を投げたりはしません。showでこれらの結果を文字列にしてから、printlnで出力しています。",
    "括弧の前にバッククォートを置いた`[\"Aki\", \"Mio\"]はListです。\"Ren\" : namesのコロンは、先頭にRenを追加した新しいリストを作ります。namesは変わりません。最後の出力にも、リストを表すバッククォートが付きます。"
  ],
  rules: [
    "タプルは長さと各位置の型が決まっています。一要素のタプルはありません。ArrayとListでは、すべての要素が同じ型である必要があります。Array<Int>に文字列は入れられません。",
    "空のコレクションには、要素型を判断する材料がありません。let empty: Array<Int> = []や、let empty: List<String> = `[ ]のように型を指定します。括弧内に空白を置いても、リストの書き方は変わりません。",
    "配列の添字はIntです。負の添字や範囲外の添字はNothingになります。numbers[1]のように値の直後に括弧を置いてください。f [1]は、配列をfへ渡す関数呼び出しです。Listには添字で読む構文はありません。",
    "ArrayとListの変換には、std/arrayのtoList、std/listのtoArrayを明示的に使います。リストの先頭に要素を追加すると、元の残りの部分を共有できます。一方、配列の残りを毎回コピーして再帰すると、要素数が多い場合に処理量が大きくなります。"
  ],
  mistakes: [
    "バッククォートのない[\"Aki\", \"Mio\"]はArrayです。渡す先がListを要求していても、自動で変換されることはありません。",
    "numbers[1]はMaybe<Int>なので、JustとNothingを扱ってから整数として使います。また、配列やリストを決まった個数に分解するパターンは、長さが合わない場合があります。型で長さが決まるタプルの分解とは異なります。"
  ],
  related: [
    "範囲やほかのコレクションから、新しい配列やリストを作る方法を確認できます。",
    "必ず成功する分解と、matchで失敗も扱う必要のある分解を確認できます。",
    "要素の基本型や、結果に使うMaybeの値を確認できます。"
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "タプル・配列・リストを、どう使い分けるか",
  summary: "タプルは固定した位置に、異なる型の値もまとめられます。ArrayとListは、同じ型の要素を任意の個数持ち、読み方や作り方が異なります。",
  reading: "(label, number)でタプルを分解します。配列の位置は0から数えるため、numbers[1]はJust 20、numbers[9]はNothingです。selectedのmatchはJustからvalueを取り出し、Nothingなら0を選びます。selectedはInt型の20となり、整数として計算に使えます。",
  result: "リストの表記には先頭のバッククォートがあり、\"Ren\" : namesは元を変えずに先頭を追加します。ArrayとListは自動では変換されません。表示されたMaybeは検索結果であり、そのまま整数の計算には使えません。"
}
