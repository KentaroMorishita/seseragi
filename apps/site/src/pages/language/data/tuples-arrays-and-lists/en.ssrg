import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Tuples, arrays, and lists",
  summary: (explanation ()).summary,
  purpose: [
    "A tuple groups values with different roles, such as a label and a number. (\"answer\", 42) has two positions: the first is String and the second Int.",
    "Use Array to read elements at integer positions. Use List when adding elements at the front or taking them in order from the front. Both are immutable, so a changed result is a new value. Array and List are different types."
  ],
  exampleTitle: "Choose a shape and read its values",
  reading: [
    "pair contains a String in its first position and an Int in its second. let (label, number) = pair extracts them and gives them names, so the first outputs are answer and 42.",
    "[10, 20, 30] has type Array<Int>. Positions start at zero, so numbers[1] refers to 20. Indexed access returns Maybe<Int>.",
    "Just 20 means an element exists at that position with value 20; Nothing means none exists. numbers[9] is outside the array, so it returns Nothing. selected uses match to extract an integer from Just, or uses 0 for Nothing.",
    "A backtick before the brackets makes a List: `[\"Aki\", \"Mio\"]. \"Ren\" : names creates a new list with Ren at the front. names is unchanged. The final output, converted to text with show, also has a backtick identifying the list."
  ],
  rules: [
    "A tuple has a fixed length and a type for each position. There is no one-element tuple. Array and List elements must all have one common type; an Array<Int> cannot contain a String.",
    "An empty collection supplies no element from which to infer its type. Declare it explicitly, for example let empty: Array<Int> = [] or let empty: List<String> = `[ ]. Spaces inside the brackets do not change the list syntax.",
    "Array indices are Int values. Negative and out-of-range indices produce Nothing. Write the index brackets immediately after the receiver: numbers[1]. f [1] instead passes an array to f. List has no index syntax.",
    "Array-to-List and List-to-Array conversion is explicit, using std/array.toList and std/list.toArray. A list can share its unchanged tail when prepending; repeatedly copying the rest of an array during recursive traversal can instead make a large traversal expensive."
  ],
  mistakes: [
    "Without the backtick, [\"Aki\", \"Mio\"] is an Array, not a List. An expected List type does not silently convert that literal.",
    "numbers[1] has type Maybe<Int>. Handle Just and Nothing before treating the result as an Int. If you destructure a collection with a fixed number of positions, it may not match; tuple destructuring is different because the tuple's length is fixed in its type."
  ],
  related: [
    "Generate collections from ranges or another collection.",
    "Check when destructuring is guaranteed to match and when match is required.",
    "Look up the basic element types and Maybe constructors used in results."
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Which collection should I use, and how do I read an element?",
  summary: "A tuple has fixed positions, possibly of different types. An Array or List has any number of elements of one type, with different access and construction operations.",
  reading: "(label, number) unpacks the tuple. Array indexes start at zero, so numbers[1] is Just 20 and numbers[9] is Nothing. The match for selected extracts value from Just, or chooses 0 for Nothing. selected is therefore an Int with value 20, ready for arithmetic.",
  result: "selected is the Int 20. After extracting the indexed result with match, it can be used in integer calculations. \"Ren\" : names creates a list with a new first element, leaving names unchanged. Use library conversion functions to convert between Array and List."
}
