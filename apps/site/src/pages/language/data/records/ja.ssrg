import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "レコード",
  summary: (explanation ()).summary,
  purpose: [
    "名前と得点のように、一緒に扱いたい値をレコードにまとめられます。{ name: \"Aki\", score: 10 }は二つのフィールドを持つ値です。フィールドは、nameやscoreのように名前を付けた部分です。",
    "レコードの型は、フィールドの名前と各フィールドの型で決まります。これを構造的型付けと呼びます。nameを必要とする関数には、scoreなどほかの必須フィールドも持つレコードを渡せます。"
  ],
  exampleTitle: "フィールドを読み、得点を変えたコピーを作る",
  reading: [
    "originalには、nameが\"Aki\"、scoreが10のレコードを入れています。original.scoreはscoreフィールドの整数を読みます。",
    "...originalで、元のフィールドを新しいレコードに取り込みます。この書き方をスプレッドと呼びます。その後のscore: 42は、新しいレコードのscoreを指定します。originalは変わりません。",
    "nameOfの引数の型は{ name: String }です。nameという必須の文字列フィールドを持つレコードを受け取ります。関数はperson.nameを読み、その文字列を返します。",
    "updatedにはscoreもありますが、nameOfに渡せます。関数内で読めるのは、引数型に指定したnameです。最後の出力がAkiなのは、コピーしたnameフィールドが変わらないためです。"
  ],
  rules: [
    "フィールドの値やスプレッドの元になる式は、書いた順に一度ずつ評価されます。スプレッドは複数書けます。同じフィールドが含まれる場合は後のスプレッドが優先され、その後に直接書いたフィールドが置き換えます。",
    "フィールドの型を変えたコピーも作れます。その場合は、結果のレコード型も変わります。元のレコードの型や値は変わりません。スプレッドの元に指定できるのはレコードです。",
    "{ name, }は{ name: name }の省略形です。一つのフィールドをこの形で書く場合、ブロックと区別するため末尾のカンマが必要です。{}は空のレコードで、Unitの値は()と書きます。",
    "必須フィールドは必ず存在しますが、省略可能なフィールドは存在しない場合があります。省略可能なフィールドを読むとMaybeが返ります。値があればJust value、なければNothingとして扱います。"
  ],
  mistakes: [
    "updated.score = 99のような代入はできません。レコードは不変なので、得点を変えるには別のレコードを作ります。",
    "{ score: 10, score: 42 }のように同じフィールドを直接二度書くとエラーです。スプレッドから取り込んだフィールドを置き換える場合とは違います。また、構造体はレコードではないため、レコードのスプレッドでコピーすることはできません。"
  ],
  related: [
    "フィールドがない場合や、JustとNothingで結果を読む方法を確認できます。",
    "型名を付けてデータを区別する場合と、構造体の更新方法を比較できます。",
    "レコードの中身を取り出して、個別の名前に束縛する方法を確認できます。"
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "元の値を変えずに、フィールドを変えるには",
  summary: "レコードは、型名を宣言せずに名前付きフィールドをまとめる値です。ドットで読み、スプレッドで変更したコピーを作ります。",
  reading: "originalはnameの\"Aki\"とscoreの10を持ちます。...originalで新しいレコードへフィールドを取り込み、score: 42で新しい方の得点を指定します。nameOfはStringのnameだけを要求するため、scoreも持つupdatedを渡せます。",
  result: "出力は10、42、Akiです。original.scoreは10のままで、updated.scoreだけが42になります。元の値を変更したい場合も、代入ではなく新しいレコードを作って使います。"
}
