import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Records",
  summary: (explanation ()).summary,
  purpose: [
    "A record groups values that belong together, such as a name and a score. { name: \"Aki\", score: 10 } has two fields. A field is a named part such as name or score.",
    "A record's type depends on its field names and the type of each field. This is called structural typing. A function requiring name can receive a record that also has other required fields, such as score."
  ],
  exampleTitle: "Read a field and make an updated record",
  reading: [
    "original holds a record with name \"Aki\" and score 10. original.score reads the integer from the score field.",
    "...original brings the original fields into a new record. This is called a spread. The following score: 42 sets the score of the new record. original stays unchanged.",
    "nameOf takes { name: String }, a record with a required string field named name. It reads person.name and returns that string.",
    "updated also has score, but can be passed to nameOf. Inside the function, the accessible field is name, as specified by its parameter type. The final output is Aki because the copied name field is unchanged."
  ],
  rules: [
    "Field values and spread source expressions are evaluated once each in written order. Several spreads are allowed. If they contain the same field, the later spread wins; a following explicit field replaces that result.",
    "A copy can change a field's type. The result then has a different record type. The original record keeps its type and value. A spread source must be a record.",
    "{ name, } abbreviates { name: name }. With one shorthand field, the trailing comma distinguishes a record from a block. {} is an empty record; the Unit value is written ().",
    "A required field always exists, while an optional field may be absent. Reading an optional field returns Maybe: handle Just value if present and Nothing if absent."
  ],
  mistakes: [
    "You cannot assign updated.score = 99. Records are immutable: construct another record if the score should change.",
    "Do not write the same field directly twice, as in { score: 10, score: 42 }. That is a duplicate-field error, unlike replacing a field copied from a spread. Do not use a record spread to copy a struct; a struct has its own update syntax."
  ],
  related: [
    "Check absent fields and the Just/Nothing results of optional access.",
    "Compare named data types and their update syntax with records.",
    "Check destructuring a record into local names."
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I group a name and score, like a TypeScript object?",
  summary: "A record groups fields such as name and score. Read a field or create an updated copy while retaining the original value.",
  reading: "original has name \"Aki\" and score 10. A dot reads a field. { ...original, score: 42 } copies the original fields and sets the new score to 42.",
  result: "The output is 10, 42 and Aki. original stays unchanged; only updated has the new score. nameOf only uses a String field named name, so updated can also have score.",
}

pub fn readerCaption -> String = "Pass the fields a function needs"

pub fn readerBridgeOne -> String =
  "This resembles creating an object with TypeScript const, but Seseragi record fields are immutable too. Instead of assigning updated.score, construct a new value with the fields you need."

pub fn readerBridgeTwo -> String =
  "The parameter type { name: String } requires a name field; it needs no separately declared type name. main uses println for output. Inside the backticks, ${...} inserts a value and \\n starts a new line."

pub fn readerInvalidCaption -> String = "Duplicate fields"

pub fn readerMistake -> String =
  "Writing the same field twice explicitly differs from replacing a copied field after a spread. In the later rejected example, remove one of the duplicate explicit fields."
