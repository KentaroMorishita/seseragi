import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Structs",
  summary: (explanation ()).summary,
  purpose: [
    "A struct gives a type name to data with several fields. User can hold id and name. A Product declaration with the same fields still defines a different type.",
    "A struct's type depends on the declaration that creates it. This is called nominal typing. Unlike records, whose types depend on field names and types, structs distinguish data with different meanings even when their shapes match."
  ],
  exampleTitle: "Create a User and rename a copy",
  reading: [
    "struct User { id: Int, name: String } declares User. Int is the integer type and String is the text type. The declaration does not create a user value yet.",
    "User { id: 1, name: \"Aki\" } creates a User by supplying both fields. The User before the braces selects the declared type.",
    "User { ...original, name: \"Mio\" } creates another User. The spread takes the starting fields from original, and name: \"Mio\" replaces the name in the new value.",
    "The output shows that original still contains Aki, renamed contains Mio, and the copied id remains 1. Reading a field uses a dot; updating a copy is not assignment to the old value."
  ],
  rules: [
    "Every declared field needs a value of its declared type. Unknown fields are not allowed. Separate struct declarations are separate types even when their field names and types match.",
    "A struct update accepts at most one spread, before explicitly supplied fields. The source must have the same struct type. Unlike a record update, it cannot change a field's type.",
    "When a variable has the same name as a field, id can abbreviate id: id. Field names select their destinations; written order determines when values are computed.",
    "A struct can use type parameters, such as Box<A>. impl can add methods for that type. Check visibility when using the struct from another module. Private fields or a struct's contents hidden by opaque cannot be accessed freely."
  ],
  mistakes: [
    "User { id: 1 } is incomplete because name is required. The following example is rejected for a missing field.",
    "{ id: 1, name: \"Aki\" } is a record, not a User. Merely matching the fields does not convert it to User. Also, renamed.name = \"Ren\" is not a valid way to update an immutable struct."
  ],
  related: [
    "Compare structural typing and record spreads with named structs.",
    "Learn how parameters such as Box<A> make a family of types.",
    "Add operations to a struct and check the rules for their self parameter."
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Why name a data shape instead of using an ordinary record?",
  summary: "A struct gives a data shape a named identity, preventing unrelated declarations with the same fields from being confused.",
  reading: "struct User declares id: Int and name: String. User before the braces constructs that specific type. User { ...original, name: \"Mio\" } builds another User with the copied id and the replacement name.",
  result: "The outputs are Aki, Mio, and 1. original still holds the name Aki; only renamed holds Mio. Both have type User. User { ...original, name: \"Mio\" } constructs a new value of that same type."
}
