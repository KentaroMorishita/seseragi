import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "構造体",
  summary: (explanation ()).summary,
  purpose: [
    "構造体は、データの形に型名を付けるための仕組みです。たとえばUserにidとnameを持たせられます。Productにも同じフィールドを宣言しても、UserとProductは別の型です。",
    "この区別によって、意味の違う値を取り違えることを防げます。フィールドの形で型が決まるレコードに対し、構造体はどの宣言から作ったかで型が決まります。この考え方を名前的型付けと呼びます。"
  ],
  exampleTitle: "Userを作り、名前を変えたコピーを作る",
  reading: [
    "struct User { id: Int, name: String }でUser型を宣言します。Intは整数、Stringは文字列の型です。この宣言だけでは、まだユーザーの値は作られません。",
    "User { id: 1, name: \"Aki\" }で、二つのフィールドを指定したUserの値を作ります。括弧の前のUserが、どの型の値を作るかを指定しています。",
    "User { ...original, name: \"Mio\" }で別のUserを作ります。...originalで元のフィールドを取り込み、name: \"Mio\"で新しい値の名前を置き換えます。",
    "出力では、originalの名前はAkiのまま、renamedの名前はMio、コピーしたidは1になっています。ドットでフィールドを読みますが、コピーを作る操作は元の値への代入ではありません。"
  ],
  rules: [
    "宣言したすべてのフィールドに、それぞれの型に合う値が必要です。宣言にないフィールドは指定できません。別々に宣言した構造体は、フィールドの名前と型が一致していても別の型です。",
    "構造体の更新に使うスプレッドは一つだけで、直接指定するフィールドより前に置きます。元の値は同じ構造体型でなければなりません。レコードと違い、更新でフィールドの型を変えることはできません。",
    "同じ名前の変数がある場合、id: idをidと省略できます。どのフィールドに入るかは名前で決まり、値を計算する順序は書いた順序で決まります。",
    "Box<A>のように型のパラメーターを持つ構造体も宣言できますが、この例では不要です。また、implで型に属する関数を追加できます。別のモジュールから使う場合は公開範囲の制限もあり、非公開の表現やopaqueで隠した表現を自由に作ったり読んだりはできません。"
  ],
  mistakes: [
    "User { id: 1 }では、必須のnameが足りません。次の例はそのためエラーになります。",
    "{ id: 1, name: \"Aki\" }はレコードであり、Userではありません。フィールドが一致しても自動でUserにはなりません。また、renamed.name = \"Ren\"のように不変の構造体へ代入することもできません。"
  ],
  related: [
    "型の決まり方やスプレッドの違いを、レコードと比較できます。",
    "Box<A>のように、型のパラメーターを使う宣言を確認できます。",
    "構造体に操作を追加する方法と、self引数の規則を確認できます。"
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "普通のレコードではなく、構造体に型名を付けるのはなぜか",
  summary: "構造体は、フィールドの形に型名を付けます。同じフィールドを持つ別の宣言と取り違えないようにできます。",
  reading: "struct Userでid: Intとname: Stringを宣言します。波括弧の前のUserは、その型の値を作る指定です。User { ...original, name: \"Mio\" }は、元のidを引き継ぎ、名前を変えた別のUserを作ります。",
  result: "出力はAki、Mio、1です。二つの値はどちらもUserで、originalは変わりません。普通の{ id: 1, name: \"Aki\" }レコードが自動でUserになるわけではありません。"
}
