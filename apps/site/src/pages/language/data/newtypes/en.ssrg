import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Newtype values",
  summary: (explanation ()).summary,
  ruleTitle: "Wrap and unpack values explicitly",
  ruleBody: "With newtype UserId = Int, UserId 42 creates a UserId containing an Int. Use the pattern UserId value to extract the contained value. You can also define methods or operators specifically for UserId.",
  typingBody: "UserId and Int are different types. An Int cannot be passed directly to a function requiring UserId. This also applies to parameterized newtypes. pub opaque allows other modules to use the type name, but hides its constructor and unpacking pattern.",
  evaluationBody: "The contained expression is evaluated once. A compilation target may implement UserId without extra storage for its wrapper. The compiler still checks UserId and Int as different types. Users construct it with UserId 42 and unpack it with the UserId number pattern.",
  invalidTitle: "Operations of the contained type are not inherited automatically",
  invalidBody: "Wrapping Int does not automatically provide Int's operators or trait implementations. A newtype also has no record-style field access or update. Define the required operations for the newtype, or extract its contents explicitly.",
  diagnosticsBody: "Check whether a contained value and its newtype have been confused. Construct the wrapper when needed and unpack it with a pattern on the receiving side.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I construct and unpack a newtype value?",
  summary: "A newtype gives one existing value type a distinct name and identity. Its constructor wraps a value; a matching pattern unwraps it.",
  reading: "UserId 42 constructs a UserId, not an ordinary Int. raw matches UserId number and returns number. The same UserId name is used in a type position, a construction expression, and an unpacking pattern.",
  result: "number is the Int 42. To pass UserId to a function taking Int, extract its contents with raw first. To use an integer as UserId, wrap it with the constructor, such as UserId 42."
}
