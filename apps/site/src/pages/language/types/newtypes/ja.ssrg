import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "newtypeの同一性と表現",
  summary: "一つの表現を別のドメイン型で包み、構築と取り出しを明示します。",
  ruleTitle: "表現が同じでも型は別",
  ruleBody: "newtype UserId = IntはIntのaliasではなく、新しいnominal型を作ります。生成されるUserIdコンストラクターは一つのIntを包み、UserIdのパターンで明示的に取り出せます。別のnewtypeが同じ表現を使っても互換にはなりません。識別子や単位が意図せず境界を越えるのを防ぎます。",
  identityBody: "ジェネリックnewtypeのコンストラクターは宣言の全パラメーターを量化します。すべてが内部表現に現れる必要はなく、使わないパラメーターで追加の実行時データなしにドメインを区別できます。推論できないパラメーターは期待型や明示した引数で確定させます。右辺はfieldリストではなく、一つの型式です。",
  checkingBody: "入力が対応するnewtypeなら、コンストラクターパターンは必ず一致します。暗黙の包み込み、取り出し、field参照、coerce、内部表現のリフレクションはありません。直接再帰する表現や、alias・別のnewtypeを介した循環は禁止です。再帰的な選択肢にはADTを使ってください。",
  invalidTitle: "newtypeを内部の値と同一視しない",
  invalidBody: "Intを受け取る関数にUserId 42を渡すと、内部表現がIntでも型不一致になります。例のtoIntのように意図して取り出してください。逆にUserIdが必要な位置には、包む前のIntを渡せません。メソッドやinstanceでドメイン操作を定義しても、この境界はなくなりません。",
  diagnosticsBody: "バックエンドは観測可能な意味を保てる場合に限って物理的なラッパーを消去できます。消去によってnominalな検査を弱めたり、暗黙変換を加えたりはできません。opaqueな公開newtypeでは、型名と安全な操作だけを公開し、構築と取り出しを定義モジュール内に閉じられます。",
  provenanceBody: "言語仕様2.18に基づく規則です。表示する短い例はこのリファレンス専用に管理し、公式コンパイラで検査しています。Tourのレッスンではありません。"
}
