import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "newtypeによる型の区別",
  summary: (explanation ()).summary,
  ruleTitle: "同じIntを使っていても、別の型として区別する",
  ruleBody: "newtype UserId = Intは、Intの別名ではなく、新しい型UserIdを作ります。UserId 42で値を作り、UserIdのパターンで中のIntを取り出します。同じIntを使うOrderIdを別に宣言しても、UserIdとは交換できません。識別子や単位を取り違える間違いを型検査で防げます。",
  identityBody: "newtypeにも型パラメーターを宣言できます。中身に使わない型パラメーターでも、異なる用途の型を区別できます。その型が値から分からない場合は、結果の型注釈か明示的な型引数で指定してください。宣言の右辺には、中身の値の型を一つ書きます。structのようなフィールド一覧は書きません。",
  checkingBody: "UserIdの値にUserIdのパターンを使えば、必ず中身を取り出せます。ただし、IntからUserIdへの変換や、その逆の変換が暗黙に行われることはありません。フィールド参照や汎用のcoerceで中身を取り出すこともできません。中身の型が、自分自身へ直接または間接に戻る循環は認められません。再帰的な選択肢が必要ならADTを使います。",
  invalidTitle: "UserIdが必要な場所に、Intをそのまま渡さない",
  invalidBody: "Intを受け取る関数にUserId 42を渡すと型エラーになります。例のtoIntのように、意図を示して中身を取り出してください。逆にUserIdが必要な場所には、IntをUserIdで包んで渡します。メソッドやtrait実装を追加しても、この型の区別はなくなりません。",
  diagnosticsBody: "コンパイラが実行時の余分な包みを省くことがあっても、ソース上では型の区別が保たれます。また、newtypeをopaqueとして公開すれば、利用側には型名と安全な操作だけを見せ、値の構築や中身の取り出しを定義元のモジュールに限定できます。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "同じ整数で表すユーザーIDと注文IDを取り違えないためには",
  summary: "整数のままでは、ユーザーIDが必要な引数へ注文IDも渡せてしまいます。newtypeで用途を別の型として宣言し、呼び出し時に区別します。",
  reading: "newtype UserId = IntはIntとは別のUserId型を作ります。UserId 42は整数42を持つUserIdの値です。OrderIdも同じ整数を使いますが、別に宣言した型なのでUserIdにはなりません。",
  result: "userLabelはUserIdだけを受け取ります。matchのUserId numberは包まれた整数をnumberという名前で取り出し、user: 42という文字列を返します。mainがその一行を表示します。",
}

pub fn readerCaption -> String = "UserIdだけを受け取る関数を作る"

pub fn readerBridgeOne -> String =
  "alias UserId = IntならIntと同じ型のままですが、newtypeは型を区別します。ただし、UserId 42を作ることは、42というユーザーが実在することや、正の番号であることの検証にはなりません。必要な検証は値を作る関数へ別に書きます。"

pub fn readerBridgeTwo -> String =
  "UserIdの値をUserId numberで分ける処理は必ず一致します。選択肢が一つだけだからです。pub effect fn mainが公開された出力の入口で、printlnが文字列と改行を出力します。整数の型が必要な場所では、同様に取り出したnumberを使います。"

pub fn readerInvalidCaption -> String = "注文IDをユーザーIDの引数へ渡す"

pub fn readerMistake -> String =
  "OrderId 42をuserLabelへ渡すと、SES-T0101がUserIdとOrderIdの違いを示します。ユーザーの番号であると確認した値からUserIdを作って渡してください。型エラーを消すために、注文の番号を無条件で包み直すと用途の取り違えは解決しません。"

pub fn readerDetailNote -> String =
  "詳しい宣言例ではtoIntでUserIdを取り出します。型パラメーターを持つnewtype、再帰の制限、実行時表現についての規則も続けて説明します。宣言だけの例に実行入口はありません。"

pub fn readerComparison -> String =
  "TypeScriptでも、kindが\"user\"のオブジェクトと\"order\"のオブジェクトを別々の型にすれば区別できます。ここでkindの型に書いた文字列は、その一つの文字列だけを許す指定です。高度な型の仕掛けを使わずに、同じ表示と取り違えの検査を実現しています。"

pub fn readerLegacyReading -> String =
  "UserId 42とOrderId 42は同じ整数を持ちますが、型は別です。toIntはUserIdだけを受け取り、matchで中の整数を取り出します。OrderIdを渡すと型エラーになります。"

pub fn readerLegacyResult -> String =
  "toInt (UserId 42)はIntの42を返します。UserIdとして使うには包み、Intとして使うには取り出します。入力値を検証したい場合は、newtypeの宣言とは別に、値を作る関数へ検証処理を書いてください。"

pub fn readerRelated -> String = "では、値を渡すときに必要な変換や取り出しを確認できます。"
