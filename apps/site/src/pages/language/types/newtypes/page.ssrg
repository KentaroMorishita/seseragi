import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  typePage "language.types.newtypes" "/docs/language/types/newtypes/" (en.copy ()) (ja.copy ()) [CodeExample
      ("types-newtypes", localized "Newtype identity and representation" "newtypeの同一性と表現")] [CodeExample
      ("types-newtype-invalid", localized "Rejected type mismatch" "拒否される型の不一致")] [
        [InternalLink
      (localized "Newtype values" "newtypeの値", "/docs/language/data/newtypes/")],
        [InternalLink (
          localized "Type identity and coercion" "型の同一性と型変換",
          "/docs/language/types/type-identity-and-coercion/"
        )],
        [InternalLink (
          localized "Erasure and runtime representation" "型消去と実行時表現",
          "/docs/language/types/erasure-and-runtime-representation/"
        )]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample
          ("type-reader-newtypes", localized (en.readerCaption ()) (ja.readerCaption ())),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "user: 42"),
        CodeExample (
          "type-reader-newtypes-typescript",
          localized "The same task in TypeScript" "TypeScriptで同じ仕事をする"
        ),
        Paragraph
          ([Words (localized (en.readerComparison ()) (ja.readerComparison ()))]),
        CodeExample (
          "type-reader-newtypes-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Paragraph (
          [
            InternalLink (
              localized "Type identity and coercion" "型の同一性と型変換",
              "/docs/language/types/type-identity-and-coercion/"
            ),
            Words (localized (en.readerRelated ()) (ja.readerRelated ()))
          ]
        ),
        Heading (
          "declaration-example",
          localized "Continue into the detailed rules" "詳しい規則と宣言例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
