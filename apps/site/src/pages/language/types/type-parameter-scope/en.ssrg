import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Type parameter scope",
  summary: (explanation ()).summary,
  ruleTitle: "The declaration owns the parameter",
  ruleBody: "In identity<A>, A becomes available after the type-parameter list and remains in scope until the declaration ends. It can appear in value-parameter types, the return type, constraints and annotations inside the body. A different function's A is a separate parameter even when both use the same spelling.",
  identityBody: "Within its declaration, a type parameter takes precedence over a module-level type of the same name. Even if the module defines a type A, A inside identity<A> refers to the parameter. Begin type parameter names with a capital letter and declare them in the parameter list. Capitalized spelling alone does not declare one.",
  checkingBody: "The example annotates a local binding with the same A used by the parameter and return type. The binding therefore keeps the caller's chosen type; it does not create another fresh A. An inner declaration cannot rebind a type parameter that is still in scope. Give a method-local parameter a different name from its impl parameter.",
  invalidTitle: "A repeated name does not introduce a second parameter",
  invalidBody: "Duplicate names in one parameter list are rejected, as is shadowing an enclosing type parameter in a nested declaration. Writing an undeclared uppercase name does not request implicit generic inference. If the name is not an accessible type or a declared parameter, it cannot be used as a type.",
  diagnosticsBody: "For an unresolved type name, inspect the declaration's parameter list and its imports. For a shadowing error, rename the inner parameter and update its annotations consistently. Scope ends with the declaration, so a later declaration must introduce its own parameter.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Where does a declared A refer to the same type?",
  summary: "A type parameter is a name used within its declaration. Repeated A references there denote the same type; another function’s declared A is independent.",
  reading: "A in keep<A> is shared by the parameter value, the return type and let saved: A. In keep 42 all three mean Int. saved gives the received value another name without changing its type.",
  result: "pair<A> declares its own A, so it can select String independently of the call to keep. (A, A) is a tuple with two positions. let (first, second) unpacks it, and the program prints 42 followed by ready, ready.",
}

pub fn readerCaption -> String =
  "Use independently declared type parameters in two functions"

pub fn readerBridgeOne -> String =
  "In a TypeScript generic function, A in function keep<A> also belongs to that declaration. Seseragi does not share a single A across the whole program either. The region where a declared type parameter is available is its scope."

pub fn readerBridgeTwo -> String =
  "A is a name in type positions, not a value to print or add. value and saved are the actual values. pub effect fn main performs output and ${...} inserts values into text. A nested declaration also cannot redeclare an already-scoped type parameter with the same name."

pub fn readerInvalidCaption -> String = "Use a function’s A outside its declaration"

pub fn readerMistake -> String =
  "After keep ends, let outside: A cannot resolve A and reports SES-N0001, followed by a type mismatch. Write Int for 42 here, or omit the annotation. A new generic function must declare its own <A> after its name."

pub fn readerDetailNote -> String =
  "The detailed declaration example uses one A in parameter, result and local annotations too. Further rules specify its scope boundaries, duplicate and shadowing restrictions, and precedence over module type names."

pub fn readerLegacyReading -> String =
  "The A after identity is the same A in value: A, the result type, and let unchanged: A. If a call chooses Int, every one of these positions means Int for that call."

pub fn readerLegacyResult -> String =
  "number is the Int value 42 and text the String value \"hello\". The A declared by identity does not carry over to another function. Declare a parameter on that function if needed. In nested declarations, use a different name from any enclosing type parameter."

pub fn readerRelated -> String = " explains how a caller selects type arguments."
