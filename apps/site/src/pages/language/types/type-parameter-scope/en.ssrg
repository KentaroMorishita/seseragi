import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Type parameter scope",
  summary: (explanation ()).summary,
  ruleTitle: "The declaration owns the parameter",
  ruleBody: "In identity<A>, A becomes available after the type-parameter list and remains in scope until the declaration ends. It can appear in value-parameter types, the return type, constraints and annotations inside the body. A different function's A is a separate parameter even when both use the same spelling.",
  identityBody: "Within its declaration, a type parameter takes precedence over a module-level type of the same name. Even if the module defines a type A, A inside identity<A> refers to the parameter. Begin type parameter names with a capital letter and declare them in the parameter list. Capitalized spelling alone does not declare one.",
  checkingBody: "The example annotates a local binding with the same A used by the parameter and return type. The binding therefore keeps the caller's chosen type; it does not create another fresh A. An inner declaration cannot rebind a type parameter that is still in scope. Give a method-local parameter a different name from its impl parameter.",
  invalidTitle: "A repeated name does not introduce a second parameter",
  invalidBody: "Duplicate names in one parameter list are rejected, as is shadowing an enclosing type parameter in a nested declaration. Writing an undeclared uppercase name does not request implicit generic inference. If the name is not an accessible type or a declared parameter, it cannot be used as a type.",
  diagnosticsBody: "For an unresolved type name, inspect the declaration's parameter list and its imports. For a shadowing error, rename the inner parameter and update its annotations consistently. Scope ends with the declaration, so a later declaration must introduce its own parameter.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Where can I use a declared type parameter?",
  summary: "A type parameter belongs to its declaration. It is visible in that declaration's signature and body, not in unrelated declarations.",
  reading: "The A after identity is the same A in value: A, the result type, and let unchanged: A. If a call chooses Int, every one of these positions means Int for that call.",
  result: "number is the Int value 42 and text the String value \"hello\". The A declared by identity does not carry over to another function. Declare a parameter on that function if needed. In nested declarations, use a different name from any enclosing type parameter."
}
