import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "型パラメーターのスコープ",
  summary: (explanation ()).summary,
  ruleTitle: "型パラメーターは宣言に属する",
  ruleBody: "identity<A>のAは型パラメーターのリストの後から宣言の終わりまで有効です。値引数の型、戻り型、制約、関数本体の型注釈で使えます。別の関数で同じAという名前を使っても、それぞれ独立したパラメーターです。",
  identityBody: "宣言の中では、型パラメーターが同名のモジュールの型より優先されます。例えば、モジュールにAという型があっても、identity<A>の本体で使うAは型パラメーターです。型パラメーターの名前は大文字で始め、パラメーターリストで宣言してください。大文字の名前を書くだけでは宣言になりません。",
  checkingBody: "例では引数と戻り型に使ったAでローカル束縛も注釈しています。その束縛は呼び出し側が選んだ同じ型を保ち、新しいAを導入しません。内側の宣言で、スコープ内の型パラメーターを同名で再束縛することは禁止です。implのパラメーターとメソッド固有のパラメーターには異なる名前を付けてください。",
  invalidTitle: "同じ名前を重ねても別のパラメーターにはならない",
  invalidBody: "一つのリスト内の重複名と、外側の型パラメーターを内側の宣言で隠すことは拒否されます。未宣言の大文字名を使っても、暗黙のジェネリック推論を要求したことにはなりません。参照可能な型でも宣言済みのパラメーターでもない名前は、型として使えません。",
  diagnosticsBody: "型名を解決できない場合は、その宣言のパラメーターリストとimportを確認してください。名前の隠蔽が原因なら、内側のパラメーターと対応する注釈を一緒に改名します。スコープは宣言の末尾で終わるため、後続の宣言では自分のパラメーターを導入する必要があります。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "宣言したAは、どこまで同じ型を表すか",
  summary: "型パラメーターは宣言の中で使う名前です。同じAを何度書いても、その宣言内では同じ型を指します。別の関数で宣言したAとは独立しています。",
  reading: "keep<A>のAはvalueの型、戻り値の型、let saved: Aの三箇所で同じです。keep 42ではすべてIntになります。savedは型を変えず、受け取った値にもう一つ名前を付けています。",
  result: "pair<A>は自分のAを宣言しているので、keepの呼び出しとは独立にStringを選べます。(A, A)は二つの位置を持つタプルです。let (first, second)で中身を取り出し、42とready, readyを表示します。",
}

pub fn readerCaption -> String = "二つの関数で、それぞれの型パラメーターを使う"

pub fn readerBridgeOne -> String =
  "TypeScriptのgeneric関数でも、function keep<A>のAはその関数の宣言に属します。SeseragiでもAという名前をプログラム全体で共有するわけではありません。型パラメーターが有効な範囲をスコープと呼びます。"

pub fn readerBridgeTwo -> String =
  "Aは型を書く位置の名前で、表示したり足したりする値ではありません。実際の値はvalueやsavedです。pub effect fn mainが出力を行い、${...}は値を文字列へ埋め込みます。内側の宣言で同じ型パラメーター名を再宣言することもできません。"

pub fn readerInvalidCaption -> String = "関数の外で、その関数だけのAを使う"

pub fn readerMistake -> String =
  "keepの宣言が終わった後にlet outside: Aと書くと、Aを解決できずSES-N0001になります。続けて型不一致も報告されます。ここでは42の型であるIntと書くか、型注釈を省略します。新しいgeneric関数なら、その関数名の後で改めて<A>を宣言します。"

pub fn readerDetailNote -> String =
  "詳しい宣言例でも、引数・戻り値・ローカル注釈に同じAを使います。宣言の開始と終了、重複や隠蔽の制限、モジュールの型名との優先順位を確認してください。"

pub fn readerLegacyReading -> String =
  "identityの後に宣言したAは、value: A、戻り値のA、let unchanged: Aのすべてで同じものです。呼び出しでIntを選べば、その呼び出しではすべてIntになります。"

pub fn readerLegacyResult -> String =
  "numberはIntの42、textはStringの\"hello\"です。identityで宣言したAは、別の関数には引き継がれません。別の関数でも型パラメーターが必要なら、その関数で宣言します。内側の宣言では、外側の型パラメーターと異なる名前を使ってください。"

pub fn readerRelated -> String = "では、呼び出し側で型引数を選ぶ方法を確認できます。"
