import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "型パラメーターのスコープ",
  summary: (explanation ()).summary,
  ruleTitle: "型パラメーターは宣言に属する",
  ruleBody: "identity<A>のAは型パラメーターのリストの後から宣言の終わりまで有効です。値引数の型、戻り型、制約、関数本体の型注釈で使えます。別の関数で同じAという名前を使っても、それぞれ独立したパラメーターです。",
  identityBody: "宣言の中では、型パラメーターが同名のモジュールの型より優先されます。これは静的な名前解決の規則で、実行時の型の同一性を変更するものではありません。名前は大文字で始めますが、大文字で書くだけでは型パラメーターになりません。必ずパラメーターリストで宣言します。",
  checkingBody: "例では引数と戻り型に使ったAでローカル束縛も注釈しています。その束縛は呼び出し側が選んだ同じ型を保ち、新しいAを導入しません。内側の宣言で、スコープ内の型パラメーターを同名で再束縛することは禁止です。implのパラメーターとメソッド固有のパラメーターには異なる名前を付けてください。",
  invalidTitle: "同じ名前を重ねても別のパラメーターにはならない",
  invalidBody: "一つのリスト内の重複名と、外側の型パラメーターを内側の宣言で隠すことは拒否されます。未宣言の大文字名を使っても、暗黙のジェネリック推論を要求したことにはなりません。参照可能な型でも宣言済みのパラメーターでもない名前は、型として使えません。",
  diagnosticsBody: "型名を解決できない場合は、その宣言のパラメーターリストとimportを確認してください。名前の隠蔽が原因なら、内側のパラメーターと対応する注釈を一緒に改名します。スコープは宣言の末尾で終わるため、後続の宣言では自分のパラメーターを導入する必要があります。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "宣言した型パラメーターは、どこで使えるか",
  summary: "型パラメーターは、それを宣言した関数や型に属します。その宣言の型注釈や本体では使えますが、別の宣言へは引き継がれません。",
  reading: "identityの後に宣言したAは、value: A、戻り値のA、let unchanged: Aのすべてで同じものです。呼び出しでIntを選べば、その呼び出しではすべてIntになります。",
  result: "numberはIntの42、textはStringの\"hello\"です。別の場所に未宣言のAを書いても、型パラメーターは生まれません。そこで宣言し、外側のパラメーターを隠す同名の宣言は避けます。"
}
