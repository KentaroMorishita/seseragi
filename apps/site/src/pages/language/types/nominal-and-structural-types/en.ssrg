import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Nominal and structural types",
  summary: (explanation ()).summary,
  ruleTitle: "Declaration identity versus record shape",
  ruleBody: "Two ADTs, structs, or newtypes are different nominal types even when their payload or fields match. A structural record R1 is a subtype of R2 when R1 contains every field required by R2 at exactly the same field type; additional R1 fields are permitted.",
  identityBody: "Use named types to distinguish UserId from OrderId even when both contain integers. Use records when an interface should accept only the fields it needs. Extra fields are permitted only at the outer record being passed. Values in shared fields, including nested records, must have exactly the same types.",
  checkingBody: "At a record use site, the checker enumerates required fields, verifies exact field-type equality, then ignores additional source fields. It never converts a struct to a same-shaped record or equates separately declared nominal types.",
  invalidTitle: "Same representation is not the same type",
  invalidBody: "A Player struct cannot be passed as { name: String } merely because it exposes name, and one newtype cannot replace another over the same Int. A record whose shared field has a narrower or wider nested record type fails because field types remain invariant.",
  diagnosticsBody: "Nominal mismatches name both declarations. Structural diagnostics identify missing fields separately from incompatible field types and retain extra fields for tooling. No backend layout decision weakens these source-level identities.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Does a shared name field let values go to the same function?",
  summary: "An ordinary record is accepted when its required fields match. A struct is also distinguished by its declaration. Whether similarly shaped data is interchangeable depends on which representation you chose.",
  reading: "customerName requires Customer. recordName requires only the fields { name: String }. The record with Mio and score can go to recordName because it has the required name.",
  result: "The output is Aki, Mio and Notebook. The example does not pass Product directly to recordName; it explicitly builds { name: product.name }. The conversion is visible in the code.",
}

pub fn readerCaption -> String = "Compare declaration identity with field shape"

pub fn readerBridgeOne -> String =
  "Deciding compatibility from field names and types is called structural typing. Ordinary TypeScript type and interface declarations use this idea too. Seseragi Customer and Product are separate struct declarations, so they remain distinct even though both have name: String."

pub fn readerBridgeTwo -> String =
  "Distinguishing types by their declarations is called nominal typing. Reading customer.name does not automatically turn a Customer into an ordinary record. main prints the three results on separate lines."

pub fn readerInvalidCaption -> String = "Passing another struct with the same shape"

pub fn readerMistake -> String =
  "customerName (Product { name: \"Notebook\" }) reports SES-T0101 because it needs Customer. If a product should not be treated as a customer, choose the appropriate function; if only name is needed, pass an explicit record to recordName."

pub fn readerExecution -> String =
  "pub effect fn main is the public entry point for work that interacts with the outside world. The runner starts main, and println writes a string and newline. The ordinary functions and let bindings above perform the calculation or construct the data."

pub fn readerDetailNote -> String =
  "The declarations below illustrate the detailed rules. They are fragments without their own entry point. To run this page’s example, use the complete program with main above."
