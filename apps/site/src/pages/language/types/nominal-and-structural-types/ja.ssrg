import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "名前付き型と構造的な型",
  summary: (explanation ()).summary,
  ruleTitle: "宣言の同一性とレコードの形を区別する",
  ruleBody: "別々に宣言したADT・struct・newtypeは、中の値やフィールドが同じでも別の型です。一方、レコードは必要なフィールドを同じ型で持っていれば渡せます。たとえば{name: String}を受け取る場所へ、nameとidを持つレコードを渡すことができます。",
  identityBody: "同じ整数でもUserIdとOrderIdを区別したいなら、名前付き型を使います。必要なフィールドだけを受け取りたいならレコードを使えます。追加のフィールドを許すのは、渡すレコードの外側だけです。共通のフィールドに入る値は、内側のレコードも含めて同じ型でなければなりません。",
  checkingBody: "レコードを使う位置で必要なフィールドを列挙し、フィールド型が一致することを確認して追加フィールドを無視します。structを同じ形のレコードへ変換したり、別の名前付き宣言を同一視したりしません。",
  invalidTitle: "同じ表現でも同じ型ではない",
  invalidBody: "nameというフィールドを持つPlayer structでも、普通の{name: String}レコードとしてそのまま渡すことはできません。同じIntを包む二つのnewtypeも別の型です。また、共通フィールドの中のレコードに余分なフィールドがある場合、外側のレコードを渡せる規則だけで、その内側の型まで変更することはできません。",
  diagnosticsBody: "名前付き型が合わない場合は、名前の似た別の宣言を使っていないかを確認します。レコードが合わない場合は、必要なフィールドがあるか、そのフィールドの型が一致しているかを確認します。実行時の形が似ていても、型検査の規則は変わりません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "同じnameフィールドがあれば、同じ関数へ渡せるか",
  summary: "普通のレコードは、必要なフィールドが合えば渡せます。structは宣言の名前でも区別します。同じ見た目のデータを交換してよいかは、どちらで表したかによって変わります。",
  reading: "customerNameはCustomerを要求します。recordNameは{name: String}というフィールドだけを要求します。Mioとscoreを持つレコードは、必要なnameがあるためrecordNameへ渡せます。",
  result: "出力はAki、Mio、Notebookです。ProductをrecordNameへ直接渡さず、{ name: product.name }で普通のレコードを作っています。変換する箇所をコードで示せます。",
}

pub fn readerCaption -> String = "宣言の名前とフィールドの形を比べる"

pub fn readerBridgeOne -> String =
  "フィールドの名前と型で使えるかを決める規則を、構造的型付けと呼びます。普通のTypeScriptのtypeやinterfaceもこの考え方です。SeseragiのCustomerとProductは、別々のstruct宣言なので、どちらもname: Stringでも別の型です。"

pub fn readerBridgeTwo -> String =
  "宣言ごとに型を区別する規則を、名前的型付けと呼びます。ドットでcustomer.nameなどを読めても、Customerが自動で普通のレコードになるわけではありません。mainは三つの結果を改行して表示します。"

pub fn readerInvalidCaption -> String = "同じ形の別structを渡す"

pub fn readerMistake -> String =
  "customerName (Product { name: \"Notebook\" })はSES-T0101です。必要なのはCustomerです。商品を顧客として扱う意図がないなら呼び出す関数を選び直し、nameだけが必要ならrecordNameへ明示的なレコードを渡します。"

pub fn readerExecution -> String =
  "pub effect fn mainは、外部へ出力する公開された実行入口です。実行するとmainが開始され、printlnが文字列と改行を出力します。計算やデータの組み立ては、その前の通常の関数やletで行っています。"

pub fn readerDetailNote -> String =
  "ここからの宣言例は、詳しい規則を調べるための断片です。単独では実行入口を持ちません。動かす場合は、上に載せたmain付きの完全な例を使ってください。"
