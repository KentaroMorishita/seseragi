import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "名前付き型と構造的な型",
  summary: "宣言ごとに区別する型と、フィールドの形で扱うレコードの違いを説明します。",
  ruleTitle: "宣言の同一性とレコードの形を区別する",
  ruleBody: "別々に宣言したADT・struct・newtypeは、中の値やフィールドが同じでも別の型です。一方、レコードは必要なフィールドを同じ型で持っていれば渡せます。たとえば{name: String}を受け取る場所へ、nameとidを持つレコードを渡すことができます。",
  identityBody: "UserIdとOrderIdを区別したい場合のように、用途を分けたいときは名前付き型を使います。必要なフィールドだけを受け取りたいときはレコードを使えます。ただし、余分なフィールドを許す規則は外側のレコードだけに適用されます。共通のフィールドに格納する値の型は一致している必要があります。",
  checkingBody: "レコードを使う位置で必要なフィールドを列挙し、フィールド型が一致することを確認して追加フィールドを無視します。structを同じ形のレコードへ変換したり、別の名前付き宣言を同一視したりしません。",
  invalidTitle: "同じ表現でも同じ型ではない",
  invalidBody: "nameというフィールドを持つPlayer structでも、普通の{name: String}レコードとしてそのまま渡すことはできません。同じIntを包む二つのnewtypeも別の型です。また、共通フィールドの中のレコードに余分なフィールドがある場合、外側のレコードを渡せる規則だけで、その内側の型まで変更することはできません。",
  diagnosticsBody: "名前付き型が合わない場合は、名前の似た別の宣言を使っていないかを確認します。レコードが合わない場合は、必要なフィールドがあるか、そのフィールドの型が一致しているかを確認します。実行時の形が似ていても、型検査の規則は変わりません。",
  provenanceBody: "言語仕様2.6の名前付き・構造的の規則に基づきます。宣言された型と不変レコード、拒否される不一致を比較します。"
}
