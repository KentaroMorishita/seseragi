import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "型構築子",
  summary: (explanation ()).summary,
  ruleTitle: "型引数を指定して完成した型を作る",
  ruleBody: "Maybe<A>は、Aの型を選ぶことで完成する型です。Maybe<Int>は整数があるかないか、Array<Maybe<Int>>はその値を並べた配列を表します。Either<E, A>には二個、Effect<R, E, A>には三個の型引数が必要です。型引数はカンマで区切り、中に別の完成した型を書けます。",
  identityBody: "Task<A>はEffect<{}, Never, A>の型別名です。関数型のA -> B -> CはA -> (B -> C)と同じです。Array<Maybe<Int>>の最後の>>は山括弧を二個閉じるための記号で、式の演算子ではありません。",
  checkingBody: "型構築子ごとに、必要な型引数の個数と形が決まっています。Maybe<Int>のMaybeには、Intのような完成した型を一つ渡します。一方、Functor<Maybe>のような宣言では、さらに型を一つ受け取れるMaybeを渡します。完成した型か、型引数を待つ型構築子かを表す情報をkindと呼びます。",
  invalidTitle: "型引数の個数と種類を合わせる",
  invalidBody: "Maybe<Int, String>は型引数が多すぎます。値の型注釈にMaybeだけを書くと不足しています。また、完成した型が必要な場所に、引数をまだ受け取っていないArrayなどを渡すこともできません。",
  diagnosticsBody: "エラーでは、その型が必要とする引数の個数と、各引数の種類を確認します。山括弧が入れ子の場合は、内側の型から順に読んでください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Box<Int>とBox<String>は、何が違うのか",
  summary: "Boxの中に入れる値の型を選ぶ例です。<A>のAは値ではなく型を入れる場所で、IntかStringかによってvalueフィールドの型が決まります。",
  reading: "struct Box<A> { value: A }は、中身の型を後で選べる宣言です。Box<Int>ではvalueは整数、Box<String>では文字列です。山括弧のIntやStringを型引数と呼びます。",
  result: "出力は42とreadyです。count.valueはInt、message.valueはStringです。型を選んだ後に、波括弧でその型に合う実際の値を指定します。",
}

pub fn readerCaption -> String = "中身の型を選んでから値を作る"

pub fn readerBridgeOne -> String =
  "TypeScriptで配列をArray<number>と書く場合も、numberは配列の要素の型です。ここでも<Int>に42などの値は書きません。型引数を受け取ってBox<Int>のような型を作るBoxを、型構築子と呼びます。"

pub fn readerBridgeTwo -> String =
  "値を作るコンストラクターと、型を組み立てる型構築子は役割が違います。Box<Int>は型を選ぶ部分、Box<Int> { value: 42 }は値を作る式です。printlnは二つのフィールドを文字列へ入れ、改行して表示します。"

pub fn readerInvalidCaption -> String = "Intを選んだ箱に文字列を入れる"

pub fn readerMistake -> String =
  "Box<Int> { value: \"ready\" }はSES-T0101です。整数42を入れるか、文字列を入れる意図ならBox<String>を使います。高度な型の種類については、後半の詳しい規則を必要なときに確認できます。"

pub fn readerExecution -> String =
  "pub effect fn mainは、外部へ出力する公開された実行入口です。実行するとmainが開始され、printlnが文字列と改行を出力します。計算やデータの組み立ては、その前の通常の関数やletで行っています。"

pub fn readerDetailNote -> String =
  "ここからの宣言例は、詳しい規則を調べるための断片です。単独では実行入口を持ちません。動かす場合は、上に載せたmain付きの完全な例を使ってください。"
