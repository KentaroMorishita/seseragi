import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "型構築子",
  summary: "型引数を再帰的に組み合わせ、個数、kind、区切り、関数型の結合を検査します。",
  ruleTitle: "型引数を指定して完成した型を作る",
  ruleBody: "Maybe<A>は、Aの型を選ぶことで完成する型です。Maybe<Int>は整数があるかないか、Array<Maybe<Int>>はその値を並べた配列を表します。Either<E, A>には二個、Effect<R, E, A>には三個の型引数が必要です。型引数はカンマで区切り、中に別の完成した型を書けます。",
  identityBody: "Task<A>はEffect<{}, Never, A>の型別名です。関数型のA -> B -> CはA -> (B -> C)と同じです。Array<Maybe<Int>>の最後の>>は山括弧を二個閉じるための記号で、式の演算子ではありません。",
  checkingBody: "それぞれの型に、型引数の個数と、渡せる型の種類が決まっています。MaybeにはIntのような完成した型を渡します。Functorのように、型引数を一つ受け取る型を要求する宣言もあります。この違いをkindと呼びます。",
  invalidTitle: "型引数の個数と種類を合わせる",
  invalidBody: "Maybe<Int, String>は型引数が多すぎます。値の型注釈にMaybeだけを書くと不足しています。また、完成した型が必要な場所に、引数をまだ受け取っていないArrayなどを渡すこともできません。",
  diagnosticsBody: "エラーでは、その型が必要とする引数の個数と、各引数の種類を確認します。山括弧が入れ子の場合は、内側の型から順に読んでください。",
}
