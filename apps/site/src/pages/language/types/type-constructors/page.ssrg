import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  typePage "language.types.type-constructors" "/docs/language/types/type-constructors/" (en.copy ()) (ja.copy ()) [
    CodeExample (
      "types-constructors",
      localized "Parameterized declarations and complete applications"
        "型パラメーターを宣言し、必要な型引数をすべて渡す"
    ),
    BulletList [
      [
        InlineCode "Array<Array<Int>>",
        Words (
          localized " recursively applies Array at each level."
        " は配列の要素も配列である型です。内側の要素はIntです。"
        )
      ],
      [
        InlineCode "Effect<R, E, A>",
        Words (
          localized " has requirement, failure, and success arguments."
        " の型引数は、必要なサービス、失敗、成功値の順です。"
        )
      ],
      [InlineCode "A -> B -> C", Words (localized " is right-associative." " は右結合です。")]
    ]
  ] [BulletList [
    [
      InlineCode "Maybe<Int, String>",
      Words (localized " supplies one argument too many." " は引数が一つ多すぎます。")
    ],
    [
      InlineCode "Array",
      Words (
        localized " is a constructor, not a complete ordinary value type."
        " だけでは型引数が足りず、値の型を表せません。"
      )
    ]
  ]] [
    [InternalLink
        (localized "Built-in types" "組み込み型", "/docs/language/types/built-in-types/")],
    [InternalLink (
      localized "Function application" "関数適用",
      "/docs/language/syntax/function-application/"
    )],
    [InternalLink (localized "Polymorphism" "多相性", "/docs/language/types/polymorphism/")]
  ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
