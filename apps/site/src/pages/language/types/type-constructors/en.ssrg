import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Type constructors",
  summary: (explanation ()).summary,
  ruleTitle: "Build larger types from checked constructors",
  ruleBody: "Built-ins include Maybe<A>, Either<E, A>, Effect<R, E, A>, Task<A>, Array<A>, List<A>, Range<A>, Signal<A>, MutableSignal<A>, tuples, structural records, and A -> B. Type arguments use commas and may recursively contain any complete type.",
  identityBody: "Task<A> is the transparent alias Effect<{}, Never, A>. A -> B -> C means A -> (B -> C). Nested closing >> and >>> are type delimiters in type context, not expression operator tokens, so Array<Maybe<Int>> remains one complete type.",
  checkingBody: "Each type constructor specifies the number and shape of its type arguments. In Maybe<Int>, Maybe takes one complete type such as Int. A declaration such as Functor<Maybe> instead takes Maybe itself, which can accept another type. A kind describes whether an expression is a complete type or a constructor still expecting type arguments.",
  invalidTitle: "Angles do not imply a partially valid type",
  invalidBody: "Maybe<Int, String>, an unapplied Maybe in an ordinary value annotation, and a constructor supplied at the wrong kind are errors. Tuple, record, Effect requirement, and function syntax retain their own grammar rather than becoming generic comma-separated calls.",
  diagnosticsBody: "The parser distinguishes nested type delimiters from operator tokens by context. Arity diagnostics name the constructor and expected count; kind diagnostics identify the argument position. Tooling preserves the written constructor nesting in hovers and signatures.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What differs between Box<Int> and Box<String>?",
  summary: "Choose the type stored inside a Box. A in <A> is a place for a type, not a value; selecting Int or String determines the type of the value field.",
  reading: "struct Box<A> { value: A } declares a box whose contents type is chosen later. Box<Int> holds an integer; Box<String> holds a string. Int or String inside the angle brackets is a type argument.",
  result: "The output is 42 and ready. count.value has type Int, while message.value has type String. After selecting the type, the braces supply an actual value that matches it.",
}

pub fn readerCaption -> String = "Choose a contents type, then construct a value"

pub fn readerBridgeOne -> String =
  "In TypeScript Array<number>, number describes the element type. Likewise, do not write a value such as 42 inside <Int>. Box, which accepts a type argument to form a type such as Box<Int>, is called a type constructor."

pub fn readerBridgeTwo -> String =
  "A value constructor and a type constructor have different jobs. Box<Int> selects a type; Box<Int> { value: 42 } constructs a value. println inserts both fields into a string and displays them on separate lines."

pub fn readerInvalidCaption -> String = "Putting text in an integer box"

pub fn readerMistake -> String =
  "Box<Int> { value: \"ready\" } reports SES-T0101. Supply 42, or choose Box<String> if text is intended. The later detailed rules cover more advanced distinctions when you need them."

pub fn readerExecution -> String =
  "pub effect fn main is the public entry point for work that interacts with the outside world. The runner starts main, and println writes a string and newline. The ordinary functions and let bindings above perform the calculation or construct the data."

pub fn readerDetailNote -> String =
  "The declarations below illustrate the detailed rules. They are fragments without their own entry point. To run this page’s example, use the complete program with main above."
