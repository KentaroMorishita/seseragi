import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Type constructors",
  summary: "Constructors combine type arguments recursively, with explicit arity, kind, delimiters, and right-associative function types.",
  ruleTitle: "Build larger types from checked constructors",
  ruleBody: "Built-ins include Maybe<A>, Either<E, A>, Effect<R, E, A>, Task<A>, Array<A>, List<A>, Range<A>, Signal<A>, MutableSignal<A>, tuples, structural records, and A -> B. Type arguments use commas and may recursively contain any complete type.",
  identityBody: "Task<A> is the transparent alias Effect<{}, Never, A>. A -> B -> C means A -> (B -> C). Nested closing >> and >>> are type delimiters in type context, not expression operator tokens, so Array<Maybe<Int>> remains one complete type.",
  checkingBody: "Each constructor application is checked independently for argument count and kind. A complete value type must finish at kind Type; extra arguments are never ignored and missing arguments are never filled with Unknown.",
  invalidTitle: "Angles do not imply a partially valid type",
  invalidBody: "Maybe<Int, String>, an unapplied Maybe in an ordinary value annotation, and a constructor supplied at the wrong kind are errors. Tuple, record, Effect requirement, and function syntax retain their own grammar rather than becoming generic comma-separated calls.",
  diagnosticsBody: "The parser distinguishes nested type delimiters from operator tokens by context. Arity diagnostics name the constructor and expected count; kind diagnostics identify the argument position. Tooling preserves the written constructor nesting in hovers and signatures.",
  provenanceBody: "This article covers specification section 2.3. The highlighted generic-struct fixture and grammar fixture exercise parameterized nominal, nested, function, record, and Effect-related type forms."
}
