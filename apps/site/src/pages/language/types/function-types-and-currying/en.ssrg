import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Function types and currying",
  summary: (explanation ()).summary,
  purpose: [
    "When some inputs are always the same, create a function that accepts only the remaining inputs instead of writing the fixed input each time. addOne can add 1 to any integer it receives. This is useful when configuring a calculation for repeated use.",
    "In TypeScript, an arrow function such as const addOne = (value: number) => add(1, value) expresses the same use. Seseragi’s ordinary call syntax also creates a function with some inputs fixed. This comparison limits the inputs to integers."
  ],
  exampleTitle: "Compare a complete call with a function given 1 in advance",
  reading: [
    "Int -> Int means a function receiving one integer and returning an integer. This is addOne’s type. add’s Int -> Int -> Int groups as Int -> (Int -> Int): receiving the first integer returns a function receiving the next integer.",
    "Supplying only some arguments is partial application. Arranging functions to accept arguments one at a time is called currying. Ordinary multi-parameter functions already have this form, so they do not need a special rewrite.",
    "The final pub effect fn main is the public execution entry. effect fn returns an Effect describing work such as output, which the runner executes. println writes text and a newline. ${direct} and ${answer} within the backticks insert their displayed values."
  ],
  rules: [
    "Function types group to the right. Int -> Int -> Int differs from (Int -> Int) -> Int. The latter receives a function of type Int -> Int, rather than an integer, and returns an integer. Use explicit parentheses when a function itself is a parameter.",
    "Arguments are supplied from left to right and checked one at a time against the required type at that step. If arguments remain, the result is a function. For add, an integer result arrives only after all required arguments. Passing one tuple with add (1, 2) is a different parameter type and call.",
    "This is the language’s function type and calling model, not a change made later by an optimizer. Functions whose types are chosen at each use may retain unresolved types or conditions on supported operations, called trait constraints. Remaining arguments or the type required where the result is used can determine them later.",
    "Even fn answer -> Int = 42, with no named parameter, has type Unit -> Int. Unit represents an input with no payload and has the sole value (). Call answer () to obtain 42. answer alone is a function, and merely declaring it does not execute the body.",
    "Editor hovers show right-grouped signatures and the function type remaining after partial application. For an error, check which individual argument failed rather than treating every parameter as one combined call."
  ],
  mistakes: ["add 1 below is a function of type Int -> Int, so it does not satisfy an annotation requiring Int. SES-T0101 reports expected Int and actual Int -> Int. To obtain 3, supply the rest with add 1 2. To keep a function, write let addOne = add 1 and call addOne 2 later."],
  related: [
    "Check complete calls and the role of parentheses.",
    "Find where to write parameter and result types.",
    "Look up functions whose types can be chosen at each use."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I fix the number to add at 1 and supply the other number later?",
  summary: "add 1 2 is an ordinary call supplying two integers. Supply just one with add 1 and the result is a function waiting for the remaining integer.",
  reading: "fn declares a function. add’s left: Int and right: Int are its two integer parameters; the intermediate -> continues to the next parameter and the final -> Int specifies an integer result. The body after = computes left + right. First, add 1 2 returns 3, named direct.",
  result: "let addOne = add 1 supplies only left with 1 and names the function waiting for right addOne. It is not yet an integer result. The next call, addOne 2, supplies the remaining 2, so answer is also 3 and the output is 3, 3."
}

pub fn title -> String = (copy ()).title
