import { articlePage, prose } from "../../../../model/article"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  Heading,
  InternalLink,
  ExternalLink,
  PageDefinition,
  Paragraph,
  Terminal,
  Words
} from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  articlePage "language.types.function-types" "/docs/language/types/function-types-and-currying/" (en.copy ()) (ja.copy ()) [
    Heading
      ("understand-this", localized "Currying: keep a configured search" "カリー化：条件を決めた検索を残す"),
    prose (en.opening ()) (ja.opening ()),
    CodeExample (
      "chapter-function-values",
      localized "Set up a search condition; reuse it" "検索条件を決めて使い回す"
    ),
    Terminal (localized "Output" "実行結果", "[ Build , bundle]\n[bundle]"),
    prose (en.effects ()) (ja.effects ()),
    Heading
      ("reading-the-example", localized "A search is a function value" "検索する関数も一つの値"),
    prose (en.partial ()) (ja.partial ()),
    Heading (
      "why",
      localized "A separate calculation: count the label text" "別の小さな計算：ラベルの文字数を数える"
    ),
    prose (en.lambda ()) (ja.lambda ()),
    CodeExample (
      "chapter-label-lengths",
      localized "Count Unicode scalars, separately from searching"
      "検索とは別に、Unicode scalar数を数える"
    ),
    Terminal (localized "Output" "実行結果", "[5, 6, 5, 3]\n19"),
    prose (en.section ()) (ja.section ()),
    Heading ("rules", localized "The type left after each argument" "引数を渡すたびに残る型"),
    prose (en.arrows ()) (ja.arrows ()),
    prose (en.argumentTypes ()) (ja.argumentTypes ()),
    CodeExample
      ("pilot-currying", localized "A small check of the arrow rule" "矢印の規則だけを確かめる小さな例"),
    Terminal (localized "Output" "実行結果", "3, 3"),
    prose (en.generic ()) (ja.generic ()),
    prose (en.unit ()) (ja.unit ()),
    Heading
      ("mistakes", localized "A remaining function is not the final value" "残った関数と、最後の値は別"),
    prose (en.rejected ()) (ja.rejected ()),
    CodeExample (
      "pilot-currying-invalid",
      localized "A function where Int is required" "Intが必要な場所へ関数を渡す"
    ),
    Heading (
      "related-rules",
      localized "Continue with composition, or look up a rule" "合成の続きと、詳しい規則へ"
    ),
    Paragraph (
      [
        InternalLink (
          localized "Function application" "関数適用",
          "/docs/language/syntax/function-application/"
        ),
        Words (localized (en.previousExit ()) (ja.previousExit ()))
      ]
    ),
    Paragraph (
      [
        InternalLink (
          localized "Pipelines and low-precedence application" "パイプラインと低優先順位の適用",
          "/docs/language/syntax/pipelines-and-low-precedence-application/"
        ),
        Words (localized (en.nextExit ()) (ja.nextExit ()))
      ]
    ),
    Paragraph (
      [
        ExternalLink (
          localized "Lambda expressions (specification)" "ラムダ式（仕様）",
          "https://github.com/KentaroMorishita/seseragi/blob/main/docs/spec/03-data-and-expressions.md"
        ),
        Words (localized (en.lambdaExit ()) (ja.lambdaExit ()))
      ]
    ),
    Paragraph (
      [
        ExternalLink (
          localized "Annotations and inference (specification)" "型注釈と推論（仕様）",
          "https://github.com/KentaroMorishita/seseragi/blob/main/docs/spec/02-types.md"
        ),
        Words (localized (en.annotationsExit ()) (ja.annotationsExit ()))
      ]
    ),
    Paragraph (
      [
        ExternalLink (
          localized "Polymorphism (specification)" "多相性（仕様）",
          "https://github.com/KentaroMorishita/seseragi/blob/main/docs/spec/02-types.md"
        ),
        Words (localized (en.genericExit ()) (ja.genericExit ()))
      ]
    ),
    Paragraph (
      [
        ExternalLink (
          localized "Custom operators and fixity (specification)" "カスタム演算子と結合規則（仕様）",
          "https://github.com/KentaroMorishita/seseragi/blob/main/docs/spec/01-syntax.md"
        ),
        Words (localized (en.operatorExit ()) (ja.operatorExit ()))
      ]
    )
  ]
