import { ArticleCopy } from "../../../../model/article"

pub fn copy -> ArticleCopy = ArticleCopy {
  title: "関数型とカリー化",
  summary: "部分適用でコマンドの検索条件を決め、関数をfilterやmapへ渡す。ラムダと演算子の関数値も、残る型から読んでみよう。"
}

pub fn title -> String = (copy ()).title

pub fn opening -> String =
  "検索文字は、ひとまず\"b\"。候補の名前と一緒に毎回渡してもいいけど、matchesへ検索文字だけ渡したらどうなるだろう。その条件で検索する関数が手元に残り、filterへ渡せる。"

pub fn partial -> String =
  "matchesは検索文字、候補の名前の順に受け取り、Boolを返す。だからmatches \"b\"の型はString -> Bool。buildsは検索結果ではなく、検索する関数だ。arrays.filterが各ラベルにその関数を使い、残す候補を決める。最初の出力には、commandsにあった空白や綴りがそのまま残っている。"

pub fn lambda -> String =
  "必要な場所で関数を作ることもできる。\\nameから始まるラムダは、空白を取ったラベルの長さを測る、その場だけの関数。mapへ渡すとArray<Int>ができる。一度しか使わない計算に、無理に名前を増やす必要はないよ。この長さはUnicode scalar数で、端末の表示幅とは別。"

pub fn section -> String =
  "演算子も関数値として渡せる。(+)は足し算のカリー化された関数。reduce 0 (+)が長さを足し合わせ、合計19を返す。こうして演算子を括弧で参照する書き方がoperator section。filter、map、reduceのように関数を受け取るものを、高階関数と呼ぶ。"

pub fn arrows -> String =
  "関数型の矢印は右側でまとまる。String -> String -> BoolはString -> (String -> Bool)の意味。関数を引数に取る場合は、(String -> Bool)のように括弧で一つの引数型を示す。これは言語の呼び出し規則で、最適化の結果たまたまこうなるわけではない。"

pub fn argumentTypes -> String =
  "引数は左から一つずつ渡し、その段階の引数型と照合する。最後の引数を渡すまでは、結果も関数。下の小さな整数例では同じ規則だけを取り出している。directとaddOne 2は、どちらも3になる。add (1, 2)なら一個のタプルを渡すので、二つのInt引数とは型も呼び方も違う。"

pub fn generic -> String =
  "多相な関数を部分適用すると、型引数やtraitの制約がまだ決まらずに残ることがある。残りの引数や結果を使う場所の型が、その情報を補う。最後に欲しい値だけで考えず、今どんな関数が残っているかを型表示で見てみよう。"

pub fn unit -> String =
  "引数名を書かない宣言もUnitを受け取る。fn answer -> Int = 42の型はUnit -> Int。answer ()で42を得るが、answerだけではまだ関数だ。宣言しただけで本体を実行することもない。"

pub fn rejected -> String =
  "ここでadd 1の型はInt -> Intだが、注釈が求めるのはIntなのでSES-T0101になる。値3が欲しければadd 1 2と残りを渡す。後で呼ぶ関数を残したいならlet addOne = add 1としよう。"

pub fn previousExit -> String = "：章の入口。keyの宣言と普通の呼び出しを確認する。"

pub fn nextExit -> String = "：次のページ。絞り込みと表示をつなぎ、見つからなかった場合も扱う。"

pub fn lambdaExit -> String = "：ラムダの引数とスコープを単独で調べる。"

pub fn annotationsExit -> String = "：関数を渡す引数の型を、どこに書くか調べる。"

pub fn genericExit -> String = "：部分適用後に残る型引数や制約を調べる。"

pub fn operatorExit -> String = "：演算子の参照と結合規則を調べる。"
