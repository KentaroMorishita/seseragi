import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Recursive declarations",
  summary: (explanation ()).summary,
  ruleTitle: "Make recursive scope explicit",
  ruleBody: "A named function or type declaration may refer to itself. Recursive functions require return annotations. Ordinary let is non-recursive. Mutually recursive functions appear in one rec group whose member names are visible throughout the group and after it, but not before it.",
  identityBody: "A local function's name is available in its own body and in code after its declaration. Declaring even before odd alone does not let even call odd. Placing both declarations in rec makes both names available in each body within the group.",
  checkingBody: "While checking a rec group, each function uses one consistent declared type. Its type parameters become reusable from outside the group after all members pass. For an ordinary pure fn, a call directly to the same function as its final operation does not grow the host stack with call count. Mutual recursion and calls followed by more work do not have that guarantee.",
  invalidTitle: "Source order still matters outside rec",
  invalidBody: "A normal let cannot read itself, an earlier local function cannot call a later sibling without rec, duplicate group names are rejected, and a mutually recursive return mismatch fails the whole group. Generalizing one member early is never used to make the group pass.",
  diagnosticsBody: "For an unresolved name, check declaration order and the rec group containing it. In deeply recursive code, also check whether the direct self call is really the final operation; the constant-stack guarantee does not apply otherwise.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can two local functions call each other?",
  summary: "Calling the same function or another function that calls back is recursion. Group mutually referring local functions in rec so an earlier declaration can refer to a later one.",
  reading: "even and odd inside isEven call each other while decreasing the number by one. At 0, even returns True and odd returns False, ending the recursion. rec { ... } makes both names available within both bodies.",
  result: "4 follows even 4, odd 3, even 2, odd 1 and even 0, producing True. 5 produces False. A negative input is first made positive as magnitude, so -4 also produces True. main prints these three results in order.",
}

pub fn readerCaption -> String =
  "Inspect mutual recursion with a stopping condition on small integers"

pub fn readerBridgeOne -> String =
  "A TypeScript function declaration can refer to another function declared later in the same function body. Ordinary local Seseragi declarations cannot yet refer to that later name; rec explicitly groups mutual references. Both languages still need a computation that progresses toward a stopping condition."

pub fn readerBridgeTwo -> String =
  "This is a small example for reading mutual references. Mutual recursion has no constant-stack guarantee, so it is unsuitable as a parity implementation for large integers. Distinguish it from the guarantee for an ordinary pure fn calling itself directly in tail position. ${...} inserts the Bool results as True or False display text."

pub fn readerInvalidCaption -> String = "Call a later local function without rec"

pub fn readerMistake -> String =
  "The first even body cannot resolve the later odd name and reports SES-N0001. Put both declarations in one rec group. Merely reversing their order leaves odd referring to the later even, so it does not solve mutual reference."

pub fn readerDetailNote -> String =
  "The detailed declaration-only example lacks the negative-to-magnitude conversion in the first complete program. Passing a negative number directly to that older example does not approach 0. Further rules retain local scope and the checking of recursive groups."

pub fn readerLegacyReading -> String =
  "even checks for zero, then calls odd with one less; odd does the opposite. The rec group makes both names visible in both bodies. For a nonnegative input, repeatedly subtracting one reaches the zero case."

pub fn readerLegacyResult -> String =
  "isEven 4 returns True. Subtracting one from a positive input eventually reaches the zero case; a negative input does not reach it. Mutual recursion also lacks the constant-stack guarantee of a direct self tail call."

pub fn readerRelated -> String =
  " reviews annotation positions, including result types required by recursive functions."
