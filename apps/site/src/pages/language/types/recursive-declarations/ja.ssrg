import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "再帰宣言",
  summary: (explanation ()).summary,
  ruleTitle: "互いを呼ぶ関数はrecでまとめる",
  ruleBody: "名前付きの関数とtypeは、自分自身の名前を使えます。再帰関数にも戻り値の型を書きます。通常のletは自分自身を参照できません。互いを呼ぶ関数は同じrecの中へまとめます。その関数名はグループの中全体と、その後のコードで使えます。",
  identityBody: "ローカル関数の名前は、その本体と宣言より後のコードで使えます。例えばevenを先に、oddを後に宣言しただけでは、evenからoddを呼べません。二つの宣言をrecへ入れると、グループ内のどちらの本体からも両方の名前を使えます。",
  checkingBody: "recの検査中は、各関数を宣言した一つの型で使います。全体の検査が済んだ後に、外から異なる型引数で使えるようになります。また、関数の最後の操作が自分自身の呼び出しなら、呼び出し回数に応じて実行環境のスタックを増やしません。互いを呼ぶ場合や呼び出し後に計算が残る場合には、この保証はありません。",
  invalidTitle: "後の関数を呼ぶ必要があれば、同じrecへ入れる",
  invalidBody: "letの初期値からそのlet自身を参照することはできません。前のローカル関数から後の関数を呼ぶにはrecが必要です。グループ内で同じ名前を重複させたり、戻り値の型を矛盾させたりした場合もエラーになります。",
  diagnosticsBody: "名前が見つからないエラーでは、宣言の順番とrecの範囲を確認してください。再帰の回数が多い計算では、直接の自己呼び出しが本当に最後の操作かも確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "二つの関数が互いを呼ぶには",
  summary: "ローカル関数が互いを呼ぶ場合は、recにまとめて宣言します。自分自身を呼ぶ関数と、letの初期値から自分を参照する場合は区別します。",
  reading: "例のevenは0かどうかを確認し、そうでなければ1減らしてoddを呼びます。oddも同様にevenを呼びます。recにまとめることで、両方の関数の本体から互いの名前を使えます。",
  result: "isEven 4はTrueです。正数を一つずつ減らすため、0の終了条件へ到達します。負数を渡すとこの終了条件へ進みません。また、互いを呼ぶ再帰には、直接の末尾自己呼び出しと同じスタック量の保証はありません。"
}
