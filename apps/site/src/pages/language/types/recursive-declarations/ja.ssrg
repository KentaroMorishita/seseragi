import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "再帰宣言",
  summary: (explanation ()).summary,
  ruleTitle: "互いを呼ぶ関数はrecでまとめる",
  ruleBody: "名前付きの関数とtypeは、自分自身の名前を使えます。再帰関数にも戻り値の型を書きます。通常のletは自分自身を参照できません。互いを呼ぶ関数は同じrecの中へまとめます。その関数名はグループの中全体と、その後のコードで使えます。",
  identityBody: "ローカル関数の名前は、その本体と宣言より後のコードで使えます。例えばevenを先に、oddを後に宣言しただけでは、evenからoddを呼べません。二つの宣言をrecへ入れると、グループ内のどちらの本体からも両方の名前を使えます。",
  checkingBody: "recの検査中は、各関数を宣言した一つの型で使います。全体の検査が済んだ後に、外から異なる型引数で使えるようになります。また、通常のfnで最後の操作が自分自身の直接の呼び出しなら、呼び出し回数に応じて実行環境のスタックを増やしません。互いを呼ぶ場合や呼び出し後に計算が残る場合には、この保証はありません。",
  invalidTitle: "後の関数を呼ぶ必要があれば、同じrecへ入れる",
  invalidBody: "letの初期値からそのlet自身を参照することはできません。前のローカル関数から後の関数を呼ぶにはrecが必要です。グループ内で同じ名前を重複させたり、戻り値の型を矛盾させたりした場合もエラーになります。",
  diagnosticsBody: "名前が見つからないエラーでは、宣言の順番とrecの範囲を確認してください。再帰の回数が多い計算では、直接の自己呼び出しが本当に最後の操作かも確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "二つのローカル関数を、互いの本体から呼ぶには",
  summary: "関数が自分や相手の関数を呼ぶ処理を再帰と呼びます。互いを参照するローカル関数はrecでまとめ、先に書いた関数から後の関数も使えるようにします。",
  reading: "isEvenの中のevenとoddは、数を一つ減らすたびに相手を呼びます。0になったらevenはTrue、oddはFalseを返して止まります。rec { ... }にまとめたため、どちらの本体からも両方の名前を使えます。",
  result: "4はeven 4、odd 3、even 2、odd 1、even 0と進むのでTrueです。5はFalseです。負の入力はmagnitudeで符号を反転してから調べるため、-4もTrueになります。mainはこの三つの結果を順に表示します。",
}

pub fn readerCaption -> String = "終了条件を持つ相互再帰で、小さい整数の偶奇を調べる"

pub fn readerBridgeOne -> String =
  "TypeScriptの関数宣言では、同じ関数内で後に宣言した関数を呼べる場合があります。Seseragiのローカル宣言は通常、後の関数をまだ参照できません。互いを呼ぶグループをrecで明示する点が違います。どちらでも、止まる条件へ進む処理が必要です。"

pub fn readerBridgeTwo -> String =
  "これは相互参照を読むための小さい例です。相互再帰には一定のスタック量で実行する保証がないので、大きな整数に対する偶奇判定の実装には向きません。通常のfnが自分自身を最後に直接呼ぶ再帰に対する保証と区別してください。BoolのTrue/Falseはshow相当の表示として${...}へ埋め込まれます。"

pub fn readerInvalidCaption -> String = "recなしで、まだ宣言していない相手を呼ぶ"

pub fn readerMistake -> String =
  "最初のevenの本体から後のoddを参照すると、名前を解決できずSES-N0001になります。両方を同じrecへ入れてください。単に順番を逆にしても、今度はoddから後のevenを参照するため、相互参照の問題は解決しません。"

pub fn readerDetailNote -> String =
  "詳細の宣言だけの例には、最初の完全な例にある負数からmagnitudeへの変換がありません。その例へ負数をそのまま渡すと0へ進まない点に注意してください。ローカルスコープと、再帰グループの型の検査も続けて確認できます。"

pub fn readerLegacyReading -> String =
  "例のevenは0かどうかを確認し、そうでなければ1減らしてoddを呼びます。oddも同様にevenを呼びます。recにまとめることで、両方の関数の本体から互いの名前を使えます。"

pub fn readerLegacyResult -> String =
  "isEven 4はTrueです。正数を一つずつ減らすため、0の終了条件へ到達します。負数を渡すとこの終了条件へ進みません。また、互いを呼ぶ再帰には、直接の末尾自己呼び出しと同じスタック量の保証はありません。"

pub fn readerRelated -> String = "では、再帰関数にも必要な戻り値の型を含め、型を書く位置を確認できます。"
