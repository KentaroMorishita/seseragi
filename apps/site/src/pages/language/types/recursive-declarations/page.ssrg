import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words,
  Paragraph,
  Terminal,
  Heading
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  typePage "language.types.recursive-declarations" "/docs/language/types/recursive-declarations/" (en.copy ()) (ja.copy ()) [
    CodeExample
      ("types-recursion", localized "A local mutually recursive group" "ブロック内で互いを呼ぶ関数"),
    BulletList [
      [Words (
        localized "All member names enter scope for the whole rec group."
      "recにまとめた宣言の名前は、同じrec全体から使えます。"
      )],
      [Words (
        localized "The group is monomorphic until every member checks."
      "同じrecの中の検査が終わるまでは、各関数に一つの型を使います。呼び出しごとに異なる型を選ぶことはできません。"
      )],
      [Words (
        localized
      "Only direct self tail calls in ordinary pure functions receive the synchronous constant host-stack guarantee."
      "通常のfnが自分自身を最後に直接呼ぶ再帰では、呼び出しの深さに応じてスタックが増えることはありません。この同期実行の保証は相互再帰にはありません。"
      )]
    ]
  ] [CodeExample (
    "types-invalid-recursion",
    localized "A forward reference outside rec" "recにまとめず、後の宣言を参照した場合"
  )] [
    [InternalLink (localized "Polymorphism" "多相性", "/docs/language/types/polymorphism/")],
    [InternalLink (
      localized "Annotations and inference" "型注釈と推論",
      "/docs/language/types/annotations-and-inference/"
    )],
    [InternalLink (
      localized "Function types and currying" "関数型とカリー化",
      "/docs/language/types/function-types-and-currying/"
    )]
  ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample
          ("type-limits-recursion", localized (en.readerCaption ()) (ja.readerCaption ())),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "True\nFalse\nTrue"),
        CodeExample (
          "type-limits-recursion-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Paragraph (
          [
            InternalLink (
              localized "Annotations and inference" "型注釈と推論",
              "/docs/language/types/annotations-and-inference/"
            ),
            Words (localized (en.readerRelated ()) (ja.readerRelated ()))
          ]
        ),
        Heading (
          "declaration-example",
          localized "Continue into the detailed rules" "詳しい規則と宣言例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
