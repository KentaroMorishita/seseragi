import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "letの多相性と使える範囲",
  summary: (explanation ()).summary,
  ruleTitle: "letに付けた関数名も、複数の型で使える場合がある",
  ruleBody: "例では、ジェネリック関数unchangedをlet identity = unchangedで別の名前に束縛しています。identity 42ではInt、identity \"hello\"ではStringを選べます。このように複数の型で使えることを多相性と呼び、letの名前にもその性質を持たせることを一般化と呼びます。周囲の値からすでに決まっている型は、一般化の対象になりません。",
  identityBody: "たとえば、関数が外側のIntの値を取り込んでいるなら、その値が別の呼び出しでStringになるわけではありません。trait制約を持つ関数は、使う型ごとに必要な実装を満たす必要があります。通常のletでは、右辺が単純な値か計算かという理由だけで一般化を制限しません。再帰する宣言は、再帰の途中では同じ型で検査し、その後に一般化します。",
  checkingBody: "すでにIntと決まった値を包む関数の結果はMaybe<Int>です。一般化によって、そのIntが任意の型に戻るわけではありません。また、関数引数として受け取るA -> AのAは、その呼び出しで選ばれた一つの型です。そのコールバックを、本体の中でInt用とString用に別々に使えるわけではありません。この範囲をrank-1と呼びます。",
  invalidTitle: "関数の引数が、それぞれ独立した多相性を持つわけではない",
  invalidBody: "関数の引数、レコードのフィールド、Arrayの要素には、使うたびに独立して型を選べる関数の型をそのまま書けません。forall A. A -> Aという表記は仕様を説明するためのもので、Seseragiのソース構文ではありません。そのようなコールバックが必要な場合は、一回の呼び出しでどの型を使うかが決まる形に設計し直します。",
  diagnosticsBody: "型が合わない場合は、その名前を複数の型で使えるのか、外側の値や引数によって一つの型に固定されているのかを確認してください。型を決める情報が足りなければ、型パラメーターや型注釈を明示します。現在のコンパイラで使える書き方については、このページの注意事項も確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "関数をletへ保存する場合と、引数として受け取る場合は同じか",
  summary: "generic関数への別名は、異なる型の呼び出しに使えます。一方、引数の(A -> A)は、その関数の一回の呼び出しで選ばれたAに対する操作です。",
  reading: "unchanged<A>は入力をそのまま返します。let identity = unchangedは関数を保存し、identity 42ではIntを選びます。applyのoperation: (A -> A)はAを受け取りAを返す関数で、apply identity \"ready\"ではAがStringになります。",
  result: "出力は42、ready、Just 42です。wrap 42は呼び出し済みのMaybe<Int>という値で、Justは中に値があるという選択肢です。let fixedで保存しても、中身が後からStringになるわけではありません。",
}

pub fn readerCaption -> String = "関数の別名、関数引数、呼び出し結果を使い分ける"

pub fn readerBridgeOne -> String =
  "TypeScriptでも関数を別の変数へ保存したり、コールバックとして渡したりできます。ここではapplyの外側で一つのAを宣言しています。その本体のoperationを呼ぶたびに、別々のAを選び直すという約束ではありません。"

pub fn readerBridgeTwo -> String =
  "このように、引数へ渡された関数が独立に型を選び直す仕組みを持たない範囲をrank-1と呼びます。最初から用語を覚えるより、applyのvalueとoperationが同じAを使う点を確認してください。mainは公開された出力の入口で、show fixedがMaybe<Int>を表示用の文字列にします。"

pub fn readerInvalidCaption -> String = "引数のAを、関数の本体で勝手にIntやStringに決める"

pub fn readerMistake -> String =
  "useTwice<A>のAは呼び出し側が選ぶ型です。その本体でoperation 42と書くと、任意のAにIntを渡せるとは限らずSES-T0101になります。operationを別々の型で使う代わりに、最初のapplyのように同じAの値も受け取って渡します。"

pub fn readerDetailNote -> String =
  "現在の実装では、let identity = \\value -> valueという短い関数の引数型を、周囲から型が分からない状態で推論できない制限が残っています。最初の例は型パラメーターを明示したfnを使います。仕様上のletの一般化と、この実装上の制限は区別してください。詳しい規則では、外側で既に決まった型や再帰の場合も扱います。"

pub fn readerLegacyReading -> String =
  "let identity = unchangedでは関数を保存するため、identity 42とidentity \"hello\"を別々の型で使えます。一方、let fixed = wrap 42は呼び出し済みのJust 42を保存し、その型はMaybe<Int>です。"

pub fn readerLegacyResult -> String =
  "identityはIntでもStringでも呼べますが、fixedはMaybe<Int>という一つの型の値です。また、関数の引数として受け取るA -> Aは、その呼び出しでAを一つ選びます。その引数を関数本体でInt用とString用に別々に使うことはできません。"

pub fn readerRelated -> String = "では、一回の呼び出しと別の呼び出しでAがどう決まるかを確認できます。"
