import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Let-polymorphism and rank",
  summary: (explanation ()).summary,
  ruleTitle: "Generalize the binding, instantiate each use",
  ruleBody: "At a non-recursive let binding, free type variables that do not occur in the surrounding environment become quantified variables in a type scheme. Every use instantiates those variables freshly. The example's identity is therefore usable at Int and String. Variables already fixed by the environment are not generalized: a closure does not forget the type of a value it captures.",
  identityBody: "Trait constraints mentioning generalized variables remain part of the scheme and must be satisfied at each use. Constraints involving only the environment remain attached to that environment. Normal let bindings have no value restriction because values are immutable and stateful computation is explicit. Recursive groups are checked monomorphically first and generalized only after the group is checked.",
  checkingBody: "Generalization does not undo a type already fixed by evaluation's static constraints. Applying a wrapper to 42 produces Maybe<Int>, not an arbitrary Maybe<A>. Seseragi supports rank-1 schemes at bindings. A function parameter typed A -> A uses the one A belonging to its enclosing declaration; it is not a function that can choose a new type independently for every call inside the body.",
  invalidTitle: "A generic binding is not a higher-rank value",
  invalidBody: "A polymorphic scheme cannot be placed inside a function parameter, record field or array element. forall A. A -> A is explanatory specification notation, not source syntax. If a callback must work at different concrete types, restructure the interface rather than assuming a parameter carries its own forall.",
  diagnosticsBody: "Read a hover's concrete type separately from the binding's scheme. A mismatch involving a captured value is not fixed by re-generalizing it. At a generic declaration, provide type parameters and constraints explicitly; at an ambiguous use, provide an annotation that actually supplies the missing type information.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Does storing a function in let fix its argument type?",
  summary: "An unchanged generic function can remain reusable at different types. A value produced by a particular call already has that call's type.",
  reading: "let identity = unchanged stores the function, so identity 42 and identity \"hello\" use Int and String separately. let fixed = wrap 42 instead stores Just 42, a Maybe<Int>; it is not the function wrap.",
  result: "This distinction does not make every function parameter automatically generic. A generic declaration names its type parameters. Passing a function that must itself work at many types involves additional limits described below."
}
