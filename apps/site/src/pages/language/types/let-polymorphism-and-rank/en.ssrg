import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Let-polymorphism and rank",
  summary: (explanation ()).summary,
  ruleTitle: "A function stored in let can remain usable at multiple types",
  ruleBody: "The example gives the generic function unchanged another name with let identity = unchanged. identity 42 uses Int, while identity \"hello\" uses String. This ability to use several types is polymorphism; preserving it on a let binding is generalization. A type already fixed by surrounding values is not generalized.",
  identityBody: "If a function captures an outer Int value, that value cannot become String on a later call. A function with a trait constraint needs the required implementation for each type used. An ordinary let can preserve polymorphism whether its right-hand side is a simple value or a computation. During recursive calls, a declaration is checked at one consistent type; generalization happens after those checks.",
  checkingBody: "Wrapping a value already known to be Int produces Maybe<Int>. Generalization does not turn that Int back into an arbitrary type. A function parameter typed A -> A uses the one A selected for that call. Its body cannot independently use that callback at Int and at String. This limitation is called rank-1 polymorphism.",
  invalidTitle: "Each function parameter does not carry independent polymorphism",
  invalidBody: "A parameter typed A -> A cannot choose a fresh A on each call inside the receiving function. The same limitation applies when storing functions in record fields or array elements. forall A. A -> A describes polymorphism in the specification, but forall is not Seseragi source syntax.",
  diagnosticsBody: "If a call fails because a captured value has a fixed type, a new let name will not change that type. Compare the types at the failing call. Declare type parameters and trait constraints on a generic function; if the compiler lacks information at a use, add a type annotation supplying the missing type.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Does storing a function in let fix its argument type?",
  summary: "An unchanged generic function can remain reusable at different types. A value produced by a particular call already has that call's type.",
  reading: "let identity = unchanged stores the function, so identity 42 and identity \"hello\" use Int and String separately. let fixed = wrap 42 instead stores Just 42, a Maybe<Int>; it is not the function wrap.",
  result: "identity can be called with Int or String, but fixed is a value of one type, Maybe<Int>. A parameter of type A -> A also has one A chosen for that call. The function body cannot independently call that parameter once at Int and once at String."
}
