import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Let-polymorphism and rank",
  summary: (explanation ()).summary,
  ruleTitle: "A function stored in let can remain usable at multiple types",
  ruleBody: "The example gives the generic function unchanged another name with let identity = unchanged. identity 42 uses Int, while identity \"hello\" uses String. This ability to use several types is polymorphism; preserving it on a let binding is generalization. A type already fixed by surrounding values is not generalized.",
  identityBody: "If a function captures an outer Int value, that value cannot become String on a later call. A function with a trait constraint needs the required implementation for each type used. An ordinary let can preserve polymorphism whether its right-hand side is a simple value or a computation. During recursive calls, a declaration is checked at one consistent type; generalization happens after those checks.",
  checkingBody: "Wrapping a value already known to be Int produces Maybe<Int>. Generalization does not turn that Int back into an arbitrary type. A function parameter typed A -> A uses the one A selected for that call. Its body cannot independently use that callback at Int and at String. This limitation is called rank-1 polymorphism.",
  invalidTitle: "Each function parameter does not carry independent polymorphism",
  invalidBody: "A parameter typed A -> A cannot choose a fresh A on each call inside the receiving function. The same limitation applies when storing functions in record fields or array elements. forall A. A -> A describes polymorphism in the specification, but forall is not Seseragi source syntax.",
  diagnosticsBody: "If a call fails because a captured value has a fixed type, a new let name will not change that type. Compare the types at the failing call. Declare type parameters and trait constraints on a generic function; if the compiler lacks information at a use, add a type annotation supplying the missing type.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Is storing a function in let the same as receiving it as an argument?",
  summary: "An alias for a generic function can be called at different types. A parameter written (A -> A), however, operates on the A selected for that enclosing function call.",
  reading: "unchanged<A> returns its input. let identity = unchanged stores the function, and identity 42 selects Int. operation: (A -> A) in apply is a function from A to the same A; apply identity \"ready\" selects String.",
  result: "The output is 42, ready and Just 42. wrap 42 is an already-computed Maybe<Int> value, with Just identifying a present payload. Storing it as fixed does not let that payload become String later.",
}

pub fn readerCaption -> String =
  "Distinguish a function alias, a function parameter and a computed result"

pub fn readerBridgeOne -> String =
  "TypeScript also lets you name a function again or pass it as a callback. Here one A is declared by apply itself. Its contract does not let operation choose a fresh A independently each time it is called inside that body."

pub fn readerBridgeTwo -> String =
  "The restriction that a received function cannot independently choose new types is called rank-1. Before learning the term, check that apply’s value and operation use the same A. main is the public output entry point; show fixed converts the Maybe<Int> value to display text."

pub fn readerInvalidCaption -> String =
  "Assume the parameter’s A is Int or String inside the function"

pub fn readerMistake -> String =
  "A in useTwice<A> is selected by the caller. operation 42 in its body reports SES-T0101 because an arbitrary A need not be Int. Instead of using operation at unrelated types, receive a value of the same A and pass it, as the first apply example does."

pub fn readerDetailNote -> String =
  "The current implementation still cannot infer the parameter in the short function let identity = \\value -> value when no surrounding type supplies it. The first example uses a named fn with explicit type parameters. Distinguish this implementation gap from the specified let-generalization rule. Further rules cover types already fixed by the surrounding environment and recursive declarations."

pub fn readerLegacyReading -> String =
  "let identity = unchanged stores the function, so identity 42 and identity \"hello\" use Int and String separately. let fixed = wrap 42 instead stores Just 42, a Maybe<Int>; it is not the function wrap."

pub fn readerLegacyResult -> String =
  "identity can be called with Int or String, but fixed is a value of one type, Maybe<Int>. A parameter of type A -> A also has one A chosen for that call. The function body cannot independently call that parameter once at Int and once at String."

pub fn readerRelated -> String =
  " reviews choosing A within one call and independently at other calls."
