import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "必要なサービスを組み合わせる",
  summary: (explanation ()).summary,
  ruleTitle: "複数の計算が必要とするサービスをまとめる",
  ruleBody: "コンソールを使う計算と時計を使う計算を組み合わせるなら、実行する環境には両方のサービスが必要です。EffectやStreamの第一の型引数に書くR & Sは、その必要なサービスの組み合わせを表します。R & {}は新しいサービスを加えないのでRと同じです。衝突がなければ、順序や括弧を変えても必要なサービスは変わりません。",
  identityBody: "R & Sは、処理に必要なサービスの型をまとめる指定です。実行時にレコードの値を結合する関数ではありません。同じ名前と型のフィールドは一つにまとまります。同名のフィールドが違う型を要求すると、一つのサービスでは両方を満たせないためSES-E0001になります。",
  checkingBody: "組み合わせられるのは、必要なサービスを必須フィールドで表したレコード型、またはそのような型を表す型パラメーターです。省略可能なフィールドを含むレコードや、名前付きのstruct、通常の値の型は使えません。プログラムの実行入口では、最終的に必要なサービスがすべて確定している必要があります。",
  invalidTitle: "&は、任意の型を組み合わせる構文ではない",
  invalidBody: "R & Sを使えるのは、EffectやStreamの必要なサービスを書く位置だけです。その他の型の位置で使うとSES-T0501になります。また、値の式で単独の&を演算子として使うことはできません。RやSは、サービスを表す完全なレコード型であり、レコードの一部だけを表す型ではありません。",
  diagnosticsBody: "SES-E0001では、衝突しているフィールド名と二つの型を見比べてください。SES-T0501では、&を書いた位置を確認します。型別名を使っている場合は、その定義もたどると、どの計算がサービスを追加しているか分かります。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "処理が必要とする二種類の設定を、一つの要求へまとめるには",
  summary: "ラベルを読むSettingsと、末尾の文字を読むThemeを必要とする処理を作ります。Effectの型では、必要なサービスのレコードを&で組み合わせられます。",
  reading: "SettingsとThemeは、外から渡す設定の型です。settingsOfとthemeOfは環境の対応するフィールドを読みます。greetingはwith Settings, Themeで両方を要求し、serviceで受け取った設定から文字列を作ります。",
  result: "Configured<R, A>は、Rにsettings: Settingsを足して要求するEffectの別名です。configuredの注釈ではRが{ theme: Theme }、AがStringなので、必要な環境は{ theme: Theme, settings: Settings }、失敗型はNever（通常の失敗がないことを表す型）、成功値はStringです。provideで両方を渡して実行するとHello!を表示します。",
}

pub fn readerCaption -> String = "二つのサービスを要求し、環境を渡して実行する"

pub fn readerBridgeOne -> String =
  "Effectは実行する処理を表す値です。doの<-は処理の成功値を次の行で使い、succeedは文字列を成功結果にします。Unit ->という注釈は、()を渡すとそのEffectを返す関数です。configured = greetingは関数に別名を付けるだけで、ここでは実行しません。"

pub fn readerBridgeTwo -> String =
  "provideは、この処理へ渡す環境の値を指定します。&は値を結合する操作ではなく、型の要求をまとめる指定です。TypeScriptのA & Bを普通のオブジェクト型へ使う場合とは、使える位置が異なります。ここではmainが設定を渡した処理を実行し、残るConsoleの出力機能はCLIが提供します。"

pub fn readerInvalidCaption -> String = "同じsettingsフィールドへ異なる型を要求する"

pub fn readerMistake -> String =
  "settingsにSettingsとThemeを同時に要求すると、同じフィールドの型が衝突してSES-E0001になります。二つの役割なら、最初の例のsettingsとthemeのように異なるフィールド名で要求してください。同じ名前と同じ型を二度要求する場合は、一つにまとまります。"

pub fn readerDetailNote -> String =
  "詳細のTimedは、既存の要求Rへclockを足す同じ考え方の宣言例です。その例だけでは時計を読みません。Eは失敗型、Aは成功値の型です。&をEffectやStreamの要求以外へ書いたときのSES-T0501や、空の要求との関係も確認できます。"

pub fn readerLegacyReading -> String =
  "Timed<R, E, A>は、Rに加えてClock型のclockを必要とするEffectの別名です。Eは回復可能な失敗、Aは成功値の型のままで、時計を追加しても変更されません。"

pub fn readerLegacyResult -> String =
  "Timedが要求するclockとRのclockは、同じ型でなければなりません。型が違えば、名前の衝突としてエラーになります。R & {}ならサービスを追加せず、Rだけの場合と同じ要求です。実行入口では、要求するフィールドをすべて確定させます。"

pub fn readerRelated -> String = "では、一つのサービスを要求して環境を渡す基本を確認できます。"
