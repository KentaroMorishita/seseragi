import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "ジェネリックimplとメソッド",
  summary: (explanation ()).summary,
  ruleTitle: "implの型引数は、メソッドを呼ぶ値から決まる",
  ruleBody: "impl<A> Box<A>はBoxにメソッドを追加します。Aは対象のBox<A>に含まれる型パラメーターです。Box<Int>の値からメソッドを呼ぶと、AはIntに決まります。getを呼ぶたびに別のAを選べるわけではありません。",
  identityBody: "メソッドはreplace<B>のBのように独自の型パラメーターを導入できます。それはそのメソッドに属し、implの他のメソッドに共有されません。外側のパラメーターを同名で隠すこともできません。例のreplaceは新しいBoxを作ってBox<B>を返し、元のBox<A>は変更しません。",
  checkingBody: "最初に、ドットの前の値とimplの対象型を照らし合わせます。その後でメソッドの引数と戻り値を検査します。number.replaceに文字列を渡すと、numberからAがInt、文字列からBがStringに決まります。結果は新しいBox<String>であり、元のBox<Int>のフィールドを書き換える操作ではありません。",
  invalidTitle: "対象型と無関係なimplパラメーターは置けない",
  invalidBody: "implで宣言した型パラメーターは、対象型に現れる必要があります。例えば、Box<Int>にimpl<A>を付けても、ドットの前の値からAを決められないため拒否されます。implのAをメソッドでもAとして再宣言することはできません。メソッド固有の型パラメーターにはBなど別の名前を使ってください。",
  diagnosticsBody: "まず、ドットの前の値がimplの対象型に合うかを確認します。次に、メソッド固有の引数や制約を確認します。implのメソッドは対象の名前付き型に属します。ジェネリックであっても、traitのinstanceを選ぶ仕組みに変わるわけではありません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "入れ物の型と、メソッドで作る結果の型を分けるには",
  summary: "整数のBoxから値を取り出す型はIntに決まっています。一方、新しい中身を渡して別のBoxを作るメソッドでは、その呼び出しの型を別に選べます。",
  reading: "struct Box<A>はA型のvalueを持つ名前付きの型です。impl<A> Box<A>は、その型に操作を追加します。getのselfはドットの前の値を受け取り、self.valueを返します。numberがBox<Int>なのでnumber.getはIntです。",
  result: "replace<B>のBはメソッド自身の型パラメーターです。number.replace \"ready\"ではBがStringとなり、新しいBox<String>を作ります。出力は43とready!で、元のnumberは整数42を持つBox<Int>のままです。",
}

pub fn readerCaption -> String = "入れ物の型を保つgetと、別の入れ物を作るreplace"

pub fn readerBridgeOne -> String =
  "getに追加の値引数はありません。selfをドットの前から渡すのでnumber.getと書き、()は付けません。replaceには新しい値を空白で渡します。Aは受け手のBoxから、Bは新しい引数から決まるため、この二つを同じ名前で再宣言しないでください。"

pub fn readerBridgeTwo -> String =
  "pub effect fn mainが公開された出力の入口です。number.get + 1は整数の加算、text.get + \"!\"は文字列の連結です。どちらもメソッドが返す型に合わせて検査し、${...}で表示用の文字列へ埋め込みます。"

pub fn readerInvalidCaption -> String = "Box<Int>のgetをStringとして受け取る"

pub fn readerMistake -> String =
  "number.getの結果はIntなので、let text: Stringに入れるとSES-T0101になります。整数ならIntとして受け取り、表示用の文字列ならshow number.getのように変換します。getの呼び出しだけで、受け手のBoxの型をStringへ変更することはできません。"

pub fn readerDetailNote -> String =
  "詳しい規則でも、受け手からimplのAを決めた後にメソッドのBを決めます。対象型に現れないimplパラメーターや、内側で同じ名前を宣言する場合の制限を確認できます。宣言だけの例にはmainがありません。"

pub fn readerComparison -> String =
  "TypeScriptでもclass Box<A>とメソッド固有の<B>で同じ関係を書けます。この例のreadonly valueは構築後に再代入しないフィールドです。replaceはthis.valueを書き換えずnew Box(value)を返します。両方の例が同じ二行を表示しますが、TypeScriptのget()とSeseragiのgetの呼び方は異なります。"

pub fn readerLegacyReading -> String =
  "numberはBox<Int>なので、impl<A> Box<A>のAはIntです。number.replace \"hello\"ではメソッドのBがStringになり、新しいBox<String>を作ります。selfはドットの前のnumberを受け取る引数です。"

pub fn readerLegacyResult -> String =
  "number.getはIntの42を返します。number.replace \"hello\"はStringを持つ新しいBoxを作り、元のnumberはBox<Int>のままです。implのAとメソッドのBは別々に決まる型を表します。"

pub fn readerRelated -> String = "では、Boxの中身の型を選び、新しい値を作る方法を確認できます。"
