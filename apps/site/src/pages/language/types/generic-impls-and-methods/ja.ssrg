import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "ジェネリックimplとメソッド",
  summary: "受け取る値によって決まるパラメーターと、一つのメソッドだけのパラメーターを分けます。",
  ruleTitle: "implのパラメーターはreceiverで決まる",
  ruleBody: "impl<A> Box<A>はBoxの各型適用にメソッドを付けます。Aはimplに属し、対象型に現れる必要があります。getを呼ぶたびに独立に選ぶ型ではありません。Box<Int>では、残りの引数を検査する前にreceiverからAがIntに決まります。",
  identityBody: "メソッドはreplace<B>のBのように独自の型パラメーターを導入できます。それはそのメソッドに属し、implの他のメソッドに共有されません。外側のパラメーターを同名で隠すこともできません。例のreplaceは新しいBoxを作ってBox<B>を返し、元のBox<A>は変更しません。",
  checkingBody: "推論はreceiverとimplの対象型を照合してimplのパラメーターを決め、その後に通常のジェネリック関数の規則でメソッド固有の型、値引数、期待型を検査します。number.replace \"hello\"ではnumberからA、文字列からBが決まり、結果はBox<String>です。これは明示的な変換操作で、変更可能なfieldや暗黙の型変換ではありません。",
  invalidTitle: "対象型と無関係なimplパラメーターは置けない",
  invalidBody: "implで宣言したパラメーターは対象型に現れる必要があります。無関係な具体型にimpl<A>を付けても、receiverからAを決められないため拒否されます。implのAが有効な場所でメソッドのAを再宣言することもできません。別の名前を使ってください。",
  diagnosticsBody: "receiverの不一致と、メソッドの引数の不一致を区別してください。まずreceiverが選ぶimplを確認し、その後にメソッド固有の制約を確認します。inherent methodはnominalな所有型に静的に関連付けられ、ジェネリックであってもtrait instanceによる選択にはなりません。",
}
