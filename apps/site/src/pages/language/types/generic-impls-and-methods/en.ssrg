import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Generic impls and methods",
  summary: (explanation ()).summary,
  ruleTitle: "The receiver determines the impl parameters",
  ruleBody: "impl<A> Box<A> attaches methods to every application of Box. A belongs to the impl and must occur in the target type; it is not a free choice made independently when calling get. For Box<Int>, the receiver fixes A to Int before the method's remaining parameters are checked.",
  identityBody: "A method can introduce its own parameters, such as B in replace<B>. They belong to that method, not to every other method in the impl. They must not shadow an enclosing parameter. The example's replace returns Box<B> by constructing a new Box; the original Box<A> remains unchanged.",
  checkingBody: "Inference first matches the receiver against the impl target to determine impl parameters. It then follows ordinary generic-function inference for method-local parameters, value arguments and the expected result. Calling number.replace \"hello\" fixes A from number and B from \"hello\", giving Box<String>. This is an explicit type-changing operation, not mutation or an implicit coercion.",
  invalidTitle: "An impl parameter cannot float free of its target",
  invalidBody: "An impl's declared type parameters must occur in its target type. For example, impl<A> for Box<Int> is rejected because the value before the dot cannot determine A. A method cannot redeclare the impl's A. Use another name, such as B, for a method's own type parameter.",
  diagnosticsBody: "Distinguish receiver mismatches from method-argument mismatches. First check which impl the receiver selects, then check the method's own constraints. Inherent methods are statically associated with nominal owners and do not acquire trait-instance dispatch merely because they are generic.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can a method distinguish its receiver’s type from the type of a new result?",
  summary: "Reading an integer Box produces Int. A method constructing another Box from a new payload can choose a separate type for that call.",
  reading: "struct Box<A> is a named type containing a value of A. impl<A> Box<A> adds operations to it. self in get receives the value before the dot and returns self.value. Since number is Box<Int>, number.get returns Int.",
  result: "B in replace<B> belongs to the method itself. number.replace \"ready\" chooses String for B and constructs a new Box<String>. The output is 43 and ready!, while number remains a Box<Int> containing 42.",
}

pub fn readerCaption -> String =
  "Read the existing payload or construct a Box with a new type"

pub fn readerBridgeOne -> String =
  "get has no additional value argument. Its self is supplied before the dot, so write number.get without (). replace takes its new value after a space. A comes from the receiver and B from the new argument; do not redeclare the same parameter name for both."

pub fn readerBridgeTwo -> String =
  "pub effect fn main is the public output entry point. number.get + 1 adds integers; text.get + \"!\" joins strings. Each operation is checked against its method’s result type, and ${...} inserts the values into display text."

pub fn readerInvalidCaption -> String = "Receive the get result of Box<Int> as String"

pub fn readerMistake -> String =
  "number.get returns Int, so assigning it to let text: String produces SES-T0101. Receive it as Int or use show number.get to convert it to display text. Calling get cannot change the receiver’s payload type to String."

pub fn readerDetailNote -> String =
  "The detailed rules determine the impl’s A from the receiver before determining the method’s B. They also explain why impl parameters must occur in the target and why nested parameters cannot reuse the same name. The declaration-only example has no main."

pub fn readerComparison -> String =
  "TypeScript can express the same relationship with class Box<A> and a method-specific <B>. readonly value cannot be reassigned after construction. replace returns new Box(value) without changing this.value. Both examples print the same two lines, although TypeScript calls get() and Seseragi calls get."

pub fn readerLegacyReading -> String =
  "number is Box<Int>, so A in impl<A> Box<A> is Int. In number.replace \"hello\", replace<B> selects B as String and constructs a new Box<String>. self names the original Box passed before the dot."

pub fn readerLegacyResult -> String =
  "number.get returns the Int value 42. number.replace \"hello\" constructs a new Box containing String; the original number remains Box<Int>. The impl's A and the method's B describe types determined separately."

pub fn readerRelated -> String =
  " reviews choosing a Box payload type and constructing another value."
