import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "ジェネリックなstruct",
  summary: "フィールドに格納する値の型を、型パラメーターで指定します。",
  ruleTitle: "フィールドの値から型引数を決める",
  ruleBody: "struct Box<A>は、型Aの値をフィールドに持つ構造体です。Box { value: 42 }なら、valueがIntなのでBox<Int>になります。Box<String> { value: \"hello\" }のように型引数を明示することもできます。フィールドの値、指定した型引数、周囲の型注釈は、すべて一致する必要があります。",
  identityBody: "Box<Int>のvalueはInt、Box<String>のvalueはStringとして扱います。フィールドを読むときも、値の型に決まった型引数を使います。Boxは名前付きの型なので、valueというフィールドを持つ普通のレコードが、そのままBoxとして使えるわけではありません。",
  checkingBody: "更新やspreadを使っても、元のstructの型引数は変わりません。Box<Int>のvalueを更新するなら、代わりの値もIntが必要です。結果もBox<Int>になります。また、値の型注釈に未確定の_を残すことはできません。",
  invalidTitle: "更新では、フィールドの型を変更できない",
  invalidBody: "Box<Int> { value: \"hello\" }は、IntとStringが一致しないため型エラーです。Box<Int>からBox<String>へ変えたい場合は、例のlabelのように値を変換し、新しいBoxを作ります。レコードの追加フィールドを許す規則によって、structの型引数を変えることもできません。",
  diagnosticsBody: "まず、更新・参照する値がBox<Int>なのかBox<String>なのかを確認してください。構築時に型引数を決められない場合は、型注釈か明示的な型引数を補います。異なる型のフィールドを持たせたい場合は、更新ではなく新しい値を構築します。",
  provenanceBody: "言語仕様2.15に基づきます。ページ内の例は公式コンパイラで検査しています。"
}
