import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  typePage "language.types.built-in-types" "/docs/language/types/built-in-types/" (en.copy ()) (ja.copy ()) [
    CodeExample
      ("syntax-literals", localized "Built-in values in canonical source" "組み込み型に対応する値"),
    BulletList [
      [
        InlineCode "Int",
        Words (
          localized " — exact safe integer, without negative zero."
      " — 正確に表せる範囲が決まった整数です。負のゼロはありません。"
        )
      ],
      [
        InlineCode "Float",
        Words (
          localized " — IEEE 754 binary64, including signed zero."
      " — IEEE 754の64ビット浮動小数点数です。正と負のゼロを区別します。"
        )
      ],
      [
        InlineCode "Char / String",
        Words (
          localized " — one Unicode scalar / an immutable scalar sequence."
      " — CharはUnicodeの符号位置一つ、Stringはその不変の列です。"
        )
      ],
      [
        InlineCode "Unit / Never",
        Words (localized " — one value / no values." " — 値一個 / 値なし。")
      ]
    ]
  ] [CodeExample (
    "syntax-invalid-numeric",
    localized "An invalid Int is not rounded" "Intの範囲外の値を丸めて受け取ることはない"
  )] [
    [InternalLink (localized "Literals" "リテラル", "/docs/language/syntax/literals/")],
    [InternalLink (
      localized "Character and string escapes" "文字と文字列のエスケープ",
      "/docs/language/syntax/character-string-escapes/"
    )],
    [InternalLink (localized "Type system" "型システム", "/docs/language/types/type-system/")]
  ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
