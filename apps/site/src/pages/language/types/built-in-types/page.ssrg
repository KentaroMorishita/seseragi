import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import { ReaderCopy } from "../../reader-article"
import * as guide from "./guide"
import { LocalizedText, localized } from "../../../../model/locale"
import {
  Article,
  Block,
  CodeExample,
  Heading,
  InternalLink,
  PageDefinition,
  Paragraph,
  Terminal,
  Words
} from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"

fn paragraph pair: (String, String) -> Block = match pair {
  (english, japanese) -> Paragraph ([Words (localized english japanese)])
}

fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  map paragraph (arrays.zip japanese english)

fn readingLink pair: ((LocalizedText, String), (String, String)) -> Block = match pair {
  ((title, path), (english, japanese)) -> Paragraph ([
    InternalLink (title, path),
    Words (localized (". " + english) ("。" + japanese))
  ])
}

fn content -> PageDefinition = {
  let english = en.copy ()
  let japanese = ja.copy ()
  let related = [
    (localized "Literals" "リテラル", "/docs/language/syntax/literals/"),
    (
      localized "Character and string escapes" "文字と文字列のエスケープ",
      "/docs/language/syntax/character-string-escapes/"
    ),
    (
      localized "Annotations and inference" "型注釈と推論",
      "/docs/language/types/annotations-and-inference/"
    ),
    (localized "Type system" "型システム", "/docs/language/types/type-system/")
  ]
  PageDefinition {
    id: "language.types.built-in-types",
    path: "/docs/language/types/built-in-types/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [CodeExample
          ("pilot-built-in-types", localized english.exampleTitle japanese.exampleTitle)],
      [Heading ("reading-the-example", localized "Read the product values" "商品の値と型を読む")],
      paragraphs english.reading japanese.reading,
      [Terminal (localized "Output" "実行結果", "Notebook: 3, 2.5, True")],
      [Heading
          ("why", localized "Distinguish integers from decimal values" "整数と小数を区別する")],
      paragraphs english.purpose japanese.purpose,
      [Heading (
        "rules",
        localized "Numeric limits, characters, and results without a payload"
          "数値の範囲、文字、返す内容のない結果"
      )],
      paragraphs english.rules japanese.rules,
      [Heading (
        "mistakes",
        localized "An annotation does not convert a number" "型を書いても数値は変換されない"
      )],
      paragraphs english.mistakes japanese.mistakes,
      [CodeExample
          ("pilot-built-in-types-invalid", localized "Rejected example" "受け付けられない例")],
      [Heading ("related-rules", localized "Find a specific answer" "必要なことを詳しく調べる")],
      map readingLink (arrays.zip (arrays.zip japanese.related english.related) related)
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
