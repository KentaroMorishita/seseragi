import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Built-in types",
  summary: "Int, Float, Bool, Char, String, Unit, and Never each have one exact value domain and no implicit numeric conversion.",
  ruleTitle: "Seven primitive value meanings",
  ruleBody: "Int is an exact safe integer from -9007199254740991 through 9007199254740991. Float is IEEE 754 binary64. Bool contains True and False; Char is one Unicode scalar; String is an immutable scalar sequence; Unit contains only (); Never contains no values.",
  identityBody: "Int has no negative zero. Float may preserve negative zero and follows binary64 representation. Unit represents a completed computation with one ordinary value, while Never represents a computation that cannot return a value, so the two are not interchangeable.",
  checkingBody: "Literal syntax determines Int or Float directly rather than through overloaded numeric literals. There is no implicit Int-to-Float, Float-to-Int, or Int-to-BigInt conversion. Never alone may coerce into a demanded type because no value crosses that boundary.",
  invalidTitle: "Similar host representations do not merge types",
  invalidBody: "A backend number representation does not make Int and Float interchangeable. A multi-scalar character is not Char, Unit is not an empty record or Never, and out-of-safe-range Int spelling is rejected rather than rounded or wrapped.",
  diagnosticsBody: "Literal diagnostics validate spelling, scalar count, range, Float overflow, and escapes before later type checking. Arithmetic leaving the Int safe range is a runtime defect; tools display the Seseragi type rather than a backend storage type.",
  provenanceBody: "This article covers specification section 2.2 and relies on the literal and escape rules in section 1.2. Its valid and rejected panels are focused documentation examples checked during the site build."
}
