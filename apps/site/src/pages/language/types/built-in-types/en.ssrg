import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Built-in types",
  summary: (explanation ()).summary,
  purpose: [
    "TypeScript normally uses number for both integers and decimal values. Seseragi treats Int and Float as separate types. A function expecting an integer quantity can reject a decimal value or a string by checking its type.",
    "3 and 3.0 can describe the same quantity, but the former is Int and the latter Float. They are not converted automatically to suit a required type. Use an explicit standard-library conversion when an integer must take part in floating-point calculations."
  ],
  exampleTitle: "Name and display four kinds of value",
  reading: [
    "An integer spelling such as 3 is Int. A decimal point or exponent makes 2.5, 3.0, and 1e3 Float values. Bool’s True and False start with capital letters. These ways of writing values directly in source are called literals.",
    "The final pub effect fn main is the entry point. pub exposes it; effect fn returns an Effect describing the output, which the runner executes. println writes text and a newline. Backticks create a string with inserted values; ${name} and the other placeholders insert each value’s display."
  ],
  rules: [
    "Int represents exact integers from -9007199254740991 through 9007199254740991, the same range as TypeScript’s safe integers. It has no negative zero. An out-of-range integer literal is rejected rather than rounded or wrapped. Arithmetic that leaves this range during execution stops with a defect, not a recoverable failure.",
    "Float is IEEE 754 binary64 floating point. It distinguishes positive and negative zero and cannot represent every decimal exactly. There are no implicit conversions between Int, Float, and the large-integer type BigInt. Similar storage representations in a runtime do not merge the language’s types.",
    "Char uses single quotes, as in 'a', and holds one Unicode scalar value. A scalar is a Unicode unit for representing text; one visible character need not contain just one scalar. String is an immutable sequence of scalars. Reading literals also checks character count, escapes, numeric range, and Float overflow.",
    "Unit represents normal completion without a payload; its only value is (). It is different from the empty record {}. Never has no values and describes a computation that cannot return normally. A computation returning () does not have result type Never.",
    "A Never expression can appear where another type is required because it never returns a value. This is not a facility for converting numbers or other values. Tools display Seseragi types such as Int and Float rather than runtime storage types."
  ],
  mistakes: ["The : Float below is an annotation requiring Float. But 3 is Int, so SES-T0101 reports expected Float and actual Int. To write a Float directly, use 3.0. To convert an existing Int, write import { fromInt } from \"std/float\" at the start of the file. This imports the conversion function from the standard library; fromInt 3 returns the Float 3.0."],
  related: [
    "Look up the detailed spellings for numeric and text values.",
    "Find how to include newlines and quotation marks in text.",
    "Find where to write types on names and functions.",
    "Read the broader rules of type checking."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Which types describe quantity, price, and availability?",
  summary: "A product has a quantity, a price, availability, and a name. Here Int represents an integer, Float a decimal value, Bool a truth value, and String text.",
  reading: "let names the value on its right. quantity’s 3 is Int; price’s 2.5 is Float. inStock’s True is Bool, whose other value is False. \"Notebook\", enclosed in double quotes, is String.",
  result: "The written values determine these types even without annotations. The final line inserts the four values into text and prints Notebook: 3, 2.5, True. Names such as quantity and price do not determine their types."
}

pub fn title -> String = (copy ()).title
