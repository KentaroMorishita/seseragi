import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "組み込み型",
  summary: "Int、Float、Bool、Char、String、Unit、Neverには、それぞれ正確な値の範囲があります。",
  ruleTitle: "七つの型が表す値",
  ruleBody: "Intは-9007199254740991から9007199254740991の整数、Floatは64ビットの浮動小数点数です。BoolはTrueとFalse、CharはUnicodeスカラー値一個、Stringはその列を表します。Unitの値は()だけです。Neverは値を一つも持たず、正常に値を返さない計算を表します。",
  identityBody: "Intに負の0はありませんが、Floatにはあります。Unitは処理が完了したときに返せる通常の値です。Neverは値を返さないことを示すため、Unitとは違います。",
  checkingBody: "整数と小数の書き方でIntかFloatが決まります。必要な型に合わせて自動でInt・Float・BigIntの間を変換することはありません。Neverの式は実際の値を返さないため、別の型の値を求める場所でも使えます。",
  invalidTitle: "似た数値や文字でも型を区別する",
  invalidBody: "IntとFloatは別の型です。複数のUnicodeスカラー値から成る文字列はCharではありません。Unitは空のレコード{}でもNeverでもありません。Intの範囲外の数値を、自動で丸めて受け付けることもありません。",
  diagnosticsBody: "数値や文字リテラルの範囲、Charの中身の個数、エスケープの書き方を、実行前に検査します。ただし、実行中のIntの計算で範囲を超える場合は、回復可能な失敗ではなく欠陥として停止します。",
}
