import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Type system",
  summary: (explanation ()).summary,
  ruleTitle: "Static types before execution",
  ruleBody: "Passing String to a function that accepts Int produces a type error before execution. The compiler checks every expression's arguments, results, and operations. Where an annotation can be omitted, values and their uses determine the inferred type. Unresolved or conflicting types prevent execution.",
  identityBody: "Named types such as structs and newtypes are distinct when declared separately, even if their values have the same shape. Record types instead depend on field names and types. The related page on nominal and structural types explains this distinction in more detail.",
  checkingBody: "Type inference compares the type known from a value, the type required by a function parameter, and any written annotation. A trait constraint also requires a matching implementation. Add an annotation when information is missing; an annotation cannot make a conflicting value valid.",
  invalidTitle: "Type inference does not choose a type by inspecting runtime values",
  invalidBody: "Types are determined while checking the source. For example, assigning String to a binding annotated Int is rejected before execution. Adding an annotation does not resolve a conflict with the value's type. Correct the value or operation, or write the necessary conversion explicitly.",
  diagnosticsBody: "Read the expected type, actual type, and source location in the error. Correct wrongly passed arguments, or add an annotation if information is missing. For a missing trait implementation, check whether the selected type provides the required operation.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "When is a wrong function argument caught?",
  summary: "Passing text to a function that requires an integer is a type error before execution. Start with the inputs and result of an ordinary calculation.",
  reading: "lineTotal takes an integer unitPrice and quantity, and returns their integer product. Each -> continues to the next parameter or result type. lineTotal 400 3 passes arguments separated by spaces and produces 1200.",
  result: "let total names that result. Running main prints 1200 on one line. The type checker verifies the types of both arguments and the returned value.",
}

pub fn readerCaption -> String = "Calculate a total from an integer price and quantity"

pub fn readerBridgeOne -> String =
  "TypeScript also rejects a string passed to a function parameter annotated number. Seseragi uses Int for integers and a separate Float type for fractional numbers. An annotation does not convert the supplied value."

pub fn readerBridgeTwo -> String =
  "pub effect fn main is the public execution entry point. println writes a string and a newline; show total converts the integer to display text. Passing type checking does not prove that the formula implements the business rule, so test concrete inputs and results too."

pub fn readerInvalidCaption -> String = "Pass a text price where an integer is required"

pub fn readerMistake -> String =
  "\"400\" is a String containing digits. SES-T0101 identifies the required Int and the supplied String. Remove the quotes to use 400 here. If text arrives from outside the program, parsing an integer and handling a possible parsing failure are separate steps."

pub fn readerDetailNote -> String =
  "The detailed Player declaration uses Score to distinguish a score from an integer, and Bronze, Silver or Gold as three named alternatives. That declaration-only example has no main; use the first complete example to run this page."

pub fn readerLegacyReading -> String =
  "Player groups a name, a Score, and a Rank. Score is a distinct wrapper around Int; Rank permits only Bronze, Silver, or Gold. The player value supplies a String, Score 42, and Gold in the appropriate fields."

pub fn readerLegacyResult -> String =
  "Player accepts Score 42 for score and Gold for rank. Passing the raw integer 42 as score or arbitrary text as rank is a type error. Named types distinguish purposes even when the values have similar representations."

pub fn readerRelated -> String = " explains where to annotate functions and values."
