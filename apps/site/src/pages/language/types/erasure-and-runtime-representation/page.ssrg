import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  typePage "language.types.erasure-and-runtime-representation" "/docs/language/types/erasure-and-runtime-representation/" (en.copy ()) (ja.copy ()) [CodeExample
      ("types-erasure", localized "Erasure and runtime representation" "型消去と実行時表現")] [] [
        [InternalLink (
          localized "Backend-independent semantics" "生成先に依存しない意味",
          "/docs/language/model/backend-independent-semantics/"
        )],
        [InternalLink (
          localized "Newtype identity and representation" "newtypeによる型の区別",
          "/docs/language/types/newtypes/"
        )],
        [InternalLink (localized "Traits" "traitとは", "/docs/language/traits/model/")]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
