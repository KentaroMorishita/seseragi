import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  typePage "language.types.erasure-and-runtime-representation" "/docs/language/types/erasure-and-runtime-representation/" (en.copy ()) (ja.copy ()) [CodeExample
      ("types-erasure", localized "Erasure and runtime representation" "型消去と実行時表現")] [] [
        [InternalLink (
          localized "Backend-independent semantics" "生成先に依存しない意味",
          "/docs/language/model/backend-independent-semantics/"
        )],
        [InternalLink (
          localized "Newtype identity and representation" "newtypeによる型の区別",
          "/docs/language/types/newtypes/"
        )],
        [InternalLink (localized "Traits" "traitとは", "/docs/language/traits/model/")]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample
          ("type-limits-erasure", localized (en.readerCaption ()) (ja.readerCaption ())),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "43\nready!"),
        CodeExample (
          "type-limits-erasure-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Paragraph (
          [
            InternalLink (
              localized "Generic functions" "ジェネリック関数",
              "/docs/language/types/generic-functions/"
            ),
            Words (localized (en.readerRelated ()) (ja.readerRelated ()))
          ]
        ),
        Heading (
          "declaration-example",
          localized "Continue into the detailed rules" "詳しい規則と宣言例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
