import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "型消去と実行時表現",
  summary: (explanation ()).summary,
  ruleTitle: "型引数は実行時の値ではない",
  ruleBody: "identity<A>のAは型検査のための情報です。関数本体からAを値として比較したり表示したりはできません。同じ関数は、IntでもStringでも受け取った値を返します。Aの中身を実行時に調べて分岐する構文はありません。",
  identityBody: "コンパイラは型引数を生成コードから省く場合も、型ごとのコードを作る場合もあります。ただし、ジェネリック構文だけで特定のメモリ配置や割り当て回数を保証するわけではありません。利用側は、関数の宣言した処理結果に基づいてコードを書きます。",
  checkingBody: "生成コードを最適化しても、返す値、計算順、型付きの失敗、キャンセル、リソースの寿命は保たれます。newtypeの実行時の包みを省く場合でも、ソース上で別の型であることは変わりません。型別名は、最適化の有無にかかわらず元の型と同じです。",
  invalidTitle: "抽象的な型を実行時に調べて分岐しない",
  invalidBody: "Aという型パラメーターを宣言しただけでは、Aを実行時に比較・表示できません。型ごとに共通の操作を呼ぶならtraitを使います。実行時に選択肢を見て分岐するなら、ADTの値をmatchで調べます。",
  diagnosticsBody: "型引数を値として使うエラーが出たら、その値で実際に行いたい操作を明らかにしてください。性能を測る場合は、測定したコンパイラと生成先の結果を記録します。ジェネリックであることだけで、追加の割り当てがないとは言えません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "ジェネリック関数の中で型引数を調べられるか",
  summary: "型パラメーターはコンパイル時の検査に使います。実行中にその型を調べて処理を分けるための値ではありません。",
  reading: "例のidentity<A>は、AがIntでもStringでも引数をそのまま返します。二つの呼び出しの戻り値はそれぞれの型を保ちます。関数の中に、表示や比較のできるAという値があるわけではありません。",
  result: "値を表示するような操作が必要なら、trait制約でその操作を要求します。値が持つ選択肢によって分けるなら、代数的データ型とmatchを使います。型引数を実行時に調べる必要はありません。"
}
