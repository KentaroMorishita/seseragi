import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Erasure and runtime representation",
  summary: (explanation ()).summary,
  ruleTitle: "Type arguments are not runtime values",
  ruleBody: "In identity<A>, A is part of the static contract, not a value available inside the function. The same body returns its argument at Int and String. There is no typecase that branches on A, no reflection over the selected parameter and no implicit runtime specialization selected by source-level type information.",
  identityBody: "A backend can erase arguments or monomorphize an implementation. Neither strategy is a language-level guarantee about memory layout, allocation or function identity. The source program may depend on the declared semantics, but cannot inspect which compiler strategy was chosen.",
  checkingBody: "Optimization preserves returned values, evaluation order, recoverable failure, cancellation, and resource lifetime. Omitting a newtype wrapper at runtime preserves the source-level type distinction. A type alias remains the same type as its definition, with or without optimization. Trait implementation selection and the number of argument evaluations must remain unchanged.",
  invalidTitle: "Do not branch on an abstract type at runtime",
  invalidBody: "A cannot be compared, printed or inspected as a value merely because it appears in a parameter list. If behavior depends on a capability, declare a trait constraint; if it depends on a finite set of runtime cases, use an ADT and match its value. Neither mechanism is hidden type reflection.",
  diagnosticsBody: "Type checking validates generic calls before backend lowering. When profiling generated code, distinguish an observed backend layout from a portable language contract. Performance documentation describes costs explicitly; generic syntax alone does not promise zero allocation or one specialization per type.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Can a function use its type parameter A as a value?",
  summary: "A type parameter names a relationship checked between inputs and results. It is not passed in as a runtime value that can be printed or compared.",
  reading: "A in keep<A> is chosen at the call: Int for keep 42 and String for keep \"ready\". The function returns its input value unchanged. value is the actual input; A appears only in type positions.",
  result: "number is an Int, so adding 1 is valid. text is a String, so it can be joined with \"!\". main prints 43 and ready!. The body of keep can return both inputs without inspecting their types at runtime.",
}

pub fn readerCaption -> String = "Return the supplied value while preserving its type"

pub fn readerBridgeOne -> String =
  "In TypeScript too, a generic function’s type parameter A does not become a runtime variable. JavaScript typeof examines an actual value, not the type parameter itself. In Seseragi, decide what to display or branch on using actual values or explicitly represented alternatives."

pub fn readerBridgeTwo -> String =
  "pub effect fn main is the public execution entry point. ${...} inserts calculated values into a backtick string, \\n separates the lines, and println displays them. The compiler decides how to represent type information in generated code. This example does not promise a particular memory layout or zero additional allocations."

pub fn readerInvalidCaption -> String = "Use the type name A as the returned value"

pub fn readerMistake -> String =
  "Writing = A reports SES-N0001 because no value named A is defined. Use = value to return the input. If different types need a common operation such as displaying, pass that operation as a function or require it through a trait. Returning a type name as a value does not provide the operation."

pub fn readerDetailNote -> String =
  "The detailed identity declaration also preserves its input type. Show<A> requires an operation that displays A; it does not inspect the type parameter at runtime. The further rules retain the observable results and ordering that optimizations must preserve."

pub fn readerLegacyReading -> String =
  "identity<A> returns its input without needing to know whether A is Int or String. The two calls keep their respective result types. There is no value named A for the function to print or compare."

pub fn readerLegacyResult -> String =
  "To display a value, require the operation through a trait constraint such as Show<A>. To branch on an alternative stored in a value, match an algebraic data type. The type parameter A itself cannot be compared at runtime."

pub fn readerRelated -> String =
  " reviews functions that preserve their input/result type relationship."
