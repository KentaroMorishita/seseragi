import * as arrays from "std/array"
import { localized } from "../../../model/locale"
import {
  Article,
  Block,
  BulletList,
  Callout,
  CommonMistake,
  Heading,
  Inline,
  PageDefinition,
  Paragraph,
  Words
} from "../../../model/page"

pub struct TypeCopy {
  title: String,
  summary: String,
  ruleTitle: String,
  ruleBody: String,
  identityBody: String,
  checkingBody: String,
  invalidTitle: String,
  invalidBody: String,
  diagnosticsBody: String,
}

fn blocks english: TypeCopy
  -> japanese: TypeCopy
  -> ruleDetails: Array<Block>
  -> invalidDetails: Array<Block>
  -> related: Array<Array<Inline>>
  -> Array<Block> =
  arrays.concat [
    [
      Heading ("rule", localized english.ruleTitle japanese.ruleTitle),
      Paragraph ([Words (localized english.ruleBody japanese.ruleBody)])
    ],
    ruleDetails,
    [
      Heading (
        "identity-and-representation",
        localized "What the type distinguishes" "この型が区別するもの"
      ),
      Paragraph ([Words (localized english.identityBody japanese.identityBody)]),
      Heading (
        "checking-and-inference",
        localized "How the compiler checks the type" "型をどう検査するか"
      ),
      Paragraph ([Words (localized english.checkingBody japanese.checkingBody)]),
      Callout (
        CommonMistake,
        localized english.invalidTitle japanese.invalidTitle,
        [Words (localized english.invalidBody japanese.invalidBody)]
      )
    ],
    invalidDetails,
    [
      Heading ("diagnostics", localized "When an error is reported" "エラーが出たときに確認すること"),
      Paragraph ([Words (localized english.diagnosticsBody japanese.diagnosticsBody)]),
      Heading ("related-rules", localized "Related rules" "関連する規則"),
      BulletList related
    ]
  ]

pub fn typePage id: String
  -> path: String
  -> english: TypeCopy
  -> japanese: TypeCopy
  -> ruleDetails: Array<Block>
  -> invalidDetails: Array<Block>
  -> related: Array<Array<Inline>>
  -> PageDefinition =
  PageDefinition {
    id,
    path,
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: blocks english japanese ruleDetails invalidDetails related
  }
