import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Generic aliases",
  summary: (explanation ()).summary,
  ruleTitle: "An alias names an existing type",
  ruleBody: "alias Pair<A> = (A, A) abbreviates a type expression. Pair<Int> and (Int, Int) have the same type identity; no constructor or extraction step is needed. Expanding an alias substitutes its arguments without capturing unrelated parameters. The example's first function accepts a tuple directly through its Pair annotation.",
  identityBody: "Type checking expands an alias, so Pair<Int> and (Int, Int) are the same type. Diagnostics may display an alias name for readability. Use newtype when you need the type checker to distinguish uses such as UserId and OrderId, even if both contain Int.",
  checkingBody: "Arity and kinds are checked wherever an alias appears, including parameter types, local annotations, lambda annotations and constraints. Constructor-kinded parameters also follow the ordinary kind rules. An alias cannot hide a wrong constructor shape. Direct and indirect alias cycles are rejected; expansion must terminate at a meaningful type.",
  invalidTitle: "An alias is not a constructor or an API privacy escape",
  invalidBody: "Pair 1 2 is not a value construction. Write the tuple value. A private alias cannot be imported, and a public alias's expanded type must not expose a private type. Changing the visible spelling does not make a private representation public or compatible with a different nominal type.",
  diagnosticsBody: "For an alias error, expand it mentally one layer at a time and verify every argument. Tooling may show the friendly alias while checking its expanded type. Resolve cycles by choosing an actual nominal recursive data declaration, not by adding another transparent alias around the cycle.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can one name describe records with different payload types?",
  summary: "A labelled number and a labelled string can share a field layout without repeating its definition. alias gives an existing type a name.",
  reading: "A in Named<A> is a place for a type chosen when the alias is used, called a type parameter. Named<Int> is the same type as { label: String, value: Int }; Named<String> is the same as { label: String, value: String }.",
  result: "readValue declares its own A and returns the value field of Named<A> as that same A. It obtains the integer 42 from count and the string ready from state, then prints them in that order.",
}

pub fn readerCaption -> String = "Use one alias for labelled numbers and strings"

pub fn readerBridgeOne -> String =
  "Create values with ordinary { ... } records. Named does not introduce a value constructor or wrap the record. Giving a shape a short alias also does not make two kinds of ID distinct types."

pub fn readerBridgeTwo -> String =
  "main is the public output entry point. ${readValue count} inserts the result of a space-separated function call into the string. \\n separates the lines, and println adds the final newline."

pub fn readerInvalidCaption -> String = "Put text in the value field of Named<Int>"

pub fn readerMistake -> String =
  "Expanding Named<Int> requires an Int value. Supplying \"42\" produces SES-T0101. Use 42 for a number, or Named<String> if the field should store text. Naming the type does not change its field checks."

pub fn readerDetailNote -> String =
  "The detailed Pair<A> = (A, A) alias names a tuple with two positions of the same type. (42, 7) creates it; (left, _) extracts its first position and ignores the second. This is a declaration-only example, unlike the first example with main."

pub fn readerComparison -> String =
  "TypeScript can perform the same task with a type Named<A> alias and a generic function. Choosing number or string for A follows the same idea. Both examples use the safe integer 42 and print the same two lines."

pub fn readerLegacyReading -> String =
  "Pair<A> means (A, A). Pair<Int> therefore means (Int, Int), and first (42, 7) passes an ordinary tuple. The pattern (left, _) extracts 42 and ignores the second element."

pub fn readerLegacyResult -> String =
  "first (42, 7) returns the Int value 42. Pair is another name for the tuple type. Construct a value as (42, 7), not Pair 42 7. Use newtype if different uses require distinct types."

pub fn readerRelated -> String =
  " explains how to distinguish IDs by purpose instead of merely naming their types."
