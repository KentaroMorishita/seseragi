import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  typePage "language.types.generic-aliases" "/docs/language/types/generic-aliases/" (en.copy ()) (ja.copy ()) [CodeExample
      ("types-generic-aliases", localized "Generic aliases" "ジェネリックalias")] [CodeExample
      ("types-generic-alias-invalid", localized "Rejected type mismatch" "拒否される型の不一致")] [
        [InternalLink
      (localized "Type constructors" "型構築子", "/docs/language/types/type-constructors/")],
        [InternalLink (
          localized "Kinds and type constructors" "型の形を表すkind",
          "/docs/language/types/kinds/"
        )],
        [InternalLink (
          localized "Type identity and coercion" "型の同一性と型変換",
          "/docs/language/types/type-identity-and-coercion/"
        )]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
