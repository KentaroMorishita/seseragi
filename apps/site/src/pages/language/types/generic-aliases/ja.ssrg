import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "ジェネリックalias",
  summary: "型式に読みやすい名前を付けます。新しい型の同一性や実行時ラッパーは作りません。",
  ruleTitle: "aliasは既存の型に名前を付ける",
  ruleBody: "alias Pair<A> = (A, A)は型式の略記です。Pair<Int>と(Int, Int)は同じ型で、構築や取り出しの操作は不要です。aliasの展開では、無関係なパラメーターを捕捉しないように引数を代入します。例のfirstはPairという注釈を通して、タプルを直接受け取ります。",
  identityBody: "aliasは型検査で透明に扱い、正規化後に消去できます。ツールは署名を読みやすくするためにalias名とソース位置を残せますが、その表示によってnominalな境界が生まれるわけではありません。短い名前ではなく別のドメイン型が必要ならnewtypeを使ってください。",
  checkingBody: "引数個数とkindは、引数の型、ローカル注釈、ラムダの注釈、制約など、aliasを使うすべての位置で検査します。型構築子を受け取るパラメーターにも通常のkind規則を適用します。aliasで誤った構築子の形を隠すことはできません。直接・間接の循環aliasは拒否され、展開は意味のある型に到達する必要があります。",
  invalidTitle: "aliasはコンストラクターでも公開範囲の抜け道でもない",
  invalidBody: "Pair 1 2は値の構築ではありません。タプルの値を書いてください。privateなaliasはimportできず、公開aliasを展開した型からprivate型が漏れてはいけません。見える名前を変えても、privateな表現が公開されたり、別のnominal型と互換になったりはしません。",
  diagnosticsBody: "aliasのエラーでは一段ずつ展開し、各引数を確認してください。ツールが読みやすいalias名を表示していても、検査は展開した型を使います。循環が必要なデータにはnominalな再帰型を使い、循環aliasを別のaliasで包んで回避しようとしないでください。",
  provenanceBody: "言語仕様2.17に基づく規則です。表示する短い例はこのリファレンス専用に管理し、公式コンパイラで検査しています。Tourのレッスンではありません。"
}
