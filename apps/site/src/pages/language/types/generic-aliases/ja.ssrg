import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "ジェネリックな型別名",
  summary: (explanation ()).summary,
  ruleTitle: "aliasは新しい型ではなく、型の別名を作る",
  ruleBody: "alias Pair<A> = (A, A)と書くと、Pair<Int>を(Int, Int)の代わりに使えます。この二つは同じ型です。値を包んだり取り出したりする操作は必要ありません。例のfirstも、Pairという型注釈を使いながら、普通のタプルを直接受け取ります。",
  identityBody: "型検査では別名の定義を展開するため、Pair<Int>と(Int, Int)は同じ型です。エラーメッセージなどでは読みやすさのために別名が表示されることがあります。同じIntを使うUserIdとOrderIdのように、用途の違いを型で区別したい場合はnewtypeを使います。",
  checkingBody: "型別名にも、必要な型引数の数や、各引数に何を渡せるかという規則があります。関数の引数、ローカルの型注釈、ラムダの型注釈など、どの位置で使っても検査されます。また、別名をたどると元の別名に戻ってしまう直接・間接の循環は認められません。",
  invalidTitle: "型の別名は、値を作るコンストラクターではない",
  invalidBody: "Pair 1 2と書いてもタプルを作ることはできません。値は(1, 2)のように書きます。非公開の型別名はimportできず、公開する型別名の定義から非公開の型を露出させることもできません。別名にするだけでは公開範囲や型の互換性は変わりません。",
  diagnosticsBody: "型別名のエラーでは、その定義をたどり、実際にどの型と型引数へ展開されるかを確認してください。再帰的なデータを表したい場合は、循環するaliasではなく、再帰的なADTなどを使います。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "中身の型だけ違うレコードに、共通の名前を付けるには",
  summary: "ラベル付きの数や文字列を扱うとき、共通のフィールド構成を繰り返し書かずに済みます。aliasは既存の型に名前を付ける宣言です。",
  reading: "Named<A>のAは、使うときに選ぶ型の置き場所です。このAを型パラメーターと呼びます。Named<Int>は{ label: String, value: Int }、Named<String>は{ label: String, value: String }と同じ型です。",
  result: "readValueもAを宣言し、受け取ったNamed<A>のvalueを同じAとして返します。countからは整数の42、stateからは文字列のreadyが得られ、その順に表示されます。",
}

pub fn readerCaption -> String = "ラベル付きの数と文字列に同じ型別名を使う"

pub fn readerBridgeOne -> String =
  "値は普通の{ ... }で作ります。Namedという値のコンストラクターを呼んだり、別の値へ包み直したりはしません。aliasによって同じ形に短い名前を付けても、用途の違う二つのIDを別の型として区別できるわけではありません。"

pub fn readerBridgeTwo -> String =
  "mainは公開された出力の入口です。${readValue count}などは、空白で引数を渡した関数の結果を文字列へ埋め込みます。\\nで行を分け、printlnが末尾の改行も出力します。"

pub fn readerInvalidCaption -> String = "Named<Int>のvalueへ文字列を入れる"

pub fn readerMistake -> String =
  "Named<Int>を展開するとvalueにはIntが必要です。\"42\"を入れるとSES-T0101になります。数として扱うなら42に直し、文字列を保存したいならNamed<String>を使います。別名にしても中のフィールドの型検査は変わりません。"

pub fn readerDetailNote -> String =
  "詳細のPair<A> = (A, A)は、同じ型の値を二つ並べたタプルの別名です。(42, 7)で値を作り、(left, _)で先頭を取り出します。_は二つ目を使わない指定です。この宣言だけの例と、最初のmain付きの例を区別してください。"

pub fn readerComparison -> String =
  "TypeScriptでも、type Named<A>のような型別名とgeneric関数で同じ仕事ができます。Aをnumberかstringへ置き換える考え方は共通です。この例は42という安全な整数を使い、両方で同じ二行を表示します。"

pub fn readerLegacyReading -> String =
  "Pair<A>は(A, A)の別名です。Pair<Int>は(Int, Int)なので、first (42, 7)には普通のタプルを渡します。(left, _)は先頭の42を取り出し、二つ目の値を使わないパターンです。"

pub fn readerLegacyResult -> String =
  "first (42, 7)はIntの42を返します。Pairという名前はタプルの型に付けた別名です。値を作るときは(42, 7)と書き、Pair 42 7とは書きません。用途ごとに別の型が必要ならnewtypeを使います。"

pub fn readerRelated -> String = "では、別名ではなく用途の違うIDを区別する方法を確認できます。"
