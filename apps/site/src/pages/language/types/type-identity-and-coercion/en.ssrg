import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Type identity and coercion",
  summary: "Seseragi permits only Never coercion and structural record width generally; every numeric, nominal, optional, and foreign conversion is explicit.",
  ruleTitle: "Identity survives similar values and representations",
  ruleBody: "Int and Float are distinct; A does not become Maybe<A> or Either<E, A>; structs do not become same-field records; newtypes do not implicitly wrap or unwrap; and Js.Nullable<A> does not become Maybe<A>. Use the named boundary conversion for each case.",
  identityBody: "The only general implicit coercions are Never into any demanded type and a wider structural record into the narrower required field set. Effect, Stream, Signal, and MutableSignal capability relationships are separately specified exceptions rather than evidence of general covariance.",
  checkingBody: "The checker first establishes source and target identity, then applies only an allowed coercion at the exact expected-type boundary. It does not chain guessed conversions or consult runtime values. Explicit conversions remain ordinary typed functions with visible failure where needed.",
  invalidTitle: "A compatible backend representation grants no conversion",
  invalidBody: "Passing Int where Float is required, a newtype where its representation is expected, a struct where a record is expected, or nullable foreign data where Maybe is expected is rejected. Wrapping a value in Just or calling toFloat is an explicit program step.",
  diagnosticsBody: "Mismatch diagnostics name the source and target identities and may point to the relevant explicit boundary API. They never report success merely because TypeScript or another backend would accept the underlying representation.",
  provenanceBody: "This article covers specification section 2.8 and links the exact record and Never exceptions. The highlighted diagnostic fixture proves that nominal newtype identity cannot be bypassed by implicit representation coercion."
}
