import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Type identity and coercion",
  summary: (explanation ()).summary,
  ruleTitle: "Write the required conversion when passing a value to another type",
  ruleBody: "To use an Int as Float, call a conversion such as toFloat. To create Maybe<Int> from an Int, wrap it in Just. A struct and an ordinary record are different types even when their fields match. Explicitly wrap or unpack newtypes and convert foreign Js.Nullable<A> values to Maybe<A> as well.",
  identityBody: "The only general implicit coercions are Never into any demanded type and a wider structural record into the narrower required field set. Effect, Stream, Signal, and MutableSignal capability relationships are separately specified exceptions rather than evidence of general covariance.",
  checkingBody: "The checker first establishes source and target identity, then applies only an allowed coercion at the exact expected-type boundary. It does not chain guessed conversions or consult runtime values. Explicit conversions remain ordinary typed functions with visible failure where needed.",
  invalidTitle: "A compatible backend representation grants no conversion",
  invalidBody: "Passing Int where Float is required, a newtype where its representation is expected, a struct where a record is expected, or nullable foreign data where Maybe is expected is rejected. Wrapping a value in Just or calling toFloat is an explicit program step.",
  diagnosticsBody: "Mismatch diagnostics name the source and target identities and may point to the relevant explicit boundary API. They never report success merely because TypeScript or another backend would accept the underlying representation.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Will the compiler convert a similar value for me?",
  summary: "Seseragi keeps most type conversions explicit. A similar representation is not enough to make two types compatible.",
  reading: "An Int such as 42 is not automatically a Float, Just 42 is a Maybe<Int> rather than an Int, and a UserId wrapping 42 is not a raw integer. These distinctions prevent accidentally dropping absence handling or mixing identifiers.",
  result: "Call toFloat to convert 42 to Float, or write Just 42 to construct a present Maybe. Use match to extract the Int from UserId. For a type error, compare the value's type with the receiving interface's type and identify the required conversion."
}
