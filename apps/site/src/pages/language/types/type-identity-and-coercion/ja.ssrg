import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "型の同一性と型変換",
  summary: (explanation ()).summary,
  ruleTitle: "似た値や表現でも同一性を保つ",
  ruleBody: "IntとFloatは別の型です。IntをFloatとして使いたい場合は、変換関数を使います。値AをMaybe<A>として使う場合も、Justで包むなどの操作が必要です。同じフィールドを持つstructとレコードも交換できません。newtypeを包む・取り出す操作や、外部のJs.Nullable<A>からMaybe<A>への変換も明示します。",
  identityBody: "一般に暗黙で許されるのは、値を返さないNeverを要求された型として扱う規則と、レコードに余分なフィールドがあっても必要なフィールドを持つ場所へ渡せる規則です。Effect・Stream・Signal・MutableSignalには、それぞれの用途に応じた例外があります。それらは任意の型を自動変換する規則ではありません。",
  checkingBody: "コンパイラは、元の値の型と、その場所で要求される型を比較し、定められた変換だけを許します。複数の変換を推測してつなげたり、実行時の値を調べて決めたりはしません。明示的な変換関数にも型があり、変換に失敗する可能性があれば、その失敗も型で表します。",
  invalidTitle: "実行時の表現が同じでも、そのまま渡せるとは限らない",
  invalidBody: "Floatが必要な場所へIntを、Intが必要な場所へnewtypeの値を、そのまま渡すことはできません。structをレコードへ、外部のnullableな値をMaybeへ直接渡すこともできません。toFloatを呼ぶ、Justで包む、newtypeをパターンで取り出すなど、意図した操作を示します。",
  diagnosticsBody: "型が合わない場合は、元の型と要求される型を見比べ、対応する変換関数やコンストラクターを確認してください。生成先のTypeScriptなどで同じ形として扱えても、それを理由にSeseragiの型検査を通すことはありません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "似た値なら自動で型を変えてくれるか",
  summary: "Seseragiでは、多くの型変換をコードで明示します。実行時の形が似ているだけでは、同じ型として扱えません。",
  reading: "42というIntは自動でFloatにはなりません。Just 42はIntではなくMaybe<Int>です。UserIdで包んだ42も、そのまま整数としては使えません。値の不在を見落としたり、IDを取り違えたりするのを防ぐ区別です。",
  result: "数値の変換、Justでの包み込み、matchでのnewtypeの取り出しなど、意図した操作を示します。後述する限定的な自動変換は、任意の変換を勝手につなぐ規則ではありません。"
}
