import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  typePage "language.types.identity-coercion" "/docs/language/types/type-identity-and-coercion/" (en.copy ()) (ja.copy ()) [BulletList
      [
        [
          InlineCode "Never -> A",
          Words
      (localized " is allowed because no value is produced." " は値が生成されないため許可されます。")
        ],
        [
          InlineCode "{ id: Int, name: String } -> { name: String }",
          Words
      (localized " is allowed by record width." " は、必要なフィールドに加えて余分なフィールドがあるため渡せます。")
        ],
        [
          InlineCode "Int -> Float",
          Words (localized " requires an explicit conversion." " は明示変換が必要です。")
        ],
        [
          InlineCode "A -> Maybe<A>",
          Words (
            localized " requires Just or another explicit constructor."
      " をMaybeにするには、Justなどで明示的に包みます。"
          )
        ]
      ]] [CodeExample (
        "types-invalid-coercion",
        localized "A newtype cannot coerce to its representation"
      "newtypeの値を、そのまま中身の型として使えない"
      )] [
        [InternalLink (
          localized "Nominal and structural types" "名前付き型と構造的な型",
          "/docs/language/types/nominal-and-structural-types/"
        )],
        [InternalLink
      (localized "Built-in types" "組み込み型", "/docs/language/types/built-in-types/")],
        [InternalLink
      (localized "Type system" "型システム", "/docs/language/types/type-system/")]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
