import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Kinds and type constructors",
  summary: (explanation ()).summary,
  ruleTitle: "A constructor is not yet a value type",
  ruleBody: "A kind describes what a type expression accepts. Int has kind Type: it can be the type of a value. Maybe has kind Type -> Type: it needs one Type argument before it can describe a value. Maybe<Int> is complete, while a bare Maybe is not. A two-parameter constructor has kind Type -> Type -> Type; supplying only its first argument does not make it a value type.",
  identityBody: "Write M<_> when a parameter should accept a type constructor that takes one type. If M is Maybe, using M<Int> gives Maybe<Int>; M could also be List. This form can occur in function, type, trait, and impl declarations, and kinds are checked at compile time. It does not declare a runtime object named M.",
  checkingBody: "Check every application layer independently: both the number of arguments and their kinds must match. Partial constructors such as Either<String, _> are allowed when a constructor is expected. The underscore is a constructor slot, not an unknown value type. It may occur in constructor-parameter declarations and partial constructor applications, but cannot remain in an ordinary value annotation.",
  invalidTitle: "Do not use a constructor where a value type is required",
  invalidBody: "A parameter annotated Maybe has not selected the contained type. Annotate Maybe<Int> or introduce a type parameter. Passing Int as M<_> also fails: Int cannot be applied to another type. Extra arguments are not ignored and missing slots do not become Unknown.",
  diagnosticsBody: "Kind and arity errors are compile-time errors. Read the expected constructor shape, then check whether each argument is a complete type or a constructor of that shape. Add the missing argument rather than treating _ as a general inference escape hatch.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can an alias choose Maybe itself, as well as the Int inside Maybe<Int>?",
  summary: "An ordinary type parameter A can select Int. A more general alias can also select something such as Maybe or Array that still expects one payload type.",
  reading: "Wrapped<M<_>, A> = M<A> declares an alias. M<_> selects something that accepts one type; A selects that payload type. Wrapped<Maybe, Int> equals Maybe<Int>, and Wrapped<Array, Int> equals Array<Int>.",
  result: "keep receives and returns Maybe<Int>. Just 42 represents a present integer; Nothing represents its absence. numbers is the integer array [1, 2]. main uses show to display Just 42, Nothing and [1, 2] on separate lines.",
}

pub fn readerCaption -> String = "Select Maybe or Array through the same alias"

pub fn readerBridgeOne -> String =
  "The _ in M<_> marks one type-argument position, not an unknown value. Maybe alone cannot annotate a value because its payload is unspecified, but it can be passed to M<_>. In a value’s annotation, supply all arguments, as in Maybe<Int>."

pub fn readerBridgeTwo -> String =
  "This shape of type inputs and results is called a kind. Int is a complete type, written Type; Maybe accepts one type, written Type -> Type. This notation describes types, not a runtime function. Read Wrapped<Maybe, Int> as two choices: Maybe for M and Int for A."

pub fn readerInvalidCaption -> String = "Pass Int where M must accept another type"

pub fn readerMistake -> String =
  "Wrapped<Int, Int> attempts to apply another Int argument to Int. Int accepts no type arguments, so this reports SES-T0604. Choose a one-argument constructor such as Maybe or Array, or annotate the value as Int if an ordinary integer is intended."

pub fn readerDetailNote -> String =
  "The detailed rules cover argument counts, partially supplied forms such as Either<String, _>, and the positions where _ may remain. Either<String, _> fixes the failure reason to String while still accepting one success-value type."

pub fn readerLegacyReading -> String =
  "Wrapped<M<_>, A> takes M, which needs one type argument, and applies it to A. Wrapped<Maybe, Int> therefore means Maybe<Int>. keep receives and returns this complete type."

pub fn readerLegacyResult -> String =
  "Maybe requires one type argument, supplied in Maybe<Int>. The _ in M<_> marks one position that accepts a type. Passing Int as M is a kind error because Int cannot accept another type argument."

pub fn readerRelated -> String =
  " reviews supplying a payload type in forms such as Box<Int>."
