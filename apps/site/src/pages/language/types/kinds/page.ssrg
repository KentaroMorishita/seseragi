import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  typePage "language.types.kinds" "/docs/language/types/kinds/" (en.copy ()) (ja.copy ()) [CodeExample
      ("types-kinds", localized "Kinds and type constructors" "kindと型構築子")] [CodeExample
      ("types-kind-invalid", localized "Rejected type mismatch" "拒否される型の不一致")] [
        [InternalLink
      (localized "Type constructors" "型構築子", "/docs/language/types/type-constructors/")],
        [InternalLink (
          localized "Generic functions" "ジェネリック関数",
          "/docs/language/types/generic-functions/"
        )],
        [InternalLink
      (localized "Trait constraints" "trait制約", "/docs/language/traits/constraints/")]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample
          ("type-limits-kinds", localized (en.readerCaption ()) (ja.readerCaption ())),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "Just 42\nNothing\n[1, 2]"),
        CodeExample (
          "type-limits-kinds-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Paragraph (
          [
            InternalLink (
              localized "Type constructors" "型構築子",
              "/docs/language/types/type-constructors/"
            ),
            Words (localized (en.readerRelated ()) (ja.readerRelated ()))
          ]
        ),
        Heading (
          "declaration-example",
          localized "Continue into the detailed rules" "詳しい規則と宣言例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
