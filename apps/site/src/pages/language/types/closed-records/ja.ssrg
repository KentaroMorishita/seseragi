import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "確定したサービス要求（closed record）",
  summary: (explanation ()).summary,
  ruleTitle: "実行入口で必要なサービスを確定させる",
  ruleBody: "実行環境へ処理を渡す時点で、必要なサービスのフィールド名と型をすべて列挙できる必要があります。型別名を展開した結果がレコードになり、重複や未解決の型変数を残さないことが条件です。EffectやStreamのサービス要求には、省略可能なフィールドを置けません。",
  identityBody: "closedは、この要求をコンパイル時に確定できるという意味です。新しい種類の実行時の値ではありません。また、サービスを渡すレコードに余分なフィールドがあっても構いません。ただし、処理から使えるのは、型に必要だと宣言したフィールドだけです。",
  checkingBody: "コンパイラは型別名と&でまとめた要求を展開して、必要なサービスの一覧を確定します。ジェネリック関数の中ではRのような型変数を使えますが、実行入口ではRも具体的なレコード型に決まっている必要があります。",
  invalidTitle: "実行入口ではサービスの型を確定させる",
  invalidBody: "実行入口に未確定の型パラメーターが残ると、必要なサービスを列挙できません。要求するフィールドの名前と型が決まるように、型引数や型別名の定義を確認してください。EffectやStreamの要求には、省略可能なサービスのフィールドも使えません。渡す環境に余分なサービスがあることは許されます。",
  diagnosticsBody: "このエラーでは、サービスの値がないという問題とは別に、要求の型が確定しているかを確認します。実行入口に残った型パラメーターや型別名の定義を見直してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "実行するとき、必要な外部機能をどう決めるのか",
  summary: "このページは実行入口の型を詳しく調べるためのものです。closed recordは「余分なフィールドを禁止するオブジェクト」ではありません。実行に必要なサービスの名前と型を確定できる、という意味です。",
  reading: "mainは実行入口です。with Consoleは端末へ出力する機能を必要とする指定で、{ console: Console }という要求に対応します。consoleがフィールド名、Consoleが機能の型です。",
  result: "実行するとreadyが一行表示されます。必要な機能がConsoleと決まっているので、CLIがその出力機能を用意できます。単にオブジェクトのフィールドをまとめたいときには、closedという指定は不要です。",
}

pub fn readerCaption -> String = "端末出力に必要な機能を明記する"

pub fn readerBridgeOne -> String =
  "effect fnは外部とのやり取りを含む処理です。-> Unitは返す中身がない正常な完了、fails ConsoleErrorは出力が失敗した場合の型を表します。pubは入口を公開し、printlnはreadyと改行を出力します。"

pub fn readerBridgeTwo -> String =
  "この機能要求は、型の上で{ console: Console }まで決まっています。実行環境がほかの機能を持っていても構いません。後半のRや型別名の話は、必要な機能を組み合わせる詳細であり、基本のレコード操作の前提ではありません。"

pub fn readerInvalidCaption -> String = "必要なConsoleを入口の型から省く"

pub fn readerMistake -> String =
  "with Consoleを省いた明示的な宣言は、必要な機能が空の{}という意味になり、この例ではSES-E0001です。printlnが要求するconsoleがないため、with Consoleを戻します。値がないことと、型に要求を書いていないことを区別してください。"

pub fn readerDetailNote -> String =
  "ここからの宣言例は、詳しい規則を調べるための断片です。単独では実行入口を持ちません。動かす場合は、上に載せたmain付きの完全な例を使ってください。"
