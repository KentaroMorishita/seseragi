import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "確定したサービス要求（closed record）",
  summary: "ホストの要求のフィールド集合を静的に列挙できることを表し、レコードの幅部分型を無効にはしません。",
  ruleTitle: "実行入口で必要なサービスを確定させる",
  ruleBody: "実行環境へ処理を渡す時点で、必要なサービスのフィールド名と型をすべて列挙できる必要があります。型別名を展開した結果がレコードになり、重複や未解決の型変数を残さないことが条件です。EffectやStreamのサービス要求には、省略可能なフィールドを置けません。",
  identityBody: "closedは、この要求をコンパイル時に確定できるという意味です。新しい種類の実行時の値ではありません。また、サービスを渡すレコードに余分なフィールドがあっても構いません。ただし、処理から使えるのは、型に必要だと宣言したフィールドだけです。",
  checkingBody: "コンパイラは型別名と&でまとめた要求を展開して、必要なサービスの一覧を確定します。ジェネリック関数の中ではRのような型変数を使えますが、実行入口ではRも具体的なレコード型に決まっている必要があります。",
  invalidTitle: "不足している型の情報を実行環境へ丸投げしない",
  invalidBody: "実行入口に自由な型変数や未解決の条件が残ると、必要なサービスを列挙できません。省略可能なサービスも使えません。一方、渡す側の環境が余分なサービスを持つことはエラーではありません。",
  diagnosticsBody: "このエラーでは、サービスの値がないという問題とは別に、要求の型が確定しているかを確認します。実行入口に残った型パラメーターや型別名の定義を見直してください。",
}
