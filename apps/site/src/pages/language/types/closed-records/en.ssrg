import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Closed records",
  summary: (explanation ()).summary,
  ruleTitle: "Close the requirement, not the value shape",
  ruleBody: "After alias expansion, a closed requirement has a record at its top level, fixed unique field names and types, no free type variable or unresolved row remainder, no recursive alias or unresolved constraint that could change the fields, and no optional field for an Effect or Stream host requirement.",
  identityBody: "Closed is a compile-time host-boundary property rather than a new runtime record type or an exact-record mode. The host may provide extra fields through ordinary width subtyping; the program cannot access fields absent from its declared requirement.",
  checkingBody: "Entry-point checking expands aliases and normalizes requirement merges before enumerating services. A generic variable still denotes one complete record rather than an open row, and it must be resolved to a closed field set at the host boundary.",
  invalidTitle: "Determine the service types at the execution entry point",
  invalidBody: "Unresolved type parameters at the execution entry point prevent the compiler from listing the required services. Check the type arguments and alias definitions so each required field has a known name and type. Effect and Stream requirements cannot contain optional service fields. Extra services in the supplied environment are allowed.",
  diagnosticsBody: "Boundary diagnostics identify the construct preventing field enumeration and retain the expanded alias path. They are separate from ordinary missing-field diagnostics and from requirement-merge conflicts.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How are the external capabilities needed at execution determined?",
  summary: "This page is a detail of entry-point types. A closed record does not mean an object that forbids extra fields. It means the names and types of required services can be fully determined.",
  reading: "main is the entry point. with Console requires terminal output and corresponds to the requirement { console: Console }. console is the field name; Console is the capability type.",
  result: "Running it prints one line, ready. The requirement is known to be Console, so the CLI can supply its output capability. Ordinary record operations do not require a closed keyword or annotation.",
}

pub fn readerCaption -> String = "State the capability needed for terminal output"

pub fn readerBridgeOne -> String =
  "effect fn describes work involving outside interaction. -> Unit means successful completion without a contents value; fails ConsoleError names the output-failure type. pub exposes the entry, and println writes ready and a newline."

pub fn readerBridgeTwo -> String =
  "The type has determined the requirement down to { console: Console }. The execution environment may still provide other capabilities. R and aliases in the later sections concern combining requirements; they are not prerequisites for ordinary record operations."

pub fn readerInvalidCaption -> String =
  "Omit the required Console from the entry contract"

pub fn readerMistake -> String =
  "Omitting with Console from this explicit declaration leaves the empty requirement {}, producing SES-E0001 here. Restore with Console because println requires console. Distinguish a missing runtime value from a requirement omitted in the type."

pub fn readerDetailNote -> String =
  "The declarations below illustrate the detailed rules. They are fragments without their own entry point. To run this page’s example, use the complete program with main above."
