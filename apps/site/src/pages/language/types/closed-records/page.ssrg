import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  typePage "language.types.closed-records" "/docs/language/types/closed-records/" (en.copy ()) (ja.copy ()) [
    CodeExample (
      "types-requirement-merge",
      localized "A generic requirement before boundary closure"
        "サービスの型を確定する前の、型パラメーターを含む要求"
    ),
    BulletList [
      [Words (
        localized "Top-level record, fixed unique required fields."
        "必要なサービスを必須フィールドとして持つ、一つのレコード型であること。"
      )],
      [Words (
        localized
        "No unresolved variable, row, constraint, or recursive alias affecting fields."
        "各フィールドの型が確定し、未確定の型変数や再帰する別名が残っていないこと。"
      )],
      [Words (
        localized
        "Extra fields in the provided host record remain valid by width subtyping."
        "実行環境が渡すレコードには、必要なもの以外のフィールドがあっても構いません。"
      )]
    ]
  ] [BulletList [
    [
      InlineCode "Effect<R, E, A>",
      Words (
        localized " is not a closed entry requirement while R remains unresolved."
        " のRが未確定なら、実行入口で渡すサービスを決められません。"
      )
    ],
    [
      InlineCode "{ console?: Console }",
      Words (
        localized " is not a closed Effect host requirement."
        " はconsoleを省略できるため、実行入口のサービス要求には使えません。"
      )
    ]
  ]] [
    [InternalLink (
      localized "Requirement merge" "必要なサービスを組み合わせる",
      "/docs/language/types/requirement-merge/"
    )],
    [InternalLink (
      localized "Optional record fields" "省略可能なレコードフィールド",
      "/docs/language/types/optional-record-fields/"
    )],
    [InternalLink (
      localized "Nominal and structural types" "名前付き型と構造的な型",
      "/docs/language/types/nominal-and-structural-types/"
    )]
  ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
