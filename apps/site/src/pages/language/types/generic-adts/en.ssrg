import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Generic algebraic data types",
  summary: (explanation ()).summary,
  ruleTitle: "Constructors quantify the declaration's parameters",
  ruleBody: "Outcome<E, A> lets you choose the failure type E and success type A. Outcome<String, Int> and Outcome<String, Bool> are different types. Failure contains a value of E and Success a value of A; both are values of Outcome<E, A>. Constructing either alternative still requires both E and A to be determined.",
  identityBody: "Each construction gets fresh type variables. A payload can fix one parameter while leaving another to the expected result type or explicit arguments. The annotated success in the example fixes E to String even though Success has no error payload. Do not interpret an unused payload parameter as Never or as a type omitted from the result.",
  checkingBody: "Matching substitutes the scrutinee's arguments into each constructor payload. Matching Outcome<String, Int> therefore binds a Failure payload as String and a Success payload as Int. Recursive references must apply the ADT's parameters explicitly: Node holds Array<Tree<A>>, not a bare Tree. This keeps one consistent A throughout that tree.",
  invalidTitle: "A payload does not necessarily determine the whole ADT",
  invalidBody: "Without an expected type, Success 42 may leave its failure parameter unresolved. Supply the full result annotation or complete constructor type arguments. A recursive field using bare Tree is not a complete type. Constructors do not select unrelated parameter types independently of the expected ADT.",
  diagnosticsBody: "For an ambiguous constructor, check which declaration parameters are absent from the payload. Those parameters need information from the surrounding expression. Pattern matching and exhaustiveness checking use the already instantiated nominal ADT rather than reconstructing a new type from each arm.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can the same result type store different payload types?",
  summary: "A generic ADT describes a fixed set of alternatives while letting you choose the types stored in them.",
  reading: "Outcome<E, A> has Failure carrying E and Success carrying A. For Outcome<String, Int>, Failure contains text and Success contains an integer. Both alternatives are values of the same complete Outcome<String, Int> type.",
  result: "The integer in Success 42 determines A as Int. The success value supplies no information about E, so the annotation fixes it as String with Outcome<String, Int>. Child trees in Tree<A> also use the same A, keeping the element type consistent throughout the tree."
}
