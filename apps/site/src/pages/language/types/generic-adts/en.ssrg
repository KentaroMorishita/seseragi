import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Generic algebraic data types",
  summary: (explanation ()).summary,
  ruleTitle: "Constructors quantify the declaration's parameters",
  ruleBody: "Outcome<E, A> lets you choose the failure type E and success type A. Outcome<String, Int> and Outcome<String, Bool> are different types. Failure contains a value of E and Success a value of A; both are values of Outcome<E, A>. Constructing either alternative still requires both E and A to be determined.",
  identityBody: "Each construction gets fresh type variables. A payload can fix one parameter while leaving another to the expected result type or explicit arguments. The annotated success in the example fixes E to String even though Success has no error payload. Do not interpret an unused payload parameter as Never or as a type omitted from the result.",
  checkingBody: "Matching substitutes the scrutinee's arguments into each constructor payload. Matching Outcome<String, Int> therefore binds a Failure payload as String and a Success payload as Int. Recursive references must apply the ADT's parameters explicitly: Node holds Array<Tree<A>>, not a bare Tree. This keeps one consistent A throughout that tree.",
  invalidTitle: "A payload does not necessarily determine the whole ADT",
  invalidBody: "Without an expected type, Success 42 may leave its failure parameter unresolved. Supply the full result annotation or complete constructor type arguments. A recursive field using bare Tree is not a complete type. Constructors do not select unrelated parameter types independently of the expected ADT.",
  diagnosticsBody: "For an ambiguous constructor, check which declaration parameters are absent from the payload. Those parameters need information from the surrounding expression. Pattern matching and exhaustiveness checking use the already instantiated nominal ADT rather than reconstructing a new type from each arm.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can a result choose types for both its success value and failure reason?",
  summary: "Represent either a success value or a failure reason as two alternatives of one type. Type parameters choose what each alternative contains.",
  reading: "type Outcome<E, A> declares Failure containing a reason of E and Success containing a value of A. | separates the alternatives. In Outcome<String, Int>, Failure \"missing\" and Success 42 are values of the same result type.",
  result: "The match in describe checks which alternative it received. Failure reason extracts a String; Success number extracts an Int. main passes both results and prints ok: 42 followed by error: missing.",
}

pub fn readerCaption -> String = "Choose the payload types of two named alternatives"

pub fn readerBridgeOne -> String =
  "The annotation on found determines both types. Success 42 supplies enough information for the success value to be Int, but contains no failure reason from which to determine E. An expected result annotation or another explicit type choice supplies the missing information."

pub fn readerBridgeTwo -> String =
  "TypeScript can also use objects distinguished by a field such as kind in a shared generic result type. Seseragi’s Failure and Success names identify the alternatives here. Failure is an ordinary value; it does not throw or interrupt control flow."

pub fn readerInvalidCaption -> String =
  "Put text in a result whose success payload must be Int"

pub fn readerMistake -> String =
  "Success in Outcome<String, Int> requires an Int. Success \"42\" produces SES-T0101. Use Success 42 for an integer, or choose Outcome<String, String> for a text payload and adjust the receiving function accordingly."

pub fn readerDetailNote -> String =
  "The detailed Outcome and Tree declarations retain the alternatives and introduce recursive data whose child trees carry the same type parameter. Array<Tree<A>> is an array of child trees using that A. No tree knowledge is needed for the first complete example."

pub fn readerLegacyReading -> String =
  "Outcome<E, A> has Failure carrying E and Success carrying A. For Outcome<String, Int>, Failure contains text and Success contains an integer. Both alternatives are values of the same complete Outcome<String, Int> type."

pub fn readerLegacyResult -> String =
  "The integer in Success 42 determines A as Int. The success value supplies no information about E, so the annotation fixes it as String with Outcome<String, Int>. Child trees in Tree<A> also use the same A, keeping the element type consistent throughout the tree."

pub fn readerRelated -> String = " reviews named alternatives and the basics of match."
