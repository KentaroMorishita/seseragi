import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "ジェネリックな代数的データ型",
  summary: (explanation ()).summary,
  ruleTitle: "各選択肢も、データ型全体の型引数を持つ",
  ruleBody: "Outcome<E, A>では、失敗値の型Eと成功値の型Aを選べます。Outcome<String, Int>とOutcome<String, Bool>は別の型です。FailureにはEの値、SuccessにはAの値が入り、どちらもOutcome<E, A>の値になります。一方の選択肢を作るときも、EとAの両方を決める必要があります。",
  identityBody: "Success 42からは、成功値の型AがIntだと分かります。しかし、失敗値の型Eはこの値だけでは分かりません。例では、結果にOutcome<String, Int>という型注釈を付けてEも決めています。失敗値を持たないSuccessだからといって、Eが自動でNeverになるわけではありません。",
  checkingBody: "matchでOutcome<String, Int>を調べると、Failureから取り出す値はString、Successから取り出す値はIntになります。再帰的なデータでも型引数を引き継ぎます。たとえばTree<A>の子を持つフィールドはArray<Tree<A>>と書き、木の中で同じAを使います。",
  invalidTitle: "一つの選択肢だけでは、すべての型引数が決まらないことがある",
  invalidBody: "結果に必要な型が分からない場所でSuccess 42だけを書くと、Eを決められないことがあります。結果の型注釈か、コンストラクターの明示的な型引数で補ってください。また、Treeのように必要な型引数を省いた型名は、値の型として使えません。",
  diagnosticsBody: "型を推論できない場合は、その選択肢に含まれない型パラメーターを確認してください。matchの各分岐では、対象のデータ型にすでに決まった型引数を使います。分岐ごとに別の型へ変わるわけではありません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "成功の中身と失敗理由の型を選べる結果を作るには",
  summary: "成功なら値、失敗なら理由を持つ、という二つの選択肢を一つの型にします。その中身に使う型をパラメーターで選べます。",
  reading: "type Outcome<E, A>には、E型の理由を持つFailureと、A型の値を持つSuccessがあります。|は選択肢の区切りです。Outcome<String, Int>なら、Failure \"missing\"もSuccess 42も同じ結果型の値です。",
  result: "describeのmatchは結果がどちらかを調べます。Failure reasonではString、Success numberではIntを取り出せます。mainは二つの結果を渡し、ok: 42とerror: missingを表示します。",
}

pub fn readerCaption -> String = "二つの選択肢の中身を、型引数で決める"

pub fn readerBridgeOne -> String =
  "foundの型注釈は二つの型を決めています。Success 42だけなら成功値がIntとは分かりますが、その値には失敗理由がないため、Eを決める材料がありません。結果の型注釈などで残りの型も指定します。"

pub fn readerBridgeTwo -> String =
  "TypeScriptでもkindなどのフィールドで成功と失敗を区別するオブジェクトを用意し、共通のgenericな結果型にできます。SeseragiではFailure/Successという名前がその選択肢を表します。ここでFailureは普通の値であり、throwや処理の中断は起きません。"

pub fn readerInvalidCaption -> String = "成功値をIntと宣言してStringを入れる"

pub fn readerMistake -> String =
  "Outcome<String, Int>のSuccessにはIntが必要です。Success \"42\"はSES-T0101になります。整数ならSuccess 42に直し、成功値を文字列にしたいならOutcome<String, String>のように型を揃え、受け取る関数もその型に合わせます。"

pub fn readerDetailNote -> String =
  "詳細のOutcomeとTreeの例では、同じ選択肢を宣言だけで示し、子の木にも型引数を引き継ぐ再帰的なデータを扱います。Array<Tree<A>>は、同じAを使う子の木を並べた配列です。最初の完全な例には、この木の知識は不要です。"

pub fn readerLegacyReading -> String =
  "例のOutcome<E, A>には、Eを持つFailureとAを持つSuccessがあります。Outcome<String, Int>なら、Failureには文字列、Successには整数が入り、どちらも同じOutcome<String, Int>型の値です。"

pub fn readerLegacyResult -> String =
  "Success 42の整数からAはIntと分かります。Eは成功値に含まれないため、例ではOutcome<String, Int>という注釈でStringに決めています。Tree<A>の子の木にも同じAを指定し、木全体で要素の型を揃えます。"

pub fn readerRelated -> String = "では、名前付きの選択肢とmatchの基本を確認できます。"
