import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words,
  Paragraph,
  Terminal,
  Heading
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  typePage "language.types.optional-record-fields" "/docs/language/types/optional-record-fields/" (en.copy ()) (ja.copy ()) [
    CodeExample (
      "syntax-optional-record-field",
      localized "Optional presence in compiled source" "フィールドのあるレコードと、ないレコード"
    ),
    BulletList [
      [InlineCode "absent -> optional", Words (localized " is accepted." " は受理されます。")],
      [
        InlineCode "required A -> optional A",
        Words (
          localized " is accepted and preserves known presence."
            " は渡せます。実際にフィールドが存在する情報も保持します。"
        )
      ],
      [
        InlineCode "optional A -> required A",
        Words (localized " is rejected." " は拒否されます。")
      ]
    ]
  ] [CodeExample (
    "syntax-invalid-record-fields",
    localized "Missing and incompatible record fields" "必須フィールドの不足と、値の型の不一致"
  )] [
    [InternalLink (
      localized "Optional record field syntax" "省略可能なレコードフィールドの構文",
      "/docs/language/syntax/optional-record-fields/"
    )],
    [InternalLink (
      localized "Nominal and structural types" "名前付き型と構造的な型",
      "/docs/language/types/nominal-and-structural-types/"
    )],
    [InternalLink (
      localized "Closed records" "確定したサービス要求（closed record）",
      "/docs/language/types/closed-records/"
    )]
  ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [[CodeExample
        ("type-reader-optional", localized (en.readerCaption ()) (ja.readerCaption ())), Paragraph
        ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]), Paragraph
        ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]), Terminal
        (localized "Output" "実行結果", "Aki\nA"),

        CodeExample (
          "type-reader-optional-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ), Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]), Paragraph (
          [
            InternalLink (
              localized "Maybe and absence" "Maybeと値の不在",
              "/docs/language/effects/maybe/"
            ),
            Words (localized (en.readerRelated ()) (ja.readerRelated ()))
          ]
        ), Heading (
          "declaration-example",
          localized "Continue into the detailed rules" "詳しい規則と宣言例を読む"
        ), Paragraph ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]), Paragraph ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]), Paragraph ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])], page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
