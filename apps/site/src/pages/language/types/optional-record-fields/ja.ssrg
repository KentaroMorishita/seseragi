pub fn copy -> TypeCopy = TypeCopy {
  title: "省略可能なレコードフィールド",
  summary: "フィールドの存在が省略可能であることと、必須フィールドにMaybeを格納することを区別します。",
  ruleTitle: "省略可能フィールドに合う三つの状態",
  ruleBody: "期待するid?: Stringに対し、元のレコードはidを持たない、省略可能として持つ、id: Stringを必須として持つ、のいずれでも構いません。期待する必須フィールドは元でも必須である必要があり、追加フィールドは幅部分型で許されます。",
  identityBody: "{id?: String}は{id: Maybe<String>}と異なります。前者はフィールドを持たない場合があり、参照結果はMaybe<String>です。後者は必ずフィールドがあり、Nothingも存在する値です。省略可能 accessでは不在とJust Nothingを区別できます。",
  checkingBody: "レコード literalに書いたフィールドは通常必須として推論します。省略可能を必須へ使うことはできず、存在するフィールドの型は一致が必要です。不在フィールドへNothingを自動挿入しません。",
  invalidTitle: "省略可能は暗黙のMaybe 内部の値ではない",
  invalidBody: "id?: Stringを必須のid: Stringに使えません。id?: Maybe<String>は二段階の欠如を持ち、まとめません。struct、関数引数、ADT 内部の値に省略可能 markerを直接付ける構文はありません。",
  diagnosticsBody: "省略可能なフィールドのhoverはMaybe<A>です。診断は必須フィールドの不足、省略可能から必須への不一致、フィールド型の不一致を区別します。構文解析器とformatterはレコード構文のフィールド?: Aを保ちます。",
}
