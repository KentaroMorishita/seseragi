import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "省略可能なレコードフィールド",
  summary: (explanation ()).summary,
  ruleTitle: "省略可能フィールドに合う三つの状態",
  ruleBody: "id?: Stringを要求する関数には、idを省略したレコード、id?: Stringを持つレコード、必須のid: Stringを持つレコードを渡せます。逆に、必須のid: Stringを要求する場合、渡す側でもidが必須でなければなりません。必要なフィールドがあれば、追加のフィールドを持つレコードも渡せます。",
  identityBody: "{id?: String}ではidフィールド自体がなくても構いません。{id: Maybe<String>}ではidは必ず存在し、その値がJustかNothingです。id?: Maybe<String>を参照するとMaybe<Maybe<String>>になり、フィールドの不在であるNothingと、フィールドが存在して値がNothingであるJust Nothingを区別します。",
  checkingBody: "レコードの値に明示的に書いたフィールドは、通常は必須のフィールドとして推論します。省略可能なフィールドを必須のフィールドとして使うことはできません。フィールドがある場合には値の型も合う必要があります。不在のフィールドにNothingを自動で追加することはありません。",
  invalidTitle: "省略可能なフィールドを、必須のフィールドとは扱えない",
  invalidBody: "id?: Stringはid: Stringを要求する場所には渡せません。id?: Maybe<String>では、フィールドがない場合と値がNothingの場合を一段にまとめません。structのフィールド、関数の引数、代数的データ型の中身に?:を直接付けることもできません。",
  diagnosticsBody: "エディターで省略可能なフィールドを参照すると、型はMaybe<A>と表示されます。診断は、必須フィールドがない場合、省略可能なものを必須として使った場合、値の型が違う場合を区別します。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "ニックネームを省略できる引数を受け取るには",
  summary: "nameは必須、nicknameはあれば使う、という入力を型で表します。フィールドがない場合の表示も、関数の中で決めます。",
  reading: "alias Personはレコードの型に付けた別名です。name: Stringは必須、nickname?: Stringは省略可能なフィールドです。ordinaryにはnameだけ、nicknamedには両方があります。どちらもdisplayNameへ渡せます。",
  result: "person.nicknameを読む結果はMaybe<String>です。値があればJustで包まれ、なければNothingになります。??は値があるときはその中身、ないときは右側のperson.nameを選ぶので、出力はAki、Aの順です。",
}

pub fn readerCaption -> String = "省略したニックネームの代わりに名前を使う"

pub fn readerBridgeOne -> String =
  "TypeScriptのnickname?: stringとperson.nickname ?? person.nameでも、同じ表示の選び方を書けます。TypeScript側のundefinedと、Seseragi側のNothingは別の表現です。ここでは、フィールドを省略する場合と文字列を渡す場合だけを比べています。"

pub fn readerBridgeTwo -> String =
  "必要なのは「渡してよい」という条件の違いです。nicknameが必須の関数には、Personのように省略可能な型をそのまま渡せません。pub effect fn mainが表示を行い、バッククォート内の${...}へ結果を埋め込み、\\nで行を分けます。"

pub fn readerInvalidCaption -> String = "省略可能なフィールドを必須として渡す"

pub fn readerMistake -> String =
  "requireNicknameには必須のnickname: Stringが必要ですが、ordinaryの型では省略可能です。SES-T0101を直すには、最初のdisplayNameのように省略も受け付けて代わりの値を決めるか、nicknameを必須として持つ値を渡します。型注釈だけで欠けた値が補われることはありません。"

pub fn readerDetailNote -> String =
  "詳しい規則ではPropsのidとchildrenを使い、必須・省略可能・不在の組み合わせを確認します。フィールド自体がない場合と、必須フィールドにNothingを入れる場合の違いも残しています。"

pub fn readerLegacyReading -> String =
  "Propsのchildrenは必須で、idは省略できます。minimalにはchildrenだけがあり、namedにはidもあります。props.idはnamedならJust \"hero\"、minimalならNothingです。??で、値があるときは取り出し、ないときは\"anonymous\"を使います。"

pub fn readerLegacyResult -> String =
  "label minimalは\"anonymous\"、label namedは\"hero\"を返します。必須のid: Maybe<String>とは異なり、この場合はidフィールドそのものを省略できます。"

pub fn readerRelated -> String = "では、読み出したJustとNothingを別々に扱う方法を確認できます。"
