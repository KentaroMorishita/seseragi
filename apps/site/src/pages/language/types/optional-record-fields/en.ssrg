import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Optional record fields",
  summary: (explanation ()).summary,
  ruleTitle: "Presence has three compatible source states",
  ruleBody: "A function expecting id?: String accepts a record with no id, an optional id?: String, or a required id: String. A function expecting a required id: String instead requires id to be mandatory in the source type too. Records may have additional fields as long as all required fields are present.",
  identityBody: "{ id?: String } may omit id, and reading it yields Maybe<String>. { id: Maybe<String> } must contain id, even when its value is Nothing. With id?: Maybe<String>, reading yields Maybe<Maybe<String>>: Nothing means the field is absent, while Just Nothing means it is present and stores Nothing.",
  checkingBody: "Record literals infer their written fields as required unless an expected type says otherwise. Optional never flows to required, present field types must match exactly, and inference does not insert Nothing for a field that was absent.",
  invalidTitle: "Optional does not mean an implicit Maybe payload",
  invalidBody: "A value with id?: String cannot satisfy a required id: String target. id?: Maybe<String> has two levels of absence and is not collapsed. Optional markers on structs, parameters, or ADT payloads are rejected by their syntax boundary.",
  diagnosticsBody: "Field-access hovers report Maybe<A> for optional presence. Compatibility diagnostics distinguish missing-required, optional-to-required, and field-type mismatch. Formatter and parser preserve the field?: A marker owned by record syntax.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can a caller omit a nickname?",
  summary: "Describe an input whose name is required and whose nickname may be absent. The function also decides what to display when the field is missing.",
  reading: "alias Person names a record type. name: String is required; nickname?: String is optional. ordinary has only name, while nicknamed has both fields. Both can be passed to displayName.",
  result: "Reading person.nickname produces Maybe<String>: Just wraps a present value, and Nothing represents absence. ?? takes the wrapped value when present, otherwise person.name on its right. The output is Aki followed by A.",
}

pub fn readerCaption -> String = "Use the name when no nickname is supplied"

pub fn readerBridgeOne -> String =
  "TypeScript can express the same display choice with nickname?: string and person.nickname ?? person.name. Its undefined and Seseragi’s Nothing are different representations. This comparison covers an omitted field or a supplied string."

pub fn readerBridgeTwo -> String =
  "The distinction concerns which inputs may be passed. A function requiring nickname cannot directly accept a type such as Person that permits its absence. pub effect fn main performs the output; ${...} inserts results into the backtick string, and \\n separates the lines."

pub fn readerInvalidCaption -> String =
  "Pass an optional field where a required field is expected"

pub fn readerMistake -> String =
  "requireNickname requires nickname: String, but ordinary has a type that permits omission. To fix SES-T0101, accept omission and choose a fallback as displayName does, or pass a value with a required nickname. An annotation alone cannot supply a missing value."

pub fn readerDetailNote -> String =
  "The detailed Props example uses id and children to examine required, optional and absent fields. It also preserves the distinction between an absent field and a required field storing Nothing."

pub fn readerLegacyReading -> String =
  "Props requires children but allows id to be absent. minimal has only children; named also has id. props.id is Just \"hero\" for named and Nothing for minimal. The ?? operator extracts an existing string or supplies \"anonymous\"."

pub fn readerLegacyResult -> String =
  "label minimal returns \"anonymous\" and label named returns \"hero\". A required field of type Maybe<String> is different: the field must exist, even when its value is Nothing."

pub fn readerRelated -> String =
  " explains how to handle the Just and Nothing results separately."
