import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "ジェネリック関数",
  summary: "呼び出しごとに新しい型引数を推論するか、型引数をすべて明示します。",
  ruleTitle: "呼び出しごとに宣言の型を具体化する",
  ruleBody: "型パラメーターは関数名の直後に書きます。identity<A>は、任意のAで使える一つの型スキームを宣言します。呼び出しの開始時に、宣言された各パラメーターに新しい型変数を用意します。以前の呼び出しで選んだ型は引き継がないため、identity 42とidentity \"hello\"はそれぞれIntとStringを返せます。",
  identityBody: "呼び出し時の推論は五段階です。新しい型変数を導入し、値引数から制約を集め、期待される戻り型の制約を加え、traitの証拠を解決し、残った曖昧さを拒否します。値引数と期待される結果は両立する必要があります。型を決める情報がないときに、コンパイルを通すための適当な型は選びません。",
  checkingBody: "型引数を明示する場合は関数名に続け、宣言順にすべて書きます。すべて省略することもできますが、一部だけの指定や名前付き指定はできません。例のempty<Int> ()は戻り型にしか現れないパラメーターを明示しています。束縛をList<Int>で注釈し、期待型を渡す方法もあります。空のリスト自体にはAを決める要素がありません。",
  invalidTitle: "戻り型だけに現れるパラメーターも確定が必要",
  invalidBody: "identity<String> 42は型引数と値引数が矛盾します。不完全な型引数リストも拒否されます。期待型のないempty ()ではAが曖昧なままです。型が決まってもtrait制約を満たす必要があり、型引数を明示しても証拠の検査は省略されません。",
  diagnosticsBody: "推論が曖昧なら、期待型を注釈するか型引数をすべて明示してください。制約が矛盾する場合は、型引数、値引数、期待する結果を一緒に比較します。これは一つの宣言を静的に具体化する仕組みで、値に応じた実行時ディスパッチではありません。",
  provenanceBody: "言語仕様2.12に基づく規則です。表示する短い例はこのリファレンス専用に管理し、公式コンパイラで検査しています。Tourのレッスンではありません。"
}
