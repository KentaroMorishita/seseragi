import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  typePage "language.types.generic-functions" "/docs/language/types/generic-functions/" (en.copy ()) (ja.copy ()) [CodeExample
      ("types-generic-functions", localized "Generic functions" "ジェネリック関数")] [CodeExample
      ("types-generic-function-invalid", localized "Rejected type mismatch" "拒否される型の不一致")] [
        [InternalLink (
          localized "Annotations and inference" "型注釈と推論",
          "/docs/language/types/annotations-and-inference/"
        )],
        [InternalLink (
          localized "Let-polymorphism and rank" "letの多相性と使える範囲",
          "/docs/language/types/let-polymorphism-and-rank/"
        )],
        [InternalLink (
          localized "Function types and currying" "関数型とカリー化",
          "/docs/language/types/function-types-and-currying/"
        )]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample
          ("type-reader-functions", localized (en.readerCaption ()) (ja.readerCaption ())),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "21, 21\nready, ready"),
        CodeExample (
          "type-reader-functions-typescript",
          localized "The same task in TypeScript" "TypeScriptで同じ仕事をする"
        ),
        Paragraph
          ([Words (localized (en.readerComparison ()) (ja.readerComparison ()))]),
        CodeExample (
          "type-reader-functions-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Paragraph (
          [
            InternalLink (
              localized "Type parameter scope" "型パラメーターのスコープ",
              "/docs/language/types/type-parameter-scope/"
            ),
            Words (localized (en.readerRelated ()) (ja.readerRelated ()))
          ]
        ),
        Heading (
          "declaration-example",
          localized "Continue into the detailed rules" "詳しい規則と宣言例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
