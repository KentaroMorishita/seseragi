import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "型引数の不変性と例外的な変換",
  summary: (explanation ()).summary,
  ruleTitle: "要素の型が違う配列は、そのまま代入できない",
  ruleBody: "Array<{ name: String, id: Int }>とArray<{ name: String }>は別の型です。前者の要素にはnameがありますが、配列全体を後者の型として扱うことはできません。このように、型引数が完全に一致しなければ互換としない規則を「不変性」と呼びます。Listや、自分で定義するADT・struct・newtypeの型引数にも同じ規則が適用されます。",
  identityBody: "nameだけを受け取る関数には、nameとidを持つレコードを渡せます。一方、Array<{ name: String }>を受け取る関数には、Array<{ name: String, id: Int }>をそのまま渡せません。例ではmapで各要素からnameだけを持つ新しいレコードを作り、配列の要素型を明示的に変えています。フィールドの記述順だけが違うレコードは同じ型です。",
  checkingBody: "一部の標準型には、用途を限定した変換があります。EffectとStreamでは、必要なサービスをすべて備えた環境で計算を使えます。また、失敗しないことを表すNeverは、別の失敗型を要求する場所でも使えます。MutableSignal<A>から読み取り専用のSignal<A>への変換も可能です。いずれも成功値やSignalの中身の型Aを変更する規則ではありません。",
  invalidTitle: "配列の型を変えるには、要素を明示的に変換する",
  invalidBody: "フィールドの多いレコードを含む配列を、フィールドの少ないレコードの配列へそのまま代入すると、型エラーになります。EffectやStreamでも、成功値の型やNever以外の失敗型を勝手に変更することはできません。読み取り専用のSignalに変えても、その中身の型は変わりません。",
  diagnosticsBody: "型エラーが出たら、外側のArrayなどの名前だけでなく、型引数まで見比べてください。要素を変える場合はmap、失敗の値を変える場合はmapErrorなどを使い、どの値をどう変換するかをコードで示します。コンパイラが自動で配列を走査して変換することはありません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "レコードは渡せるのに、その配列は渡せないのはなぜか",
  summary: "nameを持つレコードなら追加のidがあっても渡せますが、そのレコードを含む配列には同じ規則が適用されません。ArrayやListなどの型引数は、通常、完全に一致する必要があります。",
  reading: "usersの要素にはnameとidがあります。nameOnlyはnameだけを持つ新しいレコードを作り、mapが各要素にその処理を適用します。その結果、Array<{ name: String }>の配列ができます。",
  result: "結果には{name: \"Aki\"}が入ります。配列の型を代入だけで変更したのではなく、要素ごとに変換しています。後述のEffectやSignalの変換は限定的な例外です。"
}
