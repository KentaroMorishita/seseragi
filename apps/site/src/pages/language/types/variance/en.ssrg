import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Variance and capability coercions",
  summary: (explanation ()).summary,
  ruleTitle: "Arrays with different element types cannot be substituted directly",
  ruleBody: "Array<{ name: String, id: Int }> and Array<{ name: String }> are different types. Each element of the first has name, but the whole array cannot be used as the second type. Requiring type arguments to match exactly is called invariance. List and user-defined ADTs, structs and newtypes follow this rule too. There are no variance annotations, and the compiler does not infer exceptions from a type declaration's use of its parameters.",
  identityBody: "A function accepting only name can receive a record with name and id. A function accepting Array<{ name: String }> cannot directly receive Array<{ name: String, id: Int }>. The example uses map to construct a new name-only record for each element, explicitly changing the array's element type. Records differing only in field order have the same type.",
  checkingBody: "Some standard types allow limited conversions. Effect and Stream can be used with an environment providing all their required services. Never, meaning no recoverable failure, can be used where another failure type is allowed. MutableSignal<A> can also be passed as read-only Signal<A>. These rules do not change the successful value or Signal's contained A, and other failure types still must match.",
  invalidTitle: "Convert the elements explicitly to change an array's type",
  invalidBody: "An array of wider records cannot be assigned to a narrower-record array without conversion. Changing a recoverable error ADT also requires an explicit mapping; Never's special rule is not an automatic union of errors. Forgetting Signal write capability does not change its contained A.",
  diagnosticsBody: "When a generic mismatch appears, compare all arguments rather than only the record's visible fields. Use map for data conversion, mapError for deliberate error conversion, or the specific capability rule when it genuinely applies. The compiler does not insert collection traversals to make types fit.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Why can a record be passed directly while its array needs an explicit conversion?",
  summary: "A record with an extra id can be passed to a function reading name. Changing an array’s element type requires an explicit per-element conversion.",
  reading: "nameOf only needs name, so it accepts user even though user also has id. labels requires Array<{ name: String }>. nameOnly constructs a fresh name-only record from one user, and map applies that conversion to each element.",
  result: "names now has type Array<{ name: String }> and can be passed to labels. Its map extracts each name as a string. The output is Aki and [Aki]. The original users array has not had its id fields changed or deleted.",
}

pub fn readerCaption -> String =
  "Pass a record directly and explicitly map array elements"

pub fn readerBridgeOne -> String =
  "Requiring the array’s type arguments to match instead of lifting element compatibility to the whole array is called invariance. This is a type-compatibility rule, distinct from immutability, which prevents changing an existing value. map makes the intended element conversion explicit."

pub fn readerBridgeTwo -> String =
  "TypeScript can accept an array of records with an extra id where a name-only element type is expected. Do not carry that rule over to Seseragi Array. pub effect fn main is the execution entry point, and show formats the string array as [Aki]."

pub fn readerInvalidCaption -> String =
  "Change only the array annotation without converting elements"

pub fn readerMistake -> String =
  "Assigning users directly to Array<{ name: String }> produces SES-T0101 identifying the extra id in its element type. Construct the required shape with map nameOnly users, or declare id in the receiver’s type if it actually needs that shape. An annotation does not request an implicit array traversal."

pub fn readerDetailNote -> String =
  "Further rules retain the same restriction for List and user-defined types, alongside limited exceptions for Effect/Stream requirements, Never failures and read-only Signal capabilities. Those exceptions do not freely change success-payload types."

pub fn readerComparison -> String =
  "This TypeScript example also maps to new name-only objects and prints the same two lines. TypeScript additionally accepts a plain assignment such as const view: Named[] = users; that assignment does not delete id from the elements. Distinguish this from Seseragi’s rejection of the corresponding array assignment."

pub fn readerLegacyReading -> String =
  "users is an array of records containing name and id. nameOnly constructs a new record containing just name. map applies that conversion to each element, producing the explicitly requested Array<{ name: String }>."

pub fn readerLegacyResult -> String =
  "The result contains { name: \"Aki\" }. This is an explicit element-by-element transformation, not an assignment that changes the array's type. The special Effect and Signal conversions below are limited exceptions, not a general container rule."

pub fn readerRelated -> String =
  " explains compatibility for one record rather than for the whole array."
