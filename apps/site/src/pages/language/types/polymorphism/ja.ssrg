import { ExplanationCopy } from "../../explanation"
import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "多相性",
  summary: (explanation ()).summary,
  ruleTitle: "同じ関数を複数の型で使う",
  ruleBody: "identity<A>のAは、呼び出しごとに選べる型です。identity TrueはBool、identity 42はIntを返します。このように、一つの関数を異なる型で使える性質を多相性と呼びます。再帰しないletで関数に別名を付けた場合も、その性質を保てる場合があります。",
  identityBody: "仕様で使うforall A. A -> Aは、Aに異なる型を選べることを説明する記法です。ソースにforallを書くわけではありません。型を選び直しても値や関数を複製する操作ではなく、実行中の値を見て処理を切り替える仕組みでもありません。",
  checkingBody: "通常の値は不変なので、再帰しないletには、初期値が単純な値かどうかによる追加の制限を設けません。ただし、再帰する関数同士を検査している間は、各関数に同じ型を使います。再帰グループ全体の検査が済んでから、外の呼び出しで型を選べるようにします。",
  invalidTitle: "呼び出しごとに選べても、一回の呼び出し内で矛盾させない",
  invalidBody: "一回の呼び出しの中では、同じAを使う引数や戻り値の型が一致しなければなりません。必要なtraitの実装も必要です。再帰グループ内の呼び出しで、同じ関数を毎回別の型に変えて使うことはできません。",
  diagnosticsBody: "型が合わない場合は、エラーが出た呼び出しに渡す値と戻り値の型を確認します。再帰の中でだけ失敗する場合は、各呼び出しで型パラメーターを変えていないか確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "一度整数に使った関数を、次に文字列へ使えるか",
  summary: "同じ関数を異なる型で使える性質を多相性と呼びます。呼び出しごとに型を選べることと、一回の呼び出し内で型を揃えることを分けて確認します。",
  reading: "keepFirst<A>は二つのAを受け取り、先に渡した値を返します。let choose = keepFirstは呼び出しではなく、関数に別の名前を付ける宣言です。choose 1 2ではAがInt、choose \"Aki\" \"Mio\"ではAがStringになります。",
  result: "出力は1、Akiです。最初の呼び出しが、後の呼び出しの型までIntに固定することはありません。一方、一回のchooseへ渡す二つの引数は同じ型である必要があります。",
}

pub fn readerCaption -> String = "関数に別名を付け、呼び出しごとに型を選ぶ"

pub fn readerBridgeOne -> String =
  "TypeScriptでもfunction keepFirst<A>(first: A, second: A): Aのようにgeneric関数を書けます。ここで学ぶのは、同じ関数を異なる型で使う関係です。複数の型に対応するために、実行中に値の種類を調べて分岐する必要はありません。"

pub fn readerBridgeTwo -> String =
  "let choose = keepFirstは関数を保存しますが、let number = choose 1 2は呼び出した結果のIntを保存します。numberを後からStringとして使えるわけではありません。pub effect fn mainは公開された出力の入口で、printlnが二つの結果を改行で分けて表示します。"

pub fn readerInvalidCaption -> String = "一回の呼び出しで同じAにIntとStringを渡す"

pub fn readerMistake -> String =
  "keepFirst 1 \"Aki\"では最初の引数でAがIntになり、二つ目のStringがSES-T0101になります。同じ型の二つの値を渡してください。異なる型を受け取るのが目的なら、関数の宣言でAとBを別々に用意する必要があります。"

pub fn readerDetailNote -> String =
  "詳細のidentityも、呼び出しごとに型を選びます。forall A. A -> Aという表記は、その性質を仕様で説明するためのものです。ソースコードにforallを書く構文ではありません。"

pub fn readerLegacyReading -> String =
  "identity<A>は同じA型の値を受け取って返します。identity TrueはBoolのTrue、identity 42はIntの42を返します。Aは型の置き場所で、二つの呼び出しでは独立に決まります。"

pub fn readerLegacyResult -> String =
  "identityの同じAは、一回の呼び出しの中では同じ型を表します。整数を渡して文字列を返すことはできません。仕様のforall A. A -> Aは、呼び出しごとにAを選べるという説明用の記法です。Seseragiのソースにはforallを書きません。"

pub fn readerLimitation -> String =
  "現在のコンパイラでは、let identity = \\value -> valueのように引数の型を省いた短い関数を書くと、その型を推論できない場合があります。最初の例のように型パラメーターを明示したfnを使えます。これは仕様上のletの一般化を否定する規則ではなく、現在の実装の制限です。"

pub fn readerRelated -> String = "では、関数に別名を付ける場合と、関数を引数へ渡す場合の違いを詳しく調べられます。"
