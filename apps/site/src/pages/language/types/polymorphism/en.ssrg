import { TypeCopy } from "../article"

pub fn copy -> TypeCopy = TypeCopy {
  title: "Polymorphism",
  summary: "Generalized declarations are instantiated freshly at each use; forall describes the scheme but is not source syntax.",
  ruleTitle: "One binding, fresh types at every use",
  ruleBody: "A declaration with explicit type parameters and a non-recursive let value may be generalized into a type scheme. let identity = \\value -> value has the specification scheme forall A. A -> A, and separate uses may instantiate A as Int, String, or another type.",
  identityBody: "forall is notation used to explain a scheme, not a Seseragi source keyword. Instantiation creates fresh type variables for checking each use; it does not clone runtime values, attach runtime type objects, or specialize semantics by inspecting a value.",
  checkingBody: "Immutable values and Effect-contained external state allow ordinary non-recursive lets to generalize without a value restriction. Recursive groups remain monomorphic while their members are checked, then generalize only after the whole group succeeds.",
  invalidTitle: "Fresh instantiation is not unresolved ambiguity",
  invalidBody: "A use still fails when its arguments impose inconsistent equations or retained trait constraints lack unique evidence. A recursive member cannot assume a different type for each call while its group is being checked, and forall cannot be written in an ordinary source annotation.",
  diagnosticsBody: "Type errors report the concrete instantiation involved at the failing use while preserving the declaration's generic scheme in tooling. Recursive-group errors identify the monomorphic group boundary rather than degrading later uses to Unknown.",
  provenanceBody: "This article covers specification section 2.5. The highlighted local-rec fixture calls one explicitly generic identity function at Bool and Int, demonstrating fresh use-site instantiation in executable source."
}
