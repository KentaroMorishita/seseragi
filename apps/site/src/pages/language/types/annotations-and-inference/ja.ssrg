import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "型注釈と推論",
  summary: (explanation ()).summary,
  purpose: [
    "引数と戻り値に型を書くと、呼び出す側は本体を調べなくても、何を渡し何を受け取るかを確認できます。関数の実装を変えたときも、その約束に合うか検査できます。型注釈は実行環境の内部の格納形式を選ぶ指定ではありません。",
    "TypeScriptの関数でも引数や戻り値に型を書けます。Seseragiの通常のfnでは両方を明示するのが言語の規則です。型注釈はコードの条件を伝え、値を別の型へ変換する処理はしません。"
  ],
  exampleTitle: "整数に型を書き、足し算の入力と結果を宣言する",
  reading: [
    "途中の->は次の引数へ続きます。fn add left: Int -> right: Int -> Int = ...は、「leftというInt、次にrightというIntを受け取り、Intを返す」と読みます。=以降が本体で、ここでは足し算一つが本体です。値を返すためのreturn文は書きません。",
    "呼び出しは関数名の後へ引数を空白で並べます。add base 2ではleftが20、rightが2になります。let answer = ...はその結果に名前を付ける宣言で、同じ名前へ再代入するものではありません。",
    "pub effect fn mainは、公開された実行入口です。effect fnは画面出力などの処理を表すEffectを返し、実行機構がそれを実行します。show answerは22を表示用の文字列にします。括弧でその呼び出しをまとめ、printlnへ渡すと、文字列と改行が出力されます。"
  ],
  rules: [
    "通常のfnにはすべての引数と戻り値の型、公開するletには値の型を書きます。非公開で再帰しないletでは、右辺から型が決まれば注釈を省略できます。再帰とは関数などが自分自身を参照することで、その関数にも戻り値の型が必要です。",
    "現在の0.61.19では、通常のfnや公開letの注釈不足を検出しない場合があります。受理されても、省略できる言語仕様になったわけではありません。上の例のように必要な型を書いてください。",
    "短いeffect fnは例外です。引数の型を書き、->、with、fails、whereをすべて省くと、戻り値のEffectの型を本体から決めます。これらの語は、順に結果、必要な外部サービス、回復可能な失敗、型が満たす操作の条件を明示するために使います。",
    "たとえば上のmainは、出力処理から必要なEffectの型が分かるため短い形式で書けます。この推論は通常のfnの戻り値を省略する仕組みとは別です。型を一つに決める情報が足りないときは、注釈を補う必要があります。エディターの型表示では、注釈を省いた非公開letの推論結果を確認できます。"
  ],
  mistakes: [
    "次の\"3\"は数字を含む文字列であり、整数ではありません。SES-T0101は、期待するIntと実際のStringを示します。整数の3が必要なら引用符を外してください。文字列が必要なら、値の用途を確かめてStringと書きます。注釈だけを変えても数値への変換は起きません。",
    "通常の関数で引数の型を書き忘れたらleft: Intのように補い、戻り値を書き忘れたら本体の=より前に-> Intを補います。公開する値はpub let count: Int = 3のように書きます。"
  ],
  related: [
    "関数へ引数を渡す書き方を詳しく調べます。",
    "Int、Float、Stringなど、型が表す値を調べます。",
    "一つの関数を複数の型で使う規則を調べます。",
    "effect fnの二つの宣言形式を詳しく調べます。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "値と関数のどこに型を書くか",
  summary: "整数20に2を足す関数を定義します。型注釈は、値や関数が扱う型を明示する書き方です。省略できる場所では、コンパイラが値から型を決めます。",
  reading: "let base: Int = 20の: Intは、baseが整数であるという指定です。fnは関数を定義し、addがその名前です。left: Intとright: Intは整数を受け取る二つの引数で、最後の-> Intが戻り値の型です。",
  result: "=の右側のleft + rightが関数の計算で、その値を返します。add base 2は20と2を渡す呼び出しなので、answerは22です。answerの注釈は省いていますが、addの結果がIntと分かるため、answerもIntになります。このように型を求めることを推論と呼びます。"
}

pub fn title -> String = (copy ()).title
