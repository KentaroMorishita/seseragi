import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Annotations and inference",
  summary: (explanation ()).summary,
  purpose: [
    "Parameter and result types tell callers what to provide and what they receive without reading the body. A changed implementation can still be checked against that promise. An annotation does not select an internal storage representation.",
    "TypeScript functions can also annotate parameters and results. Seseragi’s language rules require both on ordinary fn declarations. An annotation states a condition on the code; it does not perform a conversion."
  ],
  exampleTitle: "Annotate an integer and declare an addition function’s inputs and result",
  reading: [
    "An intermediate -> continues to the next parameter. Read fn add left: Int -> right: Int -> Int = ... as “receive an Int named left, then an Int named right, and return an Int.” The part after = is the body, here a single addition. No return statement is needed.",
    "To call the function, put its arguments after its name, separated by spaces. add base 2 gives left the value 20 and right the value 2. let answer = ... names the result; it does not reassign an existing name.",
    "pub effect fn main is the public execution entry. effect fn returns an Effect describing work such as output, and the runner executes it. show answer converts 22 to display text. Parentheses group that call into the argument to println, which writes the text and a newline."
  ],
  rules: [
    "Write types for every parameter and result of an ordinary fn, and annotate public let declarations. A private, non-recursive let may omit its annotation when its initializer determines the type. Recursion means referring back to a function or other declaration itself; a recursive function also needs a result annotation.",
    "From 0.61.20, the compiler reports an error at ordinary fn and public let declarations that lack required type annotations. Add the parameter, result, or public value type as shown above and in the corrections on this page.",
    "The compact effect fn is an exception. Write its parameter types and omit all of ->, with, fails, and where to infer the returned Effect type from the body. These forms otherwise specify the result, required external services, recoverable failure, and conditions on operations a type supports, respectively.",
    "The main above uses this compact form because its output operation determines the Effect type. This is distinct from omitting the result of an ordinary fn. If there is insufficient information to determine one type, supply annotations. Editor type hovers can show the inferred types of private let declarations."
  ],
  mistakes: [
    "The \"3\" below is a string containing a digit, not an integer. SES-T0101 shows expected Int and actual String. Remove the quotes when you need the integer 3. If text is intended, check its use and annotate it String. Changing only the annotation does not convert text to a number.",
    "If an ordinary function lacks a parameter type, add one as in left: Int. If its result is missing, add -> Int before the body’s =. A public value can be written pub let count: Int = 3."
  ],
  related: [
    "Look up how to supply a function’s arguments.",
    "Find the values represented by Int, Float, String, and the other built-in types.",
    "Find the rules for using one function at several types.",
    "Compare the two effect fn declaration forms."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Where do I write types on values and functions?",
  summary: "Define a function that adds 2 to the integer 20. An annotation states a value’s or function’s type. Where omission is allowed, the compiler determines the type from the value.",
  reading: "In let base: Int = 20, : Int states that base is an integer. fn declares a function, named add. left: Int and right: Int are its two integer parameters; the final -> Int states its return type.",
  result: "The body on the right of = computes left + right and returns that value. add base 2 supplies 20 and 2, so answer is 22. answer has no annotation, but add’s result is Int, so answer is also Int. Determining a type this way is called inference."
}

pub fn title -> String = (copy ()).title
