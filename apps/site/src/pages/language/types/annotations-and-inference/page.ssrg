import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { typePage } from "../article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  typePage "language.types.annotations-and-inference" "/docs/language/types/annotations-and-inference/" (en.copy ()) (ja.copy ()) [
    CodeExample (
      "function-application",
      localized "Annotations and inferred immutable values" "関数に型を書き、letの型は右辺から推論する"
    ),
    BulletList [
      [
        InlineCode "fn add left: Int -> right: Int -> Int",
        Words
          (localized " states every parameter and the return type." " はすべての引数と戻り値の型を明示します。")
      ],
      [
        InlineCode "let base = 20",
        Words (localized " infers a private Int binding." " は非公開のletの型を、右辺からIntと推論します。")
      ],
      [
        InlineCode "let initial: Char",
        Words (localized " checks the initializer against Char." " は初期値がCharか検査します。")
      ]
    ]
  ] [BulletList [
    [
      InlineCode "fn add left -> Int",
      Words (localized " omits the parameter type." " は通常のfnで必要な引数の型を省略しているため、エラーです。")
    ],
    [
      InlineCode "fn add left: Int = left",
      Words (localized " omits the required return type." " は必要な戻り値の型を省略しているため、エラーです。")
    ]
  ]] [
    [InternalLink (localized "Type system" "型システム", "/docs/language/types/type-system/")],
    [InternalLink (localized "Polymorphism" "多相性", "/docs/language/types/polymorphism/")],
    [InternalLink (
      localized "Function application" "関数適用",
      "/docs/language/syntax/function-application/"
    )]
  ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
