import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "パターン照合",
  summary: (explanation ()).summary,
  ruleTitle: "上から順に照合し、最初に一致した分岐を使う",
  ruleBody: "パターンは、値を取り出したり、特定の値かどうかを調べたりする書き方です。リテラル、名前、_、コンストラクター、タプル、レコード、struct、Array、Listのパターンを入れ子にできます。whenの後のガード条件はBoolで、そのパターンから取り出した名前を使えます。どの入力値でも、いずれかの分岐に一致する必要があります。",
  typingBody: "照合する値の型から、各パターンで取り出す値の型が決まります。すべての分岐の結果は同じ型である必要があります。ただし、値を返さないNeverの分岐は例外です。ガード条件は偽になる可能性があるため、その分岐だけでは、すべての場合を扱ったとはみなしません。",
  evaluationBody: "照合する値は一度だけ評価します。分岐をソースの上から順に試し、パターンが一致してガード条件も真になった最初の分岐だけを評価します。その分岐を実行した後に、次の分岐へ処理が続くことはありません。",
  invalidTitle: "ガードが偽になる場合も扱う",
  invalidBody: "コンストラクターが一致していても、ガード条件が偽ならその分岐を使いません。同じコンストラクターを扱うガードなしの分岐か、残りを受け取る分岐を追加してください。先の分岐がすべての値に一致する場合は、後の分岐へ到達できません。",
  diagnosticsBody: "パターンと型の不一致、非公開フィールドの参照、同じ名前の重複束縛、Boolでないガード条件、扱っていない場合、到達できない分岐、結果の型の不一致を報告します。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "発送状態ごとに処理を分け、扱い忘れを見つけるには",
  summary: "matchは値に合う分岐を選び、その分岐の結果を返します。まず二つの発送状態を用意し、それぞれが表示する文を確認します。",
  reading: "DeliveryにはPendingとShipped Stringの二つの選択肢があります。Shipped \"JP42\"は追跡番号を持つ値です。match deliveryの中で、左側に選択肢、->の右側に返す値を書きます。",
  result: "Pendingの結果はnot shipped、Shipped \"JP42\"の結果はtracking: JP42です。Shipped trackingは中の文字列にtrackingと名前を付けます。両方の分岐がStringを返すため、labelもStringを返します。",
}

pub fn readerCaption -> String = "二つの状態を漏れなく表示する"

pub fn readerBridgeOne -> String =
  "TypeScriptでは、オブジェクトにkindのような識別用フィールドを置き、switchで値を調べる書き方ができます。Seseragiのこの例は、PendingとShippedという選択肢の名前を直接調べます。型名Deliveryは値ではなく、その二つをまとめる型です。"

pub fn readerBridgeTwo -> String =
  "分岐の左側で値の形を調べたり中身へ名前を付けたりする書き方を、パターンと呼びます。ここではShipped trackingが一例です。mainは二つの入力をlabelへ渡した結果をprintlnで表示します。複雑な条件付き分岐は後半で扱います。"

pub fn readerInvalidCaption -> String = "Pendingの分岐を忘れる"

pub fn readerMistake -> String =
  "Shippedだけを扱う例は、Pendingのときに返す値がなく、SES-T0301で拒否されます。Pending -> \"not shipped\"を追加してください。最初から_で残りを隠すより、この二つの選択肢を明示すると扱い忘れを見つけやすくなります。"

pub fn readerExecution -> String =
  "pub effect fn mainは、外部へ出力する公開された実行入口です。実行するとmainが開始され、printlnが文字列と改行を出力します。計算やデータの組み立ては、その前の通常の関数やletで行っています。"

pub fn readerDetailNote -> String =
  "ここからの宣言例は、詳しい規則を調べるための断片です。単独では実行入口を持ちません。動かす場合は、上に載せたmain付きの完全な例を使ってください。"
