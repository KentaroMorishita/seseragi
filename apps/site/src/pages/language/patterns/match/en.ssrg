import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Match expressions",
  summary: (explanation ()).summary,
  ruleTitle: "Try branches in order and use the first match",
  ruleBody: "A pattern extracts data or tests for a particular value. Patterns can nest literals, names, _, constructors, tuples, records, structs, Arrays, and Lists. A guard after when must be Bool and can use names extracted by the pattern. Every possible input must match some branch.",
  typingBody: "The input type determines the types extracted by each pattern. All branch results must have the same type, except a Never branch that returns no value. A guard can be false, so that branch alone does not count as handling every value of its case.",
  evaluationBody: "The input is evaluated once. Branches are tried in written order. Only the first matching branch with a true guard is evaluated. Execution does not continue into later branches afterward.",
  invalidTitle: "Handle the case where a guard is false",
  invalidBody: "A matching constructor does not select a branch if its guard is false. Add an unguarded branch for that constructor or a fallback for the remaining values. If an earlier branch matches every value, later branches cannot be reached.",
  diagnosticsBody: "The compiler reports pattern/type mismatches, private field access, duplicate bound names, non-Bool guards, omitted cases, unreachable branches, and different result types.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I handle each delivery state without forgetting a case?",
  summary: "match selects a branch that fits the value and returns its result. Start with two delivery states and check the message produced for each.",
  reading: "Delivery has two alternatives: Pending and Shipped String. Shipped \"JP42\" carries a tracking number. Inside match delivery, write an alternative on the left and the returned value after ->.",
  result: "Pending produces not shipped; Shipped \"JP42\" produces tracking: JP42. Shipped tracking names the contained string tracking. Both branches return String, so label returns String too.",
}

pub fn readerCaption -> String = "Display both delivery states"

pub fn readerBridgeOne -> String =
  "In TypeScript, an ordinary identifying field such as kind can be checked with switch. This Seseragi example directly checks the alternative names Pending and Shipped. Delivery is the type containing those two alternatives, not a value."

pub fn readerBridgeTwo -> String =
  "A pattern is syntax for checking a value’s shape or naming its contents; Shipped tracking is one example. main prints the results of passing both inputs to label. The later sections cover additional branch conditions."

pub fn readerInvalidCaption -> String = "The Pending branch is missing"

pub fn readerMistake -> String =
  "The rejected example only handles Shipped, leaving no result for Pending, so it reports SES-T0301. Add Pending -> \"not shipped\". Listing the two cases explicitly makes omissions easier to notice than immediately hiding the remainder behind _."

pub fn readerExecution -> String =
  "pub effect fn main is the public entry point for work that interacts with the outside world. The runner starts main, and println writes a string and newline. The ordinary functions and let bindings above perform the calculation or construct the data."

pub fn readerDetailNote -> String =
  "The declarations below illustrate the detailed rules. They are fragments without their own entry point. To run this page’s example, use the complete program with main above."
