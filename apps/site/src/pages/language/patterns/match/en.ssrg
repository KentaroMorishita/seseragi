import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Match expressions",
  summary: (explanation ()).summary,
  ruleTitle: "Try branches in order and use the first match",
  ruleBody: "A pattern extracts data or tests for a particular value. Patterns can nest literals, names, _, constructors, tuples, records, structs, Arrays, and Lists. A guard after when must be Bool and can use names extracted by the pattern. Every possible input must match some branch.",
  typingBody: "The input type determines the types extracted by each pattern. All branch results must have the same type, except a Never branch that returns no value. A guard can be false, so that branch alone does not count as handling every value of its case.",
  evaluationBody: "The input is evaluated once. Branches are tried in written order. Only the first matching branch with a true guard is evaluated. Execution does not continue into later branches afterward.",
  invalidTitle: "Handle the case where a guard is false",
  invalidBody: "A matching constructor does not select a branch if its guard is false. Add an unguarded branch for that constructor or a fallback for the remaining values. If an earlier branch matches every value, later branches cannot be reached.",
  diagnosticsBody: "The compiler reports pattern/type mismatches, private field access, duplicate bound names, non-Bool guards, omitted cases, unreachable branches, and different result types.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I handle every case stored in a value?",
  summary: "match selects the first matching branch and returns that branch's result. The compiler checks that no possible input case is missing.",
  reading: "Status has Waiting and Complete carrying Int. Complete count when count > 0 matches only when the extracted count is positive. The following Complete _ also handles counts of zero or less. _ discards the contained value.",
  result: "message (Complete 3) returns \"3 complete\". Complete 0 fails the guarded branch, so the next branch returns \"complete\". Every selected branch returns String."
}
