import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.patterns.match" "/docs/language/patterns/match/" (en.copy ()) (ja.copy ()) [CodeExample
      ("patterns-match", localized "Exhaustive match with a guard" "条件付きの分岐と、残りの値を扱う分岐")] [CodeExample
      (
        "patterns-invalid-match",
        localized "Rejected non-exhaustive match" "扱っていない選択肢があるmatchはエラー"
      )] [
        [InternalLink
      (localized "Binding rules" "束縛の共通規則", "/docs/language/patterns/binding-rules/")],
        [InternalLink (
          localized "Irrefutable patterns" "反駁不能パターン",
          "/docs/language/patterns/irrefutable-patterns/"
        )],
        [InternalLink (
          localized "Algebraic data types" "代数的データ型",
          "/docs/language/data/algebraic-data-types/"
        )]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample (
          "data-reader-alternatives",
          localized (en.readerCaption ()) (ja.readerCaption ())
        ),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Paragraph ([Words (localized (en.readerExecution ()) (ja.readerExecution ()))]),
        Terminal (localized "Output" "実行結果", "not shipped\ntracking: JP42"),
        CodeExample (
          "data-reader-match-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))])
      ],
      [Paragraph ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))])],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
