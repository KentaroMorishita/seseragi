import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  referencePage "language.patterns.match" "/docs/language/patterns/match/" (en.copy ()) (ja.copy ()) [CodeExample
      ("patterns-match", localized "Exhaustive match with a guard" "guardを持つ網羅match")] [CodeExample
      ("patterns-invalid-match", localized "Rejected non-exhaustive match" "非網羅matchを拒否")] [
        [InternalLink
      (localized "Binding rules" "束縛の共通規則", "/docs/language/patterns/binding-rules/")],
        [InternalLink (
          localized "Irrefutable patterns" "反駁不能パターン",
          "/docs/language/patterns/irrefutable-patterns/"
        )],
        [InternalLink (
          localized "Algebraic data types" "代数的データ型",
          "/docs/language/data/algebraic-data-types/"
        )]
      ]
