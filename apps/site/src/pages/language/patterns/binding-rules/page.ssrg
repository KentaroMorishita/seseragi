import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InternalLink,
  PageDefinition,
  Words
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  referencePage "language.patterns.binding-rules" "/docs/language/patterns/binding-rules/" (en.copy ()) (ja.copy ()) [
    CodeExample
      ("patterns-binding-rules", localized "Nested struct binding" "入れ子のstruct binding"),
    BulletList [
      [Words (
        localized "let and effectful for require an irrefutable pattern."
      "letとeffectful forはirrefutable patternを要求します。"
      )],
      [Words (
        localized "match permits refutable patterns and scopes names to one arm."
      "matchはrefutable patternを許可し、nameを一つのarmへscopeします。"
      )],
      [Words (
        localized
      "a comprehension filters values that do not match its generator pattern."
      "comprehensionはgenerator patternに一致しない値を除外します。"
      )]
    ]
  ] [CodeExample
      ("patterns-invalid-binding", localized "Rejected refutable let" "refutableなletを拒否")] [
        [InternalLink (
          localized "Irrefutable patterns" "irrefutable pattern",
          "/docs/language/patterns/irrefutable-patterns/"
        )],
        [InternalLink
      (localized "Match expressions" "match式", "/docs/language/patterns/match/")],
        [InternalLink (
          localized "Blocks and local declarations" "blockとlocal declaration",
          "/docs/language/expressions/blocks-and-local-declarations/"
        )]
      ]
