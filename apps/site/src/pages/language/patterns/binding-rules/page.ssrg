import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InternalLink,
  PageDefinition,
  Words,
  Paragraph,
  Terminal
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.patterns.binding-rules" "/docs/language/patterns/binding-rules/" (en.copy ()) (ja.copy ()) [
    CodeExample
      ("patterns-binding-rules", localized "Unpack struct fields" "structのフィールドから値を取り出す"),
    BulletList [
      [Words (
        localized "let and effectful for require an irrefutable pattern."
      "letとEffect内のforには、必ず一致するパターンを使います。"
      )],
      [Words (
        localized "match permits refutable patterns and scopes names to one arm."
      "matchには失敗しうるパターンも使えます。取り出した名前は、その分岐の中だけで使えます。"
      )],
      [Words (
        localized
      "a comprehension filters values that do not match its generator pattern."
      "内包表記では、取り出し用のパターンに合わない要素を除外します。"
      )]
    ]
  ] [CodeExample (
    "patterns-invalid-binding",
    localized "Rejected refutable let" "失敗しうるパターンをletに使うとエラー"
  )] [
    [InternalLink (
      localized "Irrefutable patterns" "反駁不能パターン",
      "/docs/language/patterns/irrefutable-patterns/"
    )],
    [InternalLink
      (localized "Match expressions" "パターン照合", "/docs/language/patterns/match/")],
    [InternalLink (
      localized "Blocks and local declarations" "ブロックとローカル宣言",
      "/docs/language/expressions/blocks-and-local-declarations/"
    )]
  ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample
          ("data-reader-binding", localized (en.readerCaption ()) (ja.readerCaption ())),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Paragraph ([Words (localized (en.readerExecution ()) (ja.readerExecution ()))]),
        Terminal (localized "Output" "実行結果", "Aki: 42"),
        CodeExample (
          "data-reader-binding-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))])
      ],
      [Paragraph ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))])],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
