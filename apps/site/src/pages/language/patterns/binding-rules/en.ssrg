import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Binding rules",
  summary: (explanation ()).summary,
  ruleTitle: "Give names to parts of one input value",
  ruleBody: "A pattern on the left of let extracts parts from the right-hand value and gives them names. This is called binding. Patterns are also used in do, match branches, comprehensions, and Effect for loops. The input type determines each name's type. The syntax determines where the names can be used and whether a pattern may fail to match.",
  typingBody: "A pattern annotation specifies the type of the complete input. Types of names inside the pattern follow from it. One name cannot be defined twice in the same pattern. While computing the right side, names newly introduced on the left are not yet available.",
  evaluationBody: "The input is computed once even when extracting nested tuples or records. All extracted names become available after the match succeeds. Names from a failed match branch cannot be used in another branch.",
  invalidTitle: "Use only guaranteed matches in let",
  invalidBody: "A pattern demanding the first array element does not match an empty array. It is not allowed in let even if this particular value is known to be nonempty. Use match to handle failure. A comprehension can use such a pattern to filter out nonmatching elements.",
  diagnosticsBody: "Check the input type, fields and number of elements, duplicate names, and whether the pattern can fail. Names are available only within the scope of their block or branch.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I unpack object fields into local names?",
  summary: "Writing fields on the left of let gives names to a record’s contents. Introducing names this way is called binding.",
  reading: "person is a record with name and score. let { name, score: points } = person keeps the name field’s name and takes score into a local name called points.",
  result: "The output is Aki: 42. The original field remains score; the local name is points. Naming its contents does not modify the input record.",
}

pub fn readerCaption -> String = "Unpack score under the name points"

pub fn readerBridgeOne -> String =
  "This resembles TypeScript object destructuring. In score: points, the left side is the field name and the right side is the new local name. { name } abbreviates { name: name }."

pub fn readerBridgeTwo -> String =
  "name and points are available after the let through the end of this function block. ${name} and ${points} insert them into a backtick string, which main passes to println."

pub fn readerInvalidCaption -> String = "Naming two values identically"

pub fn readerMistake -> String =
  "{ name, score: name } introduces name twice and reports SES-N0002. Use a different name such as score: points. Reusing an outer name in a new scope differs from duplicating a name in one pattern."

pub fn readerExecution -> String =
  "pub effect fn main is the public entry point for work that interacts with the outside world. The runner starts main, and println writes a string and newline. The ordinary functions and let bindings above perform the calculation or construct the data."

pub fn readerDetailNote -> String =
  "The declarations below illustrate the detailed rules. They are fragments without their own entry point. To run this page’s example, use the complete program with main above."
