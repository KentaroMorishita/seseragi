import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "束縛の共通規則",
  summary: (explanation ()).summary,
  ruleTitle: "一つの入力値に対して名前を付ける",
  ruleBody: "letなどの左側にパターンを書くと、右側の値から中身を取り出して名前を付けられます。この操作を束縛と呼びます。do、matchの分岐、内包表記、Effectのforでもパターンを使えます。各名前の型は入力型から決まります。失敗しうるパターンを使えるかと、名前を使える範囲は構文ごとに異なります。",
  typingBody: "パターンの型注釈は、取り出す入力全体の型を指定します。中の名前の型はそこから決まります。同じパターン内で、一つの名前を二度定義することはできません。右辺を計算する時点では、これから左辺に付ける名前もまだ使えません。",
  evaluationBody: "入れ子のタプルやレコードを取り出す場合も、入力の値は一度だけ計算します。照合に成功してから、取り出したすべての名前が使えるようになります。matchで一致しなかった分岐の名前は、ほかの分岐では使えません。",
  invalidTitle: "letには、必ず一致するパターンだけを使う",
  invalidBody: "例えば配列の先頭を取り出すパターンは、空配列には一致しません。実際に渡す値が空でないと分かっていても、letでは使えません。失敗する場合も扱うにはmatchを使います。内包表記なら、一致しない要素を除外する用途で使えます。",
  diagnosticsBody: "入力の型、フィールドや要素の数、同名の名前、パターンが失敗しうるかを確認してください。名前が使えるのは、その束縛が属するブロックや分岐の範囲内だけです。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "値の一部を取り出して名前を付けるには",
  summary: "パターンを使うと、一つの値から中身を取り出して名前を付けられます。その名前を使える範囲は、letやmatchなどの書き方で決まります。",
  reading: "letの左側のPlayer { name, score }で、右側のPlayerから対応するフィールドを取り出します。nameは\"Aki\"、scoreは42です。パターンを入れ子にすれば、さらに中の値も取り出せます。",
  result: "summaryは(\"Aki\", 42)です。Playerには宣言したnameとscoreが必ずあるため、letで取り出せます。値によって一致しないパターンを使う場合は、matchで一致しない場合も扱ってください。"
}
