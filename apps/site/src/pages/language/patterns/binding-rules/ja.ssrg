import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "束縛の共通規則",
  summary: (explanation ()).summary,
  ruleTitle: "一つの入力値に対して名前を付ける",
  ruleBody: "letなどの左側にパターンを書くと、右側の値から中身を取り出して名前を付けられます。この操作を束縛と呼びます。do、matchの分岐、内包表記、Effectのforでもパターンを使えます。各名前の型は入力型から決まります。失敗しうるパターンを使えるかと、名前を使える範囲は構文ごとに異なります。",
  typingBody: "パターンの型注釈は、取り出す入力全体の型を指定します。中の名前の型はそこから決まります。同じパターン内で、一つの名前を二度定義することはできません。右辺を計算する時点では、これから左辺に付ける名前もまだ使えません。",
  evaluationBody: "入れ子のタプルやレコードを取り出す場合も、入力の値は一度だけ計算します。照合に成功してから、取り出したすべての名前が使えるようになります。matchで一致しなかった分岐の名前は、ほかの分岐では使えません。",
  invalidTitle: "letには、必ず一致するパターンだけを使う",
  invalidBody: "例えば配列の先頭を取り出すパターンは、空配列には一致しません。実際に渡す値が空でないと分かっていても、letでは使えません。失敗する場合も扱うにはmatchを使います。内包表記なら、一致しない要素を除外する用途で使えます。",
  diagnosticsBody: "入力の型、フィールドや要素の数、同名の名前、パターンが失敗しうるかを確認してください。名前が使えるのは、その束縛が属するブロックや分岐の範囲内だけです。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "オブジェクトのフィールドを、手元の名前へ取り出すには",
  summary: "letの左側にフィールドを書くと、レコードの中身へ名前を付けられます。値を取り出して名前を導入する操作を、束縛と呼びます。",
  reading: "personはnameとscoreを持つレコードです。let { name, score: points } = personは、nameをそのままの名前で、scoreをpointsという名前で取り出します。",
  result: "出力はAki: 42です。元のフィールド名はscoreのままで、関数内の名前がpointsになります。名前を付けても、入力のレコードを書き換えるわけではありません。",
}

pub fn readerCaption -> String = "得点をpointsという名前で取り出す"

pub fn readerBridgeOne -> String =
  "TypeScriptのオブジェクトの分割代入に似た書き方です。score: pointsの左がフィールド名、右がこれから使う名前です。{ name }は{ name: name }の省略形です。"

pub fn readerBridgeTwo -> String =
  "letで作ったnameとpointsは、宣言の後からこの関数のブロック末尾まで使えます。バッククォート内の${name}と${points}で表示用の文字列を作り、mainでprintlnに渡します。"

pub fn readerInvalidCaption -> String = "二つの値へ同じ名前を付ける"

pub fn readerMistake -> String =
  "{ name, score: name }はnameを二度作るためSES-N0002です。score: pointsのように別の名前を使います。外側の名前と同じものを新しく作ることと、一つのパターンで名前を重複させることは別です。"

pub fn readerExecution -> String =
  "pub effect fn mainは、外部へ出力する公開された実行入口です。実行するとmainが開始され、printlnが文字列と改行を出力します。計算やデータの組み立ては、その前の通常の関数やletで行っています。"

pub fn readerDetailNote -> String =
  "ここからの宣言例は、詳しい規則を調べるための断片です。単独では実行入口を持ちません。動かす場合は、上に載せたmain付きの完全な例を使ってください。"
