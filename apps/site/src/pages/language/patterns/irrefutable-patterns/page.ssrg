import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  BulletList,
  CodeExample,
  InlineCode,
  InternalLink,
  PageDefinition,
  Words,
  Paragraph,
  Terminal
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.patterns.irrefutable-patterns" "/docs/language/patterns/irrefutable-patterns/" (en.copy ()) (ja.copy ()) [
    CodeExample
      ("patterns-irrefutable", localized "Bindings that cannot fail" "必ず一致するパターンで値を取り出す"),
    BulletList [
      [
        InlineCode "name",
        Words (localized " and " " と "),
        InlineCode "_",
        Words (localized " always match." " は常に一致します。")
      ],
      [Words (
        localized "Product patterns inherit refutability from every nested pattern."
      "タプルやレコードの中に失敗しうるパターンが一つでもあれば、全体も失敗する可能性があります。"
      )],
      [Words (
        localized "Only a rest-only Array or List pattern matches every length."
      "全要素をまとめて受け取るArrayやListのパターンは、空を含めどの長さにも一致します。"
      )]
    ]
  ] [CodeExample (
    "patterns-invalid-irrefutable",
    localized "Rejected length-dependent binding" "空や短い配列に一致しないパターンをletに使うとエラー"
  )] [
    [InternalLink
      (localized "Binding rules" "束縛の共通規則", "/docs/language/patterns/binding-rules/")],
    [InternalLink
      (localized "Match expressions" "パターン照合", "/docs/language/patterns/match/")],
    [InternalLink (
      localized "Tuples, arrays, and lists" "タプル・配列・リスト",
      "/docs/language/data/tuples-arrays-and-lists/"
    )]
  ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample (
          "data-reader-irrefutable",
          localized (en.readerCaption ()) (ja.readerCaption ())
        ),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Paragraph ([Words (localized (en.readerExecution ()) (ja.readerExecution ()))]),
        Terminal (localized "Output" "実行結果", "Notebook: 2\n0\n10"),
        CodeExample (
          "data-reader-irrefutable-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))])
      ],
      [Paragraph ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))])],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
