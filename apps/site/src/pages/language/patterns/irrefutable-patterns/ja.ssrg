import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "反駁不能パターン",
  summary: (explanation ()).summary,
  ruleTitle: "必ず一致するかは、入力の型から判断する",
  ruleBody: "名前だけのパターンと_は、どの入力にも一致します。タプル、レコード、structの分解は、中のすべてのパターンが必ず一致すれば使えます。選択肢が一つだけの代数的データ型やnewtypeも、中身を必ず取り出せるパターンなら同様です。",
  typingBody: "配列やListには、空の値や異なる長さの値があります。そのため、特定の要素数を要求するパターンは必ず一致するとは言えません。全要素を残りの要素としてまとめて受け取るパターンなら、長さに依存せず一致します。",
  evaluationBody: "必ず一致するかどうかは、実行する前に型から判断します。letを実行したときに一致失敗の検査を追加する方式ではありません。分解する値は一度だけ計算します。",
  invalidTitle: "今回の値に一致することと、必ず一致することは違う",
  invalidBody: "let [head, ...tail] = valuesは、valuesが空かもしれないため使えません。matchで空の場合も扱うか、Maybeを返すライブラリの操作を使います。先頭を取り出す必要がなければ、[...all]で全要素を受け取れます。",
  diagnosticsBody: "必ず一致することが必要な場所で失敗しうるパターンを使うと、パターン全体を指すエラーになります。まず入力の型と形が合っているかを確認し、その後で空や別の選択肢にも一致するか考えてください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "letでタプルは取り出せるのに、配列の先頭は要求できないのはなぜか",
  summary: "反駁不能パターンは、入力型のすべての値に必ず一致するパターンです。letに失敗時の分岐が不要なのは、その性質があるためです。",
  reading: "UserIdには必ず中の整数があり、(String, Int)のタプルには必ず二つの位置があります。例では存在を検査せずに、letでrawId、name、scoreを取り出せます。",
  result: "identityは(42, \"Aki\", 100)です。Arrayは空の場合があるため、[head, ...tail]は必ず一致するとは限りません。空の場合も扱うmatchやMaybeを返す操作を使います。"
}
