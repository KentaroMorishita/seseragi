import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "反駁不能パターン",
  summary: (explanation ()).summary,
  ruleTitle: "必ず一致するかは、入力の型から判断する",
  ruleBody: "名前だけのパターンと_は、どの入力にも一致します。タプル、レコード、structのパターンは、中のすべてのパターンが必ず一致すれば使えます。選択肢が一つだけの代数的データ型やnewtypeも、中身のパターンが必ず一致する場合は同様です。これらを反駁不能パターンと呼びます。",
  typingBody: "配列やListには、空の値や異なる長さの値があります。そのため、特定の要素数を要求するパターンは必ず一致するとは言えません。全要素を残りとして受け取るパターンなら、長さに依存せず一致します。特定のリテラルや、複数ある選択肢の一つだけを要求するパターンも、必ず一致するとは言えません。",
  evaluationBody: "必ず一致するかどうかは、実行前に入力型から判断します。letやEffectのforでは、実行中に一致するかを試すのではなく、必ず一致するパターンを使います。分解する値は一度だけ計算します。",
  invalidTitle: "今回の値に一致することと、必ず一致することは違う",
  invalidBody: "let [head, ...tail] = valuesは、valuesが空かもしれないため使えません。matchで空の場合も扱うか、Maybeを返すライブラリの操作を使います。先頭を取り出す必要がなければ、[...all]で全要素を受け取れます。",
  diagnosticsBody: "必ず一致することが必要な場所で失敗しうるパターンを使うと、パターン全体を指すエラーになります。まず入力の型と形が合っているかを確認し、その後で空や別の選択肢にも一致するか考えてください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "二つ組はletで取り出せるのに、配列の先頭は取り出せないのはなぜか",
  summary: "letで使える取り出し方は、入力型のどの値でも必ず成功するものです。これを反駁不能パターンと呼びます。今回の値がたまたま合うかではなく、型にあり得る形を考えます。",
  reading: "(String, Int)の二つ組には必ず文字列と整数があります。let (name, count) = pairで両方を取り出せます。一方、Array<Int>には空配列もあるため、先頭があるとは限りません。",
  result: "出力はNotebook: 2、0、10です。firstOrZeroはmatchで[]を0にし、[first, ...rest]なら先頭を返します。restには残りが入りますが、この例では使いません。",
}

pub fn readerCaption -> String = "必ずある位置と、ないかもしれない位置"

pub fn readerBridgeOne -> String =
  "(name, count)のように中身を取り出す書き方がパターンです。letには、取り出せなかった場合の分岐を書く場所がありません。固定の二つ組なら両方の位置があると分かります。"

pub fn readerBridgeTwo -> String =
  "matchは入力の形ごとに処理を分けられます。[]は空配列、[first, ...rest]は一つ以上ある配列に合います。_は中身に名前を付けずに受け取り、[...all]なら長さを問わず配列全体を受け取れます。"

pub fn readerInvalidCaption -> String = "非空の配列リテラルでも先頭だけをletで要求する"

pub fn readerMistake -> String =
  "let [first, ...rest] = [10, 20]もSES-T0101です。入力型Array<Int>には空の値もあるため、letでは使えません。上のfirstOrZeroのようにmatchで空の場合も書きます。"

pub fn readerExecution -> String =
  "pub effect fn mainは、外部へ出力する公開された実行入口です。実行するとmainが開始され、printlnが文字列と改行を出力します。計算やデータの組み立ては、その前の通常の関数やletで行っています。"

pub fn readerDetailNote -> String =
  "ここからの宣言例は、詳しい規則を調べるための断片です。単独では実行入口を持ちません。動かす場合は、上に載せたmain付きの完全な例を使ってください。"
