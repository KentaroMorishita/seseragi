import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Irrefutable patterns",
  summary: "An irrefutable pattern is guaranteed to match every value of its checked input type.",
  ruleTitle: "Irrefutability is a property of shape and type",
  ruleBody: "Names and wildcards always match. Tuples, records, and structs are irrefutable when every nested pattern is. A single-constructor ADT or newtype constructor is irrefutable when its payload pattern is.",
  typingBody: "Only collection patterns that bind the entire collection as rest are irrefutable. Literals, fixed collection elements, and constructors from multi-variant ADTs remain refutable even when an example value matches.",
  evaluationBody: "Checking irrefutability is compile-time reasoning; it does not insert a runtime test into let or effectful for. Destructuring still evaluates the input once.",
  invalidTitle: "A likely match is still refutable",
  invalidBody: "let [head, ...tail] = values is rejected because an Array may be empty. Use match, a total library operation returning Maybe, or bind [...all] when no length test is needed.",
  diagnosticsBody: "A forbidden refutable binding points at the complete pattern. Shape, tuple arity, field, constructor payload, and element-type mismatches are reported before refutability is accepted.",
}
