import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Irrefutable patterns",
  summary: (explanation ()).summary,
  ruleTitle: "The input type determines whether a pattern always matches",
  ruleBody: "A name or _ always matches. Tuple, record, and struct patterns always match if all their nested patterns do. The same applies to a single-constructor algebraic data type or a newtype when its payload pattern always matches. These are called irrefutable patterns.",
  typingBody: "Arrays and Lists can be empty or have different lengths. A pattern requiring a particular number of elements is therefore not guaranteed to match. A pattern taking all elements as rest matches regardless of length. A specific literal or one alternative of a multi-variant type is also not guaranteed to match.",
  evaluationBody: "The compiler determines from the input type whether a pattern always matches. let and Effect for use guaranteed patterns rather than testing for failure during execution. The input is still computed once.",
  invalidTitle: "Matching this value differs from matching every possible value",
  invalidBody: "let [head, ...tail] = values is rejected because values may be empty. Use match to handle empty input, or a library operation returning Maybe. If you do not need a first element, [...all] takes all elements.",
  diagnosticsBody: "A pattern that may fail in a guaranteed-match position causes an error pointing to the complete pattern. First check whether its shape fits the input type, then whether it also matches empty values or other alternatives.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Why can let unpack a pair but not require an array’s first element?",
  summary: "A let pattern must succeed for every value of the input type. This is called an irrefutable pattern. The question is which shapes the type permits, not whether today’s value happens to fit.",
  reading: "A (String, Int) pair always has a string and an integer, so let (name, count) = pair can unpack both. Array<Int> also permits an empty array, so a first element is not guaranteed.",
  result: "The output is Notebook: 2, 0 and 10. firstOrZero uses match to return 0 for [] or first for [first, ...rest]. rest receives the remaining elements, which this example does not use.",
}

pub fn readerCaption -> String = "Guaranteed positions and possibly missing positions"

pub fn readerBridgeOne -> String =
  "Syntax such as (name, count) that takes a value apart is a pattern. let has no branch for a failed extraction. A fixed pair guarantees both positions."

pub fn readerBridgeTwo -> String =
  "match can handle different input shapes. [] fits an empty array, while [first, ...rest] fits one or more elements. _ accepts a value without naming it; [...all] takes the entire array regardless of length."

pub fn readerInvalidCaption -> String =
  "Requiring a first element even from a nonempty literal"

pub fn readerMistake -> String =
  "let [first, ...rest] = [10, 20] still reports SES-T0101. Array<Int> permits empty values, so this is not a let pattern. Handle the empty case with match, as firstOrZero does above."

pub fn readerExecution -> String =
  "pub effect fn main is the public entry point for work that interacts with the outside world. The runner starts main, and println writes a string and newline. The ordinary functions and let bindings above perform the calculation or construct the data."

pub fn readerDetailNote -> String =
  "The declarations below illustrate the detailed rules. They are fragments without their own entry point. To run this page’s example, use the complete program with main above."
