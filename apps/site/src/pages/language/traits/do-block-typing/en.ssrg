import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Typing a do block",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "customer in customer <- name is String. quantity in quantity <- count is Int. <- passes the present payload rather than naming the whole Maybe.",
    "show quantity converts the integer to text before concatenation. The final pure expression wraps the string as Maybe<String>, so that is also the whole do block’s type.",
    "In the general notation M<A>, M is Maybe here and A is that line’s payload type. A can change between lines, while M must remain consistent within one do block."
  ], rules: [
    "The first bind, final expression or expected surrounding type determines the outer M. If mx is M<A>, x in x <- mx is A. A final M<R> makes the whole block M<R>. Ordinary let declarations alone do not determine M; add a result annotation when information is missing.",
    "A bound name is available after its line through the end of the block. Different payload types still use the same selected Monad sequencing rule.",
    "Effect do blocks also work, with compatible environment requirements and recoverable failure types. Task<A> aliases Effect<{}, Never, A>, but do is not restricted to Task. Effect can represent service-requiring or fallible work too.",
    "To move into Effect, explicitly use a conversion such as std/effect.fromEither. Align different failure types with operations such as mapError. Never cannot produce a recoverable failure, and the specification defines cases for widening an Effect failure type. In the tested compiler, that widening can fail at a do block’s final expression; make the expression types explicitly consistent."
  ], mistakes: [
    "Replacing the final pure with Right produces a different outer type, Either. Either uses Left for failure and Right for success; these are not Maybe’s Just and Nothing. Check SES-T0101, Do monad constructor mismatch, and restore pure.",
    "An ordinary let does not convert Maybe to Either or Effect. Decide how absence should become failure, for example, then explicitly use an appropriate conversion before sequencing the same kind of computation."
  ], related: [
    "Return to the concrete example that stops when an address part is missing.",
    "Check ordering and absence handling when do is written with flatMap.",
    "See how a shared function requires operations with where."
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String = "Outer types, final expressions and Effect requirements"
pub fn mistakesTitle -> String = "Do not mix Right and Just as one kind of computation"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Can one do block extract both a string and an integer?",
  summary: "The payloads may differ, such as String and Int. What stays the same here is the outer Maybe, which represents whether each value is present.",
  reading: "A shipping label uses a name and quantity. name has type Maybe<String>, and count has type Maybe<Int>. The function extracts both and returns a Maybe<String> label.",
  result: "Aki and 2 display as Just Aki: 2; a missing quantity displays as Nothing. Each value’s presence follows the same rule without forcing all intermediate payloads to have one type."
}
