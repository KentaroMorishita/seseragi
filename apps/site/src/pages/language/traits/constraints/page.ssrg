import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  referencePage "language.traits.constraints" "/docs/language/traits/constraints/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "traits-constraints",
        localized "A constrained generic function" "constraint付きgeneric関数"
      )] [CodeExample
      ("traits-invalid-constraint", localized "Missing concrete evidence" "具体的evidenceの欠落")] [
        [InternalLink
      (localized "Polymorphism" "多相性", "/docs/language/types/polymorphism/")],
        [InternalLink (
          localized "Calling trait methods" "traitメソッドの呼び出し",
          "/docs/language/traits/method-calls/"
        )],
        [InternalLink
      (localized "Instances" "インスタンス", "/docs/language/traits/instances/")]
      ]
