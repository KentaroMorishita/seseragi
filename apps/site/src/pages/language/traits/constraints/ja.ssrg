import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "trait制約",
  summary: (explanation ()).summary,
  ruleTitle: "共通の関数で必要な操作をwhereに書く",
  ruleBody: "where Label<A>は、A型にlabelの実装が必要という条件です。ジェネリック関数は、その条件のもとでlabelを呼べます。関数を使う側は、Labelのinstanceがある型をAに選びます。選んだinstanceがさらに別のtraitを条件にしていれば、その実装も必要です。",
  typingBody: "コンパイラは、具体的な呼び出しに必要なinstanceが一つに決まるか検査します。instanceは値の中身ではなく型で選びます。空のコレクションやNothingにも要素の型があるため、その型に対する条件は残ります。",
  evaluationBody: "whereは型の条件であり、処理を実行する式ではありません。関数の本体でlabelなどの操作を呼ぶと、型に対応するinstanceの実装が実行されます。",
  invalidTitle: "空の値でも、型に必要な条件は残る",
  invalidBody: "操作を使わない分岐を通るとしても、宣言した条件は必要です。条件付きinstanceが要求する別の実装まで揃わなければ、型エラーになります。",
  diagnosticsBody: "エラーでは、どの型に対するどのtraitが不足しているか確認してください。instanceが別のtraitを必要とする場合は、その条件も確認します。型自体が未確定なら、型注釈や型引数で補ってから、対応するinstanceを調べます。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "ジェネリック関数からtraitの操作を呼ぶには",
  summary: "whereの制約で、型パラメーターに必要な操作を指定します。ジェネリック関数は、すべての型に表示や比較の操作があるとは仮定できません。",
  reading: "describe<A>はlabel valueに接頭辞を付けます。where Label<A>により、本体でlabelを使え、呼び出し側はLabelの実装がある型を選びます。Badgeには実装があるため、describe Readyを呼べます。",
  result: "descriptionは\"badge: ready\"です。別の型もLabelのinstanceを用意すれば、この関数を使えます。実装がない型を渡すと実行前にエラーになり、任意の値の表示方法を勝手に推測しません。"
}
