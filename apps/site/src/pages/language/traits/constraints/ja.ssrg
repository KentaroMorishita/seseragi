import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "trait制約",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "<A>は呼び出しで決まる型です。value: Aが引数、-> Stringが戻り値で、whereの後は必要な操作の条件です。whereは値を判定するifではありません。",
    "Show<Ticket>のinstanceは、Ticketのnumberを読んで文字列を返します。describe ticketではAがTicketになるため、この実装が必要です。",
    "describe [ticket]ではAはArray<Ticket>です。配列全体の表示にも、その中のTicketを表示する実装が必要です。入れ子の型にも同じように条件を確認します。"
  ], rules: [
    "where Show<A>は、A型にshowの実装が必要という条件です。ジェネリック関数は、その条件のもとでshowを呼べます。関数を使う側は、Showのinstanceがある型をAに選びます。選んだinstanceがさらに別のtraitを条件にしていれば、その実装も必要です。",
    "コンパイラは、具体的な呼び出しに必要なinstanceが一つに決まるか検査します。instanceは値の中身ではなく型で選びます。空のコレクションやNothingにも要素の型があるため、その型に対する条件は残ります。",
    "whereは型の条件であり、処理を実行する式ではありません。関数の本体でshowなどの操作を呼ぶと、型に対応するinstanceの実装が実行されます。",
    "操作を使わない分岐を通るとしても、宣言した条件は必要です。条件付きinstanceが要求する別の実装まで揃わなければ、型エラーになります。",
    "エラーでは、どの型に対するどのtraitが不足しているか確認してください。instanceが別のtraitを必要とする場合は、その条件も確認します。型自体が未確定なら、型注釈や型引数で補ってから、対応するinstanceを調べます。"
  ], mistakes: [
    "空配列なら中身を表示しないので安全、とは限りません。次のticketsはArray<Ticket>と注釈してありますが、Show<Ticket>がありません。SES-T0201は、この足りない要素型の実装を報告します。",
    "最初の例のinstance Show<Ticket>を追加すると、空配列の例はvalue: []を出力します。空かどうかという値の状態で、型に付けた条件を省くことはできません。"
  ], related: [
    "操作の宣言と型ごとの実装を、小さな例で確認できます。",
    "型ごとの本体をどこに書くか確認できます。",
    "traitの関数を呼び、引数を一部だけ渡す方法を確認できます。"
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String = "条件は型で確かめ、入れ子にも引き継ぐ"
pub fn mistakesTitle -> String = "空配列でも要素型の条件は必要"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "型を決めずに書く関数からshowを呼ぶには",
  summary: "where Show<A>は「Aを文字列にできること」という条件です。関数はその条件のもとでshowを呼び、使う側が対応する型を渡します。",
  reading: "describe<A>は、型を一つに固定せずに値の前へvalue:を付けます。どんな型でも表示できるとは限らないため、where Show<A>でshowの実装を要求しています。",
  result: "Ticketを渡すとvalue: ticket-42、Ticketの配列を渡すとvalue: [ticket-42]です。配列の標準Showは、要素のShow<Ticket>を使います。共通のdescribeはデータの項目を知る必要がありません。"
}
