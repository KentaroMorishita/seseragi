import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Trait constraints",
  summary: (explanation ()).summary,
  ruleTitle: "Use where to state the operations a shared function needs",
  ruleBody: "where Label<A> requires a label implementation for A. A generic function can call label under that condition. Its caller chooses an A with a Label instance. If that instance requires another trait, the corresponding implementation is required too.",
  typingBody: "The compiler checks that a concrete call has one applicable instance for each requirement. Types, not value contents, select instances. An empty collection or Nothing still has an element type, so constraints on that type remain.",
  evaluationBody: "where is a type requirement, not an expression that executes work. Calling an operation such as label in the function body executes the implementation from the instance selected for the type.",
  invalidTitle: "Values cannot waive a constraint",
  invalidBody: "A branch that happens not to inspect an element, an empty container, or a particular constructor does not remove its declared requirement. Missing recursive leaf evidence remains a type error.",
  diagnosticsBody: "Check which trait is missing for which type. If an instance requires another trait, inspect that condition too. If the type itself is unresolved, supply an annotation or type argument before looking for the matching instance.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can a generic function call a trait operation?",
  summary: "A where constraint states which operations must exist for a type parameter. Without it, a generic function cannot assume every type has a label or comparison operation.",
  reading: "describe<A> adds a prefix to label value. where Label<A> gives its body permission to call label and requires the caller to choose a type with that implementation. Badge has a Label instance, so describe Ready is accepted.",
  result: "description is \"badge: ready\". A different type can use the same function after supplying its Label instance. Without such an instance, the call is rejected before execution; the compiler does not guess how to label an arbitrary value."
}
