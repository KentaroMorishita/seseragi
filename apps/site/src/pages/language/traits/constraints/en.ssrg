import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Trait constraints",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "<A> is a type chosen at each call. value: A is the argument, -> String is the result, and where lists required operations. It is not an if condition on a runtime value.",
    "The Show<Ticket> instance reads number and returns text. In describe ticket, A is Ticket, so that instance is required.",
    "In describe [ticket], A is Array<Ticket>. Displaying the array also requires a way to display Ticket elements. Requirements are checked through nested types in the same way."
  ], rules: [
    "where Show<A> requires a show implementation for A. A generic function can call show under that condition. Its caller chooses an A with a Show instance. If that instance requires another trait, the corresponding implementation is required too.",
    "The compiler checks that a concrete call has one applicable instance for each requirement. Types, not value contents, select instances. An empty collection or Nothing still has an element type, so constraints on that type remain.",
    "where is a type requirement, not an expression that executes work. Calling an operation such as show in the function body executes the implementation from the instance selected for the type.",
    "A branch that happens not to inspect an element, an empty container, or a particular constructor does not remove its declared requirement. If a nested requirement ultimately has no matching instance, it remains a type error.",
    "Check which trait is missing for which type. If an instance requires another trait, inspect that condition too. If the type itself is unresolved, supply an annotation or type argument before looking for the matching instance."
  ], mistakes: [
    "An empty array still has an element type. The rejected tickets value is annotated Array<Ticket>, but Show<Ticket> is missing. SES-T0201 reports that specific missing element implementation.",
    "Add instance Show<Ticket> from the first example and the empty-array file prints value: []. Whether a value is empty does not remove a requirement on its type."
  ], related: [
    "See a small example of operation declarations and type-specific implementations.",
    "Check where to write the body for a particular type.",
    "Check trait calls and supplying arguments in stages."
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String = "Check requirements by type, including nested types"
pub fn mistakesTitle -> String = "Empty arrays still require the element implementation"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can a function call show without fixing its argument type?",
  summary: "where Show<A> requires a way to turn A into text. The function can use show under that condition, and callers supply a type with the required implementation.",
  reading: "describe<A> adds value: before a value without choosing a single argument type. Not every type can necessarily be displayed, so where Show<A> requires an implementation of show.",
  result: "A Ticket produces value: ticket-42; an array of tickets produces value: [ticket-42]. The standard Array Show implementation uses Show<Ticket> for its elements. The shared describe function need not know the data’s fields."
}
