import { localized } from "../../../../model/locale"
import { CodeExample, PageDefinition } from "../../../../model/page"
import { readerPage } from "../../reader-article"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  readerPage "language.traits.instances" "/docs/language/traits/instances/" (en.copy ()) (ja.copy ()) "reader-trait" "ticket-42" [CodeExample
      (
        "traits-invalid-instance",
        localized "A mismatched method signature is rejected" "宣言と合わない関数の型はエラー"
      )] [
        (localized "Trait declarations" "trait宣言", "/docs/language/traits/declarations/"),
        (
          localized "Coherence and ownership" "インスタンスの一意性と所有権",
          "/docs/language/traits/coherence/"
        ),
        (
          localized "Inherent impls and methods" "固有implとメソッド",
          "/docs/language/data/impls-and-methods/"
        )
      ]
