import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  referencePage "language.traits.instances" "/docs/language/traits/instances/" (en.copy ()) (ja.copy ()) [CodeExample
      ("traits-instances", localized "A nominal type instance" "nominal型のinstance")] [CodeExample
      (
        "traits-invalid-instance",
        localized "Rejected method contract" "method contractの不一致"
      )] [
        [InternalLink
      (localized "Trait model" "trait model", "/docs/language/traits/model/")],
        [InternalLink
      (localized "Coherence" "coherence", "/docs/language/traits/coherence/")],
        [InternalLink (
          localized "Inherent methods" "inherent method",
          "/docs/language/data/impls-and-methods/"
        )]
      ]
