import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "インスタンス",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "traitは操作の型、instanceはその型に合う本体です。instance Label<Ticket>にあるfn label value: Ticket -> Stringを、traitのfnと見比べてください。Aの位置がTicketになっています。",
    "value.numberで整数を読み、showで文字列にします。showも標準のtraitの操作で、ここではInt用の実装を使います。+で接頭辞とつないだ文字列が戻り値です。",
    "instanceという宣言は、JavaScriptのnewのように値を作る式ではありません。実際の値はTicket { number: 42 }で作り、label firstで操作を呼びます。"
  ], rules: [
    "instanceは、traitが要求するすべての操作を実装します。引数の順番と戻り値の型は、型パラメーターを置き換えた宣言に合わせます。ジェネリックなinstanceを宣言する場合、その型パラメーターはinstanceが実装する型の指定に含まれている必要があります。",
    "ユーザーが定義するinstanceは、traitを定義したモジュールか、対象のいちばん外側の名前付き型を定義したモジュールに属します。この規則で、実装を追加できる場所を制限します。別のモジュールで両方の名前をimportしただけでは、そこで実装を追加する権限は得られません。",
    "使える実装は一つに決まらなければなりません。重複したり、同じ型に当てはまる範囲が重なったりするinstanceはエラーです。実行時の登録順で選ぶことはありません。型の別名を付けても、別の型としてこの制限を回避することはできません。",
    "instanceがほかのtraitを条件として要求する場合、選択時にはその条件も満たす必要があります。実装はコンパイル時の型で選び、実行中の値を分岐して選びません。組み込みの構造的な型については、コンパイラが用意する実装の代わりに、任意のユーザーinstanceを追加できるわけではありません。",
    "instanceは明示的に作ったり、関数の引数として受け渡したりする値ではありません。実装の選択は型検査で完了し、実行時のJavaScriptのクラス名や項目の形を調べて選ぶものでもありません。",
    "仕様では標準traitのinstanceも同じ署名の検査を必要とします。ただし検証した0.61.19では、Eqの戻り値を誤ってStringとした宣言を受理しました。受理された場合も、標準traitの引数と戻り値に合わせてください。"
  ], mistakes: [
    "次のinstanceはStringの代わりにIntを返すと宣言しているため、SES-T0101が出ます。戻り値をStringに直し、本体を\"ticket-\" + show value.numberにすると契約に合います。このファイルのmainはreadyを出力します。",
    "型が合っていても、必要な操作の省略や重複は認められません。呼び出し側の型注釈だけで、不正なinstanceの宣言を補うことはできません。"
  ], related: [
    "操作の引数と戻り値を約束として宣言する方法を確認できます。",
    "実装が重なる場合と、宣言を置ける場所を確認できます。",
    "ドットのメソッドとtraitの操作を使い分ける方法を確認できます。"
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String = "実装の型と、宣言できる場所"
pub fn mistakesTitle -> String = "traitの署名に合わせて実装する"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Ticket用の表示方法を実装するには",
  summary: "instanceは、traitが宣言した操作を特定の型について実装します。ここではTicketを文字列にする本体を書きます。",
  reading: "Label<A>は、Aを受け取りStringを返すlabelを要求します。instance Label<Ticket>ではAをTicketに置き換え、番号を読んでラベルを作ります。",
  result: "番号42と7からticket-42とticket-7が出ます。値の中身は変わっても、どちらもTicketなので同じinstanceの本体を使います。"
}
