import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Instances",
  summary: (explanation ()).summary,
  purpose: [
    "An instance supplies the implementation of a trait's operations for a particular type. Label<Ticket>, for example, defines the body of label that accepts Ticket and returns text.",
    "Declaring an instance does not construct a Ticket value. The compiler selects an instance matching the type passed to label."
  ],
  exampleTitle: "Implement Label for Ticket",
  reading: [
    "Label<A> requires label to take A and return String. In instance Label<Ticket>, replace A with Ticket. The required function now takes Ticket and returns String.",
    "The instance supplies fn label value: Ticket -> String. Its body reads value.number; show turns that integer into text, and + joins it to \"ticket-\".",
    "main creates a Ticket value with number 42. Calling label ticket requires Label<Ticket>, which is the instance declared above. The result is the string ticket-42.",
    "Changing the ticket's number changes the resulting text but not the selected instance. Selection is based on Ticket, not on the contents of an individual ticket."
  ],
  rules: [
    "An instance must provide every required operation, with the declared parameter order and result type after substitution. A generic instance must account for its type parameters in the instance's type application.",
    "A user-defined instance belongs to the module that defines the trait or the outermost named type involved. This ownership rule limits where implementations may be added; importing both names alone does not make another module an owner.",
    "There must be one applicable implementation. Duplicate or overlapping instances are rejected rather than chosen by runtime order. A type alias does not create a new type identity for bypassing those rules.",
    "Type constraints required by an instance must also be satisfied when it is selected. Instance lookup uses static types; it does not branch on a runtime constructor. For built-in structural types, general-purpose user instances are not a substitute for compiler-provided instances."
  ],
  mistakes: [
    "Writing impl Ticket defines functions belonging to Ticket, not an implementation of Label<Ticket>. Use instance for a trait implementation.",
    "If Label declares String as the result, an implementation returning Int is invalid. The example below is rejected because its method signature does not fulfill the trait declaration; changing the call site does not repair that mismatch."
  ],
  related: [
    "Compare the implementation against the required operation's declaration.",
    "Check where an instance may be declared and why overlapping implementations are rejected.",
    "Distinguish type-owned dot methods from trait implementations."
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Where do I write a type's implementation of a trait?",
  summary: "An instance implements the operations a trait requires for one type application. It is a declaration of behavior, not construction of an object.",
  reading: "Ticket holds a number; its Label instance prefixes that number with \"ticket-\". Person holds a name; its Label instance returns that name. labelOf<A> has the condition Label<A>, so the same function can call the correct implementation for either argument type.",
  result: "label (Ticket { number: 42 }) returns \"ticket-42\". Other Ticket numbers use the same instance. Two instances applying to the same type produce an error because the compiler cannot choose one unambiguously."
}
