import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.traits.methods-versus-traits" "/docs/language/traits/methods-versus-traits/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "traits-methods-versus-traits",
        localized "Two distinct lookup paths" "固有メソッドとtraitの関数を区別する"
      )] [CodeExample
      ("traits-invalid-method", localized "Ambiguous trait method" "同名のtraitの関数を区別できない場合")] [
        [InternalLink (
          localized "Inherent impls and methods" "固有implとメソッド",
          "/docs/language/data/impls-and-methods/"
        )],
        [InternalLink
      (localized "Method calls" "メソッド呼び出し", "/docs/language/syntax/method-calls/")],
        [InternalLink (
          localized "Calling trait methods" "traitメソッドの呼び出し",
          "/docs/language/traits/method-calls/"
        )]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
