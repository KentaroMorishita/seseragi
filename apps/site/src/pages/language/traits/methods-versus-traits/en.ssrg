import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Inherent methods versus trait operations",
  summary: (explanation ()).summary,
  ruleTitle: "Two forms solve different lookup problems",
  ruleBody: "Defining displayName in impl User lets a User value call user.displayName. instance DebugName<User> instead implements the trait's declared debugName for User. Call it as debugName user; other types can implement the same trait for use by shared code.",
  typingBody: "Dot-method lookup uses the type before the dot and visible impl methods. Trait lookup uses the operation's trait, argument types, where constraints, and available instances. Having displayName on User, for example, does not satisfy DebugName<User>.",
  evaluationBody: "Both eventually call statically known code, but neither performs dynamic object dispatch by default. The surface spelling does not merge their namespaces or ownership rules.",
  invalidTitle: "Do not use instance as an extension-method namespace",
  invalidBody: "A trait instance does not make every trait operation available as value.method. An impl cannot satisfy a trait requirement unless it also defines the required coherent instance.",
  diagnosticsBody: "Member diagnostics name the receiver and visible impl candidates. Trait diagnostics name the owning trait, evidence requirement, and ambiguity or missing instance. Keeping them separate makes fixes local.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Should this operation be a method or a trait?",
  summary: "Use an impl for operations specific to one named type. Use a trait when multiple types should satisfy a shared operation required by common code.",
  reading: "User's displayName is a dot method defined in impl User. DebugName<User> supplies the separate debugName operation. Both read the same user's name but offer different interfaces and output formats.",
  result: "user.displayName returns \"Aki\"; debugName user returns \"User(Aki)\". The example separates ordinary display from diagnostic display. impl and instance are separate declarations, so provide the implementation appropriate to the intended interface."
}
