import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "固有メソッドとtrait操作",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "User { name: \"Aki\" }はnameという文字列の項目を持つ値です。impl User内のself: Userは、ドットの前にあるuserを受け取ります。追加の引数がないのでuser.displayNameと呼べます。",
    "Show<A>は標準の表示用traitです。instance Show<User>のshowはUserを受け取りStringを返します。show userでは、引数の型からこの実装を選びます。",
    "TypeScriptのオブジェクトのメソッドに慣れている場合、ドットがあるからtraitも同じ仕組みだとは考えないでください。traitが要求するのは別に宣言した操作で、値に同名のメソッドがあるだけでは条件を満たしません。"
  ], rules: [
    "ドットのメソッドは、対象の値の型と公開されているimplから探します。traitでは、どのtraitの操作か、引数の型、whereの条件、利用できるinstanceを確認します。",
    "どちらも選ばれた実装を呼び、実行時にクラスを探して選び直すものではありません。型の中の名前空間へメソッドを加えることと、共通の操作へ実装を与えることを分けてください。"
  ], mistakes: [
    "user.showに書き換えると、showという項目がないためSES-T0101になります。Show<User>があっても、その名前のドットのメソッドは作られません。show userへ戻すと二つの表示を出力できます。",
    "逆に、implでshowという名前のメソッドを追加しただけではShow<User>の実装にはなりません。共通の関数がwhere Show<A>を要求するならinstanceが必要です。"
  ], related: [
    "操作の宣言と型ごとの実装を、小さな例で確認できます。",
    "型ごとの本体をどこに書くか確認できます。",
    "traitの関数を呼び、引数を一部だけ渡す方法を確認できます。"
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String = "ドットの検索とtraitの選択は別の規則"
pub fn mistakesTitle -> String = "実装した場所と呼び方を合わせる"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "user.displayNameとshow userは、どう使い分けるか",
  summary: "implは一つの型にドットのメソッドを定義します。instanceは共通のtrait操作をその型に実装します。両方を同じ型に用意できます。",
  reading: "画面では名前だけ、診断の表示ではUserという型名も出したいとします。impl UserにdisplayNameを書き、Show<User>のinstanceにshowを書きます。",
  result: "user.displayNameはAki、show userはUser(Aki)です。今回は異なる表示を二つに分けました。どちらの仕組みでも同じ文字列を返せますが、操作を見つける場所と呼び方が異なります。"
}
