import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.traits.do-notation" "/docs/language/traits/do-notation/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "traits-do-notation",
        localized "Bind, local let, and a final expression" "値の取り出し・let・最後の式"
      )] [CodeExample (
        "traits-invalid-do",
        localized "Rejected mixed and unfinished blocks" "異なる計算の混在と、最後の式がない例"
      )] [
        [InternalLink (
          localized "How do blocks desugar" "doブロックの構文展開",
          "/docs/language/traits/do-desugaring/"
        )],
        [InternalLink (
          localized "Typing a do block" "doブロックの型付け",
          "/docs/language/traits/do-block-typing/"
        )],
        [InternalLink (
          localized "Blocks and local declarations" "ブロックとローカル宣言",
          "/docs/language/expressions/blocks-and-local-declarations/"
        )]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
