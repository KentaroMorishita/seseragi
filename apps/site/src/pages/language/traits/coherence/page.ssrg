import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.traits.coherence" "/docs/language/traits/coherence/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "traits-coherence",
        localized "Evidence owned beside a nominal type" "型を定義した場所でtraitを実装する"
      )] [CodeExample (
        "traits-invalid-coherence",
        localized "Rejected overlapping evidence" "複数の実装が同じ型に当てはまるとエラー"
      )] [
        [InternalLink
      (localized "Instances" "インスタンス", "/docs/language/traits/instances/")],
        [InternalLink (
          localized "Standard operators and traits" "標準演算子とtrait",
          "/docs/language/traits/standard-operators/"
        )],
        [InternalLink (
          localized "Type identity and coercion" "型の同一性と型変換",
          "/docs/language/types/type-identity-and-coercion/"
        )]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
