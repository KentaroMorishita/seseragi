import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Coherence and ownership",
  summary: (explanation ()).summary,
  ruleTitle: "Do not provide two implementations for the same type",
  ruleBody: "A call that matches two instances is an error. The overlap check expands aliases and includes generic instances. An instance may be declared in the module defining its trait or the outermost named type it targets.",
  typingBody: "Candidate instances come from the current module's imports and their further imports. Compiler-provided instances for structural types cannot be replaced. For a trait whose inputs determine its result type, instances assigning different results to the same input are also rejected.",
  evaluationBody: "Coherence makes instance choice independent of runtime values and import order. Adding an unrelated import cannot silently change which implementation existing well-typed code executes.",
  invalidTitle: "Aliases and specificity do not escape overlap",
  invalidBody: "An alias expands before identity checks, and a more specific head does not outrank a generic one. Conflicting evidence must be removed or expressed through distinct nominal types.",
  diagnosticsBody: "For an overlap error, compare the two reported instances. For a declaration-location error, check where the trait and target type are defined. For a trait with an input-determined result, compare the input types and the result type declared by each instance.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What prevents a new import from changing which implementation runs?",
  summary: "Each trait application must have one unambiguous implementation. Ownership rules limit where an instance can be declared.",
  reading: "Title<Stage> is implemented once and handles both Draft and Published. title Published can therefore select a single known implementation from the static Stage type; the constructor only affects the branch inside that implementation.",
  result: "title Published returns \"published\". Adding another Title<Stage> produces an overlap error. A type alias does not create a different type from Stage, so it does not resolve the overlap. A newtype can distinguish a different use requiring different behavior."
}
