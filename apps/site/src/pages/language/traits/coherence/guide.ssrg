import { localized } from "../../../../model/locale"
import { Explanation } from "../../explanation"

pub fn explanation -> Explanation = Explanation {
  question: localized
    "What prevents a new import from changing which implementation runs?"
    "importを増やしても、既存の実装が勝手に変わらないのはなぜか",
  summary: localized
    "Each trait application must have one unambiguous implementation. Ownership rules limit where an instance can be declared."
    "一つの型に対するtrait実装は、一つに決まる必要があります。宣言できる場所も、traitか対象の型の定義元に制限します。",
  exampleId: "traits-coherence",
  reading: localized
    "Title<Stage> is implemented once and handles both Draft and Published. title Published can therefore select a single known implementation from the static Stage type; the constructor only affects the branch inside that implementation."
    "例のTitle<Stage>は一度だけ実装し、DraftとPublishedをその本体で扱います。title Publishedでは、Stageという型から一つの実装を選べます。選択肢によって変わるのは、その本体の分岐です。",
  result: localized
    "publishedTitle is \"published\". Adding another overlapping Title<Stage> is an error, not a later override. A type alias does not create a distinct type that can evade this restriction."
    "publishedTitleは\"published\"です。重なるTitle<Stage>を追加すると、後勝ちの上書きではなくエラーになります。型別名を付けても別の型にはならず、この制限を回避できません。"
}
