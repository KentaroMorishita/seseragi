import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "インスタンスの一意性と所有権",
  summary: (explanation ()).summary,
  ruleTitle: "同じ型に当てはまる実装を二つ置かない",
  ruleBody: "一つの呼び出しに二つのinstanceが当てはまるとエラーになります。型別名は展開し、ジェネリックなinstanceも含めて重複を調べます。instanceを置けるのは、traitの定義元か、対象のいちばん外側の名前付き型の定義元のモジュールです。",
  typingBody: "instanceの候補は、現在のモジュールがimportする先と、その先からさらにimportする先から集まります。コンパイラが提供する構造的な型のinstanceは置き換えられません。入力型で結果型が決まるtraitでは、同じ入力に異なる結果型を割り当てるinstanceもエラーになります。",
  evaluationBody: "型から実装が一つに決まるため、値の中身やimportの順番で処理が変わりません。無関係なimportを追加して、既存の呼び出しが別の実装へ切り替わることもありません。",
  invalidTitle: "型別名や具体的な型でも重複は回避できない",
  invalidBody: "型別名を付けても元の型と同じです。具体的な型向けの実装を、ジェネリックな実装より優先する規則もありません。重複を除くか、newtypeなどで別の型を作ってください。",
  diagnosticsBody: "重複のエラーでは、表示された二つのinstanceを見比べてください。宣言場所のエラーなら、traitと対象型の定義元を確認します。入力で結果型を決めるtraitのエラーなら、入力の型と各instanceが返す型を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "importを増やしても、既存の実装が勝手に変わらないのはなぜか",
  summary: "一つの型に対するtrait実装は、一つに決まる必要があります。宣言できる場所も、traitか対象の型の定義元に制限します。",
  reading: "例のTitle<Stage>は一度だけ実装し、DraftとPublishedをその本体で扱います。title Publishedでは、Stageという型から一つの実装を選べます。選択肢によって変わるのは、その本体の分岐です。",
  result: "title Publishedは\"published\"を返します。Title<Stage>をもう一つ追加すると、実装の重複としてエラーになります。型別名を付けてもStageとは別の型にならないため、重複は解消しません。別の処理が必要なら、newtypeで用途を区別できます。"
}
