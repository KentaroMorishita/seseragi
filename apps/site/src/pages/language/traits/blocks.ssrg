import * as arrays from "std/array"
import { LocalizedText, localized } from "../../../model/locale"
import { Block, InternalLink, Paragraph, Words } from "../../../model/page"

fn paragraph pair: (String, String) -> Block = match pair {
  (english, japanese) -> Paragraph ([Words (localized english japanese)])
}

pub fn paragraphs english: Array<String> -> japanese: Array<String> -> Array<Block> =
  map paragraph (arrays.zip japanese english)

fn relatedLink pair: ((LocalizedText, String), (String, String)) -> Block = match pair {
  ((title, path), (english, japanese)) -> Paragraph ([
    InternalLink (title, path),
    Words (localized (". " + english) ("。" + japanese))
  ])
}

pub fn related english: Array<String>
  -> japanese: Array<String>
  -> links: Array<(LocalizedText, String)>
  -> Array<Block> =
  map relatedLink (arrays.zip (arrays.zip japanese english) links)
