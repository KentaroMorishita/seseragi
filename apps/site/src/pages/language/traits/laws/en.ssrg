import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Trait laws",
  summary: (explanation ()).summary,
  ruleTitle: "A valid signature is necessary but not sufficient",
  ruleBody: "Eq requires a value to equal itself. With Functor's map, a function returning its input unchanged must preserve the original result. These requirements about related results, beyond parameter and result types, are called laws. Eq, Ord, Functor, Applicative, Monad, and other documented traits have their own laws.",
  typingBody: "Laws do not add hidden type rules or change instance selection. They describe relationships among well-typed calls. Equality used by a law follows the documented observational equality for the values involved.",
  evaluationBody: "The compiler does not run arbitrary proofs while type checking. Standard-library instances are checked by maintained law suites, and user instances can use reusable law helpers with representative generated values.",
  invalidTitle: "Compilation is not a law certificate",
  invalidBody: "An implementation can type-check and still violate reflexivity, ordering consistency, identity, or associativity. Such an instance is semantically invalid even when no compiler diagnostic is possible.",
  diagnosticsBody: "Type diagnostics still catch malformed methods and missing evidence. Law failures belong to tests and should report the property, generated input, and smallest reproducible counterexample.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Can an implementation have the right types but wrong behavior?",
  summary: "A trait law describes behavior an implementation must preserve, beyond the parameter and result types checked by the compiler.",
  reading: "reflexive checks one equality property: a value should equal itself. Eq<A> lets the function compare its input. The integer and text calls show two types using that same check.",
  result: "Both reflexive 42 and reflexive \"seseragi\" return True. An Eq implementation always returning False has the required Bool result type but violates reflexivity. When writing an instance, test these relationships with concrete values."
}
