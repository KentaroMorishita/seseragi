import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Calling trait methods",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "trait Label<A> declares label: A -> String, and instance Label<Ticket> defines its body for Ticket. label ticket is a function call without a dot.",
    "withPrefix takes String and then Ticket. withPrefix \"log: \" supplies only its first argument, leaving a Ticket -> String function. The example names that function logTicket.",
    "Partial application is not specific to traits. Remaining arguments or an expected result type can determine unresolved trait type arguments. A generic function declares its requirements with where."
  ], rules: [
    "The compiler determines the trait arguments and instance from the arguments and expected result type. A generic function must state the required trait in where before calling the operation. After partial application, later arguments may determine types still unresolved.",
    "Explicit arguments keep ordinary application order. The chosen method implementation runs directly; the runtime does not search a value's shape, constructor, or host class for a matching method."
  ], mistakes: [
    "The rejected label 42 passes Int, but only a Ticket implementation is provided. At SES-T0201, change the call to label ticket to produce the original two lines. This is a different operation from using show to display a number.",
    "The specification uses a trait-qualified name such as Label.label when operation names are ambiguous. In the tested 0.61.19 compiler, that form for a local trait reports SES-N0001. This page’s runnable example uses an unambiguous operation name and an ordinary call."
  ], related: [
    "See how a shared function requires operations with where.",
    "Decide between a dot method and a trait operation.",
    "Check overlapping implementations and permitted declaration sites."
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String =
  "Use arguments, results and where to select an implementation"
pub fn mistakesTitle -> String = "Pass a type with the required implementation"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do you call a trait function and supply arguments in stages?",
  summary: "Call a trait operation by putting arguments after its name, separated by spaces. Its types select the implementation, and it composes with ordinary functions.",
  reading: "Label<Ticket> defines a ticket’s display. label ticket calls it directly; withPrefix adds a prefix. Supplying only the prefix creates a function waiting for a ticket.",
  result: "The direct call returns ticket-42; logTicket ticket returns log: ticket-42. Both use the same Label<Ticket> implementation, with the latter adding text before its result."
}
