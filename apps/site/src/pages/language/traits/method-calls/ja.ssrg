import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "traitメソッドの呼び出し",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "trait Label<A>がlabel: A -> Stringという操作を宣言し、instance Label<Ticket>がTicketの場合の本体を定義します。label ticketはドットを使わない関数呼び出しです。",
    "withPrefixはStringとTicketを順に受け取ります。withPrefix \"log: \"は最初の引数だけを渡すため、Ticket -> Stringという型の関数を返します。これをlogTicketと名付けています。",
    "この部分適用はtrait専用ではありません。残りの引数や要求される戻り値の型で、未確定のtraitの型引数が決まることもあります。型を決めずに書く関数ならwhereで条件を宣言します。"
  ], rules: [
    "コンパイラは引数や要求される戻り値の型から、traitの型引数とinstanceを決めます。ジェネリック関数から操作を呼ぶ場合は、whereに必要なtraitを書いてください。引数を一部だけ渡す場合、残りの引数によって型が決まることもあります。",
    "引数を通常の順序で計算してから型で選んだ実装を呼びます。実行時の値や生成先のクラスから探す仕組みではありません。"
  ], mistakes: [
    "次のlabel 42ではIntを渡していますが、用意した実装はTicket用だけです。SES-T0201を確認し、label ticketへ直すと最初の例と同じ二行になります。showを使って数を文字列にするのとは別の操作です。",
    "仕様では、同名の操作が曖昧ならLabel.labelのようにtrait名で区別します。ただし検証した0.61.19では、ローカルtraitのこの修飾呼び出しはSES-N0001になります。このページの実行例は、曖昧さのない操作名で通常の呼び出しを使っています。"
  ], related: [
    "共通の関数が必要な操作をwhereで要求する方法を確認できます。",
    "ドットのメソッドとtraitの操作を使い分ける方法を確認できます。",
    "実装が重なる場合と、宣言を置ける場所を確認できます。"
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String = "引数、戻り値、whereから実装を決める"
pub fn mistakesTitle -> String = "実装がある型を渡す"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "traitの関数を呼び、引数を一部だけ渡すには",
  summary: "traitの操作も、関数名の後へ空白で引数を書いて呼びます。型が決まると実装が選ばれ、通常の関数と同じように組み合わせられます。",
  reading: "Label<Ticket>でチケットの表示を定義します。label ticketで直接呼び、withPrefixでは表示に接頭辞を付けます。先に接頭辞だけ渡しておくと、チケットを待つ関数を作れます。",
  result: "直接の呼び出しはticket-42、logTicket ticketはlog: ticket-42です。同じLabel<Ticket>の処理を使い、後者だけがその前に文字列を足しています。"
}
