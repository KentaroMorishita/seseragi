import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.traits.do-desugaring" "/docs/language/traits/do-desugaring/" (en.copy ()) (ja.copy ()) [CodeExample
      ("traits-do-desugaring", localized "Equivalent do and flatMap forms" "等価なdoとflatMap")] [] [
        [InternalLink
      (localized "Do notation" "do記法", "/docs/language/traits/do-notation/")],
        [InternalLink
      (localized "Lambda expressions" "ラムダ式", "/docs/language/expressions/lambdas/")],
        [InternalLink
      (localized "Evaluation order" "評価順序", "/docs/language/expressions/evaluation/")]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
