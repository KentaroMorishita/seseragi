import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "How do blocks desugar",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "flatMap takes a function describing the next calculation, followed by the source Maybe. For Just it passes the payload to the function; for Nothing it returns Nothing without calling it. The name does not refer only to flattening one level of an Array.",
    "\\streetName -> ... is an unnamed function with argument streetName. The argument is String, not the whole Maybe<String>. The outer flatMap inspects street.",
    "The inner flatMap inspects city. Only if both values are Just does it concatenate the strings and wrap them in Just. The final pure in withDo wraps the value the same way in this Maybe context.",
    "When the street is absent, the function containing the inner flatMap is not called. This does not retroactively avoid evaluating arguments already computed before entering the function."
  ], rules: [
    "x <- mx followed by rest corresponds to flatMap (\\x -> rest) mx. A discarded result uses a function that ignores its argument. let remains an ordinary local declaration, and the last expression directly supplies the do result.",
    "Expansion is constructed from the last line backwards, while preserving forward sequencing. A backend may avoid creating intermediate functions, but must preserve evaluation order and name scope.",
    "No dedicated do runtime object is required. That does not remove branching, state, Effect scheduling or resource handling inherent in the selected computation. Whether later work proceeds after failure still follows that operation’s rules.",
    "The required trait constraints and the requirement for irrefutable payload patterns remain. Read diagnostics at the original bind or final expression rather than looking for generated internal names."
  ], mistakes: [
    "The rejected lambda annotates streetName as Maybe<String>, but flatMap supplies its String payload. The diagnostic therefore says source argument street would need Maybe<Maybe<String>>.",
    "Change the annotation to String and this file prints Just 1 River Road, Tokyo. Check which layer the function receives. Rewriting it as do does not change that type relationship."
  ], related: [
    "Return to the concrete example that stops when an address part is missing.",
    "Distinguish payload types from the outer computation type.",
    "See why operation results need tests beyond type checking."
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String =
  "Expansion rules and the execution meaning they preserve"
pub fn mistakesTitle -> String = "The lambda receives the payload"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What happens when you write do using functions alone?",
  summary: "Read do as flatMap passing an earlier payload to the next function. Expansion preserves absence handling and the scope of names.",
  reading: "The example writes the same address calculation twice. withDo names payloads with <-; withFlatMap explicitly supplies functions receiving them. Both return Nothing if either address part is absent.",
  result: "Both comparisons are True. The two forms agree when both parts are present and when the street is missing. Reading the expanded functions shows when the later calculation is called."
}
