import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "標準演算子とtrait",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "Add<L, R, O>の三つの型は、左の値、右の値、出力です。例ではすべてDistanceで、fn addが二つのmetersを足してDistanceを作り直します。",
    "Distance { meters: 20 } + Distance { meters: 22 }は、このAddの実装を使います。calledにはDistanceという結果の型注釈を付け、同じaddを関数として呼んでいます。検証したコンパイラでは、この直接呼び出しの結果型を省くと実装を決められませんでした。",
    "TypeScriptなら、同じ計算を二つのDistanceを受け取るaddDistance関数として書けます。Seseragiでは+に対応付けられますが、それだけで単位の整合性や計算の正しさが証明されるわけではありません。"
  ], rules: [
    "==と!=はEq.eqに対応し、!=は同じ比較結果を反転します。<、<=、>、>=はOrd.compareの結果Less・Equal・Greaterから真偽を決めます。順序比較は同じ型の二つの値を受け取り、compareを一度呼びます。",
    "+、-、*、/、%、**はそれぞれAdd、Sub、Mul、Div、Rem、Powの操作です。左右を左から右へ一度ずつ評価します。&&と||は必要がなければ右を評価しない組み込み構文で、このtraitの仕組みには含まれません。",
    "Floatには標準のEqとOrdがありません。生成先のJavaScriptの比較へ自動で切り替わることもありません。小数の等しさや順序が必要なら、用途に合う明示的な数値APIを選びます。",
    "<$>、<*>、>>=はそれぞれFunctor.map、Applicative.apply、Monad.flatMapに対応します。mapは中身の変換、applyは包んだ関数の適用、flatMapは結果を使う次の計算への接続です。これらにも対応するinstanceが必要です。",
    "impl内のoperator宣言も対応する標準traitのinstanceを作るため、通常のinstanceと同じ重複禁止と宣言場所の規則が適用されます。比較記号ごとに別実装を置かず、Ord.compareを実装します。(<)などを関数として使ったり部分適用したりしても、同じ実装を使います。"
  ], mistakes: [
    "20 + 22.0は左がInt、右がFloatです。この組み合わせのAddがないためSES-T0201になります。22.0を22へ直すとIntの加算になり、42を出力します。実際に小数が必要な処理では、型と変換方法を明示して揃えてください。",
    "instanceを追加しても+の優先順位や結合の向きは変わりません。同じ左右の型から異なる結果型を選ぶ実装を二つ置くことも、仕様では禁止されています。"
  ], related: [
    "型ごとの本体をどこに書くか確認できます。",
    "実装が重なる場合と、宣言を置ける場所を確認できます。",
    "型検査だけでなく、操作の結果をテストする理由を確認できます。"
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String = "標準記号に対応する操作と評価順序"
pub fn mistakesTitle -> String = "異なる数値型を暗黙に混ぜない"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "自分のDistanceに+を使えるようにするには",
  summary: "標準の+はAddというtraitの操作に対応します。左の型、右の型、結果の型を指定して、自分の型の足し算を実装できます。",
  reading: "Distanceはmetersという整数の項目を持つ型です。二つの距離を足して新しい距離を返す処理を、instance Add<Distance, Distance, Distance>で定義します。",
  result: "演算子で足したtotalも、addを直接呼んだcalledも、metersは42です。値をIntへ暗黙に変換するのではなく、Distanceの加算として実装した処理を使います。"
}
