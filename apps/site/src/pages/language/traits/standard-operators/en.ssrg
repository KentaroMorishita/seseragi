import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Standard operators and traits",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "The three types in Add<L, R, O> are the left operand, right operand and output. All three are Distance here. fn add sums the two meters fields and creates a new Distance.",
    "Distance { meters: 20 } + Distance { meters: 22 } uses this Add implementation. called has an explicit Distance result annotation and calls the same add as a function. The tested compiler could not select the implementation for that direct call when the result annotation was omitted.",
    "TypeScript can express the same calculation with an addDistance function taking two Distance values. Seseragi can associate it with +; that alone does not prove unit consistency or arithmetic correctness."
  ], rules: [
    "== and != correspond to Eq.eq; != negates the same comparison result. <, <=, > and >= use the Less, Equal or Greater result of Ord.compare. Ordering comparisons take two values of the same type and call compare once.",
    "+, -, *, /, % and ** correspond to Add, Sub, Mul, Div, Rem and Pow. Operands are evaluated once each, left to right. && and || are built-in short-circuit syntax and do not use this trait mechanism.",
    "Float has no standard Eq or Ord. Compilation does not fall back to JavaScript comparison. For floating-point equality or ordering, choose an explicit numeric API suited to the task.",
    "<$>, <*> and >>= correspond to Functor.map, Applicative.apply and Monad.flatMap. These transform a payload, apply a wrapped function, and connect a result to a following computation respectively. Each requires the corresponding instance.",
    "operator declarations inside impl generate the corresponding standard instances and follow the same ownership and overlap rules. Implement Ord.compare rather than each comparison symbol separately. Using (<) and similar symbols as functions, including partial application, uses the same implementation."
  ], mistakes: [
    "20 + 22.0 combines Int on the left with Float on the right. No Add instance exists for that combination, so it reports SES-T0201. Change 22.0 to 22 to get Int addition and print 42. If the task needs fractions, explicitly choose consistent types and conversions.",
    "Adding an instance does not change + precedence or associativity. The specification also forbids two implementations that select different result types for the same left and right types."
  ], related: [
    "Check where to write the body for a particular type.",
    "Check overlapping implementations and permitted declaration sites.",
    "See why operation results need tests beyond type checking."
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String =
  "Operations behind the standard symbols and their evaluation order"
pub fn mistakesTitle -> String = "Do not mix numeric types implicitly"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can your Distance type support +?",
  summary: "The standard + operator corresponds to the Add trait. Specify the left, right and result types to implement addition for your own type.",
  reading: "Distance holds an integer field, meters. instance Add<Distance, Distance, Distance> defines how to add two distances and return a new distance.",
  result: "Both total, computed with the operator, and called, computed with add, have meters equal to 42. They use the implementation of Distance addition rather than an implicit conversion to Int."
}
