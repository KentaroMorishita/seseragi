import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.traits.standard-operators" "/docs/language/traits/standard-operators/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "traits-standard-operators",
        localized "Operator syntax backed by evidence" "演算子に対応するtraitの実装を使う"
      )] [CodeExample (
        "traits-invalid-coherence",
        localized "Duplicate operator evidence is incoherent" "同じ演算子に複数の実装があると選べない"
      )] [
        [InternalLink (
          localized "Operator overloads" "演算子オーバーロード",
          "/docs/language/data/operator-overloads/"
        )],
        [InternalLink (
          localized "Operator precedence" "演算子の優先順位",
          "/docs/language/syntax/operator-precedence/"
        )],
        [InternalLink (
          localized "Coherence and ownership" "インスタンスの一意性と所有権",
          "/docs/language/traits/coherence/"
        )]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
