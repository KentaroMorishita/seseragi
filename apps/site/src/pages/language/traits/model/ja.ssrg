import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "traitとは",
  summary: (explanation ()).summary,
  purpose: [
    "TypeScript側のLabel<A>は、label関数を持つオブジェクトの形をinterfaceで指定しています。ticketLabelとpersonLabelという実装オブジェクトを選び、メソッドを呼びます。どちらの言語でも、例の入力から同じ二行を出力します。",
    "Seseragiのinstanceは、そのようなオブジェクトの値ではありません。呼び出しへ実装オブジェクトを渡す代わりに、コンパイラが引数の型に合う実装を選びます。TypeScriptでも普通の関数やコールバックでこの仕事はできます。ここで比べるのは、操作の約束と実装をどこに置くかです。"
  ],
  exampleTitle: "main.ssrg",
  reading: [
    "struct Ticket { number: Int }は、numberという整数の項目を持つ型です。Ticket { number: 42 }で値を作ります。Personも同じ書き方で、文字列のnameを持ちます。",
    "trait Label<A>のAは、対象の型を表す仮の名前です。fn label value: A -> Stringは、A型の引数valueを一つ受け取り、文字列を返す操作を宣言します。この行に処理の本体はありません。",
    "instance Label<Ticket>ではAをTicketに置き換え、labelの本体を書きます。showは整数を文字列にし、+はその前にticket-を付けます。Label<Person>の本体はnameをそのまま返します。",
    "label (Ticket { number: 42 })は、関数名の後に空白で引数を渡す呼び出しです。括弧はTicketを作る式をまとめています。番号が7でも42でも、Ticket型なら同じ実装を使います。"
  ],
  rules: [
    "呼び出しに必要なinstanceがあるか、コンパイラは実行前に検査します。実装がなければ型エラーになります。",
    "instanceは引数の型で選びます。Ticket { number: 1 }もTicket { number: 42 }も、同じLabel<Ticket>を使います。",
    "traitを宣言しても、Ticketにフィールドやドットのメソッドは増えません。label ticketは、引数の型に対応するinstanceを必要とする関数呼び出しです。オブジェクトの継承とは異なります。",
    "where Label<A>のような条件は、型を決めずに書く関数へ必要な操作を指定します。この例には必要ありませんが、任意の型にlabelを呼ぶ関数を作る場合に使います。"
  ],
  mistakes: [
    "次のファイルにはLabelの宣言がありますが、Ticket用のinstanceがありません。宣言だけでは表示方法は決まらず、呼び出しにSES-T0201が出ます。最初の例にあるinstance Label<Ticket>を追加するとticket-42を出力できます。",
    "traitを実装してもticket.labelというドットのメソッドは増えません。ドットのメソッドにはimplを使います。"
  ],
  related: [
    "操作の引数と戻り値を約束として宣言する方法を確認できます。",
    "型ごとの本体をどこに書くか確認できます。",
    "共通の関数が必要な操作をwhereで要求する方法を確認できます。"
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String = "宣言、型ごとの実装、呼び出しを分ける"
pub fn mistakesTitle -> String = "操作の名前だけでは実装にならない"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "異なる型を、同じlabelで表示するには",
  summary: "データの型ごとに表示方法を定義し、共通の名前で呼びます。traitが操作の型を宣言し、instanceが具体的な処理を実装します。",
  reading: "Ticketは番号、Personは名前を持つデータです。二つを表示するために、Labelというtraitでlabelの引数と戻り値を決め、それぞれの型にinstanceを用意します。まず、このファイルをそのまま実行してみてください。",
  result: "出力はticket-42とAkiです。labelという同じ関数名でも、Ticketを渡した呼び出しとPersonを渡した呼び出しでは、使う実装が異なります。共通の操作名を保ったまま、型ごとの表示方法を追加できます。"
}
