import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "traitとは",
  summary: (explanation ()).summary,
  purpose: [
    "いろいろな種類のデータを、表示用のラベルにしたいとします。型ごとに無関係な関数名を付けると、共通の処理を書く側も、その名前をすべて知る必要があります。traitを使うと、labelという一つの操作名のまま、型ごとに違う処理を定義できます。",
    "区別するものは三つです。traitは操作の引数と戻り値を宣言します。instanceは、ある型でその操作をどう実行するか定義します。呼び出しでは、その操作に値を渡します。この例には、この三つをすべて含めています。"
  ],
  exampleTitle: "チケットを表示用のラベルにする",
  reading: [
    "struct Ticket { number: Int }は、整数を一つ持つチケット型です。mainのTicket { number: 42 }で、番号42のチケットを作ります。",
    "trait Label<A>のAは、ラベルにする対象の型を表す型パラメーターです。fn label value: A -> Stringは、A型の値を受け取ってStringを返す操作の宣言で、処理の本体はありません。",
    "instance Label<Ticket>では、AをTicketに置き換えてlabelの本体を書きます。value.numberをshowで文字列にし、先頭に\"ticket-\"を付けます。",
    "コンパイラは、label ticketのticketがTicket型であることを確認し、Label<Ticket>の実装を選びます。実行するとそのlabelが呼ばれ、ticket-42が出力されます。"
  ],
  rules: [
    "呼び出しに必要なinstanceがあるか、コンパイラは実行前に検査します。実装がなければ型エラーになります。",
    "instanceは引数の型で選びます。Ticket { number: 1 }もTicket { number: 42 }も、同じLabel<Ticket>を使います。",
    "traitを宣言しても、Ticketにフィールドやドットのメソッドは増えません。label ticketは、引数の型に対応するinstanceを必要とする関数呼び出しです。オブジェクトの継承とは異なります。",
    "labelOf<A>のwhere Label<A>は、Aにlabelの実装が必要という条件です。Personに実装があるので、labelOf (Person { name: \"Aki\" })は\"Aki\"を返します。Ticketにも実装があるため、labelOfの本体を変えずにTicketも渡せます。"
  ],
  mistakes: [
    "Label<A>を宣言しただけでは、処理の実装はできていません。instanceがない型でlabelを呼ぶと、実行前の型検査でエラーになります。",
    "Label<Ticket>があるだけではticket.labelとは書けません。ドットで呼ぶメソッドはimplで定義します。traitの関数は通常の関数適用や、Label.labelのような名前で呼びます。"
  ],
  related: [
    "traitの宣言の書き方と、その本体に書ける内容を確認できます。",
    "宣言された操作を、自分の型に対して実装する方法を確認できます。",
    "型を決めずに書く関数が、必要な操作を条件として指定する方法を確認できます。"
  ]
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "異なる型から、共通の名前で操作を呼ぶには",
  summary: "traitは共通の操作を宣言し、instanceは特定の型の処理を定義します。共通の呼び出し側は、その型の内部表現を知らずに操作を要求できます。",
  reading: "Label<A>はAからStringを返すlabelを宣言します。Ticketは番号、Personは名前を持ち、各instanceがそれぞれのlabelを定義します。labelOf<A>は内部の形を知らずにlabelを呼びます。where Label<A>は、渡す型にこの操作の実装が必要という条件です。personLabelは\"Aki\"、mainのlabel ticketは\"ticket-42\"になります。",
  result: "Ticketを渡すと、番号を使って\"ticket-42\"を作ります。Personを渡すと、名前の\"Aki\"を返します。Labelの実装がある型なら、共通のlabelOfへ渡せます。実装の選択は実行前の型検査で決まります。"
}
