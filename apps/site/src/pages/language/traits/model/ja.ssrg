import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "traitとは",
  summary: "traitは、複数の型で使える操作に共通の名前を付ける仕組みです。instanceで型ごとの処理を定義し、呼び出せることをコンパイル時に確認します。",
  purpose: [
    "いろいろな種類のデータを、表示用のラベルにしたいとします。型ごとに無関係な関数名を付けると、共通の処理を書く側も、その名前をすべて知る必要があります。traitを使うと、labelという一つの操作名のまま、型ごとに違う処理を定義できます。",
    "区別するものは三つです。traitは操作の引数と戻り値を宣言します。instanceは、ある型でその操作をどう実行するか定義します。呼び出しでは、その操作に値を渡します。次の例には、この三つをすべて含めています。"
  ],
  exampleTitle: "チケットを表示用のラベルにする",
  reading: [
    "struct Ticket { number: Int }は、整数を一つ持つチケット型です。mainのTicket { number: 42 }で、番号42のチケットを作っています。",
    "trait Label<A>のAは型のパラメーターで、あとで具体的な型に置き換える仮の名前です。fn label value: A -> Stringは「A型の値を受け取って文字列を返すlabelが必要」という宣言です。ここには処理の本体を書きません。",
    "instance Label<Ticket>で、Ticketに対する処理の本体を定義します。AをTicketに置き換え、value.numberをshowで文字列にして、先頭に\"ticket-\"を付けています。",
    "label ticketを検査するとき、コンパイラーはticketがTicket型だと分かっています。そのためLabel<Ticket>の実装を選び、その実装があることを確認します。実行すると、そのlabelが呼ばれ、ticket-42が出力されます。"
  ],
  rules: [
    "呼び出せる実装があることは、実行前に確認されます。「実装の証拠」とは、この確認を指す言葉です。呼び出すために、別途「証拠のオブジェクト」を自分で作る必要はありません。",
    "実装は型で選びます。Ticket { number: 1 }でもTicket { number: 42 }でも、使うのは同じLabel<Ticket>です。実行時に番号を見て実装を選ぶ仕組みではありません。",
    "traitを宣言しても、TicketがLabelを継承したり、その下位の型になったりはしません。フィールドやドットで呼ぶメソッドも増えません。label ticketは通常の関数呼び出しに、型に合う実装が必要という条件が付いたものです。",
    "具体的な型を決めずに関数を書く場合は、where Label<A>で「AにはLabelの実装が必要」と指定できます。呼び出す側は、その実装が見つかる型を渡します。"
  ],
  mistakes: [
    "Label<A>を宣言しただけでは、処理の実装はできていません。instanceがない型でlabelを呼ぶと、実行前の型検査でエラーになります。",
    "Label<Ticket>があるだけではticket.labelとは書けません。ドットで呼ぶメソッドはimplで定義します。traitの関数は通常の関数適用や、Label.labelのような名前で呼びます。"
  ],
  related: [
    "traitの宣言の書き方と、その本体に書ける内容を確認できます。",
    "宣言された操作を、自分の型に対して実装する方法を確認できます。",
    "型を決めずに書く関数が、必要な操作を条件として指定する方法を確認できます。"
  ]
}
