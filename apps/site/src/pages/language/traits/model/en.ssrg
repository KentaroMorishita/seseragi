import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Traits and evidence",
  summary: "A trait states a capability, and the compiler selects one matching implementation from static types before a program runs.",
  ruleTitle: "Traits are compile-time evidence",
  ruleBody: "A trait relates one or more types to named operations. An instance supplies those operations for a concrete type application. Type checking selects the unique instance and gives its operations to constrained code as a dictionary.",
  typingBody: "Trait applications participate in type inference and constraints. They do not add subtype relationships, object members, implicit casts, or runtime interface values. Evidence is determined from types, never from a constructor or value observed at runtime.",
  evaluationBody: "A backend may pass a dictionary, specialize code, or erase the abstraction after selection. Every strategy must preserve the same chosen operation and observable evaluation order.",
  invalidTitle: "Do not read a trait as inheritance",
  invalidBody: "Declaring Trait<A> does not make A a child type or attach methods to each value. Member syntax belongs to inherent impls; trait operations are ordinary constrained functions.",
  diagnosticsBody: "Missing evidence reports the concrete trait application that could not be selected. Ambiguity reports competing method owners or unresolved type information rather than inspecting runtime values.",
}
