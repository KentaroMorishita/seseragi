import { localized } from "../../../../model/locale"
import { CodeExample, PageDefinition } from "../../../../model/page"
import { readerPage } from "../../reader-article"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  readerPage "language.traits.declarations" "/docs/language/traits/declarations/" (en.copy ()) (ja.copy ()) "reader-trait" "ticket-42" [CodeExample
      (
        "traits-invalid-declaration",
        localized "An undeclared method type is rejected" "宣言していない型を使うとエラー"
      )] [
        (localized "Traits" "traitとは", "/docs/language/traits/model/"),
        (localized "Instances" "インスタンス", "/docs/language/traits/instances/"),
        (localized "Type constructors" "型構築子", "/docs/language/types/type-constructors/")
      ]
