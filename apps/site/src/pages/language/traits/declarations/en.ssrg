import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Trait declarations",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "<A> declares a type parameter for the value being labeled. A stands for a type, not a value. The colon in value: A specifies the argument type; -> String specifies the result type.",
    "The fn lines inside the trait have no equals sign. Put the implementation in an instance rather than in the contract. Both operations in the Ticket instance take Ticket and return String.",
    "let ticket names a ticket numbered 42. label ticket and shortLabel ticket call the two operations. Declaring the trait does not itself execute or print anything."
  ], rules: [
    "A trait can require several operations. Every required operation must be implemented by a matching instance. A declaration can refer to its trait parameters and to type parameters declared by a method.",
    "Type parameters must be declared before use. The compiler checks names and the shape of parameters during compilation, not when an instance is first called.",
    "A parameter such as F<_> stands for a type constructor, such as Array, rather than a complete type such as Int. Applying F to A gives F<A>. Use this form only when the operation must work with a container whose element type varies.",
    "where on a trait states another trait requirement. For example, a declaration requiring Eq<A> can rely on equality for A. This is a requirement for implementations to satisfy, not object inheritance."
  ], mistakes: [
    "MissingType in the rejected file is neither a declared type nor a declared type parameter. Replace it with A at the SES-N0001 location to produce the same two lines as the first example. Writing a name does not declare a new type parameter.",
    "Trait operations cannot have default bodies. Put their bodies in the instance, and implement every required operation."
  ], related: [
    "See a small example of operation declarations and type-specific implementations.",
    "Check where to write the body for a particular type.",
    "See how a shared function requires operations with where."
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String =
  "Type parameters and declarations that require other operations"
pub fn mistakesTitle -> String = "Declare a type name before using it"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do you declare two operations an implementation must provide?",
  summary: "A trait lists operation names, arguments and results. If it declares several operations, each instance must implement all of them.",
  reading: "A ticket needs a normal label and a short label. The two fn lines in Label<A> declare the required operations. The instance Label<Ticket> below supplies both bodies for Ticket.",
  result: "The same ticket produces ticket-42 and #42. Reading the trait tells you the arguments and results of the two functions every implementation must provide."
}
