import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Trait declarations",
  summary: "A trait declares operation types over value types or higher-kinded type constructors, with optional supertrait requirements.",
  ruleTitle: "A declaration contains signatures, not implementations",
  ruleBody: "Each trait method names a function type and omits a body. Ordinary parameters such as A range over value types; parameters such as F<_> range over unary type constructors. A where clause requires supertrait evidence.",
  typingBody: "Every use of a constructor parameter must match its declared kind and arity. Partial constructors such as Either<E, _> fill the required constructor shape; a fully applied value type cannot stand where F<_> is required.",
  evaluationBody: "A declaration has no standalone runtime action. Its signatures define the dictionary shape that each instance must satisfy and that constrained callers may consume.",
  invalidTitle: "Trait methods cannot carry default bodies",
  invalidBody: "A method body belongs in an instance. A missing type, a mismatched constructor arity, or a supertrait with the wrong kind is rejected at the declaration boundary.",
  diagnosticsBody: "Parser diagnostics identify malformed method signatures. Kind and arity diagnostics point to the offending trait parameter or partial application before any instance is considered.",
  provenanceBody: "This article covers specification 4.2 and uses the shared type-constructor and function-type rules."
}
