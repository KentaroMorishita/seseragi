import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.traits.deriving" "/docs/language/traits/deriving/" (en.copy ()) (ja.copy ()) [CodeExample
      ("traits-deriving", localized "Generating Eq and Show implementations for your type" "自分の型のEqやShowを自動で実装する")] [CodeExample
      (
        "traits-invalid-deriving",
        localized "Unsupported deriving target" "自動で導出できないtraitを指定した場合"
      )] [
        [InternalLink (
          localized "Algebraic data types" "代数的データ型",
          "/docs/language/data/algebraic-data-types/"
        )],
        [InternalLink (localized "Structs" "構造体", "/docs/language/data/structs/")],
        [InternalLink (
          localized "Coherence and ownership" "インスタンスの一意性と所有権",
          "/docs/language/traits/coherence/"
        )]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
