import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "derivingによるインスタンスの導出",
  summary: (explanation ()).summary,
  purpose: [

  ], exampleTitle: "main.ssrg", reading: [
    "Eqは等しいかを調べる操作、Showは文字列にする操作のtraitです。first == secondはEqを、show firstはShowを使います。derivingが両方のinstanceを用意します。",
    "これはTypeScriptのオブジェクトに対する===と同じ比較ではありません。ここでは二つのTicketのフィールド値を比べます。TypeScriptでもfirst.number === second.numberと書けば、この例と同じ番号の比較ができます。",
    "番号の型IntはEqとShowを持っています。もしフィールドの型が必要な操作を持たなければ、外側のTicketにderivingを書くだけでは実装できません。"
  ], rules: [
    "複数の形を持つ型（ADT）、struct、newtypeの宣言にderiving Eq, Showなどと書くと、コンパイラが等価比較や表示のinstanceを生成します。対応するtraitはEq、Ord、Show、Debug、Hash、JsonEncode、JsonDecodeです。生成したinstanceにも、宣言場所と公開範囲、重複禁止の規則が適用されます。",
    "外側の型を比較・表示するには、各フィールドや選択肢の中身にも対応するtraitが必要です。ジェネリック型では、この条件を型パラメーターに加えます。HashにはEqも必要です。JsonEncodeとJsonDecodeは、仕様で定めたJSONの形式を使います。",
    "EqとHashは宣言順に中身を調べます。順序を比較するOrdは、まずADTの選択肢の宣言順を比較し、次に中身を比較します。newtypeの等しさや順序は中身に従いますが、ShowやDebugの表示には包んだ型の名前も残ります。",
    "自分で定義したtraitをderivingで生成することはできません。同じ型に手書きと自動生成のinstanceを両方用意すると、重複としてエラーになります。フィールドに必要な実装がない場合は、その型にも実装を用意するか、外側のinstanceを自分で書いてください。",
    "生成できないtraitと、原因のフィールドや中身の型を確認します。Hashを指定した場合はEqが用意されているかも確認してください。",
    "derivingは型パラメーターの後、本体の前に置きます。opaqueな型でも定義したモジュール内で導出できますが、そのinstanceを使えることによって非公開の表現が公開されるわけではありません。",
    "Showは型名と公開されているフィールド名を含む、ソースに近い表示です。Debugは開発者向けの詳細な表示で、文字列の互換性は保証しません。どちらも宣言した順番を保ち、名前順に並べ替えません。"
  ], mistakes: [
    "次のLabelは自分で定義したtraitなので、derivingの対象ではありません。現行の診断はSES-N0001でderiving trait Label is not definedと表示しますが、この位置は一般のtraitを検索する仕組みではありません。",
    "deriving Labelをderiving Eqへ直すとこのファイルはreadyを出力します。Labelの操作が必要なら、derivingを外してinstance Label<Ticket>を自分で書いてください。"
  ], related: [
    "型ごとの本体をどこに書くか確認できます。",
    "型検査だけでなく、操作の結果をテストする理由を確認できます。",
    "実装が重なる場合と、宣言を置ける場所を確認できます。"
  ],
}

pub fn title -> String = (copy ()).title
pub fn detailsTitle -> String = "導出できる操作、必要な条件、生成される順序"
pub fn mistakesTitle -> String = "自分のtraitはinstanceを手書きする"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "自分のデータを比較、表示する処理を自動で用意するには",
  summary: "deriving Eq, Showを付けると、フィールドを使った等価比較と表示のinstanceをコンパイラが生成します。",
  reading: "Ticketの番号が同じか比べ、値を文字列でも確認したいとします。structの名前の後ろにderiving Eq, Showを書くと、Eqの比較とShowの表示を自分で実装せずに使えます。",
  result: "別々に作ったfirstとsecondでも、番号がどちらも42なので比較はTrueです。表示はTicket { number: 42 }になります。項目に沿った比較と表示が必要な場合に、手書きの実装を省けます。"
}
