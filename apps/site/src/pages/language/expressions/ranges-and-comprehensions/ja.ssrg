import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "範囲と内包表記",
  summary: (explanation ()).summary,
  exampleTitle: "偶数の二乗を集め、範囲の終端と組の順序を比べる",
  purpose: [
    "元の配列や整数の範囲から、条件に合う要素を選んで新しい配列を作ります。TypeScriptのfilterとmapを組み合わせる処理に近く、取り出す元・条件・結果を一つの式へ書けます。",
    "例では1から8までの偶数を二乗して集めます。次に終端を含めない範囲と比べ、最後に二つの範囲を組み合わせる順序を確認します。",
  ],
  reading: [
    "fn evenSquares limit: Int -> Array<Int>は、整数limitを受け取り、整数の配列を返す関数です。角括弧の中の|は、左の「結果に入れる式」と右の「取り出し方や条件」を区切ります。パイプラインの|>とは違う記号です。",
    "value <- 1 ..= limitは、1からlimitを含む範囲から整数を一つずつ取り出し、valueという名前を付けます。value % 2 == 0は、2で割った余りが0というBoolの条件です。条件に合ったvalueだけを使い、|の左のvalue * valueを結果へ入れます。",
    "inclusiveはevenSquares 8なので、2、4、6、8の二乗[4, 16, 36, 64]です。exclusiveの1 .. 8は8を含まないため、結果に64が入りません。showが配列を表示用の文字列にします。バッククォートで囲んだテンプレートの${...}へ埋め込み、\\nで出力の行を分けます。",
    "pairsでは、左のrowを1にしたままcolumnを1、2と取り出し、次にrowを2にしてcolumnを1、2と取り出します。(row, column)は二つの値の組です。結果は[(1, 1), (1, 2), (2, 1), (2, 2)]で、左にある取り出し指定が外側のループに相当します。",
  ],
  rules: [
    "start..endは終端を含まず、start..=endは終端を含みます。内包表記では、値を取り出す指定とBoolの条件を左から順に書きます。取り出す指定が複数ある場合、左のものが外側のループに相当します。",
    "結果の角括弧の前にバッククォートを置くとListを作ります。取り出す元がArrayでもListでも、結果をどちらにするかはこの書き方で決まります。Iterableは、要素を順に取り出せる型に必要な操作を定める仕組みです。Array、List、Rangeはその操作を提供します。",
    "取り出し元の型には、要素を順に取り出すためのIterableの実装が必要です。取り出すパターンは元の要素型に合い、条件式はBoolでなければなりません。|の前に書く式の型が、結果のArrayやListの要素型になります。元と結果でコレクションの種類が違っても構いません。",
    "取り出し元を順番に走査します。内側の取り出し元の式は、外側の要素ごとに一度計算します。取り出した値がパターンに合わない場合は、その要素を結果へ含めません。",
    "範囲の刻みは1です。開始値が終端より大きい場合は空になります。降順が必要ならライブラリの操作を使います。純粋な内包表記にEffectを取り出し元として渡すことはできません。",
    "取り出し元にIterableの実装があるか、条件がBoolか、パターンと要素の型が合うかを確認してください。すべての結果の要素は、同じ要素型でなければなりません。",
  ],
  mistakes: [
    "下の関数では、最後のvalueを条件として置いています。valueはIntで、Boolの条件ではないためSES-T0101になります。value % 2 == 0へ直すと、squares ()は[4, 16]を返します。引数のないこの関数は()で呼びます。",
    "現行0.61.19には、型注釈付きのトップレベルletへ同じ不正な条件を書くと、拒否せず受理する場合があります。これは実装上の検査漏れです。条件が数値や文字列でもよいという規則ではなく、Boolを返す比較を書いてください。",
  ],
  related: [
    "結果をArrayとListのどちらにするかを選べます。",
    "取り出す値をパターンへ渡す規則と、使える名前の範囲を確認します。",
    "各式をいつ何回計算するかを詳しく確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "元の値を絞り込み、計算した結果を配列に集めるには",
  summary: "内包表記では、元から値を取り出し、条件に合う値だけを残し、結果の要素を計算します。範囲は整数を順に取り出す元として使えます。",
  reading: "まず右側の範囲から取り出し、偶数という条件で絞ってから、左側の式で二乗を計算します。..=は終端を含み、..は含みません。",
  result: "最初の二行は[4, 16, 36, 64]と[4, 16, 36]です。三行目の組はrowを外側、columnを内側として並びます。",
}
