import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, PageDefinition } from "../../../../model/page"
import { readerPage } from "../../reader-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  readerPage "language.expressions.ranges-and-comprehensions" "/docs/language/expressions/ranges-and-comprehensions/" (en.copy ()) (ja.copy ()) "data-operations-comprehensions" "[4, 16, 36, 64]\n[4, 16, 36]\n[(1, 1), (1, 2), (2, 1), (2, 2)]" [CodeExample
      (
        "data-operations-comprehensions-invalid",
        localized "A rejected example and its correction" "エラーになる例と直し方"
      )] [
        (
          localized "Tuples, arrays, and lists" "タプル・配列・リスト",
          "/docs/language/data/tuples-arrays-and-lists/"
        ),
        (localized "Binding rules" "束縛の共通規則", "/docs/language/patterns/binding-rules/"),
        (localized "Evaluation order" "評価順序", "/docs/language/expressions/evaluation/")
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
