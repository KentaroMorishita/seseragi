import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Ranges and comprehensions",
  summary: (explanation ()).summary,
  exampleTitle: "Collect even squares, compare endpoints, and inspect pair order",
  purpose: [
    "Select elements from an array or integer range and build a new array. Like combining TypeScript filter and map, a comprehension writes the source, condition and result expression together.",
    "The example collects squares of even numbers from 1 through 8, compares an exclusive endpoint, then shows the order produced by combining two ranges.",
  ],
  reading: [
    "fn evenSquares limit: Int -> Array<Int> receives the integer limit and returns an integer array. Inside brackets, | separates the result expression on the left from the sources and conditions on the right. It is distinct from pipeline |>.",
    "value <- 1 ..= limit takes integers from 1 through limit, naming each value. value % 2 == 0 is a Bool condition asking whether the remainder after division by 2 is zero. Only matching values reach value * value, the expression placed in the result.",
    "inclusive calls evenSquares 8, producing the squares of 2, 4, 6 and 8: [4, 16, 36, 64]. The range 1 .. 8 in exclusive excludes 8, so its result omits 64. show converts the arrays to display strings, ${...} inserts them into the backtick-delimited template, and \\n separates the output lines.",
    "For pairs, row stays 1 while column takes 1 and 2, then row becomes 2 while column takes 1 and 2 again. (row, column) groups the two values. The result is [(1, 1), (1, 2), (2, 1), (2, 2)]: the left generator acts as the outer loop.",
  ],
  rules: [
    "start..end excludes the end; start..=end includes it. In a comprehension, write sources and Bool conditions from left to right. With several sources, the leftmost one acts as the outer loop.",
    "A backtick before the result brackets constructs a List. Whether the source is an Array or List, this spelling chooses the result collection. Iterable specifies the operations needed to take elements in order; Array, List and Range provide them.",
    "A source type needs an Iterable implementation for retrieving elements in order. Its pattern must fit the element type and each condition must be Bool. The expression before | determines the resulting Array or List element type. The source and result may be different collection kinds.",
    "Sources are traversed in order. An inner source expression is computed once for each element of its outer source. An element that does not match its pattern is omitted from the result.",
    "A range always steps by one. If the start is larger than the end, the range is empty. Use library operations for descending sequences. An Effect cannot be the source of a pure comprehension.",
    "Check that the source implements Iterable, the condition is Bool, and the pattern fits the source element type. Every resulting element must have the same type.",
  ],
  mistakes: [
    "The function below puts value itself in the condition position. It is Int rather than Bool, so it produces SES-T0101. Replace it with value % 2 == 0 and squares () returns [4, 16]. This function has no named input and is called with ().",
    "Version 0.61.19 can miss this check for the same invalid condition in an annotated top-level let. That implementation gap does not permit number or string conditions in the language. Write a comparison producing Bool.",
  ],
  related: [
    "Choose whether the result should be an Array or List.",
    "Check binding a source value to a pattern and the scope of the introduced names.",
    "Inspect when and how often the expressions are evaluated.",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I filter source values and collect transformed results?",
  summary: "A comprehension takes values from a source, keeps those meeting a condition, and computes each result element. An integer range can supply those values in order.",
  reading: "Take values from the range on the right, keep even ones, then square them with the expression on the left. ..= includes the endpoint; .. excludes it.",
  result: "The first two lines are [4, 16, 36, 64] and [4, 16, 36]. The pairs on the third line use row as the outer and column as the inner generator.",
}
