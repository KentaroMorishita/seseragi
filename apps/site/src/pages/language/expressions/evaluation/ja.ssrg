import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "評価順序",
  summary: (explanation ()).summary,
  exampleTitle: "引数を計算してから二桁の値を作る",
  purpose: [
    "評価とは、式を計算して値を得ることです。関数の呼び出しでは、まず渡す引数を計算し、その値を使って関数の本体を計算します。",
    "この例では、二つの数をそれぞれ1増やしてから、十の位と一の位として組み合わせます。関数を定義すること、呼ぶこと、出力を実行することを分けて読みます。",
  ],
  reading: [
    "placeのtensとonesはInt、つまり整数の引数です。最後の-> Intは戻り値の型です。本体のtens * 10 + onesで、二つの値から数を作ります。",
    "nextは一つの整数に1を足す関数です。place (next 1) (next 2)では、左の引数next 1が2になり、右のnext 2が3になります。",
    "placeの本体には計算済みの2と3が渡り、2 * 10 + 3で23になります。二つのnextを毎回本体の中で計算し直すわけではありません。",
    "let numberはその結果へ名前を付け、mainが23を出力します。placeやnextの宣言を書いた時点で、それらの本体を勝手に実行するわけではありません。",
  ],
  rules: [
    "普通の関数の引数は、左から右へ一度ずつ評価してから本体へ渡します。このように先に引数を計算する方式を、strict evaluation（正格評価）と呼びます。",
    "通常の二項演算の入力、レコードのフィールド、コレクションの要素も、ソースに書いた順に一度ずつ計算します。その値を後で使うかどうかで、言語が定める順序は変わりません。",
    "ただし、&&、||、??の不要になった右側は計算しません。例えばFalse && conditionならconditionを省きます。これは短絡評価の規則です。式がどうまとまるかという優先順位とも区別してください。",
    "関数を定義しただけでは本体を計算しません。計算を必要な時点へ延ばしたいなら、普通の関数の本体に置き、必要になったときに呼びます。通常のフィールドや配列へ式を書くだけで、遅延する指定にはなりません。",
    "Effectは、出力など実行する処理を表す値です。その値を作ることと、表す外部処理を実行することは別です。printlnで作ったEffectは、mainの実行など、そのEffectを開始する境界で出力を行います。普通の値の計算まで、すべて自動で後回しになるわけではありません。",
    "型が合うかを確かめる型検査と、計算する順番を決める評価規則は別です。掲載した誤りの例は、実行前の型検査で止まります。",
  ],
  mistakes: [
    "下のplace \"two\" 3は、最初の引数にIntではなくStringを渡しているためSES-T0101になります。\"two\"を2へ直すと、23を出力します。評価順序を変えても、型の不一致は解決しません。",
    "関数の定義やEffectの作成と、実行された結果を混同しないでください。出力が必要な場合は、作ったEffectを実際に実行する入口へ接続します。",
  ],
  related: [
    "どの式が関数で、どこからが引数なのかを呼び出しの例で確認できます。",
    "複数の宣言から最後の値を返すブロックの読み方を確認できます。",
    "型で確かめることと実行時に失敗することを、具体的な制限から確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "関数に渡す式は、いつ計算されるか",
  summary: "関数の引数は左から右へ一度ずつ計算し、その結果を本体へ渡します。関数を定義しただけでは本体を実行しません。",
  reading: "まず整数を使う短い計算で、引数の計算と本体の計算を分けます。Effectの外部処理や短絡評価は、その後に区別します。",
  result: "next 1は2、next 2は3です。計算済みの値をplaceへ渡すと23になります。",
}

pub fn identityTitle -> String = "別の制限：値の比較と保存領域の同一性"
pub fn identityBody -> String =
  "値が等しいかどうかと、同じ保存領域を使っているかどうかは別の話です。通常の不変値には、保存領域の同一性を調べる演算子はありません。これは評価順序を決める規則ではありません。値の比較には、その型に対応する比較の操作を使います。"
