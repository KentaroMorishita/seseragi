import { localized } from "../../../../model/locale"
import { Block, Heading, Paragraph, Words } from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"

pub fn forms -> Array<Block> = [
  Heading ("value-identity", localized (en.identityTitle ()) (ja.identityTitle ())),
  Paragraph ([Words (localized (en.identityBody ()) (ja.identityBody ()))])
]

pub fn rejected -> Array<Block> = []
