import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Evaluation order",
  summary: (explanation ()).summary,
  ruleTitle: "Ordinary expressions compute their inputs immediately",
  ruleBody: "A function call computes its arguments before its body. Operator operands, record fields, and collection elements are also computed once each in source order. Whether the resulting value is used later does not change that order.",
  typingBody: "Evaluation order specifies which computation runs first. It is separate from the rules determining whether types match. The complete program must pass type checking before execution.",
  evaluationBody: "Effect is a value describing work to execute. Constructing a printing Effect does not print yet; executing that Effect does. Likewise, defining a function does not compute its body. These are rules for functions and Effects, not rules that delay ordinary arguments or field expressions.",
  invalidTitle: "Ordinary expressions are not automatically delayed",
  invalidBody: "To delay a calculation, place it in a function body and call that function when needed. To describe work such as I/O, return an Effect. An expression in an ordinary field or collection element is not a request to delay it.",
  diagnosticsBody: "Type mismatches and undefined names are reported before execution. Comparing values also differs from comparing storage locations. Ordinary immutable values have no operator for checking storage identity.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "When are function arguments computed?",
  summary: "Ordinary expressions evaluate their inputs before producing a result. Function arguments are evaluated left to right, once each.",
  reading: "place receives a tens digit and a ones digit and computes tens * 10 + ones. In place (1 + 1) (2 + 1), the first argument becomes 2 and the second becomes 3 before the corresponding body calculation uses them.",
  result: "result is 23. First compute 1 + 1 and 2 + 1, then use the resulting 2 and 3 in place's body. An expression constructing an Effect is evaluated normally, but the external work described by that Effect waits until execution."
}
