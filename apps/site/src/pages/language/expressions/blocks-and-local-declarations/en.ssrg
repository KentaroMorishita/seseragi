import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Blocks and local declarations",
  summary: (explanation ()).summary,
  ruleTitle: "The final expression supplies the block's value",
  ruleBody: "Write local declarations and expressions inside braces. The final expression becomes the result of the whole block. A block containing only declarations returns Unit. Names declared in a block cannot be used outside it.",
  typingBody: "Local let, fn, effect fn, and rec declarations are allowed. A name is available from its declaration to the end of the block. It may shadow an outer name, but cannot refer to a local name declared later.",
  evaluationBody: "Items are evaluated from top to bottom. Declaring a function does not run its body; calling it computes the body. When a function returns an Effect, executing that Effect is a separate step.",
  invalidTitle: "{} is an empty record, not Unit",
  invalidBody: "Write { () } for a block that does nothing. {} creates an empty record. Type, trait, impl, instance, operator, foreign, and public declarations belong directly in a module, not inside a block.",
  diagnosticsBody: "Using a local name before its declaration causes an unresolved-name error. To make local functions mutually recursive, declare them in the same rec group.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Which value does a block return?",
  summary: "A block groups local declarations and expressions inside braces. Its final expression supplies its value.",
  reading: "Inside label's block, normalized replaces a negative score with zero. Next, render is declared as a local function. The final render normalized is the result of the whole block, so no return statement is needed.",
  result: "label 42 returns \"score=42\"; a negative score is normalized to zero. The local names cannot be referenced outside the block. A block of pure expressions is not the same as a do block sequencing Effect operations."
}
