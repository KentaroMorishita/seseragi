import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "ブロックとローカル宣言",
  summary: (explanation ()).summary,
  purpose: [
    "途中の計算に名前を付けると、何の金額を計算しているかを追いやすくなります。unitPriceとsubtotalはtotalの中だけで必要な名前なので、ブロック内に置きます。合計を使う側は、その計算途中の名前を扱う必要がありません。",
    "TypeScriptの関数では通常return subtotal + 5と書くところを、Seseragiではsubtotal + 5という式で終えます。"
  ],
  exampleTitle: "単価、小計、合計を順に計算する",
  reading: [
    "引数の: Intは整数を受け取る指定、-> Intは整数を返す指定です。*は掛け算で、+は足し算です。ブロック内では上から順に値を計算するため、subtotalを作るときにはunitPriceが使えます。",
    "外側のlet answer = total 3が戻り値に名前を付けます。pub effect fn mainは公開された実行入口で、出力する処理を表すEffectを返し、実行機構がその処理を実行します。show answerが65を文字列にし、括弧でまとめたその結果をprintlnが改行付きで出力します。"
  ],
  rules: [
    "名前を使える範囲をスコープと呼びます。letの名前は宣言の直後からそのブロックの末尾まで使えます。外側に同名の名前があっても内側で別の名前を宣言できますが、それは外側の値への再代入ではありません。後に宣言するローカル名は先に使えません。",
    "ブロック内にはlet、fn、effect fn、recの宣言を置けます。ローカル関数は、引数、宣言より前に見えている名前、自分自身の名前を本体から使えます。後で宣言する名前は使えません。二つの関数が互いを呼ぶ相互再帰では、同じrecのグループへまとめます。グループ内ではすべての関数名を共有し、グループより前の値を参照できます。",
    "関数を宣言するだけでは本体を実行しません。呼び出したときに本体を計算します。Effectを返す場合は、処理を表すその値を実行する段階も別です。普通のブロックへ出力処理を並べるだけで、すべて順に実行されるわけではありません。Effectを順につなぐ場合はdoを使います。",
    "ブロックは一個以上のローカル宣言と最後の式、最後の式一個、または宣言だけから成ります。宣言だけなら、返す内容のない結果を表すUnitの値()を返します。何もしないブロックは{ () }と書きます。完全に空の{}は空のレコードです。",
    "公開を示すpubや、type、型の別名、structなどの型宣言はモジュールの一番外側へ置きます。操作の約束を定めるtrait、その実装のimpl・instance、演算子の宣言、他言語との境界のforeignも、ブロック内には置けません。"
  ],
  mistakes: [
    "次のsubtotalはtotalのブロック内だけの名前です。外側で使うとSES-N0001（名前が見つからないエラー）になります。合計が必要ならlet answer = total 3と関数を呼んでください。小計を外側でも使いたい場合は、小計を返す関数として切り出すなど、必要な値を戻り値で渡します。",
    "ブロックの最後をlet subtotal = ...だけにすると、計算した小計は自動で返りません。宣言だけのブロックはUnitになるため、Intを返す関数では型が合いません。最後にsubtotalなど、返したい値の式を書きます。"
  ],
  related: [
    "関数へ渡す値と、呼び出しの書き方を確認します。",
    "条件によって、どちらの値を返すかを選ぶ書き方を調べます。",
    "式や引数が計算される順番を詳しく調べます。",
    "名前を導入する構文に共通する規則を調べます。",
    "自分自身や互いを呼ぶローカル関数の宣言を調べます。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "何行かの計算をまとめて、一つの結果を返すには",
  summary: "単価20の商品を3個買い、手数料5を足した合計を計算します。波括弧で複数行をまとめたブロックは、最後の式の値を結果にします。",
  reading: "fn total quantity: Int -> Intは、整数の個数quantityを受け取り、整数の合計を返す関数です。=の後の波括弧が本体のブロックです。letで単価unitPriceに20、小計subtotalにquantity * unitPriceの結果を名付けます。",
  result: "total 3は個数3を渡す呼び出しです。小計は3 * 20で60、最後のsubtotal + 5は65です。この最後の式がブロック全体の値になり、そのままtotalの戻り値になります。return文は書きません。"
}

pub fn title -> String = (copy ()).title
