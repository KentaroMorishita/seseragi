import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Conditional expressions",
  summary: (explanation ()).summary,
  ruleTitle: "then and else determine the result of one expression",
  ruleBody: "if takes a Bool condition. Write both then and else, and make their result types match. For example, if then returns String, else must also return String. A branch that returns no value, of type Never, is the exception: the other branch's type becomes the result type.",
  typingBody: "Only one branch runs, but the compiler checks the condition and both branches. There is no conversion that treats zero or an empty string as false. For a number, string, collection, or foreign value, write a comparison or test returning Bool.",
  evaluationBody: "The condition is evaluated once. If it is true, then is evaluated; if false, else is evaluated. Work in the unselected branch is not executed.",
  invalidTitle: "Supply else and matching branch types",
  invalidBody: "if returns a value. Omitting else does not return an implicit Unit, and different branch types are not combined automatically. Write both results explicitly and give them the same type.",
  diagnosticsBody: "A non-Bool condition, a missing else, or different result types causes an error. Check the condition or branch identified by the diagnostic. A Never branch is allowed, but the remaining branch must match the required result type.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Can I assign the result of an if directly?",
  summary: "An if expression returns the value of one branch. Its condition must be Bool and its branch results must have compatible types.",
  reading: "accessLabel takes allowed: Bool. True returns \"allowed\" and False returns \"denied\"; both are String. let label = accessLabel True names the string computed by that call.",
  result: "label is \"allowed\". The selected then branch is evaluated and the else branch is skipped. To use a number as a condition, first write a comparison that produces Bool."
}
