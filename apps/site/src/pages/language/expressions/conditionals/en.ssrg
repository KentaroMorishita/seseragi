import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Conditional expressions",
  summary: (explanation ()).summary,
  ruleTitle: "then and else determine the result of one expression",
  ruleBody: "if takes a Bool condition. Write both then and else, and make their result types match. For example, if then returns String, else must also return String. A branch that returns no value, of type Never, is the exception: the other branch's type becomes the result type.",
  typingBody: "Only one branch runs, but the compiler checks the condition and both branches. There is no conversion that treats zero or an empty string as false. For a number, string, collection, or foreign value, write a comparison or test returning Bool.",
  evaluationBody: "The condition is evaluated once. If it is true, then is evaluated; if false, else is evaluated. Work in the unselected branch is not executed.",
  invalidTitle: "Supply else and matching branch types",
  invalidBody: "if returns a value. Omitting else does not return an implicit Unit, and different branch types are not combined automatically. Write both results explicitly and give them the same type.",
  diagnosticsBody: "A non-Bool condition, a missing else, or different result types causes an error. Check the condition or branch identified by the diagnostic. A Never branch is allowed, but the remaining branch must match the required result type.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I choose the amount a function returns?",
  summary: "if chooses between two values according to a condition. Like TypeScript’s conditional operator, the selected value can become a calculation or function result.",
  reading: "subtotal >= 5000 produces a Bool value. The expression after then is used when the condition is True, and the one after else when it is False. shipping returns 0 for free shipping and 500 otherwise.",
  result: "The output is 500 and 0. The condition is False for ¥3,200 and True for ¥5,000. Both branches return Int, which matches shipping’s result annotation.",
}

pub fn readerCaption -> String = "Choose the fee at the free-shipping threshold"

pub fn readerBridgeOne -> String =
  "This corresponds to subtotal >= 5000 ? 0 : 500 in TypeScript. Seseragi spells the choice if ... then ... else .... The expression itself is the function result, with no separate return statement."

pub fn readerBridgeTwo -> String =
  "The Int subtotal alone cannot be a condition. A nonzero number is not automatically treated as true; compare it to produce Bool. main prints both results on separate lines."

pub fn readerInvalidCaption -> String = "Using an integer as the condition"

pub fn readerMistake -> String =
  "if subtotal reports SES-T0101. Write the condition you mean, such as subtotal >= 5000, to produce the required Bool."

pub fn readerExecution -> String =
  "pub effect fn main is the public entry point for work that interacts with the outside world. The runner starts main, and println writes a string and newline. The ordinary functions and let bindings above perform the calculation or construct the data."

pub fn readerDetailNote -> String =
  "The declarations below illustrate the detailed rules. They are fragments without their own entry point. To run this page’s example, use the complete program with main above."
