import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.expressions.conditionals" "/docs/language/expressions/conditionals/" (en.copy ()) (ja.copy ()) [CodeExample
      ("expressions-conditionals", localized "A total conditional" "どちらの分岐でも値を返す条件式")] [CodeExample
      (
        "expressions-invalid-conditional",
        localized "Rejected non-Bool condition" "Boolでない条件を拒否"
      )] [
        [InternalLink
      (localized "Built-in types" "組み込み型", "/docs/language/types/built-in-types/")],
        [InternalLink
      (localized "Match expressions" "パターン照合", "/docs/language/patterns/match/")],
        [InternalLink
      (localized "Evaluation order" "評価順序", "/docs/language/expressions/evaluation/")]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample (
          "data-reader-conditionals",
          localized (en.readerCaption ()) (ja.readerCaption ())
        ),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Paragraph ([Words (localized (en.readerExecution ()) (ja.readerExecution ()))]),
        Terminal (localized "Output" "実行結果", "500\n0"),
        CodeExample (
          "data-reader-conditionals-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))])
      ],
      [Paragraph ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))])],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
