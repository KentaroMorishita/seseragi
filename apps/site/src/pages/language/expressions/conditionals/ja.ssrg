import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "条件式",
  summary: (explanation ()).summary,
  ruleTitle: "thenとelseで、一つの式の結果を決める",
  ruleBody: "ifは条件にBoolの値を受け取ります。thenとelseの両方を書き、返す値の型を揃えてください。例えばthenがStringなら、elseもStringを返します。ただし、値を返さないNeverの分岐は例外です。その場合は、もう一方の分岐の型がifの結果の型になります。",
  typingBody: "実行されるのは片方だけですが、コンパイラは条件と両方の式を検査します。0や空文字列を偽として扱うような変換はありません。数値や文字列、コレクション、外部の値を条件にしたい場合は、Boolを返す比較や判定を明示します。",
  evaluationBody: "条件を一度だけ評価し、真ならthen、偽ならelseの式を評価します。選ばれなかった側の処理は実行しません。",
  invalidTitle: "elseを省略したり、別々の型を返したりはできない",
  invalidBody: "ifは値を返す式です。elseを省略して暗黙のUnitを返したり、異なる型を自動でまとめたりはしません。両方の結果を明示し、同じ型に揃えてください。",
  diagnosticsBody: "条件がBoolでない場合、elseがない場合、二つの結果の型が違う場合はエラーになります。診断が示す条件式や分岐を確認してください。値を返さないNeverの分岐は許されますが、残る分岐の型は要求された結果型に合う必要があります。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "ifの結果を、そのまま値にできるか",
  summary: "ifは、選んだ分岐の値を返す式です。条件はBoolで、二つの分岐が返す型を揃える必要があります。",
  reading: "accessLabelの引数allowedはBoolです。Trueなら\"allowed\"、Falseなら\"denied\"を返し、どちらもStringです。let label = accessLabel Trueでは、その呼び出しを計算した結果の文字列にlabelという名前を付けます。",
  result: "labelは\"allowed\"です。選ばれたthen側だけを評価し、else側は評価しません。条件に整数などを使う場合は、比較によってBoolを作ってください。"
}
