import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "条件式",
  summary: (explanation ()).summary,
  ruleTitle: "thenとelseで、一つの式の結果を決める",
  ruleBody: "ifは条件にBoolの値を受け取ります。thenとelseの両方を書き、返す値の型を揃えてください。例えばthenがStringなら、elseもStringを返します。ただし、値を返さないNeverの分岐は例外です。その場合は、もう一方の分岐の型がifの結果の型になります。",
  typingBody: "実行されるのは片方だけですが、コンパイラは条件と両方の式を検査します。0や空文字列を偽として扱うような変換はありません。数値や文字列、コレクション、外部の値を条件にしたい場合は、Boolを返す比較や判定を明示します。",
  evaluationBody: "条件を一度だけ評価し、真ならthen、偽ならelseの式を評価します。選ばれなかった側の処理は実行しません。",
  invalidTitle: "elseを省略したり、別々の型を返したりはできない",
  invalidBody: "ifは値を返す式です。elseを省略して暗黙のUnitを返したり、異なる型を自動でまとめたりはしません。両方の結果を明示し、同じ型に揃えてください。",
  diagnosticsBody: "条件がBoolでない場合、elseがない場合、二つの結果の型が違う場合はエラーになります。診断が示す条件式や分岐を確認してください。値を返さないNeverの分岐は許されますが、残る分岐の型は要求された結果型に合う必要があります。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "条件に応じて、関数が返す金額を選ぶには",
  summary: "ifは条件によって二つの値のどちらかを選びます。TypeScriptの条件演算子と同じように、選んだ値を計算や関数の結果として使えます。",
  reading: "subtotal >= 5000はBoolという真偽値になります。thenの後は条件がTrueのとき、elseの後はFalseのときの値です。shippingは、送料無料なら0、それ以外なら500を返します。",
  result: "出力は500と0です。3,200円では条件がFalse、5,000円ではTrueになります。どちらの分岐もIntを返すので、shippingの戻り値をIntと書けます。",
}

pub fn readerCaption -> String = "送料無料になる金額で分岐する"

pub fn readerBridgeOne -> String =
  "TypeScriptのsubtotal >= 5000 ? 0 : 500に対応する選択です。Seseragiではif ... then ... else ...と書きます。return文を別に足さず、この式の結果を関数から返せます。"

pub fn readerBridgeTwo -> String =
  "Intのsubtotalそのものを条件にはできません。ゼロ以外なら真、と自動で解釈しないためです。比較してBoolを作ります。mainのprintlnが二つの計算結果を改行して表示します。"

pub fn readerInvalidCaption -> String = "整数をそのまま条件にする"

pub fn readerMistake -> String =
  "if subtotalはSES-T0101です。条件にはBoolが必要なので、subtotal >= 5000のように、判断したい条件を比較で書きます。"

pub fn readerExecution -> String =
  "pub effect fn mainは、外部へ出力する公開された実行入口です。実行するとmainが開始され、printlnが文字列と改行を出力します。計算やデータの組み立ては、その前の通常の関数やletで行っています。"

pub fn readerDetailNote -> String =
  "ここからの宣言例は、詳しい規則を調べるための断片です。単独では実行入口を持ちません。動かす場合は、上に載せたmain付きの完全な例を使ってください。"
