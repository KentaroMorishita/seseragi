import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "ラムダ式",
  summary: (explanation ()).summary,
  ruleTitle: "引数と計算式をその場で書く",
  ruleBody: "バックスラッシュの後に引数、矢印の後に本体を書きます。複数の引数を書いたラムダも、引数を一つずつ受け取る関数です。通常のfnと同じように、一部の引数だけ渡して残りを待つ関数を作れます。",
  typingBody: "引数の型は、そのラムダを渡す先が要求する関数型から推論するか、引数に直接書きます。例のInt -> Intという注釈は、引数も結果もIntであることを指定します。先に書いた引数名は、後の引数の型注釈や本体から参照できます。",
  evaluationBody: "ラムダを書くと、関数の値を作ります。本体を計算するのは、その関数を呼び出したときです。本体から外側の名前を参照することもできます。参照先は、呼び出した場所ではなく、ラムダを書いた場所で使えた名前に決まります。",
  invalidTitle: "複数の引数も一つずつ受け取る",
  invalidBody: "複数の引数を書いても、タプル一つを受け取る関数とは異なります。また、JavaScriptなど外部言語のコールバックへ渡す場合は、その外部連携の変換規則が必要です。ラムダを書くだけで外部の呼び出し形式へ変わるわけではありません。",
  diagnosticsBody: "引数や戻り値の型を決める情報が足りない場合は、引数に型注釈を付けるか、要求される関数の型が分かる場所へ渡してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "名前を付けずに小さな関数を渡すには",
  summary: "ラムダ式は、その場に関数を書く式です。mapへ処理を渡す場合など、関数の値が必要な場所に直接書けます。",
  reading: "\\value -> value + 1のvalueが引数名で、->の後が戻り値の式です。incrementのInt -> Intという注釈から、引数も戻り値も整数だと分かります。addのラムダには二つの引数があります。",
  result: "increment 20は21で、add 21 21は42になるため、answerは42です。incrementやaddを定義しただけでは、引数を使う本体は計算されません。呼び出したときに計算されます。"
}
