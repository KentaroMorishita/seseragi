import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "ラムダ式",
  summary: (explanation ()).summary,
  exampleTitle: "各得点にボーナスを加える関数を渡す",
  purpose: [
    "配列の全要素に同じ計算をするなら、その計算を関数として渡せます。TypeScriptのscore => score + bonusに相当する役割を、ここではラムダ式が担います。",
    "最初の例は、得点の配列に2点ずつ加えます。その後で、二引数のラムダへ一つだけ引数を渡す場合も確認します。名前付き関数と同じく、残りを受け取る関数を返せます。",
  ],
  reading: [
    "bonusは2、scoresは[10, 20, 30]です。mapは最初の引数として変換する関数、次に元のコレクションを受け取り、各要素に関数を適用した新しいコレクションを返します。このmapは標準で使える名前です。",
    "\\score: Int -> score + bonusでは、scoreが受け取る整数、Intがその型、矢印の後が返す値です。括弧はラムダ全体を一つの引数にまとめています。10、20、30へそれぞれ2を足すのでadjustedは[12, 22, 32]です。",
    "bonusはラムダの外側で定義されています。ラムダを書いた場所で使える名前を本体から参照することを、外側の値を捕捉する、と呼びます。呼び出し元でたまたま同じ名前があっても、そちらへ参照が変わるわけではありません。",
    "addの型Int -> Int -> Intは、整数を一つ受け取り、もう一つの整数を待つ関数を返す型です。\\left right -> left + rightは二つの引数を書いたラムダです。add 5で作るaddFiveへ3を渡すと8になります。show adjustedが配列を文字列にします。mainではバッククォートでテンプレートを囲み、${...}で値を埋め込み、\\nで二つの結果の行を分けます。",
  ],
  rules: [
    "バックスラッシュの後に引数、矢印の後に本体を書きます。複数の引数を書いたラムダも、引数を一つずつ受け取る関数です。通常のfnと同じように、一部の引数だけ渡して残りを待つ関数を作れます。",
    "引数の型は、そのラムダを渡す先が要求する関数型から推論するか、引数に直接書きます。例のInt -> Int -> Intという注釈は、二つの引数と最後の結果がIntであることを指定します。先に書いた引数名は、後の引数の型注釈や本体から参照できます。",
    "ラムダを書くと、関数の値を作ります。本体を計算するのは、その関数を呼び出したときです。本体から外側の名前を参照することもできます。参照先は、呼び出した場所ではなく、ラムダを書いた場所で使えた名前に決まります。",
    "複数の引数を書いても、タプル一つを受け取る関数とは異なります。また、JavaScriptなど外部言語のコールバックへ渡す場合は、その外部連携の変換規則が必要です。ラムダを書くだけで外部の呼び出し形式へ変わるわけではありません。",
    "引数や戻り値の型を決める情報が足りない場合は、引数に型注釈を付けるか、要求される関数の型が分かる場所へ渡してください。",
  ],
  mistakes: [
    "下のincrementにはInt -> Intと注釈していますが、ラムダ本体は\"one\"というStringを返すのでSES-T0101になります。本体をvalue + 1へ直すと、increment 2の結果は3です。",
    "引数の型を決める情報が足りなければ、\\score: Int -> ...のように型を書きます。型注釈は値を変換する処理ではなく、受け取る型と返す型を確かめる指定です。",
  ],
  related: [
    "一つだけ引数を渡した後に残る関数型を詳しく確認します。",
    "空白で引数を渡す通常の呼び出しを確認できます。",
    "ラムダの本体に複数のローカル宣言を書く方法を確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "配列へ小さな変換処理を渡すには",
  summary: "ラムダ式は、その場で関数の値を書く方法です。バックスラッシュの後に引数、矢印の後に結果の式を書き、mapなどへ渡せます。",
  reading: "mapへ渡すラムダが、得点scoreと外側のbonusを足します。addの例では、二つの整数を一つずつ受け取ります。",
  result: "配列の変換結果は[12, 22, 32]、addFive 3の結果は8です。scoresは更新されず、新しい配列が作られます。",
}
