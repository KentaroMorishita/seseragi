import { localized } from "../../../../model/locale"
import { Explanation } from "../../explanation"

pub fn explanation -> Explanation = Explanation {
  question: localized "How do I pass a small function without naming it?"
    "名前を付けずに小さな関数を渡すには",
  summary: localized
    "A lambda is a function expression. It lets you put the function where a value is needed, for example as an argument to map."
    "ラムダ式は、その場に関数を書く式です。mapへ処理を渡す場合など、関数の値が必要な場所に直接書けます。",
  exampleId: "expressions-lambdas",
  reading: localized
    "In \\value -> value + 1, value names the parameter and the expression after -> is the result. The annotation Int -> Int beside increment supplies the parameter and result types. The add lambda has two parameters."
    "\\value -> value + 1のvalueが引数名で、->の後が戻り値の式です。incrementのInt -> Intという注釈から、引数も戻り値も整数だと分かります。addのラムダには二つの引数があります。",
  result: localized
    "increment 20 is 21, and add 21 21 is 42, so answer is 42. The backslash begins the lambda; it is not an escape within a string. A captured outer value remains subject to the usual immutability rules."
    "increment 20は21で、add 21 21は42なので、answerは42です。先頭のバックスラッシュはラムダを始める記号です。外側の値を参照しても、通常の不変性の規則は変わりません。"
}
