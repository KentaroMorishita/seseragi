import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, PageDefinition } from "../../../../model/page"
import { readerPage } from "../../reader-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  readerPage "language.expressions.lambdas" "/docs/language/expressions/lambdas/" (en.copy ()) (ja.copy ()) "data-operations-lambdas" "[12, 22, 32]\n8" [CodeExample
      (
        "data-operations-lambdas-invalid",
        localized "A rejected example and its correction" "エラーになる例と直し方"
      )] [
        (
          localized "Function types and currying" "関数型とカリー化",
          "/docs/language/types/function-types-and-currying/"
        ),
        (
          localized "Function application" "関数適用",
          "/docs/language/syntax/function-application/"
        ),
        (
          localized "Blocks and local declarations" "ブロックとローカル宣言",
          "/docs/language/expressions/blocks-and-local-declarations/"
        )
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
