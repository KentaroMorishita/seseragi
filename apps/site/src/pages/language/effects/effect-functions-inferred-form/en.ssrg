import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effect functions with an inferred contract",
  summary: (explanation ()).summary,
  ruleTitle: "Remove every signature clause to request inference",
  ruleBody: "For an effect fn omitting ->, with, fails, and where, the compiler infers the returned Effect<R, E, A> from the body. R names required services, E names recoverable errors, and A is the success type. The inferred type is also recorded in the public module's type information.",
  typingBody: "Services with the same name and type merge into one field. With no recoverable failures, E is Never; with one error type, E is that type. Distinct error types produce a type error instead of an automatically generated common type. Success values in different branches must also have the same type.",
  evaluationBody: "Writing an explicit declaration with the same inferred type does not change execution results. In either form, calling the function constructs an Effect without executing its represented work.",
  invalidTitle: "Do not mix explicit and inferred forms",
  invalidBody: "with, fails, or where cannot appear while -> is omitted. Either state the success type after -> and specify the required type information, or omit all four clauses to infer the whole type.",
  diagnosticsBody: "Diagnostics distinguish a non-Effect body, conflicting requirement fields, multiple failure types, and incompatible success branches, with the source spans that contributed each type.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can an output function’s body determine its contract?",
  summary: "Keep parameter types and omit all of ->, with, fails and where to infer an effect fn’s requirements, failure and success types from its body.",
  reading: "announce returns println message. send is annotated String -> Effect<{ console: Console }, ConsoleError, Unit>, checking that the inferred announce can be used as that function type.",
  result: "Running main prints one line, ready. The shorter declaration does not remove its Console requirement or possible ConsoleError; main still uses that information when it runs.",
}

pub fn readerCaption -> String =
  "Check the inferred type against an explicit annotation"

pub fn readerBridgeOne -> String =
  "String -> starts a function accepting a string; the following Effect is its result. The first type argument is the requirement record { console: Console }, not Console alone. send is another name for announce, not an additional operation."

pub fn readerBridgeTwo -> String =
  "TypeScript return-type inference is a useful starting point. Seseragi’s compact effect fn infers not only the success value but also capabilities and recoverable failure. Inferring a type does not execute the external work."

pub fn readerInvalidCaption -> String = "Add only with to the inferred form"

pub fn readerMistake -> String =
  "Writing with Console while omitting -> reports SES-P0001. Remove with to infer the whole contract, or begin the explicit form with -> Unit with Console fails ConsoleError."

pub fn readerDetailNote -> String =
  "The detailed rules below also use declaration-only examples. They have no standalone entry point; use the complete program with main above when you want to run an example."

pub fn readerLegacyReading -> String =
  "announceInferred receives a String and returns println message. Since println needs Console and may fail with ConsoleError, the inferred return is Effect<{ console: Console }, ConsoleError, Unit>. No output happens merely from constructing it."

pub fn readerLegacyResult -> String =
  "announceInferred returns Effect<{ console: Console }, ConsoleError, Unit>. The compact declaration still records its services and error type in type information. To specify any part explicitly, change to the explicit form beginning with ->."
