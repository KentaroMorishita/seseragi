import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.effects.effect-functions-inferred-form" "/docs/language/effects/effect-functions-inferred-form/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-inferred-form",
        localized "A complete contract inferred from println"
      "printlnからサービス・失敗・結果の型を推論する"
      )] [CodeExample
      ("effects-invalid-pure-body", localized "Rejected non-Effect body" "本体がEffectを返さない場合")] [
        [InternalLink (
          localized "Effect functions with an explicit contract" "Effect関数の型を明示する形式",
          "/docs/language/effects/effect-functions-contract-form/"
        )],
        [InternalLink (
          localized "Annotations and inference" "型注釈と推論",
          "/docs/language/types/annotations-and-inference/"
        )],
        [InternalLink (
          localized "Effect error channels" "Effectの回復可能な失敗",
          "/docs/language/effects/error-channels/"
        )]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample (
          "failure-reader-inferred",
          localized (en.readerCaption ()) (ja.readerCaption ())
        ),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "ready"),
        CodeExample (
          "failure-reader-inferred-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Heading (
          "declaration-example",
          localized "Read the declaration-only example" "宣言だけの例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
