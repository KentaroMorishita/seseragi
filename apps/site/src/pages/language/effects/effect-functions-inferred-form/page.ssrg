      (
        "effects-inferred-form",
        localized "A complete contract inferred from println" "printlnから完全なcontractを推論"
      )] [CodeExample
      ("effects-invalid-pure-body", localized "Rejected non-Effect body" "Effectでないbodyを拒否")] [
        [InternalLink (
          localized "Explicit Effect contracts" "明示Effect contract",
          "/docs/language/effects/effect-functions-contract-form/"
        )],
        [InternalLink (
          localized "Annotations and inference" "annotationと推論",
          "/docs/language/types/annotations-and-inference/"
        )],
        [InternalLink (
          localized "Error channels" "error channel",
          "/docs/language/effects/error-channels/"
        )]
      ]
