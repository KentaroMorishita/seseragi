import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effect関数の型を推論する形式",
  summary: (explanation ()).summary,
  ruleTitle: "本体の操作からEffectの型を決める",
  ruleBody: "->、with、fails、whereをすべて省略したeffect fnでは、コンパイラが本体から戻り値のEffect<R, E, A>を推論します。Rは必要なサービス、Eは回復可能な失敗、Aは成功値の型です。推論した型は、公開されるモジュールの型情報にも記録されます。",
  typingBody: "同じ名前と型のサービスは一つにまとめます。回復可能な失敗がなければEはNever、失敗型が一種類ならEはその型です。異なる失敗型が複数ある場合は、自動で共通の型を作らず型エラーにします。分岐の成功値にも、同じ型が必要です。",
  evaluationBody: "推論した型と同じ型を明示形式で書いても、実行結果は変わりません。どちらの形式でも、関数の呼び出しではEffectを作るだけで、表している処理を実行しません。",
  invalidTitle: "明示する形式と推論する形式を混ぜない",
  invalidBody: "->を省略したままwith、fails、whereだけを書くことはできません。成功型を->で指定して必要な型情報を明示するか、四つの指定をすべて省略して全体を推論させてください。",
  diagnosticsBody: "本体がEffectでない場合、同じ名前のサービスの型が衝突する場合、失敗型や成功型が一致しない場合を区別して確認してください。失敗型はmapErrorなどで明示的に揃えます。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "出力する関数の型を、本体から決めてもらうには",
  summary: "引数の型は書き、->、with、fails、whereをすべて省くと、effect fnの本体から必要な機能・失敗・成功の型を決めます。",
  reading: "announceの本体はprintln messageです。sendにはString -> Effect<{ console: Console }, ConsoleError, Unit>と型を書いてあり、推論されたannounceをその型の関数として使えることを確認しています。",
  result: "mainを実行するとreadyが一行表示されます。短い宣言でも、必要なConsoleや起こり得るConsoleErrorが消えるわけではありません。mainもその型を使って実行します。",
}

pub fn readerCaption -> String = "推論した型を、明示した型と照合する"

pub fn readerBridgeOne -> String =
  "String ->は文字列を受け取る関数、その後のEffectは戻り値です。第一の型引数はConsoleそのものではなく、{ console: Console }という要求のレコードです。sendは別の処理を追加せず、announceへ付けた別の名前です。"

pub fn readerBridgeTwo -> String =
  "TypeScriptの関数で戻り値の型を省き、本体から推論する場合が手掛かりになります。Seseragiの短いeffect fnでは成功値だけでなく、必要な機能と回復可能な失敗も決まります。値を計算しただけで外部処理を実行する仕組みではありません。"

pub fn readerInvalidCaption -> String = "推論形式の途中にwithだけを足す"

pub fn readerMistake -> String =
  "->を省いたままwith Consoleを書くとSES-P0001です。全部を推論するならwithも消します。明示したいなら-> Unit with Console fails ConsoleErrorのように成功時の型から書きます。"

pub fn readerDetailNote -> String =
  "以下の詳しい規則では、宣言だけの例も示します。単独の実行入口はないため、実行する場合は上のmain付きの完全な例を使ってください。"

pub fn readerLegacyReading -> String =
  "announceInferredの本体はprintln messageです。printlnはConsoleを必要とし、ConsoleErrorで失敗する可能性があるため、Effect<{ console: Console }, ConsoleError, Unit>を推論します。値を作るだけでは出力しません。"

pub fn readerLegacyResult -> String =
  "announceInferredの戻り値はEffect<{ console: Console }, ConsoleError, Unit>です。短い宣言でも、必要なサービスと失敗型は型情報に記録されます。一部だけ型を指定したい場合は、->で始まる明示形式へ変更してください。"
