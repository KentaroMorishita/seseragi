import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Task",
  summary: (explanation ()).summary,
  ruleTitle: "Taskは、Effect<{}, Never, A>の短い名前",
  ruleBody: "Task<A>はEffect<{}, Never, A>の別名です。{}はサービス不要、Neverは回復可能な失敗なし、Aは成功値の型を表します。Taskと書いても型の同一性や使える操作は変わらず、Effectと同じ実行方式やtraitの実装を使います。",
  typingBody: "サービスが不要でも、回復可能な失敗を返す処理はEffect<{}, E, A>です。Taskの失敗型はNeverなので、別の失敗型が許される処理とも組み合わせられます。サービスが必要な処理は、失敗型がNeverでもTaskとは書けません。",
  evaluationBody: "Taskは、作っただけでは実行されません。処理順、キャンセル、リソースの管理、他の処理への実行の切り替えは、Effectと同じ規則に従います。実行結果の保存や共有も、Taskという名前だけで自動的に行われるものではありません。",
  invalidTitle: "非同期処理なら何でもTaskになるわけではない",
  invalidBody: "Taskと短く書けるのは、Rが正確に{}、EがNeverのときだけです。必要なサービスや回復可能な失敗があるなら、Effect<R, E, A>にその型を残してください。",
  diagnosticsBody: "型が合わない場合は、TaskをEffect<{}, Never, A>として見直し、必要なサービス、失敗型、成功値の型のどこが違うかを確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Taskを作るとすぐ動くのか、同じTaskを二度使うとどうなるのか",
  summary: "Task<A>は、外部サービスを要求せず、型で表す失敗も持たないEffectの短い名前です。処理を作っただけでは動かず、実行するたびにその処理を行います。",
  reading: "counterはrefs.make 0で作る、整数を保存する入れ物です。nextはその値を1増やして読むTask<Int>を作ります。let work = next counterの時点ではまだ増えません。beforeで0を読み、workを二度実行してfirstとsecondを受け取ります。",
  result: "表示は[0, 1, 2]です。Taskを変数に保存しても、成功値を自動で保存するキャッシュにはなりません。二度の実行で同じcounterを更新しています。"
}

pub fn readerBridgeOne -> String =
  "importでstd/refをrefsとして読み込みます。Ref<Int>は整数の保存先を表します。refs.updateへ渡す\\value: Int -> value + 1は、現在値を受け取って次の値を返す小さな関数です。refs.getも状態を読むためTaskを返します。"

pub fn readerBridgeTwo -> String =
  "fn nextの戻り値Task<Int>のIntは成功値の型です。完全に書くとEffect<{}, Never, Int>で、{}は追加サービス不要、Neverは型付きの失敗なしを表します。mainのdoで<-を使うと処理を実行して成功値に名前を付けます。printlnとshowは最後の表示を担当します。"

pub fn readerMistake -> String =
  "拒否例のeffects.fail \"missing\"にはStringの失敗があるため、Task<Int>とは書けません。Effect<{}, String, Int>など失敗を残す型にしてください。Taskでも不具合やキャンセルで止まることはあります。TypeScriptのPromiseのように、作成済みの一回の実行結果を表す名前ではありません。"

pub fn readerCaption -> String = "同じ処理を作ってから二度実行する"

pub fn readerInvalidCaption -> String = "直すべき宣言・呼び出し"

pub fn readerDetailNote -> String =
  "以下の例は宣言だけを示す補足です。上の実行例で使った考え方を、より小さい断片でも確認できます。実行入口や出力は含みません。"

pub fn readerLegacyReading -> String =
  "cachedは、受け取った整数を成功値にする処理をsucceedで作ります。サービスも回復可能な失敗もないので、戻り値をTask<Int>と書けます。fallibleにはStringで失敗する場合があるため、Effect<{}, String, Int>という失敗型を含む宣言が必要です。"

pub fn readerLegacyResult -> String =
  "cached 42は、実行すると成功値42を返します。Neverは回復可能な失敗がないことを表し、キャンセルや処理の不具合で止まらないことを保証する型ではありません。"
