import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.effects.task" "/docs/language/effects/task/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-task",
        localized "Task beside a service-free fallible Effect"
      "Taskと、サービス不要でも失敗しうるEffect"
      )] [CodeExample
      ("effects-invalid-task", localized "Rejected fallible Task" "回復可能な失敗をTaskでは表せない")] [
        [InternalLink
      (localized "The Effect type" "Effect型", "/docs/language/effects/effect-type/")],
        [InternalLink (
          localized "Effect error channels" "Effectの回復可能な失敗",
          "/docs/language/effects/error-channels/"
        )],
        [InternalLink
      (localized "Generic aliases" "ジェネリックな型別名", "/docs/language/types/generic-aliases/")]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
