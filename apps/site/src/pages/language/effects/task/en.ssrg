import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Task",
  summary: (explanation ()).summary,
  ruleTitle: "Task is an alias for Effect<{}, Never, A>",
  ruleBody: "Task<A> is an alias for Effect<{}, Never, A>. {} means no required services, Never means no recoverable failure, and A is the successful result type. Writing Task changes neither type identity nor available operations; it uses the same execution model and trait implementations as Effect.",
  typingBody: "A service-free computation returning recoverable failures has type Effect<{}, E, A>. Task has error type Never and can compose with work that permits another error type. A computation requiring services cannot be written as Task even when its error type is Never.",
  evaluationBody: "Creating a Task does not execute it. Sequencing, cancellation, resource management, and switching execution to other work follow the same rules as Effect. Writing Task does not automatically store or share execution results either.",
  invalidTitle: "Task does not mean arbitrary async work",
  invalidBody: "The Task abbreviation is valid only when R is exactly {} and E is Never. Keep required services and recoverable errors in Effect<R, E, A> when the work uses them.",
  diagnosticsBody: "Alias expansion reports mismatches against Effect<{}, Never, A>, showing whether the problem is a required service, a non-Never failure, or the success type.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "When can I shorten an Effect type to Task?",
  summary: "Task<A> is an alias for an Effect with no required services and no recoverable failures. It lets you write only the success type A without changing Effect's execution model.",
  reading: "cached uses succeed to construct work returning its integer input successfully. It needs no services and has no recoverable failures, so Task<Int> is appropriate. fallible can fail with a String, requiring a declaration that includes the error type: Effect<{}, String, Int>.",
  result: "Executing cached 42 succeeds with 42. Never means no recoverable failure; it does not guarantee that cancellation or computation defects cannot stop execution."
}
