import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Signalとトランザクション",
  summary: (explanation ()).summary,
  ruleTitle: "Signalの現在値は、Effectの中で読み書きする",
  ruleBody: "Signalは、変化を観測できる現在値を持ちます。生成・読み取り・更新・購読には状態へのアクセスが必要なので、TaskかEffectを返します。書き込み可能なMutableSignal<A>は、読み取り専用のSignal<A>として渡せます。逆の変換はできず、中身の型Aも変わりません。",
  typingBody: "planSetとplanUpdateで、実行する更新の計画を作ります。計画の型SignalChangeから更新対象や値を取り出す操作はないため、中身の型が異なるSignalへの更新も同じArrayに入れられます。transactionは、その計画を受け取るTask<Unit>です。計画を作っただけでは現在値は変わりません。",
  evaluationBody: "transactionは配列の順に更新を準備し、すべて計算できてから一度に公開します。同じSignalへのplanUpdateは、それ以前の計画で準備した値を受け取ります。更新を準備している間に処理の不具合が起きたり、公開前にキャンセルされたりした場合は、一件も公開しません。公開開始後は、派生値の再計算と通知が終わるまでキャンセルを保留します。",
  invalidTitle: "純粋な式の中では、Signalの現在値を読めない",
  invalidBody: "純粋なコードでは、Signalの値自体を受け渡せても、現在値は読めません。現在値はEffectの中でSignal.readか接頭辞*を使って読みます。古い値を読んで後から書き戻すと、その間の更新を反映できない場合があります。現在値から次の値を計算して更新するにはupdateを使ってください。",
  diagnosticsBody: "読み取り専用のSignalを更新しようとした場合や、更新する値の型が合わない場合は型エラーになります。実行時の診断では、更新の準備、公開、派生値の再計算、購読者への通知のどの段階で問題が起きたかを区別します。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "二つの値を、中途半端な状態を見せずに更新するには",
  summary: "Signalは、変化を観測できる現在値を持つ仕組みです。複数のSignalを同時に更新するには、更新計画を作り、transactionへ渡します。",
  reading: "xの初期値は1、yは2です。planSet 10 xはxを10にする計画、planUpdateはyに20を足す計画を作ります。transactionが両方をまとめて公開し、その後の*で更新済みの現在値を読みます。",
  result: "updateCoordinatesは(10, 22)で成功します。このトランザクションの通知で、途中の(10, 2)を見せることはありません。まとめて更新する対象はSignalだけです。通常の不変なフィールドを書き換えたり、入出力をtransactionへ入れたりする操作ではありません。"
}
