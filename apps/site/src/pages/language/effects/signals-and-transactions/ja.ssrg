import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Signalとトランザクション",
  summary: (explanation ()).summary,
  ruleTitle: "Signalの現在値は、Effectの中で読み書きする",
  ruleBody: "Signalは、変化を観測できる現在値を持ちます。生成・読み取り・更新・購読には状態へのアクセスが必要なので、TaskかEffectを返します。書き込み可能なMutableSignal<A>は、読み取り専用のSignal<A>として渡せます。逆の変換はできず、中身の型Aも変わりません。",
  typingBody: "planSetとplanUpdateで、実行する更新の計画を作ります。計画の型SignalChangeから更新対象や値を取り出す操作はないため、中身の型が異なるSignalへの更新も同じArrayに入れられます。transactionは、その計画を受け取るTask<Unit>です。計画を作っただけでは現在値は変わりません。",
  evaluationBody: "transactionは配列の順に更新を準備し、すべて計算できてから一度に公開します。同じSignalへのplanUpdateは、それ以前の計画で準備した値を受け取ります。更新を準備している間に処理の不具合が起きたり、公開前にキャンセルされたりした場合は、一件も公開しません。公開開始後は、派生値の再計算と通知が終わるまでキャンセルを保留します。",
  invalidTitle: "純粋な式の中では、Signalの現在値を読めない",
  invalidBody: "純粋なコードでは、Signalの値自体を受け渡せても、現在値は読めません。現在値はEffectの中でSignal.readか接頭辞*を使って読みます。古い値を読んで後から書き戻すと、その間の更新を反映できない場合があります。現在値から次の値を計算して更新するにはupdateを使ってください。",
  diagnosticsBody: "読み取り専用のSignalを更新しようとした場合や、更新する値の型が合わない場合は型エラーになります。実行時の診断では、更新の準備、公開、派生値の再計算、購読者への通知のどの段階で問題が起きたかを区別します。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "二つの変化する値を、途中の組み合わせを見せずに更新するには",
  summary: "Signalは、時点ごとに値を持つものです。値を更新するMutableSignalと、それらから計算するSignalを作り、transactionで複数の更新を一緒に公開できます。",
  reading: "widthとheightは1と2を初期値に持ちます。areaは二つを掛ける計算を登録したSignalです。seenには通知された面積を記録します。subscribeはareaの現在値2を最初に通知し、その後の更新も記録する関数へ渡します。",
  result: "transactionで幅を3、高さを4へまとめて更新すると、通知の記録は[2, 12]です。片方だけ変えた6や4は通知しません。unsubscribeで通知を止めたあと、signals.read areaで現在の面積12を読みます。"
}

pub fn readerBridgeOne -> String =
  "\\w: Int -> \\h: Int -> w * hは、幅と高さを順に受け取る整数の掛け算です。signals.combineへ渡すことで、どのSignalに依存するかを明示します。refsは記録用の保存先、arrays.append [value] valuesは記録の末尾へ新しい値を足す操作です。Array<Int>は整数の配列です。"

pub fn readerBridgeTwo -> String =
  "planSetはまだ値を変えず、変更の計画を作ります。transactionが配列順に計画を適用し、すべての計算に成功してから一度だけ公開します。同じ対象へのplanUpdateは、それより前の計画を反映した値を受け取ります。生成・読取・更新・購読は状態に触れるのでEffectです。mainの<-で実行して値を受け取ります。"

pub fn readerMistake -> String =
  "整数を持つwidthのようなSignalに、拒否例の文字列の計画は適用できません。値の型を揃えてください。変更計画の計算で不具合が起きた場合や公開前のキャンセルでは元の値を保ちます。ただしtransactionがまとめるのはSignal更新で、任意の入出力や外部サービスの操作ではありません。"

pub fn readerCaption -> String = "通知を記録し、二つの更新が一緒に届くことを確かめる"

pub fn readerInvalidCaption -> String = "直すべき宣言・呼び出し"

pub fn readerDetailNote -> String =
  "以下の例は宣言だけを示す補足です。上の実行例で使った考え方を、より小さい断片でも確認できます。実行入口や出力は含みません。"

pub fn readerLegacyReading -> String =
  "xの初期値は1、yは2です。planSet 10 xはxを10にする計画、planUpdateはyに20を足す計画を作ります。transactionが両方をまとめて公開し、その後の*で更新済みの現在値を読みます。"

pub fn readerLegacyResult -> String =
  "updateCoordinatesは(10, 22)で成功します。このトランザクションの通知で、途中の(10, 2)を見せることはありません。まとめて更新する対象はSignalだけです。通常の不変なフィールドを書き換えたり、入出力をtransactionへ入れたりする操作ではありません。"
