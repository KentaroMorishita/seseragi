import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.effects.signals-transactions" "/docs/language/effects/signals-and-transactions/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-signal-transactions",
        localized "Atomically updating two sources" "二つのSignalの更新をまとめて公開する"
      )] [CodeExample (
        "effects-invalid-signal-read",
        localized "Rejected pure Signal read" "純粋な式ではSignalの現在値を読めない"
      )] [
        [InternalLink (localized "Task" "Task", "/docs/language/effects/task/"), Words (localized ": Check when a procedure can be called Task" "：Taskと書ける処理の条件を確認する")],
        [InternalLink (localized "Derived Signals" "派生Signal", "/docs/language/effects/derived-signals/"), Words (localized ": Build values that follow source Signals" "：元のSignalに追従する値を作る")],
        [InternalLink (localized "Signal operators" "Signalの演算子", "/docs/language/effects/signal-operators/"), Words (localized ": Read and update Signal values explicitly" "：Signalの読取と更新を明示する")]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample (
          "lifecycle-reader-transactions",
          localized (en.readerCaption ()) (ja.readerCaption ())
        ),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "[2, 12]\n12"),
        CodeExample (
          "lifecycle-reader-transactions-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Heading (
          "declaration-example",
          localized "Read the declaration-only example" "宣言だけの例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
