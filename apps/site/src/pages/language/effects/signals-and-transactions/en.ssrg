import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Signals and transactions",
  summary: (explanation ()).summary,
  ruleTitle: "Signal state is accessed through Effect",
  ruleBody: "A Signal holds a current value whose changes can be observed. Creating, reading, updating, and subscribing access state, so they return Task or Effect. A writable MutableSignal<A> can be passed as a read-only Signal<A>. The reverse conversion is unavailable, and the contained type A remains unchanged.",
  typingBody: "planSet and planUpdate construct update plans. SignalChange exposes no operation to extract a plan's target or value, allowing changes to Signals containing different types in one Array. transaction takes those plans and returns Task<Unit>. Creating a plan alone does not change the current value.",
  evaluationBody: "transaction prepares changes in Array order and publishes once all calculations succeed. A planUpdate for the same Signal receives the value prepared by earlier plans. A defect during preparation or cancellation before publication publishes nothing. Once publication starts, cancellation is deferred until derived recomputation and notification finish.",
  invalidTitle: "A Signal is not an implicitly changing pure value",
  invalidBody: "Pure code may pass a Signal value around but cannot read its current value. Use Signal.read or prefix * within an Effect. Reading an old value and writing it back later can miss updates made between those operations. Use update to calculate and write the next value from the current value.",
  diagnosticsBody: "Type errors distinguish read-only Signal from MutableSignal and report the exact planned value mismatch. Runtime diagnostics identify staging, commit, derived recomputation, and subscriber notification phases.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I update two changing values without exposing a mixed state?",
  summary: "A Signal holds a value at each point in time. Create updatable MutableSignals and Signals calculated from them, then use transaction to publish several updates together.",
  reading: "width and height start at 1 and 2. area is a Signal registering their product. seen records notified areas. subscribe first sends the current area 2 to the recording function and then sends later updates.",
  result: "Updating width to 3 and height to 4 in one transaction records [2, 12]. It does not notify the mixed areas 6 or 4. After unsubscribe stops notifications, signals.read area reads the current area 12."
}

pub fn readerBridgeOne -> String =
  "\\w: Int -> \\h: Int -> w * h takes width and height in order and multiplies them. Passing it to signals.combine explicitly names the dependency Signals. refs provides the record cell, and arrays.append [value] values adds a new value to its end. Array<Int> is an array of integers."

pub fn readerBridgeTwo -> String =
  "planSet creates a change plan without changing the value yet. transaction applies plans in array order and publishes once after all change calculations succeed. A planUpdate for the same target receives the value staged by earlier plans. Creation, reading, updating and subscribing touch state, so they are Effects, executed and bound through <- in main."

pub fn readerMistake -> String =
  "The rejected string plan cannot update an integer Signal such as width. Keep the value types consistent. A defect while calculating changes or cancellation before publication preserves the original values. The transaction covers Signal updates, not arbitrary input/output or external service operations."

pub fn readerCaption -> String =
  "Record notifications to verify that two updates arrive together"

pub fn readerInvalidCaption -> String = "A declaration or call to correct"

pub fn readerDetailNote -> String =
  "The following declaration-only fragment is a smaller view of the same topic. It has no entry point or output."

pub fn readerLegacyReading -> String =
  "x starts at 1 and y at 2. planSet 10 x plans x = 10; planUpdate plans adding 20 to y. transaction publishes both changes together. The following * operations read the updated current values."

pub fn readerLegacyResult -> String =
  "updateCoordinates succeeds with (10, 22). This transaction's notifications do not expose the intermediate state (10, 2). Only Signal updates are grouped this way; transaction does not make ordinary immutable fields writable or include I/O operations."
