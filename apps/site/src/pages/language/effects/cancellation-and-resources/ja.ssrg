import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "キャンセルとリソースの管理",
  summary: (explanation ()).summary,
  ruleTitle: "処理の終了時に、確保したリソースを必ず後片付けする",
  ruleBody: "ファイルや接続は、取得した後に解放する必要があります。bracketは取得・使用・解放の処理を受け取り、使用が終わった後に解放します。acquireReleaseは、取得した値の解放処理を現在のscopeへ登録します。scopeは処理とリソースを管理する範囲です。取得に成功してから解放を登録するまでにキャンセルが入っても、リソースを解放せずに残すことはありません。",
  typingBody: "キャンセルはEffectのEの値ではありません。リソースの解放関数では、EffectExit<E, A>で成功・回復可能な失敗・キャンセルを調べられます。解放処理は回復可能な失敗を呼び出し側へ返せないため、その失敗型はNeverにする必要があります。",
  evaluationBody: "scopeが終了すると、未完了の子の処理へキャンセルを要求し、後片付けを待ちます。登録した解放処理は、登録と逆の順序で一度ずつ実行します。解放中は新たなキャンセルを保留します。明示的な解放とscope終了時の解放が重なっても、同じリソースを二重に解放しません。",
  invalidTitle: "解放処理の失敗は、その処理の中で扱う",
  invalidBody: "解放で想定される失敗は、recoverなどで解放処理の中で扱ってください。一つの解放処理に不具合が起きても、残りの解放を試してから最初の不具合を報告します。後から起きた不具合も診断に残します。解放の不具合は、元の処理の回復可能な失敗より優先して報告されます。",
  diagnosticsBody: "診断では、取得・使用・解放のどの段階で失敗したかを確認してください。解放処理が永久に完了しなければ、scopeの終了も完了しません。元の終了理由と、解放中に起きた不具合を区別して調べます。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "成功しても失敗しても、使い終えたものを片付けるには",
  summary: "リソースは使い終わりに解放が必要なものです。scopedで管理する範囲を作り、acquireReleaseで取得と後片付けを結び付けると、その範囲を出る前に後片付けを行います。",
  reading: "例は実際のファイルを開かず、A、B、Cという名前の取得と解放を記録します。traceは記録用の文字列を持つRefです。acquireは名前を取得したことにして、解放時にその名前をtraceの末尾へ足す処理を登録します。",
  result: "最初のscopeは42で成功し、後から取得したB、次にAを解放するためBAになります。次はCを取得し、failWithでexpectedという理由の失敗を作ります。failWithは空の理由ならokで成功し、それ以外ならその理由で失敗する関数です。recoverが理由を成功値に変える前にCの解放を終えるので、最後の記録はBACです。"
}

pub fn readerBridgeOne -> String =
  "importでeffectsとrefsを読み込みます。fnの引数nameとtraceに続くTask<String>は、名前を成功値にする処理の型です。\\released: String -> ...は後片付けの関数、内側の\\text: String -> text + releasedは記録を更新する関数です。mainの<-は処理の成功値を受け取り、_ <-はその値を使わず完了を待ちます。 effects.scoped $ do { ... }は、effects.scoped (do { ... })と同じく、do全体を一つの引数にする書き方です。|>は左に書いた処理の値を、右の関数呼び出しの最後の引数へ渡します。例ではscopedで囲んだ処理をrecoverへ渡し、失敗した場合の対応を結び付けています。"

pub fn readerBridgeTwo -> String =
  "後片付けの関数をfinalizer、管理範囲をscopeと呼びます。同じscopeでは後から登録したものを先に、一度ずつ実行します。キャンセルでも同じ規則です。これは処理へ停止を要求する仕組みで、失敗型の値とは別です。取得成功とfinalizer登録の間にキャンセルされても取得物を失わない契約があります。"

pub fn readerMistake -> String =
  "拒否例のように、finalizerから型付きの失敗を残すことはできません。後片付け内で必要な失敗を扱い、Neverの失敗型に揃えてください。defectが起きても残りの解放を試みますが、終わらないfinalizerやプロセスの強制終了では完了を保証できません。"

pub fn readerCaption -> String = "取得と後片付けを記録して順序を確かめる"

pub fn readerInvalidCaption -> String = "直すべき宣言・呼び出し"

pub fn readerDetailNote -> String =
  "以下の例は宣言だけを示す補足です。上の実行例で使った考え方を、より小さい断片でも確認できます。実行入口や出力は含みません。"

pub fn readerLegacyReading -> String =
  "この例は、読み書きできる状態Refで後片付けを確認します。releasedの初期値はFalseです。scopedは内側の管理範囲を作ります。その中のacquireReleaseは、refs.set True releasedを解放処理として登録し、範囲が終わると実行します。"

pub fn readerLegacyResult -> String =
  "useScopedはTrueを返します。これは、管理範囲が終わった後にreleasedを読み、登録した解放処理が動いたと確認できるためです。実際のファイルなら、取得したハンドルを閉じる処理を登録します。このような登録済みの後片付けをfinalizerと呼びます。"
