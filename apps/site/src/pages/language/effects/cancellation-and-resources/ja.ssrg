import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "キャンセルとリソースの管理",
  summary: (explanation ()).summary,
  ruleTitle: "処理の終了時に、確保したリソースを必ず後片付けする",
  ruleBody: "bracketやacquireReleaseは、ファイルや接続などを確保した後の解放処理を、現在の処理範囲へ登録します。この範囲をscopeと呼びます。確保に成功してから解放を登録するまでの間にキャンセルが入っても、解放の登録を飛ばしてリソースを残すことはありません。",
  typingBody: "キャンセルはEffectの失敗型Eの値ではありません。終了理由を調べる場合はEffectExit<E, A>で成功・型付きの失敗・キャンセルを区別します。解放処理自身は回復可能な失敗を外へ残せないため、失敗型をNeverにする必要があります。",
  evaluationBody: "scopeの終了時は、未完了の子の処理へキャンセルを要求し、登録した解放処理を逆順に一度ずつ実行します。明示的な解放とscope終了の解放が重なっても、同じ解放処理を二重に実行しません。",
  invalidTitle: "解放処理の失敗は、その処理の中で扱う",
  invalidBody: "解放で想定される失敗は、解放処理の中で扱います。解放中に想定外の不具合が起きても、残りの解放を試してから、最初の不具合を報告します。後で起きた不具合も診断に残ります。",
  diagnosticsBody: "診断では確保・使用・解放のどこで失敗したかを確認します。解放処理が永久に完了しないとscopeも終了できないため、解放には必ず完了できる処理を用意してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "処理が途中で止まったとき、誰が後片付けするか",
  summary: "リソースの管理範囲は、処理と後片付けをまとめて管理します。取得時に解放処理を登録し、成功・失敗・キャンセルのいずれでも後片付けするようにします。",
  reading: "例では本物のファイルを開く代わりに、後片付けを確認するためのRefを使います。releasedは最初Falseです。scopedの中でacquireReleaseがrefs.set True releasedを解放処理として登録し、その範囲を抜けると実行します。",
  result: "useScopedを実行するとTrueになり、登録した解放処理が動いたと分かります。ファイルなら、取得したハンドルを閉じる処理を同じ形で登録します。この後片付けをfinalizerと呼び、そこで起こる回復可能な失敗は内部で扱います。"
}
