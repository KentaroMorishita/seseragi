import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Cancellation and resources",
  summary: (explanation ()).summary,
  ruleTitle: "Release acquired resources when their work ends",
  ruleBody: "Files and connections need release after acquisition. bracket receives acquisition, use, and release operations and releases after use ends. acquireRelease registers cleanup for the acquired value in the current scope. A scope is the boundary managing work and resources. Cancellation between successful acquisition and cleanup registration cannot leave the resource without release.",
  typingBody: "Cancellation is not a value of Effect's E. A resource release function can inspect success, recoverable failure, or cancellation through EffectExit<E, A>. Cleanup cannot return a recoverable failure to its caller, so its error type must be Never.",
  evaluationBody: "When a scope ends, it requests cancellation from unfinished children and waits for cleanup. Registered finalizers run once in reverse registration order. New cancellation is deferred during finalization. If explicit release and scope release overlap, the same resource is not released twice.",
  invalidTitle: "Handle release failures inside cleanup",
  invalidBody: "Handle anticipated release failures inside the finalizer, using recover or a similar operation. If one finalizer defects, the runner attempts the remaining finalizers before reporting the first defect. Later defects remain in diagnostics. A finalizer defect takes reporting precedence over the original computation's recoverable failure.",
  diagnosticsBody: "Identify whether acquisition, use, or release failed. A finalizer that never completes also prevents its scope from finishing. Distinguish the original termination reason from any defects during cleanup.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Who releases a resource if work stops early?",
  summary: "Register cleanup when acquiring a resource such as a file or connection. That cleanup runs after success and also when failure or cancellation stops the work.",
  reading: "The example uses mutable state in a Ref to observe cleanup. released starts False. scoped creates an inner management scope. Inside it, acquireRelease registers refs.set True released as cleanup, which runs when that scope ends.",
  result: "useScoped returns True because it reads released after the scope ends and observes that cleanup ran. For an actual file, register the operation closing its acquired handle. This registered cleanup is called a finalizer."
}
