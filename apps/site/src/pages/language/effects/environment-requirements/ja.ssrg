import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effectが必要とするサービス",
  summary: (explanation ()).summary,
  ruleTitle: "必要なサービスをEffectの型に書く",
  ruleBody: "サービスは、設定の取得や出力など、処理が利用する機能を表す値です。複数のEffectを組み合わせると、それぞれに必要なサービスをまとめて要求します。同じ名前のサービスは、型も一致する必要があります。サービスを取得する操作はEffect.serviceで、省略可能なフィールドや暗黙のグローバル変数にはしません。",
  typingBody: "必要なサービスをすべて同じ型で持つ環境なら、追加のサービスがあっても使えます。この規則はEffectに対して定めたもので、任意のジェネリック型へは適用できません。型パラメーターRを使う関数では、R & { service: Service }と書いて必要なサービスを追加できます。",
  evaluationBody: "Effect.provideは、使うサービスを指定したEffectを作ります。provideSomeは、実行時に外側の環境から必要な環境を作る操作です。実行機構は処理を始める前にサービスを検査するため、必要なサービスがないまま処理を開始することはありません。",
  invalidTitle: "使えるかどうかが変わる機能は、操作の結果で表す",
  invalidBody: "必要なサービスのフィールドは省略可能にできません。機能が使えない場合もあるなら、Maybeを返す操作をサービスに用意してください。別の方法として、実行前に使えるサービスを選び、provideで指定できます。",
  diagnosticsBody: "型エラーが出たら、要求したサービスのフィールド名と型を、渡す環境と見比べてください。選んだ実行先で提供できないサービスは、処理を開始する前に報告されます。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "同じ処理へ、実行する場所の設定を渡すには",
  summary: "必要な設定を、暗黙のグローバル変数ではなく処理の型で示します。ここではSettingsのlabelを読み、与えた文字列を表示します。",
  reading: "SettingsはStringのlabelを持つ構造体です。selectSettingsは{ settings: Settings }というレコードからsettingsを選ぶ普通の関数です。effects.serviceは、実行時の環境へその関数を使う処理を作ります。",
  result: "出力はHello, Akiです。mainのprovideが渡すSettingsに、そのlabelが入っています。applicationLabelのコードを変えずに、別の実行用の設定を与えられます。",
}

pub fn readerCaption -> String = "必要な設定を渡してから実行する"

pub fn readerBridgeOne -> String =
  "with Settingsは、正規の型では{ settings: Settings }という要求です。applicationLabelのdoでsettings <- ...と書くと、取得したSettingsを名前で使えます。succeedは、そのlabelを成功値として返す処理を作ります。"

pub fn readerBridgeTwo -> String =
  "effects.provideは、使う環境と対象のEffectを受け取り、その環境を指定したEffectを返します。provideを書いた場所で実行するのではありません。mainへ返った処理を実行すると、labelを受け取ってprintlnへ渡します。"

pub fn readerInvalidCaption -> String = "必要なsettingsフィールドを渡さない"

pub fn readerMistake -> String =
  "effects.provide {}では必要なsettingsがなく、SES-T0101です。{ settings: Settings { label: \"Hello, Aki\" } }のように、宣言した型の値を用意します。フィールド名と、その中に入る型の両方を合わせます。"

pub fn readerDetailNote -> String =
  "以下の詳しい規則では、宣言だけの例も示します。単独の実行入口はないため、実行する場合は上のmain付きの完全な例を使ってください。"

pub fn readerLegacyReading -> String =
  "SettingsはString型のlabelを持つ型です。{ settings: Settings }は、環境にsettingsフィールドが必要なことを表します。effects.serviceは実行時にenvironment.settingsを取り出します。mapに渡した関数は、そのSettingsからlabelを取り出してStringを返します。"

pub fn readerLegacyResult -> String =
  "実行するには、settingsフィールドにSettingsの値を持つ環境が必要です。計算を作る時点と、実行用の環境を渡す時点は分かれています。関数のコードを変えずに、実行する環境ごとに異なる設定を渡せます。"
