import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effectが必要とするサービス",
  summary: (explanation ()).summary,
  ruleTitle: "必要なサービスをEffectの型に書く",
  ruleBody: "サービスは、設定の取得や出力など、処理が利用する機能を表す値です。複数のEffectを組み合わせると、それぞれに必要なサービスをまとめて要求します。同じ名前のサービスは、型も一致する必要があります。サービスを取得する操作はEffect.serviceで、省略可能なフィールドや暗黙のグローバル変数にはしません。",
  typingBody: "必要なサービスをすべて同じ型で持つ環境なら、追加のサービスがあっても使えます。この規則はEffectに対して定めたもので、任意のジェネリック型へは適用できません。型パラメーターRを使う関数では、R & { service: Service }と書いて必要なサービスを追加できます。",
  evaluationBody: "Effect.provideは、使うサービスを指定したEffectを作ります。provideSomeは、実行時に外側の環境から必要な環境を作る操作です。実行機構は処理を始める前にサービスを検査するため、必要なサービスがないまま処理を開始することはありません。",
  invalidTitle: "使えるかどうかが変わる機能は、操作の結果で表す",
  invalidBody: "必要なサービスのフィールドは省略可能にできません。機能が使えない場合もあるなら、Maybeを返す操作をサービスに用意してください。別の方法として、実行前に使えるサービスを選び、provideで指定できます。",
  diagnosticsBody: "型エラーが出たら、要求したサービスのフィールド名と型を、渡す環境と見比べてください。選んだ実行先で提供できないサービスは、処理を開始する前に報告されます。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "処理がアプリケーションの設定を要求するには",
  summary: "Effectの第一の型引数Rには、必要なサービスをレコードで書きます。実行環境からそのサービスを受け取るため、設定などを暗黙のグローバル変数にする必要はありません。",
  reading: "SettingsはString型のlabelを持つ型です。{ settings: Settings }は、環境にsettingsフィールドが必要なことを表します。effects.serviceは実行時にenvironment.settingsを取り出します。mapに渡した関数は、そのSettingsからlabelを取り出してStringを返します。",
  result: "実行するには、settingsフィールドにSettingsの値を持つ環境が必要です。計算を作る時点と、実行用の環境を渡す時点は分かれています。関数のコードを変えずに、実行する環境ごとに異なる設定を渡せます。"
}
