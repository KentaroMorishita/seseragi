import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effect environment requirements",
  summary: (explanation ()).summary,
  ruleTitle: "State required services in the Effect type",
  ruleBody: "A service is a value representing a capability used by a computation, such as settings access or output. Combining Effects requires all of their services. Services with the same field name must have the same type. Obtain them through Effect.service rather than optional fields or implicit global variables.",
  typingBody: "An environment can provide extra services if it contains every required service with the same type. This is a rule specifically for Effect, not for arbitrary generic types. A function using type parameter R can add a required service with R & { service: Service }.",
  evaluationBody: "Effect.provide constructs an Effect with specified services. provideSome creates the needed environment from an outer environment at execution time. The runtime validates services before starting the computation, so work does not begin with a required service missing.",
  invalidTitle: "Optional capabilities are explicit service operations",
  invalidBody: "A required service field cannot be optional. If a capability may be unavailable, add a service operation returning Maybe. Alternatively, select an available service before execution and supply it with provide.",
  diagnosticsBody: "For a type error, compare the required service field names and types with the environment being supplied. A service unavailable on the selected target is reported before work starts.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How does a computation request application settings?",
  summary: "Effect's first type argument R is a record of required services. The execution environment supplies them, so settings do not need to be implicit global variables.",
  reading: "Settings has a label of type String. { settings: Settings } requires a settings field in the environment. effects.service retrieves environment.settings during execution. The function passed to map selects that Settings value's label and returns a String.",
  result: "Execution requires an environment whose settings field contains a Settings value. Constructing the computation and supplying its environment are separate stages. Different execution environments can supply different settings without changing the function."
}
