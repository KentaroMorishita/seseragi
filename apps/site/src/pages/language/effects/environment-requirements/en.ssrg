import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effect environment requirements",
  summary: (explanation ()).summary,
  ruleTitle: "State required services in the Effect type",
  ruleBody: "A service is a value representing a capability used by a computation, such as settings access or output. Combining Effects requires all of their services. Services with the same field name must have the same type. Obtain them through Effect.service rather than optional fields or implicit global variables.",
  typingBody: "An environment can provide extra services if it contains every required service with the same type. This is a rule specifically for Effect, not for arbitrary generic types. A function using type parameter R can add a required service with R & { service: Service }.",
  evaluationBody: "Effect.provide constructs an Effect with specified services. provideSome creates the needed environment from an outer environment at execution time. The runtime validates services before starting the computation, so work does not begin with a required service missing.",
  invalidTitle: "Optional capabilities are explicit service operations",
  invalidBody: "A required service field cannot be optional. If a capability may be unavailable, add a service operation returning Maybe. Alternatively, select an available service before execution and supply it with provide.",
  diagnosticsBody: "For a type error, compare the required service field names and types with the environment being supplied. A service unavailable on the selected target is reported before work starts.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I supply settings for the place where work runs?",
  summary: "State required settings in the work’s type instead of reading an implicit global variable. This example reads Settings.label and displays the supplied text.",
  reading: "Settings is a struct with a String label. selectSettings is an ordinary function selecting settings from a { settings: Settings } record. effects.service constructs work that applies that selector to the execution environment.",
  result: "The output is Hello, Aki, the label in the Settings supplied by main’s provide. A different execution can supply different settings without changing applicationLabel.",
}

pub fn readerCaption -> String = "Supply the required settings before execution"

pub fn readerBridgeOne -> String =
  "with Settings normalizes to the requirement { settings: Settings }. settings <- ... in applicationLabel’s do makes the retrieved Settings available by name. succeed constructs work returning its label as the success value."

pub fn readerBridgeTwo -> String =
  "effects.provide takes an environment and an Effect, returning an Effect with that environment supplied. It does not execute it at that call site. When the work returned by main runs, the label is received and passed to println."

pub fn readerInvalidCaption -> String = "Do not supply the settings field"

pub fn readerMistake -> String =
  "effects.provide {} lacks the required settings and reports SES-T0101. Supply the declared value, such as { settings: Settings { label: \"Hello, Aki\" } }. Both the field name and its contents type must match."

pub fn readerDetailNote -> String =
  "The detailed rules below also use declaration-only examples. They have no standalone entry point; use the complete program with main above when you want to run an example."

pub fn readerLegacyReading -> String =
  "Settings has a label of type String. { settings: Settings } requires a settings field in the environment. effects.service retrieves environment.settings during execution. The function passed to map selects that Settings value's label and returns a String."

pub fn readerLegacyResult -> String =
  "Execution requires an environment whose settings field contains a Settings value. Constructing the computation and supplying its environment are separate stages. Different execution environments can supply different settings without changing the function."
