import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.effects.environment-requirements" "/docs/language/effects/environment-requirements/" (en.copy ()) (ja.copy ()) [CodeExample
      ("effects-environment", localized "Selecting one typed service" "必要なサービスを取得する")] [CodeExample
      (
        "effects-invalid-contract",
        localized "Rejected missing Console requirement" "Consoleの要求が不足する例"
      )] [
        [InternalLink (
          localized "Requirement merge" "必要なサービスを組み合わせる",
          "/docs/language/types/requirement-merge/"
        )],
        [InternalLink (
          localized "Effect functions with an explicit contract" "Effect関数の型を明示する形式",
          "/docs/language/effects/effect-functions-contract-form/"
        )],
        [InternalLink (
          localized "Effect runtime boundaries" "Effectを実行する境界",
          "/docs/language/effects/runtime-boundaries/"
        )]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample (
          "failure-reader-environment",
          localized (en.readerCaption ()) (ja.readerCaption ())
        ),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "Hello, Aki"),
        CodeExample (
          "failure-reader-environment-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Heading (
          "declaration-example",
          localized "Read the declaration-only example" "宣言だけの例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
