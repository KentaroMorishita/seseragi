import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  referencePage "language.effects.either" "/docs/language/effects/either/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-either",
        localized "Typed validation and right-side mapping" "型付きvalidationとright側のmap"
      )] [] [
        [InternalLink (localized "Maybe" "Maybe", "/docs/language/effects/maybe/")],
        [InternalLink (
          localized "Effect error channels" "Effectのerror channel",
          "/docs/language/effects/error-channels/"
        )],
        [InternalLink (
          localized "Algebraic data types" "代数的data型",
          "/docs/language/data/algebraic-data-types/"
        )]
      ]
