import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Either and typed results",
  summary: (explanation ()).summary,
  ruleTitle: "Return a success value or an error reason",
  ruleBody: "Either<E, A> is Left containing an error reason E or Right containing a successful result A. Use it for a calculated result with an error reason, such as parsing text or validating input. Either stores a result already calculated; Effect represents work to execute. Use Validation when independent validation errors must be accumulated.",
  typingBody: "mapRight changes only the successful value inside Right and preserves a Left error. Mapping the error side changes only E. Chaining Either operations stops subsequent success processing at the first Left. Convert distinct error types explicitly to a common type before combining them.",
  evaluationBody: "Constructing Left or Right produces an ordinary result immediately. Matching and transformations inspect which case is present and call only the required branch. Creating an Either does not itself start I/O.",
  invalidTitle: "Either is not an Effect failure channel",
  invalidBody: "Left in Either is ordinary data, separate from an Effect's recoverable failure. fromEither creates an Effect that interprets Left as failure and Right as success when executed. Conversely, attempt receives an Effect's recoverable failure as Left and success as Right.",
  diagnosticsBody: "Diagnostics retain the distinct E and A positions and report branch, mapping, or expected-result mismatches at the operation that introduced them.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I return a failure reason to the caller?",
  summary: "Return a success value for a positive integer, or a reason for zero and negative values. Either is an ordinary value containing Right for success or Left for a reason.",
  reading: "In Either<String, Int>, String is the failure-reason type and Int is the success type. positive 2 returns Right 2; positive 0 returns Left \"must be positive\". describe uses match to inspect the alternative and names its contents value or reason.",
  result: "The output is ok: 2 and error: must be positive. Creating Left does not throw control to an exception handler. The caller inspects the returned value and chooses its display or next operation.",
}

pub fn readerCaption -> String = "Return a success value or failure reason"

pub fn readerBridgeOne -> String =
  "This TypeScript example throws for a nonpositive value and formats it in the caller’s try/catch. Seseragi returns Left and reads it with match, so control propagation differs. The compared inputs are the integers 2 and 0 with matching messages; external-input parsing and validation of every possible number are outside the example."

pub fn readerBridgeTwo -> String =
  "TypeScript can also return a union of success/failure objects. Here familiar try/catch provides a starting point for returning reasons as values. Seseragi’s pub effect fn main is the output entry, and println prints both messages on separate lines."

pub fn readerInvalidCaption -> String = "Put a string in the success alternative"

pub fn readerMistake -> String =
  "Right \"2\" in Either<String, Int> reports SES-T0101. Right needs the success type Int, so use Right 2. String is the type of the failure reason carried by Left."

pub fn readerDetailNote -> String =
  "The detailed rules below also use declaration-only examples. They have no standalone entry point; use the complete program with main above when you want to run an example."

pub fn readerLegacyReading -> String =
  "positive returns Right value when the integer is positive and Left (NotPositive value) otherwise. increment uses mapRight to add one only to a successful value, preserving any failure reason."

pub fn readerLegacyResult -> String =
  "increment (positive 2) returns Right 3. For zero it returns Left (NotPositive 0) unchanged. A caller can use match to separate successful output from handling each error reason. Either is ordinary data, so it does not wait for execution to start as an Effect does."
