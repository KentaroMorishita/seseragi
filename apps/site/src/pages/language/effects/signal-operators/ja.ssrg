import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Signalの演算子",
  summary: "prefix *はSignal snapshotを読み、:=はMutableSignalへ書きます。どちらもeffectful operationです。",
  ruleTitle: "*で読み、:=で更新する。ただし、どちらもEffect",
  ruleBody: "*sourceはSignal.read sourceと同じで、Task<A>を返します。target := valueはSignal.set value targetと同じで、Task<Unit>を返します。*が二つの値の間にある場合は、通常の乗算です。",
  typingBody: "SignalとMutableSignalはどちらも読めますが、:=で更新できるのはMutableSignalだけです。通常のletやstructのフィールドを代入可能にする記号ではありません。",
  evaluationBody: "一回の:=が一つの更新になります。*は、その処理が実行された時点の安定した現在値を読みます。現在値から新しい値を計算して一つの操作で更新するならupdateを使います。",
  invalidTitle: "現在値を読む操作もEffectである",
  invalidBody: "*sourceはAそのものではなくTask<A>です。純粋な関数からAとして返せません。また、読み取りを行って後で書き戻す操作と、updateによる一回の更新は同じではありません。",
  diagnosticsBody: ":=の左に読み取り専用のSignalや普通の値を置いていないか確認します。*の結果を使うときは、Taskを実行して中の値を受け取る必要があります。",
}
