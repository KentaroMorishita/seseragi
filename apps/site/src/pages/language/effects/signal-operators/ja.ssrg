import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Signalの演算子",
  summary: (explanation ()).summary,
  ruleTitle: "*で現在値を読み、:=で更新する",
  ruleBody: "接頭辞の*sourceはSignal.read sourceと同じで、Task<A>を返します。target := valueはSignal.set value targetと同じで、Task<Unit>を返す更新操作です。二つの値の間に書く*は、通常の乗算のままです。",
  typingBody: "SignalとMutableSignalはどちらも読めますが、:=で更新できるのはMutableSignalだけです。通常のletやstructのフィールドを代入可能にする記号ではありません。",
  evaluationBody: "一回の:=は、一件のトランザクションとして実行します。*は、Taskを実行した時点の更新が確定した現在値を返します。現在値から新しい値を計算し、一つの操作として更新するにはupdateを使います。",
  invalidTitle: "現在値を読む操作もEffectである",
  invalidBody: "*sourceの型はTask<A>なので、純粋な関数からAとして返すと型エラーになります。また、古い値を読んで後から書き戻す場合は、その間の変更を反映できないことがあります。現在値から計算して更新するにはupdateを使ってください。",
  diagnosticsBody: ":=の左側がMutableSignalか確認してください。読み取り専用のSignalや普通の値は更新できません。*の結果がTask<A>であることにも注意し、doなどで実行後のAを受け取って使います。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Signalの現在値を読み、値を更新する記号はどう使うか",
  summary: "*countは現在値を読む処理、count := 4は更新する処理です。どちらもEffectなので、通常の式が勝手に変化する仕組みにはなりません。",
  reading: "countを0で作り、snapshot <- *countで整数0を保存します。count := 4で現在値を4へ変え、updateで今の値に1を足します。current <- *countが更新後の整数5を読みます。",
  result: "出力は0、5、10です。先に読んだsnapshotは0のままです。最後のcurrent * 2は二項の乗算で、先頭に書く*countというSignal読取とは位置が異なります。"
}

pub fn readerBridgeOne -> String =
  "importはstd/signalをsignalsとして読み込みます。pub effect fn mainが実行入口で、doでは処理を順に実行します。<-は処理の成功値に名前を付ける記号です。Intは整数、\\value: Int -> value + 1は現在値から次の値を計算する関数です。"

pub fn readerBridgeTwo -> String =
  "*countの型はTask<Int>で、signals.read countの短い表記です。:=はsignals.setの短い表記で、書き込み可能なMutableSignalにだけ使えます。普通のlet変数やレコードのフィールドへ代入する記号ではありません。現在値に基づく更新は、読み取りと書き込みを別にせずsignals.updateでまとめてください。"

pub fn readerMistake -> String =
  "拒否例のsnapshotは普通のIntを返す宣言なのに、本文はTask<Int>です。戻り値をTask<Int>にし、呼び出し側のdoで実行して値を受け取ります。読み取り専用の派生Signalへ:=を書くこともできません。"

pub fn readerCaption -> String = "読み取った整数と、その後に変わるSignalを比べる"

pub fn readerInvalidCaption -> String = "直すべき宣言・呼び出し"

pub fn readerDetailNote -> String =
  "以下の例は宣言だけを示す補足です。上の実行例で使った考え方を、より小さい断片でも確認できます。実行入口や出力は含みません。"

pub fn readerLegacyReading -> String =
  "countの初期値は0です。count := 1を実行すると現在値が1になります。signals.updateはその現在値に1を足し、最後の* countが更新後の値を読みます。これらのTaskをdoで順につないでいます。"

pub fn readerLegacyResult -> String =
  "readAndWriteは2を返します。* count自体はTask<Int>で、通常のIntとして使えません。また、:=はMutableSignalに限った操作で、letの変数やstructのフィールドへの代入には使えません。"
