import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Signal operators",
  summary: (explanation ()).summary,
  ruleTitle: "Read the current value with * and update it with :=",
  ruleBody: "Prefix *source is equivalent to Signal.read source and returns Task<A>. target := value is equivalent to Signal.set value target and returns Task<Unit>. A * written between two values remains ordinary multiplication.",
  typingBody: "Both Signal<A> and MutableSignal<A> can be read, but only MutableSignal<A> can appear on the left of :=. Ordinary variables and struct fields are immutable and never become assignable through this operator.",
  evaluationBody: "Each := executes as one transaction. * returns the committed current value at the time its Task executes. Use update to calculate the next value from the current value and write it as one operation.",
  invalidTitle: "Reading a current value also returns an Effect",
  invalidBody: "Since *source has type Task<A>, returning it as A from a pure function produces a type error. Reading an old value and writing it back later may also miss changes between those operations. Use update to calculate and write the next value from the current one.",
  diagnosticsBody: "Check that the left side of := is a MutableSignal. A read-only Signal or ordinary value cannot be updated. Also remember that * returns Task<A>; obtain the executed A through do or another Effect composition operation.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What do * and := do with a Signal?",
  summary: "Prefix * constructs a Task reading a Signal's current value. := is a Task representing a MutableSignal update. Both access state when executed.",
  reading: "count starts at 0. Executing count := 1 changes its current value to 1. signals.update adds one to that current value, and * count reads the updated value. do links these Tasks in sequence.",
  result: "readAndWrite returns 2. * count itself is Task<Int>, not an ordinary Int. := applies only to MutableSignal; it does not assign to a let variable or a struct field."
}
