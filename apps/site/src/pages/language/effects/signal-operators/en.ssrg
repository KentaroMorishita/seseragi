import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Signal operators",
  summary: (explanation ()).summary,
  ruleTitle: "Operators expose state access, not assignment syntax",
  ruleBody: "*source desugars to Signal.read source and has type Task<A>. target := value desugars to Signal.set value target and has type Task<Unit>; binary * remains multiplication.",
  typingBody: "Both Signal<A> and MutableSignal<A> can be read, but only MutableSignal<A> can appear on the left of :=. Ordinary variables and struct fields are immutable and never become assignable through this operator.",
  evaluationBody: "Each := is one transaction. Reading with * observes the current stable snapshot at that Effect step; update is the atomic operation for deriving a new value from the old one.",
  invalidTitle: "Do not treat * as a pure dereference",
  invalidBody: "A pure function cannot return *source as A because the expression is Task<A>. Likewise, target := *target is neither an atomic increment nor valid pure assignment; use update instead.",
  diagnosticsBody: "Diagnostics distinguish prefix * from multiplication by position, show the resulting Task type, and report when := receives a read-only Signal or a non-Signal target.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What do * and := do with a Signal?",
  summary: "Prefix * reads a Signal's current value through an Effect. := writes a MutableSignal through an Effect; it is not assignment to ordinary variables.",
  reading: "count is created with 0. count := 1 sets its current value to 1. signals.update applies current + 1 as one update, and * count reads the resulting current value.",
  result: "Executing readAndWrite returns 2. A pure function cannot treat * count as an immediate Int; its type is Task<Int>. Use update for read-modify-write rather than separately reading an old value and writing a replacement."
}
