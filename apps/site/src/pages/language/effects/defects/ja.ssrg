import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "想定外の不具合（defect）",
  summary: (explanation ()).summary,
  ruleTitle: "回復可能な失敗と、処理を停止する不具合を分ける",
  ruleBody: "整数の範囲超過や0除算など、処理を続けられない不具合をdefectと呼びます。実行基盤が保証する条件に違反した場合、メモリ不足、安全な外部連携で約束した型に違反する値も、この不具合として処理を停止する場合があります。不正な入力や通信の失敗など、呼び出し側が処理できる結果にはEitherやEffectのEを使います。",
  typingBody: "defectはEffectのEの値ではありません。recoverが受け取るのは回復可能な失敗だけです。任意のdefectを捕捉して成功値に変える一般的なcatch構文もありません。",
  evaluationBody: "defectが起きると、その処理を止め、登録済みのリソースの後片付けを始めます。解放処理にも不具合が起きた場合は、残りの解放処理を試してから最初の不具合を報告します。後から起きた不具合も診断に記録します。",
  invalidTitle: "想定できる失敗をdefectに変えない",
  invalidBody: "解析の失敗、権限の拒否、サービスが使えない場合など、アプリケーションが想定する結果は、呼び出し側が調べられる型で返してください。defectへ変えると、戻り値の型から回復方法を確認できなくなります。",
  diagnosticsBody: "実行時の診断では、回復可能な失敗とdefectを分けて確認してください。診断には、取得できたソース位置と呼び出しの経緯も記録されます。defectはEの値ではないため、アプリケーションのShow<E>による表示は行いません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "不正な入力を、扱える失敗として返すには",
  summary: "0で割る可能性があるなら、計算前に確認して理由を返せます。defectは、そのような回復可能な失敗とは別の、処理を停止する不具合です。",
  reading: "checkedDivideは除数が0ならLeftで理由を返し、0以外ならRightに整数の商を入れます。describeのmatchは、成功した整数か失敗理由の文字列を表示用に変えます。",
  result: "出力は3とcannot divide by zeroです。このInt同士の例では7 / 2の整数の商は3です。0の場合は除算そのものを行わず、呼び出し側が読める通常の値を返しています。",
}

pub fn readerCaption -> String = "除算の前に入力を確認する"

pub fn readerBridgeOne -> String =
  "Either<String, Int>は、Leftに文字列の理由、Rightに整数の結果を持つ型です。Leftを作ってもthrowしません。pub effect fn mainが、二つの通常の結果をprintlnで表示します。"

pub fn readerBridgeTwo -> String =
  "TypeScriptのtry/catchと対応させる際は、数値の規則も区別してください。TypeScriptのnumberでは7 / 0はInfinity、7 / 2は3.5です。SeseragiのIntでは0除算はdefectで、recoverが受け取る失敗値Eにはなりません。"

pub fn readerInvalidCaption -> String = "recoverでも整数の0除算は回復しない"

pub fn readerMistake -> String =
  "停止する例ではdeferへ渡した\\_ -> ...の関数が、実行時にdivide 0を行います。recoverに42を返す処理を置いても呼ばれず、stdoutは空、CLIはruntime defectで終了します。入力として予想できる0は、上のcheckedDivideのように先に検査して理由を返してください。"

pub fn readerDetailNote -> String =
  "以下の詳しい規則では、宣言だけの例も示します。単独の実行入口はないため、実行する場合は上のmain付きの完全な例を使ってください。"

pub fn readerLegacyReading -> String =
  "checkedDivideは除算前にdivisorを調べます。0ならLeft ZeroDivisorを返すため、不正な除算をせずに、呼び出し側で理由を説明できます。それ以外なら商をRightに入れて返します。"

pub fn readerLegacyResult -> String =
  "checkedDivide 7 2はRight 3、checkedDivide 7 0はLeft ZeroDivisorを返します。0を除数にする可能性を先に確認し、理由を通常の値として返すので、呼び出し側で処理できます。recoverなどがすべての実行時の不具合を捕捉するわけではありません。"
