import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "想定外の不具合（defect）",
  summary: (explanation ()).summary,
  ruleTitle: "回復可能な失敗と、処理を停止する不具合を分ける",
  ruleBody: "整数の範囲超過や0除算など、処理を続けられない不具合をdefectと呼びます。実行基盤が保証する条件に違反した場合、メモリ不足、安全な外部連携で約束した型に違反する値も、この不具合として処理を停止する場合があります。不正な入力や通信の失敗など、呼び出し側が処理できる結果にはEitherやEffectのEを使います。",
  typingBody: "defectはEffectのEの値ではありません。recoverが受け取るのは回復可能な失敗だけです。任意のdefectを捕捉して成功値に変える一般的なcatch構文もありません。",
  evaluationBody: "defectが起きると、その処理を止め、登録済みのリソースの後片付けを始めます。解放処理にも不具合が起きた場合は、残りの解放処理を試してから最初の不具合を報告します。後から起きた不具合も診断に記録します。",
  invalidTitle: "想定できる失敗をdefectに変えない",
  invalidBody: "解析の失敗、権限の拒否、サービスが使えない場合など、アプリケーションが想定する結果は、呼び出し側が調べられる型で返してください。defectへ変えると、戻り値の型から回復方法を確認できなくなります。",
  diagnosticsBody: "実行時の診断では、回復可能な失敗とdefectを分けて確認してください。診断には、取得できたソース位置と呼び出しの経緯も記録されます。defectはEの値ではないため、アプリケーションのShow<E>による表示は行いません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "入力が不正なとき、実行を止める不具合として扱うべきか",
  summary: "defectは、整数の0除算など、処理を停止する不具合です。呼び出し側が予測して扱う不正入力は、回復できる結果の型で返してください。",
  reading: "checkedDivideは除算前にdivisorを調べます。0ならLeft ZeroDivisorを返すため、不正な除算をせずに、呼び出し側で理由を説明できます。それ以外なら商をRightに入れて返します。",
  result: "checkedDivide 7 2はRight 3、checkedDivide 7 0はLeft ZeroDivisorを返します。0を除数にする可能性を先に確認し、理由を通常の値として返すので、呼び出し側で処理できます。recoverなどがすべての実行時の不具合を捕捉するわけではありません。"
}
