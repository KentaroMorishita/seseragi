import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.effects.defects" "/docs/language/effects/defects/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-defects",
        localized "Modeling an expected zero divisor as data" "ゼロ除算を失敗の値として返す"
      )] [] [
        [InternalLink (
          localized "Effect error channels" "Effectの回復可能な失敗",
          "/docs/language/effects/error-channels/"
        )],
        [InternalLink (
          localized "No hidden danger" "危険を暗黙に隠さない",
          "/docs/language/model/no-hidden-danger/"
        )],
        [InternalLink (
          localized "Backend-independent semantics" "生成先に依存しない意味",
          "/docs/language/model/backend-independent-semantics/"
        )]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
