import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Derived Signals",
  summary: (explanation ()).summary,
  ruleTitle: "Derive changing values from specified source Signals",
  ruleBody: "map derives a value from one Signal; combine derives a value from several Signals. constant holds an unchanging value. distinct removes notifications equal to the previous value, while switchMap changes which Signal supplies the current value. Specify dependencies explicitly as arguments to these functions.",
  typingBody: "Operations constructing derived Signals are pure functions. map and combine return read-only Signals. distinct requires Eq<A> to compare values. switchMap chooses the next Signal from a source value and returns a read-only Signal holding the selected Signal's current value.",
  evaluationBody: "Within one transaction, derived Signals are recalculated starting with those nearest the sources. Each affected derived Signal is recalculated at most once for that update, and notification waits until all values are ready. In the same transaction, switchMap releases the old dependency and publishes the selected dependency's current value once.",
  invalidTitle: "Notifications contain consistent derived values",
  invalidBody: "Subscribers do not receive an inconsistent combination where only one input has updated. Ordinary set and update notify even if the new value equals the old one. Use distinct to omit equal-value notifications. Reading a Signal inside an arbitrary function does not automatically register it as a dependency.",
  diagnosticsBody: "Construction rejects dependency cycles and missing Eq evidence. Runtime graph diagnostics identify the derived node and constructor while preserving the transaction that triggered recomputation.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How can a total follow changing prices and shipping costs?",
  summary: "Build a read-only Signal calculated from source Signals. Naming the inputs explicitly lets the total follow changes without manually writing each new total.",
  reading: "price and shipping are updatable values. The first signals.map calls use identity functions to create read-only priceValues and shippingValues. doubled is a Signal for twice the price; total adds its value to shipping.",
  result: "The first read gives 22 from price 10 and shipping 2. After one transaction sets price 20 and shipping 5, the next read gives 45. before remains the integer 22 captured at its read. Distinguish the changing total Signal from an integer read from it."
}

pub fn readerBridgeOne -> String =
  "add is an ordinary function adding two integers. f <$> source builds a Signal applying f to source’s value. add <$> doubled holds the remaining function after add receives the price value. <*> shippingValues combines it with the shipping Signal to produce a total Signal. This is the Applicative combination used here."

pub fn readerBridgeTwo -> String =
  "\\value: Int -> value returns its input, and value * 2 is integer multiplication. Building derived Signals with map or these operators is pure. Reading a current value with signals.read returns a Task, so main uses <- in do. A transaction supplies all changed sources before stabilizing derived values and notifying subscribers."

pub fn readerMistake -> String =
  "Signal has no Monad instance to select the next Signal through >>=, so the rejected example cannot compile. Explicitly use signals.switchMap when a value chooses another dependency Signal. Reading a Signal incidentally inside a function does not automatically register a dependency."

pub fn readerCaption -> String =
  "Combine doubled prices and shipping while keeping them as Signals"

pub fn readerInvalidCaption -> String = "A declaration or call to correct"

pub fn readerDetailNote -> String =
  "The following declaration-only fragment is a smaller view of the same topic. It has no entry point or output."

pub fn readerLegacyReading -> String =
  "left starts at 1 and right at 2. combine add left right creates a read-only total that passes both current values to add. A transaction changes left to 10 and right to 20, and total is recalculated from those updated values."

pub fn readerLegacyResult -> String =
  "stableTotal returns 30. Because both changes belong to one transaction, notifications do not contain a temporary sum with one old input. The dependencies are written as combine arguments rather than inferred automatically from reads inside a function."
