import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Maybe and absence",
  summary: (explanation ()).summary,
  ruleTitle: "Use Nothing when no value is a valid result",
  ruleBody: "Maybe<A> is either Nothing with no value or Just containing an A. Use it when absence, such as a search with no match, is a normal result. Choose Either if the caller also needs a reason for absence. Convert nullable foreign values to Maybe at the interop boundary.",
  typingBody: "value ?? fallback unwraps the A inside Just. If value is Nothing, it returns fallback instead, so the fallback must also have type A. The whole expression has type A. ?? groups to the right and works only with Maybe, not with Either, nullable foreign values, or ordinary values.",
  evaluationBody: "?? evaluates its left side first. Just value returns value without evaluating the right side. Only Nothing evaluates the fallback, so an expensive fallback calculation runs only when it is needed.",
  invalidTitle: "Absence and failure are different questions",
  invalidBody: "Maybe has no place to store a reason for absence. Using it for an operation whose caller needs a reason loses that information. False and 0 remain ordinary values; neither is converted automatically to Nothing.",
  diagnosticsBody: "Type errors identify a non-Maybe left operand or a fallback whose type differs from A. Exhaustive matching still requires both Nothing and Just when pattern matching directly.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I use a value that might be absent?",
  summary: "Maybe<A> distinguishes Just containing a value from Nothing containing no value. Use it for normal absence, such as a search that finds no match.",
  reading: "displayName checks cached first, then requested, then uses \"anonymous\". ?? unwraps Just's string; its right side is evaluated only for Nothing. Because the operator groups from the right, requested ?? \"anonymous\" supplies the fallback for cached.",
  result: "With cached = Just \"Aki\", the result is \"Aki\". With both inputs Nothing, it is \"anonymous\". Use match when you need different processing for presence and absence, or Either when absence must carry an explanation."
}
