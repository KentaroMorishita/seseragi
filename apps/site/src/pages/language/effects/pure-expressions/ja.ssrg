import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "純粋な式",
  summary: (explanation ()).summary,
  ruleTitle: "外部の読み書きと、値の計算を分ける",
  ruleBody: "純粋な関数は、渡された引数から戻り値を計算します。画面への出力、通信、ファイル操作、時刻や乱数の取得にはEffectを使います。変更可能な状態の読み書きや非同期処理もEffectで表すため、戻り値の型から外部への操作を確認できます。",
  typingBody: "コンパイラは、使う操作の型を検査して純粋な計算と外部への操作を区別します。純粋な関数からEffect<R, E, A>を作って返すことは可能です。ただし、Effectはこれから実行する処理を表す値なので、実行後の結果Aとしては使えません。",
  evaluationBody: "通常の式では、引数を順に計算してから関数を呼びます。Effectを作る際にも、必要な純粋な計算はその場で行います。出力や状態の更新など、Effectが表す外部への操作は、実行入口でそのEffectを実行するまで始まりません。",
  invalidTitle: "Effectを返すことと実行することは違う",
  invalidBody: "出力する関数の戻り値には、出力処理を表すEffectが必要です。時刻の取得やSignalの更新も同じです。通常のUnitや時刻の値を返す宣言のまま、内部でこれらの操作を実行することはできません。",
  diagnosticsBody: "型エラーが出たら、処理を表すEffectと、実行して得られる値を取り違えていないか確認してください。Effect<R, E, A>のRは必要なサービス、Eは回復可能な失敗、Aは成功時の戻り値です。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "計算を返す関数と、画面へ出力する処理を分けるには",
  summary: "普通の関数で値を計算し、出力はEffectとして返します。まず送料や合計のような計算と、その結果を表示する処理を分けてみます。",
  reading: "lineTotalは単価priceと個数quantityを掛け、Intを返します。lineTotal 20 3は60です。let totalは、その計算結果へ名前を付けます。",
  result: "表示されるのは60です。計算を行うlineTotalは画面へ何も書きません。実行入口のmainが、printlnで結果を一行表示します。",
}

pub fn readerCaption -> String = "金額の計算と表示を分ける"

pub fn readerBridgeOne -> String =
  "TypeScriptでも、計算だけを行う関数を同じように書けます。Seseragiでは、出力やファイル操作などはEffectの型を持つため、普通のIntなどを返す関数との違いが型にも表れます。"

pub fn readerBridgeTwo -> String =
  "pub effect fn mainは、外部へ出力する公開された実行入口です。Effectという値を組み立てることと、その処理を開始することは別です。後半の例では、普通の関数から実行する処理そのものを返す場合も説明します。"

pub fn readerInvalidCaption -> String = "effect fnから普通の整数を返す"

pub fn readerMistake -> String =
  "effect fn total -> Int = 20 * 3はSES-T0101です。Effectを返す関数の本体には、普通のIntだけでは足りません。計算だけならfnに直し、成功する処理を作りたいならeffects.succeedを使います。"

pub fn readerDetailNote -> String =
  "以下の詳しい規則では、宣言だけの例も示します。単独の実行入口はないため、実行する場合は上のmain付きの完全な例を使ってください。"

pub fn readerLegacyReading -> String =
  "lineTotalは二つの整数を掛け、計算したIntを返します。plannedTotalは同じ計算結果をsucceedへ渡し、Task<Int>を返す関数です。TaskはEffectの別名で、この場合は成功値がIntの処理を表します。plannedTotalを呼ぶだけでは、その処理を実行しません。"

pub fn readerLegacyResult -> String =
  "lineTotal 20 3の結果は60です。plannedTotal 20 3は処理を表す値で、実行すると成功値60を返します。通常のIntが必要な場所に、このTask<Int>をそのまま渡すと型が合いません。"
