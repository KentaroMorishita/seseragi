import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.effects.pure-expressions" "/docs/language/effects/pure-expressions/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-pure-expressions",
        localized "Pure calculation returning a cold plan" "処理を実行せず、組み立てたEffectを返す"
      )] [CodeExample (
        "effects-invalid-pure-body",
        localized "Rejected plain effect-function body" "effect fnの本体がEffectを返さない場合"
      )] [
        [InternalLink
      (localized "The Effect type" "Effect型", "/docs/language/effects/effect-type/")],
        [InternalLink
      (localized "Evaluation order" "評価順序", "/docs/language/expressions/evaluation/")],
        [InternalLink (
          localized "Effect runtime boundaries" "Effectを実行する境界",
          "/docs/language/effects/runtime-boundaries/"
        )]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample
          ("failure-reader-pure", localized (en.readerCaption ()) (ja.readerCaption ())),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "60"),
        CodeExample (
          "failure-reader-pure-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Heading (
          "declaration-example",
          localized "Read the declaration-only example" "宣言だけの例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
