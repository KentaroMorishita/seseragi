import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Pure expressions",
  summary: (explanation ()).summary,
  ruleTitle: "Separate calculation from external operations",
  ruleBody: "A pure function calculates its result from the arguments it receives. Use Effect for output, network and file operations, reading the clock, or obtaining randomness. Mutable state access and asynchronous work also appear as Effect values, so a function's return type identifies its external operations.",
  typingBody: "The compiler checks operation types to distinguish pure calculation from external work. A pure function can construct and return Effect<R, E, A>. That value represents work to execute, however, and cannot be used as its eventual result A.",
  evaluationBody: "Ordinary expressions evaluate arguments in order before calling a function. Constructing an Effect also performs the pure calculations needed to build it. The represented output or state update does not start until an execution boundary runs the Effect.",
  invalidTitle: "Returning an Effect is not running it",
  invalidBody: "A function that prints must return an Effect representing the output operation. Reading the clock and updating a Signal follow the same rule. Those operations cannot run inside a function declared to return an ordinary Unit or time value.",
  diagnosticsBody: "If a type error occurs, check whether an Effect describing work has been confused with its eventual result. In Effect<R, E, A>, R names required services, E names recoverable failures, and A is the successful result.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I separate calculating a value from printing it?",
  summary: "Use an ordinary function to calculate a value, and return output work as an Effect. Start by separating a total calculation from displaying its result.",
  reading: "lineTotal multiplies the price and quantity and returns Int. lineTotal 20 3 is 60. let total names that calculated result.",
  result: "The output is 60. lineTotal does not write to the screen; the entry point main uses println to display the result on one line.",
}

pub fn readerCaption -> String = "Separate the calculation from output"

pub fn readerBridgeOne -> String =
  "TypeScript can use a calculation-only function in the same way. In Seseragi, output and file operations have Effect types, so their distinction from functions returning ordinary Int values is also visible in the type."

pub fn readerBridgeTwo -> String =
  "pub effect fn main is the public entry point for outside work, here output. Constructing an Effect value differs from starting its work. The later example also covers an ordinary function returning the work itself."

pub fn readerInvalidCaption -> String = "Return an ordinary integer from effect fn"

pub fn readerMistake -> String =
  "effect fn total -> Int = 20 * 3 reports SES-T0101. An Effect-returning body needs more than a plain Int. Use fn for just the calculation, or effects.succeed to construct work that succeeds with a value."

pub fn readerDetailNote -> String =
  "The detailed rules below also use declaration-only examples. They have no standalone entry point; use the complete program with main above when you want to run an example."

pub fn readerLegacyReading -> String =
  "lineTotal multiplies two integers and returns the calculated Int. plannedTotal passes the same calculation to succeed and returns Task<Int>. Task is an alias for Effect and here represents work whose successful result is an Int. Calling plannedTotal does not execute that work."

pub fn readerLegacyResult -> String =
  "lineTotal 20 3 returns 60. plannedTotal 20 3 returns a description of work; executing it succeeds with 60. Passing that Task<Int> directly where an ordinary Int is required produces a type mismatch."
