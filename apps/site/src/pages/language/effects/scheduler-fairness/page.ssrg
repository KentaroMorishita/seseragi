import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.effects.scheduler-fairness" "/docs/language/effects/scheduler-fairness/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-scheduler-fairness",
        localized "An explicit cooperative checkpoint" "ほかの処理へ実行を譲る地点を置く"
      )] [] [
        [InternalLink (
          localized "Cancellation and resources" "キャンセルとリソースの管理",
          "/docs/language/effects/cancellation-and-resources/"
        )],
        [InternalLink (
          localized "Fiber supervision" "Fiberの所有と監督",
          "/docs/language/effects/fiber-supervision/"
        )],
        [InternalLink (localized "Task" "Task", "/docs/language/effects/task/")]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
