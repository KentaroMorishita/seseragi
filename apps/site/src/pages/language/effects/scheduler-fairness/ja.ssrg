import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "実行順と公平性",
  summary: (explanation ()).summary,
  ruleTitle: "待機やyieldの地点で、別の処理へ実行を渡す",
  ruleBody: "非同期の待機、yieldNow、Queue・Deferred・Semaphoreの待機、sleep、入出力、キャンセルの確認が、実行を切り替えられる地点です。実行可能なFiberは待ち行列へ入り、他の処理もこの地点へ到達し続ける限り、順に実行されます。",
  typingBody: "yieldNowはTask<Unit>です。サービスや回復可能な失敗を追加せず、明示的に実行を譲ります。Fiberに優先度を付ける操作はありません。",
  evaluationBody: "保証されるのは、実行可能な処理がいずれ実行されることです。実時間や実行ステップ数が全処理で等しくなる保証ではありません。長い純粋な計算の途中で自動的に割り込むことはないため、他の処理を長く待たせる場合があります。",
  invalidTitle: "独立した後片付けの全体順序は保証されない",
  invalidBody: "順序が必要なら、使うAPIが何の順序を保証するか確認してください。独立した子の処理の解放が、全体で必ず一定の順番になるとは限りません。",
  diagnosticsBody: "実行の記録では、待機・再開・待ち行列への追加を確認できます。ただし、実行方法の違いでAPIが保証する結果順や、同じscope内の逆順の解放を変えることはできません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "長い計算で、他の処理を待たせてしまうことはあるか",
  summary: "実行の割り当ては協調的に行います。待機や明示的なyieldで他の処理へ機会を渡し、長い純粋な計算を自動で細切れに中断するわけではありません。",
  reading: "例のyieldNowは、cooperativeStepが42で成功する前に、実行を譲る機会を作ります。サービスの要求や回復可能な失敗を追加せず、実行可能な他の処理へ機会を渡します。",
  result: "結果は42のままです。公平性は、全処理の実行時間が均等になることや、決まった時間内の応答を保証しません。長い純粋な計算が続けば、他の処理を待たせる可能性があります。"
}
