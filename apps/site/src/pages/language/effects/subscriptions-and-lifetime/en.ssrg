import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Subscriptions and lifetime",
  summary: (explanation ()).summary,
  ruleTitle: "Choose when observation starts and ends",
  ruleBody: "Executing subscribe registers a function receiving Signal notifications, called an observer. It first receives the current value and then subsequent updates in order. Observers on the same Signal execute in registration order. A new notification does not overlap an observer's processing of the previous one.",
  typingBody: "An observer takes the notified A and returns Effect<R, Never, Unit>. Handle recoverable failures from its operations inside that function. subscribe succeeds with a Subscription representing the registration. unsubscribe returns Task<Unit> to release it, and repeated execution does not release it twice.",
  evaluationBody: "Updating a Signal during notification queues a new update after the current transaction ends. The same notification handler is not entered again while it is still running. A subscription registered in a scope is released after that scope's success, failure, or cancellation. A derived Signal without subscribers also releases unnecessary dependency subscriptions.",
  invalidTitle: "Use switchMap to change dependencies",
  invalidBody: "Signal has no general Monad implementation for choosing subsequent work from a successful value. Use switchMap to change the source Signal dynamically. This operation manages releasing the old subscription and starting the new one as a single update.",
  diagnosticsBody: "A computation defect in a notification function stops that observer. It does not propagate as another observer's recoverable failure. Check where unsubscribe executes or where the subscription is registered in a scope, according to the period during which notifications are needed.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I stop observing a Signal when I no longer need it?",
  summary: "Subscribing registers a function to receive Signal changes. Use unsubscribe when observation is no longer needed. A subscription registered in a resource scope is released when that scope ends.",
  reading: "subscribe first passes source's current value to the function, which writes it into mirror. Setting source to 2 also updates mirror. After unsubscribe releases the subscription, setting source to 3 no longer invokes that function.",
  result: "observeThenRelease returns 2 because mirror receives no updates after release. The notification argument value is source's current value, not the Signal itself. Release the subscription so notifications last only as long as needed."
}
