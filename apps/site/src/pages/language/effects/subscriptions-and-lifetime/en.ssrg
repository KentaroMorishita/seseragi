import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Subscriptions and lifetime",
  summary: (explanation ()).summary,
  ruleTitle: "Choose when observation starts and ends",
  ruleBody: "Executing subscribe registers a function receiving Signal notifications, called an observer. It first receives the current value and then subsequent updates in order. Observers on the same Signal execute in registration order. A new notification does not overlap an observer's processing of the previous one.",
  typingBody: "An observer takes the notified A and returns Effect<R, Never, Unit>. Handle recoverable failures from its operations inside that function. subscribe succeeds with a Subscription representing the registration. unsubscribe returns Task<Unit> to release it, and repeated execution does not release it twice.",
  evaluationBody: "Updating a Signal during notification queues a new update after the current transaction ends. The same notification handler is not entered again while it is still running. A subscription registered in a scope is released after that scope's success, failure, or cancellation. A derived Signal without subscribers also releases unnecessary dependency subscriptions.",
  invalidTitle: "Use switchMap to change dependencies",
  invalidBody: "Signal has no general Monad implementation for choosing subsequent work from a successful value. Use switchMap to change the source Signal dynamically. This operation manages releasing the old subscription and starting the new one as a single update.",
  diagnosticsBody: "A computation defect in a notification function stops that observer. It does not propagate as another observer's recoverable failure. Check where unsubscribe executes or where the subscription is registered in a scope, according to the period during which notifications are needed.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I observe updates and stop when finished?",
  summary: "Pass an observer function to subscribe to receive the current value and later updates. Release the subscription when finished. Registering its release with a scope also handles cleanup after failure or cancellation.",
  reading: "source starts at 1; seen stores the notification record. The function passed to subscribe appends each integer to seen. acquireRelease obtains the subscription and registers unsubscribe as its cleanup in the same scope.",
  result: "The initial 1 and two updates to 2 produce [1, 2, 2]. Leaving the scope unsubscribes. Updating source to 3 afterward does not add to the record, although reading the Signal still gives 3. Unsubscribing does not disable the Signal itself."
}

pub fn readerBridgeOne -> String =
  "In main’s do block, <- receives a success value and _ <- waits without retaining it. refs provides the record cell; arrays.empty<Int> () creates an empty integer array and arrays.append [value] values appends an item. \\value: Int -> ... runs for each notification; its inner \\values: Array<Int> -> ... updates the record. effects.scoped $ do { ... } passes the whole do block as the managed procedure, just like effects.scoped (do { ... }). source := 2 is a procedure updating the mutable Signal. *source is a procedure reading its current value; current <- *source executes it and receives the integer. These operators do not assign to an ordinary variable or read current state as a pure expression."

pub fn readerBridgeTwo -> String =
  "The notification function is called an observer. This observer uses refs.update and has no typed failure. If it performs fallible work such as external output, handle that failure inside the observer, for example with recover. Observers of one Signal run in registration order, without overlapping the next notification with one already running."

pub fn readerMistake -> String =
  "The rejected observer directly uses println and leaves ConsoleError unhandled, which does not meet subscribe’s requirement. Handle the failure before registering it. Repeated unsubscribe calls are safe. To suppress equal-value notifications, explicitly use distinct, which compares value equality."

pub fn readerCaption -> String =
  "Record the initial notification, equal updates, and behavior after release"

pub fn readerInvalidCaption -> String = "A declaration or call to correct"

pub fn readerDetailNote -> String =
  "The following declaration-only fragment is a smaller view of the same topic. It has no entry point or output."

pub fn readerLegacyReading -> String =
  "subscribe first passes source's current value to the function, which writes it into mirror. Setting source to 2 also updates mirror. After unsubscribe releases the subscription, setting source to 3 no longer invokes that function."

pub fn readerLegacyResult -> String =
  "observeThenRelease returns 2 because mirror receives no updates after release. The notification argument value is source's current value, not the Signal itself. Release the subscription so notifications last only as long as needed."
