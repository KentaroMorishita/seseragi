import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Signalの購読と寿命",
  summary: (explanation ()).summary,
  ruleTitle: "変化を受け取る期間を決め、購読を解放する",
  ruleBody: "subscribeを実行すると、通知を受け取る関数をSignalへ登録します。その関数を購読者と呼びます。最初に現在値を通知し、その後の更新も順に渡します。同じSignalの購読者は登録順に実行し、一つの購読者が通知を処理している間は次の通知を重ねません。",
  typingBody: "購読者は、通知された値Aを受け取り、Effect<R, Never, Unit>を返す関数です。回復可能な失敗がある操作は、その関数の中で処理してください。subscribeの成功値は、登録した購読を表すSubscriptionです。unsubscribeは、その購読を解除するTask<Unit>を返し、重ねて実行しても二重に解除しません。",
  evaluationBody: "通知中にSignalを更新した場合は、現在のトランザクションが終わった後に、次の更新として実行します。通知の処理中に、同じ通知処理へ再び入ることはありません。scopeへ登録した購読は、そのscopeの成功・失敗・キャンセルのいずれでも解除します。購読者のいない派生Signalも、不要な依存先の購読を解放します。",
  invalidTitle: "依存先を変えるにはswitchMapを使う",
  invalidBody: "Signalには、成功値から次の処理を選ぶMonadの一般的な実装はありません。依存するSignalを動的に切り替える場合はswitchMapを使います。この操作なら、古いSignalの購読解除と新しいSignalの購読開始を、一つの更新として管理できます。",
  diagnosticsBody: "通知の関数に処理の不具合であるdefectが起きると、その購読者を停止します。他の購読者の回復可能な失敗としては伝えません。購読を続けたい期間に合わせて、unsubscribeを実行する位置やscopeへの登録を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "値が変わった通知を受け取り、使い終わったら止めるには",
  summary: "subscribeへ通知を受け取る関数を渡すと、現在値とその後の更新が届きます。購読は使い終わりに解除します。scopeへ解除を登録すれば、途中で失敗やキャンセルが起きても後片付けできます。",
  reading: "sourceは1で始まるSignal、seenは通知の記録です。subscribeへ渡す関数は、受け取った整数をseenの配列末尾へ追加します。acquireReleaseで購読を取得し、その解除関数unsubscribeを同じscopeへ登録します。",
  result: "購読時の1と、二回の更新による2、2が届くため、記録は[1, 2, 2]です。scopeを出ると解除され、その後sourceを3に変えても記録は増えません。最後の現在値は3で、Signalの更新自体を止めたわけではありません。"
}

pub fn readerBridgeOne -> String =
  "実行入口mainのdoで<-は成功値を受け取り、_ <-は完了だけを待ちます。refsは記録用の保存先、arrays.empty<Int> ()は空の整数配列、arrays.append [value] valuesは末尾への追加です。\\value: Int -> ...は通知ごとに呼ばれる関数で、その中の\\values: Array<Int> -> ...が記録を更新します。 effects.scoped $ do { ... }は、effects.scoped (do { ... })と同じくdo全体を管理範囲の処理として渡します。source := 2は書き込み可能なSignalを更新する処理です。*sourceは現在値を読み取る処理を表し、current <- *sourceで実行して整数を受け取ります。記号だけで通常の変数へ代入したり、現在値を純粋な式として読んだりするわけではありません。"

pub fn readerBridgeTwo -> String =
  "通知を受け取る関数をobserverと呼びます。例のobserverはrefs.updateなので型付きの失敗を持ちません。外部出力など失敗しうる処理を行うなら、observerの中でrecoverなどを使って扱ってください。同じSignalのobserverは登録順に呼ばれ、一つの実行へ次の通知を重ねません。"

pub fn readerMistake -> String =
  "拒否例のprintlnをそのまま使うobserverにはConsoleErrorの失敗が残るため、subscribeの条件を満たしません。失敗を処理してから登録してください。unsubscribeは重ねて呼んでも安全です。同じ値の通知を省くなら、値の等しさを比べるdistinctを明示します。"

pub fn readerCaption -> String = "購読時・同じ値への更新・解除後を記録で比べる"

pub fn readerInvalidCaption -> String = "直すべき宣言・呼び出し"

pub fn readerDetailNote -> String =
  "以下の例は宣言だけを示す補足です。上の実行例で使った考え方を、より小さい断片でも確認できます。実行入口や出力は含みません。"

pub fn readerLegacyReading -> String =
  "subscribeは最初にsourceの現在値を関数へ渡し、その関数がmirrorへ書き込みます。sourceを2にするとmirrorも2になります。unsubscribeで購読を解除した後にsourceを3へ更新しても、その関数は呼ばれません。"

pub fn readerLegacyResult -> String =
  "observeThenReleaseは2を返します。mirrorは解除後の更新を受け取らないためです。通知の引数valueは、sourceの現在値であってSignalそのものではありません。必要な期間だけ通知を受け取るよう、購読を解除してください。"
