      (
        "effects-runtime-boundary",
        localized "A cold program awaiting its host" "host実行を待つcoldなprogram"
      )] [] [
        [InternalLink (
          localized "Programs and entry points" "programとentry point",
          "/docs/language/model/programs/"
        )],
        [InternalLink (
          localized "Environment requirements" "environment requirement",
          "/docs/language/effects/environment-requirements/"
        )],
        [InternalLink
      (localized "Pure expressions" "純粋な式", "/docs/language/effects/pure-expressions/")]
      ]
