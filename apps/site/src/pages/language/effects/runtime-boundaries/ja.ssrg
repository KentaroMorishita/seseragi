import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effectを実行する境界",
  summary: (explanation ()).summary,
  ruleTitle: "処理を組み立て、実行入口で開始する",
  ruleBody: "main、テストの実行入口、定義済みのコールバック用アダプターがEffectを実行する境界です。実行環境は必要なサービスを用意し、返されたEffectを実行して終了結果を受け取ります。",
  typingBody: "実行前に、必要なサービスRがすべて提供できるか検査します。アプリケーション独自のサービスはprovideで指定します。選んだ実行先で使えないサービスは、ビルドや開始時に拒否されます。",
  evaluationBody: "境界は入口の関数が返したEffectを一度実行し、リソースと子の処理の後片付けを待ちます。成功、型付きの失敗、defect、キャンセルは別々の終了理由として扱います。",
  invalidTitle: "helper関数から境界の外へ逃げない",
  invalidBody: "通常の関数から任意にEffectを実行する汎用runEffectはありません。途中で別の実行入口を作るとキャンセルやリソースの管理が分断されるため、Effectのまま組み合わせます。",
  diagnosticsBody: "ビルドや開始時にサービスのエラーが出たら、processかbrowserかという実行先と、そのサービスの対応環境を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "保存したEffectは、どこで実行を始めるか",
  summary: "mainやテスト実行機構など、定められた実行境界が必要なサービスを渡してEffectを開始します。通常の関数で値を作るだけでは始まりません。",
  reading: "programはsucceedで作ったTask<String>を返します。program ()を呼ぶと処理の説明ができ、直接出力するわけではありません。ホストとの連携側がこの関数を呼び、決められた実行規則でTaskを実行します。",
  result: "実行時の成功値は\"ready for the host boundary\"です。普通の補助関数が、Effect<R, E, A>からAを直接取り出してよいわけではありません。Effectを組み合わせ、本来の実行境界へ返します。"
}
