import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effectを実行する境界",
  summary: (explanation ()).summary,
  ruleTitle: "処理を組み立て、実行入口で開始する",
  ruleBody: "Effectを開始する場所は、main、テストの実行入口、定義済みのコールバック用アダプターです。実行機構は必要なサービスを用意して入口の関数を呼び、その関数が返したEffectを実行します。処理の終了後は、結果を実行先へ返します。",
  typingBody: "実行前に、Rに書いたサービスをすべて提供できるか検査します。アプリケーション独自のサービスは、provideで実行するEffectへ指定してください。選んだ実行先で使えないサービスは、ビルドや開始時に拒否されます。",
  evaluationBody: "実行機構は入口の関数が返したEffectを一度実行し、リソースの解放と子の処理の後片付けを待ちます。成功、回復可能な失敗、処理の不具合、キャンセルは、それぞれ異なる終了理由として扱います。",
  invalidTitle: "補助関数ではEffectのまま返す",
  invalidBody: "通常のアプリケーションコードで任意のEffectを実行するrunEffectはありません。補助関数からもEffectを返し、他のEffectと組み合わせてください。途中に別の実行入口を作ると、サービス、キャンセル、リソースを一つの処理として管理できなくなります。",
  diagnosticsBody: "ビルドや開始時にサービスのエラーが出たら、processかbrowserかという実行先と、そのサービスの対応環境を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "保存したEffectは、どこで実行を始めるか",
  summary: "mainやテスト実行機構など、定められた実行入口がEffectを開始します。実行前に必要なサービスを用意し、終了時には後片付けも待ちます。",
  reading: "programはsucceedで作ったTask<String>を返します。program ()を呼ぶと、成功値として文字列を返す処理ができます。この例自体は出力しません。実行環境との連携側が関数を呼び、そのTaskを実行する形を示しています。",
  result: "Taskを実行したときの成功値は\"ready for the host boundary\"です。通常の補助関数からEffect<R, E, A>のAを直接取り出す操作はありません。補助関数でもEffectを組み合わせ、実行入口へ返してください。"
}
