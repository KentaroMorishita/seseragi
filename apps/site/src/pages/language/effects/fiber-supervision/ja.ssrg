import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Fiberの所有と監督",
  summary: (explanation ()).summary,
  ruleTitle: "子の処理を、親の処理範囲の外へ残さない",
  ruleBody: "forkを実行すると、現在のscopeに属する子の処理を開始します。scopeはmainの実行入口か、最も内側のscopedで作った管理範囲です。scopeが終了すると、未完了の子へキャンセルを要求し、子の後片付けが完了するまで待ちます。親の成功・回復可能な失敗・キャンセルのいずれでも同じです。",
  typingBody: "joinは子の完了を待ち、成功値を返します。子の回復可能な失敗は呼び出し側の失敗になり、子がキャンセルされればjoinしている処理もキャンセルされます。終了理由を値として調べるには、awaitでFiberExitを取得してください。interruptは子へキャンセルを要求し、後片付けの完了を待ちます。",
  evaluationBody: "子の回復可能な失敗は、joinやawaitで確認するまでFiberに保存します。親の失敗型へ自動で伝わるわけではありません。joinやawaitで待つ処理をキャンセルした場合は、待機だけを止め、対象の子は止めません。子を止めたい場合はinterruptを使います。重ねて呼んでも停止処理は一度だけです。",
  invalidTitle: "forkした処理を管理外へ放置できない",
  invalidBody: "Fiberのハンドルを捨てても、子の処理をscopeの管理外へ移せません。scopeは終了時に子の後片付けを待ちます。テスト実行機構は、確認していない子の失敗を診断として報告する場合がありますが、親の型で宣言した戻り値は変えません。",
  diagnosticsBody: "子が属するscope、forkの位置、終了状態、失敗を確認したかを診断で調べてください。実行環境によるプロセスの強制終了では、通常のキャンセルと後片付けの完了を保証できません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "親の処理が終わったとき、子の処理はどうなるか",
  summary: "forkは、現在のscopeで子のEffectを開始します。返されるFiberで完了を待ったり停止を要求したりできます。scopeの終了時には、実行機構が未完了の子の停止と後片付けを待ちます。",
  reading: "forkで成功値21を返す子の処理を開始し、Fiberのハンドルを受け取ります。joinはその子が完了するまで待ち、成功値21を返します。親の処理は21を2倍にして、42で成功します。",
  result: "この例はjoinで子の完了を待つので、親の成功値は42です。子が未完了のまま親のscopeが終わる場合は、実行機構が子へキャンセルを要求し、後片付けを待ちます。単に待機を止めることと、子へ停止を要求することは別の操作です。"
}
