import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Fiberの所有と監督",
  summary: (explanation ()).summary,
  ruleTitle: "子の処理を、親の処理範囲の外へ残さない",
  ruleBody: "forkを実行すると、現在のscopeに属する子の処理を開始します。scopeはmainの実行入口か、最も内側のscopedで作った管理範囲です。scopeが終了すると、未完了の子へキャンセルを要求し、子の後片付けが完了するまで待ちます。親の成功・回復可能な失敗・キャンセルのいずれでも同じです。",
  typingBody: "joinは子の完了を待ち、成功値を返します。子の回復可能な失敗は呼び出し側の失敗になり、子がキャンセルされればjoinしている処理もキャンセルされます。終了理由を値として調べるには、awaitでFiberExitを取得してください。interruptは子へキャンセルを要求し、後片付けの完了を待ちます。",
  evaluationBody: "子の回復可能な失敗は、joinやawaitで確認するまでFiberに保存します。親の失敗型へ自動で伝わるわけではありません。joinやawaitで待つ処理をキャンセルした場合は、待機だけを止め、対象の子は止めません。子を止めたい場合はinterruptを使います。重ねて呼んでも停止処理は一度だけです。",
  invalidTitle: "forkした処理を管理外へ放置できない",
  invalidBody: "Fiberのハンドルを捨てても、子の処理をscopeの管理外へ移せません。scopeは終了時に子の後片付けを待ちます。テスト実行機構は、確認していない子の失敗を診断として報告する場合がありますが、親の型で宣言した戻り値は変えません。",
  diagnosticsBody: "子が属するscope、forkの位置、終了状態、失敗を確認したかを診断で調べてください。実行環境によるプロセスの強制終了では、通常のキャンセルと後片付けの完了を保証できません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "子の処理がまだ動いているときに親の管理範囲を抜けたらどうなるか",
  summary: "forkで始めた子の処理は、その場のscopeに属します。scopeを抜けると未完了の子へ停止を要求し、子の後片付けが終わるまで待ちます。",
  reading: "readyとwaitForeverは、一度だけ結果を渡せるDeferredです。子は後片付けを登録してからreadyを完了し、waitForeverを待ちます。親はreadyを待つので、子の準備前にscopeを抜けることはありません。その後42でscopeを終了させます。",
  result: "42、true、21と表示します。trueは、待機していた子がscope終了でキャンセルされ、releasedの更新まで終わったことを示します。最後は別の子をforkし、joinでその成功値21を受け取る例です。"
}

pub fn readerBridgeOne -> String =
  "importのeffectsは実行の操作、deferredは完了を待つ合図、refsは値の保存先を提供します。Neverは型付きの失敗なし、Unitと()は情報を持たない値です。deferred.succeed () readyが合図を完了し、deferred.awaitが待ちます。waitForeverには合図を送らず、scopeによるキャンセルで待機を終えます。 effects.scoped $ do { ... }の$は、後ろのdo全体を一つの引数として渡す記号です。effects.scoped (do { ... })と同じで、このdoの範囲が子とリソースを管理します。"

pub fn readerBridgeTwo -> String =
  "Fiberは開始した子を指す値です。forkは成功値そのものではなくFiberを返し、joinが成功値を待ちます。mainの<-はその成功値を受け取ります。例の解放処理はrefs.set True releasedで記録を書き換えるだけなので、後片付け自身が外部サービスや待機を必要としません。"

pub fn readerMistake -> String =
  "拒否例のforkの結果はFiberなので、Task<Int>として整数を直接返せません。成功値を使うにはjoinします。joinする側のキャンセルは待機だけを解除します。子を明示的に止めるにはinterruptを使い、その操作は後片付けの完了まで待ちます。"

pub fn readerCaption -> String = "子の準備を待ち、scope終了で後片付けを完了する"

pub fn readerInvalidCaption -> String = "直すべき宣言・呼び出し"

pub fn readerDetailNote -> String =
  "以下の例は宣言だけを示す補足です。上の実行例で使った考え方を、より小さい断片でも確認できます。実行入口や出力は含みません。"

pub fn readerLegacyReading -> String =
  "forkで成功値21を返す子の処理を開始し、Fiberのハンドルを受け取ります。joinはその子が完了するまで待ち、成功値21を返します。親の処理は21を2倍にして、42で成功します。"

pub fn readerLegacyResult -> String =
  "この例はjoinで子の完了を待つので、親の成功値は42です。子が未完了のまま親のscopeが終わる場合は、実行機構が子へキャンセルを要求し、後片付けを待ちます。単に待機を止めることと、子へ停止を要求することは別の操作です。"
