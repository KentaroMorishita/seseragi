import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.effects.error-channels" "/docs/language/effects/error-channels/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-error-channels",
        localized "Mapping a dependency error into an application ADT"
      "ライブラリの失敗を、アプリケーションの失敗型に変換する"
      )] [CodeExample (
        "effects-invalid-errors",
        localized "Rejected mismatched failure contract" "宣言した失敗の型と実際の処理が違う場合"
      )] [
        [InternalLink (
          localized "Either and typed results" "Eitherによる成功と失敗",
          "/docs/language/effects/either/"
        )],
        [InternalLink
      (localized "Defects" "想定外の不具合（defect）", "/docs/language/effects/defects/")],
        [InternalLink
      (localized "The Effect type" "Effect型", "/docs/language/effects/effect-type/")]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample
          ("failure-reader-errors", localized (en.readerCaption ()) (ja.readerCaption ())),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "Aki\nfallback: missing"),
        CodeExample (
          "failure-reader-errors-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Heading (
          "declaration-example",
          localized "Read the declaration-only example" "宣言だけの例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
