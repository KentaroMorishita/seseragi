import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effect error channels",
  summary: (explanation ()).summary,
  ruleTitle: "Convert different error types to a common type before composing",
  ruleBody: "One Effect composition uses one recoverable error type. If libraries return different error types, define a type for application errors. It can be an ADT with several cases, with mapError converting each library's error into the appropriate case.",
  typingBody: "Effect<R, Never, A> cannot return a recoverable failure, so it can be used where failures of type E are allowed. Other error types do not change implicitly. recover receives a failure of type E and returns an Effect for recovery. The resulting error type is the error type of that recovery Effect.",
  evaluationBody: "A recoverable failure stops subsequent normal processing. If recover has been composed around the work, the failure value goes to the nearest recovery operation. A defect, meaning a computation defect, and cancellation are separate termination reasons: recover neither catches them nor converts them to E.",
  invalidTitle: "Return anticipated failures in a type the caller can handle",
  invalidBody: "Use E or Either for results the caller should handle, such as connection refusal or invalid input. Representing these as defects prevents recovery through operations such as recover. A computation defect is not a substitute for defining an application error type.",
  diagnosticsBody: "Failure mismatches show each concrete E and the operation that introduced it. Inferred effect functions suggest an ADT plus mapError or recover when multiple non-Never failures meet.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I receive a failure reason and use a fallback result?",
  summary: "An Effect has a failure type that its caller can handle. recover receives that reason and returns replacement work.",
  reading: "readName constructs work that succeeds with Aki for present, or fails with the String missing otherwise. effects.succeed constructs success and effects.fail constructs failure; neither means throwing at its call site.",
  result: "The output is Aki and fallback: missing. Success keeps the name; only failure passes its reason to recover. The replacement string is returned as work using succeed, then its result is printed.",
}

pub fn readerCaption -> String = "Construct a fallback from the reason"

pub fn readerBridgeOne -> String =
  "\\reason -> ... is a small function receiving the reason, similar to TypeScript reason => .... In do, name <- names an operation’s successful value before continuing. _ <- executes an operation without using its returned contents."

pub fn readerBridgeTwo -> String =
  "Unlike a try/catch that can receive arbitrary thrown values, recover handles the Effect’s declared E failure. It does not catch defects or cancellation. readName’s E is String here; it is recovered before combining with println and its ConsoleError."

pub fn readerInvalidCaption -> String = "Compose two different failure types unchanged"

pub fn readerMistake -> String =
  "Sequencing a String-failing operation and an Int-failing operation in do without aligning their failure types reports SES-E0001. The compiler does not invent String | Int. Handle the failure with recover or use the later mapError example to convert both to a common type."

pub fn readerDetailNote -> String =
  "The detailed rules below also use declaration-only examples. They have no standalone entry point; use the complete program with main above when you want to run an example."

pub fn readerLegacyReading -> String =
  "rawLoad constructs an Effect succeeding with 1 when its key is \"present\". Other keys fail with the key String. load uses mapError MissingRecord to convert that String into the MissingRecord case of AppError. The successful Int remains unchanged."

pub fn readerLegacyResult -> String =
  "Executing load \"missing\" fails with MissingRecord \"missing\". recover can receive that AppError and return another computation. Cancellation and defects are not AppError values and are not caught by this recovery operation."
