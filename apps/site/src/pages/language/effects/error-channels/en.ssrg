import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effect error channels",
  summary: (explanation ()).summary,
  ruleTitle: "Application failures are designed, not auto-unioned",
  ruleBody: "Effects in one composition use one recoverable error type. mapError converts dependency errors into an application ADT; the compiler never synthesizes an anonymous union merely because two operations can fail differently.",
  typingBody: "Effect<R, Never, A> may widen to Effect<R, E, A> because it cannot produce a recoverable failure. No other failure coercion exists. recover handles E only and must return an Effect with the replacement error type.",
  evaluationBody: "A typed failure stops the current sequential continuation and is passed to the nearest explicit recovery operation. It is distinct from a defect and cancellation, neither of which recover catches or converts to E.",
  invalidTitle: "Expected external failure is not a defect",
  invalidBody: "Network refusal, invalid input, and other anticipated outcomes belong in E or an ordinary Either. Do not hide them behind a runtime defect simply to avoid designing an application error type.",
  diagnosticsBody: "Failure mismatches show each concrete E and the operation that introduced it. Inferred effect functions suggest an ADT plus mapError or recover when multiple non-Never failures meet.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I turn library errors into application errors?",
  summary: "An Effect's E names its recoverable error values. Convert errors explicitly when operations use different error types.",
  reading: "rawLoad succeeds with 1 for \"present\" and otherwise fails with the key String. load uses mapError MissingRecord to wrap that String in the application's AppError type. The successful Int remains unchanged.",
  result: "Executing load \"missing\" fails with MissingRecord \"missing\". A recovery operation can handle that declared failure. It does not catch cancellation or defects, which are different termination paths."
}
