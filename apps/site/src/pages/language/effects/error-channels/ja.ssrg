import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effectの回復可能な失敗",
  summary: (explanation ()).summary,
  ruleTitle: "異なる失敗型は共通の型へ変換して組み合わせる",
  ruleBody: "一つのEffectの合成には、一つの回復可能な失敗型を使います。複数のライブラリが別々の失敗型を返す場合は、アプリケーションの失敗を表す型を用意してください。複数のケースを持つADTとして定義し、mapErrorで各ライブラリの失敗を変換できます。",
  typingBody: "Effect<R, Never, A>は回復可能な失敗を返さないので、Eの失敗が許される場所でも使えます。それ以外の失敗型は、暗黙に変更されません。recoverはEの失敗を受け取り、回復のためのEffectを返す操作です。回復後の失敗型は、そのEffectの失敗型になります。",
  evaluationBody: "回復可能な失敗が起きると、後続の通常の処理を止めます。recoverを組み合わせていれば、最も近い回復処理へ失敗の値を渡します。処理の不具合であるdefectとキャンセルは別の終了理由なので、recoverは捕捉せず、Eの値にも変換しません。",
  invalidTitle: "想定する失敗は呼び出し側が扱える型で返す",
  invalidBody: "接続拒否や不正な入力など、呼び出し側で処理する結果にはEやEitherを使ってください。これらをdefectにすると、recoverなどで回復できなくなります。アプリケーションの失敗型を省くために、処理の不具合へ置き換えることはできません。",
  diagnosticsBody: "失敗型が合わない場合は、各操作が返すEffectのEを確認してください。異なる失敗型を組み合わせたい場合は、共通のADTを用意し、mapErrorで変換するか、recoverで回復処理を定義します。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "ライブラリの失敗を、アプリケーションの失敗にまとめるには",
  summary: "EffectのEは、呼び出し側が回復処理で扱える失敗の型です。異なる失敗型を返す処理をつなぐには、mapErrorなどで共通の型へ変換します。",
  reading: "rawLoadは、キーが\"present\"なら成功値1を返すEffectを作ります。他のキーでは、そのStringで失敗します。loadはmapError MissingRecordを使い、失敗のStringをAppErrorのケースMissingRecordへ変換します。成功値Intは変えません。",
  result: "load \"missing\"を実行すると、MissingRecord \"missing\"で失敗します。recoverを使えば、このAppErrorを受け取って別の処理を返せます。キャンセルやdefectはAppErrorではないので、この回復処理では捕捉しません。"
}
