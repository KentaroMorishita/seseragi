import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "例外と代数的Effect",
  summary: (explanation ()).summary,
  ruleTitle: "失敗をthrowではなく戻り値の型に残す",
  ruleBody: "予測して扱う失敗は、EitherやEffectのEで返します。外部言語の処理が例外を投げる場合は、連携用アダプターが捕捉します。アダプターは、ForeignErrorを持つEitherかEffectへ変換して結果を返します。",
  typingBody: "Seseragiには、例外を投げて捕捉するthrow、catch、tryの構文はありません。処理をperformで要求し、handleで引き受ける代数的Effectの構文もありません。必要なサービス、回復可能な失敗、リソース、キャンセルはEffectで扱います。",
  evaluationBody: "外部アダプターは、生成先の言語で起きた例外を宣言した結果の型へ変換します。安全なアダプターが約束した型に違反する値は、通常の回復可能な失敗にせず、処理の不具合であるdefectとして扱います。",
  invalidTitle: "他の言語の例外構文は使えない",
  invalidBody: "他の言語と同じtryやcatchを書いても、Seseragiでは例外処理として認識しません。今回の例では未定義の名前として報告します。アプリケーションの失敗は戻り値の型で表してください。外部言語の例外の捕捉は、連携用アダプターが担当します。",
  diagnosticsBody: "提供されていない名前や記法では、そのソース位置に名前解決または構文の診断が出ます。外部連携の失敗では、操作名とForeignErrorの内容を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "try/catchを使わず、予想できる失敗を呼び出し側で扱うには",
  summary: "想定して扱う失敗はEffectの失敗型に残し、recoverで対応できます。これは投げた例外を捕まえる構文とは異なり、操作が返す型に成功と失敗の情報があります。",
  reading: "checkedMessageは正の整数ならokという文字列で成功し、それ以外ならmust be positiveというStringの理由で失敗します。explainはrecoverへ失敗時の関数を渡し、理由をerrorで始まる表示用文字列へ変えます。",
  result: "2に対してok: 2、0に対してerror: must be positiveを出力します。失敗を扱い終えたexplainはTask<String>です。recoverが扱うのは宣言したStringの失敗だけで、不具合によるdefectやキャンセルを通常の成功へ変えるものではありません。"
}

pub fn readerBridgeOne -> String =
  "Effect<{}, String, String>の{}は追加サービス不要、最初のStringは失敗理由、二つ目は成功値の型です。succeedとfailがそれぞれの処理を作ります。\\reason: String -> ...は失敗時の関数です。mainの<-は処理を実行し、最後にprintlnで表示します。"

pub fn readerBridgeTwo -> String =
  "TypeScriptでtry/catchを使う場合は、投げられた例外をcatchへ渡します。ここではeffects.failで作る型付きの失敗へrecoverを結び付けています。Seseragiにはtry/catch/throw構文はありません。外部言語の例外を扱う場合は、連携用のアダプターで宣言したEitherやEffectの結果へ変換します。"

pub fn readerMistake -> String =
  "拒否例のtry/catchは提供されていないため、tryとcatchが未定義の名前として拒否されます。予想できる失敗には例のような失敗型とrecoverを使ってください。また、処理要求をperformで発生させhandleで引き受ける、別方式の「代数的Effect」の構文もありません。必要なサービス・リソース・キャンセルは既存のEffectの契約で扱います。"

pub fn readerCaption -> String = "成功と予想した失敗を、それぞれ表示用の値へ変える"

pub fn readerInvalidCaption -> String = "直すべき宣言・呼び出し"

pub fn readerDetailNote -> String =
  "以下の例は宣言だけを示す補足です。上の実行例で使った考え方を、より小さい断片でも確認できます。実行入口や出力は含みません。"

pub fn readerLegacyReading -> String =
  "decodeForeignは、外部連携の結果の形を示す例です。成功ならRight 42、拒否なら理由を持つForeignErrorをLeftで返します。実際の連携処理では、外部言語の例外を境界で捕捉して、このような宣言した型へ変換します。"

pub fn readerLegacyResult -> String =
  "decodeForeign Falseは、Left (ForeignError \"adapter rejected the value\")を返します。この例は外部言語の例外を捕捉する実装ではなく、呼び出し側へ返す結果の形を示しています。呼び出し側は、宣言されたForeignErrorをmatchなどで扱います。"
