import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "例外と代数的Effect",
  summary: (explanation ()).summary,
  ruleTitle: "失敗をthrowではなく戻り値の型に残す",
  ruleBody: "想定して扱う失敗はEitherやEffectのEで返します。外部言語の例外は外部連携のアダプターが捕捉し、ForeignErrorを持つEitherやEffectへ変換します。",
  typingBody: "Seseragiにはthrow・catch・tryや、perform・handleの構文がありません。必要なサービス、回復可能な失敗、リソース、キャンセルは、別々の隠れた仕組みではなくEffectで扱います。",
  evaluationBody: "外部アダプターが生成先の例外を整理してから、Seseragiの処理へ戻します。安全なアダプターが守るべき約束に違反する値は、通常の回復可能な失敗ではなくdefectです。",
  invalidTitle: "他の言語の例外構文は使えない",
  invalidBody: "他の言語のtryやcatchをそのまま書かないでください。アプリケーションの失敗は型付きの値、外部の例外の捕捉は連携する境界に置きます。",
  diagnosticsBody: "未対応の構文では、そのソース位置に構文エラーが出ます。外部連携の失敗では、操作名とForeignErrorの内容を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "通常のコードでtryやcatchの代わりに何を使うか",
  summary: "予測して扱う失敗は、EitherかEffectのEで表します。Seseragiにはthrow/catchや、perform/handleという構文はありません。",
  reading: "decodeForeignは、外部連携の結果の形を示す例です。成功ならRight 42、拒否なら理由を持つForeignErrorをLeftで返します。実際の連携処理では、外部言語の例外を境界で捕捉して、このような宣言した型へ変換します。",
  result: "FalseではLeft (ForeignError \"adapter rejected the value\")を返します。この例は結果の扱い方を示し、隠れたtry/catchの実装ではありません。呼び出し側は、外部の任意の例外ではなく、宣言された結果を扱います。"
}
