import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.effects.exceptions-algebraic" "/docs/language/effects/exceptions-and-algebraic-effects/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-foreign-failure",
        localized "A foreign failure made explicit" "外部の処理が失敗する可能性を型に残す"
      )] [CodeExample
      ("effects-invalid-throw", localized "Rejected throw syntax" "throw文は使えない")] [
        [InternalLink (localized "Effect error channels" "Effectの回復可能な失敗", "/docs/language/effects/error-channels/"), Words (localized ": Handle a declared failure with recover" "：宣言した失敗をrecoverで扱う")],
        [InternalLink (localized "Defects" "想定外の不具合（defect）", "/docs/language/effects/defects/"), Words (localized ": Separate expected failure from a runtime defect" "：想定した失敗と実行時の不具合を区別する")],
        [InternalLink (localized "Backend-independent semantics" "生成先に依存しない意味", "/docs/language/model/backend-independent-semantics/"), Words (localized ": Keep behavior consistent across execution targets" "：実行先が違っても同じ動作を保つ規則を読む")]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample (
          "lifecycle-reader-exceptions",
          localized (en.readerCaption ()) (ja.readerCaption ())
        ),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "ok: 2\nerror: must be positive"),
        CodeExample (
          "lifecycle-reader-exceptions-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Heading (
          "declaration-example",
          localized "Read the declaration-only example" "宣言だけの例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
