import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Exceptions and algebraic effects",
  summary: (explanation ()).summary,
  ruleTitle: "Represent failure in the return type",
  ruleBody: "Return anticipated failures through Either or Effect's E. When foreign-language code throws, an interop adapter catches the exception. The adapter converts it into an Either or Effect containing ForeignError and returns that declared result.",
  typingBody: "Seseragi has no throw, catch, or try syntax for throwing and catching exceptions. Nor does it have algebraic-effect syntax for requesting operations with perform and handling them with handle. Required services, recoverable failures, resources, and cancellation are handled through Effect.",
  evaluationBody: "A foreign adapter converts target-language exceptions to its declared result type. A value violating a safe adapter's promised type is treated as a computation defect, not as a normal recoverable failure.",
  invalidTitle: "Other languages' exception syntax is not supported",
  invalidBody: "Writing another language's try or catch produces a syntax error in Seseragi. Express application failures in the return type. The interop adapter is responsible for catching foreign-language exceptions.",
  diagnosticsBody: "The parser reports unsupported exception or handler forms at their source range. Interop diagnostics retain the adapter operation and normalized ForeignError without exposing an arbitrary host stack as typed program data.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "What replaces try and catch in ordinary Seseragi code?",
  summary: "Use Either or Effect's E for anticipated failures. An interop adapter catches foreign-language exceptions and converts them into its declared error type.",
  reading: "decodeForeign models an adapter result: success becomes Right 42 and rejection becomes Left with a ForeignError explanation. A real adapter must catch foreign-language exceptions at its boundary and return the declared result type.",
  result: "decodeForeign False returns Left (ForeignError \"adapter rejected the value\"). The example shows the result shape returned to callers, not an implementation catching a foreign exception. Callers handle the declared ForeignError with match or another result operation."
}
