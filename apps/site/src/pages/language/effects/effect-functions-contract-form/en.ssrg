import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effect functions with an explicit contract",
  summary: (explanation ()).summary,
  ruleTitle: "Declare the result, required services, and failures",
  ruleBody: "effect fn parameters -> A with R fails E = body is notation for a function returning Effect<R, E, A>. A is the successful result, R names required services, and E is the recoverable error type. Callers can read the declaration to see which services to supply and failures to handle.",
  typingBody: "Omitting with specifies the service-free requirement {}. Omitting fails specifies Never, meaning no recoverable failure. The body's Effect must match the declaration; ordinary values are not converted implicitly into Effects. Only a computation whose success type is Never, and which cannot return successfully, may be used where another success type is required.",
  evaluationBody: "This form explicitly states the returned Effect type. Calling the function constructs an Effect, which is returned to an execution boundary or composed with another Effect. Explicit notation does not start external operations when the function is called.",
  invalidTitle: "Omitted with and fails clauses still specify types",
  invalidBody: "Writing -> Unit without with or fails fixes Effect<{}, Never, Unit>. The compiler does not inspect the body and silently add Console, Clock, or an error type to that explicit API.",
  diagnosticsBody: "Compare the declared type with the type returned by the body's operations. Check required services, recoverable errors, and successful results separately. Omitting with or fails does not ask the compiler to fill them from the body.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I state an output function’s requirements and failure type?",
  summary: "An effect fn declaration can state its success type, required capability and failure type. A small output example shows what callers must prepare.",
  reading: "announce takes a String. -> Unit means successful completion without a contents value; with Console requires terminal output; fails ConsoleError names the possible output-failure type.",
  result: "Running main prints one line, ready. Calling announce constructs work; the runner starts the work returned by main. Merely writing the declaration does not print.",
}

pub fn readerCaption -> String = "State success, requirements and failure"

pub fn readerBridgeOne -> String =
  "The normalized return type is Effect<{ console: Console }, ConsoleError, Unit>, ordered as requirements, failure and success. The declaration spells those parts as -> for success, with for requirements and fails for failure."

pub fn readerBridgeTwo -> String =
  "Omitting with in the explicit form means the empty requirement {}. Omitting fails means Never, with no recoverable failure. A TypeScript try/catch does not itself impose this kind of failure-type contract; here the compiler checks the declared type against the body’s operations."

pub fn readerInvalidCaption -> String = "Omit the required Console"

pub fn readerMistake -> String =
  "The rejected declaration returns println without declaring its Console requirement, producing SES-E0001. Add with Console. To infer everything from the body, use the compact inferred form rather than partially omitting its contract."

pub fn readerDetailNote -> String =
  "The detailed rules below also use declaration-only examples. They have no standalone entry point; use the complete program with main above when you want to run an example."

pub fn readerLegacyReading -> String =
  "announce takes message: String. -> Unit says that success has no useful payload; with Console requires output support, and fails ConsoleError permits an output error. println message is itself the Effect returned by the body."

pub fn readerLegacyResult -> String =
  "Calling announce constructs an Effect that prints the message. Output happens when that Effect executes. Omitting with declares no required services; omitting fails declares no recoverable failures. Write those clauses to match the operations in the body."
