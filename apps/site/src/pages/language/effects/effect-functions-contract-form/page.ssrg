import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  CodeExample,
  InternalLink,
  PageDefinition,
  Paragraph,
  Words,
  Terminal,
  Heading
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn detailed -> PageDefinition =
  referencePage "language.effects.effect-functions-contract-form" "/docs/language/effects/effect-functions-contract-form/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-contract-form",
        localized "An explicit Console contract" "必要なConsoleと失敗の型を明示する"
      )] [CodeExample (
        "effects-invalid-contract",
        localized "Rejected missing environment and failure" "必要なサービスや失敗の型を省略した場合"
      )] [
        [InternalLink (
          localized "Effect functions with an inferred contract" "Effect関数の型を推論する形式",
          "/docs/language/effects/effect-functions-inferred-form/"
        )],
        [InternalLink (
          localized "Effect environment requirements" "Effectが必要とするサービス",
          "/docs/language/effects/environment-requirements/"
        )],
        [InternalLink (
          localized "Function types and currying" "関数型とカリー化",
          "/docs/language/types/function-types-and-currying/"
        )]
      ]

fn content -> PageDefinition = {
  let page = detailed ()
  PageDefinition {
    ...page,
    blocks: arrays.concat [
      [
        CodeExample (
          "failure-reader-contract",
          localized (en.readerCaption ()) (ja.readerCaption ())
        ),
        Paragraph ([Words (localized (en.readerBridgeOne ()) (ja.readerBridgeOne ()))]),
        Paragraph ([Words (localized (en.readerBridgeTwo ()) (ja.readerBridgeTwo ()))]),
        Terminal (localized "Output" "実行結果", "ready"),
        CodeExample (
          "failure-reader-contract-invalid",
          localized (en.readerInvalidCaption ()) (ja.readerInvalidCaption ())
        ),
        Paragraph ([Words (localized (en.readerMistake ()) (ja.readerMistake ()))]),
        Heading (
          "declaration-example",
          localized "Read the declaration-only example" "宣言だけの例を読む"
        ),
        Paragraph
          ([Words (localized (en.readerDetailNote ()) (ja.readerDetailNote ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyReading ()) (ja.readerLegacyReading ()))]),
        Paragraph
          ([Words (localized (en.readerLegacyResult ()) (ja.readerLegacyResult ()))])
      ],
      page.blocks
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
