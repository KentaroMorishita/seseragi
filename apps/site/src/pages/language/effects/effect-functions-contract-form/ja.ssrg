import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effect関数の型を明示する形式",
  summary: (explanation ()).summary,
  ruleTitle: "成功値・必要なサービス・失敗を宣言に書く",
  ruleBody: "effect fn 引数 -> A with R fails E = 本体は、Effect<R, E, A>を返す関数の書き方です。Aは成功時の戻り値、Rは必要なサービス、Eは回復可能な失敗の型です。呼び出し側は、この宣言から用意するサービスと処理する失敗を確認できます。",
  typingBody: "withを省略すると、サービスが不要な{}を指定したことになります。failsの省略は、回復可能な失敗がないNeverです。本体が返すEffectは宣言した型と合う必要があり、通常の値を暗黙にEffectへ変換することはありません。成功値がNeverで、成功して戻らない処理だけは、別の成功型が要求される場所にも使えます。",
  evaluationBody: "この形式は、関数が返すEffectの型を明示するための書き方です。関数を呼ぶとEffectを作り、実行入口へ返すか、別のEffectと組み合わせて実行します。型を明示しても、その呼び出し時点で外部への操作は始まりません。",
  invalidTitle: "省略したwithやfailsにも意味がある",
  invalidBody: "-> Unitだけを指定すると、Effect<{}, Never, Unit>になります。本体にConsoleやClockが必要でも、コンパイラが宣言へ勝手に追加することはありません。必要なwithやfailsを書いてください。",
  diagnosticsBody: "宣言した型と、本体の操作が返す型を見比べてください。必要なサービス、回復可能な失敗、成功値のうち、どこが違うかを調べます。withやfailsを省略しても、本体から自動で補われません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "出力する関数が必要な機能と失敗を、宣言で示すには",
  summary: "effect fnの宣言に成功時の型、必要な機能、失敗の型を書けます。呼び出す側が準備するものを、出力の小さい例で確認します。",
  reading: "announceはStringを受け取ります。-> Unitは返す中身のない正常な完了、with Consoleは端末出力の機能、fails ConsoleErrorは出力が失敗した場合の型です。",
  result: "mainを実行するとreadyが一行表示されます。announceを呼ぶと処理の値ができ、実行機構がmainから返った処理を開始します。宣言を書いた時点で出力するわけではありません。",
}

pub fn readerCaption -> String = "成功・必要な機能・失敗を明示する"

pub fn readerBridgeOne -> String =
  "正規の戻り値はEffect<{ console: Console }, ConsoleError, Unit>です。型の順序は必要な機能、失敗、成功です。表面の宣言は読みやすいよう、成功を->の後、機能をwith、失敗をfailsに分けます。"

pub fn readerBridgeTwo -> String =
  "明示形式でwithを省くと、要求は空の{}になります。failsを省くと回復可能な失敗がないNeverです。TypeScriptのtry/catch自体には、このように失敗の型を関数の型として宣言する仕組みはありません。ここでは本体の操作と宣言の型が合うかを検査します。"

pub fn readerInvalidCaption -> String = "出力に必要なConsoleを省く"

pub fn readerMistake -> String =
  "拒否される宣言はConsoleを要求せずにprintlnを返すため、SES-E0001です。with Consoleを追加します。必要な情報をすべて本体から決めたいなら、途中まで省かず、別の記事の短い推論形式を使います。"

pub fn readerDetailNote -> String =
  "以下の詳しい規則では、宣言だけの例も示します。単独の実行入口はないため、実行する場合は上のmain付きの完全な例を使ってください。"

pub fn readerLegacyReading -> String =
  "announceはStringのmessageを受け取ります。-> Unitは成功時に内容を返さないこと、with Consoleは出力サービスが必要なこと、fails ConsoleErrorは出力が失敗する可能性を表します。本体のprintln messageもEffectです。"

pub fn readerLegacyResult -> String =
  "announceを呼ぶと、メッセージを出力するEffectを作ります。そのEffectを実行したときに出力します。withを省略すればサービス不要、failsを省略すれば回復可能な失敗なしという宣言になるため、本体で使う型に合わせて書いてください。"
