import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effectの逐次・並列実行",
  summary: (explanation ()).summary,
  ruleTitle: "並列にする操作を選ばなければ、順番に実行する",
  ruleBody: "flatMap、>>=、doでつないだEffectは、先の処理が成功してから次を開始します。先の成功値を、次の処理で使うこともできます。独立したEffectを並べるだけでは同時実行になりません。並列実行にはparallelなどの操作を使います。",
  typingBody: "複数のEffectを組み合わせるには、必要なサービスと回復可能な失敗の型が合う必要があります。並列実行の操作も、組み合わせられるEffectの集まりを受け取ります。結果の並び方は、使うAPIで定められた順序です。",
  evaluationBody: "逐次処理が失敗すると、後続の処理は始まりません。並列処理で選ぶ失敗、他の処理へのキャンセル要求、後片付けの方法は、使用したAPIの規則に従います。処理が完了する順序だけから、戻り値の順序を決めることはできません。",
  invalidTitle: "コンパイラはEffectを自動で並列にしない",
  invalidBody: "外部への出力順、リソースの寿命、どの失敗を返すかは観測できる動作です。そのためコンパイラが勝手にEffectを並列に変更することはありません。",
  diagnosticsBody: "必要なサービスと失敗型の不一致を、実行前の型エラーとして確認します。並列処理の実行時の診断では、選んだ操作と入力の位置を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "前の結果を待つ処理と、並行して進める処理をどう書き分けるか",
  summary: "doで並べた処理は順番に実行します。互いの成功値を待つ必要がない処理を一緒に進める場合は、effects.parallelへ配列で明示します。",
  reading: "jobは整数を返すTaskを作ります。途中のyieldNow ()は、実行をほかの処理へ譲れる地点です。mainのfirst <- job 10が終わってからsecond <- job 20へ進みます。togetherでは二つのjobをparallelへ渡しています。",
  result: "逐次側も並列側も[10, 20]を返します。parallelの結果配列は完了した順ではなく、渡した配列の順です。空のnoJobsは[]を返します。この出力だけから、二つの処理の細かな実行順や速度は判断できません。"
}

pub fn readerBridgeOne -> String =
  "fn job value: Int -> Task<Int>は、整数valueから整数で成功する処理を作る関数です。succeedは成功値を返す処理、()はUnitの値です。pub effect fn mainのdoでは、<-で成功値に名前を付けます。showが配列を表示用の文字列にし、printlnが出力します。"

pub fn readerBridgeTwo -> String =
  "Array<Task<Int>>は同じ成功値型を持つ処理の配列です。処理を配列に入れただけでは実行されず、parallelを実行したときに開始します。最初に観測した失敗では未開始の処理を始めず、実行中の兄弟へキャンセルを要求し、後片付けを待ちます。同じ実行ターンの複数失敗では入力位置が小さいものを選びます。"

pub fn readerMistake -> String =
  "拒否例の配列は整数で成功する処理と文字列で成功する処理を混ぜているため型が合いません。同じ結果型へ揃えてください。また、後続処理が前の結果を必要とする場合はdoを使います。parallelはCPUコア数や外部操作の順序を保証するものではありません。"

pub fn readerCaption -> String = "逐次・並列・空の処理配列を比べる"

pub fn readerInvalidCaption -> String = "直すべき宣言・呼び出し"

pub fn readerDetailNote -> String =
  "以下の例は宣言だけを示す補足です。上の実行例で使った考え方を、より小さい断片でも確認できます。実行入口や出力は含みません。"

pub fn readerLegacyReading -> String =
  "twiceは、入力を2倍にした値で成功する処理を作ります。sequentialはtwice 2の後にtwice 3を実行して結果を足します。parallelは二つの処理をeffects.parallelへ渡します。"

pub fn readerLegacyResult -> String =
  "sequentialは成功値10を返します。parallelは、合計ではなく入力順の配列[4, 6]を返します。並列実行では処理の開始時点や失敗時のキャンセルも異なるため、doと同じ動作の別の書き方ではありません。"
