import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effectの逐次・並列実行",
  summary: (explanation ()).summary,
  ruleTitle: "並列にする操作を選ばなければ、順番に実行する",
  ruleBody: "flatMap、>>=、doでつないだEffectは、先の処理が成功してから次を開始します。先の成功値を、次の処理で使うこともできます。独立したEffectを並べるだけでは同時実行になりません。並列実行にはparallelなどの操作を使います。",
  typingBody: "複数のEffectを組み合わせるには、必要なサービスと回復可能な失敗の型が合う必要があります。並列実行の操作も、組み合わせられるEffectの集まりを受け取ります。結果の並び方は、使うAPIで定められた順序です。",
  evaluationBody: "逐次処理が失敗すると、後続の処理は始まりません。並列処理で選ぶ失敗、他の処理へのキャンセル要求、後片付けの方法は、使用したAPIの規則に従います。処理が完了する順序だけから、戻り値の順序を決めることはできません。",
  invalidTitle: "コンパイラはEffectを自動で並列にしない",
  invalidBody: "外部への出力順、リソースの寿命、どの失敗を返すかは観測できる動作です。そのためコンパイラが勝手にEffectを並列に変更することはありません。",
  diagnosticsBody: "必要なサービスと失敗型の不一致を、実行前の型エラーとして確認します。並列処理の実行時の診断では、選んだ操作と入力の位置を確認してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "独立して見える処理は、自動で同時実行されるか",
  summary: "EffectをflatMapやdoでつなぐと、処理を順に実行します。独立した処理を同時に進めたい場合は、並列実行用の操作を明示的に使います。",
  reading: "twiceは、入力を2倍にした値で成功する処理を作ります。sequentialはtwice 2の後にtwice 3を実行して結果を足します。parallelは二つの処理をeffects.parallelへ渡します。",
  result: "sequentialは成功値10を返します。parallelは、合計ではなく入力順の配列[4, 6]を返します。並列実行では処理の開始時点や失敗時のキャンセルも異なるため、doと同じ動作の別の書き方ではありません。"
}
