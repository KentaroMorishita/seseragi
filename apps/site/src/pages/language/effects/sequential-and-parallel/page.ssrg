import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.effects.sequential-and-parallel" "/docs/language/effects/sequential-and-parallel/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-execution-order",
        localized "Explicit sequential and parallel composition" "明示的な逐次・並列合成"
      )] [] [
        [InternalLink
      (localized "Do notation" "do記法", "/docs/language/traits/do-notation/")],
        [InternalLink (
          localized "Effectful for" "Effectを実行するfor",
          "/docs/language/effects/effectful-for/"
        )],
        [InternalLink
      (localized "Visible costs" "コストを見えるようにする", "/docs/language/model/visible-costs/")]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
