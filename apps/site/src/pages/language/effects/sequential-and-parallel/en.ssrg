import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Sequential and parallel Effects",
  summary: (explanation ()).summary,
  ruleTitle: "Choose an explicit operation for parallel execution",
  ruleBody: "Effects linked with flatMap, >>=, or do start the next operation only after the previous one succeeds. The next operation can use that successful value. Merely placing independent Effects together does not execute them concurrently. Use an operation such as parallel for parallel execution.",
  typingBody: "Combining Effects requires compatible services and recoverable error types. Parallel operations also take a collection of compatible Effects. Their result order is specified by the selected API.",
  evaluationBody: "A sequential failure prevents later work from starting. In parallel execution, failure selection, cancellation of other work, and cleanup follow the selected API's rules. Completion timing alone does not determine the order of returned results.",
  invalidTitle: "The compiler cannot auto-parallelize Effects",
  invalidBody: "External order, resource ownership, failure choice, and cancellation are observable. Even apparently independent Effects remain sequential until the program selects an explicit parallel operation.",
  diagnosticsBody: "Type errors identify incompatible requirements, failures, or successes before scheduling. Runtime diagnostics retain the selected operation and input position for concurrent failures.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I distinguish waiting in sequence from progressing concurrently?",
  summary: "Procedures listed in do run in sequence. To progress together when neither needs the other’s success value, explicitly pass an array to effects.parallel.",
  reading: "job creates a Task returning an integer. yieldNow () provides a point where other work can run. main finishes first <- job 10 before beginning second <- job 20. together instead passes both jobs to parallel.",
  result: "Both versions produce [10, 20]. parallel keeps input order in its result array, not completion order. The empty noJobs produces []. These printed values alone establish neither detailed scheduling order nor speed."
}

pub fn readerBridgeOne -> String =
  "fn job value: Int -> Task<Int> creates an integer-success procedure from an integer value. succeed creates a successful procedure, and () is Unit. In pub effect fn main, <- names success values. show creates display text and println outputs it."

pub fn readerBridgeTwo -> String =
  "Array<Task<Int>> is an array of procedures sharing a success type. Putting them in an array does not run them; executing parallel starts them. On the first observed failure it starts no remaining inputs, requests cancellation of running siblings and waits for cleanup. Failures in the same scheduler turn choose the smaller input index."

pub fn readerMistake -> String =
  "The rejected array mixes integer-success and string-success procedures. Give them a common result type. Use do when the next operation needs the previous result. parallel does not guarantee a CPU core count or the order of external actions."

pub fn readerCaption -> String =
  "Compare sequential, parallel, and empty collections of procedures"

pub fn readerInvalidCaption -> String = "A declaration or call to correct"

pub fn readerDetailNote -> String =
  "The following declaration-only fragment is a smaller view of the same topic. It has no entry point or output."

pub fn readerLegacyReading -> String =
  "twice describes a computation returning twice its input. sequential obtains the result of twice 2 before obtaining twice 3 and then adds them. parallel explicitly passes both computations to effects.parallel."

pub fn readerLegacyResult -> String =
  "sequential succeeds with 10. parallel returns [4, 6] in input order rather than their sum. Parallel execution changes when work starts and how other work is cancelled on failure; it is not another notation for do's behavior."
