import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effectを実行するfor",
  summary: (explanation ()).summary,
  ruleTitle: "各要素の処理が終わってから、次の要素へ進む",
  ruleBody: "for パターン <- 値の集合 { 本体 }は、各要素についてEffectを順に実行する式です。本体も式全体も、成功値がUnitのEffectになります。空の集合なら、本体を一度も実行せず成功します。",
  typingBody: "値の集合には、要素を順に取り出すIterableの実装が必要です。パターンは、どの要素にも必ず当てはまるものにしてください。本体の各分岐は、同じサービスと失敗型を持つEffectを返します。その成功値の型はUnitである必要があります。",
  evaluationBody: "Iterableが定める順序で要素を取り出します。一つの本体の処理が完了してから次の要素へ進み、最初の回復可能な失敗で停止します。このforは並列実行せず、breakやcontinueという構文もありません。",
  invalidTitle: "早期終了には専用の操作を使う",
  invalidBody: "要素を処理せず次へ進めたい場合は、分岐でsucceed ()を返してください。途中で正常に終了するには、forEachUntilへ渡す関数からContinueかBreakを返します。並列処理にはforEachParallelを使います。これらは戻り値による制御で、別の関数やFiberからの非局所的なジャンプではありません。",
  diagnosticsBody: "入力がIterableか、パターンが必ず当てはまるか、本体がEffectを返すかを確認します。通常の値やUnit以外の成功値を返す本体は使えません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "一覧の各項目に、出力などの処理を順番に行うには",
  summary: "Effectを実行するforは、入力の先頭から一件ずつ処理します。前の項目が終わってから次へ進み、空の一覧なら何もせず終了します。",
  reading: "announceは文字列の配列namesを受け取る処理です。for name <- namesで一件ずつnameという名前を付けます。空文字列ならsucceed ()で何もせず成功し、それ以外ならprintlnで名前を出力します。",
  result: "最初の呼び出しはAkiとMioをこの順に出力します。二つ目の空配列では出力せず、mainの最後でdoneを出します。空文字列の項目だけを飛ばしても、後ろのMioは処理します。"
}

pub fn readerBridgeOne -> String =
  "importでstd/effectをeffectsとして読み込みます。Array<String>は文字列の配列、effect fnは実行する処理を作る関数です。pub effect fn mainが実行入口で、doの_ <-はannounceの完了を待って次へ進むという意味です。"

pub fn readerBridgeTwo -> String =
  "forの本体は、意味のある成功値を持たないUnitを返すEffectにします。()がUnitの値です。値を集める配列の内包表記とは用途が異なり、ここでは各項目への出力が目的です。処理中に型付きの失敗が起きたら、その時点で後続の項目を止めます。"

pub fn readerMistake -> String =
  "拒否例のvalue + 1は整数を計算するだけなので、forの本体が必要とするEffectではありません。値を並べたいなら内包表記、出力したいならprintlnを使ってください。breakやcontinueはなく、全体を途中で正常終了する場合はforEachUntilでContinue/Breakという結果を返します。"

pub fn readerCaption -> String = "空の項目と空の配列を含め、名前を順番に出力する"

pub fn readerInvalidCaption -> String = "直すべき宣言・呼び出し"

pub fn readerDetailNote -> String =
  "以下の例は宣言だけを示す補足です。上の実行例で使った考え方を、より小さい断片でも確認できます。実行入口や出力は含みません。"

pub fn readerLegacyReading -> String =
  "announceAllはArray<String>を受け取ります。for message <- messagesで各要素をmessageとして使い、その回のprintln messageを組み立てます。内包表記とは違い、結果を配列に集める処理ではありません。"

pub fn readerLegacyResult -> String =
  "announceAll [\"Aki\", \"Mio\"]を実行すると、Aki、Mioの順に一行ずつ出力します。一回の処理が失敗すれば、その後の要素は実行しません。空の入力なら何も出力せず完了します。"
