import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.effects.effect-type" "/docs/language/effects/effect-type/" (en.copy ()) (ja.copy ()) [CodeExample
      (
        "effects-cold-value",
        localized "A cold Effect rebuilt on each execution" "実行するたびに処理を始めるEffect"
      )] [CodeExample (
        "effects-invalid-pure-body",
        localized "Rejected implicit lifting" "通常の値をEffectとしてそのまま返すことはできない"
      )] [
        [InternalLink
      (localized "Pure expressions" "純粋な式", "/docs/language/effects/pure-expressions/")],
        [InternalLink (
          localized "Effect functions with an explicit contract" "Effect関数の型を明示する形式",
          "/docs/language/effects/effect-functions-contract-form/"
        )],
        [InternalLink
      (localized "Do notation" "do記法", "/docs/language/traits/do-notation/")]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
