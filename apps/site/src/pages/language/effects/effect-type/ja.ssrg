import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Effect型",
  summary: (explanation ()).summary,
  ruleTitle: "構築と実行は別の段階",
  ruleBody: "Effect<R, E, A>は、実行する処理を表す値です。Rは必要なサービス、Eは回復可能な失敗、Aは成功時の戻り値の型を表します。Effectを作っただけでは入出力や状態の更新を始めません。まず処理を組み立て、実行入口へ返します。",
  typingBody: "mapは、成功した値に関数を適用してAを変える操作です。flatMapは、成功値を受け取って次に実行するEffectを選びます。これらはそれぞれFunctor、Monadというtraitの操作でもあります。Applicativeの操作は、複数の処理を定められた順序で組み合わせます。合成した処理では必要なサービスもまとめて要求され、回復可能な失敗は一つの型で表します。",
  evaluationBody: "同じEffectをもう一度実行すると、処理は最初から始まります。この性質をcoldと呼びます。逐次処理は左から右へ進みます。回復可能な失敗、想定外の不具合、キャンセルが起きた場合の停止方法は、使う操作の規則に従います。",
  invalidTitle: "Effectを作っただけでは、処理は開始されない",
  invalidBody: "Effectを保存したり、引数で渡したり、関数から返したりしても、処理は始まりません。実行結果を自動で保存・共有する仕組みでもありません。一度だけ開始した処理を共有する場合は、リソースや並行処理のAPIで、処理を管理する範囲と終了時の操作を決めてください。",
  diagnosticsBody: "型エラーが出たら、Effect<R, E, A>のどの部分が合わないかを調べてください。必要なサービスR、回復可能な失敗E、成功値Aを別々に確認すると、合成できない理由を特定できます。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "出力する処理を変数へ入れたら、その場で表示されるか",
  summary: "Effectは、これから実行する処理を表す値です。変数へ保存することと、実行して結果を得ることを分けて確認します。",
  reading: "announce \"run\"は出力処理を作り、plannedへ保存します。この行では表示しません。mainのdoは処理を順に実行します。_ <-は処理を実行して戻り値を使わない指定で、最後のplannedも実行します。",
  result: "出力はbefore、run、runの順です。保存した時点ではrunが表示されず、同じplannedを二回使うと二回表示されます。これは、すでに開始したPromiseを保存して結果を共有する場合とは異なります。",
}

pub fn readerCaption -> String = "作った処理を二回実行する"

pub fn readerBridgeOne -> String =
  "このplannedの型はEffect<{ console: Console }, ConsoleError, Unit>です。必要な出力機能、起こり得る出力の失敗、返す中身のない正常な完了が順に表れます。一般形では、その三つをR、E、Aと書きます。"

pub fn readerBridgeTwo -> String =
  "TypeScriptで関数を保存し、後で呼ぶ場合が近い手掛かりです。ただしEffectは、必要な機能と失敗の型も含む処理の値です。pubで公開したmainを実行機構が呼び、返った処理を開始します。Effectを普通のIntやStringとして使うことはできません。"

pub fn readerInvalidCaption -> String = "処理の値を、その成功値として使う"

pub fn readerMistake -> String =
  "effects.succeed 42は、実行すると42で成功する処理です。Intと書いたletへ代入するとSES-T0101です。処理の中で値を受け取りたい場合は、doでvalue <- ...のように取り出して後続の処理へ渡します。"

pub fn readerDetailNote -> String =
  "以下の詳しい規則では、宣言だけの例も示します。単独の実行入口はないため、実行する場合は上のmain付きの完全な例を使ってください。"

pub fn readerLegacyReading -> String =
  "greetingは名前を受け取り、Task<String>を返します。Taskはサービスが不要で、回復可能な失敗のないEffectの別名です。deferに渡した関数は実行時に呼ばれます。その中のsucceedは、作った文字列を成功値として返す処理を表します。"

pub fn readerLegacyResult -> String =
  "greeting \"Aki\"を実行すると、成功値\"Hello, Aki\"を返します。greeting \"Aki\"を変数へ保存するだけでは、Stringを取り出せません。mapで成功値を変換した場合も、戻り値は引き続きEffectです。"
