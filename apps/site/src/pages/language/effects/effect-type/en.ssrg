import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "The Effect type",
  summary: (explanation ()).summary,
  ruleTitle: "Construction and execution are separate",
  ruleBody: "Effect<R, E, A> is a value representing work to execute. R names required services, E names recoverable failures, and A is the successful result type. Creating an Effect does not start I/O or state updates. First compose the work, then return it to an execution boundary.",
  typingBody: "map applies a function to a successful value and changes A. flatMap receives that value and chooses the next Effect to execute. They are also operations of the Functor and Monad traits, respectively. Applicative operations combine computations in a specified order. The combined computation requires all compatible services and uses one recoverable error type.",
  evaluationBody: "Executing the same Effect again starts its work from the beginning. This property is called cold execution. Sequential work proceeds from left to right. Stopping on recoverable failure, defect, or cancellation follows the selected operation's rules.",
  invalidTitle: "Creating an Effect does not start its work",
  invalidBody: "Saving, passing, or returning an Effect does not start it. Nor does it automatically store or share the execution result. To share work started once, choose a resource or concurrency API and define the scope that manages it and the operations used at its end.",
  diagnosticsBody: "For a type error, inspect which part of Effect<R, E, A> differs. Checking required services R, recoverable errors E, and successful results A separately helps identify why the operations cannot compose.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Does creating an Effect value also start the work?",
  summary: "Effect<R, E, A> represents work using services R that may fail with E or return A. Creating the value and executing the work are separate stages.",
  reading: "greeting takes a name and returns Task<String>. Task is an alias for an Effect that needs no services and has no recoverable failure. The function passed to defer is called at execution time. Its succeed represents a computation returning the constructed string successfully.",
  result: "Executing greeting \"Aki\" succeeds with \"Hello, Aki\". Merely storing greeting \"Aki\" in a variable does not retrieve a String. Even after map transforms the successful result, the return remains an Effect."
}
