import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "The Effect type",
  summary: (explanation ()).summary,
  ruleTitle: "Construction and execution are separate",
  ruleBody: "R is the structural service requirement, E is the recoverable error, and A is the success value. Building an Effect records a computation; it does not perform the represented I/O, scheduling, state access, or asynchronous work.",
  typingBody: "Effect composition merges compatible requirement fields and keeps one explicit failure type. Functor changes A, Applicative combines independent descriptions in its documented order, and Monad sequences later work from an earlier success.",
  evaluationBody: "Each execution starts the cold computation again. Sequential combinators run left to right and stop on typed failure, defect, or cancellation according to the selected operation's contract.",
  invalidTitle: "An Effect is not a Promise or an eager task",
  invalidBody: "Storing, passing, or returning an Effect does not start it or memoize its result. If work must run once or be shared, use the resource or concurrency API whose ownership and lifetime make that behavior explicit.",
  diagnosticsBody: "Type displays keep R, E, and A visible. Mismatches point to the requirement field, failure channel, or success value that does not compose rather than reporting a generic asynchronous error.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Is an Effect a result, or a description of work?",
  summary: "Effect<R, E, A> describes work that needs services R, may fail with E, and succeeds with A. Creating that value does not start the work.",
  reading: "greeting receives a name and returns a Task<String>, the service-free, recoverable-error-free form of Effect. defer delays choosing the inner computation until execution; succeed then completes with the constructed greeting.",
  result: "Executing greeting \"Aki\" yields \"Hello, Aki\". Merely storing greeting \"Aki\" does not obtain that String. Operations such as map transform the eventual success value while keeping the computation represented as an Effect."
}
