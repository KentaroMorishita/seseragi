import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "The Effect type",
  summary: (explanation ()).summary,
  ruleTitle: "Construction and execution are separate",
  ruleBody: "Effect<R, E, A> is a value representing work to execute. R names required services, E names recoverable failures, and A is the successful result type. Creating an Effect does not start I/O or state updates. First compose the work, then return it to an execution boundary.",
  typingBody: "map applies a function to a successful value and changes A. flatMap receives that value and chooses the next Effect to execute. They are also operations of the Functor and Monad traits, respectively. Applicative operations combine computations in a specified order. The combined computation requires all compatible services and uses one recoverable error type.",
  evaluationBody: "Executing the same Effect again starts its work from the beginning. This property is called cold execution. Sequential work proceeds from left to right. Stopping on recoverable failure, defect, or cancellation follows the selected operation's rules.",
  invalidTitle: "Creating an Effect does not start its work",
  invalidBody: "Saving, passing, or returning an Effect does not start it. Nor does it automatically store or share the execution result. To share work started once, choose a resource or concurrency API and define the scope that manages it and the operations used at its end.",
  diagnosticsBody: "For a type error, inspect which part of Effect<R, E, A> differs. Checking required services R, recoverable errors E, and successful results A separately helps identify why the operations cannot compose.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Does saving output work in a variable print immediately?",
  summary: "An Effect is a value describing work to execute. Separate saving that value from executing it and obtaining a result.",
  reading: "announce \"run\" constructs output work and stores it in planned without printing. main’s do executes operations in order. _ <- executes an operation and ignores its returned value; the final planned is executed too.",
  result: "The output is before, run, run. Nothing prints when planned is stored; executing the same value twice prints twice. This differs from keeping an already-started Promise and sharing its result.",
}

pub fn readerCaption -> String = "Execute the saved work twice"

pub fn readerBridgeOne -> String =
  "planned has type Effect<{ console: Console }, ConsoleError, Unit>: its output capability, possible output failure, and successful completion without a contents value. The general form calls these three types R, E and A."

pub fn readerBridgeTwo -> String =
  "Saving a TypeScript function to call later is a useful starting analogy. Effect also records the required capabilities and failure type. The runner calls the public main and starts its returned work. An Effect is not itself the ordinary Int or String it may produce."

pub fn readerInvalidCaption -> String = "Use the work as if it were its success value"

pub fn readerMistake -> String =
  "effects.succeed 42 constructs work that succeeds with 42. Assigning it to an Int let reports SES-T0101. Inside work, use a do binding such as value <- ... to pass the success value to subsequent operations."

pub fn readerDetailNote -> String =
  "The detailed rules below also use declaration-only examples. They have no standalone entry point; use the complete program with main above when you want to run an example."

pub fn readerLegacyReading -> String =
  "greeting takes a name and returns Task<String>. Task is an alias for an Effect that needs no services and has no recoverable failure. The function passed to defer is called at execution time. Its succeed represents a computation returning the constructed string successfully."

pub fn readerLegacyResult -> String =
  "Executing greeting \"Aki\" succeeds with \"Hello, Aki\". Merely storing greeting \"Aki\" in a variable does not retrieve a String. Even after map transforms the successful result, the return remains an Effect."
