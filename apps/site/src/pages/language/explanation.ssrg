import * as arrays from "std/array"
import { LocalizedText, localized } from "../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  PageDefinition,
  Paragraph,
  Words
} from "../../model/page"

// Each page owns its question and explanation. Existing canonical source is
// moved beside that explanation; it is neither copied nor replaced by prose.
pub struct ExplanationCopy {
  question: String,
  summary: String,
  reading: String,
  result: String
}

pub type ExampleSelection =
  | WithoutExample
  | ArticleExample String

pub struct Explanation {
  question: LocalizedText,
  summary: LocalizedText,
  exampleId: ExampleSelection,
  reading: LocalizedText,
  result: LocalizedText
}

pub fn makeExplanation exampleId: ExampleSelection
  -> english: ExplanationCopy
  -> japanese: ExplanationCopy
  -> Explanation =
  Explanation {
    question: localized english.question japanese.question,
    summary: localized english.summary japanese.summary,
    exampleId,
    reading: localized english.reading japanese.reading,
    result: localized english.result japanese.result
  }

fn isExample id: String -> block: Block -> Bool = match block {
  CodeExample (exampleId, _) -> exampleId == id
  _ -> False
}

fn keepExample id: ExampleSelection -> block: Block -> Bool = match id {
  WithoutExample -> True
  ArticleExample value -> !(isExample value block)
}

pub fn explainPage explanation: Explanation -> page: PageDefinition -> PageDefinition =
  {
    let source = match explanation.exampleId {
      WithoutExample -> {
        let empty: Array<Block> = []
        empty
      }
      ArticleExample id -> match arrays.find (isExample id) page.blocks {
        Nothing -> {
          let empty: Array<Block> = []
          empty
        }
        Just block -> [block]
      }
    }
    PageDefinition {
      ...page,
      summary: explanation.summary,
      blocks: arrays.concat [
        [Heading ("understand-this", explanation.question)],
        source,
        [
          Paragraph ([Words explanation.reading]),
          Paragraph ([Words explanation.result])
        ],
        arrays.filter (keepExample explanation.exampleId) page.blocks
      ]
    }
  }
