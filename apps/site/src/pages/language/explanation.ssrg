import * as arrays from "std/array"
import { LocalizedText, localized } from "../../model/locale"
import {
  Block,
  CodeExample,
  Heading,
  PageDefinition,
  Paragraph,
  Words
} from "../../model/page"

// Each page owns its question and explanation. Existing canonical source is
// moved beside that explanation; it is neither copied nor replaced by prose.
pub struct ExplanationCopy {
  question: String,
  summary: String,
  reading: String,
  result: String
}

pub type ExampleSelection =
  | WithoutExample
  | ArticleExample String
  | ArticleExamples (Array<String>)

pub struct Explanation {
  question: LocalizedText,
  summary: LocalizedText,
  exampleId: ExampleSelection,
  reading: LocalizedText,
  result: LocalizedText
}

pub fn makeExplanation exampleId: ExampleSelection
  -> english: ExplanationCopy
  -> japanese: ExplanationCopy
  -> Explanation =
  Explanation {
    question: localized english.question japanese.question,
    summary: localized english.summary japanese.summary,
    exampleId,
    reading: localized english.reading japanese.reading,
    result: localized english.result japanese.result
  }

fn isExample id: String -> block: Block -> Bool = match block {
  CodeExample (exampleId, _) -> exampleId == id
  _ -> False
}

fn containsId id: String -> ids: Array<String> -> Bool = match ids {
  [] -> False
  [value, ...rest] -> id == value || containsId id rest
}

// A group is all-or-nothing: every requested ID must name exactly one panel.
// Return the original blocks, including their localized labels, in ID order.
pub fn selectArticleExamples ids: Array<String>
  -> blocks: Array<Block>
  -> Either<String, Array<Block>> =
  match ids {
    [] -> Right []
    [id, ...rest] ->
      if containsId id rest then
        Left ("ArticleExamples duplicate requested ID: " + id)
      else
        match arrays.filter (isExample id) blocks {
      [] -> Left ("ArticleExamples missing page CodeExample: " + id)
      [block] -> match selectArticleExamples rest blocks {
        Left error -> Left error
        Right remaining -> Right (arrays.concat [[block], remaining])
      }
      _ -> Left ("ArticleExamples duplicate page CodeExample: " + id)
    }
  }

fn keepExample id: ExampleSelection -> block: Block -> Bool = match id {
  WithoutExample -> True
  ArticleExample value -> !(isExample value block)
  ArticleExamples values -> match block {
    CodeExample (value, _) -> !(containsId value values)
    _ -> True
  }
}

pub fn explainPage explanation: Explanation -> page: PageDefinition -> PageDefinition = {
    let selected: Either<String, Array<Block>> = match explanation.exampleId {
      WithoutExample -> {
        let empty: Array<Block> = []
        Right empty
      }
      ArticleExample id -> match arrays.find (isExample id) page.blocks {
        Nothing -> {
          let empty: Array<Block> = []
          Right empty
        }
        Just block -> Right [block]
      }
      ArticleExamples ids -> selectArticleExamples ids page.blocks
    }
    let (source, remaining) = match selected {
      Right blocks -> (blocks, arrays.filter (keepExample explanation.exampleId) page.blocks)
      // This reserved, deliberately absent example surfaces the diagnostic as
      // site-build-error through the existing renderer and build validation.
      Left error -> (
        [CodeExample (
          "__invalid-article-examples__/" + page.id + "/" + error,
          explanation.question
        )],
        page.blocks
      )
    }
    PageDefinition {
      ...page,
      summary: explanation.summary,
      blocks: arrays.concat [
        [Heading ("understand-this", explanation.question)],
        source,
        [
          Paragraph ([Words explanation.reading]),
          Paragraph ([Words explanation.result])
        ],
        remaining
      ]
    }
  }
