import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "トップレベルの宣言",
  summary: (explanation ()).summary,
  ruleTitle: "ファイルの直下には宣言を置く",
  ruleBody: "モジュール直下にはimport、再公開、let、fn、effect fn、型、impl、trait、instance、演算子、foreign、recなどの宣言を置きます。単独の関数呼び出しを文として並べることはできません。計算結果を保持するならletの右辺、処理を定義するなら関数の本体に書きます。",
  typingBody: "モジュール直下のletには、必ず一致するパターンと純粋な右辺が必要です。Effectの値を作るだけなら、外部処理をまだ実行しないため純粋な計算です。例のlet pending = report ()は、printlnを実行する処理の値を保存します。pendingの初期化時には出力しません。",
  evaluationBody: "letは上から順に一度だけ計算します。先のletとモジュールの関数を参照できますが、後のletを直接読むことはできません。関数の宣言はletの後にあっても呼べます。ただし、その関数がまだ初期化していないletを読むことはできません。",
  invalidTitle: "関数に移しても、未初期化の値は読めない",
  invalidBody: "関数の本体から後のletを参照すること自体はできます。問題になるのは、そのletの初期化前に関数を呼んでしまう場合です。SES-N0201はこの呼び出しを拒否します。関数宣言を上へ移すだけでは解消しません。関数同士の相互再帰には同じrecが必要です。",
  diagnosticsBody: "使う名前が宣言済みか、letのパターンが必ず一致するか、初期化中に未初期化の値へ到達していないかを確認してください。Effectをimportしただけでは実行しません。実行はmainなどの明示的な入口で行います。",
}

pub fn layoutTitle -> String = "公開する型を明示し、名前の範囲を区別する"

pub fn layoutBody -> String =
  "非公開のletでは、右辺から型を推論できます。通常のfnは、非公開でも引数と戻り値の型を書きます。例外となる短いeffect fnでは、->、with、fails、whereをすべて省略し、引数の型は書いたうえで戻り値のEffectを推論します。公開APIも、この形式の規則と公開範囲の規則に従います。importは他の宣言より前に置きます。ブロック内のローカル関数は宣言位置から使えます。"

pub fn exampleTitle -> String = "初期化では処理を構築し、実行は後へ残す"

pub fn exampleBody -> String =
  "まずbaseが初期化され、続いてanswerが42になります。report ()はpendingを構築しますが、printlnの処理は返されたEffectの中に残ります。他モジュールがこのファイルをimportしても、answerを出力することはありません。"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "モジュール直下で作ったEffectは、import時に実行されるか",
  summary: "モジュール直下の宣言は名前を定義し、通常の値を初期化します。Effectの値を保存しても、その説明する処理は実行しません。",
  reading: "baseは20です。answerではdouble 21を計算し、42を保存します。report ()は、出力を行うEffectの値を作り、pendingへ保存します。printlnの実行は後に残るため、この初期化では画面やコンソールに出力しません。",
  result: "保存したEffectを実行するのは、実行入口などの定められた境界です。トップレベルに単独の式文は置かず、値は宣言に、外部操作は返すEffectの中に書きます。"
}
