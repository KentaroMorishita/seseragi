import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  Article,
  CodeExample,
  Heading,
  PageDefinition,
  Terminal
} from "../../../../model/page"
import { ReaderCopy } from "../../reader-article"
import { paragraphs, related } from "../blocks"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition = {
  let english: ReaderCopy = en.copy ()
  let japanese: ReaderCopy = ja.copy ()
  PageDefinition {
    id: "language.modules.dependency-graphs",
    path: "/docs/language/modules/dependency-graphs/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        CodeExample
          ("modules-project-cycle-manifest", localized "seseragi.toml" "seseragi.toml"),
        CodeExample (
          "modules-project-cycle-shared-a",
          localized "src/shared-a.ssrg" "src/shared-a.ssrg"
        ),
        CodeExample (
          "modules-project-cycle-shared-b",
          localized "src/shared-b.ssrg" "src/shared-b.ssrg"
        ),
        CodeExample
          ("modules-project-cycle-main", localized "src/main.ssrg" "src/main.ssrg")
      ],
      [Terminal (
        localized "Check this separate project from its root" "この別プロジェクトのルートで検査",
        "seseragi lock update .\nseseragi run .\n"
      )],
      [Terminal (
        localized "Cycle diagnostic: code, kind and reported paths"
          "循環の診断：コード・種類・表示されるパス",
        "SES-K0001\nCycle\nModulePath(\"shared-a\")\nModulePath(\"shared-b\")\n"
      )],
      [Heading (
        "rule",
        localized "A file cannot depend on itself through other files"
          "別のファイルをたどって自分に依存してはいけない"
      )],
      paragraphs english.purpose japanese.purpose,
      [Heading (
        "reading-the-files",
        localized "Read the two directions of this dependency" "二方向の依存をファイルごとに読む"
      )],
      paragraphs english.reading japanese.reading,
      [Heading ("evaluation", localized (en.repairTitle ()) (ja.repairTitle ()))],
      paragraphs (en.repair ()) (ja.repair ()),
      [
        CodeExample (
          "modules-project-cycle-repair-manifest",
          localized "cycle-repair/seseragi.toml" "cycle-repair/seseragi.toml"
        ),
        CodeExample (
          "modules-project-cycle-repair-common",
          localized "cycle-repair/src/common.ssrg" "cycle-repair/src/common.ssrg"
        ),
        CodeExample (
          "modules-project-cycle-repair-shared-a",
          localized "cycle-repair/src/shared-a.ssrg" "cycle-repair/src/shared-a.ssrg"
        ),
        CodeExample (
          "modules-project-cycle-repair-shared-b",
          localized "cycle-repair/src/shared-b.ssrg" "cycle-repair/src/shared-b.ssrg"
        ),
        CodeExample (
          "modules-project-cycle-repair-main",
          localized "cycle-repair/src/main.ssrg" "cycle-repair/src/main.ssrg"
        )
      ],
      [Terminal (
        localized "Run from this project’s root" "このプロジェクトのルートで実行",
        "seseragi lock update .\nseseragi run .\n"
      )],
      [Terminal
          (localized "Output from the repaired project" "修正したプロジェクトの実行結果", "21, 22\n")],
      [Heading (
        "typing",
        localized "Types, traits, aliases and re-exports still create dependencies"
          "型・trait・別名・再公開にも依存関係がある"
      )],
      paragraphs english.rules japanese.rules,
      [Heading (
        "diagnostics",
        localized "A type-only cycle is rejected too" "型だけを取り込む循環も拒否される"
      )],
      paragraphs english.mistakes japanese.mistakes,
      [
        CodeExample (
          "modules-project-type-cycle-manifest",
          localized "type-cycle/seseragi.toml" "type-cycle/seseragi.toml"
        ),
        CodeExample (
          "modules-project-type-cycle-user",
          localized "type-cycle/src/user.ssrg" "type-cycle/src/user.ssrg"
        ),
        CodeExample (
          "modules-project-type-cycle-order",
          localized "type-cycle/src/order.ssrg" "type-cycle/src/order.ssrg"
        ),
        CodeExample (
          "modules-project-type-cycle-main",
          localized "type-cycle/src/main.ssrg" "type-cycle/src/main.ssrg"
        )
      ],
      [Terminal (
        localized "Check this separate project from its root" "この別プロジェクトのルートで検査",
        "seseragi lock update .\nseseragi run .\n"
      )],
      [Terminal (
        localized "Type-cycle diagnostic: code, kind and reported paths"
          "型の循環の診断：コード・種類・表示されるパス",
        "SES-K0001\nCycle\nModulePath(\"user\")\nModulePath(\"order\")\n"
      )],
      [Heading ("related-rules", localized "Questions to explore next" "次に調べたいこと")],
      related english.related japanese.related [
        (
          localized "Module initialization" "モジュールの初期化",
          "/docs/language/modules/initialization/"
        ),
        (localized "Imports" "import", "/docs/language/modules/imports/"),
        (localized "Re-exports" "再公開", "/docs/language/modules/re-exports/")
      ]
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
