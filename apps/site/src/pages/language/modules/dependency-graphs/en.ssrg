import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Dependency graphs and cycles",
  summary: (explanation ()).summary,
  ruleTitle: "Following imports must not return to the starting module",
  ruleBody: "If user.ssrg imports order.ssrg and order.ssrg imports user.ssrg, they form a cycle. The same applies when intermediate modules eventually lead back to the starting module. Imports of values, types, or traits, including re-exports, must not form cycles. This rule lets dependencies be processed before their consumers.",
  typingBody: "The example imports modules-domain, which does not import its consumer back. Two spellings that refer to the same file in the same package still describe one dependency. Giving an import an alias does not change the target module or remove a cycle.",
  evaluationBody: "If two modules need a shared type, move it to a module such as shared.ssrg and import it from both. shared.ssrg must not import either consumer back. Functions within one module may call each other in a rec group; separate modules may not import each other.",
  invalidTitle: "Type-only imports do not make a cycle harmless",
  invalidBody: "Importing only types still produces an error when user.ssrg and order.ssrg refer to each other. A dependency remains when another module re-exports it with pub import. Delaying Effect execution does not change the source imports and therefore does not remove the cycle.",
  diagnosticsBody: "Follow the module paths reported by the diagnostic. Inspect the whole path back to its starting point, not only the final import. Move shared declarations to a common module or otherwise change the actual imports to make the dependencies one-way.",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I recognize and remove an import cycle?",
  summary: "A module depends on every module it imports. A cycle occurs when following those imports eventually returns to the starting module.",
  reading: "The example imports modules-domain; that module defines UserId without importing the caller back. This is one-way dependency. In contrast, user.ssrg importing order.ssrg while order.ssrg imports user.ssrg would form a cycle, even if both imports mention only types.",
  result: "Move declarations both modules need into a third module, such as shared.ssrg, and let both import it without importing each other. An import alias changes a local name, not the dependency, so renaming alone cannot break the cycle."
}
