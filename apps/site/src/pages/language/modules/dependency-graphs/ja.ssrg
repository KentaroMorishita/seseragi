import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "依存グラフと循環",
  summary: (explanation ()).summary,
  ruleTitle: "importをたどって元のモジュールへ戻ってはいけない",
  ruleBody: "user.ssrgがorder.ssrgをimportし、order.ssrgがuser.ssrgをimportすると循環になります。間に別のモジュールを挟んでも、importをたどって元へ戻るなら同じです。値、型、traitのどれを取り込んでも、再公開を経由しても循環は禁止です。依存先を先に処理できる順序を決めるための規則です。",
  typingBody: "例では、利用側がmodules-domainをimportし、modules-domainは利用側をimportしません。同じパッケージの同じファイルを二通りにimportしても、依存先は一つです。importに別名を付けても参照先のモジュールは変わらず、循環は解消しません。",
  evaluationBody: "二つのモジュールが共通の型を必要とするなら、その型をshared.ssrgなどへ移し、両方からimportします。shared.ssrgは、その二つをimportしないようにします。同じモジュールの関数が互いを呼ぶ場合はrecでまとめられますが、別のモジュールが互いをimportすることはできません。",
  invalidTitle: "型だけのimportでも循環は禁止",
  invalidBody: "型だけをimportしていても、user.ssrgとorder.ssrgが互いを参照すればエラーになります。pub importで別のモジュールから再公開しても、その依存関係は残ります。Effectの実行を後へ延ばしても、ソースのimport先は変わらないため、循環は解消しません。",
  diagnosticsBody: "診断に表示されたモジュールのパスを順に確認してください。最後のimportだけでなく、どこから参照をたどると元へ戻るかを調べます。双方で使う宣言を共通モジュールへ移すなどして、実際のimportを一方向に変更してください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "importの循環を見つけ、解消するには",
  summary: "モジュールはimport先に依存します。importを順にたどって、出発したモジュールへ戻ってしまう状態が循環です。",
  reading: "例はmodules-domainを使い、その定義側は利用側をimportしていないので、一方向の依存です。一方、user.ssrgがorder.ssrgを、order.ssrgがuser.ssrgをimportすれば、型だけを使っていても循環になります。",
  result: "共通の宣言をshared.ssrgなどの第三のモジュールへ移し、双方がそこをimportする形にします。importの別名を変えても依存先は変わらず、名前を変えるだけでは循環を解消できません。"
}
