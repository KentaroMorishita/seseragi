import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "依存グラフと循環",
  summary: (explanation ()).summary,
  purpose: [
    "ファイルを分けた後で、二つのファイルが互いをimportすることがあります。依存グラフとは、各モジュールからimport先へ矢印を引いた関係のことです。その矢印をたどって出発点へ戻ると、循環になります。",
    "最初のプロジェクトではshared-a.ssrgがshared-b.ssrgを、shared-b.ssrgがshared-a.ssrgを必要とします。aを用意するにはbが必要で、bを用意するにはaが必要です。依存先を先に処理できる構成へ直しましょう。",
  ],
  exampleTitle: "互いの値を必要とする二つのファイル",
  reading: [
    "seseragi.tomlのpackageは名前、バージョン、対応する言語バージョンを指定します。runのentry = \"main\"は標準のsrcフォルダーのmain.ssrgを選び、target = \"process\"はプロセスで実行する指定です。",
    "shared-a.ssrgのimport { b }は、shared-b.ssrgの公開名bを取り込もうとします。pub let a: Int = b + 1は整数の値aを公開する宣言です。shared-b.ssrgも同じようにaを取り込み、bをa + 1で作ろうとします。どちらも相手を先に必要とします。",
    "main.ssrgはaを取り込み、pub effect fn mainでその表示を定義しています。Effectは実行する処理を表す値です。showは整数を文字列へ変え、printlnは文字列と改行を出力します。ただし、このプロジェクトではimportの循環が検出されるので、入口の出力処理まで進みません。",
  ],
  rules: [
    "循環は、値、型、traitのどれを取り込むimportでも禁止です。traitは複数の型に共通する操作を定義する仕組みですが、それだけを使う場合も依存関係に含まれます。型だけの循環も例外にはなりません。",
    "二つのファイルが直接importし合う場合だけでなく、三つ以上のファイルをたどって元へ戻る場合も循環です。pub importによる再公開も通常のimportと同じ依存関係に含まれます。",
    "importにasで別名を付けても、参照先のモジュールは変わりません。同じパッケージの同じファイルへ解決するパスは一つのモジュールを指します。綴りや別名を変えるだけでは、矢印の向きは変わりません。",
    "Effectの実行を後へ延ばしても、ソースに書いたimportは残ります。同じモジュールの関数同士が互いを呼ぶ場合にはrecグループを使えますが、別のモジュール同士の循環importを許可する指定ではありません。",
    "コンパイラは、循環を構成するすべてのモジュールパスを診断へ出します。最後に示されたimportだけでなく、そこからどの順で出発点へ戻るのかを確認します。",
  ],
  mistakes: [
    "次のtype-cycleプロジェクトでは、user.ssrgとorder.ssrgが型だけを取り込んでいます。pub struct UserはnameというStringのフィールドを持つ型、pub struct OrderはcountというIntのフィールドを持つ型です。mainはUser { name: \"Aki\" }で値を作り、.nameで文字列を読みます。型の循環があるので、その出力も始まりません。",
    "この小さな例では、両方の型定義がimportした型を実際には使っていません。不要な二つのimportを外せば循環する参照を取り除けます。実際に共通の型が必要なら、その型を第三のファイルへ移し、両方から取り込みます。第三のファイルが利用側をimportし返さないことが重要です。",
  ],
  related: [
    "循環をなくした後、依存先と利用側をどの順で初期化するか確認できます。",
    "名前だけの変更と、実際のimport先の変更を区別できます。",
    "公開用の中継ファイルも依存関係に含まれる理由を確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn repairTitle -> String = "共通の値を、どちらにも依存しないファイルへ移す"

pub fn repair -> Array<String> = [
  "修正版は別のプロジェクトです。common.ssrgがpub let base: Int = 20で共通の整数を公開します。shared-a.ssrgはbase + 1をaへ、shared-b.ssrgはbase + 2をbへ保存します。どちらもcommon.ssrgを必要としますが、common.ssrgはどちらもimportしません。",
  "main.ssrgはaとbを取り込みます。バッククォートで囲んだ`${a}, ${b}`は、二つの整数を文字列の中へ埋め込みます。選ばれたmainのEffectを実行すると、printlnが21, 22と改行を出力します。",
  "最初の循環にはa = b + 1とb = a + 1を同時に満たす値がありません。修正版は、その計算を同じものとして温存するのではなく、共通の基準値から二つの結果を作る設計へ変更しています。業務上どの値を共有したいかを決めたうえで、実際のimport先と計算を直してください。",
]

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "互いをimportする二つのファイルを、どう分け直すか",
  summary: "import先を順にたどって出発したモジュールへ戻る構成は、型だけのimportでもコンパイルエラーです。共有する定義を別のモジュールへ分けると、依存を一方向にできます。",
  reading: "この最初の例は、失敗を確かめるための完全なプロジェクトです。shared-a.ssrgがbを、shared-b.ssrgがaを取り込み、互いの値を使って自分の値を計算しようとします。main.ssrgからaを使うと、この循環も読み込まれます。",
  result: "seseragi run .はSES-K0001のCycle診断で拒否し、shared-aとshared-bのパスを示します。出力はありません。下の修正版では共通のbaseをcommon.ssrgへ移し、入口で21, 22を表示できる構成にします。",
}
