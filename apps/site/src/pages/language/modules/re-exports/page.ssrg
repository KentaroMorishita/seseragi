import { localized } from "../../../../model/locale"
import {
  Callout,
  Warning,
  Words,
  CodeExample,
  InternalLink,
  PageDefinition
} from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition =
  referencePage "language.modules.re-exports" "/docs/language/modules/re-exports/" (en.copy ()) (ja.copy ()) [
    CodeExample ("modules-re-exports", localized "Re-exports" "再export"),
    Callout (
      Warning,
      localized "Current compiler limitation" "現在のコンパイラの制約",
      [Words (
        localized
          "Combining a named re-export and a namespace re-export from the same source can currently generate duplicate exports and fail when the program starts. Use one re-export form per source until this lowering limitation is resolved; the named facade shown here is verified through execution."
          "同じソースから名前を指定した再exportと名前空間の再exportを組み合わせると、現在は重複したexportが生成され、起動に失敗する場合があります。コード生成の制約が解消されるまでは、一つのソースに対して一種類の再exportを使ってください。表示する名前指定の例は実行まで検証しています。"
      )]
    )
  ] [] [
    [InternalLink (localized "Visibility and opaque representations" "公開範囲とopaqueな表現", "/docs/language/modules/visibility/")],
    [InternalLink (localized "Imports" "import", "/docs/language/modules/imports/")],
    [InternalLink (localized "Dependency graphs and cycles" "依存graphと循環", "/docs/language/modules/dependency-graphs/")]
  ]
