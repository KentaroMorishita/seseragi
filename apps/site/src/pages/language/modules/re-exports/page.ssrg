import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import { CodeExample, InternalLink, PageDefinition } from "../../../../model/page"
import { referencePage } from "../../reference-article"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition =
  referencePage "language.modules.re-exports" "/docs/language/modules/re-exports/" (en.copy ()) (ja.copy ()) [CodeExample
      ("modules-re-exports", localized "Re-exports" "再公開")] [] [
        [InternalLink (
          localized "Visibility and opaque representations" "公開範囲とopaqueな表現",
          "/docs/language/modules/visibility/"
        )],
        [InternalLink (localized "Imports" "import", "/docs/language/modules/imports/")],
        [InternalLink (
          localized "Dependency graphs and cycles" "依存グラフと循環",
          "/docs/language/modules/dependency-graphs/"
        )]
      ]

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
