import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "再公開",
  summary: (explanation ()).summary,
  purpose: ["利用側を内部の細かな配置から切り離したいときに使います。TypeScriptでも別ファイルから名前をexportし直す窓口を作れます。Seseragiではpub importという書き方を使い、名前付きの型も元の定義として受け渡します。"],
  exampleTitle: "公開する窓口のファイルを一つ作る",
  reading: [
    "pub importのpubは、このimportで選んだ名前をさらに公開する指定です。通常のimportは自分のファイルで使う名前を選ぶだけです。どちらも、元の宣言を勝手に複製するものではありません。",
    "ここで公開を保つのはgreetという名前とStringを受け取ってStringを返す型です。パッケージの外から使わせる場合は、この窓口のモジュールをマニフェストのexportsからも参照できるようにします。"
  ],
  rules: [
    "次のnewtype UserId = Intは、整数を包むUserIdという別の型を作ります。UserId 42は値の構築、UserIdという型注釈は値の型の指定です。toIntのmatchはUserId valueの中身をvalueとして取り出し、その整数を返します。",
    "public.ssrgはUserIdとtoIntを名前で再公開すると同時に、pub import * as domainでdomainという名前空間も再公開します。利用側のapi.UserIdとapi.domain.UserIdは同じ定義元の型です。mainは一方の名前で作った値をもう一方の型注釈へ保存し、api.toIntで42を取り出します。",
    "名前空間は公開名をまとめて修飾するための名前です。domain.UserIdのように辿る指定であり、すべての名前を利用側へ無修飾で追加するワイルドカードではありません。名前を選ぶ再公開と名前空間の再公開は併用できます。別名を付けて公開しても、元の型の同一性は変わりません。",
    "pub importも通常のimportと同じ依存関係に加わります。再公開を経由した循環にも例外はなく、初期化の順序は依存先から決まります。traitのinstance、つまり型に対する操作の実装を使える範囲も、通常のimportの規則に従います。",
    "再公開するファイル自身の非公開名や、元のファイルの非公開名は自動で公開されません。opaqueで内部表現を隠した型を再公開しても、その制約は残ります。再公開は新しい型や実装を作る機能ではありません。"
  ],
  mistakes: [
    "次のgreeting.ssrgはgreetだけを公開し、punctuateは非公開です。public.ssrgがpunctuateまでpub importするとPrivateExportになります。利用側のmain.ssrgとseseragi.tomlは最初の例と同じ内容です。",
    "public.ssrgから非公開のpunctuateを取り除き、pub import { greet }だけにしてください。利用側は公開されたgreetを呼び、Hello, Aki!を表示できます。実装の補助関数まで外へ出す必要はありません。"
  ],
  related: [
    "元の宣言でpubやopaqueが何を公開するか確認します。",
    "名前付きimportと名前空間による参照を確認します。",
    "再公開を含むimportの循環を見つけて直す方法を調べます。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "内部のファイル配置を利用側に知らせず、関数を公開するには",
  summary: "greetの実装はgreeting.ssrgに置き、利用側はpublic.ssrgから取り込みます。pub importで別ファイルの公開宣言を再公開すると、利用側が指定する窓口をまとめられます。",
  reading: "greeting.ssrgのpub fn greetが関数を定義します。public.ssrgのpub import { greet }は、その公開名をこのファイルからも使えるようにする宣言です。main.ssrgは定義元のgreetingではなくpublicをimportします。",
  result: "greet \"Aki\"は同じ関数を呼ぶので、表示はHello, Aki!です。public.ssrgへ実装をコピーしたわけではありません。内部の配置を変える場合も、窓口が公開する名前と型を保てば利用側のimportを保てます。",
}

pub fn setup -> String =
  "空のフォルダーへ、seseragi.tomlとsrc内の三つのファイルを置きます。greeting.ssrg、public.ssrg、main.ssrgは兄弟です。下のコマンドはseseragi.tomlのあるフォルダーで実行します。mainだけではなく、参照先を含む一式を用意してください。"

pub fn detailsTitle -> String = "型の同一性を保ち、名前空間も再公開する"

pub fn mistakesTitle -> String = "非公開の補助関数は、別のファイルから再公開できない"

pub fn title -> String = (copy ()).title
