import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import { ReaderCopy } from "../../reader-article"
import { paragraphs, related } from "../blocks"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  Article,
  CodeExample,
  Heading,
  PageDefinition,
  Paragraph,
  Terminal,
  Words
} from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition = {
  let english = en.copy ()
  let japanese = ja.copy ()
  PageDefinition {
    id: "language.modules.imports",
    path: "/docs/language/modules/imports/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        CodeExample (
          "modules-project-named-import-manifest",
          localized "seseragi.toml" "seseragi.toml"
        ),
        CodeExample (
          "modules-project-named-import-greeting",
          localized "src/greeting.ssrg" "src/greeting.ssrg"
        ),
        CodeExample
          ("modules-project-named-import-main", localized "src/main.ssrg" "src/main.ssrg"),
        Paragraph ([Words (localized (en.setup ()) (ja.setup ()))]),
        Terminal (
          localized "Run the complete project" "一式を実行する",
          "seseragi lock update .\nseseragi run ."
        ),
        Terminal (localized "Output" "実行結果", "Hello, Aki!")
      ],
      paragraphs english.reading japanese.reading,
      [
        Heading (
          "typescript",
          localized "The same two files in TypeScript" "同じ二つのファイルをTypeScriptで書く"
        ),
        CodeExample (
          "modules-project-typescript-greeting",
          localized "TypeScript: greeting.ts" "TypeScriptのgreeting.ts"
        ),
        CodeExample (
          "modules-project-typescript-main",
          localized "TypeScript: main.ts" "TypeScriptのmain.ts"
        )
      ],
      paragraphs english.purpose japanese.purpose,
      [Heading ("rules", localized (en.detailsTitle ()) (ja.detailsTitle ()))],
      paragraphs english.rules japanese.rules,
      [
        Heading (
          "import-forms",
          localized "Replace main to compare the three forms" "mainを置き換えて三つの書き方を比べる"
        ),
        CodeExample
          ("modules-project-import-forms-main", localized "src/main.ssrg" "src/main.ssrg"),
        Terminal (localized "Output" "実行結果", "Hello, Aki!\nHello, Aki!\nHello, Aki!"),
        Heading (
          "operator-import",
          localized "A separate project imports an operator and its association"
          "別のプロジェクトで演算子と結合規則を取り込む"
        ),
        CodeExample
          ("modules-project-operator-manifest", localized "seseragi.toml" "seseragi.toml"),
        CodeExample (
          "modules-project-operator-operators",
          localized "src/operators.ssrg" "src/operators.ssrg"
        ),
        CodeExample
          ("modules-project-operator-main", localized "src/main.ssrg" "src/main.ssrg"),
        Terminal (localized "Output" "実行結果", "9")
      ],
      [Heading ("mistakes", localized (en.mistakesTitle ()) (ja.mistakesTitle ()))],
      paragraphs english.mistakes japanese.mistakes,
      [
        CodeExample (
          "modules-project-namespace-unqualified-main",
          localized "src/main.ssrg" "src/main.ssrg"
        ),
        Terminal (
          localized "Diagnostic to check" "確認する診断",
          "SES-N0001: Name could not be resolved"
        ),
        Heading ("repair", localized "Qualify the call" "モジュールの別名を付けて呼ぶ"),
        CodeExample
          ("modules-project-namespace-main", localized "src/main.ssrg" "src/main.ssrg")
      ],
      [Heading ("related-rules", localized "Find a specific answer" "必要なことを詳しく調べる")],
      related english.related japanese.related [
        (
          localized "Visibility and opaque representations" "公開範囲とopaqueな表現",
          "/docs/language/modules/visibility/"
        ),
        (
          localized "Module specifier resolution" "モジュール指定の解決",
          "/docs/language/modules/specifier-resolution/"
        ),
        (
          localized "Custom operators and fixity" "カスタム演算子と結合規則",
          "/docs/language/syntax/custom-operators/"
        )
      ]
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
