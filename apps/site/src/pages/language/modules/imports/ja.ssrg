import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "import",
  summary: (explanation ()).summary,
  purpose: [
    "TypeScriptなら、同じ二つのファイルをexport functionとimportで書けます。この例も同じ\"Aki\"を渡し、Hello, Aki!を表示します。どちらも関数を複製せず、定義したファイルから使います。",
    "この例で比較するのは関数の公開と利用です。TypeScriptのimportも十分短く書けます。Seseragiでは公開をpubで指定し、greet \"Aki\"のように空白で引数を渡す点を読み分けてください。"
  ],
  exampleTitle: "別ファイルの関数を呼ぶ",
  reading: [
    "\"./greeting\"の基準は、importを書いたmain.ssrgの場所です。同じディレクトリーのgreeting.ssrgを指し、.ssrgは省略できます。シェルで作業しているディレクトリーを基準にはしません。",
    "pubとimportは別々の役割です。定義側のpubが外から使ってよい名前を決め、利用側のimportがこのファイルで使う名前を選びます。importには関数の呼び出しの引数を書きません。"
  ],
  rules: [
    "import { greet }ならgreet、import { greet as welcome }ならwelcomeとして使います。asが変えるのは利用側の名前だけで、関数の型や実装は同じです。import * as wordsではwords.greetと書きます。wordsは公開名をまとめて参照するための別名であり、実行時のオブジェクトではありません。",
    "次の三つの呼び出しはすべて同じ関数を使います。mainのdoは出力処理を上から順に実行する指定です。Hello, Aki!が三行表示されます。すべての公開名を無修飾で取り込むワイルドカード構文はありません。importは他の宣言より前に置き、同じ範囲へ同じ名前を二度持ち込まないようにします。",
    "モジュール名による修飾は値や関数だけでなく、型、trait、値を作るコンストラクター、さらに入れ子の公開名前空間にも使えます。他言語との接続を宣言するforeign内のnamespaceも、このモジュールの別名の名前空間へ入り、同じ修飾形式で参照します。例えば公開newtypeが同じ綴りの型とコンストラクターを持つ場合、名前を指定するimport一つで両方を取り込みます。asも両方へ同じ別名を付け、型注釈か値の式かで参照先を区別します。",
    "独自演算子はimport { operator <^> }のように明示します。下のinfixr 4は、優先順位4で右側を先にまとめる指定です。<^>の本体は引き算なので、10 <^> 3 <^> 2は10 - (3 - 2)となり、9を表示します。operator名だけでなく、型、結合の向き、優先順位も公開情報から取り込みます。words.<^>のように修飾した中置表記はありません。",
    "importすると依存先のモジュールが初期化され、直下のletの純粋な計算では関数を呼ぶこともあります。一方、取り込んだ関数を自動で呼んだり、保存されたEffectや取り込み先のmainを自動実行したりはしません。コンパイラや言語サーバーは、演算子の解析のために取り込み先の関数本体を実行しません。",
    "traitは、ある型で使える操作をまとめる仕組みです。その型に対する操作の実装をinstanceと呼びます。取り込み先から提供され、型検査で実際に選ばれたinstanceがあれば、そのimportは使用済みです。式に別名が現れないことだけを理由に削除しません。名前、演算子、再公開、選ばれたinstanceのどれにも使わないimportは警告の対象です。"
  ],
  mistakes: [
    "最初のgreetingプロジェクトへ戻り、main.ssrgだけを次の内容へ置き換えます。import * as wordsで取り込んだのに、greetを直接呼んでいます。greetというローカル名は作られていないため、SES-N0001です。greeting.ssrgは最初の例と同じ内容で用意してください。",
    "words.greet \"Aki\"へ直せばHello, Aki!を表示します。あるいはimport { greet }へ変えれば、元のgreetという呼び方を使えます。非公開の名前は、名前を知っていてもimportできません。存在しない公開名の指定と、公開されていない宣言の指定は別の診断です。"
  ],
  related: [
    "宣言を公開するpubと、中身を隠すopaqueを調べます。",
    "相対パスやパッケージ名から参照先のファイルを決める規則を確認します。",
    "独自演算子の結合と優先順位の宣言を詳しく読みます。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "別のファイルに分けた関数を使うには",
  summary: "あいさつを作る関数をgreeting.ssrgへ分け、main.ssrgから呼びます。一つの.ssrgファイルが一つのモジュールです。使いたい宣言をpubで公開し、利用側のimportで選びます。",
  reading: "greeting.ssrgのpub fn greetは、文字列を受け取って文字列を返す公開関数です。name: Stringは引数の型、-> Stringは戻り値の型を示します。+で文字列をつなぎます。main.ssrgのimport { greet }は、その公開関数をこのファイルで使えるようにします。",
  result: "greet \"Aki\"は\"Hello, Aki!\"を返します。pub effect fn mainは出力処理を返す公開入口で、実行機構がその処理を開始します。printlnが文字列と改行を出力します。関数を別ファイルに分けても、呼び出し方や結果は変わりません。",
}

pub fn setup -> String =
  "空のフォルダーに、パネルのファイル名どおり三つのファイルを作ってください。srcは通常のソースを置くディレクトリーです。seseragi.tomlの[run]はsrc/main.ssrgを入口に選びます。以下のコマンドはそのフォルダーで実行します。相対importを含むため、main.ssrgだけを単独のPlaygroundへ貼る例ではありません。"

pub fn detailsTitle -> String = "名前を直接使う、別名を付ける、モジュール名を添える"

pub fn mistakesTitle -> String = "wordsを付けずに呼ぶと、別の名前を探してしまう"

pub fn title -> String = (copy ()).title
