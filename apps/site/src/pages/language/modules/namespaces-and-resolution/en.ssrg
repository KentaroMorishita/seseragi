import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Namespaces and name resolution",
  summary: (explanation ()).summary,
  purpose: ["Using a short name in an inner scope does not assign to the outer value. TypeScript also distinguishes a function-local variable from one with the same name outside. In Seseragi, the reference position additionally distinguishes a type name from a value name."],
  exampleTitle: "Distinguish a type, its constructor, and local names",
  reading: [
    "id: UserId in toInt accepts a wrapped value. The UserId number -> number branch of match id extracts the contents under the name number and returns it. This type has just one form.",
    "Backticks in main construct an interpolated string. ${toInt user} displays 42 and ${value} displays 1; println writes that string and a newline. pub effect fn main is the public entry returning this output work to the runner."
  ],
  rules: [
    "Types, traits and type parameters share one namespace. Values, functions and constructors share another. Fields and inherent methods, module aliases, and custom operators form three more: five categories in total. A name cannot be declared twice in the same namespace and scope.",
    "Constructors of newtype and multi-alternative type declarations enter the value namespace. Type parameters such as A enter the type namespace within their declaration. A type and constructor sharing a spelling are distinguished by type-annotation versus value-expression position; that alone is not ambiguous.",
    "Unqualified names are searched among nearby local bindings and functions, current-module declarations, explicit imports, and finally the standard prelude. The prelude supplies names such as Int and println without individual imports. Multiple candidates at the same stage produce an ambiguity error.",
    "Fields and methods resolve from the receiver's statically known type. Module aliases are separate too. With import * as words, words.greet refers to a public declaration rather than looking up a field on a runtime object called words.",
    "A named import of a public newtype introduces both its type and same-spelled constructor. An alias renames both, so the alias can appear in a type annotation and in value construction. Adding imports in a different order does not silently choose a new target for an ambiguous reference."
  ],
  mistakes: [
    "Both let value declarations below introduce values at the module top level. Neither belongs to another namespace or an inner scope, so SES-N0002 reports a duplicate. The second line is not treated as assignment to the first.",
    "Use distinct names, or move the inner declaration into a function as in the first example to give it a different scope. For colliding imported names, use as or namespace aliases. When a name is missing, check whether the reference is in a type or value position and whether it is within the declaration's scope as well as checking the spelling."
  ],
  related: [
    "Review aliases and qualified access for imported names.",
    "Check allowed identifier characters and reserved words.",
    "Find the scope in which a type parameter name is available."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Why can UserId name both a type and a way to construct a value?",
  summary: "A name is resolved by its position and scope as well as its spelling. The same spelling may have different roles in a type position and a value expression. These categories of names are called namespaces.",
  reading: "newtype UserId = Int defines a distinct type wrapping an integer. UserId in let user: UserId is a type name. UserId (local ()) on the right is a constructor that makes a value of that type. local () calls the function with the Unit argument ().",
  result: "Inside local, the nearer let value = 42 is read, and the final value in the block is returned. The outer value = 1 is unchanged. Displaying the integer inside user and then the outer value produces 42, 1.",
}

pub fn setup -> String =
  "Create seseragi.toml and src/main.ssrg in an empty directory and run the commands there. All application names in this example are defined in main.ssrg, so no sibling source file is required."

pub fn detailsTitle -> String = "Resolve a name by its purpose and scope"

pub fn mistakesTitle -> String = "Do not define value twice in the same scope"

pub fn title -> String = (copy ()).title
