import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "名前空間と名前解決",
  summary: (explanation ()).summary,
  purpose: ["同じ短い名前を内側で使っても、外側の値を書き換えることにはなりません。TypeScriptでも関数内の変数は外側の同名の変数と区別できます。Seseragiではさらに、型として読む名前か値として読む名前かを、その位置で区別します。"],
  exampleTitle: "型名と値を作る名前、内側と外側の名前",
  reading: [
    "toIntの引数id: UserIdは、包まれた値を受け取る指定です。match idのUserId number -> numberは、その値の中身をnumberという名前で取り出して返す分岐です。この型には一つの形しかありません。",
    "mainのバッククォートは値を埋め込む文字列です。${toInt user}へ42、${value}へ1の表示が入り、printlnが文字列と改行を出力します。pub effect fn mainは、その出力処理を実行機構へ返す公開入口です。"
  ],
  rules: [
    "型、trait、型パラメーターの名前は一つの名前空間です。値、関数、コンストラクターは別の名前空間です。さらにフィールドと固有メソッド、モジュールの別名、独自演算子を区別し、合わせて五つの区分があります。同じ名前空間の同じスコープでは、同名を重複して宣言できません。",
    "newtypeや、複数の形を持つtypeのコンストラクターは値の側へ入ります。ジェネリック宣言のAなどの型パラメーターは、その宣言内の型の側へ入ります。型名とコンストラクター名が一致していても、型注釈か値の式かで区別できるため、それだけでは曖昧になりません。",
    "修飾しない名前は、近くのローカル変数・ローカル関数、現在のモジュールの宣言、明示したimport、標準で使えるpreludeの順に探します。preludeはIntやprintlnなど、個別のimportなしで使える標準の名前です。同じ段階に候補が複数ある場合は曖昧な参照として拒否します。",
    "フィールドやメソッドの参照先は、受け取る値のコンパイル時の型から決まります。モジュールの別名も別扱いです。例えばimport * as wordsならwords.greetは公開名への参照であり、wordsという実行時オブジェクトのフィールドを調べる操作ではありません。",
    "名前付きimportで公開newtypeの名前を一つ指定すると、同じ綴りの型とコンストラクターを両方取り込めます。別名も両方へ付くため、その別名を型注釈と値の構築に使います。importを追加した順番で曖昧な参照先を勝手に選び直すことはありません。"
  ],
  mistakes: [
    "次の二つのlet valueは、どちらも同じファイル直下の値の宣言です。別の名前空間でも内側のスコープでもないため、SES-N0002で重複を指摘されます。二行目を後の代入として扱うことはありません。",
    "一方を別名にするか、最初の例のように関数の内側へ置いて、使う範囲を分けてください。importした名前の衝突ならasやモジュールの別名で区別します。名前が見つからない場合は綴りだけでなく、値の式か型の位置か、宣言の範囲内かも確かめます。"
  ],
  related: [
    "importした名前に別名を付けたり、モジュール名を添えたりする方法を確認します。",
    "識別子に使える文字と予約語を調べます。",
    "型パラメーターの名前を使える範囲を確認します。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "同じUserIdを、型の指定と値の構築に使えるのはなぜか",
  summary: "名前の綴りだけでなく、書かれた場所と使える範囲から参照先を決めます。型を指定する場所と、値を作る場所では、同じ綴りでも違う役割を持てます。この用途の区分を名前空間と呼びます。",
  reading: "newtype UserId = Intは、整数を包む別の型を定義します。let user: UserIdのUserIdは型名です。右辺のUserId (local ())は、その型の値を作るコンストラクターです。local ()は引数として()を渡す関数呼び出しです。",
  result: "localの中では、近くのlet value = 42を読み、そのブロックの最後のvalueを返します。外側のvalue = 1は変わりません。userの中身を表示すると42、外側のvalueは1なので、実行結果は42, 1です。",
}

pub fn setup -> String =
  "空のフォルダーにseseragi.tomlとsrc/main.ssrgを作り、そのフォルダーで次のコマンドを実行します。この例の名前はすべてmain.ssrgで定義しているため、兄弟のソースは不要です。"

pub fn detailsTitle -> String = "名前を用途とスコープから探す"

pub fn mistakesTitle -> String = "同じ範囲へvalueを二度定義しない"

pub fn title -> String = (copy ()).title
