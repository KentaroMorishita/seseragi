import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "名前空間と名前解決",
  summary: (explanation ()).summary,
  ruleTitle: "型の名前と値の名前は、別々に扱われる",
  ruleBody: "newtype UserId = Intでは、UserIdを型の名前にも、値を作るコンストラクターの名前にも使います。型注釈のUserIdは型を、UserId 42はコンストラクターを参照します。Seseragiは名前を、型・trait・型パラメーター、値・関数・コンストラクター、フィールド・固有メソッド、モジュールの別名、独自演算子の五つに分けて扱います。この区分を名前空間と呼びます。",
  typingBody: "修飾しない名前は、まず近くのローカル束縛とローカル関数から探します。次に現在のモジュール、明示的なimport、標準で使えるpreludeの順に調べます。例えば、関数内のlet valueはモジュールのvalueより優先します。同じ段階に候補が複数ある場合はエラーです。",
  evaluationBody: "同じ名前空間の同じスコープには、同名の宣言を二つ置けません。フィールドやメソッドの参照先は、それを持つ値の静的な型から決まります。text.trimのtextのようなモジュールの別名は、公開名を修飾するためのものです。モジュール自体が実行時の値になるわけではありません。",
  invalidTitle: "同じ名前空間には、同じ名前を重複して宣言できない",
  invalidBody: "型とコンストラクターは、書かれた位置によって区別できるため同名にできます。一方、同じスコープに二つの値を同名で宣言することはできません。importした名前が衝突する場合は、別名を付けるか、モジュール名で修飾します。宣言の順番で参照先が決まるわけではありません。",
  diagnosticsBody: "名前が見つからない場合は、その名前を使っている位置、使える範囲、importの書き方を確認してください。候補が複数ある場合は、別名や修飾名で意図した宣言を指定します。型の注釈で使う名前なのか、値の式で使う名前なのかも見分けてください。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "UserIdを型名にも値の構築にも使えるのはなぜか",
  summary: "同じUserIdという綴りでも、型注釈では型名、値を作る式ではコンストラクターです。コンパイラは、名前を書いた位置と使える範囲から参照先を決めます。このように用途別に区別する名前の範囲を名前空間と呼びます。",
  reading: "user: UserIdのUserIdは型名で、UserId (local ())のUserIdはコンストラクターです。localの中では、モジュールのvalue = 1より近いlet value = 42を参照します。",
  result: "userはUserId 42で、外側のvalueは1のままです。内側の範囲で名前を使っても、外側の値への代入ではありません。importが曖昧なら別名や修飾名で区別します。"
}
