import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "モジュールの識別",
  summary: (explanation ()).summary,
  ruleTitle: "一つのファイルが一つのモジュールを定義する",
  ruleBody: "一つの.ssrgファイルが一つのモジュールになります。ファイルの先頭でモジュール名を宣言する必要はありません。通常は、ソースのルートディレクトリからの相対パスがモジュールのパスになります。ルートがsrcなら、src/domain/user.ssrgのパスはdomain/userです。パッケージも識別に使うため、別のパッケージにある同名のファイルとは区別されます。",
  typingBody: "名前付きの型は、定義元のモジュールに属します。importで変わるのは呼び方であり、型そのものではありません。例では、拡張子.ssrgを省略したパスと明示したパスの両方から、同じファイルのUserIdとtoIntを取り込んでいます。そのため、一方から作ったUserIdを他方のtoIntへ渡せます。同じ宣言を別ファイルにコピーした場合は、別の型になります。",
  evaluationBody: "同じモジュールを複数のimportから使っても、宣言とトップレベルの値は共有します。初期化は依存先の後に一度だけ行います。例えば、同じUserIdを別名で二度importしても、二種類のUserIdが作られるわけではありません。",
  invalidTitle: "importの別名と、モジュールそのものを混同しない",
  invalidBody: "モジュールに付ける別名を変えても、新しいモジュールにはなりません。.ssrgを付けても別の型にはなりません。一方、内容が同じでも、別ファイルの宣言は別のモジュールに属します。型名が同じなのに型エラーになる場合は、定義元のパッケージとモジュールを確認してください。",
  diagnosticsBody: "モジュールのパスは、UnicodeのNFCという形式に正規化されます。ファイル名の大文字・小文字も一致させる必要があります。正規化すると同名になるファイルや、大文字・小文字だけが違うモジュールは置けません。シンボリックリンクを使っても同じファイルは一つとして扱われ、パッケージの外へ参照先が出ることはできません。",
}

pub fn layoutTitle -> String = "ソースのルートディレクトリを基準にパスを読む"

pub fn layoutBody -> String =
  "パッケージは名前、正確なバージョン、取得元で識別します。通常のソース、生成されたソース、テスト、ベンチマークのルートは区別され、生成コードには@generated、テストには@test、ベンチマークには@benchmarkという区分が付きます。相対importで..を使っても、別のルートには移動できません。識別用のパスは/で区切り、拡張子.ssrgを含めません。"

pub fn exampleTitle -> String = "二つのimportから、同じ定義を使う"

pub fn exampleBody -> String =
  "二つのファイルを、同じソースのルート内の同じディレクトリに置きます。一つ目に型と公開関数を定義し、二つ目から拡張子を省略したパスと明示したパスで参照します。二つのコードパネルを合わせて一つの例です。"

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "同じファイルを二通りにimportすると、型も二つになるか",
  summary: "一つのソースファイルが一つのモジュールです。正しく解決した先が同じファイルなら、importの綴りが違っても同じ宣言を使います。",
  reading: "modules-domainにはUserId、userId、toIntを定義します。利用側の例ではUserIdを.ssrgなし、toIntを.ssrgありでimportしますが、同じパッケージの同じファイルへ解決します。",
  result: "UserIdとtoIntを異なるimportから使っても、同じ定義元なので組み合わせられます。一方、同じnewtype宣言を別のファイルへコピーすると、そのファイルで定義した別の型になります。内容だけでなく定義元も型の区別に使います。"
}
