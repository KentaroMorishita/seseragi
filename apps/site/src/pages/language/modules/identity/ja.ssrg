import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "モジュールの識別",
  summary: (explanation ()).summary,
  purpose: ["同じファイルへたどり着くimportなら、定義を共有できるため、別名を付けた利用側どうしでも同じ関数や型を使えます。TypeScriptでもimportのasは呼び方を変える指定です。ここで確認するのは、Seseragiでも別名と定義元を分けて考えることです。"],
  exampleTitle: "同じファイルを二通りに指定する",
  reading: [
    "greetのpubは、この関数を他のファイルから使えるようにします。fnは関数宣言、name: Stringと-> Stringは引数と結果の型です。mainのdoはprintlnによる二つの出力処理を順に実行します。",
    "モジュールを区別するときは、パッケージと、そのソースの起点からファイルまでのパスを使います。src/domain/user.ssrgなら、通常のモジュールのパスはdomain/userです。別パッケージに同じパスのファイルがあっても、別のモジュールです。"
  ],
  rules: [
    "次のpub newtype UserId = Intは、整数を包むUserIdという名前付きの型を定義します。UserId 42はその型の値を作り、let id: UserIdのUserIdは型注釈です。toIntのmatchは包まれた整数を取り出す処理で、UserId value -> valueはその中身をvalueという名前で返します。",
    "UserIdは拡張子なし、toIntは拡張子ありのimportから使っていますが、どちらも同じdomain.ssrgの宣言です。そのためtoInt idは42になります。別のファイルへ同じnewtype宣言をコピーした場合は、定義元が異なる別の型になり、同じようには渡せません。",
    "パッケージは名前、正確なバージョン、取得元で区別します。通常のソースに加え、生成コード、テスト、ベンチマークの起点も区別します。識別用のパスには、それぞれ@generated、@test、@benchmarkという区分が付きます。相対importの..で別の起点へ移動することはできません。",
    "識別用のパスは/区切りで、.ssrgを含めません。同じファイルへ到達する相対パスやシンボリックリンクは、一つの正規化したパスへ解決します。何か所からimportしても、そのモジュールの直下の値は一度だけ初期化され、利用側で共有します。",
    "Unicodeには同じ文字を複数の符号の並びで表せる場合があります。モジュールのパスはNFCという形式へ正規化して識別します。正規化後に同名となるファイルは同じ起点へ置けません。大文字・小文字だけが異なるモジュールも、同じパッケージへ置けません。importの大文字・小文字も実際のファイル名に合わせ、シンボリックリンクでもパッケージの外へ抜けないようにします。"
  ],
  mistakes: [
    "次の例では、domain.ssrgの内容をcopied-domain.ssrgへもコピーしています。UserIdをコピー側、toIntを元のファイルからimportすると、SES-T0101になります。診断の型名がどちらもUserIdでも、定義元が異なります。型名の綴りだけで判断せず、二つのimport先を確認してください。",
    "型とその操作を同じdomain.ssrgから取り込む形へ戻せば、42を表示できます。importに別名を付けることと、宣言を別ファイルへ複製することは違います。"
  ],
  related: [
    "パッケージの名前や依存先を宣言する設定を確認します。",
    "型を公開しつつ、その内部表現を隠す方法を調べます。",
    "名前付きimportと別名の使い分けを確認します。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "同じファイルを二通りにimportすると、別の関数になるか",
  summary: "一つのファイルで定義した関数を、二つのimportから使います。呼び方が違っても、参照先が同じファイルなら同じ宣言です。",
  reading: "二つのimportは、それぞれ\"./greeting\"と\"./greeting.ssrg\"を指定します。どちらも同じ場所のgreeting.ssrgです。二つ目のas greetAgainは、利用側で区別して呼ぶための別名です。",
  result: "greet \"Aki\"もgreetAgain \"Aki\"も同じgreetを呼び、Hello, Aki!が二行表示されます。importの綴りや別名を変えても、関数を複製したり、新しいモジュールを作ったりはしません。",
}

pub fn setup -> String =
  "空のフォルダーにseseragi.tomlと、src内の二つのファイルを、パネルに示した配置で作ります。ファイルの中にモジュール名を宣言する行は不要です。そのフォルダーで次のコマンドを実行してください。"

pub fn detailsTitle -> String = "型の名前が同じでも、定義元が違えば別の型"

pub fn mistakesTitle -> String = "同じ宣言をコピーしても、元のUserIdにはならない"

pub fn title -> String = (copy ()).title
