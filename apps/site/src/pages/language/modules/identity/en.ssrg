import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "Module identity",
  summary: (explanation ()).summary,
  ruleTitle: "One file defines one module",
  ruleBody: "A .ssrg file contains one module; it does not start with a module-name declaration. Within an ordinary source root, the relative file path names that module. For example, src/domain/user.ssrg has the module path domain/user when src is the package's source root. The package identity supplies the other half of its name, so domain/user in two different packages does not become the same module.",
  typingBody: "A nominal type belongs to its declaring module. An import changes how you refer to that declaration, not which type it is. In the example, UserId and toInt come from the same file through spellings with and without the .ssrg suffix. The UserId produced by userId is therefore accepted by toInt. Copying the declaration into a second file would create a different nominal type.",
  evaluationBody: "Multiple imports of one module share its declarations and top-level values. Initialization occurs once, after its dependencies. For example, importing UserId twice under different names does not create two UserId types.",
  invalidTitle: "An import spelling is not an identity",
  invalidBody: "Renaming a namespace alias does not create a new module, and adding the .ssrg suffix does not create a new type. Conversely, two files with identical contents are still separate modules. When a type mismatch occurs, inspect the defining package and module instead of comparing only the displayed type name.",
  diagnosticsBody: "The resolver canonicalizes paths and rejects an ambiguous or invalid module path. Module paths use NFC-normalized Unicode and matching filename case; two files that collapse to one normalized spelling, or differ only by case within a package, are not valid independent modules. Symlink aliases must resolve to one canonical path without escaping the package.",
}

pub fn layoutTitle -> String = "Source roots give paths their meaning"

pub fn layoutBody -> String =
  "Package identity includes its name, exact version and source identity. Source, generated, test and benchmark roots remain distinct: generated modules use @generated, tests use @test and benchmarks use @benchmark in their identities. A relative import stays within the current root; it cannot use .. to cross into another root. Filesystem separators normalize to / and .ssrg is omitted from the module identity."

pub fn exampleTitle -> String = "Two imports, one defining module"

pub fn exampleBody -> String =
  "Place these files next to each other in the same source root. The first file owns the type and public functions. The second refers to that file twice; the second spelling explicitly includes its extension. These panels form a two-file example."

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Are two imports of the same file two different types?",
  summary: "A source file is one module. Different valid spellings that resolve to that file refer to the same declarations.",
  reading: "modules-domain defines UserId and the public functions userId and toInt. The companion example imports UserId without .ssrg and toInt with .ssrg; both imports resolve to that one file in the same package.",
  result: "UserId and toInt from different imports work together because they share one defining module. Copying the same newtype declaration into another file creates a distinct type defined in that file. Type identity depends on its declaration's origin, not only its contents."
}
