import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Packages",
  summary: (explanation ()).summary,
  purpose: ["A package groups files into a unit callers can use through chosen public names. Creating another directory does not itself create another package. Explicit configuration and exported paths separate internal file organization from the caller's contract."],
  exampleTitle: "An application uses a neighboring library",
  reading: [
    "Each [package] declares a name, a package version, and a supported language-version range. The language range is not the CLI product version number. Each package has its own seseragi.toml.",
    "pub fn greet is a public function from String to String. [exports] chooses which modules an external package can reach; pub chooses which declarations it can use once there. pub alone does not expose every file in the package.",
    "lock update records the resolved dependencies and inputs in seseragi.lock. run then executes src/main.ssrg selected by the application's [run] table. main returns the println operation, and the runner prints the string and a newline."
  ],
  rules: [
    "One seseragi.toml defines the package root. The compiler neither infers it from package.json nor merges several parent configurations. Import external packages only when declared directly in your own [dependencies]. A library's further dependencies do not automatically become importable by your application.",
    "Package identity includes name, exact version and source identity. Different versions can have distinct identities. Two sources claiming the same name and exact version in one dependency graph cause an error rather than an arbitrary choice. Imported named types retain their defining package identity.",
    "Package names use lowercase ASCII segments separated by /. The std, self and gen prefixes are reserved. An incompatible language range is rejected before source typechecking. Explicitly run lock update after changing dependency or source inputs.",
    "The default roots for ordinary source, tests, benchmarks and generated bindings are src, tests, benchmarks and .seseragi/generated. They cannot overlap or escape the package, even through symlinks. Tests and benchmarks use their corresponding commands; generated modules carry a distinct identity tag. Relative imports stay within one root.",
    "self/ selects ordinary source in the current package, and gen/ selects generated bindings. An external consumer uses the paths chosen by exports. Adding \"email\" = \"email\", for example, makes docs/greetings/email resolve to src/email.ssrg. That file must exist, and its usable declarations still need pub.",
    "A path dependency's package name must match the target manifest. The path form is for local development and cannot remain in a published package manifest. The rules for direct dependencies, exported paths and declaration visibility do not change with the acquisition method."
  ],
  mistakes: [
    "internal/secret.ssrg contains pub let secret. Nevertheless, importing docs/greetings/internal/secret from the application produces SES-N0104 because the path is absent from exports. A file existing is different from it being externally reachable.",
    "Restore main.ssrg to the original greet-based source to print Hello, Aki! in the same project. If an internal value genuinely belongs in the public API, deliberately redesign the library's declarations and exports. A caller's relative path is not a way around the boundary."
  ],
  related: [
    "See how package identity and file path identify a module.",
    "Review pub and opaque on functions and types.",
    "Check how the start of an import path determines its resolver."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I use a function from another project?",
  summary: "Make a greeting library and its application separate packages. A package uses seseragi.toml to declare its name and dependencies. This example points to a neighboring directory rather than downloading anything.",
  reading: "In the library, \".\" = \"lib\" under [exports] maps an import of docs/greetings to src/lib.ssrg. The application's [dependencies] table locates that package at ../greetings-library. That path is relative to the directory containing app/seseragi.toml.",
  result: "import { greet } from \"docs/greetings\" uses the library's public greet. The application prints the string returned by greet \"Aki\", producing Hello, Aki!. The library does not need main.",
}

pub fn setup -> String =
  "Create sibling app and greetings-library directories and all five files at the displayed paths. app contains the entry point; greetings-library contains the public function and an internal file. Run the commands below from the parent directory containing both packages."

pub fn detailsTitle -> String =
  "Expose a declaration and expose a module as separate decisions"

pub fn mistakesTitle -> String =
  "A public declaration can still sit behind a private package path"

pub fn title -> String = (copy ()).title
