import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "パッケージ",
  summary: "複数のモジュールを一つの単位として扱い、名前、バージョン、依存先、公開するモジュールをseseragi.tomlに指定します。",
  ruleTitle: "seseragi.tomlでパッケージの範囲を決める",
  ruleBody: "パッケージのルートにseseragi.tomlを一つ置きます。名前、バージョン、対応する言語のバージョンを宣言し、必要に応じてソースの配置、直接の依存先、公開するモジュールを指定します。ディレクトリーを分けるだけでは、別のパッケージにはなりません。package.jsonから設定を推測したり、親ディレクトリーの設定を自動で混ぜたりもしません。",
  typingBody: "パッケージは、名前、正確なバージョン、取得元で区別します。同じ名前とバージョンでも取得元が異なるものを一つの依存関係に混ぜるとエラーになります。別のパッケージで定義した型は、その定義元の型として扱います。型名が同じという理由で同一の型にはなりません。",
  evaluationBody: "importできる外部パッケージは、マニフェストに直接の依存先として宣言したものだけです。依存先がさらに利用しているパッケージを、自分の宣言なしに使うことはできません。importするモジュールは、依存先の公開パスの対応表から解決します。",
  invalidTitle: "宣言の公開と、モジュールの公開は別の設定",
  invalidBody: "pubは、そのモジュールの宣言を他モジュールへ公開します。マニフェストのexportsは、外部パッケージから参照できるモジュールのパスを定めます。pubだけでは内部のすべてのファイルを外部から参照できず、exportsだけでは非公開の宣言を使えるようにはなりません。",
  diagnosticsBody: "名前は小文字ASCIIの区分を/でつなぎます。std、self、genで始まる名前は予約されています。依存先や公開パスが見つからないときは、マニフェストと実際のファイルを確認してください。seseragi.lockは解決済みの依存関係を記録するため、パッケージやソースを変更したらseseragi lock updateで更新します。",
}

pub fn layoutTitle -> String = "通常のソースと、テスト・生成コードの配置を区別する"

pub fn layoutBody -> String =
  "ソースを探す起点は、既定ではsrc、tests、benchmarks、.seseragi/generatedです。通常のコード、テスト、ベンチマーク、生成されたコードをそれぞれ分けて置きます。これらのディレクトリは重複できず、シンボリックリンクを使ってもパッケージの外へ出られません。testsとbenchmarksは対応するコマンドで使い、通常のコードとは別に識別します。相対importは同じ起点の中で使います。self/はこのパッケージの通常のソース、gen/は生成された連携コードを参照する指定です。"

pub fn exampleTitle -> String = "ライブラリで公開するモジュールを選ぶ"

pub fn exampleBody -> String =
  "下の設定では、外部からacme/validationをimportするとsrc/lib.ssrgを、acme/validation/emailならsrc/email.ssrgを使います。exportsに載せていないファイルは、パッケージ内部だけで使います。ライブラリにはmainは不要です。実行するパッケージにする場合は、[run]に実行入口のモジュールと実行環境を指定します。"
