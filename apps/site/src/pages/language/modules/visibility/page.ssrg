import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import { ReaderCopy } from "../../reader-article"
import { paragraphs, related } from "../blocks"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  Article,
  CodeExample,
  Heading,
  PageDefinition,
  Paragraph,
  Terminal,
  Words
} from "../../../../model/page"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition = {
  let english = en.copy ()
  let japanese = ja.copy ()
  PageDefinition {
    id: "language.modules.visibility",
    path: "/docs/language/modules/visibility/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        CodeExample (
          "modules-project-private-helper-manifest",
          localized "seseragi.toml" "seseragi.toml"
        ),
        CodeExample (
          "modules-project-private-helper-greeting",
          localized "src/greeting.ssrg" "src/greeting.ssrg"
        ),
        CodeExample (
          "modules-project-private-helper-main",
          localized "src/main.ssrg" "src/main.ssrg"
        ),
        Paragraph ([Words (localized (en.setup ()) (ja.setup ()))]),
        Terminal (
          localized "Run the complete project" "一式を実行する",
          "seseragi lock update .\nseseragi run ."
        ),
        Terminal (localized "Output" "実行結果", "Hello, Aki!")
      ],
      paragraphs english.reading japanese.reading,
      paragraphs english.purpose japanese.purpose,
      [Heading ("rules", localized (en.detailsTitle ()) (ja.detailsTitle ()))],
      paragraphs english.rules japanese.rules,
      [
        Heading (
          "opaque-type",
          localized "A separate project publishes operations on an opaque Counter"
            "別のプロジェクトでCounterの操作だけを公開する"
        ),
        CodeExample
            ("modules-project-opaque-manifest", localized "seseragi.toml" "seseragi.toml"),
        CodeExample
            ("modules-project-opaque-domain", localized "src/domain.ssrg" "src/domain.ssrg"),
        CodeExample
            ("modules-project-opaque-main", localized "src/main.ssrg" "src/main.ssrg"),
        Terminal (localized "Output" "実行結果", "42")
      ],
      [Heading ("mistakes", localized (en.mistakesTitle ()) (ja.mistakesTitle ()))],
      paragraphs english.mistakes japanese.mistakes,
      [
        CodeExample (
          "modules-project-private-import-main",
          localized "Private helper example: src/main.ssrg" "補助関数の例を変更するsrc/main.ssrg"
        ),
        CodeExample (
          "modules-project-opaque-access-main",
          localized "Opaque example: src/main.ssrg" "opaqueの例を変更するsrc/main.ssrg"
        )
      ],
      [Terminal (
        localized "Diagnostic to check" "確認する診断",
        "PrivateExport: punctuate\nSES-T0101: record type has no field `value`"
      )],
      [Heading ("related-rules", localized "Find a specific answer" "必要なことを詳しく調べる")],
      related english.related japanese.related [
        (localized "Imports" "import", "/docs/language/modules/imports/"),
        (localized "Packages" "パッケージ", "/docs/language/modules/packages/"),
        (localized "Module identity" "モジュールの識別", "/docs/language/modules/identity/")
      ]
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
