import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "公開範囲とopaqueな表現",
  summary: (explanation ()).summary,
  purpose: ["利用側が知る必要のある名前だけを公開すると、ファイルの内部を直す範囲と、利用側にも影響する変更を区別できます。TypeScriptで補助関数をexportしない場合と同じく、公開関数の本体から非公開の補助関数を呼べます。"],
  exampleTitle: "公開関数から非公開の補助関数を使う",
  reading: [
    "fn greet name: String -> Stringは文字列を一つ受け取り、文字列を返します。pubはその関数を公開する指定で、関数内から使うすべての名前を一緒に公開する指定ではありません。",
    "pub effect fn mainは出力する処理を返す公開入口です。実行機構がmainの返す処理を開始し、printlnが文字列と改行を出力します。greeting.ssrgをimportしたこと自体がgreetの呼び出しになるわけではありません。"
  ],
  rules: [
    "pubはlet、fn、effect fn、型、trait、独自演算子、foreignの宣言に使えます。公開letと通常の関数には型注釈を書きます。短いeffect fnは引数の型を記し、->、with、fails、whereをすべて省略した形なら結果のEffectを推論できます。公開する型の署名に非公開の型を漏らすことはできません。",
    "次のstruct Counterは、valueというIntの項目を持つ名前付きの型です。通常のpub structなら項目も外部へ公開しますが、pub opaque structは型の名前を公開し、中身を隠します。create 42でCounterを受け取った外部コードは値を保持・受け渡しできますが、Counter { value: 42 }による直接の構築やcounter.valueによる読み取りはできません。",
    "定義元のdomain.ssrgでは引き続き中身に触れます。公開関数createが値を作り、readが意図して用意した読み取り操作になります。下のmainはread counterによって42を表示します。opaqueはコンパイル時に許される操作の制限であり、暗号化や実行時のセキュリティー検査ではありません。",
    "複数の形から選ぶtypeの値を作る名前をコンストラクターと呼びます。通常の公開typeはそのコンストラクターも、公開newtypeはコンストラクターと包む型も公開します。これらにもopaqueを付けると、他モジュールからの構築やパターンによる分解を禁止できます。中身を公開するnewtypeは非公開の型を包めませんが、中身を隠すopaque newtypeなら内部で使えます。",
    "型に属するメソッドも既定では非公開です。外部から呼ぶメソッドには、それぞれpub fnを付けます。型そのものを公開しただけで、すべてのメソッドが公開されるわけではありません。",
    "traitは型に求める操作のまとまりで、instanceは特定の型でその操作を実装する宣言です。instance自体にはpubを付けません。直接importしたモジュールと、そこからさらにたどれるimport先のinstanceが、型検査時の候補になります。名前を指定してimportしても、instanceを一つだけ選んだり、別に隠したりはできません。"
  ],
  mistakes: [
    "次のmain.ssrgへ置き換えると、非公開のpunctuateをimportしようとしてPrivateExportで拒否されます。上のgreeting.ssrgはそのままです。公開されたgreetを取り込み、greet \"Aki\"を呼ぶ形へ戻してください。存在しない名前のimportは、非公開名とは別のMissingExportです。",
    "opaqueの例でも、利用側でcounter.valueを読むとSES-T0101になります。必要な情報は公開関数read counterを通して取り出してください。中身を変更できるかどうかは、型を公開したかどうかとは別に設計します。"
  ],
  related: [
    "呼び出し側で公開名を取り込む書き方を確認します。",
    "pubとは別に、外部パッケージへモジュールを公開する設定を調べます。",
    "型の名前と定義元を使って区別する規則を確認します。"
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "補助関数は隠したまま、必要な関数だけ公開するには",
  summary: "あいさつを作るgreetを公開し、末尾に!を付ける補助関数punctuateはファイル内だけで使います。宣言は既定で非公開で、pubを付けた名前だけを他のモジュールから使えます。",
  reading: "greeting.ssrgではpunctuateにpubがなく、greetにはpubがあります。greetの本体は同じファイルのpunctuateを呼べます。main.ssrgは公開されたgreetをimportし、greet \"Aki\"として使います。",
  result: "表示はHello, Aki!です。呼び出し側はpunctuateの名前や実装を使わずに、公開関数の結果を受け取れます。補助関数を変更しても、公開する引数と戻り値の約束を維持すれば呼び出し方は変わりません。",
}

pub fn setup -> String =
  "パネルの三つのファイルを同じプロジェクトへ置きます。src/greeting.ssrgとsrc/main.ssrgは同じディレクトリーです。seseragi.tomlを置いたフォルダーで、次のコマンドを実行してください。"

pub fn detailsTitle -> String = "型は渡せても、中身へ直接触れさせない"

pub fn mistakesTitle -> String = "非公開の名前は、名前を知っていても取り込めない"

pub fn title -> String = (copy ()).title
