import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Visibility and opaque representations",
  summary: (explanation ()).summary,
  purpose: ["Publishing only the names a caller needs separates internal changes from changes to the caller's contract. As with an unexported TypeScript helper, a public function may call a private helper in its defining file."],
  exampleTitle: "Use a private helper through a public function",
  reading: [
    "fn greet name: String -> String accepts one string and returns a string. pub publishes that function; it does not also publish every name used in the body.",
    "pub effect fn main is the public entry that returns output work. The runner starts that work, and println writes the string and a newline. Importing greeting.ssrg is not itself a call to greet."
  ],
  rules: [
    "pub applies to let, fn, effect fn, types, traits, custom operators and foreign declarations. Annotate public lets and ordinary functions. The compact effect fn form may infer its returned Effect when parameter types are written and all of ->, with, fails and where are omitted. A public type signature cannot expose a private type.",
    "The next struct Counter is a named type with an Int field called value. Ordinary pub struct exposes its fields too; pub opaque struct publishes the type name while hiding its representation. External code receiving create 42 may keep and pass the Counter value, but cannot construct Counter { value: 42 } directly or read counter.value.",
    "The defining domain.ssrg can still access the representation. Its public create constructs a value, and read supplies a deliberate observation. The shown caller uses read counter to print 42. opaque restricts source-level operations during compilation; it is not encryption or a runtime security check.",
    "The names that build the alternatives of a type are called constructors. An ordinary public type exposes its constructors; a public newtype exposes its constructor and wrapped type. Adding opaque also blocks external construction and pattern-based deconstruction for those forms. A representation-exposing newtype cannot wrap a private type, while an opaque newtype may use one internally.",
    "Inherent methods are private by default too. Add pub fn to each method callers outside the module should use. Publishing the owner type does not publish every method.",
    "A trait groups operations required of a type; an instance implements them for a particular type. An instance has no pub modifier. Instances in directly imported modules and the modules reachable through their imports participate in typechecking. Named imports do not select individual instances or hide them separately."
  ],
  mistakes: [
    "Replacing main.ssrg with the following source tries to import private punctuate and is rejected as PrivateExport. Keep greeting.ssrg unchanged. Restore the import of public greet and the call greet \"Aki\". Importing a nonexistent name is the distinct MissingExport diagnostic.",
    "In the opaque example, reading counter.value from the caller produces SES-T0101. Use the public read counter operation instead. Which representation operations to expose is a separate decision from making the type name public."
  ],
  related: [
    "Review how a caller imports public declarations.",
    "Check the package export map, which controls module reachability separately from pub.",
    "See how a type is distinguished by its name and defining module."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "How do I publish a function while keeping its helpers private?",
  summary: "Publish greet while keeping punctuate, the helper that adds !, inside its file. Declarations are private by default; pub makes a declaration available to other modules.",
  reading: "punctuate in greeting.ssrg has no pub, but greet does. The body of greet can call punctuate in the same file. main.ssrg imports the public greet and calls greet \"Aki\".",
  result: "The output is Hello, Aki!. The caller receives the public function's result without using the helper's name or implementation. Changes to the helper need not change the call when the public parameter and result contract stays the same.",
}

pub fn setup -> String =
  "Put all three displayed files in one project. src/greeting.ssrg and src/main.ssrg are siblings. Run the commands below from the directory containing seseragi.toml."

pub fn detailsTitle -> String = "Pass a type without exposing its contents"

pub fn mistakesTitle -> String = "Knowing a private name does not make it importable"

pub fn title -> String = (copy ()).title
