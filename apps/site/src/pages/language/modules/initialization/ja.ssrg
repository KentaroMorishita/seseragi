import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "モジュールの初期化",
  summary: (explanation ()).summary,
  ruleTitle: "依存先を一度だけ初期化し、letをソース順に評価する",
  ruleBody: "まず依存先を初期化してから、それを使うモジュールを初期化します。各モジュールは一度だけ初期化します。同じファイル内のモジュール直下のletは、ソースに書いた順に計算します。関数や型の名前はその前から参照できますが、関数同士を相互再帰させる場合はrecにまとめる必要があります。",
  typingBody: "モジュールの関数は、letを計算する前に呼び出せる状態になります。letの右辺から、先のletと関数を参照できますが、後のletを直接参照することはできません。関数の本体から後のletを参照することはできます。ただし、その値の初期化が済んでから関数を呼ぶ必要があります。ローカル関数は宣言した位置から使えるため、別の規則です。",
  evaluationBody: "letの初期化中に関数を呼び、その関数が未初期化のletを読むと、SES-N0201で拒否されます。例では後のletを読む関数を定義していますが、呼ぶのはそのletの初期化が済んでからです。Effectを作っただけでは、記述した入出力は実行しません。",
  invalidTitle: "後の値を読む関数は、その値の初期化後に呼ぶ",
  invalidBody: "letの初期値から関数を呼ぶ場合、その関数が読むletも初期化済みである必要があります。参照を関数の中へ移すだけでは、呼ぶ順序の問題は解消しません。同じモジュールを複数箇所からimportしても、初期化は一度です。importはEffectを実行する操作でもありません。",
  diagnosticsBody: "初期化前の参照では、どのletの計算からどの関数を呼び、どの未初期化の値を読んだかを確認してください。foreignでpure-loadを指定した外部モジュールは初期化時に読み込みますが、task-loadなら最初のTask実行時まで待ちます。コンパイラやエディターが調べるだけで、外部コードを実行することはありません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "後で宣言する値を、関数から読んでもよいか",
  summary: "モジュールの値はソース順に初期化します。関数が後の値を参照していても、呼び出した時点でその値が初期化済みである必要があります。",
  reading: "readLaterはlaterを参照しています。firstが1、次にlaterが2になり、その後でresultがreadLaterを呼びます。呼ぶ時点ではlaterが準備済みなので、有効です。",
  result: "readLaterを呼んだ結果は2です。この呼び出しをlaterの初期化前へ移すと、まだ値がないlaterを読むためエラーになります。関数を宣言する位置ではなく、その関数を実際に呼ぶ位置を確認してください。"
}
