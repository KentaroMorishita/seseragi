import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  Article,
  CodeExample,
  Heading,
  PageDefinition,
  Terminal
} from "../../../../model/page"
import { ReaderCopy } from "../../reader-article"
import { paragraphs, related } from "../blocks"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition = {
  let english: ReaderCopy = en.copy ()
  let japanese: ReaderCopy = ja.copy ()
  PageDefinition {
    id: "language.modules.initialization",
    path: "/docs/language/modules/initialization/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        CodeExample (
          "modules-project-initialization-manifest",
          localized "seseragi.toml" "seseragi.toml"
        ),
        CodeExample (
          "modules-project-initialization-summary",
          localized "src/summary.ssrg" "src/summary.ssrg"
        ),
        CodeExample (
          "modules-project-initialization-main",
          localized "src/main.ssrg" "src/main.ssrg"
        )
      ],
      [Terminal (
        localized "Run from this project’s root" "このプロジェクトのルートで実行",
        "seseragi lock update .\nseseragi run .\n"
      )],
      [Terminal (localized "Output" "実行結果", "42\n")],
      [Heading (
        "rule",
        localized "Prepare dependencies before their consumers" "利用側より先に、依存先の値を用意する"
      )],
      paragraphs english.purpose japanese.purpose,
      [Heading (
        "reading-the-files",
        localized "Follow the value from summary to main" "summaryからmainへ値を追う"
      )],
      paragraphs english.reading japanese.reading,
      [Heading (
        "evaluation",
        localized "Source order and function availability" "値を作る順序と、関数を呼べる時期"
      )],
      paragraphs english.rules japanese.rules,
      [Heading (
        "diagnostics",
        localized "The function exists, but its value is not ready"
          "関数は使えても、読む値がまだ用意されていない"
      )],
      paragraphs english.mistakes japanese.mistakes,
      [
        CodeExample (
          "modules-project-early-read-manifest",
          localized "early-read/seseragi.toml" "early-read/seseragi.toml"
        ),
        CodeExample (
          "modules-project-early-read-main",
          localized "early-read/src/main.ssrg" "early-read/src/main.ssrg"
        )
      ],
      [Terminal (
        localized "Check this separate project from its root" "この別プロジェクトのルートで検査",
        "seseragi lock update .\nseseragi run .\n"
      )],
      [Terminal (
        localized "Relevant diagnostic text (before execution)" "診断の該当部分（実行前）",
        "SES-N0201\nTop-level initializer reads a value before it is initialized\nlater is not initialized before this call\n"
      )],
      [Heading (
        "typing",
        localized "Repair the order without moving the function" "関数を動かさず、初期化の順序を直す"
      )],
      [
        CodeExample (
          "modules-project-ordered-read-manifest",
          localized "ordered-read/seseragi.toml" "ordered-read/seseragi.toml"
        ),
        CodeExample (
          "modules-project-ordered-read-main",
          localized "ordered-read/src/main.ssrg" "ordered-read/src/main.ssrg"
        )
      ],
      [Terminal (
        localized "Run from this project’s root" "このプロジェクトのルートで実行",
        "seseragi lock update .\nseseragi run .\n"
      )],
      [Terminal (localized "Output" "実行結果", "42\n")],
      [Heading ("foreign-loading", localized (en.loaderTitle ()) (ja.loaderTitle ()))],
      paragraphs (en.loader ()) (ja.loader ()),
      [Heading ("related-rules", localized "Questions to explore next" "次に調べたいこと")],
      related english.related japanese.related [
        (localized "Evaluation order" "評価順序", "/docs/language/expressions/evaluation/"),
        (
          localized "Blocks and local declarations" "ブロックとローカル宣言",
          "/docs/language/expressions/blocks-and-local-declarations/"
        ),
        (
          localized "Executable entry points" "実行入口",
          "/docs/language/modules/entry-points/"
        )
      ]
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
