import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "Module specifier resolution",
  summary: (explanation ()).summary,
  purpose: ["You can determine where code comes from by checking the importing file and its explicit path. TypeScript resolution varies with configuration and runtime; do not assume those search rules apply to Seseragi."],
  exampleTitle: "Name a file inside a directory explicitly",
  reading: [
    "The string in an import is called its module specifier. A relative path starts from the importing source file, not the shell working directory. Moving the shell to another directory does not make the same import silently select another file.",
    "pub fn greet name: String -> String declares a public function accepting and returning strings. pub effect fn main is an entry returning output work; the runner executes println. No separate module-name declaration is needed inside these files."
  ],
  rules: [
    "./ and ../ are relative to the current module. ./user selects exactly the sibling user.ssrg. Writing .ssrg explicitly normalizes to the same module. The resolver does not try directory indexes, alternative extensions, or the shell working directory as fallbacks.",
    "self/ selects ordinary source in the current package. For example, self/words/index selects src/words/index.ssrg. std/ selects the standard library, and gen/ selects generated bindings. These forms classify a specifier; they are not fallback choices tried in sequence.",
    "Other names select a manifest-declared direct dependency and its public subpath. If docs/greetings exports email, docs/greetings/email selects that exported module. Knowing a path inside the dependency's repository does not make it importable.",
    "For a dependency alias, use the declared dependency name as the prefix. A package may use its own name through its exports map without declaring itself as a dependency. That public path differs from package-private source access through self/. Relative imports cannot cross between ordinary source, test and generated roots.",
    "No candidate is an error, and multiple candidates are an error rather than an arbitrary selection. For a relative path, check the importing file and actual target. For an external package, check the direct dependency and its exports map."
  ],
  mistakes: [
    "With the layout above, changing main.ssrg to the following source produces SES-K0001: ./words selects src/words.ssrg, which does not exist. Compare the path in the diagnostic with the src/words/index.ssrg file you created.",
    "Restore \"./words/index\" to print Hello, Aki!. Moving the source to words.ssrg is another option, but changes the layout itself. A private package path or undeclared dependency requires fixing the package contract, not merely spelling a filename differently."
  ],
  related: [
    "Check direct dependency declarations and exported package paths.",
    "Review the forms for importing public functions and types.",
    "See when different path spellings identify one module."
  ],
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "Which file does an import string select?",
  summary: "Put a greeting function in words/index.ssrg and use it from main.ssrg. Seseragi selects an explicitly named file; it does not infer index.ssrg from a directory name.",
  reading: "\"./words/index\" in main.ssrg selects words/index.ssrg under the same src directory. pub on greet makes it importable. greet \"Aki\" passes the argument, and println displays the returned string.",
  result: "The output is Hello, Aki!. Including the extension, \"./words/index.ssrg\", selects the same file. In contrast, \"./words\" asks for words.ssrg, which does not exist in this layout.",
}

pub fn setup -> String =
  "Create all three files in an empty directory. Alongside src/main.ssrg, create the src/words directory and place index.ssrg inside it. Run the commands below from the directory containing seseragi.toml."

pub fn detailsTitle -> String = "The leading form chooses the kind of target"

pub fn mistakesTitle -> String = "./words does not mean words/index.ssrg"

pub fn title -> String = (copy ()).title
