import * as arrays from "std/array"
import { explainPage } from "../../explanation"
import * as guide from "./guide"
import { localized } from "../../../../model/locale"
import {
  Article,
  CodeExample,
  Heading,
  PageDefinition,
  Terminal
} from "../../../../model/page"
import { ReaderCopy } from "../../reader-article"
import { paragraphs, related } from "../blocks"
import * as en from "./en"
import * as ja from "./ja"

fn content -> PageDefinition = {
  let english: ReaderCopy = en.copy ()
  let japanese: ReaderCopy = ja.copy ()
  PageDefinition {
    id: "language.modules.entry-points",
    path: "/docs/language/modules/entry-points/",
    kind: Article,
    title: localized english.title japanese.title,
    summary: localized english.summary japanese.summary,
    blocks: arrays.concat [
      [
        CodeExample (
          "modules-project-named-import-manifest",
          localized "seseragi.toml" "seseragi.toml"
        ),
        CodeExample (
          "modules-project-named-import-greeting",
          localized "src/greeting.ssrg" "src/greeting.ssrg"
        ),
        CodeExample
          ("modules-project-named-import-main", localized "src/main.ssrg" "src/main.ssrg")
      ],
      [Terminal (
        localized "Run from this project’s root" "このプロジェクトのルートで実行",
        "seseragi lock update .\nseseragi run .\n"
      )],
      [Terminal (localized "Output" "実行結果", "Hello, Aki!\n")],
      [Heading
          ("rule", localized "Select the application’s starting point" "アプリケーションの開始位置を選ぶ")],
      paragraphs english.purpose japanese.purpose,
      [Heading (
        "reading-the-files",
        localized "From the manifest to the greeting" "設定ファイルから挨拶の出力までを読む"
      )],
      paragraphs english.reading japanese.reading,
      [Heading (
        "entry-contract",
        localized "One public main; libraries can omit it" "公開mainは一つ、ライブラリには不要"
      )],
      paragraphs english.rules japanese.rules,
      [Heading ("typing", localized (en.servicesTitle ()) (ja.servicesTitle ()))],
      paragraphs (en.services ()) (ja.services ()),
      [Heading ("evaluation", localized (en.failuresTitle ()) (ja.failuresTitle ()))],
      paragraphs (en.failures ()) (ja.failures ()),
      [Heading (
        "diagnostics",
        localized "An integer success value is not an exit code" "整数の成功値を、終了コードとしては使えない"
      )],
      paragraphs english.mistakes japanese.mistakes,
      [
        CodeExample (
          "modules-project-entry-int-manifest",
          localized "entry-int/seseragi.toml" "entry-int/seseragi.toml"
        ),
        CodeExample (
          "modules-project-entry-int-main",
          localized "entry-int/src/main.ssrg" "entry-int/src/main.ssrg"
        )
      ],
      [Terminal (
        localized "Check this separate project from its root" "この別プロジェクトのルートで検査",
        "seseragi lock update .\nseseragi run .\n"
      )],
      [Terminal (
        localized "Entry diagnostic (before execution)" "入口の診断（実行前）",
        "invalid entry point: `main` must succeed with Unit\n"
      )],
      [Heading ("imported-main", localized (en.importedTitle ()) (ja.importedTitle ()))],
      paragraphs (en.imported ()) (ja.imported ()),
      [
        CodeExample (
          "modules-project-initialization-manifest",
          localized "initialization/seseragi.toml" "initialization/seseragi.toml"
        ),
        CodeExample (
          "modules-project-initialization-summary",
          localized "initialization/src/summary.ssrg" "initialization/src/summary.ssrg"
        ),
        CodeExample (
          "modules-project-initialization-main",
          localized "initialization/src/main.ssrg" "initialization/src/main.ssrg"
        )
      ],
      [Terminal (
        localized "Run from this project’s root" "このプロジェクトのルートで実行",
        "seseragi lock update .\nseseragi run .\n"
      )],
      [Terminal (localized "Output" "実行結果", "42\n")],
      [Heading ("related-rules", localized "Questions to explore next" "次に調べたいこと")],
      related english.related japanese.related [
        (
          localized "Programs and entry points" "プログラムと実行入口",
          "/docs/language/model/programs/"
        ),
        (
          localized "Effect runtime boundaries" "Effectを実行する境界",
          "/docs/language/effects/runtime-boundaries/"
        ),
        (
          localized "Module initialization" "モジュールの初期化",
          "/docs/language/modules/initialization/"
        )
      ]
    ]
  }
}

pub fn page -> PageDefinition = explainPage (guide.explanation ()) (content ())
