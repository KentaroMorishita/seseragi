import { ExplanationCopy } from "../../explanation"
import { ReaderCopy } from "../../reader-article"

pub fn copy -> ReaderCopy = ReaderCopy {
  title: "実行入口",
  summary: (explanation ()).summary,
  purpose: [
    "ファイルに関数を書いただけでは、どの関数をアプリケーションとして開始するかは決まりません。実行可能なパッケージは、seseragi.tomlで入口のモジュールを選び、その公開mainを一つ使います。",
    "ここではgreeting.ssrgを再利用する関数のファイル、main.ssrgを出力の入口として分けます。ライブラリ側の関数を使うことと、アプリケーションを開始することが別々に読めます。",
  ],
  exampleTitle: "設定ファイルからmainを選び、挨拶を出力する",
  reading: [
    "seseragi.tomlのpackageはプロジェクトの名前、バージョン、対応する言語バージョンを指定します。runのentry = \"main\"は、標準のsrcフォルダーから見たmain.ssrgを選びます。設定内のモジュールパスには.ssrgを書きません。target = \"process\"は実行先をプロセスにする指定です。",
    "greeting.ssrgのpub fn greet name: String -> Stringは、文字列の引数nameを受け取り文字列を返す公開関数です。=の後の式が戻り値です。\"Hello, \"、name、\"!\"を+でつなぎ、greet \"Aki\"ならHello, Aki!を返します。",
    "main.ssrgはimport { greet } from \"./greeting\"で同じフォルダーの公開関数を取り込みます。greet \"Aki\"はスペースの後に引数を渡す呼び出しです。括弧はその戻り値をprintlnへ渡すために式をまとめています。",
    "pub effect fn mainは、実行入口として公開する関数です。Effectは、後で実行する入出力などを表す値です。短いeffect fnの形式では、成功値、必要なサービス、失敗の型を本体から推論します。この本体のprintlnは挨拶と改行を出力する処理を表します。",
    "実行機構は依存するモジュールの初期化を終えてから、選んだmainへUnitの値()を一度渡します。mainが返したEffectへ必要なサービスを供給して実行します。printlnが成功すると、追加の結果を持たないUnitの値()で完了します。",
  ],
  rules: [
    "入口のモジュールには公開mainが一つ必要です。pub effect fn main -> Unit with AppEnv fails AppErrorという明示形式は、Unit -> Effect<AppEnv, AppError, Unit>という関数の型を表します。AppEnvは必要なサービス、AppErrorは通常の失敗、最後のUnitは成功時の結果です。ここでのAppEnvとAppErrorは説明用の型名であり、組み込みのサービス名ではありません。",
    "ライブラリのパッケージにはmainもrun設定も不要です。run設定のないパッケージをアプリケーションとして実行しようとするとエラーになります。一つのパッケージがexportsとrunを両方持ち、ライブラリとアプリケーションを兼ねることもできます。",
    "他のモジュールをimportしただけで、そのモジュールのmainを暗黙に呼びません。下のinitializationプロジェクトではsummary.ssrgにも公開mainがありますが、設定が選ぶのはsrc/main.ssrgだけです。",
  ],
  mistakes: [
    "次のentry-intプロジェクトは、mainの成功値を整数にしているため拒否されます。import * as effects from \"std/effect\"はEffectを作る標準の関数をeffectsという名前で参照する指定です。effects.succeed 42は、成功すると42を返すEffectを作ります。ここには必要な定義がすべてあっても、入口の成功値はUnitでなければなりません。",
    "42を終了コードとして返す用途には使えません。値を表示したいなら、最初の完全なプロジェクトのようにprintlnで出力し、そのEffectをmainから返します。printlnの成功値はUnitなので入口の条件を満たします。",
  ],
  related: [
    "プログラムの開始と、値や関数の定義の関係を確認できます。",
    "返したEffectを実行する境界と、後片付けの扱いを詳しく確認できます。",
    "入口を呼ぶ前に、import先の値を用意する順番を確認できます。",
  ],
}

pub fn title -> String = (copy ()).title

pub fn servicesTitle -> String = "必要なサービスと型は、実行前に確定させる"

pub fn services -> Array<String> = [
  "サービスとは、出力先など、Effectが実行環境へ要求する機能です。AppEnvのような必要条件は、必須のサービス名とその型がすべて決まったレコードで表します。これを閉じた構造的レコードと呼びます。型パラメーターを残したmain、未確定の型変数、フィールドの集合が決まらない必要条件は、入口にできません。",
  "実行環境は余分なサービスを持っていても構いません。ただし、必要なフィールドを省いたり、違う型のサービスを渡したりはできません。選んだターゲットが提供できなければ、実行前に診断します。名前だけでサービスを実行時に検索して補う仕組みではありません。",
  "アプリケーション独自のサービスを標準の実行環境が用意しない場合、mainが返すEffectを組み立てる時点でprovideを使って実際のサービスを供給します。この例の出力は標準のConsoleを使い、processターゲットが提供できます。",
]

pub fn failuresTitle -> String = "失敗の表示と終了状態は、実行機構が扱う"

pub fn failures -> Array<String> = [
  "失敗の型も具体的に決まっている必要があります。Neverは、通常の失敗が起きないことを表す型です。それ以外の失敗型には、値を表示用の文字列へ変えるShowの実装が必要です。入口からimportをたどって到達するモジュールの範囲で、矛盾しない一つの実装を解決できなければビルドエラーです。",
  "実行機構がShowで表示するのは、この型で表された通常の失敗です。予期しない実行上の障害とキャンセルは別の終了理由であり、通常のAppErrorへ置き換えません。入口の検査では、公開名、関数の型、確定したサービスと失敗の型、失敗を表示する実装を個別に確認します。",
  "mainの成功値はUnitだけです。アプリケーションからプロセスを直接終了するexit操作も、任意の整数を終了コードとして返す入口の別形式もありません。終了状態は、成功、通常の失敗、予期しない障害、キャンセル、プロセスのシグナルなどに応じて実行機構が決めます。通常のコードから後片付けを飛ばして終了しないための境界です。",
]

pub fn importedTitle -> String = "別のファイルにもmainがあってよい"

pub fn imported -> Array<String> = [
  "この別プロジェクトでは、summary.ssrgのdoubleは整数を2倍にし、answerを42へ初期化します。report ()は出力を表すEffectをpendingへ保存するだけです。summary.ssrgのmainも定義されますが、設定の入口はmain.ssrgなので自動で呼ばれません。",
  "main.ssrgはanswerだけを取り込み、showで文字列へ変えてprintlnで出力します。実行結果は42と改行だけです。stored Effect must not runとimported main must not runは出力されません。",
]

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "seseragi runは、どのファイルのどの関数を実行するのか",
  summary: "設定ファイルが選んだモジュールの公開mainから開始します。mainは実行するEffectを返し、その成功値はUnitです。",
  reading: "この三つのファイルを保存すると、entry = \"main\"がsrc/main.ssrgを入口に選びます。greeting.ssrgのgreetが挨拶を作り、mainのprintlnがそれを出力するEffectを返します。",
  result: "プロジェクトのルートでseseragi lock update .、続いてseseragi run .を実行すると、Hello, Aki!と改行が出力されます。呼ばれるのは選択された公開mainです。greetの定義をimportすること自体が、出力を開始するわけではありません。",
}
