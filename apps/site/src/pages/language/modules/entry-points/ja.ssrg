import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "実行入口",
  summary: "プログラムを開始するときに呼ばれる、公開されたmain関数の条件を説明します。",
  ruleTitle: "実行するモジュールとmainを選ぶ",
  ruleBody: "実行可能なパッケージでは、seseragi.tomlに入口のモジュールを指定します。そのモジュールの公開mainが実行入口です。pub effect fn main -> Unit with AppEnv fails AppErrorは、()を受け取りEffect<AppEnv, AppError, Unit>を返す関数です。実行環境がmainを呼び、返ったEffectに必要なサービスを渡して実行します。importするだけではmainは呼ばれません。",
  typingBody: "入口には未確定の型パラメーターを残せません。AppEnvは、必要なサービスの名前と型が決まったレコードである必要があります。実行環境は追加のフィールドを持つレコードを渡せますが、必要なフィールドを省けません。標準の実行環境が用意しない独自サービスは、provideでEffectへ供給してから実行入口の結果にします。",
  evaluationBody: "失敗の型も具体的でなければなりません。失敗しないNever以外の型には、失敗内容を表示するShowの実装が必要です。実行結果はUnitです。ライブラリのパッケージは、mainを持たなくても他のパッケージから使えます。",
  invalidTitle: "mainから整数を返して終了コードを指定する形式はない",
  invalidBody: "終了状態は、成功、型付きの失敗、予期しない障害、キャンセルなどに応じて実行環境が決めます。アプリケーションのmainで整数を返す形式はありません。また、キャンセルや予期しない障害を、通常のAppErrorへ置き換える必要もありません。",
  diagnosticsBody: "mainにpubがあるか、戻り値がUnitか、サービスと失敗の型が確定しているか、失敗を表示するShowがあるかを確認してください。例では標準のConsoleを使います。選んだターゲットが提供しないサービスを、実行時に名前だけで探して補うことはありません。",
}
