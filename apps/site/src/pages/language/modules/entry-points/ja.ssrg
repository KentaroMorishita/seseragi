import { ExplanationCopy } from "../../explanation"
import { ReferenceCopy } from "../../reference-article"

pub fn copy -> ReferenceCopy = ReferenceCopy {
  title: "実行入口",
  summary: (explanation ()).summary,
  ruleTitle: "実行するモジュールとmainを選ぶ",
  ruleBody: "実行可能なパッケージでは、seseragi.tomlに入口のモジュールを指定します。そのモジュールの公開mainが実行入口です。pub effect fn main -> Unit with AppEnv fails AppErrorは、()を受け取りEffect<AppEnv, AppError, Unit>を返す関数です。実行環境がmainを呼び、返ったEffectに必要なサービスを渡して実行します。importするだけではmainは呼ばれません。",
  typingBody: "入口では、型パラメーターと必要なサービスの型がすべて決まっている必要があります。AppEnvは、必須のサービス名と型を列挙したレコードです。実行環境に余分なフィールドがあっても構いませんが、必要なフィールドは省けません。標準の実行環境が用意しない独自サービスは、provideで供給したEffectをmainから返します。",
  evaluationBody: "失敗の型も具体的でなければなりません。失敗しないNever以外の型には、失敗内容を表示するShowの実装が必要です。実行結果はUnitです。ライブラリのパッケージは、mainを持たなくても他のパッケージから使えます。",
  invalidTitle: "mainから整数を返して終了コードを指定する形式はない",
  invalidBody: "終了状態は、成功、回復可能な失敗、予期しない障害、キャンセルなどに応じて実行環境が決めます。mainから整数を返して終了コードを指定する形式はありません。キャンセルや予期しない障害は通常のAppErrorとは別に扱い、AppErrorへ置き換えないでください。",
  diagnosticsBody: "mainにpubがあるか、戻り値がUnitか、サービスと失敗の型が確定しているか、失敗を表示するShowがあるかを確認してください。例では標準のConsoleを使います。選んだターゲットが提供しないサービスを、実行時に名前だけで探して補うことはありません。",
}

pub fn explanation -> ExplanationCopy = ExplanationCopy {
  question: "実行時に、最初に呼ばれる関数はどれか",
  summary: "実行可能なパッケージは、公開mainを持つモジュールを入口に選びます。mainは、成功値がUnitのEffectを返します。",
  reading: "pubはmainを実行機構から使えるように公開します。effect fnはEffectを返し、with Consoleとfails ConsoleErrorが出力サービスと失敗の可能性を表します。printlnはメッセージと改行を出力する処理です。",
  result: "実行するとHello, Seseragi!と改行を出力し、Unitの値()で完了します。実行するのは、指定した入口モジュールの公開mainです。他のモジュールからimportするだけではmainを呼びません。ライブラリとして使うパッケージにはmainが不要です。"
}
