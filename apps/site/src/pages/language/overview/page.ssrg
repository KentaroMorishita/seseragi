import { localized } from "../../../model/locale"
import { DocumentationLanding, PageDefinition } from "../../../model/page"
import * as en from "./en"
import * as ja from "./ja"

pub fn page -> PageDefinition = PageDefinition {
  id: "language.overview",
  path: "/docs/language/",
  kind: DocumentationLanding,
  title: localized (en.title ()) (ja.title ()),
  summary: localized (en.summary ()) (ja.summary ()),
  blocks: []
}
