fn languageArea -> NavigationArea = NavigationArea {
  id: "language",
  title: localized "Language Reference" "Language Reference",
  description: localized
    "Understand each language concept, then inspect its exact rules."
    "概念を理解してから、正確な言語規則まで辿れます。",
  landing: languageOverviewPage (),
  groups: [
    NavigationGroup {
      id: "orientation",
      title: localized "Understand Seseragi" "Seseragiを理解する",
      sections: [
        NavigationSection {
          id: "language-model",
          title: localized "The language model" "言語model",
          kind: FlatSection,
          overview: whatIsSeseragiPage (),
          pages: [programsPage (), nonFeaturesPage ()]
        },
        NavigationSection {
          id: "design-principles",
          title: localized "Design principles" "設計原則",
          kind: FlatSection,
          overview: designPrinciplesPage (),
          pages: [
            expressionOrientedPage (),
            immutableByDefaultPage (),
            noHiddenDangerPage (),
            backendIndependentSemanticsPage (),
            diagnosableBehaviorPage (),
            visibleCostsPage (),
            readableDensityPage ()
          ]
        }
      ]
    },
    NavigationGroup {
      id: "source-and-syntax",
      title: localized "Source and syntax" "sourceと構文",
      sections: [
        NavigationSection {
          id: "source-forms",
          title: localized "Reading source" "sourceを読む",
          kind: FlatSection,
          overview: sourceTextPage (),
          pages: [
            literalsPage (),
            characterStringEscapesPage (),
            layoutLineContinuationPage ()
          ]
        },
        NavigationSection {
          id: "names-and-fields",
          title: localized "Names and fields" "nameとfield",
          kind: FlatSection,
          overview: reservedWordsPage (),
          pages: [optionalRecordFieldsPage ()]
        }
      ]
    },
    NavigationGroup {
      id: "functions-and-operators",
      title: localized "Functions and operators" "関数とoperator",
      sections: [
        NavigationSection {
          id: "calling-functions",
          title: localized "Calling functions" "関数を呼び出す",
          kind: FlatSection,
          overview: functionApplicationPage (),
          pages: [methodCallsPage (), pipelinesPage ()]
        },
        NavigationSection {
          id: "operators",
          title: localized "Operators" "operator",
          kind: FlatSection,
          overview: operatorPrecedencePage (),
          pages: [customOperatorsPage ()]
        }
      ]
    },
    NavigationGroup {
      id: "types",
      title: localized "Types" "型",
      sections: [
        NavigationSection {
          id: "understanding-types",
          title: localized "Understanding types" "型を理解する",
          kind: FlatSection,
          overview: typeSystemPage (),
          pages: [
            builtInTypesPage (),
            typeConstructorsPage (),
            annotationsInferencePage (),
            polymorphismPage ()
          ]
        },
        NavigationSection {
          id: "data-shapes",
          title: localized "Nominal and structural data" "nominal・structural data",
          kind: FlatSection,
          overview: nominalStructuralPage (),
          pages: [
            optionalRecordTypePage (),
            closedRecordsPage (),
            requirementMergePage ()
          ]
        },
        NavigationSection {
          id: "function-and-recursive-types",
          title: localized "Functions and recursion" "関数と再帰",
          kind: FlatSection,
          overview: functionTypesPage (),
          pages: [identityCoercionPage (), recursiveDeclarationsPage ()]
        }
      ]
    },
    NavigationGroup {
      id: "expressions",
      title: localized "Expressions" "式",
      sections: [
        NavigationSection {
          id: "evaluation-and-scope",
          title: localized "Evaluation and local scope" "評価とlocal scope",
          kind: FlatSection,
          overview: evaluationPage (),
          pages: [blocksLocalPage (), conditionalsPage (), lambdasPage ()]
        },
        NavigationSection {
          id: "ranges-and-comprehensions",
          title: localized "Ranges and comprehensions" "rangeとcomprehension",
          kind: FlatSection,
          overview: rangesComprehensionsPage (),
          pages: []
        }
      ]
    },
    NavigationGroup {
      id: "data",
      title: localized "Data" "データ",
      sections: [
        NavigationSection {
          id: "nominal-data",
          title: localized "Nominal data" "名前を持つデータ型",
          kind: FlatSection,
          overview: algebraicDataTypesPage (),
          pages: [structsPage (), newtypesPage ()]
        },
        NavigationSection {
          id: "structural-and-collection-data",
          title: localized "Structural and collection data" "構造的データとコレクション",
          kind: FlatSection,
          overview: recordsPage (),
          pages: [tuplesArraysListsPage ()]
        },
        NavigationSection {
          id: "methods-and-operators",
          title: localized "Methods and operator overloads" "メソッドと演算子オーバーロード",
          kind: FlatSection,
          overview: implsMethodsPage (),
          pages: [operatorOverloadsPage ()]
        }
      ]
    },
    NavigationGroup {
      id: "patterns",
      title: localized "Patterns" "パターン",
      sections: [NavigationSection {
        id: "binding-and-matching",
        title: localized "Binding and matching" "束縛とパターン照合",
        kind: FlatSection,
        overview: bindingRulesPage (),
        pages: [irrefutablePatternsPage (), matchPage ()]
      }]
    },
    NavigationGroup {
      id: "traits-and-abstraction",
      title: localized "Traits and abstraction" "traitと抽象",
      sections: [
        NavigationSection {
          id: "trait-evidence",
          title: localized "Traits and evidence" "traitとevidence",
          kind: FlatSection,
          overview: traitModelPage (),
          pages: [
            traitDeclarationsPage (),
            traitInstancesPage (),
            traitConstraintsPage (),
            traitMethodCallsPage ()
          ]
        },
        NavigationSection {
          id: "coherence-and-contracts",
          title: localized "Coherence and contracts" "coherenceとcontract",
          kind: FlatSection,
          overview: traitCoherencePage (),
          pages: [
            traitStandardOperatorsPage (),
            traitLawsPage (),
            traitDerivingPage (),
            methodsVersusTraitsPage ()
          ]
        },
        NavigationSection {
          id: "do-notation",
          title: localized "Do notation" "do記法",
          kind: FlatSection,
          overview: doNotationPage (),
          pages: [doDesugaringPage (), doBlockTypingPage ()]
        }
      ]
    },
    NavigationGroup {
      id: "effects-and-failure",
      title: localized "Effects and failure" "Effectとfailure",
      sections: [
        NavigationSection {
          id: "values-and-computations",
          title: localized "Values and computations" "値と計算",
          kind: FlatSection,
          overview: pureExpressionsPage (),
          pages: [maybePage (), eitherPage (), effectTypePage ()]
        },
        NavigationSection {
          id: "effect-programs",
          title: localized "Writing Effect programs" "Effect programを書く",
          kind: FlatSection,
          overview: effectContractFormPage (),
          pages: [
            effectInferredFormPage (),
            effectfulForPage (),
            environmentRequirementsPage (),
            effectErrorChannelsPage (),
            taskPage ()
          ]
        },
        NavigationSection {
          id: "effect-execution",
          title: localized "Execution and faults" "実行と異常終了",
          kind: FlatSection,
          overview: sequentialParallelPage (),
          pages: [runtimeBoundariesPage (), defectsPage ()]
        }
      ]
    }
  ]
}

fn libraryArea input: BuildInput -> NavigationArea = NavigationArea {
  id: "library",
  title: localized "Standard Library" "標準ライブラリ",
  description: localized "Look up modules and public symbols." "moduleと公開symbolを調べられます。",
  landing: libraryOverviewPage (),
  groups: referenceGroups input.referenceModules
}

fn sectionPages section: NavigationSection -> Array<PageDefinition> = arrays.concat [
  [section.overview],
  section.pages
]

fn groupPages group: NavigationGroup -> Array<PageDefinition> =
  arrays.concat [sectionPages section | section <- group.sections]

fn areaPages area: NavigationArea -> Array<PageDefinition> = arrays.concat [
  [area.landing],
  arrays.concat [groupPages group | group <- area.groups]
]

pub fn catalog input: BuildInput -> SiteCatalog = {
  let home = homePage ()
  let areas = [languageArea (), libraryArea input]
  SiteCatalog {
    home,
    areas,
    pages: arrays.concat [
      [home, docsOverviewPage (), examplesPage (), releasesPage ()],
      arrays.concat [areaPages area | area <- areas]
    ]
  }
}
