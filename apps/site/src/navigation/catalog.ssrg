import { BuildInput } from "../model/build"
import { localized } from "../model/locale"
import {
  FlatSection,
  NavigationArea,
  NavigationGroup,
  NavigationSection,
  SiteCatalog
} from "../model/page"
import * as entrance from "../pages/entrance"
import * as compositionChapter from "../pages/composition"
import * as effects from "../pages/effects"
import * as types from "../pages/types"
import * as signals from "../pages/signals"
import * as api from "../pages/api"
import * as arrays from "std/array"
import { page as application } from "../pages/language/syntax/function-application/page"
import { page as currying } from "../pages/language/types/function-types-and-currying/page"
import { page as composition } from "../pages/language/syntax/pipelines-and-low-precedence-application/page"

pub fn catalog input: BuildInput -> SiteCatalog = {
  let home = entrance.home ()
  let first = application ()
  let second = currying ()
  let third = composition ()
  let landing = entrance.language ()
  let area = NavigationArea {
    id: "language",
    title: localized "Functions and notation" "関数と記法",
    description: localized
      "Start with a search key. Keep a condition, then connect the calls."
      "検索用の文字列を作るところから。条件を手元に残し、呼び出しをつないでみよう。",
    landing,
    groups: [NavigationGroup {
      id: "functions-and-notation",
      title: localized "Three small steps" "三つの小さな段階",
      sections: [NavigationSection {
        id: "functions",
        title: localized "Functions and notation" "関数と記法",
        kind: FlatSection,
        overview: first,
        pages: [second, third]
      }]
    }]
  }
  SiteCatalog {
    home,
    areas: [area, types.area (), compositionChapter.area (), effects.area (), signals.area (), api.area input],
    pages: arrays.concat [[
      home,
      entrance.docs (),
      entrance.firstRun (),
      entrance.examples (),
      entrance.releases (),
      landing,
      first,
      second,
      third,
      api.index input
    ], types.pages (), compositionChapter.pages (), effects.pages (), signals.pages (), api.pages input]
  }
}
