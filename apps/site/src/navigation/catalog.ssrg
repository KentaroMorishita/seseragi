import { page as expressionOrientedPage } from "../pages/language/model/expression-oriented/page"
import { page as immutableByDefaultPage } from "../pages/language/model/immutable-by-default/page"
import { page as noHiddenDangerPage } from "../pages/language/model/no-hidden-danger/page"
import { page as backendIndependentSemanticsPage } from "../pages/language/model/backend-independent-semantics/page"
import { page as diagnosableBehaviorPage } from "../pages/language/model/diagnosable-behavior/page"
import { page as visibleCostsPage } from "../pages/language/model/visible-costs/page"
import { page as readableDensityPage } from "../pages/language/model/readable-density/page"
import { page as programsPage } from "../pages/language/model/programs/page"
import { page as nonFeaturesPage } from "../pages/language/model/non-features/page"
import { page as functionApplicationPage } from "../pages/language/syntax/function-application/page"
import { page as methodCallsPage } from "../pages/language/syntax/method-calls/page"
import { page as pipelinesPage } from "../pages/language/syntax/pipelines-and-low-precedence-application/page"
import { page as operatorPrecedencePage } from "../pages/language/syntax/operator-precedence/page"
import { page as customOperatorsPage } from "../pages/language/syntax/custom-operators/page"
import { page as reservedWordsPage } from "../pages/language/syntax/reserved-words-and-names/page"
import { page as optionalRecordFieldsPage } from "../pages/language/syntax/optional-record-fields/page"
import { page as sourceTextPage } from "../pages/language/syntax/source-text/page"
import { page as literalsPage } from "../pages/language/syntax/literals/page"
import { page as characterStringEscapesPage } from "../pages/language/syntax/character-string-escapes/page"
import { page as layoutLineContinuationPage } from "../pages/language/syntax/layout-and-line-continuation/page"
import { page as typeSystemPage } from "../pages/language/types/type-system/page"
import { page as builtInTypesPage } from "../pages/language/types/built-in-types/page"
import { page as typeConstructorsPage } from "../pages/language/types/type-constructors/page"
import { page as annotationsInferencePage } from "../pages/language/types/annotations-and-inference/page"
import { page as polymorphismPage } from "../pages/language/types/polymorphism/page"
import { page as libraryOverviewPage } from "../pages/library/overview/page"
import { page as examplesPage } from "../pages/examples/page"
import { page as releasesPage } from "../pages/releases/page"
import { referenceGroups } from "../reference/catalog"

fn getStartedArea -> NavigationArea = {
  let overview = getStartedOverviewPage ()
  NavigationArea {
    id: "get-started",
    title: localized "Get Started" "Get Started",
    description: localized
      "Install the toolchain and take one verified program through run, test and production build."
      "toolchainの導入から実行・test・production buildまでを進めます。",
    landing: overview,
    groups: [NavigationGroup {
      id: "journey",
      title: localized "Guide" "ガイド",
      sections: [NavigationSection {
        id: "first-project",
        title: localized "First project" "最初のproject",
        kind: FlatSection,
        overview: installPage (),
        pages: [
          helloSeseragiPage (),
          createProjectPage (),
          projectLayoutPage (),
          runPage (),
          formatAndCheckPage (),
          testPage (),
          productionBuildPage (),
          webApplicationPage (),
          nextPage ()
        ]
      }]
    }]
  }
}

fn languageArea -> NavigationArea = NavigationArea {
  id: "language",
  title: localized "Language Reference" "Language Reference",
  description: localized "Syntax and semantics, one concept per page."
    "構文と意味論を、一概念ずつ説明します。",
  landing: languageOverviewPage (),
  groups: [
    NavigationGroup {
      id: "language-model",
      title: localized "Language model" "言語model",
      sections: [NavigationSection {
        id: "foundations",
        title: localized "Foundations" "基礎",
        kind: FlatSection,
        overview: whatIsSeseragiPage (),
        pages: [
          designPrinciplesPage (),
          expressionOrientedPage (),
          immutableByDefaultPage (),
          noHiddenDangerPage (),
          backendIndependentSemanticsPage (),
          diagnosableBehaviorPage (),
          visibleCostsPage (),
          readableDensityPage (),
          programsPage (),
          nonFeaturesPage ()
        ]
      }]
    },
    NavigationGroup {
      id: "syntax",
      title: localized "Syntax" "構文",
      sections: [
        NavigationSection {
          id: "lexical-structure",
          title: localized "Lexical structure" "字句構造",
          kind: FlatSection,
          overview: sourceTextPage (),
          pages: [
            literalsPage (),
            characterStringEscapesPage (),
            layoutLineContinuationPage ()
          ]
        },
        NavigationSection {
          id: "application",
          title: localized "Application" "適用",
          kind: FlatSection,
          overview: functionApplicationPage (),
          pages: [methodCallsPage (), pipelinesPage ()]
        },
        NavigationSection {
          id: "operators",
          title: localized "Operators and names" "operatorとname",
          kind: FlatSection,
          overview: operatorPrecedencePage (),
          pages: [
            customOperatorsPage (),
            reservedWordsPage (),
            optionalRecordFieldsPage ()
          ]
        }
      ]
    },
    NavigationGroup {
      id: "type-system",
      title: localized "Type system" "型system",
      sections: [NavigationSection {
        id: "type-foundations",
        title: localized "Foundations" "基礎",
        kind: FlatSection,
        overview: typeSystemPage (),
        pages: [
          builtInTypesPage (),
          typeConstructorsPage (),
          annotationsInferencePage (),
          polymorphismPage ()
        ]
      }]
    }
  ]
}

fn libraryArea input: BuildInput -> NavigationArea = NavigationArea {
  id: "library",
  title: localized "Standard Library" "標準ライブラリ",
  description: localized "Module and symbol reference generated from compiler metadata."
    "compiler metadataから生成されるmodule・symbol referenceです。",
  landing: libraryOverviewPage (),
  groups: referenceGroups input.referenceModules
}

fn sectionPages section: NavigationSection -> Array<PageDefinition> = arrays.concat [
  [section.overview],
  section.pages
]

fn groupPages group: NavigationGroup -> Array<PageDefinition> =
  arrays.concat [sectionPages section | section <- group.sections]

fn areaPages area: NavigationArea -> Array<PageDefinition> = arrays.concat [
  [area.landing],
  arrays.concat [groupPages group | group <- area.groups]
]

pub fn catalog input: BuildInput -> SiteCatalog = {
  let home = homePage ()
  let areas = [getStartedArea (), languageArea (), libraryArea input]
  SiteCatalog {
    home,
    areas,
    pages: arrays.concat [
      [home, docsOverviewPage (), examplesPage (), releasesPage ()],
      arrays.concat [areaPages area | area <- areas]
    ]
  }
}
