import * as effects from "std/effect"
import * as inputs from "std/stdin"
import * as json from "std/json"
import { RenderRequest, decodeRenderRequest } from "./model/render-request"
import { catalog } from "./navigation/catalog"
import { renderBatch } from "./render/batch"

type GeneratorError deriving Show =
  | InputFailure
  | DecodeFailure
  | RequestFailure String
  | ConsoleFailure ConsoleError

fn requireInput value: Maybe<String> -> Either<GeneratorError, String> = match value {
  Nothing -> Left InputFailure
  Just encoded -> Right encoded
}

pub effect fn main -> Unit with Console, Stdin fails GeneratorError = do {
  limit <- inputs.lineLimit 67108864
    |> effects.fromEither
    |> effects.mapError (\_ -> InputFailure)
  line <- inputs.readLineWith limit |> effects.mapError (\_ -> InputFailure)
  encoded <- requireInput line |> effects.fromEither
  request <- decodeRenderRequest encoded
    |> effects.fromEither
    |> effects.mapError (\_ -> DecodeFailure)
  response <- renderBatch request (catalog request.input)
    |> effects.fromEither
    |> effects.mapError RequestFailure
  println (json.encodeString response) |> effects.mapError ConsoleFailure
}
