import * as effects from "std/effect"
import * as fs from "std/fs"
import * as paths from "std/path"

type ReportError deriving Show =
  | PathFailure paths.PathError
  | WriteFailure fs.FileSystemError
  | ReadFailure fs.FileTextError

effect fn report directory: paths.Path -> String with FileSystem fails ReportError =
  do {
    file <- paths.child "report.txt" directory
      |> effects.fromEither
      |> effects.mapError PathFailure
    _ <- fs.writeTextUtf8 fs.Append "first\n" file |> effects.mapError WriteFailure
    _ <- fs.writeTextUtf8 fs.Append "second\n" file |> effects.mapError WriteFailure
    _ <- fs.writeTextUtf8 fs.Append "tail" file |> effects.mapError WriteFailure
    fs.readTextUtf8 file |> effects.mapError ReadFailure
  }

pub effect fn main = do {
  result <- effects.attempt (fs.withTemporaryDirectory "fs16-append-" report)
  let message = match result {
    Right text -> text
    Left problem -> show problem
  }
  println message
}
