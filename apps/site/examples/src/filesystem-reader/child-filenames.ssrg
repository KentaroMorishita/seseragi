import * as paths from "std/path"

fn addFilename base: paths.Path -> name: String -> String =
  match paths.child name base {
    Left _ -> `rejected: ${name}`
    Right file -> paths.render file
  }

pub effect fn main = match paths.parse "reports" {
  Left reason -> println (show reason)
  Right base -> do {
    _ <- println (addFilename base "report.txt")
    _ <- println (addFilename base "report.v2.txt")
    _ <- println (addFilename base "../report.txt")
    _ <- println (addFilename base "")
    _ <- println (addFilename base ".")
    println (addFilename base "..")
  }
}
