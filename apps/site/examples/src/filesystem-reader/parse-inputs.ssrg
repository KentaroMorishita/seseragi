import * as paths from "std/path"

fn describe text: String -> String = match paths.parse text {
  Left reason -> `rejected: ${show reason}`
  Right file -> `accepted: ${paths.render file}`
}

pub effect fn main = do {
  _ <- println (describe "reports/./report.txt")
  _ <- println (describe "")
  println (describe "C:\\reports\\report.txt")
}
