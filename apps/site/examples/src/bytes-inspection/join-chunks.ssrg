import * as bytes from "std/bytes"

pub effect fn main = match (bytes.fromInts [10, 20], bytes.fromInts [30]) {
  (Right first, Right last) -> do {
    let joined = bytes.concat [first, bytes.empty (), last]
    println (show (bytes.toInts joined))
    println (show (bytes.toInts (bytes.concat [])))
    println (show (bytes.toInts first))
    println (show (bytes.toInts last))
  }
  _ -> println "Invalid byte input"
}
