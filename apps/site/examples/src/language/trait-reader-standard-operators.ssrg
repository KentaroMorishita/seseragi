struct Distance { meters: Int }

instance Add<Distance, Distance, Distance> {
  fn add left: Distance -> right: Distance -> Distance = Distance {
    meters: left.meters + right.meters
  }
}

let total = Distance { meters: 20 } + Distance { meters: 22 }
let called: Distance = add (Distance { meters: 20 }) (Distance { meters: 22 })
pub effect fn main = println (show total.meters + "\n" + show called.meters)
