pub effect fn main = do {
  let pair = ("answer", 42)
  let (label, number) = pair
  let numbers = [10, 20, 30]
  let names = `["Aki", "Mio"]
  let moreNames = "Ren": names
  _ <- println label
  _ <- println number
  _ <- println (show numbers[1])
  _ <- println (show numbers[9])
  println (show moreNames)
}
