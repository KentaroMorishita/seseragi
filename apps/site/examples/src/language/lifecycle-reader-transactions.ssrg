import * as arrays from "std/array"
import * as refs from "std/ref"
import * as signals from "std/signal"

pub effect fn main = do {
  width <- signals.make 1
  height <- signals.make 2
  seen <- refs.make (arrays.empty<Int> ())
  let area = signals.combine (\w: Int -> \h: Int -> w * h) width height
  subscription <- signals.subscribe (
    \value: Int -> refs.update (\values: Array<Int> -> arrays.append [value] values)
      seen
  ) area
  signals.transaction [signals.planSet 3 width, signals.planSet 4 height]
  signals.unsubscribe subscription
  history <- refs.get seen
  current <- signals.read area
  _ <- println (show history)
  println current
}
