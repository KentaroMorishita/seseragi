import * as effects from "std/effect"

fn checkedMessage value: Int -> Effect<{}, String, String> =
  if value > 0 then
    effects.succeed ("ok: " + show value)
  else
    effects.fail "must be positive"

fn explain value: Int -> Task<String> =
  effects.recover (\reason: String -> effects.succeed ("error: " + reason)) (checkedMessage value)

pub effect fn main = do {
  good <- explain 2
  bad <- explain 0
  _ <- println good
  println bad
}
