import * as effects from "std/effect"
import * as refs from "std/ref"

effect fn step counter: refs.Ref<Int> = do {
  _ <- refs.update (\value: Int -> value + 1) counter
  effects.yieldNow ()
}

effect fn steps counter: refs.Ref<Int> = for iteration <- [1, 2, 3] {
  step counter
}

pub effect fn main = do {
  left <- refs.make 0
  right <- refs.make 0
  _ <- effects.parallel [steps left, steps right]
  leftCount <- refs.get left
  rightCount <- refs.get right
  println (show [leftCount, rightCount])
}
