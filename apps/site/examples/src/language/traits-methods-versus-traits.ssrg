struct User { name: String, }

impl User {
  fn displayName self: User -> String = self.name
}

trait DebugName<A> {
  fn debugName value: A -> String
}

instance DebugName<User> {
  fn debugName value: User -> String = "User(" + value.name + ")"
}

let user = User { name: "Aki", }
let publicName = user.displayName
let diagnosticName = debugName user
