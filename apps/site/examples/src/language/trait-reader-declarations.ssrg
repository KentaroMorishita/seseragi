struct Ticket { number: Int }

trait Label<A> {
  fn label value: A -> String
  fn shortLabel value: A -> String
}

instance Label<Ticket> {
  fn label value: Ticket -> String = "ticket-" + show value.number

  fn shortLabel value: Ticket -> String = "#" + show value.number
}

let ticket = Ticket { number: 42 }
pub effect fn main = println (label ticket + "\n" + shortLabel ticket)
