type Outcome<E, A> =
  | Failure E
  | Success A

fn describe result: Outcome<String, Int> -> String = match result {
  Failure reason -> `error: ${reason}`
  Success number -> `ok: ${number}`
}

let found: Outcome<String, Int> = Success 42
let missing: Outcome<String, Int> = Failure "missing"
pub effect fn main = println `${describe found}\n${describe missing}`
