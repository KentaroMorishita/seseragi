import * as either from "std/either"

type PositiveError =
  | NotPositive Int

pub fn positive value: Int -> Either<PositiveError, Int> =
  if value > 0 then Right value else Left (NotPositive value)

pub fn increment result: Either<PositiveError, Int> -> Either<PositiveError, Int> =
  either.mapRight (\value -> value + 1) result
