struct Customer { name: String }
struct Product { name: String }

fn customerName customer: Customer -> String = customer.name
fn recordName value: { name: String } -> String = value.name

let customer = Customer { name: "Aki" }
let product = Product { name: "Notebook" }
let first = customerName customer
let second = recordName { name: "Mio", score: 10 }
let third = recordName { name: product.name }

pub effect fn main = println `${first}\n${second}\n${third}`
