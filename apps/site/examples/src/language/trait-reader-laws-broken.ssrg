struct Ticket { number: Int }

instance Eq<Ticket> {
  fn eq left: Ticket -> right: Ticket -> Bool = False
}

fn reflexive<A> value: A -> Bool where Eq<A> = value == value
fn symmetric<A> left: A -> right: A -> Bool where Eq<A> =
  (left == right) == (right == left)

let ticket = Ticket { number: 42 }
pub effect fn main =
  println (show (reflexive ticket) + "\n" + show (symmetric ticket (Ticket { number: 7 })))
