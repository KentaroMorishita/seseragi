let pair = ("answer", 42)
let (label, number) = pair
let numbers = [10, 20, 30]
let selected = match numbers[1] {
  Just value -> value
  Nothing -> 0
}
let names = `["Aki", "Mio"]
let moreNames = "Ren": names

pub effect fn main =
  println `${label}\n${number}\n${show numbers[1]}\n${show numbers[9]}\n${selected}\n${show moreNames}`
