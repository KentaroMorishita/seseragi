import * as signals from "std/signal"

fn add left: Int -> right: Int -> Int = left + right

pub effect fn main = do {
  price <- signals.make 10
  shipping <- signals.make 2
  let priceValues = signals.map (\value: Int -> value) price
  let shippingValues = signals.map (\value: Int -> value) shipping
  let doubled = (\value: Int -> value * 2) <$> priceValues
  let total = add <$> doubled <*> shippingValues
  before <- signals.read total
  signals.transaction [signals.planSet 20 price, signals.planSet 5 shipping]
  after <- signals.read total
  _ <- println before
  println after
}
