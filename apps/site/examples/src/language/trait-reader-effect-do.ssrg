import * as effects from "std/effect"

fn positive value: Int -> Effect<{}, String, Int> =
  if value > 0 then effects.succeed value else effects.fail "must be positive"

fn total first: Int -> second: Int -> Effect<{}, String, Int> = do {
  left <- positive first
  right <- positive second
  let result: Effect<{}, String, Int> = effects.succeed (left + right)
  result
}

fn duplicate<M<_>, A> source: M<A> -> M<(A, A)> where Monad<M> = do {
  value <- source
  pure (value, value)
}

struct Settings { label: String }
fn chooseSettings environment: { settings: Settings } -> Settings = environment.settings
effect fn readLabel -> String with Settings = do {
  settings <- effects.service chooseSettings
  effects.succeed settings.label
}

pub effect fn main = do {
  label <- effects.provide { settings: Settings { label: "ready" } } (readLabel ())
  paired <- effects.recover (\_: String -> effects.succeed (-1, -1)) (duplicate (total 20 22))
  accepted <- effects.recover (\_: String -> effects.succeed (-1)) (total 20 22)
  rejected <- effects.recover (\_: String -> effects.succeed (-1)) (total 20 0)
  println (
    label + "\n" + show paired + "\n" + show accepted + "\n" + show rejected + "\n" + show
      (duplicate (Just 2))
  )
}
