fn increment value: Int -> Maybe<Int> = Just (value + 1)

fn withDo source: Maybe<Int> -> Maybe<Int> = do {
  value <- source
  increment value
}

fn withFlatMap source: Maybe<Int> -> Maybe<Int> =
  flatMap (\value -> increment value) source

let sameResult = withDo (Just 41) == withFlatMap (Just 41)
