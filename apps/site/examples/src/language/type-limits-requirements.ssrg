import * as effects from "std/effect"

struct Settings { label: String }
struct Theme { suffix: String }
alias Configured<R, A> = Effect<R & { settings: Settings }, Never, A>

fn settingsOf environment: { settings: Settings } -> Settings = environment.settings
fn themeOf environment: { theme: Theme } -> Theme = environment.theme

effect fn greeting -> String with Settings, Theme = do {
  settings <- effects.service settingsOf
  theme <- effects.service themeOf
  effects.succeed (settings.label + theme.suffix)
}

let configured: Unit -> Configured<{ theme: Theme }, String> = greeting

pub effect fn main = do {
  label <- effects.provide {
    settings: Settings { label: "Hello" },
    theme: Theme { suffix: "!" }
  } (configured ())
  println label
}
