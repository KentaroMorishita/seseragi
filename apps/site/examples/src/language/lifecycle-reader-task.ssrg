import * as refs from "std/ref"

fn next counter: refs.Ref<Int> -> Task<Int> = do {
  refs.update (\value: Int -> value + 1) counter
  refs.get counter
}

pub effect fn main = do {
  counter <- refs.make 0
  let work = next counter
  before <- refs.get counter
  first <- work
  second <- work
  println (show [before, first, second])
}
