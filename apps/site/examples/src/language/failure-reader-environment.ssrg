import * as effects from "std/effect"

struct Settings { label: String }

fn selectSettings environment: { settings: Settings } -> Settings = environment.settings

effect fn applicationLabel -> String with Settings = do {
  settings <- effects.service selectSettings
  effects.succeed settings.label
}

pub effect fn main = do {
  label <- effects.provide { settings: Settings { label: "Hello, Aki" } } (applicationLabel ())
  println label
}
