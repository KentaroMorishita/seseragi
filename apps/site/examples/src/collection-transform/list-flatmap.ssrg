import * as items from "std/list"
import * as json from "std/json"

struct Group { title: String, tasks: List<String> }
let groups = `[
  Group { title: "Today", tasks: `["Read", "Review"] },
  Group { title: "Waiting", tasks: `[] },
  Group { title: "Tomorrow", tasks: `["Ship"] }
]

pub effect fn main =
  println (json.encodeString [value | value <- (items.flatMap (\group -> group.tasks) groups)])
