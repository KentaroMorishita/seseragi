import * as items from "std/list"
import * as json from "std/json"

fn renderTasks tasks: Array<String> -> String = json.encodeString [task | task <- tasks]

let tasks = `["Read", "Review", "Ship"]
let converted: Array<String> = items.toArray tasks

pub effect fn main = do {
  _ <- println (renderTasks converted)
  println (json.encodeString [task | task <- tasks])
}
