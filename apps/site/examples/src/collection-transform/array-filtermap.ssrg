import * as items from "std/array"
import * as ints from "std/int"
import * as json from "std/json"

fn parseCount value: String -> Maybe<Int> = match ints.parse value {
  Right count -> Just count
  Left _ -> Nothing
}

let inputs = ["2", "oops", "0", "3"]

pub effect fn main = do {
  _ <- println (json.encodeString [value | value <- (items.filterMap parseCount inputs)])
  println (json.encodeString [value | value <- inputs])
}
