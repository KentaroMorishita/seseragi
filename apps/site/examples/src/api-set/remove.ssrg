import * as sets from "std/set"
import * as json from "std/json"

pub effect fn main = do {
  let original = sets.fromIterable [3, 1, 2]
  let removed = sets.remove 1 original
  println (json.encodeString (sets.toArray removed))
  println (json.encodeString (sets.toArray (sets.insert 1 removed)))
  println (json.encodeString (sets.toArray (sets.remove 9 original)))
  println (json.encodeString (sets.toArray original))
  println (json.encodeString (sets.toArray (sets.remove 1 (sets.empty<Int> ()))))
}
