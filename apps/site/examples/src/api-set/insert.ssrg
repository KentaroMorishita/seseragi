import * as sets from "std/set"
import * as json from "std/json"

pub effect fn main = do {
  let original = sets.fromIterable [3, 1, 2]
  println (json.encodeString (sets.toArray (sets.insert 1 original)))
  println (json.encodeString (sets.toArray (sets.insert 4 original)))
  println (json.encodeString (sets.toArray original))
  println (json.encodeString (sets.toArray (sets.insert 0 (sets.empty<Int> ()))))
}
