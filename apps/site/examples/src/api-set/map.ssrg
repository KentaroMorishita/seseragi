import * as sets from "std/set"
import * as json from "std/json"

fn parity value: Int -> Int = value % 2

pub effect fn main = do {
  let original = sets.fromIterable [3, 2, 5, 4]
  println (json.encodeString (sets.toArray (sets.map parity original)))
  println (json.encodeString (sets.toArray original))
  println (json.encodeString (sets.toArray (sets.map parity (sets.empty<Int> ()))))
}
