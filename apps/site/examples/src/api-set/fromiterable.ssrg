import * as sets from "std/set"
import * as json from "std/json"

pub effect fn main = do {
  let values = sets.fromIterable [3, 1, 3, 2, 1]
  let noValues: Array<Int> = []
  println (json.encodeString (sets.toArray values))
  println (json.encodeString (sets.toArray (sets.fromIterable `[3, 1, 3, 2])))
  println (json.encodeString (sets.toArray (sets.fromIterable noValues)))
}
