import * as sets from "std/set"
import * as json from "std/json"

pub effect fn main = do {
  let required = sets.fromIterable [2, 1]
  let allowed = sets.fromIterable [3, 1, 2]
  let empty = sets.empty<Int> ()
  println (sets.isSubsetOf allowed required)
  println (sets.isSubsetOf required allowed)
  println (sets.isSubsetOf allowed empty)
  println (sets.isSubsetOf empty required)
  println (sets.isSubsetOf empty empty)
}
