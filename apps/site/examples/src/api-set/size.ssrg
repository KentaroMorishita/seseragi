import * as sets from "std/set"
import * as json from "std/json"

pub effect fn main = do {
  let values = sets.fromIterable [3, 1, 3, 2]
  println (sets.size values)
  println (sets.size (sets.insert 1 values))
  println (sets.size (sets.insert 4 values))
  println (sets.size (sets.empty<Int> ()))
}
