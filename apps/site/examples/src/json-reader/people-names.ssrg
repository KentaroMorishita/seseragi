import * as json from "std/json"
import * as text from "std/text"

fn segment value: json.JsonPathSegment -> String = match value {
  json.JsonField name -> "." + name
  json.JsonIndex position -> "[" + show position + "]"
}

fn pathText path: Array<json.JsonPathSegment> -> String =
  "$" + text.join "" [segment item | item <- path]

fn kindText kind: json.DecodeErrorKind -> String = match kind {
  json.ExpectedJsonType expected -> "expected " + expected
  json.MissingJsonField name -> "missing " + name
  json.UnknownJsonField name -> "unknown " + name
  json.UnknownJsonTag name -> "unknown tag " + name
  json.InvalidJsonValue message -> "invalid " + message
}

fn decodeErrorText error: json.DecodeError -> String =
  pathText error.path + " | " + kindText error.kind

let stringDecoder: json.Decoder<String> = decodeJson
let nameDecoder: json.Decoder<String> = json.field "name" stringDecoder
let peopleDecoder: json.Decoder<Array<String>> =
  json.field "people" (json.array nameDecoder)

fn report source: String -> String = match json.parse source {
  Left _ -> "Invalid JSON text"
  Right value -> match peopleDecoder value {
    Left error -> decodeErrorText error
    Right names -> json.encodeString names
  }
}

pub effect fn main -> Unit with Console fails ConsoleError = do {
  _ <- println (report "{\"people\":[{\"name\":\"Mio\"},{\"name\":\"Aki\"}]}")
  _ <- println (report "{\"people\":[]}")
  _ <- println (report "{\"people\":[{\"name\":\"Mio\"},{\"name\":false},{\"name\":null}]}")
  _ <- println (report "{\"people\":[{\"name\":\"Mio\"},{}]}")
  _ <- println (report "{\"people\":[false]}")
  _ <- println (report "{\"people\":false}")
  println (report "{}")
}
