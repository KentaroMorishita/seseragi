import * as json from "std/json"
let stringDecoder: json.Decoder<String> = decodeJson

let optionalName: json.Decoder<Maybe<String>> = json.optionalField "name" stringDecoder
fn report source: String -> String = match json.parse source {
  Left _ -> "Invalid JSON text"
  Right value -> match optionalName value {
    Left _ -> "Name must be text"
    Right name -> match name {
      Nothing -> "Name is missing"
      Just value -> "Present: " + value
    }
  }
}
pub effect fn main -> Unit with Console fails ConsoleError = do {
  _ <- println (report "{}")
  _ <- println (report "{\"name\":\"\"}")
  _ <- println (report "{\"name\":\"Mio\"}")
  println (report "{\"name\":null}")
}
