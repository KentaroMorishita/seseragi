import * as json from "std/json"
struct Settings deriving JsonDecode { name: String, retries: Int }
fn readSettings source: String -> Either<json.JsonReadError, Settings> =
  json.decodeString source
fn describe source: String -> String = match readSettings source {
  Right settings -> "Ready: " + settings.name
  Left error -> match error {
    json.JsonSyntaxFailure _ -> "JSON text rejected"
    json.JsonDecodeFailure _ -> "Settings shape rejected"
  }
}
pub effect fn main -> Unit with Console fails ConsoleError = do {
  _ <- println (describe "{\"name\":\"Mio\",\"retries\":2}")
  _ <- println (describe "{\"name\":false,\"retries\":2}")
  println (describe "{")
}
