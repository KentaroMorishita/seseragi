import * as json from "std/json"
struct Settings deriving JsonEncode, JsonDecode { name: String, retries: Int }
let encodeSettings: json.Encoder<Settings> = encodeJson
let decodeSettings: json.Decoder<Settings> = decodeJson
fn readParsed source: String -> String = match json.parse source {
  Left _ -> "Invalid JSON text"
  Right value -> match decodeSettings value {
    Left _ -> "Settings rejected"
    Right settings -> "Ready: " + settings.name
  }
}
pub effect fn main -> Unit with Console fails ConsoleError = do {
  _ <- println (json.stringify (encodeSettings (Settings { name: "Mio", retries: 2 })))
  println (readParsed "{\"name\":\"Mio\",\"retries\":2}")
}
