import * as json from "std/json"
let stringDecoder: json.Decoder<String> = decodeJson

let labelsDecoder: json.Decoder<Array<(String, String)>> = json.record [
  ("first", stringDecoder),
  ("second", stringDecoder)
]
fn report source: String -> String = match json.parse source {
  Left _ -> "Invalid JSON text"
  Right value -> match labelsDecoder value {
    Left _ -> "Labels rejected"
    Right labels -> json.encodeString labels
  }
}
pub effect fn main -> Unit with Console fails ConsoleError = do {
  _ <- println (report "{\"second\":\"B\",\"first\":\"A\"}")
  _ <- println (report "{\"first\":\"A\"}")
  println (report "{\"first\":false,\"extra\":\"x\"}")
}
