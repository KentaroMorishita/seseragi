import * as json from "std/json"
let intDecoder: json.Decoder<Int> = decodeJson
let countsDecoder: json.Decoder<Array<Int>> = json.array intDecoder
fn report source: String -> String = match json.parse source {
  Left _ -> "Invalid JSON text"
  Right value -> match countsDecoder value {
    Left _ -> "Counts rejected"
    Right counts -> json.encodeString counts
  }
}
pub effect fn main -> Unit with Console fails ConsoleError = do {
  _ <- println (report "[2, 0, 5]")
  _ <- println (report "[]")
  println (report "[2, false, 5]")
}
