import * as json from "std/json"
fn normalize source: String -> String = match json.parse source {
  Left _ -> "Invalid JSON text"
  Right value -> json.stringify value
}
pub effect fn main -> Unit with Console fails ConsoleError = do {
  _ <- println (normalize " {\"name\":\"Mio\",\"retries\":2} ")
  _ <- println (normalize "[true, null, \"ready\"]")
  println (normalize "{")
}
