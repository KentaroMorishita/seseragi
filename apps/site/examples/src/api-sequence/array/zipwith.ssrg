import * as arrays from "std/array"

fn subtract left: Int -> right: Int -> Int = left - right
let left = [10, 20, 30]
let right = [1, 2]
let none: Array<Int> = []

pub effect fn main = do {
  _ <- println (show (arrays.zipWith subtract right left))
  _ <- println (show (arrays.zipWith subtract left right))
  _ <- println (show (arrays.zipWith subtract right none))
  println (show (arrays.zipWith subtract none left))
}
