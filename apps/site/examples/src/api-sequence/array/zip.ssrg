import * as arrays from "std/array"

let names = ["Aki", "Mio", "Ren"]
let scores = [80, 95]
let noNames: Array<String> = []
let noScores: Array<Int> = []

pub effect fn main = do {
  _ <- println (show (arrays.zip scores names))
  _ <- println (show (arrays.zip names scores))
  _ <- println (show (arrays.zip scores noNames))
  println (show (arrays.zip noScores names))
}
