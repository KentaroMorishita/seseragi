import * as lists from "std/list"

let names = `["Aki", "Mio", "Ren"]
let scores = `[80, 95]
let noNames: List<String> = `[]
let noScores: List<Int> = `[]

pub effect fn main = do {
  _ <- println (show (lists.zip scores names))
  _ <- println (show (lists.zip names scores))
  _ <- println (show (lists.zip scores noNames))
  println (show (lists.zip noScores names))
}
