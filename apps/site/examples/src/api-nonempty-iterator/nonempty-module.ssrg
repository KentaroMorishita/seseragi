import * as nonempty from "std/non-empty-list"
fn total values: List<Int> -> String = match nonempty.fromList values {
  Nothing -> "no scores"
  Just scores -> show (nonempty.reduce1 (\sum score -> sum + score) scores)
}
pub effect fn main = do {
  println (total `[10, 20, 30])
  println (total `[])
}
