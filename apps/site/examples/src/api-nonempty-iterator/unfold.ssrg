import * as iterator from "std/iterator"
fn countdown remaining: Int -> Maybe<(Int, Int)> =
  if remaining > 0 then Just (remaining, remaining - 1) else Nothing
fn repeatValue value: Int -> Maybe<(Int, Int)> = Just (value, value)
pub effect fn main = do {
  println (show [value | value <- iterator.unfold countdown 3])
  println (show [value | value <- iterator.unfold countdown 0])
  println (match iterator.next (iterator.unfold repeatValue 10) {
      Nothing -> "done"
      Just (value, _) -> show value
    }
  )
}
