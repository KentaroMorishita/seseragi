import * as items from "std/array"
import * as json from "std/json"

fn describe value: Maybe<String> -> String = match value {
  Just label -> "present: " + json.encodeString label
  Nothing -> "missing"
}
pub effect fn main = do {
  let labels = ["", "Review"]
  _ <- println (describe (items.get 0 labels))
  _ <- println (describe (items.get 1 labels))
  _ <- println (describe (items.get (0 - 1) labels))
  _ <- println (describe (items.get 2 labels))
  _ <- println (describe (items.get 0 (items.empty<String> ())))
  _ <- println (describe (items.head labels))
  println (describe (items.head (items.empty<String> ())))
}
