import * as items from "std/list"
import * as json from "std/json"

pub effect fn main = do {
  let none: List<Int> = `[]
  let one = `[0]
  let several = `[0, 2, 0]
  _ <- println (json.encodeString (items.isEmpty none))
  _ <- println (json.encodeString (items.isEmpty one))
  _ <- println (json.encodeString (items.isEmpty (`[False])))
  _ <- println (json.encodeString (items.isEmpty (`[""])))
  _ <- println (show (items.length none))
  _ <- println (show (items.length one))
  println (show (items.length several))
}
