import * as items from "std/array"
import * as json from "std/json"

struct Task { title: String, urgent: Bool }
fn urgent task: Task -> Bool = task.urgent
let tasks = [
  Task { title: "Read", urgent: False },
  Task { title: "Review", urgent: True },
  Task { title: "Ship", urgent: True }
]

pub effect fn main = do {
  let selected = items.filter urgent tasks
  _ <- println (json.encodeString [task.title | task <- selected])
  _ <- println (json.encodeString [task.title | task <- tasks])
  println (json.encodeString [task.title | task <- items.filter urgent (items.empty<Task> ())])
}
