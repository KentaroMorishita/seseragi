import * as maps from "std/map"
fn priceLabel prices: maps.Map<String, Int> -> String = match maps.get "tea" prices {
  Nothing -> "not listed"
  Just price -> show price
}
pub effect fn main = do {
  let prices: maps.Map<String, Int> = maps.fromEntries [
    ("tea", 0),
    ("coffee", 5),
    ("tea", 2)
  ]
  let updated = maps.insert "tea" 3 prices
  println (show (maps.entries prices))
  println (show (maps.entries updated))
  println (priceLabel (maps.singleton "tea" 0))
  println (priceLabel (maps.empty ()))
  println (prices == maps.fromEntries [("coffee", 5), ("tea", 2)])
}
