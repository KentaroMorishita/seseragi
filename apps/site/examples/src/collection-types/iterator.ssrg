import * as iterator from "std/iterator"
fn countdown remaining: Int -> Maybe<(Int, Int)> =
  if remaining > 0 then Just (remaining, remaining - 1) else Nothing
fn first values: Iterator<Int> -> String = match iterator.next values {
  Nothing -> "done"
  Just (value, _) -> show value
}
fn second values: Iterator<Int> -> String = match iterator.next values {
  Nothing -> "done"
  Just (_, rest) -> first rest
}
pub effect fn main = do {
  let values: iterator.Iterator<Int> = iterator.unfold countdown 3
  println (first values)
  println (first values)
  println (second values)
  println (first (iterator.unfold countdown 0))
}
