import * as nonempty from "std/non-empty-list"
fn firstOrNone values: List<Int> -> String = match nonempty.fromList values {
  Nothing -> "no scores"
  Just scores -> show (nonempty.head scores)
}
pub effect fn main = do {
  let scores: nonempty.NonEmptyList<Int> = nonempty.cons 10 `[20, 30]
  println (nonempty.head scores)
  println (show (nonempty.tail scores))
  println (show (nonempty.tail (nonempty.singleton 0)))
  println (firstOrNone `[0, 20])
  println (firstOrNone `[])
}
