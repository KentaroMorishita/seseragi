import * as collections from "std/collection"
fn step total: Int -> score: Int -> collections.ReduceStep<Int> =
  if score < 0 then collections.Done total else collections.Next (total + score)
fn carried decision: collections.ReduceStep<Int> -> Int = match decision {
  collections.Next value -> value
  collections.Done value -> value
}
pub effect fn main = do {
  println (collections.reduceUntil 0 step [10, 20, -1, 100])
  println (collections.reduceUntil 0 step [10, 20])
  let emptyScores: Array<Int> = []
  println (collections.reduceUntil 0 step emptyScores)
  println (carried (collections.Done 99))
  println "still running"
}
