import * as lists from "std/list"
import * as maps from "std/map"
fn parity value: Int -> Int = value % 2
fn describe group: Maybe<List<Int>> -> String = match group {
  Just values -> "group: " + show values
  Nothing -> "no group"
}
let groups = lists.groupBy parity `[3, 2, 5, 4, 7]
pub effect fn main = do {
  println (show (maps.keys groups))
  println (describe (maps.get 1 groups))
  println (describe (maps.get 0 groups))
  println (describe (maps.get 9 groups))
  println (maps.size (lists.groupBy parity (lists.empty<Int> ())))
}
