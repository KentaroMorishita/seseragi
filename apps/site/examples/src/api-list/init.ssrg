import * as lists from "std/list"
fn describe values: List<Int> -> String = match lists.init values {
  Just remaining -> "remaining: " + show remaining
  Nothing -> "empty input"
}
pub effect fn main = do {
  println (describe `[10, 20, 30])
  println (describe `[10])
  println (describe (lists.empty<Int> ()))
}
