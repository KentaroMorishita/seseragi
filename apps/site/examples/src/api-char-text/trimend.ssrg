import * as text from "std/text"

let label = "  Aki  "
let withBom = "Aki \u{FEFF}"

pub effect fn main =
  println `result: [${text.trimEnd label}]
original: [${label}]
NEL removed: ${text.trimEnd "Aki\u{0085}" == "Aki"}
FEFF preserved: ${text.trimEnd withBom == withBom}
empty: [${text.trimEnd ""}]
only whitespace: [${text.trimEnd "\n\t\u{2003}"}]`
