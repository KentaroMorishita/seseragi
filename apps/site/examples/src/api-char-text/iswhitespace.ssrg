import * as unicode from "std/text/unicode"

let space = ' '
pub effect fn main =
  println `space whitespace: ${unicode.isWhitespace space}
tab whitespace: ${unicode.isWhitespace '\t'}
NEL whitespace: ${unicode.isWhitespace '\u{0085}'}
EM SPACE whitespace: ${unicode.isWhitespace '\u{2003}'}
U+FEFF whitespace: ${unicode.isWhitespace '\u{FEFF}'}
U+200B whitespace: ${unicode.isWhitespace '\u{200B}'}`
