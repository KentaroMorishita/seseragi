import * as char from "std/char"

fn describe point: Int -> String = match char.fromCodePoint point {
  Just value -> `found: ${char.toString value}`
  Nothing -> "not a scalar"
}

pub effect fn main =
  println `${describe 128077}
${describe (-1)}
${describe 55296}
${describe 57343}
${describe 1114112}
zero accepted: ${char.fromCodePoint 0 == Just '\0'}
last accepted: ${char.fromCodePoint 1114111 == Just '\u{10FFFF}'}`
