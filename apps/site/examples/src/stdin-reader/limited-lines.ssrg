import * as effects from "std/effect"
import * as stdin from "std/stdin"

effect fn reportLine limit: stdin.LineLimit
  -> Unit
with Console, stdin: stdin.Stdin
fails ConsoleError =
  do {
    result <- effects.attempt (stdin.readLineWith limit)
    match result {
      Right Nothing -> println "EOF"
      Right (Just "") -> println "Blank line"
      Right (Just text) -> println ("Line: " + text)
      Left (stdin.InvalidStdinUtf8 { offset }) -> println ("Invalid UTF-8 at byte " + show offset)
      Left (stdin.StdinLineTooLong { limitBytes }) -> println ("Line exceeds " + show limitBytes + " bytes")
      Left _ -> println "Input failed"
    }
  }

pub effect fn main -> Unit with Console, stdin: stdin.Stdin fails ConsoleError =
  match stdin.lineLimit 4 {
    Left problem -> println ("Invalid limit: " + show problem)
    Right limit -> do {
      _ <- reportLine limit
      _ <- reportLine limit
      reportLine limit
    }
  }
