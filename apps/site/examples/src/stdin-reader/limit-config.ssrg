import * as stdin from "std/stdin"

fn describe value: Int -> String = match stdin.lineLimit value {
  Right _ -> "Accepted"
  Left (stdin.NonPositiveLineLimit bytes) -> "Use at least 1 byte: " + show bytes
  Left (stdin.LineLimitTooLarge bytes) -> "Use at most 67108864 bytes: " + show bytes
  Left reason -> "Invalid limit: " + show reason
}

pub effect fn main -> Unit with Console fails ConsoleError = do {
  println (describe 0)
  println (describe (-1))
  println (describe 1)
  println (describe 67108864)
  println (describe 67108865)
}
