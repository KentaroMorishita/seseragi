import * as ints from "std/int"

fn describeCount text: String -> String = match ints.parse text {
  Left _ -> "invalid count"
  Right count -> "count: " + ints.format count
}
pub effect fn main = do {
  println (describeCount "+12")
  println (describeCount "-0")
  println (describeCount "012")
  println (describeCount "12px")
  println (describeCount "9007199254740991")
  println (describeCount "9007199254740992")
}
