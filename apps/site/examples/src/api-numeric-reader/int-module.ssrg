import * as ints from "std/int"

fn addFive text: String -> String = match ints.parse text {
  Left _ -> "invalid count"
  Right count -> match ints.checkedAdd 5 count {
    Nothing -> "count too large"
    Just total -> "total: " + ints.format total
  }
}
pub effect fn main = do {
  println (addFive "12")
  println (addFive "12px")
  println (addFive "9007199254740991")
}
