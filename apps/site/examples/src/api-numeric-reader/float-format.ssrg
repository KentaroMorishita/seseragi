import * as floats from "std/float"

pub effect fn main = do {
  println (floats.format 12.5)
  println (floats.format 12.0)
  println (floats.format (-0.0))
  println (floats.format 1e21)
  println (floats.format (floats.nan ()))
  println (floats.format (floats.positiveInfinity ()))
  println (floats.format (floats.negativeInfinity ()))
}
