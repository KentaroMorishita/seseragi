import * as floats from "std/float"

fn describeMeasurement text: String -> String = match floats.parse text {
  Left _ -> "invalid measurement"
  Right value ->
    if floats.isFinite value then
      "measurement: " + floats.format value
    else
      "non-finite measurement"
}

pub effect fn main = do {
  println (describeMeasurement "12.5")
  println (describeMeasurement "12.5cm")
  println (describeMeasurement "")
  println (describeMeasurement " 12.5")
  println (describeMeasurement "Infinity")
  println (describeMeasurement "NaN")
  println (describeMeasurement "1e309")
}
