import * as ints from "std/int"

fn calculate original: Int -> amount: Int -> String =
  match ints.checkedSubtract amount original {
    Nothing -> "out of range"
    Just result -> "result: " + ints.format result
  }
pub effect fn main = do {
  println (calculate 12 5)
  println (calculate (-9007199254740991) 1)
}
