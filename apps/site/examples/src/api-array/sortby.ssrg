import * as arrays from "std/array"

fn score value: { name: String, score: Int } -> Int = value.score

let people = [
  { name: "Aki", score: 2 },
  { name: "Mio", score: 1 },
  { name: "Ren", score: 2 }
]

let nobody: Array<{ name: String, score: Int }> = []

pub effect fn main = do {
  _ <- println (show (arrays.sortBy score people))
  _ <- println (show people)
  println (show (arrays.sortBy score (nobody)))
}
