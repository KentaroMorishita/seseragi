import * as arrays from "std/array"

fn isSmall value: Int -> Bool = value < 3

pub effect fn main = do {
  _ <- println (show (arrays.takeWhile isSmall [1, 2, 4, 1]))
  _ <- println (show (arrays.takeWhile isSmall [4, 1]))
  _ <- println (show (arrays.takeWhile isSmall [1, 2]))
  println (show (arrays.takeWhile isSmall (arrays.empty<Int> ())))
}
