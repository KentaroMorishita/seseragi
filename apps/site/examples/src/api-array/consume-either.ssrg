import * as arrays from "std/array"

fn batchLabel size: Int -> values: Array<Int> -> String = match arrays.chunksOf size values {
  Right batches -> "batches: " + show batches
  Left error -> "invalid: " + show error
}

pub effect fn main = do {
  _ <- println (batchLabel 2 [10, 20, 30])
  println (batchLabel 0 [10, 20, 30])
}
