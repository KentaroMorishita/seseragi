import * as graphemes from "std/text/grapheme"

fn preview start: Int -> end: Int -> label: String -> String =
  match graphemes.slice start end label {
    Right part -> "preview: [" + part + "]"
    Left reason -> "invalid: " + show reason
  }

let label = "A👍🏽e\u{0301}"
pub effect fn main =
  println `${preview 0 2 label}
${preview 1 3 label}
${preview 2 2 label}
${preview 0 4 label}
${preview 2 1 label}
${preview (-1) 2 label}
${preview 0 0 ""}`
