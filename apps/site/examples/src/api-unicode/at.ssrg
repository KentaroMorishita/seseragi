import * as graphemes from "std/text/grapheme"

fn labelAt index: Int -> value: String -> String = match graphemes.at index value {
  Just piece -> "found: " + piece
  Nothing -> "not found"
}

let label = "A👍🏽e\u{0301}"
pub effect fn main =
  println `${labelAt 1 label}
${labelAt 2 label}
${labelAt (-1) label}
${labelAt 3 label}
${labelAt 0 ""}`
