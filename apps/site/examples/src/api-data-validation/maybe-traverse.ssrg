import * as maybe from "std/maybe"
import * as text from "std/text"
fn findSeat code: String -> Maybe<Int> =
  if code == "A" then Just 1 else if code == "B" then Just 2 else Nothing
fn describe result: Maybe<Array<Int>> -> String = match result {
  Just seats -> "Seats: [" + text.join "," (map (\seat: Int -> show seat) seats) + "]"
  Nothing -> "Missing seat"
}
pub effect fn main = do {
  println (describe (maybe.traverse findSeat ["B", "A"]))
  println (describe (maybe.traverse findSeat ["unknown", "A"]))
  println (describe (maybe.traverse findSeat ["B", "unknown", "A"]))
  println (describe (maybe.traverse findSeat []))
}
