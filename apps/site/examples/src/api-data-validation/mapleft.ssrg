import * as either from "std/either"
fn requireSeats seats: Int -> Either<String, Int> =
  if seats > 0 then Right seats else Left "seats must be positive"
fn addField error: String -> String = "seats field: " + error
fn describe result: Either<String, Int> -> String = match result {
  Right seats -> "Seats: " + show seats
  Left error -> "Cannot book: " + error
}
pub effect fn main = do {
  println (describe (either.mapLeft addField (requireSeats 0)))
  println (describe (either.mapLeft addField (requireSeats 2)))
}
