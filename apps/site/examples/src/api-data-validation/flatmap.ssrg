fn requireSeats seats: Int -> Either<String, Int> =
  if seats > 0 then Right seats else Left "seats must be positive"
fn quote seats: Int -> Either<String, Int> =
  if seats > 5 then Left "too many seats" else Right (seats * 20)
fn describe result: Either<String, Int> -> String = match result {
  Right total -> "Total: " + show total
  Left error -> "Cannot book: " + error
}
pub effect fn main = do {
  println (describe (flatMap quote (requireSeats 2)))
  println (describe (flatMap quote (requireSeats 0)))
  println (describe (flatMap quote (requireSeats 6)))
}
