import * as arrays from "std/array"
import * as text from "std/text"
import * as validation from "std/validation"
import { Validation, Valid, Invalid } from "std/validation"
import * as nonempty from "std/non-empty-list"
fn describe result: Validation<String, String> -> String = match result {
  Valid value -> "OK: " + value
  Invalid errors -> "Errors: " + text.join "; " (arrays.fromIterable errors)
}
pub effect fn main = do {
  let errors = nonempty.cons "name is required" `["seats must be positive"]
  let checked: Validation<String, String> = validation.invalidMany errors
  println (describe checked)
}
