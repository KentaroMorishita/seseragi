import * as maybe from "std/maybe"
fn describe nickname: Maybe<String> -> String = match nickname {
  Just name -> "Present: [" + name + "]"
  Nothing -> "No nickname"
}
pub effect fn main = do {
  println (describe (maybe.orElse (Just "team") (Just "Ada")))
  println (describe (maybe.orElse (Just "team") Nothing))
  println (describe (maybe.orElse Nothing Nothing))
  println (describe (maybe.orElse (Just "team") (Just "")))
}
