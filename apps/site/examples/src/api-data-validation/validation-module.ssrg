import * as arrays from "std/array"
import * as text from "std/text"
import * as validation from "std/validation"
import { Validation, Valid, Invalid } from "std/validation"
fn validateName name: String -> Validation<String, String> =
  if name == "" then validation.invalid "name is required" else validation.valid name
fn validateSeats seats: Int -> Validation<String, Int> =
  if seats > 0 then
    validation.valid seats
  else
    validation.invalid "seats must be positive"
fn bookingLabel name: String -> seats: Int -> String = name + ": " + show seats
fn validateBooking name: String -> seats: Int -> Validation<String, String> =
  pure bookingLabel
  <*> validateName name
  <*> validateSeats seats
fn describe result: Validation<String, String> -> String = match result {
  Valid value -> "OK: " + value
  Invalid errors -> "Errors: " + text.join "; " (arrays.fromIterable errors)
}
pub effect fn main = do {
  println (bookingLabel "Ada" 2)
  println (describe (validateBooking "Ada" 2))
  println (describe (validateBooking "" 2))
  println (describe (validateBooking "Ada" 0))
  println (describe (validateBooking "" 0))
}
