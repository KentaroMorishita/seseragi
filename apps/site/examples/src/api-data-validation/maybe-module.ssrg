import * as maybe from "std/maybe"
fn explain nickname: Maybe<String> -> String = match nickname {
  Just name -> "Present: [" + name + "]"
  Nothing -> "No nickname"
}
fn greet nickname: Maybe<String> -> String =
  "Hello, " + maybe.withDefault "guest" nickname
pub effect fn main = do {
  println (explain (Just "Ada"))
  println (explain Nothing)
  println (explain (Just ""))
  println (greet Nothing)
}
