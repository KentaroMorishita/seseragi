import * as html from "std/web/html"
fn card title: String -> detail: String -> html.Html<Unit> = {
  let heading: html.Html<Unit> = html.h2 { children: title }
  let description: html.Html<Unit> = html.p { children: detail }
  html.section { class: "release-card", children: [heading, description] }
}
fn page -> html.Html<Unit> = html.fragment [
  card "Release <notes>" "Search & navigation improvements",
  card "Next release" "Two smaller fixes"
]
pub effect fn main = println (html.renderToString (page ()))
