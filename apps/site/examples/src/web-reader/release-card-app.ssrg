import * as dom from "std/web/dom"
import * as html from "std/web/html"

type Action =
  | ToggleDetails

fn update action: Action -> expanded: Bool -> Bool = match action {
  ToggleDetails -> if expanded then False else True
}

fn view expanded: Bool -> html.Html<Action> = html.section {
  class: "release-card",
  children: [
    html.h2 { children: "Release <notes>" },
    html.p {
      hidden:
        if expanded then
          False
        else
          True,
      children: "Search & navigation improvements"
    },
    html.button {
      id: "toggle-details",
      onClick: ToggleDetails,
      ariaExpanded: expanded,
      children:
        if expanded then
          "Hide details"
        else
          "Show details"
    }
  ]
}

pub effect fn main = dom.app { target: "#app", initial: False, update, view }
