import * as effects from "std/effect"
import * as paths from "std/path"
import * as process from "std/process"

pub effect fn main -> Unit with Console, process: process.Process fails ConsoleError =
  do {
    result <- effects.attempt (process.currentDirectory ())
    match result {
      Right path -> println ("Directory: " + paths.render path)
      Left reason -> println ("Cannot read the directory: " + show reason)
    }
  }
