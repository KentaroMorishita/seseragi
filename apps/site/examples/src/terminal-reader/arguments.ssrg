import * as arrays from "std/array"
import * as effects from "std/effect"
import * as process from "std/process"

pub effect fn main -> Unit with Console, process: process.Process fails ConsoleError =
  do {
    result <- effects.attempt (process.arguments ())
    match result {
      Right values ->
        if arrays.isEmpty values then println "No arguments" else for value <- values {
        println ("Argument: [" + value + "]")
      }
      Left reason -> println ("Cannot read arguments: " + show reason)
    }
  }
