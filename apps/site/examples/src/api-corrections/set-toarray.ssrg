import * as sets from "std/set"
pub effect fn main = do {
  let values = sets.insert 2 (sets.insert 1 (sets.singleton 2))
  let moved = sets.insert 2 (sets.remove 2 values)
  println (show (sets.toArray values))
  println (show (sets.toArray moved))
  println (show (sets.toArray (sets.empty<Int> ())))
  println (show (sets.toArray values))
}
