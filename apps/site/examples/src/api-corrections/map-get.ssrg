import * as maps from "std/map"
fn describe value: Maybe<String> -> String = match value {
  Just text -> `found: [${text}]`
  Nothing -> "missing"
}
pub effect fn main = do {
  let names = maps.insert "empty" "" (maps.singleton "name" "Aki")
  println (describe (maps.get "name" names))
  println (describe (maps.get "empty" names))
  println (describe (maps.get "unknown" names))
  println (describe (maps.get "name" (maps.empty<String, String> ())))
}
