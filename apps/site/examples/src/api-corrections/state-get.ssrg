import * as state from "std/transformer/state"
fn describe result: Maybe<(Int, Int)> -> String = match result {
  Just (value, finalState) -> `value=${value}, state=${finalState}`
  Nothing -> "no result"
}
pub effect fn main = do {
  let readState: state.StateT<Int, Maybe, Int> = state.get ()
  println (describe (state.run 7 readState))
  println (describe (state.run 0 readState))
}
