import * as queues from "std/queue"
import * as effects from "std/effect"
type AppError deriving Show =
  | QueueFailure queues.QueueClosed
  | ConsoleFailure ConsoleError
fn takeText queue: queues.Queue<Int> -> Effect<{}, Never, String> =
  ((\value: Int -> show value) <$> queues.take queue)
  |> effects.recover (\_: queues.QueueClosed -> effects.succeed "closed")
pub effect fn main -> Unit with Console fails AppError = do {
  queue <- queues.unbounded<Int> ()
  queues.offer 10 queue |> effects.mapError QueueFailure
  queues.offer 20 queue |> effects.mapError QueueFailure
  queues.close queue
  first <- takeText queue
  second <- takeText queue
  last <- takeText queue
  println first |> effects.mapError ConsoleFailure
  println second |> effects.mapError ConsoleFailure
  println last |> effects.mapError ConsoleFailure
}
