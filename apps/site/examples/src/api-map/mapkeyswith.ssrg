import * as maps from "std/map"
import * as json from "std/json"

fn category key: String -> String = if key == "keep" then "keep" else "same"
fn combine current: String -> incoming: String -> String = current + "/" + incoming

pub effect fn main = do {
  let original = maps.fromEntries [
    ("first", "A"),
    ("keep", "K"),
    ("second", "B"),
    ("third", "C")
  ]
  println (json.encodeString (maps.entries (maps.mapKeysWith combine category original)))
  println (json.encodeString (maps.entries original))
  println (
    json.encodeString
      (maps.entries (maps.mapKeysWith combine category (maps.empty<String, String> ())))
  )
}
