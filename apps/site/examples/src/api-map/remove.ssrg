import * as maps from "std/map"
import * as json from "std/json"

pub effect fn main = do {
  let original = maps.fromEntries [("b", 2), ("a", 1)]
  let removed = maps.remove "b" original
  println (json.encodeString (maps.entries removed))
  println (json.encodeString (maps.entries (maps.remove "missing" removed)))
  println (json.encodeString (maps.entries (maps.insert "b" 8 removed)))
  println (json.encodeString (maps.entries original))
  println (json.encodeString (maps.entries (maps.remove "b" (maps.empty<String, Int> ()))))
}
