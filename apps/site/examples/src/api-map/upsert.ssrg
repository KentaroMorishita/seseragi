import * as maps from "std/map"
import * as json from "std/json"

fn update previous: Maybe<String> -> String = match previous {
  Just value -> "existing:" + value
  Nothing -> "new"
}

pub effect fn main = do {
  let original = maps.fromEntries [("empty", ""), ("name", "Aki")]
  println (json.encodeString (maps.entries (maps.upsert "empty" update original)))
  println (json.encodeString (maps.entries (maps.upsert "name" update original)))
  println (json.encodeString (maps.entries (maps.upsert "missing" update original)))
  println (json.encodeString (maps.entries original))
}
