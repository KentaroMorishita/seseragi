fn describe nickname: Maybe<String> -> String = match nickname {
  Just name -> "Nickname: [" + name + "]"
  Nothing -> "Nickname is missing"
}
pub effect fn main = do {
  let present: Maybe<String> = Just "Ada"
  let missing: Maybe<String> = Nothing
  println (describe present)
  println (describe missing)
  println (describe (Just ""))
}
