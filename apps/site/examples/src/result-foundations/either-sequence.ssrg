import * as either from "std/either"
import * as text from "std/text"
fn describe result: Either<String, Array<Int>> -> String = match result {
  Right seats -> "Seats: [" + text.join "," (map (\seat: Int -> show seat) seats) + "]"
  Left reason -> "Error: " + reason
}
pub effect fn main = do {
  let accepted: Array<Either<String, Int>> = [Right 2, Right 1]
  let firstFailed: Array<Either<String, Int>> = [Left "first", Right 1]
  let twoFailed: Array<Either<String, Int>> = [Right 2, Left "first", Left "second"]
  let empty: Array<Either<String, Int>> = []
  println (describe (either.sequence accepted))
  println (describe (either.sequence firstFailed))
  println (describe (either.sequence twoFailed))
  println (describe (either.sequence empty))
}
