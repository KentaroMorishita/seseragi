import * as either from "std/either"
fn notification result: Either<Int, String> -> String = match result {
  Left count -> "Count: " + show count
  Right reason -> "Reason: " + reason
}
pub effect fn main = do {
  let accepted: Either<String, Int> = Right 2
  let rejected: Either<String, Int> = Left "seats must be positive"
  println (notification (either.swap accepted))
  println (notification (either.swap rejected))
}
