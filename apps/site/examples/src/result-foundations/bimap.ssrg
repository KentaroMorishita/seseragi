import * as either from "std/either"
fn addField reason: String -> String = "form: " + reason
fn seatLabel count: Int -> String = "seats=" + show count
fn describe result: Either<String, String> -> String = match result {
  Right label -> "OK: " + label
  Left reason -> "Error: " + reason
}
pub effect fn main = do {
  let accepted: Either<String, Int> = Right 2
  let rejected: Either<String, Int> = Left "seats must be positive"
  println (describe (either.bimap addField seatLabel accepted))
  println (describe (either.bimap addField seatLabel rejected))
}
