import * as maybe from "std/maybe"
import * as text from "std/text"
fn describe result: Maybe<Array<Int>> -> String = match result {
  Just seats -> "Seats: [" + text.join "," (map (\seat: Int -> show seat) seats) + "]"
  Nothing -> "Missing seat"
}
pub effect fn main = do {
  let present: Array<Maybe<Int>> = [Just 2, Just 1]
  let firstMissing: Array<Maybe<Int>> = [Nothing, Just 1]
  let middleMissing: Array<Maybe<Int>> = [Just 2, Nothing, Just 1]
  let empty: Array<Maybe<Int>> = []
  println (describe (maybe.sequence present))
  println (describe (maybe.sequence firstMissing))
  println (describe (maybe.sequence middleMissing))
  println (describe (maybe.sequence empty))
}
