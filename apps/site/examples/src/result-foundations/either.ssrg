fn requireSeats count: Int -> Either<String, Int> =
  if count > 0 then Right count else Left "seats must be positive"
fn describe result: Either<String, Int> -> String = match result {
  Right count -> "Accepted: " + show count
  Left reason -> "Rejected: " + reason
}
pub effect fn main = do {
  println (describe (requireSeats 2))
  println (describe (requireSeats 0))
}
