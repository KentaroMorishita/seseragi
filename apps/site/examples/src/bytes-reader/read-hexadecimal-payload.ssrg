import * as hex from "std/bytes/hex"

fn read input: String -> String = match hex.decode input {
  Left _ -> "Rejected"
  Right content -> "Accepted: " + hex.encode content
}
pub effect fn main = for input <- [
  "00FF",
  "",
  "0",
  "00xz",
  "é0",
  "00é",
  "0x00",
  "00 00"
] {
  println (read input)
}
