import * as bytes from "std/bytes"
import * as hex from "std/bytes/hex"
import * as base64 from "std/bytes/base64"

fn encoded -> String = match bytes.fromInts [251, 255] {
  Left error -> show error
  Right content -> base64.encodeUrl content
}
fn read input: String -> String = match base64.decodeUrl input {
  Left _ -> "Rejected"
  Right content -> "Accepted: " + hex.encode content
}
pub effect fn main = for line <- [
  encoded (),
  read "-_8",
  read "",
  read "AA=",
  read "+A",
  read "AB",
  read "A"
] {
  println line
}
