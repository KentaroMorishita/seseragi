import * as bytes from "std/bytes"
import * as hex from "std/bytes/hex"

fn render values: Array<Int> -> String = match bytes.fromInts values {
  Left error -> show error
  Right content -> hex.encode content
}
pub effect fn main = for values <- [
  [0, 15, 16, 171, 255],
  []
] { println (render values) }
