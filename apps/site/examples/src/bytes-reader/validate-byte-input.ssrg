import * as bytes from "std/bytes"

fn describe values: Array<Int> -> String = match bytes.fromInts values {
  Left (bytes.ByteOutOfRange value) -> `Out of range: ${value}`
  Right content -> show (bytes.toInts content)
}
pub effect fn main = for values <- [[0, 127, 255], [1, 256, -1], [-1], []] {
  println (describe values)
}
