import * as bytes from "std/bytes"
import * as text from "std/text"

fn explain -> String = match bytes.fromInts [97, 226, 40, 161] {
  Left error -> show error
  Right content -> match text.decodeUtf8 content {
    Left (text.InvalidUtf8 { offset }) -> `Invalid UTF-8 at byte ${offset}`
    Right value -> value
  }
}
pub effect fn main = println (explain ())
