import * as hex from "std/bytes/hex"
import * as base64 from "std/bytes/base64"

fn read input: String -> String = match base64.decode input {
  Left _ -> "Rejected"
  Right content -> "Accepted: " + hex.encode content
}
pub effect fn main = for input <- [
  "Zg==",
  "",
  "Zg",
  "AA A",
  "AA=A",
  "AB==",
  "Z g==",
  "-_8",
  "Zm9v"
] {
  println (read input)
}
