import * as base64 from "std/bytes/base64"
import * as hex from "std/bytes/hex"
fn read input: String -> String = match base64.decode input {
  Right content -> "Decoded: " + hex.encode content
  Left error -> match error {
    base64.InvalidBase64Length length -> `Invalid byte length: ${length}`
    base64.InvalidBase64Digit { offset } -> `Invalid digit at byte ${offset}`
    base64.InvalidBase64Padding { offset } -> `Invalid padding at byte ${offset}`
    base64.NonCanonicalBase64Bits { offset } -> `Unused bits at byte ${offset}`
  }
}
pub effect fn main = for input <- [
  "Zg==",
  "Zg",
  "AA A",
  "AA=A",
  "AB=="
] { println (read input) }
