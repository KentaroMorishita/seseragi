import * as bytes from "std/bytes"
import * as text from "std/text"
import * as hex from "std/bytes/hex"
import * as base64 from "std/bytes/base64"

let content = text.encodeUtf8 "café"
fn decoded -> String = match text.decodeUtf8 content {
  Left _ -> "Rejected"
  Right value -> value
}
pub effect fn main =
  println `${bytes.length content}
${hex.encode content}
${base64.encode content}
${base64.encodeUrl content}
${decoded ()}`
