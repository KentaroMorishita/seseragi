import * as text from "std/text"

import * as json from "std/json"

pub effect fn main = do {
  _ <- println (json.encodeString (text.split "," "a,,b,"))
  _ <- println (json.encodeString (text.split "," ""))
  _ <- println (json.encodeString (text.split "" "A😀"))
  println (json.encodeString (text.split "" ""))
}
