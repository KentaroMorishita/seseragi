import * as text from "std/text"

import * as graphemes from "std/text/grapheme"

let value = "Aé😀e\u{301}"

pub effect fn main = do {
  _ <- println ("scalars: " + show (text.lengthScalars value))
  _ <- println ("UTF-8 bytes: " + show (text.lengthBytes value))
  println ("graphemes: " + show (graphemes.length value))
}
