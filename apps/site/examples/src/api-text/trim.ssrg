import * as text from "std/text"

pub effect fn main = do {
  _ <- println ("[" + text.trim "  A B\n" + "]")
  _ <- println ("[" + text.trim "\u{3000}A\u{3000}" + "]")
  _ <- println ("[" + text.trim " \t" + "]")
  _ <- println (show (text.lengthScalars (text.trim "\u{FEFF}A\u{FEFF}")))
  println ("[" + text.trim "" + "]")
}
