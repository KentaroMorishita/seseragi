import * as text from "std/text"

pub effect fn main = do {
  _ <- println (text.replaceAll "a" "X" "banana")
  _ <- println (text.replaceAll "aa" "X" "aaa")
  _ <- println (text.replaceAll "" ":" "A😀")
  _ <- println (text.replaceAll "a" "$&" "cat")
  println ("[" + text.replaceAll "a" "X" "" + "]")
}
