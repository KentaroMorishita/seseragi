import * as effects from "std/effect"

fn outputFailure problem: ConsoleError -> String = "output failed"

effect fn visit label: String = do {
  _ <- effects.mapError outputFailure (println ("visit: " + label))
  if label == "bad" then
    effects.fail "bad label"
  else
    effects.succeed (if label == "stop" then
      effects.Break
    else
      effects.Continue)
}

fn describe result: Either<String, Unit> -> String = match result {
  Right value -> "Completed"
  Left reason -> "Rejected: " + reason
}

effect fn preview labels: Array<String> = do {
  result <- effects.attempt (effects.forEachUntil visit labels)
  println (describe result)
}

pub effect fn main = do {
  _ <- preview ["one", "stop", "after"]
  _ <- preview ["one", "two"]
  _ <- preview []
  _ <- preview ["stop", "after"]
  preview ["one", "bad", "after"]
}
