import * as effects from "std/effect"

fn checkedTitle title: String -> Either<String, String> =
  if title == "" then Left "title is required" else Right title

fn annotate reason: String -> String = "preview: " + reason

fn describe result: Either<String, String> -> String = match result {
  Right value -> "Ready: " + value
  Left reason -> "Rejected: " + reason
}

effect fn preview title: String = do {
  result <- effects.attempt (effects.mapError annotate (effects.fromEither (checkedTitle title)))
  println (describe result)
}

pub effect fn main = do {
  _ <- preview "Search improvements"
  preview ""
}
