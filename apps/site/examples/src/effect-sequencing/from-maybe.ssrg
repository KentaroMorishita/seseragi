import * as effects from "std/effect"

fn describe result: Either<String, Int> -> String = match result {
  Right value -> "Count: " + show value
  Left reason -> "Rejected: " + reason
}

effect fn display value: Maybe<Int> = do {
  result <- effects.attempt (effects.fromMaybe "count is missing" value)
  println (describe result)
}

pub effect fn main = do {
  _ <- display (Just 2)
  _ <- display (Just 0)
  display Nothing
}
