import * as effects from "std/effect"

fn describe control: effects.LoopControl -> String = match control {
  effects.Continue -> "Continue permits the next item"
  effects.Break -> "Break stops successfully"
}

let keepGoing: effects.LoopControl = effects.Continue
let stopHere: effects.LoopControl = effects.Break

pub effect fn main = do {
  _ <- println (describe keepGoing)
  _ <- println (describe stopHere)
  result <- effects.succeed stopHere
  println (describe result)
}
