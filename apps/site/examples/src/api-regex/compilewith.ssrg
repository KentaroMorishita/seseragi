import * as regex from "std/regex"
import { RegexOptions } from "std/regex"
fn check options: RegexOptions -> source: String -> text: String -> String =
  match regex.compileWith options source {
    Left error -> `invalid pattern at byte ${error.offset}`
    Right pattern -> show (regex.isMatch pattern text)
  }
pub effect fn main = do {
  let insensitive = RegexOptions {
    caseInsensitive: True,
    multiline: False,
    dotMatchesNewline: False
  }
  let lines = RegexOptions {
    caseInsensitive: False,
    multiline: True,
    dotMatchesNewline: False
  }
  let anyScalar = RegexOptions {
    caseInsensitive: False,
    multiline: False,
    dotMatchesNewline: True
  }
  println (check insensitive "^café$" "CAFÉ")
  println (check insensitive "^straße$" "STRASSE")
  println (check lines "^id$" "first\nid\nlast")
  println (check anyScalar "^a.b$" "a\nb")
  println (check (regex.defaultOptions ()) "^a.b$" "a\nb")
}
