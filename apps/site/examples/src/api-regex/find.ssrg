import * as regex from "std/regex"
import * as maps from "std/map"
import * as arrays from "std/array"
fn describe text: String -> String =
  match regex.compile "(?<code>ORD-[0-9]+)(?:-(?<tag>[A-Z]+))?" {
    Left error -> `invalid pattern at byte ${error.offset}`
    Right pattern -> match regex.find pattern text {
      Nothing -> "no match"
      Just found -> {
        let tag = match maps.get "tag" found.named {
          Just (Just capture) -> capture.text
          Just Nothing -> "absent"
          Nothing -> "not declared"
        }
        `${found.text}: bytes ${found.span.start}..${found.span.end}; captures=${arrays.length found.captures}; tag=${tag}`
      }
    }
  }
pub effect fn main = do {
  println (describe "é ORD-42")
  println (describe "é ORD-42-X")
  println (describe "no order")
}
