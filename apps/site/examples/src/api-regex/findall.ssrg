import * as regex from "std/regex"
fn describe source: String -> text: String -> String = match regex.compile source {
  Left error -> `invalid pattern at byte ${error.offset}`
  Right pattern -> show [`${found.span.start}..${found.span.end}:${found.text}` | found <- regex.findAll
      pattern text]
}
pub effect fn main = do {
  println (describe "ORD-[0-9]+" "ORD-1 ORD-2")
  println (describe "ORD-[0-9]+" "none")
  println (describe "" "a👍")
  println (describe "a|aa" "xaa")
  println (describe "a+" "xaa")
  println (describe "." "👍🏽")
}
