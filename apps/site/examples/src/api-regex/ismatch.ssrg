import * as regex from "std/regex"
fn check source: String -> text: String -> String = match regex.compile source {
  Left error -> `invalid pattern at byte ${error.offset}`
  Right pattern -> show (regex.isMatch pattern text)
}
pub effect fn main = do {
  println (check "ORD-[0-9]+" "memo ORD-42")
  println (check "^ORD-[0-9]+$" "memo ORD-42")
  println (check "\\d+" "123")
  println (check "\\d+" "٣")
  println (check "^\\w+$" "漢_٣")
}
