import * as regex from "std/regex"
fn containsLiteral wanted: String -> text: String -> String =
  match regex.compile (regex.escape wanted) {
    Left error -> `invalid pattern at byte ${error.offset}`
    Right pattern -> show (regex.isMatch pattern text)
  }
pub effect fn main = do {
  println (regex.escape "a+b.txt")
  println (containsLiteral "a+b.txt" "file a+b.txt ready")
  println (containsLiteral "a+b.txt" "file aaabXtxt ready")
  println (containsLiteral "" "anything")
}
