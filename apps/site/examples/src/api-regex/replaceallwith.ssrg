import * as regex from "std/regex"
import * as arrays from "std/array"

fn replacement found: regex.RegexMatch -> String = match arrays.get 0 found.captures {
  Just (Just capture) -> "[" + capture.text + "]"
  Just Nothing -> "[absent]"
  Nothing -> "[no group]"
}

fn replace text: String -> String = match regex.compile "x([0-9]+)?" {
  Left error -> `invalid pattern at byte ${error.offset}`
  Right pattern -> regex.replaceAllWith pattern replacement text
}

pub effect fn main = do {
  println (replace "x12 x x3")
  println (replace "nothing to replace")
  println ("empty: [" + replace "" + "]")
}
