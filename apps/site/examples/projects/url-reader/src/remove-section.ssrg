import * as navigation from "std/web/navigation"

fn wholePage input: String -> String = match navigation.parseUrl input {
  Left _ -> "Link rejected"
  Right original -> {
    let cleared = navigation.withoutFragment original
    let again = navigation.withoutFragment cleared
    navigation.renderUrl cleared + "\n" + navigation.renderUrl again
  }
}

pub effect fn main = println (wholePage "https://example.test/search?q=tea#results")
