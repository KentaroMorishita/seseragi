import * as navigation from "std/web/navigation"

fn shareLink input: String -> String = match navigation.parseUrl input {
  Left _ -> "Link rejected"
  Right original -> {
    let oldQuery = navigation.urlQuery original
    let newSearch = navigation.setQuery "q" "tea & cake" oldQuery
    let firstPage = navigation.removeQuery "page" newSearch
    let selectedTags = navigation.appendQuery "tag" "sale" firstPage
    let filtered = navigation.withQuery selectedTags original
    let shareable = navigation.withFragment "results" filtered
    navigation.renderUrl shareable
  }
}

pub effect fn main =
  println (shareLink "https://example.test/search?q=old&page=3&tag=books&tag=music#summary")
