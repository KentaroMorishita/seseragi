import * as navigation from "std/web/navigation"

fn normalized input: String -> String = match navigation.parseUrl input {
  Left _ -> "Link rejected"
  Right url -> {
    let query = navigation.urlQuery url
    let rebuilt = navigation.withQuery query url
    navigation.renderUrl url + "\n" + navigation.renderUrl rebuilt
  }
}

pub effect fn main =
  println (normalized "HTTPS://EXAMPLE.TEST:443/a/../search?q=tea%20cake~#results")
