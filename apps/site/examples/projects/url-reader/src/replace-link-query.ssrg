import * as navigation from "std/web/navigation"

fn replaceFilters input: String -> String = match navigation.parseUrl input {
  Left _ -> "Link rejected"
  Right original -> {
    let oldQuery = navigation.urlQuery original
    let replacement = navigation.appendQuery "q" "tea" navigation.emptyQuery
    let changed = navigation.withQuery replacement original
    let cleared = navigation.withQuery navigation.emptyQuery original
    navigation.renderQuery oldQuery + "\n" + navigation.renderUrl changed + "\n" + navigation.renderUrl cleared + "\n" + navigation.renderUrl original
  }
}

pub effect fn main =
  println (replaceFilters "https://example.test/search?tag=books&page=3#results")
