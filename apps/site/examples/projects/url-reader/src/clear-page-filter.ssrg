import * as navigation from "std/web/navigation"

fn firstPage input: String -> String = match navigation.parseQuery input {
  Left _ -> "Query rejected"
  Right original -> {
    let cleared = navigation.removeQuery "page" original
    let unchanged = navigation.removeQuery "missing" cleared
    navigation.renderQuery cleared + "\n" + navigation.renderQuery unchanged
  }
}

pub effect fn main = println (firstPage "q=tea&page=3&tag=books&page=4")
