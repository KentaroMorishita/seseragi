import * as navigation from "std/web/navigation"

fn sectionText url: navigation.Url -> String = match navigation.urlFragment url {
  Nothing -> "No section"
  Just section -> "Section: " + section
}

fn sectionLink input: String -> String = match navigation.parseUrl input {
  Left _ -> "Link rejected"
  Right original -> {
    let changed = navigation.withFragment "results 2" original
    navigation.renderUrl changed + "\n" + sectionText changed + "\n" + sectionText original
  }
}

pub effect fn main = println (sectionLink "https://example.test/search?q=tea")
