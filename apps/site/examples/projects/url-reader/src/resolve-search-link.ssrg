import * as navigation from "std/web/navigation"

fn searchLink baseText: String -> String = match navigation.parseUrl baseText {
  Left _ -> "Base link rejected"
  Right base -> match navigation.resolveUrl "../search?tag=books" base {
    Left _ -> "Search link rejected"
    Right resolved -> navigation.renderUrl resolved
  }
}

pub effect fn main = do {
  _ <- println (searchLink "https://example.test/catalog/item")
  println (searchLink "https://example.test/catalog/item/")
}
