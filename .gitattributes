# Hash-pinned upstream bytes must not be normalized or whitespace-cleaned.
runtime/unicode/ucd/** -text whitespace=-blank-at-eol,-blank-at-eof

# The canonical renderer emits a trailing space for Right of the empty String.
examples/spec/artifacts/execution-schema-1/unicode-text/stdout.txt -text whitespace=-blank-at-eol

# The native file acceptance compares bytes and validates package content locks.
examples/spec/fixtures/rust-backend/filesystem-* text eol=lf
examples/spec/fixtures/rust-backend/path-portable.* text eol=lf
examples/spec/fixtures/rust-backend-projects/filesystem/** text eol=lf

# Fiber/Deferred acceptance traces compare source bytes across hosts.
examples/spec/fixtures/rust-backend/fiber-* text eol=lf
examples/spec/fixtures/rust-backend/deferred-* text eol=lf

# The Effect WASM package lock pins manifest, source and bridge bytes.
examples/spec/fixtures/rust-backend-projects/program-wasm-effect-package/** text eol=lf

# Imported type acceptance packages pin manifest and source bytes in their lock.
examples/spec/fixtures/rust-backend-projects/imported-unit-*/** text eol=lf

# Program stdout fixtures are byte-exact oracles, including line endings.
*.stdout -text
