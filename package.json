{
  "name": "seseragi",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "description": "Seseragi compiler and tooling workspace",
  "license": "Apache-2.0",
  "scripts": {
    "build": "./scripts/build.sh",
    "check": "./scripts/check.sh",
    "check:full": "./scripts/check-scoped.sh full",
    "check:readme": "bun scripts/check-readme.ts",
    "check:sample": "./scripts/check-scoped.sh sample",
    "check:playground": "./scripts/check-scoped.sh playground",
    "check:rust": "./scripts/check-scoped.sh rust",
    "check:conformance": "./scripts/check-scoped.sh conformance",
    "check:wasm": "./scripts/check-scoped.sh wasm",
    "check:extension": "./scripts/check-scoped.sh extension",
    "check:release": "./scripts/check-scoped.sh release",
    "check:release-gate": "./scripts/check-scoped.sh release-gate",
    "format": "./scripts/format.sh",
    "release:info": "bun scripts/release-contract.ts info",
    "release:sync": "bun scripts/release-contract.ts sync",
    "release:check": "bun scripts/release-contract.ts check",
    "release:check-tag": "bun scripts/release-contract.ts check-tag",
    "release:readiness": "bun scripts/release-readiness.ts info",
    "release:readiness:check": "bun scripts/release-readiness.ts check",
    "release:notes": "bun scripts/release-contract.ts notes",
    "release:bump": "bun scripts/release-contract.ts bump",
    "release:native": "bun scripts/native-release.ts",
    "cli": "cargo run -p seseragi-cli --",
    "conformance": "cargo run -p seseragi-conformance -- .",
    "test:samples:cli": "bun scripts/check-samples-cli.ts",
    "tour:diagnostics:update": "bun scripts/check-samples-cli.ts --update-tour-diagnostics",
    "deep-dive:diagnostics:update": "bun scripts/check-samples-cli.ts --update-deep-dive-diagnostics",
    "test:playground:wasm": "./scripts/build-playground-wasm.sh apps/playground/src/wasm/pkg && git diff --exit-code -- apps/playground/src/wasm/pkg && cd apps/playground && bun run test",
    "dev:playground": "cd apps/playground && bun run dev",
    "build:playground": "cd apps/playground && bun run build",
    "build:playground:wasm": "./scripts/build-playground-wasm.sh apps/playground/src/wasm/pkg",
    "build:extension": "cd extensions/seseragi && bun install --frozen-lockfile && bun ../../scripts/check-extension-identity.ts && bun run package && bun run package:legacy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "@types/bun": "latest"
  }
}
