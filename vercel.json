{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/playground && bun run build",
  "outputDirectory": "apps/playground/dist",
  "installCommand": "cd apps/playground && bun install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/en/deep-dive",
      "destination": "/deep-dive/index.html"
    },
    {
      "source": "/en/deep-dive/(.*)",
      "destination": "/deep-dive/index.html"
    },
    {
      "source": "/en/tour",
      "destination": "/en/tour/index.html"
    },
    {
      "source": "/en/tour/(.*)",
      "destination": "/en/tour/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/(.*)",
      "destination": "/en/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
