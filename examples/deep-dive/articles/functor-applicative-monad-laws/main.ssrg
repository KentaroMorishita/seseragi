fn identityInt value: Int -> Int = value
fn increment value: Int -> Int = value + 1
fn double value: Int -> Int = value * 2
fn incrementThenDouble value: Int -> Int = double $ increment value
fn wrapMaybe value: Int -> Maybe<Int> = Just value
fn stepA value: Int -> Maybe<Int> = Just $ value + 1
fn stepB value: Int -> Maybe<Int> = Just $ value * 2
fn stepAB value: Int -> Maybe<Int> = stepA value >>= stepB

fn render value: Maybe<Int> -> String = match value {
  Nothing -> "Nothing"
  Just 21 -> "Just 21"
  Just 41 -> "Just 41"
  Just 42 -> "Just 42"
  Just 82 -> "Just 82"
  Just _ -> "Just another value"
}

fn report label: String -> left: Maybe<Int> -> right: Maybe<Int> -> String =
  if render left == render right then label + ": ok" else label + ": failed"

pub effect fn main = do {
  report "Functor identity" (identityInt <$> Just 21) (Just 21) |> println
  report "Functor composition" (incrementThenDouble <$> Just 20) (double <$> (increment <$> Just 20))
    |> println
  report "Applicative identity" (pure identityInt <*> Just 21) (Just 21) |> println
  report "Applicative homomorphism" (pure increment <*> pure 41) (pure 42) |> println
  report "Monad left identity" (pure 40 >>= stepA) (stepA 40) |> println
  report "Monad right identity" (Just 41 >>= wrapMaybe) (Just 41) |> println
  report "Monad associativity" (Just 40 >>= stepA >>= stepB) (Just 40 >>= stepAB)
    |> println
}
