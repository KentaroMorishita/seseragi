{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seseragi design article",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "relatedTourLessons",
    "relatedLinks",
    "sections"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "relatedTourLessons": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "relatedLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
