{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seseragi Deep Dive article",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "prerequisites",
    "tourPrerequisites",
    "relatedTourLessons",
    "sections",
    "recap",
    "files"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "tourPrerequisites": { "type": "array", "items": { "type": "string" } },
    "relatedTourLessons": { "type": "array", "items": { "type": "string" } },
    "recap": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "files": {
      "type": "object",
      "required": [
        "source",
        "expectedOutput",
        "diagnosticExample",
        "diagnosticOutput"
      ],
      "properties": {
        "source": { "const": "main.ssrg" },
        "expectedOutput": { "const": "stdout.txt" },
        "diagnosticExample": { "const": "diagnostic.ssrg" },
        "diagnosticOutput": { "const": "diagnostic.txt" }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
