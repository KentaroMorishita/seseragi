{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seseragi Deep Dive article",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "prerequisites",
    "tourPrerequisites",
    "relatedTourLessons",
    "sections"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "tourPrerequisites": { "type": "array", "items": { "type": "string" } },
    "relatedTourLessons": { "type": "array", "items": { "type": "string" } },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
