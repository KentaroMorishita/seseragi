import * as bytes from "std/bytes"

pub opaque struct Postgres { token: Unit }
pub opaque struct Pool { token: Unit }
pub opaque struct Transaction { token: Unit }
pub opaque struct Cursor { token: Unit }
pub opaque struct Row { token: Unit }
pub opaque struct Value { token: Unit }
pub opaque struct Decoder<A> { token: Unit }
pub opaque struct TransactionProgram<A> { token: Unit }

pub struct Config { connectionString: String, maxConnections: Int, }

pub struct Query { text: String, values: Array<Value>, }

pub struct QueryResult<A> { rows: Array<A>, rowCount: Int, command: String, }

pub struct DriverError deriving Show { operation: String, code: String, message: String, }

pub type RowDecodeError deriving Show =
  | MissingColumn String
  | UnexpectedColumnType String
  | IntOutsideRange String

pub type Error deriving Show =
  | DriverFailure DriverError
  | RowDecodeFailure RowDecodeError

fn unavailable -> Error = DriverFailure (DriverError {
  operation: "package",
  code: "POSTGRES_UNAVAILABLE",
  message: "PostgreSQL runtime operation was not linked",
})

pub fn textValue value: String -> Value = Value { token: () }
pub fn intValue value: Int -> Value = Value { token: () }
pub fn floatValue value: Float -> Value = Value { token: () }
pub fn boolValue value: Bool -> Value = Value { token: () }
pub fn bytesValue value: bytes.Bytes -> Value = Value { token: () }
pub fn nullValue -> Value = Value { token: () }
pub fn emptyValues -> Array<Value> = [Value { token: () }]

pub fn string column: String -> Decoder<String> = Decoder { token: () }

pub fn int column: String -> Decoder<Int> = Decoder { token: () }

pub fn float column: String -> Decoder<Float> = Decoder { token: () }

pub fn bool column: String -> Decoder<Bool> = Decoder { token: () }

pub fn bytes column: String -> Decoder<bytes.Bytes> = Decoder { token: () }

pub fn map2<A, B, C> combine: (A -> B -> C)
  -> first: Decoder<A>
  -> second: Decoder<B>
  -> Decoder<C> =
  Decoder {
    token: ()
  }

pub effect fn openPool config: Config -> Pool with postgres: Postgres fails Error =
  fail (unavailable ())

pub effect fn query<A> pool: Pool
  -> query: Query
  -> decoder: Decoder<A>
  -> QueryResult<A>
with postgres: Postgres
fails Error =
  fail (unavailable ())

pub fn transactionQuery<A> query: Query
  -> decoder: Decoder<A>
  -> TransactionProgram<QueryResult<A>> =
  TransactionProgram {
    token: ()
  }

pub effect fn transaction<A> pool: Pool
  -> program: TransactionProgram<A>
  -> A
with postgres: Postgres
fails Error =
  fail (unavailable ())

pub effect fn openCursor query: Query
  -> pool: Pool
  -> Cursor
with postgres: Postgres
fails Error =
  fail (unavailable ())

pub effect fn fetch<A> limit: Int
  -> decoder: Decoder<A>
  -> cursor: Cursor
  -> Array<A>
with postgres: Postgres
fails Error =
  fail (unavailable ())

pub effect fn closeCursor cursor: Cursor -> Unit with postgres: Postgres fails Error =
  fail (unavailable ())

pub effect fn closePool pool: Pool -> Unit with postgres: Postgres fails Error =
  fail (unavailable ())
