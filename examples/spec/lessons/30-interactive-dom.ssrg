// Lesson 30: Signal から、操作できる DOM を安全に動かす
// 前提: Lessons 15, 18, 27
// Test target: test-web
// Test services: ./30-interactive-dom.services.json

import * as dom from "std/web/dom"
import * as effects from "std/effect"
import * as html from "std/web/html"
import * as signals from "std/signal"

type Msg =
  | Increment
  | Stop

type DispatchError =
  | StopRequested

type AppError deriving Show =
  | DomFailure dom.DomError
  | ConsoleFailure ConsoleError

// view は今の値から Html を作るだけの純粋な関数です。DOM の要素やイベントの受け取りを持ちません。
fn view count: Int -> html.Html<Msg> = html.div {
  children: [
    html.span { id: "count", children: show count },
    html.button { id: "increment", onClick: Increment, children: "+" },
    html.button { id: "stop", onClick: Stop, children: "stop" },
  ]
}

// イベントは Msg として、来た順に渡されます。Increment は Signal を更新し、Stop は mount を終わらせます。
fn dispatch count: MutableSignal<Int>
  -> message: Msg
  -> Effect<{}, DispatchError, Unit> =
  match message {
    Increment -> signals.update (\value -> value + 1) count
    Stop -> effects.fail StopRequested
  }

pub effect fn main -> Unit with Console, Dom fails AppError = do {
  count <- signals.make 0
  let content = signals.map view count

  target <- dom.query "#app" |> effects.mapError DomFailure

  // run は、取り付け、待つこと、取り外しを1つの範囲（scope）にまとめます。
  // Stop を配送したときの失敗だけを正常な終わりとして受け取り、イベントの受け取りと購読の後片付けを待ちます。
  dom.run (dom.defaultOptions ()) target (dispatch count) content
    |> effects.recover (\failure -> match failure {
      dom.DispatchFailure StopRequested -> effects.succeed ()
      dom.DomFailure error -> effects.fail $ DomFailure error
    }
  )

  finalCount <- *count
  println `count: ${finalCount}` |> effects.mapError ConsoleFailure
}

// Expected stdout:
// count: 1
