// Lesson 24: タイムゾーンで、あいまいな現地時刻や存在しない現地時刻を明示的に扱う
// 前提: Lessons 10, 17, 23

import * as effects from "std/effect"
import * as time from "std/time"

type AppError deriving Show =
  | InvalidLocalTime time.DateTimeError
  | TimeZoneFailure time.TimeZoneError
  | ConsoleFailure ConsoleError

pub effect fn main -> Unit with Console, TimeZones fails AppError = do {
  // Europe/Berlin では、この現地時刻は、夏時間が始まるときに飛ばされる時間帯にあります。
  local <- time.parseLocalDateTime "2024-03-31T02:30:00"
    |> effects.fromEither
    |> effects.mapError InvalidLocalTime

  berlin <- time.loadTimeZone "Europe/Berlin" |> effects.mapError TimeZoneFailure

  // resolveLocal は勝手に 03:30 へ直さず、Gap を値として返します。
  let message = match time.resolveLocal local berlin {
    time.Unique _ -> "unique local time"
    time.Ambiguous _ -> "ambiguous local time"
    time.Gap _ -> "nonexistent local time"
  }

  println message |> effects.mapError ConsoleFailure
}

// Expected stdout:
// nonexistent local time
