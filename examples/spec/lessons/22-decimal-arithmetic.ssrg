// Lesson 22: Decimal の誤差のない計算と、明示的な丸めを学ぶ
// 前提: Lessons 08, 10, 21

import { Decimal } from "std/decimal"
import * as decimal from "std/decimal"

// Decimal の足し算と掛け算では、丸めは起きません。
// 読み取りの失敗は、例外ではなく Either の失敗として扱います。
fn invoiceTotal -> Either<decimal.DecimalParseError, Decimal> = do {
  coffee <- decimal.parse "12.50"
  cake <- decimal.parse "3.25"
  pure (coffee + cake * decimal.fromInt 2)
}

pub effect fn main -> Unit with Console fails ConsoleError = match invoiceTotal () {
  Left error -> println $ `decimal error: ${error}`
  Right total ->
  // Show は、要らない末尾の0を除いた、決まった形で表示します。
  println $ `total: ${show total}`
}

// Expected stdout:
// total: 19
