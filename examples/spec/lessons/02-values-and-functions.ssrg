// Lesson 02: 値、型、カリー化した関数を学ぶ
// 前提: Lesson 01

// 引数と戻り値に型を書きます。引数が複数あるときは -> でつなぎ、1つずつ受け取る関数（カリー化した関数）になります。
fn add left: Int -> right: Int -> Int = left + right

// let は変わらない値に名前を付けます。ここでは右辺から Int と推論します。
let base = 20

// 関数を呼ぶときは、関数と引数を空白で区切ります。add base 22 は (add base) 22 のように左から順に適用します。
let answer = add base 22

// Char は Unicode の文字（スカラー値）1つです。数値の _ は読みやすくするためだけのもので、値は変わりません。
let initial: Char = '瀬'
let million: Int = 1_000_000

pub effect fn main -> Unit with Console fails ConsoleError =
  // 文字列の中の ${...} は、Show を使って値を文字列にします。$ は優先順位の低い関数適用で、右側を先にまとめます。
  println $ `answer: ${answer}, initial: ${initial}, million: ${million}`

// Expected stdout:
// answer: 42, initial: 瀬, million: 1000000
