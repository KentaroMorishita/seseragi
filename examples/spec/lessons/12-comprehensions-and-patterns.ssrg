// Lesson 12: 内包表記、Array の残りのパターン、レコードのパターンを学ぶ
// 前提: Lessons 04, 11

import * as arrays from "std/array"

// 内包表記は、要素を取り出す部分と条件を左から右に処理して、Array を作ります。
fn oddPairs limit: Int -> Array<(Int, Int)> = [
  (left, right) | left <- 1 ..= limit,
  right <- 1 ..= limit,
  left < right,
  (left + right) % 2 != 0
]

fn describe pairs: Array<(Int, Int)> -> String = match pairs {
  // ...rest は、先頭以外の要素を同じ型の Array として受け取ります。
  [(left, right), ...rest] -> {
    let summary = { first: `${left} + ${right}`, remaining: arrays.length rest, }

    // レコードのパターンは、必要なフィールドだけを形で取り出します。
    match summary {
      { first, remaining } -> `${first}; remaining: ${remaining}`
    }
  }
  [] -> "no pairs"
}

pub effect fn main -> Unit with Console fails ConsoleError =
  println $
  describe $
  oddPairs 4

// Expected stdout:
// 1 + 2; remaining: 3
