// Lesson 05: 基礎構文を組み合わせてFizzBuzzを書く
// 前提: Lessons 01-04

// match は値をパターンで分けます。タプルにすると、いくつかの条件を一度に調べられます。
fn fizzBuzz number: Int -> String = match (number % 3, number % 5) {
  (0, 0) -> "FizzBuzz"
  (0, _) -> "Fizz"
  (_, 0) -> "Buzz"
  _ -> `${number}`
}

// effect fn は副作用を型に書きます。for は範囲を順に回り、それぞれの Effect を1つずつ実行します。
pub effect fn main -> Unit with Console fails ConsoleError = for number <- 1 ..= 100 {
  println $ fizzBuzz number
}

// Expected stdout: ./05-fizzbuzz.stdout
