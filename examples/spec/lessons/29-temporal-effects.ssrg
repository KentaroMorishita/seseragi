// Lesson 29: 再試行、繰り返し、時間切れを、毎回同じに動く Schedule で扱う
// 前提: Lessons 10, 18, 24

import * as effects from "std/effect"
import * as refs from "std/ref"
import * as time from "std/time"

type AttemptError deriving Show =
  | NotReady Int

type AppError deriving Show =
  | ScheduleFailure effects.ScheduleError
  | AttemptFailure AttemptError
  | ConsoleFailure ConsoleError

pub effect fn main -> Unit with Console, Clock fails AppError = do {
  retryCount <- refs.make 0

  // Effect は実行するまで動かないので、再試行のたびに defer の中身が最初から実行されます。
  // この処理は最初の2回だけ失敗し、3回目に成功します。
  let flaky = effects.defer<{}, AttemptError, Int> $ \_ -> do {
    attempt <- refs.modify (\count: Int -> (count + 1, count + 1)) retryCount
    if attempt < 3 then effects.fail $ NotReady attempt else effects.succeed attempt
  }

  // spaced の数は「全部で何回実行するか」ではなく、最初の実行の後に何回まで追加で実行するかです。
  retryPolicy <- effects.spaced<AttemptError> 2 (time.zeroDuration ())
    |> effects.fromEither
    |> effects.mapError ScheduleFailure

  successfulAttempt <- effects.retry retryPolicy flaky
    |> effects.mapError AttemptFailure

  repeatCount <- refs.make 0
  repeatPolicy <- effects.recurs<Int> 2
    |> effects.fromEither
    |> effects.mapError ScheduleFailure

  // repeat は成功の値を Schedule に渡し、止まるまで同じ Effect をもう1度実行します。
  finalCount <- refs.modify (\count: Int -> (count + 1, count + 1)) repeatCount
    |> effects.repeat repeatPolicy

  // 時間切れが0でも、元の処理を先に始めます。同じ回ですぐに成功すれば、元の処理が勝ちます。
  immediate <- effects.succeed "ready" |> effects.timeout (time.zeroDuration ())

  println `retry attempt: ${successfulAttempt}` |> effects.mapError ConsoleFailure
  println `repeat result: ${finalCount}` |> effects.mapError ConsoleFailure
  println `timeout result: ${show immediate}` |> effects.mapError ConsoleFailure
}

// Expected stdout:
// retry attempt: 3
// repeat result: 3
// timeout result: Just ready
