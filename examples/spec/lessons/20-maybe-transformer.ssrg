// Lesson 20: MaybeT で、Maybe の「値がなければそこで止まる」を Effect に重ねる
// 前提: Lessons 10, 18

import { MaybeT } from "std/transformer/maybe"
import * as maybeT from "std/transformer/maybe"

struct User { name: String, }

// アプリで使う、重ねた型（モナド変換子）に、型の別名で短い名前を付けます。
alias App<A> = MaybeT<Effect<{ console: Console }, ConsoleError, _>, A>

fn findUser id: Int -> Maybe<User> =
  if id == 1 then Just (User { name: "Aki" }) else Nothing

fn greet userId: Int -> App<Unit> = do {
  // fromMaybe は、Nothing を MaybeT の「そこで止まる」として持ち上げます。
  user <- maybeT.fromMaybe (findUser userId)

  // lift は、元の Effect を MaybeT の中に入れます。Effect をその場で実行するわけではありません。
  maybeT.lift $ println $ `Hello, ${user.name}!`
}

pub effect fn main -> Unit with Console fails ConsoleError =
  // run は MaybeT を1枚だけはがします。残った Maybe は map で Unit にして、main の戻り値の型に合わせます。
  maybeT.run (greet 1) |> map (\_ -> ())

// Expected stdout:
// Hello, Aki!
