// Lesson 11: 型を引数に取る struct、メソッド、型の別名を学ぶ
// 前提: Lessons 07, 10

// 型の別名（alias）は新しい型を作らず、型に使い回せる名前を付けます。
alias Named<A> = { name: String, value: A }

// Box<A> は A の値を持ちます。作るときは、フィールドの値から A を推論します。
struct Box<A> deriving Eq, Show { value: A, }

impl<A> Box<A> {
  fn get self: Box<A> -> A = self.value

  // メソッドで新しい型引数 B を使い、Box<A> を Box<B> に変換します。

  fn map<B> self: Box<A> -> f: (A -> B) -> Box<B> = Box { value: f self.value }
}

fn named<A> name: String -> value: A -> Named<A> = { name, value }

let answer = Box { value: 21 }
let doubled = answer.map (\value -> value * 2)
let result = named "answer" doubled.get

pub effect fn main -> Unit with Console fails ConsoleError =
  println $
  `${result.name}: ${result.value}`

// Expected stdout:
// answer: 42
