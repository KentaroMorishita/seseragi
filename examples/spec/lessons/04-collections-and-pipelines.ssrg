// Lesson 04: Array、ラムダ、パイプラインを学ぶ
// 前提: Lessons 02-03

import * as arrays from "std/array"

let numbers = [1, 2, 3, 4, 5]

// |> は左の値を次の関数の最後の引数に渡します。処理の順が上から下へ読めます。
let total = numbers
  // ラムダ（名前のない関数）は \引数 -> 式 と書きます。map は Array の各要素を変換します。
  |> map (\value -> value * value) |> arrays.filter (\value -> value % 2 == 0)
  // sum は数値の並びを足し合わせます。空なら zero () を返します。
  |> sum

// find は最初に見つかったところで探すのをやめます。break の代わりに、目的を表す名前の関数を使います。
let firstLarge = arrays.find (\value -> value > 3) numbers
let firstLargeText = match firstLarge {
  Just value -> show value
  Nothing -> "none"
}

pub effect fn main -> Unit with Console fails ConsoleError =
  println $
  `total: ${total}, first large: ${firstLargeText}`

// Expected stdout:
// total: 20, first large: 4
