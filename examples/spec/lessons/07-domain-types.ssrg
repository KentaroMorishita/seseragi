// Lesson 07: struct、代数的データ型、newtype で分野のデータを表す
// 前提: Lessons 03-05

// 代数的データ型は、取りうる場合をコンストラクターとして並べます。並べていない状態は作れません。
type Rank deriving Eq, Show =
  | Bronze
  | Silver
  | Gold

// newtype は、中身が Int でも、型検査では Int と別の型として扱います。
newtype Score deriving Eq, Ord, Show = Int

// 演算子 + を Score 同士の足し算として定義します。Int との暗黙の変換はしません。
impl Score {
  operator + self -> other: Score -> Score = match (self, other) {
    (Score left, Score right) -> Score (left + right)
  }
}

fn addBonus score: Score -> Score = score + Score 10

// struct は名前のあるフィールドを持ち、名前で区別される型です。フィールドの型にも、分野の型を使えます。
struct Player deriving Eq, Show { name: String, score: Score, rank: Rank, }

let player = Player { name: "Aki", score: Score 32, rank: Gold, }

// deriving Show により、Score や Rank の名前を残したまま表示できます。
pub effect fn main -> Unit with Console fails ConsoleError =
  println $
  `${player.name}: ${show player.rank}, ${show $ addBonus player.score}`

// Expected stdout:
// Aki: Gold, Score 42
