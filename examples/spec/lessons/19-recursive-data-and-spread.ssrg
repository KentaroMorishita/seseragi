// Lesson 19: 型引数を持つ代数的データ型、再帰する関数、レコードの展開を学ぶ
// 前提: Lessons 11-14

// 再帰する代数的データ型では、再帰する位置にも同じ型引数 A を書きます。
type Tree<A> deriving Eq, Show =
  | Leaf A
  | Branch (Tree<A>, Tree<A>)

// 名前のある関数は、自分自身を呼べます。rec のまとまりが要るのは、互いに呼び合うときだけです。
fn mapTree<A, B> f: (A -> B) -> tree: Tree<A> -> Tree<B> = match tree {
  Leaf value -> Leaf (f value)
  Branch (left, right) -> Branch (mapTree f left, mapTree f right)
}

fn sumTree tree: Tree<Int> -> Int = {
  // ブロックの中の関数は、それより前の値を取り込みます。自分自身と、後に書いたものから呼べます。
  fn loop current: Tree<Int> -> Int = match current {
    Leaf value -> value
    Branch (left, right) -> loop left + loop right
  }

  loop tree
}

let tree = Branch (Branch (Leaf 1, Leaf 2), Branch (Leaf 3, Leaf 4))

let doubled = mapTree (\value -> value * 2) tree
let baseSummary = { label: "doubled tree", total: 0 }

// レコードの展開は元のレコードを変えず、後に書いたフィールドの値だけを置き換えます。
let summary = { ...baseSummary, total: sumTree doubled }

pub effect fn main -> Unit with Console fails ConsoleError =
  println $
  `${summary.label}: ${summary.total}`

// Expected stdout:
// doubled tree: 20
