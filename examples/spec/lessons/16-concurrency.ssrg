// Lesson 16: 親子で管理する Fiber、Deferred、join を学ぶ
// 前提: Lesson 10

import * as deferred from "std/deferred"
import * as effects from "std/effect"

pub effect fn main -> Unit with Console fails ConsoleError = do {
  // Deferred は1度だけ値が決まる入れ物です。ここでは、作業が始まった合図に使います。
  gate <- deferred.make<Never, Int> ()

  // fork した Fiber は今の範囲（scope）の子になり、範囲が終わった後まで勝手に動き続けません。
  worker <- effects.fork $ do {
    value <- deferred.await gate
    println $ `worker: ${value}`
  }

  deferred.succeed 42 gate
  // join は作業が終わるのを待ちます。型のついた失敗があれば、呼び出した側に伝えます。
  effects.join worker
}

// Expected stdout:
// worker: 42
