// Lesson 06: パイプラインと map、reduce を組み合わせる
// 前提: Lessons 04-05

import * as maps from "std/map"
import * as text from "std/text"

// |> は左の値を次の関数の最後の引数に渡します。変換の流れが上から下へ読めます。
fn wordCounts input: String -> maps.Map<String, Int> =
  input
  |> text.words
  |> map text.caseFold
  // empty () は空の Map を返す関数です。reduce は初期値から順に、要素を1つずつまとめていきます（畳み込み）。
  // Map の更新も、元の Map を変えずに新しい Map を返します。
  |> reduce (maps.empty ()) (\counts word -> counts |> maps.upsert word (\current -> (current ?? 0) + 1))

let sample = "Red blue RED green blue red"

pub effect fn main -> Unit with Console fails ConsoleError =
  // Map は、キーを最初に加えた順に要素を取り出します。
  // 実行ごとにハッシュの種が変わっても、この出力の順と値は変わりません。
  for (word, count) <- maps.entries (wordCounts sample) {
  println $ `${word}: ${count}`
}

// Expected stdout:
// red: 3
// blue: 2
// green: 1
