// Lesson 28: Unicode の見た目の文字の区切りと、正規化を学ぶ
// 前提: Lessons 21, 23

import * as graphemes from "std/text/grapheme"
import * as unicode from "std/text/unicode"

// 文字列の Unicode の文字（スカラー値）の数と、人が1文字と見る数（書記素クラスター）は、同じとは限りません。
// 肌の色を変える記号や、組み合わせる文字を含んでいても、この文字列は3つに分かれます。
let source = "A👍🏽e\u{0301}"

// NFC は見た目を変えずに、分かれた e とアクセントを、1文字の é にまとめます。
let normalized = unicode.normalize unicode.NFC source

pub effect fn main -> Unit with Console fails ConsoleError = do {
  println $ `clusters: ${graphemes.length source}`
  println $ normalized
}

// Expected stdout:
// clusters: 3
// A👍🏽é
