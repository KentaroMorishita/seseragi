// Lesson 23: 正規表現をコンパイルし、文字列の置き換えに安全に使う
// 前提: Lessons 08, 10, 22

import { RegexCompileError } from "std/regex"
import * as regex from "std/regex"

// パターンの誤りは例外ではなく Either で返るので、呼び出した側が型として扱えます。
fn redactOrderNumber text: String -> Either<RegexCompileError, String> = do {
  number <- regex.compile "[0-9]+"
  // 置き換える文字列は、書いたとおりに使われます。一致した部分を使って置き換えたいときは replaceAllWith を使います。
  pure (regex.replaceAll number "<number>" text)
}

pub effect fn main -> Unit with Console fails ConsoleError =
  match redactOrderNumber "order 123 is ready" {
    Left error -> println $ `regex error at byte ${error.offset}`
    Right redacted -> println redacted
  }

// Expected stdout:
// order <number> is ready
