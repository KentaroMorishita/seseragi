// Lesson 26: struct の JSON の変換を、安全に自動で作る
// 前提: Lessons 07, 08, 25

import * as json from "std/json"

struct User deriving Eq, Show, JsonEncode, JsonDecode { id: Int, name: String, }

let user = User { id: 7, name: "Aki" }
let encoded = json.encodeString user

fn decodeUser text: String -> Either<json.JsonReadError, User> = json.decodeString text

fn report result: Either<json.JsonReadError, User> -> String =
  // decodeString<User> は、JSON の文法と、User のフィールドの両方を確かめます。
  match result {
    Left _ -> "decode error"
    Right decoded ->
    // 自動で作った変換は、フィールドを宣言した順に、いつも同じ形の JSON を作ります。
    `${json.encodeString decoded} / ${decoded.name}`
  }

pub effect fn main -> Unit with Console fails ConsoleError =
  println $
  report (decodeUser encoded)

// Expected stdout:
// {"id":7,"name":"Aki"} / Aki
