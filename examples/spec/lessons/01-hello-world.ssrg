// Lesson 01: いちばん小さい Seseragi のプログラムを動かす
// 前提: なし

// 実行するパッケージは、公開した main から始まります。引数を書かない関数は、Unit を1つ受け取ります。
// effect fn は、使うサービスと失敗の型を隠さず、main の型に書きます。
pub effect fn main -> Unit with Console fails ConsoleError =
  // println は Console サービスを使い、文字列の最後に改行を加えて出力します。
  println "Hello, Seseragi!"

// Expected stdout:
// Hello, Seseragi!
