// Lesson 03: if、match、パターンを学ぶ
// 前提: Lesson 02

fn describe number: Int -> String =
  // if は必ず then と else を持ち、どちらも同じ型の値を返します。
  if number == 0 then "zero" else
  // match は上から順にパターンを試します。タプルを使うと、いくつかの条件を一度に分けられます。
  match (number > 0, number % 2) {
  (True, 0) -> "positive even"
  (True, _) -> "positive odd"
  (False, 0) -> "negative even"
  (False, _) -> "negative odd"
}

pub effect fn main -> Unit with Console fails ConsoleError = println $ describe (-3)

// Expected stdout:
// negative odd
