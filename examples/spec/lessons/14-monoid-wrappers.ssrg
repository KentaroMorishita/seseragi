// Lesson 14: Semigroup、Monoid、意味を表す包みの型を学ぶ
// 前提: Lessons 07, 08, 13

// Int は、足し算と掛け算のどちらでまとめるかが1つに決まらないので、Sum で足し算を選びます。
newtype Sum deriving Eq, Show = Int

instance Semigroup<Sum> {
  fn append left: Sum -> right: Sum -> Sum = match (left, right) {
    (Sum leftValue, Sum rightValue) -> Sum (leftValue + rightValue)
  }
}

// empty () は足し算で何も変えない値（0）です。combine は空の Array ならこの値を返します。
instance Monoid<Sum> {
  fn empty -> Sum = Sum 0
}

// combine は、Monoid のインスタンスを通して、型ごとのまとめ方を使います。
fn total values: Array<Int> -> Sum = values |> map Sum |> combine

let totals = [total [1, 2, 3, 4], total []]

pub effect fn main -> Unit with Console fails ConsoleError = for result <- totals {
  println $ show result
}

// Expected stdout:
// Sum 10
// Sum 0
