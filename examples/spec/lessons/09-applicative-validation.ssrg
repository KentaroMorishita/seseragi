// Lesson 09: 互いに依存しない検査を Applicative で組み合わせる
// 前提: Lessons 07-08

import { Invalid, Valid, Validation } from "std/validation"
import * as validation from "std/validation"
import * as text from "std/text"

type FormError deriving Eq, Show =
  | NameRequired
  | AgeMustBePositive

struct User deriving Eq, Show { name: String, age: Int, }

fn makeUser name: String -> age: Int -> User = User { name, age }

// それぞれの検査は互いの結果に依存せず、成功の値か、1件のエラーを返します。
fn validateName name: String -> Validation<FormError, String> =
  if name
    |> text.trim
    |> text.isEmpty then
    validation.invalid NameRequired
  else
    validation.valid name

fn validateAge age: Int -> Validation<FormError, Int> =
  if age > 0 then validation.valid age else validation.invalid AgeMustBePositive

// pure で普通の関数を Validation の中に入れ、<*> でそれぞれの入力を渡します。
// Validation は途中で止まらず、両方のエラーを入力の順にためます。
fn validateUser name: String -> age: Int -> Validation<FormError, User> =
  pure makeUser
  <*> validateName name
  <*> validateAge age

pub effect fn main -> Unit with Console fails ConsoleError = match validateUser "" 0 {
  Valid user -> println $ show user
  Invalid errors -> for error <- errors {
    println $ show error
  }
}

// Expected stdout:
// NameRequired
// AgeMustBePositive
