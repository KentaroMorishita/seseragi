// Lesson 10: Monad、>>=、do の関係を学ぶ
// 前提: Lesson 09

struct Address deriving Eq, Show { city: String, }

struct Profile deriving Eq, Show { address: Maybe<Address>, }

struct Account deriving Eq, Show { profile: Maybe<Profile>, }

// >>= は、前の成功の値を見て、次の計算を選びます。
fn shippingCity account: Account -> Maybe<String> =
  account.profile
  >>= (\profile -> profile.address)
  |> map (\address -> address.city)

// do は、同じ処理を、前の結果に順に依存する形で読みやすく書くための書き方です。
fn shippingCityDo account: Account -> Maybe<String> = do {
  profile <- account.profile
  address <- profile.address
  pure address.city
}

let account = Account {
  profile: Just (Profile { address: Just (Address { city: "Kyoto" }), }),
}

pub effect fn main -> Unit with Console fails ConsoleError =
  match (shippingCity account, shippingCityDo account) {
    (Just fromBind, Just fromDo) -> println $ `${fromBind} / ${fromDo}`
    _ -> println "address unavailable"
  }

// Expected stdout:
// Kyoto / Kyoto
