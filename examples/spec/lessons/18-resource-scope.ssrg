// Lesson 18: acquireRelease、scope、後片付けを学ぶ
// 前提: Lessons 10, 16

import * as effects from "std/effect"
import * as refs from "std/ref"

pub effect fn main -> Unit with Console fails ConsoleError = do {
  released <- refs.make False

  // acquireRelease は、取得に成功したらすぐに、解放の処理を今の範囲（scope）に登録します。
  effects.scoped $ do {
    effects.acquireRelease (effects.succeed ()) (\_: Unit -> refs.set True released)

    effects.succeed ()
  }

  // scoped の外に出たときには、後片付けは終わっています。
  wasReleased <- refs.get released
  println $ `released: ${wasReleased}`
}

// Expected stdout:
// released: True
