// Lesson 21: 変更できない Bytes と、UTF-8 の文字の区切りを学ぶ
// 前提: Lessons 08, 19

import * as bytes from "std/bytes"
import * as text from "std/text"

let encoded = text.encodeUtf8 "せせらぎ"

// slice の位置は、文字の数ではなくバイトの位置です。終わりの位置は含みません。
// UTF-8 の文字の区切りに合わせた 0..6 は、3バイトの「せ」を2文字取り出します。
fn prefix -> Either<bytes.BytesSliceError, bytes.Bytes> = bytes.slice 0 6 encoded

fn output -> String = match prefix () {
  Left error -> `slice error: ${error}`
  Right value ->
  // decodeUtf8 は、正しくないバイト列を隠さず、Either でその位置を返します。
  match text.decodeUtf8 value {
    Left error -> `UTF-8 error: ${error}`
    Right decoded -> `${decoded} (${bytes.length value} bytes)`
  }
}

pub effect fn main -> Unit with Console fails ConsoleError = println (output ())

// Expected stdout:
// せせ (6 bytes)
