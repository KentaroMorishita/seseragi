{
  "schema": 1,
  "kind": "provider-design-validation",
  "identity": "seseragi/provider-system",
  "capabilities": [
    {"name":"clock","applicationApi":"std/clock::{now,sleep}","contract":"std/clock::Clock#{now,sleep}","abi":"seseragi/provider-abi/typescript@1","provider":"host monotonic clock and timer adapter","properties":["one-shot","cancellation"]},
    {"name":"http-client","applicationApi":"std/http::{sendBytes,sendEmpty}","contract":"std/http::HttpClient#send","abi":"seseragi/provider-abi/typescript@1","provider":"host fetch or external HTTP client adapter","properties":["request-response","copied-bytes","cancellation"]},
    {"name":"http-server","applicationApi":"std/http/server::{listen,serveOnce,close}","contract":"std/http/server::HttpServer#{listen,close}","abi":"seseragi/provider-abi/typescript@1","provider":"host listener, request callback, and response writer adapter","properties":["handler","resource","shutdown"]},
    {"name":"filesystem","applicationApi":"std/fs::{readBytes,readChunks}","contract":"std/fs::FileSystem#{openRead,read,close}","abi":"seseragi/provider-abi/typescript@1","provider":"host filesystem and file descriptor adapter","properties":["opaque-handle","bytes","resource","cleanup"]},
    {"name":"postgresql","applicationApi":"PostgreSQL-specific package API","contract":"acme/postgres::Postgres#{openPool,query,openCursor,fetch,closeCursor,closePool}","abi":"seseragi/provider-abi/typescript@1","provider":"external PostgreSQL driver adapter without custom protocol engine","properties":["external-driver","pool","row","cursor"]}
  ],
  "diagnostics": ["missing", "ambiguous", "target", "contract", "abi"],
  "conformance": ["success", "typed-failure", "defect", "cancellation", "cleanup", "concurrency", "invalid-value", "mismatch", "ambiguity"],
  "handoff": ["contract-artifact", "manifest-resolution", "typescript-bridge", "target-diagnostics", "provider-package", "clock", "http-server", "http-client-node", "filesystem", "postgresql", "conformance-guide"]
}
