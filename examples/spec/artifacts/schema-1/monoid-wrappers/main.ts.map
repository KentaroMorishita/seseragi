pub struct Tally { value: Int }
instance Zero<Tally> {
  fn zero unit: Unit -> Tally = Tally { value: - 1 }
}
instance Add<Tally, Tally, Tally> {
  fn add left: Tally -> right: Tally -> Tally = Tally {
    value: left.value + right.value + 1
  }
}
pub struct Ordered { value: String }
instance One<Ordered> {
  fn one unit: Unit -> Ordered = Ordered { value: "" }
}
instance Mul<Ordered, Ordered, Ordered> {
  fn mul left: Ordered -> right: Ordered -> Ordered = Ordered {
    value: left.value + right.value
  }
}
pub fn mergeAll<C, A> values: C -> A where Reducible<C, A>, Monoid<A> = combine values
pub fn unwrapSum<A> value: Sum<A> -> A = match value { Sum n -> n }
pub fn unwrapProduct<A> value: Product<A> -> A = match value { Product n -> n }

pub effect fn main = do {
  println $ show $ unwrapSum $ mergeAll [Sum 1, Sum 2, Sum 3]
  println $ show $ unwrapProduct $ mergeAll `[Product 2, Product 3, Product 4]
  let emptySum: Array<Sum<Int>> = []
  let emptyProduct: Array<Product<Int>> = []
  println $ show $ unwrapSum $ mergeAll emptySum
  println $ show $ unwrapProduct $ mergeAll emptyProduct
  let custom = unwrapSum $ mergeAll [Sum (Tally { value: 1 }), Sum (Tally { value: 2 })]
  println $ show custom.value
  let ordered = unwrapProduct $
    mergeAll [
      Product (Ordered { value: "first" }),
      Product (Ordered { value: "-second" })
    ]
  println ordered.value
  let partial: Sum<Int> -> Sum<Int> = append (Sum 10)
  println $ show $ unwrapSum $ partial (Sum 20)
}
