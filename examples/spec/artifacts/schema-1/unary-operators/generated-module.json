{
  "schema": 1,
  "module": "artifact/unary-operators",
  "target": "typescript-es2022",
  "runtime": {
    "identity": "@seseragi/runtime",
    "abiMajor": 1,
    "requirements": [
      "core.int",
      "core.int.subtract",
      "core.float64",
      "core.bool"
    ]
  },
  "exports": [
    "negative",
    "negativeZero",
    "inverted",
    "minimum",
    "values",
    "floats",
    "flags",
    "tuple",
    "record",
    "snapshot",
    "negateInt",
    "negateFloat",
    "invert"
  ],
  "outputs": {
    "typescript": "main.ts",
    "sourceMap": "main.ts.map"
  }
}
