// unary - / !の型と値をliteral・binding・argument・nested valueで固定します。
pub struct Snapshot {
  negative: Int,
  negativeZero: Float,
  inverted: Bool,
}

pub let negative = -2
pub let negativeZero = -0.0
pub let inverted = !True
pub let minimum: Int = -9007199254740991

pub let values: Array<Int> = [-1, -2, -3]
pub let floats: Array<Float> = [-1.0, -0.0, -6.022e23]
pub let flags: Array<Bool> = [!True, !False]
pub let tuple: (Int, Float, Bool) = (-4, -2.5, !False)
pub let record = { negative: -5, inverted: !True }
pub let snapshot: Snapshot =
  Snapshot {
    negative: -6,
    negativeZero: -0.0,
    inverted: !False,
  }

pub fn negateInt value: Int -> Int = -value
pub fn negateFloat value: Float -> Float = -value
pub fn invert value: Bool -> Bool = !value

trait Render<A> {
  fn render value: A -> String
}

instance Render<Int> {
  fn render value: Int -> String = show value
}

fn identity<A> value: A -> A = value

operator infixl 4 <~>
  left: Int -> right: Int -> Int =
  left - right

pub effect fn main =
  do {
    println "first"
    -1
    |> identity
    |> debug
    |> println
    -1
    |> show
    |> println
    -2
    |> render
    |> println
    -2.5
    |> show
    |> println
    !True
    |> debug
    |> println
    println (debug (-3))
    println (debug [-4, -5])
    -5 <~> 2
    |> debug
    |> println
  }
