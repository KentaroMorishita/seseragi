// generic callの具体的な戻り型と安全なtop-level初期化順を固定します。
pub type Packet<A> deriving Debug =
  | Packet A

pub struct Box<A> deriving Debug {
  value: A,
}

fn addMaybe
  left: Maybe<Int>
  -> right: Maybe<Int>
  -> Maybe<Int> =
  do {
    a <- left
    b <- right
    pure (a + b)
  }

fn wrapMaybe<A> value: A -> Maybe<A> =
  Just value

fn wrapEither<A> value: A -> Either<String, A> =
  Right value

fn wrapArray<A> value: A -> Array<A> =
  [value]

fn wrapList<A> value: A -> List<A> =
  `[value]

fn wrapPacket<A> value: A -> Packet<A> =
  Packet value

fn wrapBox<A> value: A -> Box<A> =
  Box { value }

let success = addMaybe (Just 20) (Just 22)
let stopped = addMaybe (Just 20) Nothing
let wrapped = wrapMaybe 42
let eitherValue = wrapEither 42
let arrayValue = wrapArray 42
let listValue = wrapList 42
let packetValue = wrapPacket 42
let boxValue = wrapBox 42

pub effect fn main =
  do {
    debug success |> println
    debug stopped |> println
    debug wrapped |> println
    debug eitherValue |> println
    debug arrayValue |> println
    debug listValue |> println
    debug packetValue |> println
    debug boxValue |> println
  }
