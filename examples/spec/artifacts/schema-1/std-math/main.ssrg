import * as math from "std/math"
import { pi as circleConstant, sin, atan2 } from "std/math"
pub let constants: (Float, Float, Float, Float) = (math.pi, math.e, math.tau, circleConstant)
pub let functions: Array<Float -> Float> = [
  sin,
  math.cos,
  math.tan,
  math.asin,
  math.acos,
  math.atan,
  math.exp,
  math.log,
  math.log2,
  math.log10,
  math.sqrt,
  math.cbrt,
  math.sinh,
  math.cosh,
  math.tanh
]
pub let partial: Float -> Float = atan2 1.0
pub let length: Float = math.hypot 3.0 4.0
pub let result: Float = partial 1.0
