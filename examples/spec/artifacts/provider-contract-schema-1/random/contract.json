    { "identity": "std/random::Random#shuffleIndices", "kind": "one-shot", "input": { "kind": "primitive", "name": "int" }, "success": { "kind": "array", "items": { "kind": "primitive", "name": "int" } }, "failure": { "kind": "never" }, "portability": { "kind": "portable" }, "summary": "Return a Fisher-Yates permutation atomically." }
  ]
