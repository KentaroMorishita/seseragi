{
  "schema": 1,
  "kind": "provider-contract",
  "identity": "std/fs::FileSystem",
  "version": {
    "major": 1,
    "minor": 0
  },
  "requirement": {
    "field": "fileSystem",
    "type": "std/fs::FileSystem"
  },
  "operations": [
    {
      "identity": "std/fs::FileSystem#openRead",
      "kind": "resource",
      "input": {
        "kind": "record",
        "fields": [
          {
            "name": "path",
            "type": {
              "kind": "named",
              "identity": "std/path::Path"
            }
          }
        ]
      },
      "success": {
        "kind": "named",
        "identity": "std/fs::FileHandle"
      },
      "failure": {
        "kind": "named",
        "identity": "std/fs::FileError"
      },
      "portability": {
        "kind": "portable"
      },
      "summary": "Acquire a read handle for a normalized portable path."
    },
    {
      "identity": "std/fs::FileSystem#read",
      "kind": "one-shot",
      "input": {
        "kind": "record",
        "fields": [
          {
            "name": "handle",
            "type": {
              "kind": "named",
              "identity": "std/fs::FileHandle"
            }
          },
          {
            "name": "limit",
            "type": {
              "kind": "primitive",
              "name": "int"
            }
          }
        ]
      },
      "success": {
        "kind": "primitive",
        "name": "bytes"
      },
      "failure": {
        "kind": "named",
        "identity": "std/fs::FileError"
      },
      "portability": {
        "kind": "portable"
      },
      "summary": "Read at most the requested byte count from an owned handle."
    },
    {
      "identity": "std/fs::FileSystem#close",
      "kind": "one-shot",
      "input": {
        "kind": "named",
        "identity": "std/fs::FileHandle"
      },
      "success": {
        "kind": "unit"
      },
      "failure": {
        "kind": "named",
        "identity": "std/fs::FileError"
      },
      "portability": {
        "kind": "portable"
      },
      "summary": "Close an owned file handle without exposing a host handle."
    }
  ]
