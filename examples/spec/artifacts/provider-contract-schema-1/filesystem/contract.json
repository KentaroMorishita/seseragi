{
  "schema": 1,
  "kind": "provider-contract",
  "identity": "std/fs::FileSystem",
  "version": { "major": 1, "minor": 1 },
  "requirement": { "field": "fileSystem", "type": "std/fs::FileSystem" },
  "operations": [
    {
      "identity": "std/fs::FileSystem#openRead",
      "kind": "resource",
      "input": { "kind": "record", "fields": [{ "name": "path", "type": { "kind": "named", "identity": "std/path::Path" } }] },
      "success": { "kind": "named", "identity": "std/fs::FileHandle" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Acquire a read handle for a normalized portable path."
    },
    {
      "identity": "std/fs::FileSystem#read",
      "kind": "one-shot",
      "input": { "kind": "record", "fields": [
        { "name": "handle", "type": { "kind": "named", "identity": "std/fs::FileHandle" } },
        { "name": "limit", "type": { "kind": "primitive", "name": "int" } }
      ] },
      "success": { "kind": "primitive", "name": "bytes" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Read at most the requested byte count from an owned handle."
    },
    {
      "identity": "std/fs::FileSystem#openWrite",
      "kind": "resource",
      "input": { "kind": "record", "fields": [
        { "name": "path", "type": { "kind": "named", "identity": "std/path::Path" } },
        { "name": "mode", "type": { "kind": "primitive", "name": "string" } }
      ] },
      "success": { "kind": "named", "identity": "std/fs::FileHandle" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Acquire an owned write handle with an explicit portable write mode."
    },
    {
      "identity": "std/fs::FileSystem#write",
      "kind": "one-shot",
      "input": { "kind": "record", "fields": [
        { "name": "handle", "type": { "kind": "named", "identity": "std/fs::FileHandle" } },
        { "name": "content", "type": { "kind": "primitive", "name": "bytes" } }
      ] },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Write one Bytes chunk to an owned file handle."
    },
    {
      "identity": "std/fs::FileSystem#flush",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/fs::FileHandle" },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Flush an owned writable file handle."
    },
    {
      "identity": "std/fs::FileSystem#close",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/fs::FileHandle" },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Close an owned file handle without exposing a host handle."
    },
    {
      "identity": "std/fs::FileSystem#openDirectory",
      "kind": "resource",
      "input": { "kind": "record", "fields": [{ "name": "path", "type": { "kind": "named", "identity": "std/path::Path" } }] },
      "success": { "kind": "named", "identity": "std/fs::DirectoryHandle" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Acquire an owned directory scan handle."
    },
    {
      "identity": "std/fs::FileSystem#readDirectory",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/fs::DirectoryHandle" },
      "success": { "kind": "named", "identity": "std/fs::ProviderDirectoryRead" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Read the next directory entry or the end marker."
    },
    {
      "identity": "std/fs::FileSystem#closeDirectory",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/fs::DirectoryHandle" },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Close an owned directory scan handle."
    },
    {
      "identity": "std/fs::FileSystem#exists",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/path::Path" },
      "success": { "kind": "primitive", "name": "bool" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Check path existence without hiding non-not-found failures."
    },
    {
      "identity": "std/fs::FileSystem#metadata",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/path::Path" },
      "success": { "kind": "named", "identity": "std/fs::ProviderFileMetadata" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Read metadata while following a symbolic link."
    },
    {
      "identity": "std/fs::FileSystem#symlinkMetadata",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/path::Path" },
      "success": { "kind": "named", "identity": "std/fs::ProviderFileMetadata" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Read metadata for a symbolic link itself."
    },
    {
      "identity": "std/fs::FileSystem#canonicalize",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/path::Path" },
      "success": { "kind": "named", "identity": "std/path::Path" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Resolve an existing path to a portable absolute path."
    },
    {
      "identity": "std/fs::FileSystem#createDirectory",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/path::Path" },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Create exactly one directory level."
    },
    {
      "identity": "std/fs::FileSystem#createDirectories",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/path::Path" },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Create a directory and every missing ancestor."
    },
    {
      "identity": "std/fs::FileSystem#removeFile",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/path::Path" },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Remove a regular file or symbolic link without following it."
    },
    {
      "identity": "std/fs::FileSystem#removeDirectory",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/path::Path" },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Remove one empty directory without following a link."
    },
    {
      "identity": "std/fs::FileSystem#move",
      "kind": "one-shot",
      "input": { "kind": "record", "fields": [
        { "name": "destination", "type": { "kind": "named", "identity": "std/path::Path" } },
        { "name": "source", "type": { "kind": "named", "identity": "std/path::Path" } }
      ] },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Move a path atomically without replacing an existing destination."
    },
    {
      "identity": "std/fs::FileSystem#writeAtomic",
      "kind": "one-shot",
      "input": { "kind": "record", "fields": [
        { "name": "content", "type": { "kind": "primitive", "name": "bytes" } },
        { "name": "path", "type": { "kind": "named", "identity": "std/path::Path" } }
      ] },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Replace one target with complete Bytes through a same-directory temporary."
    },
    {
      "identity": "std/fs::FileSystem#createTemporary",
      "kind": "resource",
      "input": { "kind": "record", "fields": [
        { "name": "prefix", "type": { "kind": "primitive", "name": "string" } },
        { "name": "kind", "type": { "kind": "primitive", "name": "string" } }
      ] },
      "success": { "kind": "named", "identity": "std/fs::TemporaryHandle" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Acquire a temporary resource with owner identity retained by the provider."
    },
    {
      "identity": "std/fs::FileSystem#temporaryPath",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/fs::TemporaryHandle" },
      "success": { "kind": "named", "identity": "std/path::Path" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Read the portable path of an owned temporary resource."
    },
    {
      "identity": "std/fs::FileSystem#cleanupTemporary",
      "kind": "one-shot",
      "input": { "kind": "named", "identity": "std/fs::TemporaryHandle" },
      "success": { "kind": "unit" },
      "failure": { "kind": "named", "identity": "std/fs::FileError" },
      "portability": { "kind": "portable" },
      "summary": "Clean only the still-matching owned temporary resource tree."
    }
  ]
}
