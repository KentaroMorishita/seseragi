import { Box, Boxed, Monad, Profile, bind } from "./domain"

fn incrementBox value: Int -> Box<Int> =
  Boxed $ value + 1

fn render value: Box<Int> -> String =
  match value {
    Boxed 42 -> "Imported Box Monad: 42"
    Boxed _ -> "Imported Box Monad: another value"
  }

fn addBox left: Box<Int> -> right: Box<Int> -> Box<Int> =
  do {
    first <- left
    second <- right
    Boxed $ first + second
  }

fn incrementProfileBox value: Box<Profile> -> Box<Profile> =
  do {
    Profile (profileName, profileAge) <- value
    let Profile (typedName, typedAge): Profile =
      Profile (profileName, profileAge)
    Boxed $ Profile (typedName, typedAge + 1)
  }

fn renderProfileBox value: Box<Profile> -> String =
  match value {
    Boxed (Profile (profileName, profileAge)) ->
      `Imported Box Pattern: ${profileName}: ${profileAge}`
  }

pub effect fn main =
  do {
    let Boxed (Profile (localName, localAge)): Box<Profile> =
      Boxed $ Profile ("Aki", 40)
    println $ `Imported Box Let: ${localName}: ${localAge}`

    Boxed (Profile (boundName, boundAge)) <-
      succeed $ Boxed $ Profile ("Ren", 41)
    println $ `Imported Box Bind: ${boundName}: ${boundAge}`

    Boxed 41
    |> bind incrementBox
    |> render
    |> println

    addBox (Boxed 20) (Boxed 22)
    |> render
    |> println

    Boxed (Profile ("Mio", 41))
    |> incrementProfileBox
    |> renderProfileBox
    |> println
  }
