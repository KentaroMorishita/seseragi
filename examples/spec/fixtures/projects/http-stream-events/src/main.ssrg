import * as bytes from "std/bytes"
import * as effects from "std/effect"
import * as http from "std/http"
import * as streams from "std/stream"
import * as text from "std/text"

type AppError deriving Show =
  | BuildFailure http.HttpBuildError
  | HttpFailure http.HttpError
  | TextFailure text.Utf8DecodeError
  | UnexpectedEvents
  | ConsoleFailure ConsoleError

fn mapHttpError error: Either<Never, http.HttpError> -> AppError =
  match error {
    Left _ -> UnexpectedEvents
    Right failure -> HttpFailure failure
  }

fn decodeBody first: bytes.Bytes -> second: bytes.Bytes
  -> Either<AppError, String> =
  match text.decodeUtf8 (bytes.concat [first, second]) {
    Left failure -> Left (TextFailure failure)
    Right body -> Right body
  }

fn renderEvents events: Array<http.HttpEvent> -> Either<AppError, String> =
  match events {
    [firstEvent, secondEvent, thirdEvent, fourthEvent] ->
      match firstEvent {
        http.ResponseStarted head ->
          match secondEvent {
            http.ResponseBodyChunk first ->
              match thirdEvent {
                http.ResponseBodyChunk second ->
                  match fourthEvent {
                    http.ResponseTrailers trailers ->
                      match (decodeBody first second, http.headerValues "x-end" trailers) {
                        (Right body, [end]) ->
                          Right `${http.statusCode head.status}: ${body} (${end})`
                        _ -> Left UnexpectedEvents
                      }
                    _ -> Left UnexpectedEvents
                  }
                _ -> Left UnexpectedEvents
              }
            _ -> Left UnexpectedEvents
          }
        _ -> Left UnexpectedEvents
      }
    _ -> Left UnexpectedEvents
  }

pub effect fn main -> Unit
with Console, HttpClient
fails AppError =
  do {
    url <-
      http.parseUrl "http://127.0.0.1:41288/stream"
        |> effects.fromEither
        |> effects.mapError BuildFailure

    events <-
      http.request http.get url
        |> http.exchange (http.emptyBody<{}, Never> ())
        |> streams.runCollect
        |> effects.mapError mapHttpError

    output <- renderEvents events |> effects.fromEither
    println output |> effects.mapError ConsoleFailure
  }
