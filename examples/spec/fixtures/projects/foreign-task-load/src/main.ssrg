import * as effects from "std/effect"

foreign "typescript" from "../host/nested/lazy-module.mjs" {
  task fn call label: String -> String

  namespace nested = "Nested" {
    task fn callAsync label: String -> String
  }
}

type AppError deriving Show =
  | ConsoleFailure ConsoleError
  | ForeignFailure Js.Error

pub effect fn main -> Unit
with Console
fails AppError =
  do {
    println "before"
      |> effects.mapError ConsoleFailure

    first <-
      call "a"
        |> effects.mapError ForeignFailure

    second <-
      nested.callAsync "b"
        |> effects.mapError ForeignFailure

    let output = `${first},${second}`
    println output |> effects.mapError ConsoleFailure
  }
