import { DomOptions, HydrateStrict, PreserveRenderedDom, } from "std/web/dom"
import * as dom from "std/web/dom"
import * as effects from "std/effect"
import * as html from "std/web/html"
import * as signals from "std/signal"

fn strictOptions -> DomOptions = {
  let defaults = dom.defaultOptions ()
  DomOptions {
    eventCapacity: defaults.eventCapacity,
    hydration: HydrateStrict,
    cleanup: PreserveRenderedDom,
  }
}

fn ignore action: Unit -> Task<Unit> = effects.succeed ()

fn mountStrict target: dom.DomTarget
  -> Effect<{ dom: dom.Dom }, dom.DomError, dom.DomMount<Never>> =
  dom.mount (strictOptions ()) target ignore (signals.constant $ html.p { children: "client" })

fn finish result: Either<dom.DomError, dom.DomMount<Never>> -> Task<Unit> =
  match result {
    Left (dom.HydrationMismatch _) -> effects.succeed ()
    Left _ -> effects.succeed ()
    Right mount -> dom.unmount mount
  }

fn runTarget target: dom.DomTarget -> Effect<{ dom: dom.Dom }, Never, Unit> = do {
  mountResult <- effects.attempt $ mountStrict target
  effects.provideSome (\_environment: { dom: dom.Dom } -> {}) (finish mountResult)
}

pub effect fn main -> Unit with dom: dom.Dom = do {
  targetResult <- effects.attempt $ dom.query "#app"
  match targetResult {
    Left _ -> effects.provideSome (\_environment: { dom: dom.Dom } -> {}) (effects.succeed ())
    Right target -> runTarget target
  }
}
