import {
  Secret,
  Box,
  create,
  read,
  unpack,
  update,
  box,
  unbox,
  nested,
  collect
} from "./facade"

pub effect fn main = {
  let secret = create 7
  do {
    println $ show (read secret)
    println $ show (unpack secret)
    println $ show secret
    println $ show (secret == create 7)
    println $ show (unbox (box 42))
    println $ show (nested (box secret))
    println $ show (collect [secret])
    println $ show (read (update secret))
  }
}
