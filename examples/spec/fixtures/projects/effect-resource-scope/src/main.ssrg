import * as effects from "std/effect"
import * as refs from "std/ref"

pub effect fn main -> Unit with Console fails ConsoleError = do {
  released <- refs.make False

  effects.scoped $ do {
    effects.acquireRelease (effects.succeed ()) (\_: Unit -> refs.set True released)

    effects.succeed ()
  }

  wasReleased <- refs.get released
  println $ `released: ${wasReleased}`
}
