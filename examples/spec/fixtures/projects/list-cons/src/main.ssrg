import { prepend, first } from "./domain"
foreign "typescript" from "../host/probe.mjs" {
  pure fn record value: Int -> Int
  pure fn trace unit: Unit -> String
}
fn tail unit: Unit -> List<Int> = if record 2 == 2 then `[3, 4] else `[]
let values = record 1 : tail ()
let add: Bool -> List<Bool> -> List<Bool> = (:)
let withFive = (:) 5
pub effect fn main = do {
  println $ show (Nothing : `[Just 1])
  println $ show values
  println $ show (1 : 2 : 3 : `[])
  println $ show (prepend 0 values)
  println $ show (first values)
  println $ show (add True `[], withFive `[6], (:) 7 `[8])
  println $ show (values == `[1, 3, 4])
  println (trace ())
}
