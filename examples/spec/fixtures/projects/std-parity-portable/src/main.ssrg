import * as arrays from "std/array"
import * as collections from "std/collection"
import * as bytes from "std/bytes"
import * as base64 from "std/bytes/base64"
import * as bigints from "std/big-int"
import * as decimals from "std/decimal"
import * as hex from "std/bytes/hex"
import * as floats from "std/float"
import * as ints from "std/int"
import * as json from "std/json"
import * as lists from "std/list"
import * as numbers from "std/number"
import * as texts from "std/text"
import * as chars from "std/char"
import * as graphemes from "std/text/grapheme"
import * as unicode from "std/text/unicode"
import * as maps from "std/map"
import * as sets from "std/set"
import * as maybe from "std/maybe"
import * as either from "std/either"
import * as validation from "std/validation"
import * as regex from "std/regex"

fn even value: Int -> Bool = value % 2 == 0

let selected = arrays.filter even [1, 2, 3, 4]
let converted = arrays.toList selected
let numeric = match floats.toInt numbers.HalfEven (floats.fromInt 2) {
  Left _ -> 0
  Right value -> value
}
let encoded = texts.encodeUtf8 "ok"
let unicodeText = unicode.normalize unicode.NFC "A👍🏽e\u{0301}"
let unicodeSummary =
  `${unicode.version ()} / ${graphemes.length unicodeText} / ${texts.lengthScalars unicodeText} / ${texts.lengthBytes unicodeText} / ${map chars.codePoint (texts.scalarAt 1 unicodeText)}`
let decoded = match texts.decodeUtf8 encoded {
  Left _ -> "error"
  Right value -> value
}
let jsonText = json.encodeString selected
let ordered = maps.fromEntries [("b", 2), ("a", 1), ("b", 3)]
let unique = sets.fromIterable [3, 1, 3, 2]
let grouped = arrays.groupBy even [3, 2, 1, 4]
let sorted = lists.sort `[3, 1, 2]
let invalidSize = match arrays.windows 0 selected {
  Left (collections.NonPositiveSize size) -> size
  Right _ -> 1
}
let optional: Array<Maybe<Int>> = [Just 1, Just 2]
let maybeResult = maybe.sequence optional
let successful: Either<String, Int> = Right 2
let eitherResult = either.mapRight (\value -> value + 1) successful
let firstInvalid: validation.Validation<String, Int> = validation.invalid "first"
let secondInvalid: validation.Validation<String, Int> = validation.invalid "second"
let validationResult: validation.Validation<String, Int> =
  pure (\a: Int -> \b: Int -> a + b)
  <*> firstInvalid
  <*> secondInvalid
let regexSummary = match regex.compile "[0-9]+" {
  Left _ -> "regex error"
  Right pattern -> regex.replaceAll pattern "<number>" "order 123"
}
let decodedHex = match hex.decode "6F6B" {
  Left error -> show error
  Right value -> show (bytes.toInts value)
}
let decodedBase64 = match base64.decode "b2s=" {
  Left error -> show error
  Right value -> show (bytes.toInts value)
}
let decodedBase64Url = match base64.decodeUrl "b2s" {
  Left error -> show error
  Right value -> show (bytes.toInts value)
}
let invalidHex = match hex.decode "00é" {
  Left error -> show error
  Right _ -> "unexpected success"
}
let invalidBase64 = match base64.decode "AB==" {
  Left error -> show error
  Right _ -> "unexpected success"
}
let bigIntSummary = match bigints.parse "9007199254740993" {
  Left error -> show error
  Right value -> bigints.format (value * bigints.fromInt 2 + bigints.fromInt 1)
}
let decimalSummary = match decimals.context 2 numbers.HalfEven {
  Left error -> show error
  Right decimalContext ->
    match decimals.parse "12345678901234567890.000000000000000001" {
      Left error -> show error
      Right exact ->
        match decimals.divide decimalContext (decimals.fromInt 8) (decimals.fromInt 1) {
          Left error -> show error
          Right rounded -> `${show rounded} / ${json.encodeString exact}`
        }
    }
}

pub effect fn main = do {
  println `array: ${arrays.length selected} / list: ${lists.length converted} / numeric: ${ints.saturatingAdd numeric 1} / bytes: ${bytes.length encoded} / text: ${decoded} / json: ${jsonText} / map: ${json.encodeString ordered} / set: ${sum unique} / grouped: ${maps.values grouped} / sorted: ${sorted} / size: ${invalidSize} / maybe: ${maybeResult} / either: ${eitherResult} / validation: ${validationResult}`
  println `unicode: ${unicodeSummary}`
  println `regex: ${regexSummary}`
  println `codecs: ${hex.encode encoded} / ${base64.encode encoded} / ${base64.encodeUrl encoded} / ${decodedHex} / ${decodedBase64} / ${decodedBase64Url} / ${invalidHex} / ${invalidBase64}`
  println `big-int: ${bigIntSummary}`
  println `decimal: ${decimalSummary}`
}
