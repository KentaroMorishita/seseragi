import * as deferred from "std/deferred"
import * as effects from "std/effect"
import * as queues from "std/queue"
import * as semaphores from "std/semaphore"

type AppError deriving Show =
  | QueueCreateFailure queues.QueueCreateError
  | QueueFailure queues.QueueClosed
  | SemaphoreFailure semaphores.SemaphoreCreateError
  | ConsoleFailure ConsoleError

effect fn parallelValues -> Array<Int> =
  effects.traverseParallel
    (effects.unboundedParallelism ())
    (\value: Int -> effects.succeed (value + 10))
    [1, 2]

effect fn four -> Int = effects.succeed 4
effect fn five -> Int = effects.succeed 5

effect fn parallelEffects -> Array<Int> =
  effects.parallel [four (), five ()]

pub effect fn main -> Unit
with Console
fails AppError =
  do {
    queue <-
      queues.bounded<Int> 1
        |> effects.mapError QueueCreateFailure
    queues.offer 1 queue
      |> effects.mapError QueueFailure

    blocked <- effects.fork $ do {
      queues.offer 2 queue
        |> effects.mapError QueueFailure
    }
    first <-
      queues.take queue
        |> effects.mapError QueueFailure
    effects.join blocked
    second <-
      queues.take queue
        |> effects.mapError QueueFailure

    gate <- deferred.make<Never, Unit> ()
    waiting <- effects.fork $ deferred.await gate
    deferred.succeed () gate
    effects.join waiting

    semaphore <-
      semaphores.make 1
        |> effects.mapError SemaphoreFailure
    guarded <-
      effects.succeed 3
        |> semaphores.withPermit semaphore

    parallel <- parallelValues ()
    all <- parallelEffects ()

    println `${first},${second},${guarded},${show parallel},${show all}`
      |> effects.mapError ConsoleFailure
  }
