import * as arrays from "std/array"
import * as console from "std/console"
import * as effects from "std/effect"
import * as logs from "std/log"
import { LogEvent } from "std/log"
import * as stdin from "std/stdin"

type AppError deriving Show =
  | InputFailure StdinError
  | OutputFailure ConsoleError
  | LogFailure logs.LogError

fn renderLine value: Maybe<String> -> String =
  match value {
    Nothing -> "EOF"
    Just text ->
      if text == ""
      then "EMPTY"
      else `line: ${text}`
  }

pub effect fn main -> Unit
with Console, Stdin, logger: logs.Logger
fails AppError =
  do {
    logs.log (LogEvent {
      level: logs.LogInfo,
      message: "stdin started",
      fields: arrays.toList [("fixture", logs.LogString "stdin-lines")],
    })
      |> effects.mapError LogFailure

    first <- stdin.readLine () |> effects.mapError InputFailure
    console.println (renderLine first) |> effects.mapError OutputFailure

    second <- stdin.readLine () |> effects.mapError InputFailure
    console.println (renderLine second) |> effects.mapError OutputFailure

    third <- stdin.readLine () |> effects.mapError InputFailure
    console.println (renderLine third) |> effects.mapError OutputFailure

    eof <- stdin.readLine () |> effects.mapError InputFailure
    console.println (renderLine eof) |> effects.mapError OutputFailure
  }
