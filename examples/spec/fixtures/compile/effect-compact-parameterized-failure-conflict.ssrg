import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"

type Action =
  | Increment

fn handle count: signals.MutableSignal<Int> -> action: Action
  -> Effect<{}, Never, Unit> =
  signals.update (\value: Int -> value + 1) count

fn view count: Int -> html.Html<Action> =
  html.p { children: show count }

pub effect fn main =
  do {
    count <- signals.make 0
    let content = signals.map view count
    let options = dom.defaultOptions ()
    target <- dom.query "#app"
    dom.run options target (handle count) content
  }
