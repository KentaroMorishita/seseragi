import * as effects from "std/effect"
import * as refs from "std/ref"
import { Ref } from "std/ref"
import { Pair, Reversed, Twice, Constant, Tag1, Tag2, label1, label2 } from "./facade"

effect fn selectPrefix counter: Ref<Int> -> String = do {
  count <- refs.get counter
  refs.set (count + 1) counter
  effects.succeed "saved="
}

pub effect fn main = do {
  counter <- refs.make 0
  savedPrefix <- selectPrefix counter
  let flipSaved = \value: Pair<Bool, Int> -> label2<Reversed, Int, Bool> savedPrefix value
  let repeatSaved = \value: Pair<Int, Int> -> label1<Twice, Int> savedPrefix value
  let eraseSaved = \value: Int -> label1<Constant, Bool> savedPrefix value
  println (flipSaved (Pair (True, 42)))
  println (repeatSaved (Pair (1, 2)))
  println (eraseSaved 9)
  println (label2<Reversed, Int, Bool> "again=" (Pair (False, 7)))
  println (label1<Twice, Int> "again=" (Pair (3, 4)))
  println (label1<Constant, Bool> "again=" 42)
  selected <- refs.get counter
  if selected == 1 then
    effects.succeed ()
  else
    effects.die "prefix must evaluate once before saved closures"
}
