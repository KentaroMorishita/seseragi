import * as maps from "std/map"

pub opaque newtype Input = String
pub opaque newtype Output = Int
instance Eq<Input> { fn eq left: Input -> right: Input -> Bool = match left { Input a -> match right { Input b -> a == b } } }
instance Hash<Input> { fn hash _value: Input -> Int = 0 }
instance Eq<Output> { fn eq left: Output -> right: Output -> Bool = match left { Output a -> match right { Output b -> a == b } } }
instance Hash<Output> { fn hash _value: Output -> Int = 0 }
pub fn output value: Int -> Output = Output value
pub fn read value: Output -> Int = match value { Output number -> number }
pub fn key value: Input -> Output = match value { Input text -> Output (if text == "c" then 2 else 1) }
pub fn source -> maps.Map<Input,Int> = maps.singleton (Input "a") 10 |> maps.insert (Input "b") 20 |> maps.insert (Input "c") 3
pub fn update<K,V> key: K -> callback: (Maybe<V> -> V) -> maps.Map<K,V> -> maps.Map<K,V> where Eq<K>, Hash<K> = maps.upsert key callback
pub fn merge<K,V> callback: (V -> V -> V) -> right: maps.Map<K,V> -> maps.Map<K,V> -> maps.Map<K,V> where Eq<K>, Hash<K> = maps.mergeWith callback right
pub fn rekey<K1,K2,V> callback: (V -> V -> V) -> key: (K1 -> K2) -> maps.Map<K1,V> -> maps.Map<K2,V> where Eq<K2>, Hash<K2> = maps.mapKeysWith callback key
