import { Box, Monad, make, unwrap, bump } from "./facade"

fn next value: Int -> Box<Int> = make<Int> (bump value)

pub fn probe -> Int = {
  let bind: Box<Int> -> (Int -> Box<Int>) -> Box<Int> = (>>=)
  let held = bind (make 40)
  let result: Box<Int> = held next
  unwrap<Int> result
}

pub effect fn main = do { println (show (probe ())) }
