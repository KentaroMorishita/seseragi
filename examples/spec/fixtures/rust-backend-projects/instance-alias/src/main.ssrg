import { Label as Tag, Box as Crate, retained } from "./facade"
import { Name as ModelName, Render as Display, renderImported } from "model"
import * as refs from "std/ref"

newtype Owned = Int
alias OwnName = Owned

instance Display<OwnName> {
  fn render value: Owned -> String = match value { Owned n -> "owned=" + show n }
}

pub fn probe -> Array<String> = {
  let value: ModelName = Tag 4
  let saved = retained (Crate value)
  [show value, show (Crate value), saved 5, saved 6, renderImported (Owned 10)]
}

pub effect fn main = do {
  saved <- refs.make (retained (Crate (Tag 7)))
  display <- refs.get saved
  println (display 8)
  println (display 9)
}
