pub trait Pick<F<_>> {
  fn pick<A> left: F<A> -> right: F<A> -> Bool
}

pub type Box<A> = | Box A
instance Pick<Box> {
  fn pick<A> left: Box<A> -> (Box<A> -> Bool) = \right -> True
}
let selectedMethod = pick
let copiedMethod = selectedMethod

fn capture<F<_>, A> left: F<A> -> (F<A> -> Bool) where Pick<F> = {
  let chosen = copiedMethod
  let copied = chosen
  copied left
}

pub fn selected<A> left: Box<A> -> (Box<A> -> Bool) = capture left
