import {
  Kept,
  PublicWrapped,
  PublicChain,
  create,
  reveal,
  scoped,
  constrained
} from "./facade"

struct Sealed<F<_>, A> { value: F<A> }

pub fn keep<F<_>, A> value: PublicChain<F, A> -> PublicWrapped<F, A> = value

pub effect fn main = do {
  let saved: Maybe<Int> -> PublicChain<Maybe, Int> = create
  let hidden: Kept<Maybe, Int> = saved (Just 42)
  let actual = constrained<Maybe, Int> (scoped<Maybe, Int> (reveal (keep hidden)))
  println (show actual)
  let second: PublicWrapped<Maybe, String> = create<Maybe, String> (Just "kept")
  println (show (reveal second))
}
