import * as codec from "codec"
import * as effects from "std/effect"
import * as fs from "std/fs"
import * as paths from "std/path"

pub effect fn main -> Unit with FileSystem fails String = do {
  input <- paths.child "input.txt" (paths.current ())
    |> effects.fromEither
    |> effects.mapError (\_error -> "invalid path")
  output <- paths.child "output.txt" (paths.current ())
    |> effects.fromEither
    |> effects.mapError (\_error -> "invalid path")
  original <- fs.readTextUtf8 input |> effects.mapError (\_error -> "read failure")
  rendered <- codec.render original |> effects.fromEither
  fs.writeTextUtf8 fs.Replace rendered output |> effects.mapError (\_error -> "write failure")
}
