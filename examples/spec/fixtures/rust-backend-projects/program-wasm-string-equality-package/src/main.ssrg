import * as dom from "std/web/dom"
import * as effects from "std/effect"
import * as html from "std/web/html"
import * as signals from "std/signal"

foreign "typescript" from "../host/bridge.ts" {
  task fn compare input: String -> String
}

type Action = | Compare

fn view status: String -> html.Html<Action> = html.main {
  children: [
    html.h1 { children: "String equality in program WASM" },
    html.pre { id: "status", children: status },
    html.button { id: "compare", onClick: Compare, children: "Compare ready" }
  ]
}

effect fn dispatch state: signals.MutableSignal<String> -> _action: Action -> Unit fails Js.Error = do {
  result <- compare "ready\n"
  signals.update (\_ -> result) state
}

pub effect fn main -> Unit with Dom fails String = do {
  state <- signals.make "Ready to compare"
  target <- dom.query "#app" |> effects.mapError show
  dom.run (dom.defaultOptions ()) target (dispatch state) (signals.map view state)
    |> effects.mapError show
}
