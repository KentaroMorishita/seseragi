import { ExportedBox as Foreign, ExportedTrait as Display, rendered, boxed } from "./facade"
import * as refs from "std/ref"

type Box<A> = | Local A
trait Render<A> {
  fn own value: A -> String
}
instance Render<Int> {
  fn own value: Int -> String = "own=" + show value
}

fn retained<A> seed: Foreign<A> -> (Bool -> String) where Display<Foreign<A>> = {
  let local = \value -> rendered seed + ":" + show value
  local
}

pub fn probe -> Array<String> = {
  let display = \value -> rendered value
  let current = retained (boxed 9)
  let prefix = \text: String -> \value -> text + display value
  let saved: Foreign<Int> -> String = prefix "saved="
  [display (boxed 42), display (boxed True), saved (boxed 7), current False, own 1]
}

pub effect fn main = do {
  let display = \value -> rendered value
  values <- refs.make (retained (boxed 3))
  saved <- refs.get values
  println (saved True)
  let later = \value: Foreign<Int> -> do {
    current <- refs.get values
    println (current False + "/" + display value)
  }
  let cold = later (boxed 8)
  println "cold"
  cold
  refs.set (retained (boxed 4)) values
  cold
}
