import { older, render, Label, cold } from "./facade"

pub fn probe -> String = {
  let saved = older 40
  render (Label (saved 2))
}

pub effect fn main = do {
  let deferred = cold ()
  println (probe ())
  deferred
}

import { Tagged, Count, Point, Higher } from "./facade"

pub fn specimens -> (Count, Point, Tagged<Int>, Higher<Array, Int>) =
  (Count 1, Point { x: 2 }, Tagged 3, Higher [4])
