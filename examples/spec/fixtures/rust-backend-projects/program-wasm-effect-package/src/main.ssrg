import * as dom from "std/web/dom"
import * as effects from "std/effect"
import * as html from "std/web/html"
import * as signals from "std/signal"

foreign "typescript" from "../host/bridge.ts" {
  task fn operate action: String -> input: String -> String
}

type Action =
  | Prepare | Run | Failure | Defect | Cleanup
  | Callback | CallCallback | Detach
  | Start | Cancel | StartCleanup | Dispose | Reload

fn view state: (Int, String) -> html.Html<Action> = {
  let (count, status) = state
  html.main {
    children: [
      html.h1 { children: "Seseragi Effect program WASM" },
      html.p { children: "冷たいEffectを明示runし、失敗・キャンセルと解放を確認します。" },
      html.pre { id: "status", children: status },
      html.button { id: "prepare", onClick: Prepare, children: "planを作る" },
      html.button { id: "run", onClick: Run, children: "run／再実行" },
      html.button { id: "failure", onClick: Failure, children: "型付き失敗" },
      html.button { id: "defect", onClick: Defect, children: "Defect" },
      html.button { id: "cleanup", onClick: Cleanup, children: "finalizerのDefect" },
      html.button { id: "callback", onClick: Callback, children: "callbackを受け取る" },
      html.button { id: "call-callback", onClick: CallCallback, children: "callbackを呼ぶ" },
      html.button { id: "detach", onClick: Detach, children: "callbackを解放" },
      html.button { id: "start", onClick: Start, children: "継続するEffectを開始" },
      html.button { id: "cancel", onClick: Cancel, children: "cancelして終了を待つ" },
      html.button { id: "start-cleanup", onClick: StartCleanup, children: "解放を報告するEffectを開始" },
      html.button { id: "dispose", onClick: Dispose, children: "instanceを解放して待つ" },
      html.button { id: "reload", onClick: Reload, children: "再生成" },
      html.p { id: "count", children: `操作: ${count}` }
    ]
  }
}

effect fn dispatch state: signals.MutableSignal<(Int, String)>
  -> action: Action
  -> Unit
fails Js.Error = do {
  current <- signals.read state
  let (count, _) = current
  let next = count + 1
  let name = match action {
    Prepare -> "prepare"
    Run -> "run"
    Failure -> "failure"
    Defect -> "defect"
    Cleanup -> "cleanup"
    Callback -> "callback"
    CallCallback -> "call-callback"
    Detach -> "detach"
    Start -> "start"
    Cancel -> "cancel"
    StartCleanup -> "start-cleanup"
    Dispose -> "dispose"
    Reload -> "reload"
  }
  status <- operate name `雪 / 操作 ${next}`
  signals.update (\_ -> (next, status)) state
}

effect fn release _initial: String -> Unit = do {
  _ <- effects.attempt (operate "finalize" "UI finalizer")
  effects.succeed ()
}

pub effect fn main -> Unit with Dom fails String = do {
  initial <- effects.acquireRelease (operate "reload" "初期") release
    |> effects.mapError show
  state <- signals.make (0, initial)
  target <- dom.query "#app" |> effects.mapError show
  dom.run (dom.defaultOptions ()) target (dispatch state) (signals.map view state)
    |> effects.mapError show
}
