import * as effects from "std/effect"
import * as refs from "std/ref"
import * as either from "std/either"

effect fn ignore _error:ConsoleError -> Unit with Console = effects.succeed ()
effect fn say message:String -> Unit with Console = println message |> effects.recover ignore
fn choose value:Int -> Either<String,Int> = if value == 0 then Left "first" else Right (value + 10)
fn callback seed:Int -> (Int -> Either<String,Int>) = if seed == 0 then choose else choose
fn errorCallback seed:Int -> (String -> String) = if seed == 0 then (\message:String -> message) else (\message:String -> message)
fn left -> Either<String,Int> = Left "left"
fn right -> Either<String,Int> = Right 7
fn transformWith offset:Int -> (Array<Int> -> Either<String,Array<Int>>) = either.traverse (\value:Int -> Right (value + offset))
effect fn failBody -> Unit fails String = do {
  let _computed = either.traverse choose [1,2,3]
  effects.fail "typed"
}
pub effect fn main = do {
  released <- refs.make 0
  saved <- refs.make (transformWith 10)
  let cold = effects.defer $ \_:Unit -> do {
    say "cold"
    operation <- refs.get saved
    say (match operation [1,2,3] { Left message -> message; Right values -> show values })
    effects.succeed ()
  }
  say "created"
  effects.scoped (do {
    effects.acquireRelease (say "acquired") (\_:Unit -> do {
      refs.update (\n -> n + 1) released
      say "released"
    })
    cold
    cold
    failBody ()
  }) |> effects.recover (\message:String -> say ("recovered: " + message))
  count <- refs.get released
  say ("released: " + show count)
}
