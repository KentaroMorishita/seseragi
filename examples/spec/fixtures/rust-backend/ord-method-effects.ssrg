import * as effects from "std/effect"
import * as refs from "std/ref"
import { Ref } from "std/ref"

type Watch = | Watch Ref<Watch -> Ordering>
instance Eq<Watch> {
  fn eq left: Watch -> right: Watch -> Bool = True
}
instance Ord<Watch> {
  fn compare left: Watch -> (Watch -> Ordering) = {
    let cold = match left { Watch state -> refs.get state }
    \right -> { let retained = cold; Equal }
  }
}

effect fn delayed = do { println "cold"; effects.succeed 42 }

pub effect fn main = do {
  callbacks <- refs.make (\value: Watch -> Less)
  released <- refs.make 0
  let left = Watch callbacks
  let cold = delayed ()
  let operator = compare
  let selected = operator
  let saved = selected left
  refs.set saved callbacks
  println "created"
  effects.scoped $ do {
    effects.acquireRelease (effects.succeed saved) (\held: (Watch -> Ordering) -> refs.set 1 released)
    again <- refs.get callbacks
    value <- cold
    println (show value)
    println (match again left { Equal -> "equal"; _ -> "wrong" })
    println (match saved left { Equal -> "equal"; _ -> "wrong" })
  }
  count <- refs.get released
  println ("released: " + show count)
}
