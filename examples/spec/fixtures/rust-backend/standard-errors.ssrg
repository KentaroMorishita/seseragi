    displayed (children.ChildOutputLimitExceeded { channel: children.ChildStderr, limitBytes: (-9007199254740991) }) + " | " + inspected (children.ChildOutputLimitExceeded { channel: children.ChildStderr, limitBytes: (-9007199254740991) }),
