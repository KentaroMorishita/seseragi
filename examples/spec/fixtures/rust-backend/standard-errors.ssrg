pub fn probe -> String = join "\n" [
  debug (checkBenchmarkFailure ()),
  debug (checkBigIntConversionError ()),
  debug (checkBigIntDivisionError ()),
  debug (checkBigIntParseError ()),
  debug (checkBigIntPowerError ()),
  debug (checkBase64DecodeError ()),
  debug (checkHexDecodeError ()),
  debug (checkByteError ()),
  debug (checkBytesSliceError ()),
  debug (checkChildProcessConfigError ()),
  debug (checkChildProcessError ()),
  debug (checkSizeError ()),
  debug (checkDecimalArithmeticError ()),
  debug (checkDecimalContextError ()),
  debug (checkDecimalConversionError ()),
  debug (checkDecimalParseError ()),
  debug (checkParallelismError ()),
  debug (checkScheduleError ()),
  debug (checkEntropyConfigError ()),
  debug (checkEntropyError ()),
  debug (checkFileSystemErrorKind ()),
  debug (checkFileTextError ()),
  debug (checkHttpBuildError ()),
  debug (checkHttpError ()),
  debug (checkIntParseError ()),
  debug (checkPathError ()),
  debug (checkStdinError ()),
  debug (checkProcessError ()),
  debug (checkQueueClosed ()),
  debug (checkQueueCreateError ()),
  debug (checkRandomConfigError ()),
  debug (checkRandomRangeError ()),
  debug (checkRegexCompileError ()),
  debug (checkRegexCompileErrorKind ()),
  debug (checkSemaphoreCreateError ()),
  debug (checkStdinConfigError ()),
  debug (checkBufferCapacityError ()),
  debug (checkGraphemeSliceError ()),
  debug (checkTextSliceError ()),
  debug (checkUtf8DecodeError ()),
  debug (checkDateTimeError ()),
  debug (checkDurationError ()),
  debug (checkTimeZoneError ()),
  debug (checkDomError ()),
  debug (checkDomRuntimeError ()),
  debug (checkHtmlBuildError ()),
  debug (checkNavigationError ()),
  debug (checkUrlBuildError ()),
  debug (checkStorageError ())
]
pub effect fn main = println (probe ())
