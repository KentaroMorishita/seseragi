fn checkBigIntParseError -> String = {
  let savedShow: big.BigIntParseError -> String = show
  let savedDebug: big.BigIntParseError -> String = debug
  let savedEq: big.BigIntParseError -> big.BigIntParseError -> Bool = eq
  let partial = savedEq big.EmptyBigInt
  join "\n" [
    "std/big-int::BigIntParseError",
    displayed big.EmptyBigInt + " | " + inspected big.EmptyBigInt,
    displayed (big.InvalidBigIntRadix 0) + " | " + inspected (big.InvalidBigIntRadix 0),
    displayed (big.InvalidBigIntRadix (-9007199254740991)) + " | " + inspected (big.InvalidBigIntRadix (-9007199254740991)),
    displayed (big.InvalidBigIntDigit { offset: 0, radix: 0 }) + " | " + inspected (big.InvalidBigIntDigit { offset: 0, radix: 0 }),
    displayed (big.InvalidBigIntDigit { offset: (-9007199254740991), radix: (-9007199254740991) }) + " | " + inspected (big.InvalidBigIntDigit { offset: (-9007199254740991), radix: (-9007199254740991) }),
    savedShow (big.InvalidBigIntDigit { offset: (-9007199254740991), radix: (-9007199254740991) }),
    savedDebug (big.InvalidBigIntDigit { offset: (-9007199254740991), radix: (-9007199254740991) }),
    show (equal big.EmptyBigInt big.EmptyBigInt),
    show (equal (big.InvalidBigIntRadix 0) (big.InvalidBigIntRadix 0)),
    show (equal (big.InvalidBigIntRadix (-9007199254740991)) (big.InvalidBigIntRadix (-9007199254740991))),
    show (equal (big.InvalidBigIntDigit { offset: 0, radix: 0 }) (big.InvalidBigIntDigit { offset: 0, radix: 0 })),
    show (equal (big.InvalidBigIntDigit { offset: (-9007199254740991), radix: (-9007199254740991) }) (big.InvalidBigIntDigit { offset: (-9007199254740991), radix: (-9007199254740991) })),
    show (partial big.EmptyBigInt),
    show (partial (big.InvalidBigIntRadix 0)),
    show (partial (big.InvalidBigIntRadix (-9007199254740991))),
    show (partial (big.InvalidBigIntDigit { offset: 0, radix: 0 })),
    show (partial (big.InvalidBigIntDigit { offset: (-9007199254740991), radix: (-9007199254740991) }))
  ]
}

