fn displayed<A> value: A -> String where Show<A> = show value
fn inspected<A> value: A -> String where Debug<A> = debug value
fn equal<A> left: A -> right: A -> Bool where Eq<A> = left == right
fn regexError -> regex.RegexCompileError = match regex.compile "(" { Left error -> error; Right _ -> regexError () }
fn domFailure value: dom.DomError -> dom.DomRuntimeError<String> = dom.DomFailure value

fn checkBenchmarkFailure -> String = {
  let savedShow: benchmarks.BenchmarkFailure -> String = show
  let savedEq: benchmarks.BenchmarkFailure -> benchmarks.BenchmarkFailure -> Bool = eq
  let partial = savedEq (benchmarks.ExplicitBenchmarkFailure "")
  join "\n" [
    "std/benchmark::BenchmarkFailure",
    displayed (benchmarks.ExplicitBenchmarkFailure ""),
    displayed (benchmarks.ExplicitBenchmarkFailure "雪🙂\n\t\"\\\u{0}"),
    savedShow (benchmarks.ExplicitBenchmarkFailure "雪🙂\n\t\"\\\u{0}"),
    show (equal (benchmarks.ExplicitBenchmarkFailure "") (benchmarks.ExplicitBenchmarkFailure "")),
    show (equal (benchmarks.ExplicitBenchmarkFailure "雪🙂\n\t\"\\\u{0}") (benchmarks.ExplicitBenchmarkFailure "雪🙂\n\t\"\\\u{0}")),
    show (partial (benchmarks.ExplicitBenchmarkFailure "")),
    show (partial (benchmarks.ExplicitBenchmarkFailure "雪🙂\n\t\"\\\u{0}"))
  ]
}

fn checkBigIntConversionError -> String = {
  let savedShow: big.BigIntConversionError -> String = show
  let savedDebug: big.BigIntConversionError -> String = debug
  let savedEq: big.BigIntConversionError -> big.BigIntConversionError -> Bool = eq
  let partial = savedEq big.BigIntOutsideIntRange
  join "\n" [
    "std/big-int::BigIntConversionError",
    displayed big.BigIntOutsideIntRange + " | " + inspected big.BigIntOutsideIntRange,
    savedShow big.BigIntOutsideIntRange,
    savedDebug big.BigIntOutsideIntRange,
    show (equal big.BigIntOutsideIntRange big.BigIntOutsideIntRange),
    show (partial big.BigIntOutsideIntRange)
  ]
}

