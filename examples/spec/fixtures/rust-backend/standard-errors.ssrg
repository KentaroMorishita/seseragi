  join "\n" [
    "std/time::DateTimeError",
    displayed (time.InvalidDate { year: 0, month: 0, day: 0 }) + " | " + inspected (time.InvalidDate { year: 0, month: 0, day: 0 }),
    displayed (time.InvalidDate { year: (-9007199254740991), month: (-9007199254740991), day: (-9007199254740991) }) + " | " + inspected (time.InvalidDate { year: (-9007199254740991), month: (-9007199254740991), day: (-9007199254740991) }),
    displayed (time.InvalidTime { hour: 0, minute: 0, second: 0, nanosecond: 0 }) + " | " + inspected (time.InvalidTime { hour: 0, minute: 0, second: 0, nanosecond: 0 }),
    displayed (time.InvalidTime { hour: (-9007199254740991), minute: (-9007199254740991), second: (-9007199254740991), nanosecond: (-9007199254740991) }) + " | " + inspected (time.InvalidTime { hour: (-9007199254740991), minute: (-9007199254740991), second: (-9007199254740991), nanosecond: (-9007199254740991) }),
    displayed (time.InvalidUtcOffsetSeconds 0) + " | " + inspected (time.InvalidUtcOffsetSeconds 0),
    displayed (time.InvalidUtcOffsetSeconds (-9007199254740991)) + " | " + inspected (time.InvalidUtcOffsetSeconds (-9007199254740991)),
    displayed (time.InvalidDateTimeText { offset: 0 }) + " | " + inspected (time.InvalidDateTimeText { offset: 0 }),
    displayed (time.InvalidDateTimeText { offset: (-9007199254740991) }) + " | " + inspected (time.InvalidDateTimeText { offset: (-9007199254740991) }),
    savedShow (time.InvalidDateTimeText { offset: (-9007199254740991) }),
    savedDebug (time.InvalidDateTimeText { offset: (-9007199254740991) })
  ]
}

