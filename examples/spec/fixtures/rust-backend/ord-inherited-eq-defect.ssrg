import * as effects from "std/effect"

type Mark = | Mark Int
instance Eq<Mark> {
  fn eq left: Mark -> (Mark -> Bool) = {
    let bad = 9007199254740991 + 1
    \right -> True
  }
}
instance Ord<Mark> {
  fn compare left: Mark -> right: Mark -> Ordering = Equal
}

fn selected<A> left: A -> (A -> Bool) where Ord<A> = {
  let chosen: A -> A -> Bool = (==)
  chosen left
}

pub effect fn main = effects.scoped $ do {
  effects.acquireRelease (println "acquired") (
    \unit: Unit -> effects.recover (\error: ConsoleError -> effects.succeed ())
      (println "released")
  )
  let saved = selected (Mark 1)
  println "unreachable"
}
