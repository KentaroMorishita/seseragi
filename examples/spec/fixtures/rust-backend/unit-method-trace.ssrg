trait Start<A> {
  fn start -> (A -> Bool)
}

instance Start<Int> {
  fn start -> (Int -> Bool) = \value -> False
}

fn selectStage -> (Unit -> Int -> Bool) = start<Int>
fn argumentStage -> Unit = ()

pub fn probe -> String = {
  let chosen = selectStage ()
  let held = chosen (argumentStage ())
  show (held 7) + ":" + show (held 9)
}

pub effect fn main = println (probe ())
