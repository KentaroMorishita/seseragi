import * as arrays from "std/array"

fn fixed values: Array<Int> -> String = match values {
  [] -> "empty"
  [1] -> "one"
  [a, b] -> show (a, b)
  _ -> "other"
}

fn suffix values: Array<Int> -> String = match values {
  [head, ...tail] when head == 1 && arrays.length tail == 1 -> "guarded"
  [1, 2, 3] -> "fallback"
  [head, ...tail] -> show (head, tail)
  [] -> "empty"
}

fn whole<A> values: Array<A> -> Array<A> = match values { [...rest] -> rest }

fn nested values: Array<Maybe<(Int, Array<Int>, List<Int>)>> -> String = match values {
  [Just (1, [2, ...tail], `[3, ...linked]), ...rest] when arrays.isEmpty tail -> "guarded"
  [Just (1, [2, ...tail], `[3, ...linked]), ...rest] -> show (tail, linked, rest)
  _ -> "other"
}

fn record values: Array<{ name: String, flags: Array<Bool> }> -> String = match values {
  [{ name: "雪", flags: [True, False] }] -> "record"
  _ -> "other"
}

fn linked values: List<Array<Int>> -> String = match values {
  `[] -> "empty"
  `[[1], [2]] -> "fixed"
  `[[head, ...tail], ...rest] when arrays.isEmpty tail -> "guarded"
  `[[head, ...tail], ...rest] -> show (head, tail, rest)
  _ -> "other"
}

fn allList values: List<Int> -> List<Int> = match values { `[...rest] -> rest }

fn scrutinee -> Array<Int> = [1, 2, 3]

fn once -> String = match scrutinee () {
  [] -> "empty"
  [head, ...tail] when head == 9 -> "first"
  [head, ...tail] when arrays.isEmpty tail -> "second"
  [1, 2, 3] -> "once"
  _ -> "other"
}

pub effect fn main = do {
  let empty: Array<Int> = []
  println (fixed [])
  println (fixed [1])
  println (fixed [9])
  println (fixed [2, 3])
  println (fixed [1, 2, 3])
  println (suffix [])
  println (suffix [1])
  println (suffix [1, 2])
  println (suffix [1, 2, 3])
  println (suffix [4, 5, 6, 7])
  println (show (whole empty))
  println (show (whole ["雪", "🙂"]))
  println (nested [Just (1, [2, 4], `[3, 5]), Nothing])
  println (nested [Just (1, [2], `[3])])
  println (nested [Just (1, [], `[3])])
  println (nested [Nothing])
  println (record [{ name: "雪", flags: [True, False] }])
  println (record [{ name: "雪", flags: [] }])
  println (linked `[])
  println (linked `[[1], [2]])
  println (linked `[[1]])
  println (linked `[[1, 2, 3], [4]])
  println (linked `[[]])
  println (show (allList `[1, 2, 3]))
  println (show (allList `[]))
  println (once ())
}
