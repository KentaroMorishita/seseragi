import * as decimal from "std/decimal"
import * as effects from "std/effect"
import * as refs from "std/ref"
import * as maps from "std/map"

fn value source: String -> decimal.Decimal = match decimal.parse source { Right result -> result; Left _ -> decimal.fromInt (42 / 0) }
effect fn ignore _error: ConsoleError -> Unit with Console = effects.succeed ()
effect fn say message: String -> Unit with Console = println message |> effects.recover ignore
effect fn failBody -> Unit fails String = effects.fail "typed"

pub effect fn main = do {
  released <- refs.make 0
  saved <- refs.make (\_: Unit -> effects.succeed 0)
  let callback = \_: Unit -> do {
    _ <- refs.get saved
    effects.succeed 42
  }
  refs.set callback saved
  let stored = maps.singleton (value "1.20") callback |> maps.insert (value "2") callback
  let equal: decimal.Decimal -> Bool = eq (value "1.2")
  let hashed: decimal.Decimal -> Int = hash
  let cold = effects.defer $ \_: Unit -> do {
    say "cold"
    let found = match maps.get (value "1.200") stored { Nothing -> callback; Just selected -> selected }
    say (show (equal (value "12e-1")))
    say (show (hashed (value "1.2") == hash (value "1.20")))
    refs.set found saved
    answer <- found ()
    say (show answer)
    effects.succeed answer
  }
  say "created"
  effects.scoped (do {
    effects.acquireRelease (say "acquired") (\_: Unit -> do {
      refs.update (\n -> n + 1) released
      say "released"
    })
    first <- cold
    second <- cold
    say (show (first + second))
    failBody ()
  }) |> effects.recover (\message: String -> say ("recovered: " + message))
  count <- refs.get released
  say ("released: " + show count)
}
