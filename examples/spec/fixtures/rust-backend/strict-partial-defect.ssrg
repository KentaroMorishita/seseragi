import * as effects from "std/effect"

pub effect fn main = effects.scoped $ do {
  effects.acquireRelease (do { println "acquired";
    effects.succeed () }) (
      \_: Unit -> effects.recover (\_: ConsoleError -> effects.succeed ())
        (println "released")
    )
  println {
    fn prefix<A> value: A -> suffix: String -> String where Show<A> =
      show value + suffix
    let saved = prefix [9007199254740991 + 1][0]
    "unreachable"
  }
}
