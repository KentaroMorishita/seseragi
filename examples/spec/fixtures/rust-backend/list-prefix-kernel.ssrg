fn build remaining: Int -> values: List<Int> -> List<Int> =
  if remaining <= 0 then values else build (remaining - 1) (remaining: values)

fn step1 values: List<Int> -> Int = match values {
  `[v0, ...tail] -> v0
  _ -> -1
}

fn repeat1 remaining: Int -> values: List<Int> -> total: Int -> Int =
  if remaining <= 0 then total
  else repeat1 (remaining - 1) values (total + step1 values)

pub fn kernel1 count: Int -> Int = repeat1 count (build 1 `[]) 0

fn step4 values: List<Int> -> Int = match values {
  `[v0, v1, v2, v3, ...tail] -> v0 + v1 + v2 + v3
  _ -> -1
}

fn repeat4 remaining: Int -> values: List<Int> -> total: Int -> Int =
  if remaining <= 0 then total
  else repeat4 (remaining - 1) values (total + step4 values)

pub fn kernel4 count: Int -> Int = repeat4 count (build 4 `[]) 0

fn step16 values: List<Int> -> Int = match values {
  `[v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, ...tail] -> v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15
  _ -> -1
}

fn repeat16 remaining: Int -> values: List<Int> -> total: Int -> Int =
  if remaining <= 0 then total
  else repeat16 (remaining - 1) values (total + step16 values)

pub fn kernel16 count: Int -> Int = repeat16 count (build 16 `[]) 0

fn step32 values: List<Int> -> Int = match values {
  `[v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31, ...tail] -> v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20 + v21 + v22 + v23 + v24 + v25 + v26 + v27 + v28 + v29 + v30 + v31
  _ -> -1
}

fn repeat32 remaining: Int -> values: List<Int> -> total: Int -> Int =
  if remaining <= 0 then total
  else repeat32 (remaining - 1) values (total + step32 values)

pub fn kernel32 count: Int -> Int = repeat32 count (build 32 `[]) 0

pub fn probe -> Int = kernel1 1000 + kernel4 1000 + kernel16 1000 + kernel32 1000
