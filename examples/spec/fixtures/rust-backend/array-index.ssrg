type Box<A> = | Box A

instance<A> Show<Box<A>> where Show<A> {
  fn show value: Box<A> -> String = match value { Box item -> "box=" + show item }
}

pub effect fn main = println (show (probe ()))

fn lookup<A> values: Array<A> -> offset: Int -> Maybe<A> = values[offset]

fn keep<A> value: A -> (Unit -> A) = \_: Unit -> value

pub fn probe -> Array<String> = {
  let values = [10, 20, 30]
  let empty: Array<Int> = []
  let saved = lookup values
  let callback = match [keep 42][0] { Just selected -> selected; Nothing -> keep 0 }
  let display: Box<Char> -> String = show
  let selected = match [display][0] { Just render -> render; Nothing -> \_: Box<Char> -> "missing" }
  let render: Maybe<Box<Char>> -> String = show
  [
    show values[0],
    show values[2],
    show values[-1],
    show values[3],
    show values[9007199254740991],
    show values[-9007199254740991],
    show empty[0],
    show (saved 1),
    show (callback ()),
    selected (Box '🙂'),
    show [[Box "λ"]][0],
    show [True, False][1],
    debug ["line\n"][0],
    show [[1][0]][0],
    render [Box 'λ'][0]
  ]
}
