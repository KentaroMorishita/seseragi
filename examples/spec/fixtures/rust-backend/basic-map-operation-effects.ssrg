import * as effects from "std/effect"
import * as refs from "std/ref"
import * as maps from "std/map"
import * as arrays from "std/array"

effect fn ignore _error: ConsoleError -> Unit with Console = effects.succeed ()
effect fn say message: String -> Unit with Console = println message |> effects.recover ignore
effect fn failBody -> Unit fails String = effects.fail "typed"
fn selected _key: String -> value: Int -> Bool = value > 0
fn mapper value: Int -> Int = value + 1

pub effect fn main = do {
  released <- refs.make 0
  saved <- refs.make (\_: Unit -> effects.succeed 0)
  let callback = \_: Unit -> do {
    _ <- refs.get saved
    let input = maps.singleton "first" 20 |> maps.insert "second" 21
    let filtered = maps.filter selected input
    let mapped = maps.mapValues mapper filtered
    let values = maps.values mapped
    let first = match arrays.get 0 values { Nothing -> 0; Just value -> value }
    let second = match arrays.get 1 values { Nothing -> 0; Just value -> value }
    effects.succeed (first + second)
  }
  let stored = maps.singleton "callback" callback
  let functions = maps.mapValues (\call -> call) stored
  let selected = match arrays.get 0 (maps.values functions) {
    Nothing -> \_: Unit -> effects.succeed (-1)
    Just call -> call
  }
  refs.set selected saved
  let cold = effects.defer $ \_: Unit -> do {
    say "cold"
    read <- refs.get saved
    answer <- read ()
    say (show answer)
    effects.succeed answer
  }
  say "created"
  effects.scoped (do {
    effects.acquireRelease (say "acquired") (\_: Unit -> do {
      refs.update (\n -> n + 1) released
      say "released"
    })
    first <- cold
    second <- cold
    say (show (first + second))
    failBody ()
  }) |> effects.recover (\message: String -> say ("recovered: " + message))
  count <- refs.get released
  say ("released: " + show count)
}
