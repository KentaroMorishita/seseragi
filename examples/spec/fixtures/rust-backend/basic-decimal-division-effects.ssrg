import * as effects from "std/effect"
import * as refs from "std/ref"
import * as decimal from "std/decimal"
import * as numbers from "std/number"

effect fn ignore _error:ConsoleError -> Unit with Console = effects.succeed ()
effect fn say message:String -> Unit with Console = println message |> effects.recover ignore
fn value source:String -> decimal.Decimal = match decimal.parse source { Right result -> result; Left _ -> decimal.fromInt (42 / 0) }
fn chosen precision:Int -> decimal.DecimalContext = match decimal.context precision numbers.HalfEven { Right context -> context; Left _ -> chosen 1 }
fn report result:Either<decimal.DecimalArithmeticError,decimal.Decimal> -> String = match result { Right result -> show result; Left _ -> "unexpected" }
fn arithmeticWith number:decimal.Decimal -> (Unit -> String) = {
  let divide = decimal.divide (chosen 4)
  let dividedByThree = divide (value "3")
  let exact = decimal.divideExact (value "0.08")
  let quantize = decimal.quantize 1 numbers.HalfEven
  \_:Unit -> report (dividedByThree number) + ":" + show (quantize number) + ":" + report (exact number)
}
effect fn failBody -> Unit fails decimal.DecimalArithmeticError = do {
  _value <- decimal.divide (chosen 4) (decimal.fromInt 0) (decimal.fromInt 7) |> effects.fromEither
  effects.succeed ()
}
pub effect fn main = do {
  released <- refs.make 0
  saved <- refs.make (arithmeticWith (value "1.25"))
  let cold = effects.defer $ \_:Unit -> do {
    say "cold"
    operation <- refs.get saved
    say (operation ())
    effects.succeed ()
  }
  say "created"
  effects.scoped (do {
    effects.acquireRelease (say "acquired") (\_:Unit -> do {
      refs.update (\n -> n + 1) released
      say "released"
    })
    cold
    cold
    failBody ()
  }) |> effects.recover (\_error:decimal.DecimalArithmeticError -> say "recovered: zero")
  count <- refs.get released
  say ("released: " + show count)
}
