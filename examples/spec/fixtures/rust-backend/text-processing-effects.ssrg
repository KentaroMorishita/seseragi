import * as effects from "std/effect"
import * as arrays from "std/array"
import * as lists from "std/list"
import * as text from "std/text"

pub fn clean content: String -> String = {
  let selected = content
    |> text.lines
    |> arrays.toList
    |> lists.filter (\line: String -> line != "")
    |> lists.toArray
  let joined = text.join "\n" selected
  if joined == "" then "" else joined + "\n"
}


effect fn ignore _error: ConsoleError -> Unit with Console = effects.succeed ()

effect fn say message: String -> Unit with Console =
  println message
  |> effects.recover ignore

effect fn release _unit: Unit -> Unit with Console = say "released"

effect fn body mode: String -> String with Console fails String = effects.scoped $ do {
  effects.acquireRelease (say "acquired") release
  let captured = "雫\r\n\r\n🙂\n"
  let plan = effects.defer $ \_: Unit -> do {
    let normalized = clean captured
    if mode == "fail" then effects.fail "body failure"
    else if mode == "defect" then effects.die "body defect"
    else effects.succeed normalized
  }
  say "cold"
  first <- plan
  second <- plan
  effects.succeed (first + second)
}

effect fn report error: String -> String with Console = effects.succeed ("Failure: " + error)

pub effect fn main = do {
  result <- body "ready" |> effects.recover report
  println result
}
