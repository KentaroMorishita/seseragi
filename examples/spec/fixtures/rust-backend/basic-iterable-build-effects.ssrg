import * as effects from "std/effect"
import * as refs from "std/ref"
import * as arrays from "std/array"
import * as lists from "std/list"
import * as maps from "std/map"
import * as sets from "std/set"
import * as iterator from "std/iterator"

newtype Bag = Array<Int>
instance Iterable<Bag,Int> { fn iterate bag:Bag -> iterator.Iterator<Int> = match bag { Bag values -> iterator.unfold (\index:Int -> match arrays.get index values { Nothing -> Nothing; Just value -> Just (value,index + 1) }) 0 } }
fn advance state:Int -> Maybe<(Int,Int)> = if state >= 3 then Nothing else Just (state,state + 1)
newtype Broken = Unit
instance Iterable<Broken,Int> { fn iterate _value:Broken -> iterator.Iterator<Int> = if 42 / 0 == 0 then iterator.unfold advance 0 else iterator.unfold advance 1 }
newtype BadHash = Int
instance Eq<BadHash> { fn eq _left:BadHash -> _right:BadHash -> Bool = True }
instance Hash<BadHash> { fn hash _value:BadHash -> Int = 42 / 0 }
newtype BadEq = Int
instance Eq<BadEq> { fn eq _left:BadEq -> _right:BadEq -> Bool = 42 / 0 == 0 }
instance Hash<BadEq> { fn hash _value:BadEq -> Int = 0 }
effect fn ignore _error:ConsoleError -> Unit with Console = effects.succeed ()
effect fn say message:String -> Unit with Console = println message |> effects.recover ignore
fn transformWith values:Array<Int> -> (Unit -> String) = {
  let asArray:Bag -> Array<Int> = arrays.fromIterable
  let asList:Bag -> List<Int> = lists.fromIterable
  let asSet:Bag -> sets.Set<Int> = sets.fromIterable
  let entries:Array<(Int,String)> = [(1,"old"),(2,"second"),(1,"new")]
  let asMap:Array<(Int,String)> -> maps.Map<Int,String> = maps.fromEntries
  \_:Unit -> show (asArray (Bag values)) + "|" + show (asList (Bag values)) + "|" + show (sets.toArray (asSet (Bag values))) + "|" + show (maps.entries (asMap entries))
}
effect fn failBody -> Unit fails String = do {
  let _computed = arrays.fromIterable (iterator.unfold advance 0)
  effects.fail "typed"
}
pub effect fn main = do {
  released <- refs.make 0
  saved <- refs.make (transformWith [1,2,1])
  let cold = effects.defer $ \_:Unit -> do {
    say "cold"
    operation <- refs.get saved
    say (operation ())
    effects.succeed ()
  }
  say "created"
  effects.scoped (do {
    effects.acquireRelease (say "acquired") (\_:Unit -> do {
      refs.update (\n -> n + 1) released
      say "released"
    })
    cold
    cold
    failBody ()
  }) |> effects.recover (\message:String -> say ("recovered: " + message))
  count <- refs.get released
  say ("released: " + show count)
}
