import * as maps from "std/map"
import * as sets from "std/set"

newtype Values<A> = Array<A>
instance<A> Iterable<Values<A>, A> {
  fn iterate source:Values<A> -> Iterator<A> = match source {
    Values items -> iterate items
  }
}

fn collect<C,A> source:C -> Array<A> where Iterable<C,A> = [x | x <- source]
fn closures -> Array<Unit -> Int> = [\_unit:Unit -> x | x <- [1,2,3]]

pub effect fn main = do {
  let maybes:Array<Maybe<Int>> = [Nothing,Just 2,Nothing,Just 4]
  let empty:Array<Int> = []
  let emptyList:List<Int> = `[]
  let records:Array<{ value:Maybe<Int> }> = [{ value: Nothing },{ value: Just 6 }]
  let wrapped:Array<Values<Int>> = [Values [],Values [8],Values [1,2]]
  println (show [(x,y) | x <- [1,2,3], x % 2 == 1, y <- `[x,x + 10], y > 2])
  println (show `[x + y | x <- 1..=3, y <- 0..x])
  println (show [x | Just x <- maybes, x > 2])
  println (show `[x | Just x <- `[Just 1,Nothing,Just 3]])
  println (show [x | x <- 4..1])
  println (show `[x | x <- empty])
  println (show [x + y | x <- [1,2], y <- emptyList])
  println (show [x | x <- sets.fromIterable [3,1,3,2]])
  println (show [(key,value) | (key,value) <- maps.fromEntries [("b",2),("a",1)]])
  println (show (collect (Values [9,7,5])))
  println (show (collect (iterate (2..=4))))
  println (show [x | [0,x,..._] <- [[0,2],[1,3],[0],[0,4,5]]])
  println (show [x | `[0,x,..._] <- `[`[0,2],`[1,3],`[0],`[0,4,5]]])
  println (show [x | { value: Just x } <- records])
  println (show [x | Values [x] <- wrapped])
  println (show [1 | True <- [False,True,True]])
  println (show [1 | '雪' <- ['雨','雪']])
  println (show [1 | "yes" <- ["no","yes"]])
  println (show [1 | `[1,2] <- [`[1],`[1,2],`[1,2,3]]])
  let x = 40
  println (show ([x | x <- [1,2]],x))
  println (show [f () | f <- closures ()])
  println (show (sum [n | n <- 1..=100000]))
  println (show (sum `[n | n <- 1..=100000]))
}
