import * as effects from "std/effect"

alias PreludeUnit = Unit

fn selected<Unit> -> (Unit -> Effect<{}, Never, String>) where Show<Unit> = {
  let display: Unit -> String = show;
  \value -> effects.defer (\_: PreludeUnit -> effects.succeed (display value))
}

pub effect fn main = do {
  let unit = ()
  let saved = selected<Int> unit
  let cold = saved 42
  println "created"
  first <- cold
  println first
  second <- cold
  println second
}
