import * as decimal from "std/decimal"
import * as numbers from "std/number"
fn value source:String -> decimal.Decimal = match decimal.parse source { Right result -> result; Left _ -> decimal.fromInt (42 / 0) }
fn report result:Either<decimal.DecimalArithmeticError,decimal.Decimal> -> String = match result { Right result -> show result; Left decimal.DecimalDivisionByZero -> "zero"; Left decimal.NonTerminatingDecimal -> "non-terminating" }
fn exact -> (decimal.Decimal -> decimal.Decimal -> String) = \divisor -> \dividend -> report (decimal.divideExact divisor dividend)
fn chosen precision:Int -> mode:numbers.RoundingMode -> decimal.DecimalContext = match decimal.context precision mode { Right context -> context; Left _ -> chosen 1 mode }
fn rounded -> (decimal.DecimalContext -> decimal.Decimal -> decimal.Decimal -> String) = \context -> \divisor -> \dividend -> report (decimal.divide context divisor dividend)
pub effect fn main = do {
  println (exact () (value "2") (value "5"))
  println (exact () (value "-2") (value "5"))
  println (exact () (value "2") (value "-5"))
  println (exact () (value "-2") (value "-5"))
  println (exact () (value "6") (value "9"))
  println (exact () (value "3") (value "6"))
  println (exact () (value "625") (value "1"))
  println (exact () (value "1024") (value "1"))
  println (exact () (value "0.0008") (value "-1.2"))
  println (exact () (value "79228162514264337593543950336") (value "1"))
  println (exact () (value "3") (value "1"))
  println (exact () (value "-6") (value "1"))
  println (exact () (value "0") (value "1"))
  println (exact () (value "0") (value "0"))
  println (exact () (value "1") (value "0"))
  println (exact () (value "100000000000000000000000000000000000000000000000000") (value "10"))
  println (rounded () (chosen 1 numbers.HalfEven) (value "2") (value "5"))
  println (rounded () (chosen 1 numbers.HalfEven) (value "2") (value "-5"))
  println (rounded () (chosen 1 numbers.HalfEven) (value "-2") (value "5"))
  println (rounded () (chosen 3 numbers.HalfEven) (value "3") (value "1"))
  println (rounded () (chosen 3 numbers.HalfEven) (value "3") (value "-1"))
  println (rounded () (chosen 3 numbers.HalfEven) (value "1000") (value "9995"))
  println (rounded () (chosen 17 numbers.HalfEven) (value "0.08") (value "123456789012345678901234567890.125"))
  println (show (decimal.quantize (0) numbers.HalfEven (value "2.5")))
  println (show (decimal.quantize (0) numbers.HalfEven (value "3.5")))
  println (show (decimal.quantize (0) numbers.HalfEven (value "-2.5")))
  println (show (decimal.quantize (0) numbers.HalfEven (value "-3.5")))
  println (show (decimal.quantize (0) numbers.HalfEven (value "2.49999")))
  println (show (decimal.quantize (0) numbers.HalfEven (value "-2.50001")))
  println (show (decimal.quantize (-1) numbers.HalfEven (value "25")))
  println (show (decimal.quantize (-1) numbers.HalfEven (value "-25")))
  println (show (decimal.quantize (-2) numbers.HalfEven (value "1350")))
  println (show (decimal.quantize (3) numbers.HalfEven (value "-0.0009")))
  println (show (decimal.quantize (2) numbers.HalfEven (value "9.999")))
  println (show (decimal.quantize (16) numbers.HalfEven (value "1.25")))
  println (rounded () (chosen 1 numbers.HalfUp) (value "2") (value "5"))
  println (rounded () (chosen 1 numbers.HalfUp) (value "2") (value "-5"))
  println (rounded () (chosen 1 numbers.HalfUp) (value "-2") (value "5"))
  println (rounded () (chosen 3 numbers.HalfUp) (value "3") (value "1"))
  println (rounded () (chosen 3 numbers.HalfUp) (value "3") (value "-1"))
  println (rounded () (chosen 3 numbers.HalfUp) (value "1000") (value "9995"))
  println (rounded () (chosen 17 numbers.HalfUp) (value "0.08") (value "123456789012345678901234567890.125"))
  println (show (decimal.quantize (0) numbers.HalfUp (value "2.5")))
  println (show (decimal.quantize (0) numbers.HalfUp (value "3.5")))
  println (show (decimal.quantize (0) numbers.HalfUp (value "-2.5")))
  println (show (decimal.quantize (0) numbers.HalfUp (value "-3.5")))
  println (show (decimal.quantize (0) numbers.HalfUp (value "2.49999")))
  println (show (decimal.quantize (0) numbers.HalfUp (value "-2.50001")))
  println (show (decimal.quantize (-1) numbers.HalfUp (value "25")))
  println (show (decimal.quantize (-1) numbers.HalfUp (value "-25")))
  println (show (decimal.quantize (-2) numbers.HalfUp (value "1350")))
  println (show (decimal.quantize (3) numbers.HalfUp (value "-0.0009")))
  println (show (decimal.quantize (2) numbers.HalfUp (value "9.999")))
  println (show (decimal.quantize (16) numbers.HalfUp (value "1.25")))
  println (rounded () (chosen 1 numbers.TowardZero) (value "2") (value "5"))
  println (rounded () (chosen 1 numbers.TowardZero) (value "2") (value "-5"))
  println (rounded () (chosen 1 numbers.TowardZero) (value "-2") (value "5"))
  println (rounded () (chosen 3 numbers.TowardZero) (value "3") (value "1"))
  println (rounded () (chosen 3 numbers.TowardZero) (value "3") (value "-1"))
  println (rounded () (chosen 3 numbers.TowardZero) (value "1000") (value "9995"))
  println (rounded () (chosen 17 numbers.TowardZero) (value "0.08") (value "123456789012345678901234567890.125"))
  println (show (decimal.quantize (0) numbers.TowardZero (value "2.5")))
  println (show (decimal.quantize (0) numbers.TowardZero (value "3.5")))
  println (show (decimal.quantize (0) numbers.TowardZero (value "-2.5")))
  println (show (decimal.quantize (0) numbers.TowardZero (value "-3.5")))
  println (show (decimal.quantize (0) numbers.TowardZero (value "2.49999")))
  println (show (decimal.quantize (0) numbers.TowardZero (value "-2.50001")))
  println (show (decimal.quantize (-1) numbers.TowardZero (value "25")))
  println (show (decimal.quantize (-1) numbers.TowardZero (value "-25")))
  println (show (decimal.quantize (-2) numbers.TowardZero (value "1350")))
  println (show (decimal.quantize (3) numbers.TowardZero (value "-0.0009")))
  println (show (decimal.quantize (2) numbers.TowardZero (value "9.999")))
  println (show (decimal.quantize (16) numbers.TowardZero (value "1.25")))
  println (rounded () (chosen 1 numbers.AwayFromZero) (value "2") (value "5"))
  println (rounded () (chosen 1 numbers.AwayFromZero) (value "2") (value "-5"))
  println (rounded () (chosen 1 numbers.AwayFromZero) (value "-2") (value "5"))
  println (rounded () (chosen 3 numbers.AwayFromZero) (value "3") (value "1"))
  println (rounded () (chosen 3 numbers.AwayFromZero) (value "3") (value "-1"))
  println (rounded () (chosen 3 numbers.AwayFromZero) (value "1000") (value "9995"))
  println (rounded () (chosen 17 numbers.AwayFromZero) (value "0.08") (value "123456789012345678901234567890.125"))
  println (show (decimal.quantize (0) numbers.AwayFromZero (value "2.5")))
  println (show (decimal.quantize (0) numbers.AwayFromZero (value "3.5")))
  println (show (decimal.quantize (0) numbers.AwayFromZero (value "-2.5")))
  println (show (decimal.quantize (0) numbers.AwayFromZero (value "-3.5")))
  println (show (decimal.quantize (0) numbers.AwayFromZero (value "2.49999")))
  println (show (decimal.quantize (0) numbers.AwayFromZero (value "-2.50001")))
  println (show (decimal.quantize (-1) numbers.AwayFromZero (value "25")))
  println (show (decimal.quantize (-1) numbers.AwayFromZero (value "-25")))
  println (show (decimal.quantize (-2) numbers.AwayFromZero (value "1350")))
  println (show (decimal.quantize (3) numbers.AwayFromZero (value "-0.0009")))
  println (show (decimal.quantize (2) numbers.AwayFromZero (value "9.999")))
  println (show (decimal.quantize (16) numbers.AwayFromZero (value "1.25")))
  println (rounded () (chosen 1 numbers.Floor) (value "2") (value "5"))
  println (rounded () (chosen 1 numbers.Floor) (value "2") (value "-5"))
  println (rounded () (chosen 1 numbers.Floor) (value "-2") (value "5"))
  println (rounded () (chosen 3 numbers.Floor) (value "3") (value "1"))
  println (rounded () (chosen 3 numbers.Floor) (value "3") (value "-1"))
  println (rounded () (chosen 3 numbers.Floor) (value "1000") (value "9995"))
  println (rounded () (chosen 17 numbers.Floor) (value "0.08") (value "123456789012345678901234567890.125"))
  println (show (decimal.quantize (0) numbers.Floor (value "2.5")))
  println (show (decimal.quantize (0) numbers.Floor (value "3.5")))
  println (show (decimal.quantize (0) numbers.Floor (value "-2.5")))
  println (show (decimal.quantize (0) numbers.Floor (value "-3.5")))
  println (show (decimal.quantize (0) numbers.Floor (value "2.49999")))
  println (show (decimal.quantize (0) numbers.Floor (value "-2.50001")))
  println (show (decimal.quantize (-1) numbers.Floor (value "25")))
  println (show (decimal.quantize (-1) numbers.Floor (value "-25")))
  println (show (decimal.quantize (-2) numbers.Floor (value "1350")))
  println (show (decimal.quantize (3) numbers.Floor (value "-0.0009")))
  println (show (decimal.quantize (2) numbers.Floor (value "9.999")))
  println (show (decimal.quantize (16) numbers.Floor (value "1.25")))
  println (rounded () (chosen 1 numbers.Ceiling) (value "2") (value "5"))
  println (rounded () (chosen 1 numbers.Ceiling) (value "2") (value "-5"))
  println (rounded () (chosen 1 numbers.Ceiling) (value "-2") (value "5"))
  println (rounded () (chosen 3 numbers.Ceiling) (value "3") (value "1"))
  println (rounded () (chosen 3 numbers.Ceiling) (value "3") (value "-1"))
  println (rounded () (chosen 3 numbers.Ceiling) (value "1000") (value "9995"))
  println (rounded () (chosen 17 numbers.Ceiling) (value "0.08") (value "123456789012345678901234567890.125"))
  println (show (decimal.quantize (0) numbers.Ceiling (value "2.5")))
  println (show (decimal.quantize (0) numbers.Ceiling (value "3.5")))
  println (show (decimal.quantize (0) numbers.Ceiling (value "-2.5")))
  println (show (decimal.quantize (0) numbers.Ceiling (value "-3.5")))
  println (show (decimal.quantize (0) numbers.Ceiling (value "2.49999")))
  println (show (decimal.quantize (0) numbers.Ceiling (value "-2.50001")))
  println (show (decimal.quantize (-1) numbers.Ceiling (value "25")))
  println (show (decimal.quantize (-1) numbers.Ceiling (value "-25")))
  println (show (decimal.quantize (-2) numbers.Ceiling (value "1350")))
  println (show (decimal.quantize (3) numbers.Ceiling (value "-0.0009")))
  println (show (decimal.quantize (2) numbers.Ceiling (value "9.999")))
  println (show (decimal.quantize (16) numbers.Ceiling (value "1.25")))
  println (exact () (value "1e100000000000000000000000") (value "1e100000000000000000000000"))
  println (rounded () (chosen 17 numbers.HalfEven) (value "1e-100000000000000000000000") (value "1e-100000000000000000000000"))
  println (show (decimal.quantize 9007199254740991 numbers.Ceiling (value "1.25")))
  println (report (Left decimal.DecimalDivisionByZero))
  println (report (Left decimal.NonTerminatingDecimal))
}
