import * as effects from "std/effect"
import * as refs from "std/ref"
import * as decimal from "std/decimal"
import * as numbers from "std/number"

effect fn ignore _error: ConsoleError -> Unit with Console = effects.succeed ()
effect fn say message: String -> Unit with Console = println message |> effects.recover ignore
fn render operation: (numbers.RoundingMode -> Either<decimal.DecimalContextError,decimal.DecimalContext>) -> String = match operation numbers.HalfEven {
  Right context -> show (decimal.precision context)
  Left _ -> "unexpected"
}
effect fn failBody -> Unit fails decimal.DecimalContextError = do {
  _value <- decimal.context 0 numbers.Ceiling |> effects.fromEither
  effects.succeed ()
}

pub effect fn main = do {
  released <- refs.make 0
  saved <- refs.make (decimal.context 34)
  let cold = effects.defer $ \_: Unit -> do {
    say "cold"
    operation <- refs.get saved
    say (render operation)
    effects.succeed ()
  }
  say "created"
  effects.scoped (do {
    effects.acquireRelease (say "acquired") (\_: Unit -> do {
      refs.update (\n -> n + 1) released
      say "released"
    })
    cold
    cold
    failBody ()
  }) |> effects.recover (\error: decimal.DecimalContextError -> match error { decimal.NonPositiveDecimalPrecision digits -> say ("recovered: " + show digits) })
  count <- refs.get released
  say ("released: " + show count)
}
