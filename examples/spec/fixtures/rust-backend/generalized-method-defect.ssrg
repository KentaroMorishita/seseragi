type Mark = | Mark Int

instance Eq<Mark> {
  fn eq left: Mark -> (Mark -> Bool) = {
    let bad = 9007199254740991 + 1
    \right -> True
  }
}

fn choose<A> left: A -> (A -> Bool) where Eq<A> = {
  let equal = eq
  let alias = equal
  alias left
}

pub effect fn main = do {
  println "before"
  let saved = choose (Mark 1)
  println "unreachable"
}
