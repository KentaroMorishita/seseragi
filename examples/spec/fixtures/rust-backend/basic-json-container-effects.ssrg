import * as effects from "std/effect"
import * as refs from "std/ref"
import * as json from "std/json"

alias Rows = { rows: Array<(Int, List<Maybe<json.Json>>)> }
effect fn ignore _error: ConsoleError -> Unit with Console = effects.succeed ()
effect fn say message: String -> Unit with Console = println message |> effects.recover ignore
fn reader<A> source: String -> Unit -> String where JsonDecode<A>, JsonEncode<A> = {
  let decode: String -> Either<json.JsonReadError, A> = json.decodeString
  let encode: A -> String = json.encodeString
  match decode source {
    Left _ -> \_: Unit -> "invalid"
    Right value -> \_: Unit -> encode value
  }
}
effect fn failBody -> Unit fails String = match json.decodeString<Array<Int>> "[1,1.5]" {
  Left (json.JsonDecodeFailure error) -> match error.kind {
    json.InvalidJsonValue _ -> effects.fail "typed"
    _ -> effects.die "unexpected domain error"
  }
  _ -> effects.die "expected domain failure"
}
pub effect fn main = do {
  released <- refs.make 0
  saved <- refs.make (\_: Unit -> effects.succeed "")
  let render = reader<Rows> "{\"rows\":[[1,[9007199254740992000000000001.100,null,{\"snow\":\"雪🙂\"}]],[2,[]]]}"
  let callback = \_: Unit -> do {
    _ <- refs.get saved
    effects.succeed (render ())
  }
  refs.set callback saved
  let cold = effects.defer $ \_: Unit -> do {
    say "cold"
    selected <- refs.get saved
    line <- selected ()
    say line
    effects.succeed ()
  }
  say "created"
  effects.scoped (do {
    effects.acquireRelease (say "acquired") (\_: Unit -> do {
      refs.update (\n -> n + 1) released
      say "released"
    })
    cold
    cold
    failBody ()
  }) |> effects.recover (\message: String -> say ("recovered: " + message))
  count <- refs.get released
  say ("released: " + show count)
}
