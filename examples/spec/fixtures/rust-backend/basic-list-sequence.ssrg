import * as s from "std/list"
import * as collection from "std/collection"
import * as text from "std/text"

fn maybe value: Maybe<Int> -> String = match value {
  Nothing -> "none"
  Just value -> show value
}
fn initial value: Maybe<List<Int>> -> String = match value {
  Nothing -> "none"
  Just values -> show values
}
fn sized value: Either<collection.SizeError, List<List<Int>>> -> String = match value {
  Left (collection.NonPositiveSize size) -> text.join "" ["size:", show size]
  Right values -> show values
}
fn paired<A,B> right: List<B> -> left: List<A> -> List<(A,B)> = s.zip right left
fn prefix<A> predicate: (A -> Bool) -> values: List<A> -> List<A> = s.takeWhile predicate values
fn step value: Int -> accumulated: String -> String =
  text.join "" [show value, "(", accumulated, ")"]

pub fn probe -> String = {
  let values = `[1, 2, 3]
  let empty: List<Int> = `[]
  let singleton = `[7]
  let find: (Int -> Bool) -> List<Int> -> Maybe<Int> = s.findIndex
  let two = find (\value: Int -> value == 2)
  let zip: (Int -> Int -> Int) -> List<Int> -> List<Int> -> List<Int> = s.zipWith
  let combine = zip (\a: Int -> \b: Int -> a * 10 + b)
  let withRight = combine `[4, 5]
  let take = s.takeWhile (\value: Int -> value < 3)
  let drop: (Int -> Bool) -> List<Int> -> List<Int> = s.dropWhile
  let last: List<Int> -> Maybe<Int> = s.last
  let init: List<Int> -> Maybe<List<Int>> = s.init
  let windows: Int -> List<Int> -> Either<collection.SizeError, List<List<Int>>> = s.windows
  let chunks = s.chunksOf<Int> 2
  let fold: String -> (Int -> String -> String) -> List<Int> -> String = s.reduceRight
  let foldStep = fold "z" step
  let badSize: Int -> collection.SizeError = collection.NonPositiveSize
  let captured = 40
  let callbacks: List<Int -> Int> = `[\value: Int -> value + captured]
  let callback = match s.last callbacks { Nothing -> -1; Just call -> call 2 }
  text.join "|" [
    maybe (two values), maybe (s.findIndex (\_: Int -> False) values),
    show (take values), show (drop (\value: Int -> value < 3) values),
    maybe (last values), initial (init values),
    show (paired `[True, False] values),
    show (withRight values),
    show (s.unzip (paired `[True, False] values)),
    sized (chunks values), sized (windows 2 values),
    foldStep values, foldStep empty,
    maybe (last empty), initial (init empty), initial (init singleton),
    sized (windows 4 values), sized (windows 0 values), sized (s.chunksOf (-2) values),
    sized (windows 9007199254740991 values), sized (s.chunksOf 9007199254740991 values),
    show (prefix (\_: String -> True) `["雪", "🙂"]),
    show (s.zip empty values), show callback,
    match badSize (-3) { collection.NonPositiveSize size -> show size },
    show values
  ]
}
pub effect fn main = println (probe ())
