// Program WASM passes BigInt and Decimal in the same shape as the TS target
// and computes them with the same results.
import { BigInt } from "std/big-int"
import * as bigints from "std/big-int"
import { Decimal } from "std/decimal"
import * as decimal from "std/decimal"

pub fn big text: String -> Maybe<BigInt> = match bigints.parse text {
  Left _ -> Nothing
  Right value -> Just value
}

pub fn grow value: BigInt -> BigInt = value * value * bigints.fromInt 3 - bigints.fromInt 1

pub fn render value: BigInt -> String = bigints.format value

pub fn smaller pair: (BigInt, BigInt) -> Bool = match pair {
  (left, right) -> left < right
}

pub fn quotient pair: (BigInt, BigInt) -> Maybe<BigInt> = match pair {
  (left, right) -> match bigints.checkedDivide left right {
    Left _ -> Nothing
    Right value -> Just value
  }
}

pub fn amount text: String -> Maybe<Decimal> = match decimal.parse text {
  Left _ -> Nothing
  Right value -> Just value
}

pub fn invoice pair: (Decimal, Decimal) -> Decimal = match pair {
  (price, tax) -> price * decimal.fromInt 3 + tax - price
}

pub fn shown value: Decimal -> String = show value

pub fn share pair: (Decimal, Decimal) -> Maybe<Decimal> = match pair {
  (total, parts) -> match decimal.divideExact total parts {
    Left _ -> Nothing
    Right value -> Just value
  }
}
