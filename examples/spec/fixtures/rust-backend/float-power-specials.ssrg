import * as floats from "std/float"

pub effect fn main = do {
  let nan = floats.nan ()
  let inf = floats.positiveInfinity ()
  println (floats.format ((1.0) ** (nan)))
  println (floats.format ((-1.0) ** (nan)))
  println (floats.format ((0.0) ** (nan)))
  println (floats.format ((nan) ** (0.0)))
  println (floats.format ((nan) ** (-0.0)))
  println (floats.format ((nan) ** (2.0)))
  println (floats.format ((inf) ** (3.0)))
  println (floats.format ((inf) ** (-3.0)))
  println (floats.format ((-inf) ** (3.0)))
  println (floats.format ((-inf) ** (2.0)))
  println (floats.format ((-inf) ** (-3.0)))
  println (floats.format ((-inf) ** (-2.0)))
  println (floats.format ((0.0) ** (2.0)))
  println (floats.format ((0.0) ** (-2.0)))
  println (floats.format ((-0.0) ** (3.0)))
  println (floats.format ((-0.0) ** (2.0)))
  println (floats.format ((-0.0) ** (-3.0)))
  println (floats.format ((-0.0) ** (-2.0)))
  println (floats.format ((1.0) ** (inf)))
  println (floats.format ((-1.0) ** (inf)))
  println (floats.format ((1.0) ** (-inf)))
  println (floats.format ((-1.0) ** (-inf)))
  println (floats.format ((2.0) ** (inf)))
  println (floats.format ((2.0) ** (-inf)))
  println (floats.format ((0.5) ** (inf)))
  println (floats.format ((0.5) ** (-inf)))
  println (floats.format ((-2.0) ** (0.5)))
  println (floats.format ((-2.0) ** (3.0)))
  println (floats.format ((-2.0) ** (-3.0)))
  println (floats.format ((4.0) ** (0.5)))
  println (floats.format ((4.0) ** (-0.5)))
  println (floats.format ((-0.0) ** (9007199254740991.0)))
  println (floats.format ((-0.0) ** (9007199254740992.0)))
  println (floats.format ((-inf) ** (-9007199254740991.0)))
  println (floats.format ((2.0) ** (1024.0)))
  println (floats.format ((-2.0) ** (1025.0)))
  println (floats.format ((2.0) ** (-1074.0)))
  println (floats.format ((-2.0) ** (-1075.0)))
  println (floats.format (1.5 ** 2.0))
  println (floats.format (floats.power 2.0 1.5))
}
