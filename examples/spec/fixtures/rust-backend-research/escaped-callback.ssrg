import * as effects from "std/effect"
import * as refs from "std/ref"

pub effect fn main = do {
  counter <- refs.make 40
  callback <- effects.scoped $ do {
    effects.acquireRelease (effects.succeed ()) (\_: Unit -> refs.set 42 counter)
    effects.succeed (\_: Unit -> refs.get counter)
  }
  value <- callback ()
  println $ `escaped: ${value}`
}
