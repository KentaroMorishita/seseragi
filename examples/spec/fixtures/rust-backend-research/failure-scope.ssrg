import * as effects from "std/effect"
import * as refs from "std/ref"

effect fn failing -> Unit fails String = effects.fail "expected"

pub effect fn main = do {
  released <- refs.make 0
  effects.recover (\_: String -> effects.succeed ()) $ effects.scoped $ do {
    effects.acquireRelease (effects.succeed ()) (\_: Unit -> refs.set 42 released)
    failing ()
  }
  value <- refs.get released
  println $ `failure released: ${value}`
}
