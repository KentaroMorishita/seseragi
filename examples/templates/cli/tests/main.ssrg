// `seseragi test` で実行するテストです。
import * as test from "std/test"
import { greeting } from "self/main"

let cases = [
  test.test "greets by name" (test.equal (Right "Hello, World!") (greeting "World")),
  test.test "rejects an empty name"
    (test.equal (Left "name must not be empty") (greeting ""))
]

pub let tests: test.Test = test.suite "greeting" cases
