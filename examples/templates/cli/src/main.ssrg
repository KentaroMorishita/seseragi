// コマンドライン引数で受け取った名前にあいさつする CLI ツールです。
// 引数がなければ World にあいさつします。空の名前は失敗として扱い、
// 終了コード 1 で終わります。
import * as effects from "std/effect"
import * as process from "std/process"

pub fn greeting name: String -> Either<String, String> =
  if name == "" then Left "name must not be empty" else Right `Hello, ${name}!`

pub effect fn main -> Unit with process: process.Process, Console fails String = do {
  args <- process.arguments () |> effects.mapError show
  let name = match args {
    [first, ...rest] -> first
    [] -> "World"
  }
  message <- effects.fromEither (greeting name)
  println message |> effects.mapError show
}
