{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seseragi.dev/schemas/tour-lesson.schema.json",
  "title": "Seseragi Tour lesson content",
  "oneOf": [
    { "$ref": "#/$defs/legacyLesson" },
    { "$ref": "#/$defs/structuredLesson" }
  ],
  "$defs": {
    "lessonId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "fileName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "inlineRichText": {
      "type": "string",
      "minLength": 1,
      "description": "Inline-only rich text: code, emphasis, strong and safe links. Block Markdown, images and raw HTML elements are not rendered."
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "endLine"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      }
    },
    "legacyLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "id", "challenge", "files"],
      "properties": {
        "$schema": { "type": "string" },
        "id": { "$ref": "#/$defs/lessonId" },
        "challenge": { "type": "string", "minLength": 1 },
        "interactive": { "type": "boolean" },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "guide"],
          "properties": {
            "source": { "$ref": "#/$defs/fileName" },
            "guide": { "$ref": "#/$defs/fileName" },
            "stdin": { "$ref": "#/$defs/fileName" },
            "expectedOutput": { "$ref": "#/$defs/fileName" },
            "exercise": { "$ref": "#/$defs/fileName" },
            "exerciseExpectedOutput": { "$ref": "#/$defs/fileName" },
            "diagnosticExample": { "$ref": "#/$defs/fileName" },
            "diagnosticOutput": { "$ref": "#/$defs/fileName" }
          }
        }
      }
    },
    "structuredLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "id", "formatVersion", "sections", "files"],
      "properties": {
        "$schema": { "type": "string" },
        "id": { "$ref": "#/$defs/lessonId" },
        "interactive": { "type": "boolean" },
        "formatVersion": { "const": 2 },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prerequisite",
            "walkthrough",
            "introduced",
            "exercise",
            "diagnostic",
            "recap",
            "next"
          ],
          "properties": {
            "prerequisite": { "$ref": "#/$defs/inlineRichText" },
            "walkthrough": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["heading", "body", "sourceRange"],
                "properties": {
                  "heading": { "type": "string", "minLength": 1 },
                  "body": { "$ref": "#/$defs/inlineRichText" },
                  "sourceRange": { "$ref": "#/$defs/sourceRange" }
                }
              }
            },
            "introduced": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "name", "body"],
                "properties": {
                  "kind": {
                    "enum": ["syntax", "type", "api"]
                  },
                  "name": { "type": "string", "minLength": 1 },
                  "body": { "$ref": "#/$defs/inlineRichText" }
                }
              }
            },
            "exercise": {
              "type": "object",
              "additionalProperties": false,
              "required": ["instruction", "reset"],
              "properties": {
                "instruction": { "$ref": "#/$defs/inlineRichText" },
                "reset": { "const": "restore-lesson-source" }
              }
            },
            "diagnostic": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading", "body"],
              "properties": {
                "heading": { "type": "string", "minLength": 1 },
                "body": { "$ref": "#/$defs/inlineRichText" }
              }
            },
            "recap": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/inlineRichText" }
            },
            "next": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lessonId", "body"],
              "properties": {
                "lessonId": {
                  "oneOf": [{ "$ref": "#/$defs/lessonId" }, { "type": "null" }]
                },
                "body": { "$ref": "#/$defs/inlineRichText" }
              }
            },
            "notes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/inlineRichText" }
            }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "exercise",
            "exerciseExpectedOutput",
            "diagnosticExample",
            "diagnosticOutput"
          ],
          "properties": {
            "source": { "$ref": "#/$defs/fileName" },
            "stdin": { "$ref": "#/$defs/fileName" },
            "expectedOutput": { "$ref": "#/$defs/fileName" },
            "exercise": { "$ref": "#/$defs/fileName" },
            "exerciseExpectedOutput": { "$ref": "#/$defs/fileName" },
            "diagnosticExample": { "$ref": "#/$defs/fileName" },
            "diagnosticOutput": { "$ref": "#/$defs/fileName" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["interactive"],
            "properties": {
              "interactive": { "const": true }
            }
          },
          "else": {
            "properties": {
              "files": {
                "required": ["expectedOutput"]
              }
            }
          }
        }
      ]
    }
  }
}
