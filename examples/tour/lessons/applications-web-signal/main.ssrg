import * as html from "std/web/html"
import * as signals from "std/signal"

type Action =
  | NoAction

fn planForm draft: String -> html.Html<Action> = html.form {
  children: [
    html.h1 { children: "Plan board" },
    html.input { id: "draft", inputType: "text", value: draft },
    html.button { buttonType: "submit", children: "Save" },
  ]
}

fn page draft: String -> html.Html<Action> = html.main { children: planForm draft }

pub effect fn main = do {
  state <- signals.make "First plan"
  let content = signals.map page state
  current <- signals.read content
  current |> html.renderToString |> println
}
