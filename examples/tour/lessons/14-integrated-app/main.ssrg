import * as dom from "std/web/dom"
import * as html from "std/web/html"

struct Counter {
  count: Int
}

type Action =
  | Increment

fn update action: Action -> state: Counter -> Counter =
  match action {
    Increment -> Counter { count: state.count + 1 }
  }

fn view state: Counter -> html.Html<Action> =
  html.main {
    className: "min-h-screen bg-emerald-50 p-8",
    children: html.button {
      id: "increment",
      onClick: Increment,
      className: "mx-auto block rounded-xl bg-emerald-600 px-6 py-4 text-xl font-bold text-white shadow-lg",
      children: `Count: ${state.count} — click to add 1`
    }
  }

// dom.appがstateのSignal、event dispatch、mountとcleanupを所有します。
pub effect fn main =
  dom.app {
    target: "#app",
    initial: Counter { count: 0 },
    update,
    view
  }
