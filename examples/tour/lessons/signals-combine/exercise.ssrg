import * as signals from "std/signal"
import { Signal } from "std/signal"

pub effect fn main = do {
  price <- signals.make 100
  count <- signals.make 2
  let doubled = signals.map (\n: Int -> n * 2) price
  let viaOp: Signal<Int> = (\n: Int -> n * 2) <$> price
  let total = signals.combine (\p: Int -> \c: Int -> p * c) price count
  initialDoubled <- *doubled
  initialOp <- *viaOp
  initialTotal <- *total
  println `doubled: ${initialDoubled}`
  println `<$>: ${initialOp}`
  println `initial total: ${initialTotal}`
  count := 5
  afterCount <- *total
  println `after update: ${afterCount}`
}
