import * as arrays from "std/array"

fn even value: Int -> Bool = value % 2 == 0
fn double value: Int -> Int = value * 2

fn summarize values: Array<Int> -> Int =
  values
  |> arrays.filter even
  |> map double
  |> reduce 10 (+)

let numbers = [1, 2, 3, 4]
let doubled = double <$> numbers
let total = summarize numbers

pub effect fn main = do {
  println $ `doubled: ${doubled}`
  println $ `pipeline total: ${total}`
}
