type Delivery =
  | Preparing
  | Shipped String
  | Delivered (String, Int)

fn message delivery: Delivery -> String = match delivery {
  Preparing -> "Preparing your order"
  Shipped city -> `Shipped to ${city}`
  Delivered (city, stops) -> `Delivered to ${city} in ${stops} stops`
}

pub effect fn main = do {
  println (message Preparing)
  println (message (Shipped "Osaka"))
  println (message (Delivered ("Kyoto", 2)))
}
