import * as either from "std/either"

struct ErrorInfo { message: String }

fn increment value: Int -> Int = value + 1
fn toErrorInfo text: String -> ErrorInfo = ErrorInfo { message: text }

fn render value: Either<ErrorInfo, Int> -> String = match value {
  Left info -> `error: ${info.message}`
  Right number -> `success: ${number}`
}

let success: Either<String, Int> = Right 41
let failure: Either<String, Int> = Left "invalid"

let named = map increment success
let viaOperator = increment <$> success
let preserved = increment <$> failure
let alignedSuccess = either.mapLeft toErrorInfo success
let alignedFailure = either.mapLeft toErrorInfo failure

pub effect fn main = do {
  println `map: ${named}`
  println `<$>: ${viaOperator}`
  println `left kept: ${preserved}`
  println (render alignedSuccess)
  println (render alignedFailure)
}
