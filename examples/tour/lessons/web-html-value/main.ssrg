import * as html from "std/web/html"

type Action =
  | NoAction

let accent = html.style { backgroundColor: "#ecfeff", color: "#155e75" }

let page: html.Html<Action> = html.main {
  id: "welcome",
  class: "rounded-xl p-4",
  style: accent,
  children: [
    html.h1 { children: "Seseragi Web" },
    html.p { title: "Greeting", children: "Pure HTML preview" },
  ]
}

pub effect fn main = html.renderToString page |> println
