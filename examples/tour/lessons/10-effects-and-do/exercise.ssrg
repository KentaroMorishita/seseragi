import { succeed } from "std/effect"

let source: Effect<{}, Never, Int> = succeed 15

let double: Int -> Effect<{}, Never, Int> = \value: Int -> succeed $ value * 2

let named: Effect<{}, Never, Int> = flatMap double source
let viaOperator: Effect<{}, Never, Int> = source >>= double
let block: Effect<{}, Never, Int> = do {
  value <- source
  let doubled = value * 2
  succeed doubled
}

pub effect fn main = do {
  namedValue <- named
  operatorValue <- viaOperator
  blockValue <- block
  println $ `flatMap: ${namedValue}`
  println $ `>>=: ${operatorValue}`
  println $ `do: ${blockValue}`
}
