fn greeting name: String -> String = `Hello, ${name}!`

fn wrap mark: String -> value: String -> String = `${mark}${value}${mark}`

fn addLabel label: String -> value: String -> String = `${label}: ${value}`

fn buildMessage name: String -> String =
  name
  |> greeting
  |> wrap "**"
  |> addLabel "Welcome"

pub effect fn main = println $ buildMessage "Seseragi"
