type Delivery deriving Show =
  | Preparing
  | Shipped String
  | Delivered (String, Int)

let pending: Delivery = Preparing
let transit: Delivery = Shipped "Kobe"
let completed: Delivery = Delivered ("Kyoto", 2)

pub effect fn main = do {
  println (show pending)
  println (show transit)
  println (show completed)
}
