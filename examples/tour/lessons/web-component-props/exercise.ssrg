import * as html from "std/web/html"

type Action =
  | NoAction

fn card title: String -> detail: String -> html.Html<Action> = html.article {
  children: [html.h2 { children: title }, html.p { children: detail }]
}

let page = html.main {
  children: [card "Components" "Reusable UI", card "Tour" "Step 29"]
}

pub effect fn main = html.renderToString page |> println
