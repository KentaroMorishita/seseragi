import * as signals from "std/signal"
import { Signal } from "std/signal"

fn pureSignal value: Int -> Signal<Int> = pure value

pub effect fn main = do {
  constantValue <- signals.read (signals.constant 40)
  pureValue <- signals.read (pureSignal 2)
  println `constant: ${constantValue}`
  println `pure: ${pureValue}`
}
