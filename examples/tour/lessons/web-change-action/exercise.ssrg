import * as html from "std/web/html"

type Action =
  | EnabledChanged Bool
  | IgnoredChange

fn enabledAction event: html.ChangeEvent -> Action = match event.checked {
  Just checked -> EnabledChanged checked
  Nothing -> IgnoredChange
}

let field: html.Html<Action> = html.input {
  name: "enabled",
  inputType: "checkbox",
  checked: True,
  onChange: enabledAction
}

pub effect fn main = html.renderToString field |> println
