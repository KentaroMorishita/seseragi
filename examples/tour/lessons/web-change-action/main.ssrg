import * as html from "std/web/html"

type Action =
  | CheckedChanged Bool
  | IgnoredChange

fn checkedAction event: html.ChangeEvent -> Action = match event.checked {
  Just checked -> CheckedChanged checked
  Nothing -> IgnoredChange
}

let field: html.Html<Action> = html.input {
  id: "pinned",
  inputType: "checkbox",
  checked: False,
  onChange: checkedAction
}

pub effect fn main = html.renderToString field |> println
