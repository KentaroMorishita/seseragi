type Badge =
  | Active

type Device =
  | Online

trait Label<A> {
  fn label value: A -> String
}

instance Label<Badge> {
  fn label value: Badge -> String = "badge-ready"
}

instance Label<Device> {
  fn label value: Device -> String = "device-ready"
}

fn describe<A> value: A -> String where Label<A> = label value

pub effect fn main = do {
  describe Active |> println
  describe Online |> println
}
