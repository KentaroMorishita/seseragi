import * as arrays from "std/array"

struct Sale {
  item: String,
  amount: Int
}

let sales: Array<Sale> = [
  Sale { item: "Book", amount: 2400 },
  Sale { item: "Pen", amount: 600 },
  Sale { item: "Cancelled", amount: 0 }
  ]

fn large sale: Sale -> Bool = sale.amount >= 1000
fn render sale: Sale -> String = `${sale.item}: ${sale.amount}`

pub effect fn main =
  sales |> arrays.filter large |> map render |> join "\n" |> println
