import * as arrays from "std/array"

struct Sale {
  item: String,
  amount: Int
}

let sales: Array<Sale> = [
  Sale { item: "Book", amount: 2400 },
  Sale { item: "Pen", amount: 600 },
  Sale { item: "Cancelled", amount: 0 }
  ]

fn completed sale: Sale -> Bool = sale.amount > 0
fn render sale: Sale -> String = `${sale.item}: ${sale.amount}`

pub effect fn main =
  sales
  |> arrays.filter completed
  |> map render
  |> join "\n"
  |> println
