operator infixr 4 <+> left: String -> right: String -> String = append left right

fn applyJoin operation: (String -> String -> String)
  -> left: String
  -> right: String
  -> String =
  operation left right

pub effect fn main =
  do {
    "Sese" <+> "ragi" |> println
    applyJoin (<+>) "Tour" "!" |> println
  }
