type Box<A> =
  | Empty
  | Box A

type Pair<A, B> =
  | Pair (A, B)

fn unwrapOr<A> fallback: A -> box: Box<A> -> A = match box {
  Empty -> fallback
  Box value -> value
}

fn swap<A, B> pair: Pair<A, B> -> Pair<B, A> = match pair {
  Pair (first, second) -> Pair (second, first)
}

pub effect fn main = do {
  let label = unwrapOr "none" (Box "Seseragi")
  let number = unwrapOr 0 Empty
  let Pair (count, tag) = swap (Pair ("Tour", 22))
  println `${label}: ${number}`
  println `${count} / ${tag}`
}
