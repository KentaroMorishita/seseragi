import * as signals from "std/signal"

fn add left: Int -> right: Int -> Int = left + right

// transactionは途中状態を公開せず、更新をまとめてcommitします。
pub effect fn main =
  do {
    tasks <- signals.make 2
    points <- signals.make 10
    let taskValues = signals.map (\value: Int -> value) tasks
    let doubledTasks = (\value: Int -> value * 2) <$> taskValues
    let addTwo = signals.constant (\value: Int -> value + 2)
    let adjustedTasks = addTwo <*> doubledTasks
    let total = signals.combine add adjustedTasks points
    let setTasks = signals.planSet 12
    let updatePoints = signals.planUpdate (\value: Int -> value + 30)

    signals.transaction [setTasks tasks, updatePoints points]

    current <- *total
    println `Dashboard total: ${current}`
  }
