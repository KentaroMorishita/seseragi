import * as signals from "std/signal"
import { Signal } from "std/signal"

pub effect fn main = do {
  state <- signals.make 42
  let view: Signal<Int> = state
  named <- signals.read view
  operator <- *view
  mutableOperator <- *state
  println `signals.read Signal: ${named}`
  println `*Signal: ${operator}`
  println `*MutableSignal: ${mutableOperator}`
}
