fn triple value: Int -> Int = value * 3
let arrayNamed = map triple [1, 2, 3]
let arrayOperator = triple <$> [1, 2, 3]
let listNamed: List<Int> = map triple `[1, 2, 3]
let listOperator: List<Int> = triple <$> `[1, 2, 3]

pub effect fn main =
  do {
    println $ `Array: ${arrayNamed} / ${arrayOperator}`
    println $ `List: ${listNamed} / ${listOperator}`
  }
