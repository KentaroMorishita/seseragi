import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"

fn add left: Int -> right: Int -> Int = left + right

fn appendTrace prev: String -> value: Int -> String =
  if prev == "" then `${value}` else `${prev} -> ${value}`

fn applyBatch left: MutableSignal<Int> -> right: MutableSignal<Int> -> Task<Unit> =
  signals.transaction [
    signals.planSet 30 left,
    signals.planSet 15 right,
  ]

pub effect fn main = do {
  left <- signals.make 1
  right <- signals.make 2
  mirror <- signals.make 0
  trace <- signals.make ""
  let total: Signal<Int> = add <$> left <*> right
  subscription <- signals.subscribe (\value: Int -> do {
      signals.set value mirror
      signals.update (\prev: String -> appendTrace prev value) trace
  }) total
  applyBatch left right
  signals.unsubscribe subscription
  current <- *mirror
  observed <- *trace
  println `total: ${current}`
  println `observed: ${observed}`
}
