fn keep<A> value: A -> A = value

struct Score {
  value: Int
}

impl Score {
  operator + self -> bonus: Int -> Score =
  Score { value: self.value + bonus }
}

trait Label<A> {
  fn label value: A -> String
}

instance Label<Score> {
  fn label score: Score -> String = `Score: ${score.value}`
}

// 同じ値がgeneric関数と二つの型契約を通ります。
pub effect fn main = keep (Score { value: 40 } + 2) |> label |> println
