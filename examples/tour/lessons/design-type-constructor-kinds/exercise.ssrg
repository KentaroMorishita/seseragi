fn keepValue<A> value: A -> A = value

fn keepShape<F<_>, A> value: F<A> -> F<A> = value

fn prefix tag: String -> text: String -> String = `${tag}: ${text}`

fn inspectShape<F<_>, A> tag: String -> value: F<A> -> String where Show<F<A>> =
  value
  |> keepShape
  |> show
  |> prefix tag

pub effect fn main = do {
  let keptInt = keepValue 42
  println $ `Int: ${keptInt}`
  inspectShape "Maybe" (Just 7) |> println
  inspectShape "Array" [7, 8] |> println
}
