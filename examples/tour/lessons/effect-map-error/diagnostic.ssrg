pub type ParseError deriving Show =
  | InvalidNumber String

pub type StockError deriving Show =
  | OutOfStock String

effect fn parseCount raw: String -> Int fails ParseError =
  if raw == "2" then succeed 2 else fail (InvalidNumber raw)

effect fn checkStock item: String -> String fails StockError =
  if item == "tea" then succeed "tea" else fail (OutOfStock item)

effect fn prepareOrder raw: String item: String = do {
  count <- parseCount raw
  checked <- checkStock item
  succeed `${checked} x${count}`
}

pub effect fn main = println "mapError"
