import * as html from "std/web/html"

type Action =
  | NameChanged String

fn nameAction event: html.InputEvent -> Action = NameChanged event.value

let field: html.Html<Action> = html.input {
  name: "name",
  inputType: "text",
  value: "Ada",
  onInput: nameAction
}

pub effect fn main = html.renderToString field |> println
