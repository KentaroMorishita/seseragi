import * as html from "std/web/html"

type Action =
  | DraftChanged String

fn draftAction event: html.InputEvent -> Action = DraftChanged event.value

let form: html.Html<Action> = html.form {
  children: [
    html.label { htmlFor: "task", children: "Task title" },
    html.input { id: "task", inputType: "text", onInput: draftAction },
    html.p { role: "status", children: "Ready to edit" },
  ]
}

pub effect fn main = form |> html.renderToString |> println
