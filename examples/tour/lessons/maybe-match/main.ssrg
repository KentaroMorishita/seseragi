fn formatUser value: Maybe<String> -> String = match value {
  Nothing -> "user: none"
  Just name -> `user: ${name}`
}

let primary: Maybe<String> = Just "Mio"
let secondary: Maybe<String> = Nothing
let mainName = primary ?? "Guest"
let backupName = secondary ?? "Guest"

pub effect fn main = do {
  println (formatUser primary)
  println (formatUser secondary)
  println `active: ${mainName} / backup: ${backupName}`
}
