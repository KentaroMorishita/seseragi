fn formatNote note: Maybe<String> -> String = match note {
  Nothing -> "note: none"
  Just text -> `note: ${text}`
}

fn formatOrder result: Either<String, Int> -> String = match result {
  Left reason -> `error: ${reason}`
  Right count -> `order: ${count} items`
}

let note: Maybe<String> = Nothing
let validOrder: Either<String, Int> = Left "out of stock"
let failedOrder: Either<String, Int> = Left "count must be positive"

pub effect fn main = do {
  println (formatNote note)
  println (formatOrder validOrder)
  println (formatOrder failedOrder)
}
