import * as arrays from "std/array"

let scores: Array<Int> = [10, 20, 30, 40]
let numbers: Range<Int> = 1 ..= 5

pub effect fn main = do {
  println $ `scores: ${scores} (length ${arrays.length scores})`
  println $ `get 1: ${arrays.get 1 scores}`
  println $ `get 3: ${arrays.get 3 scores}`
  println $ `range: ${numbers} (sum ${sum numbers})`
}
