import * as arrays from "std/array"

fn even value: Int -> Bool = value % 2 == 0

fn double value: Int -> Int = value * 2

// filterとmapは入力を変えず、新しいcollectionを返します。
let arrayValues = arrays.filter even [1, 2, 3, 4, 5, 6]
let listValues = map double `[1, 2, 3]
let rangeValues = [value | value <- 1..=4]

pub effect fn main =
  println `Array: ${arrayValues} / List: ${listValues} / Range: ${rangeValues}`
