struct Customer { name: String, plan: String }

struct Staff { name: String, plan: String }

fn formatCustomer customer: Customer -> String = `${customer.name}: ${customer.plan}`

let customer = Customer { name: "Mio", plan: "Pro" }
let staff = Staff { name: "Aoi", plan: "Support" }

pub effect fn main = do {
  println `Customer -> ${formatCustomer customer}`
  println `Staff -> ${staff.name}: ${staff.plan}`
}
