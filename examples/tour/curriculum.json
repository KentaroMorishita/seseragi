{
  "$schema": "./curriculum.schema.json",
  "schema": 1,
  "title": "A Tour of Seseragi",
  "chapters": [
    {
      "id": "foundations",
      "title": "Programと関数",
      "summary": "実行入口から値、関数、値の受け渡しまでを積み上げます。"
    },
    {
      "id": "data",
      "title": "データと失敗",
      "summary": "データを組み立て、分解し、値がない場合と失敗を表現します。"
    },
    {
      "id": "applications",
      "title": "Effectとアプリケーション",
      "summary": "Effect、抽象化、時間変化する値、Web UIを一つのアプリへ接続します。"
    }
  ],
  "lessons": [
    {
      "id": "01-hello-world",
      "order": 1,
      "chapter": "foundations",
      "title": "最小のmainと文字列出力",
      "focus": ["program entry", "text output"],
      "introduces": ["main", "effect-fn", "string-literal", "println"],
      "prerequisites": [],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 121,
      "seedSamples": ["hello-world"]
    },
    {
      "id": "02-values-and-bindings",
      "order": 2,
      "chapter": "foundations",
      "title": "値・binding・型注釈",
      "focus": ["immutable binding", "type annotation"],
      "introduces": ["let", "type-annotation", "int", "string-template"],
      "prerequisites": ["01-hello-world"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 121,
      "seedSamples": ["strings-and-templates"]
    },
    {
      "id": "03-function-definitions",
      "order": 3,
      "chapter": "foundations",
      "title": "関数を定義する",
      "focus": ["function definition", "return type"],
      "introduces": ["fn", "parameter", "return-type", "pure-function"],
      "prerequisites": ["02-values-and-bindings"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 121,
      "seedSamples": ["functions-and-pipelines"]
    },
    {
      "id": "04-function-calls",
      "order": 4,
      "chapter": "foundations",
      "title": "関数を呼び出す",
      "focus": ["function application", "curried arguments"],
      "introduces": ["application", "currying", "partial-application"],
      "prerequisites": ["03-function-definitions"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 121,
      "seedSamples": ["functions-and-pipelines"]
    },
    {
      "id": "05-pipelines",
      "order": 5,
      "chapter": "foundations",
      "title": "$と|>で値を渡す",
      "focus": ["low precedence application", "pipeline"],
      "introduces": ["dollar-application", "pipeline"],
      "prerequisites": ["04-function-calls"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 121,
      "seedSamples": ["functions-and-pipelines"]
    },
    {
      "id": "06-records-and-structs",
      "order": 6,
      "chapter": "data",
      "title": "RecordとStructを組み立てる",
      "focus": ["named fields", "immutable update"],
      "introduces": ["record", "struct", "field-access", "record-spread"],
      "prerequisites": ["05-pipelines"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 122,
      "seedSamples": ["records", "generic-structs"]
    },
    {
      "id": "07-adts-and-patterns",
      "order": 7,
      "chapter": "data",
      "title": "データ型をPattern matchする",
      "focus": ["algebraic data type", "pattern matching"],
      "introduces": ["adt", "constructor", "match", "pattern-binding"],
      "prerequisites": ["06-records-and-structs"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 122,
      "seedSamples": ["data-and-patterns"]
    },
    {
      "id": "08-collections-and-ranges",
      "order": 8,
      "chapter": "data",
      "title": "Collectionを変換する",
      "focus": ["finite collections", "collection transformation"],
      "introduces": ["array", "list", "range", "map", "filter"],
      "prerequisites": ["07-adts-and-patterns"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 122,
      "seedSamples": ["collections", "collection-patterns"]
    },
    {
      "id": "09-maybe-and-either",
      "order": 9,
      "chapter": "data",
      "title": "値がない場合と失敗を表す",
      "focus": ["optional value", "typed failure value"],
      "introduces": ["maybe", "either", "left", "right"],
      "prerequisites": ["08-collections-and-ranges"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 122,
      "seedSamples": ["stdin-greeting", "either-and-monad"]
    },
    {
      "id": "10-effects-and-do",
      "order": 10,
      "chapter": "applications",
      "title": "Effectをdoで合成する",
      "focus": ["deferred effect", "sequential composition"],
      "introduces": ["effect", "do", "bind", "with", "fails"],
      "prerequisites": ["09-maybe-and-either"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 123,
      "seedSamples": ["effects-and-do", "stdin-greeting"]
    },
    {
      "id": "11-generics-and-traits",
      "order": 11,
      "chapter": "applications",
      "title": "Genericな契約をTraitで表す",
      "focus": ["parametric abstraction", "type class evidence"],
      "introduces": ["generic", "trait", "instance", "impl", "operator"],
      "prerequisites": ["10-effects-and-do"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 123,
      "seedSamples": [
        "generic-structs",
        "traits-and-instances",
        "impl-and-operators"
      ]
    },
    {
      "id": "12-signals-and-state",
      "order": 12,
      "chapter": "applications",
      "title": "Signalで時間変化する状態を扱う",
      "focus": ["time-varying value", "atomic state update"],
      "introduces": [
        "signal",
        "mutable-signal",
        "applicative-signal",
        "transaction"
      ],
      "prerequisites": ["11-generics-and-traits"],
      "capabilities": ["console"],
      "outputMode": "text",
      "deliveryIssue": 123,
      "seedSamples": ["signal-composition", "signal-state"]
    },
    {
      "id": "13-components-and-web-ui",
      "order": 13,
      "chapter": "applications",
      "title": "Function componentでWeb UIを作る",
      "focus": ["pure Html value", "function component"],
      "introduces": ["html", "function-component", "style", "html-preview"],
      "prerequisites": ["12-signals-and-state"],
      "capabilities": ["console"],
      "outputMode": "html",
      "deliveryIssue": 123,
      "seedSamples": ["html-components"]
    },
    {
      "id": "14-integrated-app",
      "order": 14,
      "chapter": "applications",
      "title": "Typed Actionで小さなアプリを動かす",
      "focus": ["pure reducer", "effectful action"],
      "introduces": ["typed-action", "pure-reducer", "dom-app", "task-action"],
      "prerequisites": ["13-components-and-web-ui"],
      "capabilities": ["dom"],
      "outputMode": "html",
      "deliveryIssue": 123,
      "seedSamples": ["interactive-app"]
    }
  ],
