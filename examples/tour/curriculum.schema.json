{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seseragi.dev/schemas/tour-curriculum.schema.json",
  "title": "Seseragi Tour curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "title",
    "requiredTopics",
    "categories",
    "sampleAudit",
    "currentPathDuplicates",
    "excludedDesignSurfaces"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 2 },
    "title": { "type": "string", "minLength": 1 },
    "requiredTopics": { "$ref": "#/$defs/nonEmptyStrings" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    },
    "sampleAudit": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sampleAudit" }
    },
    "currentPathDuplicates": {
      "type": "array",
      "items": { "$ref": "#/$defs/currentPathDuplicate" }
    },
    "excludedDesignSurfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/excludedSurface" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "summary", "chapters"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/chapter" }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "summary", "lessons"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lesson" }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "summary",
        "goal",
        "focus",
        "introducedSurfaces",
        "requiredSurfaces",
        "prerequisites",
        "capabilities",
        "outputMode",
        "content",
        "deliveryIssue",
        "seedSamples"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "focus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "introducedSurfaces": { "$ref": "#/$defs/nonEmptyStrings" },
        "requiredSurfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["console", "stdin", "dom"] }
        },
        "outputMode": { "enum": ["text", "html"] },
        "content": {
          "type": "string",
          "pattern": "^lessons/[a-z0-9]+(?:-[a-z0-9]+)*/lesson\\.json$"
        },
        "deliveryIssue": { "type": "integer", "minimum": 1 },
        "seedSamples": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "sampleAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleId",
        "currentKind",
        "decision",
        "tourLessons",
        "reason"
      ],
      "properties": {
        "sampleId": { "$ref": "#/$defs/slug" },
        "currentKind": { "enum": ["lesson", "recipe", "showcase"] },
        "decision": {
          "enum": [
            "tour-seed-only",
            "tour-seed-and-recipe",
            "tour-seed-and-showcase",
            "discover-recipe",
            "discover-showcase"
          ]
        },
        "tourLessons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "currentPathDuplicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleId", "paths"],
      "properties": {
        "sampleId": { "$ref": "#/$defs/slug" },
        "paths": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        }
      }
    },
    "excludedSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "designLessons",
        "forbiddenTopics",
        "forbiddenImports",
        "reason"
      ],
      "properties": {
        "surface": { "$ref": "#/$defs/slug" },
        "designLessons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "forbiddenTopics": { "$ref": "#/$defs/nonEmptyStrings" },
        "forbiddenImports": { "$ref": "#/$defs/nonEmptyStrings" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
