pub fn stepPillStyle active: Bool -> completed: Bool -> html.Style =
  if active then
    html.style {
      backgroundColor: "#d8b36a",
      color: "#121318",
      borderRadius: "999px",
      fontSize: "12px",
      fontWeight: "700",
      padding: "6px 12px"
    }
  else if completed then
    html.style {
      backgroundColor: "rgba(216, 179, 106, 0.16)",
      color: "#ebd29d",
      border: "1px solid rgba(216, 179, 106, 0.35)",
      borderRadius: "999px",
      fontSize: "12px",
      fontWeight: "600",
      padding: "5px 12px"
    }
  else
    html.style {
      backgroundColor: "rgba(255, 255, 255, 0.04)",
      color: "#8e8a82",
      border: "1px solid rgba(255, 255, 255, 0.09)",
      borderRadius: "999px",
      fontSize: "12px",
      fontWeight: "500",
      padding: "5px 12px"
    }

