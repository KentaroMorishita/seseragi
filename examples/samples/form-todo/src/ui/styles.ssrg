import * as html from "std/web/html"
import { Build, Rest, Share, Track } from "../plans/model"

// 色はここだけに書く。画面の区切りは、名前を付けた Style を呼ぶだけにする。

pub fn trackColor track: Track -> String = match track {
  Build -> "#2f5bea"
  Share -> "#d4513b"
  Rest -> "#3f8f6b"
}

pub fn trackSoft track: Track -> String = match track {
  Build -> "#e7edff"
  Share -> "#fde9e5"
  Rest -> "#e3f2ea"
}

pub fn pageStyle -> html.Style = html.style {
  background: "#eef1f5",
  color: "#14213d",
  fontFamily: "system-ui, -apple-system, \"Hiragino Sans\", \"Noto Sans JP\", sans-serif",
  minHeight: "100vh",
  padding: "28px 18px 56px"
}

pub fn shellStyle -> html.Style = html.style {
  display: "grid",
  gap: "20px",
  margin: "0 auto",
  maxWidth: "1040px"
}

// ── 見出しの帯 ───────────────────────────────────

pub fn headerStyle -> html.Style = html.style {
  background: "#14213d",
  borderRadius: "24px",
  color: "#f4f6fb",
  display: "grid",
  gap: "20px",
  padding: "28px clamp(20px, 4vw, 40px)"
}

pub fn eyebrowStyle -> html.Style = html.style {
  color: "#9fb4ff",
  fontSize: "12px",
  fontWeight: "700",
  letterSpacing: "0.16em",
  margin: "0"
}

pub fn displayStyle -> html.Style = html.style {
  fontSize: "clamp(28px, 5vw, 44px)",
  fontWeight: "800",
  letterSpacing: "-0.02em",
  lineHeight: "1.15",
  margin: "8px 0 0"
}

pub fn phraseStyle -> html.Style = html.style { display: "inline-block" }

pub fn leadStyle -> html.Style = html.style {
  color: "#c9d3ee",
  fontSize: "16px",
  lineHeight: "1.8",
  margin: "12px 0 0",
  maxWidth: "36em"
}

pub fn headerLinkStyle -> html.Style = html.style {
  color: "#9fb4ff",
  fontSize: "14px",
  fontWeight: "600"
}

pub fn metricsStyle -> html.Style = html.style {
  display: "grid",
  gap: "10px",
  gridTemplateColumns: "repeat(3, minmax(0, 1fr))"
}

pub fn metricStyle -> html.Style = html.style {
  background: "#1d2c52",
  borderRadius: "16px",
  padding: "12px 14px"
}

pub fn metricValueStyle -> html.Style = html.style {
  fontSize: "28px",
  fontVariantNumeric: "tabular-nums",
  fontWeight: "800",
  margin: "0"
}

pub fn metricLabelStyle -> html.Style = html.style {
  color: "#9fb4ff",
  fontSize: "12px",
  margin: "2px 0 0"
}

// ── 作業の面（フォームとボード） ─────────────────────────

pub fn workspaceStyle -> html.Style = html.style {
  alignItems: "start",
  display: "grid",
  gap: "20px",
  gridTemplateColumns: "repeat(auto-fit, minmax(300px, 1fr))"
}

pub fn panelStyle -> html.Style = html.style {
  background: "#ffffff",
  border: "1px solid #dde3ee",
  borderRadius: "22px",
  display: "grid",
  gap: "16px",
  padding: "22px"
}

pub fn panelHeadingStyle -> html.Style = html.style {
  fontSize: "20px",
  fontWeight: "800",
  margin: "0"
}

pub fn panelCopyStyle -> html.Style = html.style {
  color: "#5a6680",
  fontSize: "14px",
  lineHeight: "1.7",
  margin: "4px 0 0"
}

pub fn fieldStyle -> html.Style = html.style { display: "grid", gap: "6px" }

pub fn labelStyle -> html.Style = html.style {
  color: "#33405e",
  fontSize: "13px",
  fontWeight: "700"
}

pub fn inputStyle -> html.Style = html.style {
  background: "#f7f9fc",
  border: "1px solid #cfd7e6",
  borderRadius: "12px",
  color: "#14213d",
  font: "inherit",
  fontSize: "16px",
  padding: "10px 12px"
}

pub fn textareaStyle -> html.Style = html.style {
  background: "#f7f9fc",
  border: "1px solid #cfd7e6",
  borderRadius: "12px",
  color: "#14213d",
  font: "inherit",
  fontSize: "16px",
  minHeight: "84px",
  padding: "10px 12px",
  resize: "vertical"
}

pub fn choiceRowStyle -> html.Style = html.style {
  display: "flex",
  flexWrap: "wrap",
  gap: "8px"
}

pub fn choiceStyle track: Track -> selected: Bool -> html.Style = match selected {
  True -> html.style {
    background: trackColor track,
    border: `1px solid ${trackColor track}`,
    borderRadius: "999px",
    color: "#ffffff",
    cursor: "pointer",
    font: "inherit",
    fontSize: "14px",
    fontWeight: "700",
    padding: "8px 14px"
  }
  False -> html.style {
    background: "#ffffff",
    border: "1px solid #cfd7e6",
    borderRadius: "999px",
    color: "#33405e",
    cursor: "pointer",
    font: "inherit",
    fontSize: "14px",
    fontWeight: "600",
    padding: "8px 14px"
  }
}

pub fn checkboxRowStyle -> html.Style = html.style {
  alignItems: "center",
  display: "flex",
  fontSize: "14px",
  gap: "8px"
}

pub fn primaryButtonStyle -> html.Style = html.style {
  background: "#14213d",
  border: "0",
  borderRadius: "999px",
  color: "#ffffff",
  cursor: "pointer",
  font: "inherit",
  fontWeight: "700",
  justifySelf: "start",
  padding: "12px 22px"
}

pub fn validationStyle -> html.Style = html.style {
  background: "#fdecea",
  borderLeft: "4px solid #c0392b",
  borderRadius: "10px",
  color: "#8e2a1f",
  fontSize: "14px",
  margin: "0",
  padding: "10px 12px"
}

// ── ボード ────────────────────────────────────────

pub fn filterBarStyle -> html.Style = html.style {
  background: "#eef1f5",
  borderRadius: "999px",
  display: "flex",
  flexWrap: "wrap",
  gap: "4px",
  padding: "4px"
}

pub fn filterStyle selected: Bool -> html.Style = match selected {
  True -> html.style {
    background: "#ffffff",
    border: "0",
    borderRadius: "999px",
    boxShadow: "0 1px 2px #14213d26",
    color: "#14213d",
    cursor: "pointer",
    font: "inherit",
    fontSize: "13px",
    fontWeight: "700",
    padding: "7px 12px"
  }
  False -> html.style {
    background: "transparent",
    border: "0",
    borderRadius: "999px",
    color: "#5a6680",
    cursor: "pointer",
    font: "inherit",
    fontSize: "13px",
    fontWeight: "600",
    padding: "7px 12px"
  }
}

pub fn progressTrackStyle -> html.Style = html.style {
  background: "#e3e8f1",
  borderRadius: "999px",
  height: "8px",
  overflow: "hidden"
}

pub fn progressBarStyle percent: Int -> html.Style = html.style {
  background: "#3f8f6b",
  borderRadius: "999px",
  height: "100%",
  transition: "width 240ms ease",
  width: `${percent}%`
}

pub fn summaryStyle -> html.Style = html.style {
  color: "#5a6680",
  fontSize: "13px",
  margin: "0"
}

pub fn listStyle -> html.Style = html.style {
  display: "grid",
  gap: "12px",
  listStyle: "none",
  margin: "0",
  padding: "0"
}

pub fn cardStyle track: Track -> complete: Bool -> html.Style = html.style {
  background:
    if complete then
      "#f7f9fc"
    else
      "#ffffff",
  border: "1px solid #dde3ee",
  borderLeft: `5px solid ${trackColor track}`,
  borderRadius: "16px",
  display: "grid",
  gap: "10px",
  opacity:
    if complete then
      "0.78"
    else
      "1",
  padding: "14px 16px"
}

pub fn cardTopStyle -> html.Style = html.style {
  alignItems: "center",
  display: "flex",
  flexWrap: "wrap",
  gap: "6px",
  justifyContent: "space-between"
}

pub fn badgeStyle track: Track -> html.Style = html.style {
  background: trackSoft track,
  borderRadius: "999px",
  color: trackColor track,
  fontSize: "12px",
  fontWeight: "700",
  padding: "3px 10px"
}

pub fn pinBadgeStyle -> html.Style = html.style {
  background: "#fff4d6",
  borderRadius: "999px",
  color: "#8a5a00",
  fontSize: "12px",
  fontWeight: "700",
  padding: "3px 10px"
}

pub fn titleInputStyle complete: Bool -> html.Style = html.style {
  background: "transparent",
  border: "1px solid transparent",
  borderRadius: "8px",
  color: "#14213d",
  font: "inherit",
  fontSize: "17px",
  fontWeight: "700",
  padding: "4px 6px",
  textDecoration:
    if complete then
      "line-through"
    else
      "none",
  width: "100%"
}

pub fn detailsStyle -> html.Style = html.style {
  color: "#5a6680",
  fontSize: "14px",
  lineHeight: "1.7",
  margin: "0"
}

pub fn cardActionsStyle -> html.Style = html.style {
  display: "flex",
  flexWrap: "wrap",
  gap: "8px"
}

pub fn ghostButtonStyle -> html.Style = html.style {
  background: "#ffffff",
  border: "1px solid #cfd7e6",
  borderRadius: "999px",
  color: "#33405e",
  cursor: "pointer",
  font: "inherit",
  fontSize: "13px",
  fontWeight: "600",
  padding: "6px 12px"
}

pub fn quietButtonStyle -> html.Style = html.style {
  background: "transparent",
  border: "0",
  color: "#8a94a8",
  cursor: "pointer",
  font: "inherit",
  fontSize: "13px",
  padding: "6px 4px"
}

pub fn emptyStyle -> html.Style = html.style {
  border: "1px dashed #cfd7e6",
  borderRadius: "16px",
  padding: "24px",
  textAlign: "center"
}

pub fn emptyHeadingStyle -> html.Style = html.style {
  fontSize: "17px",
  fontWeight: "800",
  margin: "0"
}

pub fn statusStyle -> html.Style = html.style {
  color: "#5a6680",
  fontSize: "13px",
  margin: "0"
}
