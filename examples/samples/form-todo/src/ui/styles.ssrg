pub fn seatButtonStyle tier: SeatTier -> availability: SeatAvailability
  -> selected: Bool -> dimmed: Bool -> html.Style =
  if availability == Sold then
    html.style {
      backgroundColor: "#222531",
      border: "1px solid #2e3240",
      borderRadius: "8px 8px 4px 4px",
      color: "#98a0b6",
      cursor: "not-allowed",
      fontSize: "12px",
      fontWeight: "600",
      height: "34px",
      minWidth: "24px",
      flex: "1 1 24px",
      maxWidth: "44px",
      padding: "0",
      opacity:
        if dimmed then
          "0.3"
        else
          "1"
    }
  else if selected then
    html.style {
      backgroundColor: "#d8b36a",
      border: "2px solid #fff3d6",
      borderRadius: "8px 8px 4px 4px",
      boxShadow: "0 0 0 2px rgba(216, 179, 106, 0.35)",
      color: "#111217",
      cursor: "pointer",
      fontSize: "12px",
      fontWeight: "800",
      height: "34px",
      minWidth: "24px",
      flex: "1 1 24px",
      maxWidth: "44px",
      padding: "0"
    }
  else
    {
      let accentBorder = match tier {
        TierS -> "1px solid rgba(216, 179, 106, 0.72)"
        TierA -> "1px solid rgba(104, 159, 204, 0.72)"
        TierB -> "1px solid rgba(114, 171, 130, 0.72)"
        TierAccessible -> "1px solid rgba(169, 143, 214, 0.8)"
      }
      let tint = match tier {
        TierS -> "rgba(216, 179, 106, 0.12)"
        TierA -> "rgba(104, 159, 204, 0.12)"
        TierB -> "rgba(114, 171, 130, 0.12)"
        TierAccessible -> "rgba(169, 143, 214, 0.16)"
      }
      html.style {
        backgroundColor: tint,
        border: accentBorder,
        borderRadius: "8px 8px 4px 4px",
        color: "#f2efe8",
        cursor: "pointer",
        fontSize: "12px",
        fontWeight: "600",
        height: "34px",
        minWidth: "24px",
        flex: "1 1 24px",
        maxWidth: "44px",
        padding: "0",
        opacity:
          if dimmed then
            "0.28"
          else
            "1"
      }
    }

