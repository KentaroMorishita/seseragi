pub fn primaryButtonStyle disabled: Bool -> html.Style =
  if disabled then
    html.style {
      backgroundColor: "#2d303c",
      border: "none",
      borderRadius: "10px",
      color: "#777b88",
      cursor: "not-allowed",
      fontSize: "14px",
      fontWeight: "700",
      padding: "13px 18px",
      width: "100%"
    }
  else
    html.style {
      backgroundColor: "#d8b36a",
      border: "none",
      borderRadius: "10px",
      color: "#111217",
      cursor: "pointer",
      fontSize: "14px",
      fontWeight: "700",
      padding: "13px 18px",
      width: "100%"
    }

