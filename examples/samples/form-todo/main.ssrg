import * as arrays from "std/array"
import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"

struct Plan {
  id: Int,
  title: String,
  details: String,
  track: Track,
  pinned: Bool,
  complete: Bool
}

type Track deriving Eq, Show =
  | Build
  | Share
  | Rest

type ViewFilter deriving Eq, Show =
  | All
  | Pinned
  | Open
  | Complete

struct Model {
  draft: String,
  details: String,
  track: Track,
  pinned: Bool,
  filter: ViewFilter,
  nextId: Int,
  validation: String,
  lastInteraction: String,
  plans: Array<Plan>
}

type PlanAction =
  | DraftChanged String
  | DetailsChanged String
  | TrackChanged Track
  | PinnedChanged Bool
  | Submitted
  | TitleChanged (Int, String)
  | ToggleComplete Int
  | TogglePinned Int
  | Removed Int
  | FilterChanged ViewFilter
  | ClearCompleted
  | InteractionChanged String
  | NoOp

let initialModel: Model =
  Model {
    draft: "",
    details: "",
    track: Build,
    pinned: False,
    filter: All,
    nextId: 4,
    validation: "",
    lastInteraction: "Ready for a focused planning session.",
    plans: [
    Plan {
      id: 1,
      title: "Outline the launch story",
      details: "Give the next screen a clear reason to exist.",
      track: Build,
      pinned: True,
      complete: False
    },
    Plan {
      id: 2,
      title: "Invite two people to review",
      details: "Check the keyboard and touch paths before sharing.",
      track: Share,
      pinned: False,
      complete: False
    },
    Plan {
      id: 3,
      title: "Leave room for a quiet reset",
      details: "A sustainable plan includes a deliberate pause.",
      track: Rest,
      pinned: False,
      complete: True
    }
    ]
  }

fn newPlan model: Model -> Plan =
  Plan {
    id: model.nextId,
    title: model.draft,
    details: model.details,
    track: model.track,
    pinned: model.pinned,
    complete: False
  }

fn trackLabel track: Track -> String =
  match track {
    Build -> "Build"
    Share -> "Share"
    Rest -> "Rest"
  }

fn sameTrack first: Track -> second: Track -> Bool =
  match first {
    Build ->
    match second {
      Build -> True
      _ -> False
    }
    Share ->
    match second {
      Share -> True
      _ -> False
    }
    Rest ->
    match second {
      Rest -> True
      _ -> False
    }
  }

fn sameFilter first: ViewFilter -> second: ViewFilter -> Bool =
  match first {
    All ->
    match second {
      All -> True
      _ -> False
    }
    Pinned ->
    match second {
      Pinned -> True
      _ -> False
    }
    Open ->
    match second {
      Open -> True
      _ -> False
    }
    Complete ->
    match second {
      Complete -> True
      _ -> False
    }
  }

fn filterLabel filter: ViewFilter -> String =
  match filter {
    All -> "All plans"
    Pinned -> "Pinned"
    Open -> "Open"
    Complete -> "Completed"
  }

fn previousFilter filter: ViewFilter -> ViewFilter =
  match filter {
    All -> Complete
    Pinned -> All
    Open -> Pinned
    Complete -> Open
  }

fn nextFilter filter: ViewFilter -> ViewFilter =
  match filter {
    All -> Pinned
    Pinned -> Open
    Open -> Complete
    Complete -> All
  }

fn isComplete plan: Plan -> Bool =
  plan.complete

fn isOpen plan: Plan -> Bool =
  if plan.complete then False else True

fn isPinned plan: Plan -> Bool =
  plan.pinned

fn matches filter: ViewFilter -> plan: Plan -> Bool =
  match filter {
    All -> True
    Pinned -> isPinned plan
    Open -> isOpen plan
    Complete -> isComplete plan
  }

fn visiblePlans filter: ViewFilter
  -> plans: Array<Plan>
  -> Array<Plan> =
  arrays.filter (matches filter) plans

fn openCount plans: Array<Plan> -> Int =
  arrays.length (arrays.filter isOpen plans)

fn pinnedCount plans: Array<Plan> -> Int =
  arrays.length (arrays.filter isPinned plans)

fn completeCount plans: Array<Plan> -> Int =
  arrays.length (arrays.filter isComplete plans)

fn toggleComplete id: Int -> plan: Plan -> Plan =
  if plan.id == id
  then Plan { ...plan, complete: if plan.complete then False else True }
  else plan

fn togglePinned id: Int -> plan: Plan -> Plan =
  if plan.id == id
  then Plan { ...plan, pinned: if plan.pinned then False else True }
  else plan

fn renamePlan id: Int -> title: String -> plan: Plan -> Plan =
  if plan.id == id then Plan { ...plan, title } else plan

fn keepPlan removedId: Int -> plan: Plan -> Bool =
  plan.id != removedId

fn update action: PlanAction -> model: Model -> Model =
  match action {
    DraftChanged value ->
    Model { ...model, draft: value, validation: "" }
    DetailsChanged value ->
    Model { ...model, details: value, validation: "" }
    TrackChanged value ->
    Model { ...model, track: value, validation: "" }
    PinnedChanged value ->
    Model { ...model, pinned: value }
    Submitted ->
    if model.draft == ""
    then
    Model {
      ...model,
      validation: "Give this plan a name before adding it.",
      lastInteraction: "Validation: a plan name is required."
    }
    else
    if model.details == ""
    then
    Model {
      ...model,
      validation: "Add one sentence so the plan has a clear purpose.",
      lastInteraction: "Validation: add a short purpose."
    }
    else
    Model {
      ...model,
      draft: "",
      details: "",
      pinned: False,
      nextId: model.nextId + 1,
      validation: "",
      lastInteraction: "Plan added to the launch loop.",
      plans: arrays.append [newPlan model] model.plans
    }
    TitleChanged (id, title) ->
    Model {
      ...model,
      lastInteraction: "Plan title edited inline.",
      plans: map (renamePlan id title) model.plans
    }
    ToggleComplete id ->
    Model {
      ...model,
      lastInteraction: "Plan completion changed.",
      plans: map (toggleComplete id) model.plans
    }
    TogglePinned id ->
    Model {
      ...model,
      lastInteraction: "Plan pin changed.",
      plans: map (togglePinned id) model.plans
    }
    Removed id ->
    Model {
      ...model,
      lastInteraction: "Plan removed from the launch loop.",
      plans: arrays.filter (keepPlan id) model.plans
    }
    FilterChanged value ->
    Model {
      ...model,
      filter: value,
      lastInteraction: "View changed."
    }
    ClearCompleted ->
    Model {
      ...model,
      filter: All,
      lastInteraction: "Completed plans cleared.",
      plans: arrays.filter isOpen model.plans
    }
    InteractionChanged detail ->
    Model { ...model, lastInteraction: detail }
    NoOp -> model
  }

fn dispatch state: MutableSignal<Model>
  -> action: PlanAction
  -> Task<Unit> =
  signals.update (update action) state

fn draftTask state: MutableSignal<Model>
  -> event: html.InputEvent
  -> Task<Unit> =
  dispatch state (DraftChanged event.value)

fn detailsTask state: MutableSignal<Model>
  -> event: html.InputEvent
  -> Task<Unit> =
  dispatch state (DetailsChanged event.value)

fn pinnedTask state: MutableSignal<Model>
  -> event: html.ChangeEvent
  -> Task<Unit> =
  dispatch state (PinnedChanged event.checked)

fn titleTask state: MutableSignal<Model>
  -> id: Int
  -> event: html.InputEvent
  -> Task<Unit> =
  dispatch state (TitleChanged (id, event.value))

fn pointerTask state: MutableSignal<Model>
  -> event: html.PointerEvent
  -> html.EventAction<Task<Unit>> =
  html.Dispatch $
  dispatch state
  (InteractionChanged "Plan details explored with pointer input.")

fn filterKeyTask state: MutableSignal<Model>
  -> filter: ViewFilter
  -> event: html.KeyboardEvent
  -> html.EventAction<Task<Unit>> =
  match event.key {
    "ArrowLeft" ->
    html.DispatchPreventDefault $
    dispatch state (FilterChanged (previousFilter filter))
    "ArrowRight" ->
    html.DispatchPreventDefault $
    dispatch state (FilterChanged (nextFilter filter))
    "Home" ->
    html.DispatchPreventDefault (dispatch state (FilterChanged All))
    "End" ->
    html.DispatchPreventDefault (dispatch state (FilterChanged Complete))
    _ ->
    html.Dispatch (dispatch state NoOp)
  }

