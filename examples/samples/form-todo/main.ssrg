  "py-3",
  "font-semibold",
  "text-white",
  ]

let initialModel: Model =
  Model {
    draft: "",
    note: "",
    urgent: False,
    nextId: 3,
    filter: All,
    lastInteraction: "Ready for keyboard, touch, pen, or mouse.",
    items: [
    Todo {
      id: 1,
      title: "Review the typed form",
      note: "Edit this title directly in the table.",
      urgent: True
    },
    Todo {
      id: 2,
      title: "Try the filters",
      note: "Arrow keys move between All and Urgent.",
      urgent: False
    }
    ]
  }

fn newTodo model: Model -> Todo =
  Todo {
    id: model.nextId,
    title: model.draft,
    note: model.note,
    urgent: model.urgent
  }

fn keepTodo removedId: Int -> todo: Todo -> Bool =
  todo.id != removedId

fn renameTodo id: Int -> title: String -> todo: Todo -> Todo =
  if todo.id == id then Todo { ...todo, title } else todo

fn isUrgent todo: Todo -> Bool =
  todo.urgent

fn visibleItems filter: Filter -> items: Array<Todo> -> Array<Todo> =
  match filter {
    All -> items
    UrgentOnly -> arrays.filter isUrgent items
  }

fn update action: TodoAction -> model: Model -> Model =
  match action {
    DraftChanged value -> Model { ...model, draft: value }
    NoteChanged value -> Model { ...model, note: value }
    UrgentChanged checked -> Model { ...model, urgent: checked }
    Submitted ->
    if model.draft == "" then
    model
    else
    Model {
      ...model,
      draft: "",
      note: "",
      urgent: False,
      nextId: model.nextId + 1,
      lastInteraction: "Task added from the form.",
      items: arrays.append [newTodo model] model.items
    }
    TitleChanged (id, title) ->
    Model {
      ...model,
      lastInteraction: "Task title edited.",
      items: map (renameTodo id title) model.items
    }
    Removed id ->
    Model {
      ...model,
      lastInteraction: "Task deleted.",
      items: arrays.filter (keepTodo id) model.items
    }
    FilterChanged filter ->
    Model {
      ...model,
      filter,
      lastInteraction: "Visible tasks filtered."
    }
    InteractionChanged detail ->
    Model { ...model, lastInteraction: detail }
    NoOp -> model
  }

fn dispatch state: MutableSignal<Model>
  -> action: TodoAction
  -> Task<Unit> =
  signals.update (update action) state

fn draftTask state: MutableSignal<Model>
  -> event: html.InputEvent
  -> Task<Unit> =
  dispatch state (DraftChanged event.value)

fn noteTask state: MutableSignal<Model>
  -> event: html.InputEvent
  -> Task<Unit> =
  dispatch state (NoteChanged event.value)

fn urgentTask state: MutableSignal<Model>
  -> event: html.ChangeEvent
  -> Task<Unit> =
  dispatch state (UrgentChanged event.checked)

fn renameTask state: MutableSignal<Model>
  -> id: Int
  -> event: html.InputEvent
  -> Task<Unit> =
  dispatch state (TitleChanged (id, event.value))

fn pointerTask state: MutableSignal<Model>
  -> event: html.PointerEvent
  -> html.EventAction<Task<Unit>> =
  html.Dispatch $
  dispatch state
  (InteractionChanged `Row reached with ${event.pointerType} pointer.`)

fn filterKeyTask state: MutableSignal<Model>
  -> event: html.KeyboardEvent
  -> html.EventAction<Task<Unit>> =
  match event.key {
    "ArrowLeft" ->
    html.DispatchPreventDefault (dispatch state (FilterChanged All))
    "ArrowRight" ->
    html.DispatchPreventDefault (dispatch state (FilterChanged UrgentOnly))
    _ -> html.Dispatch (dispatch state NoOp)
  }

fn filterButton state: MutableSignal<Model>
  -> label: String
  -> filter: Filter
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: dispatch state (FilterChanged filter),
    onFocus: dispatch state (InteractionChanged `${label} filter focused.`),
    onKeyDown: filterKeyTask state,
    className: filterButtonClass,
    children: label
  }

fn titleCell state: MutableSignal<Model>
  -> todo: Todo
  -> html.Html<Task<Unit>> =
  html.td {
    className: "border-b border-slate-200 px-3 py-3",
    children: html.input {
      id: `todo-${todo.id}`,
      value: todo.title,
      onInput: renameTask state todo.id,
      className: titleInputClass
    }
  }

fn noteCell value: String -> html.Html<Task<Unit>> =
  html.td { className: noteCellClass, children: value }

fn priorityCell value: String -> html.Html<Task<Unit>> =
  html.td { className: priorityCellClass, children: value }

fn deleteCell state: MutableSignal<Model>
  -> todo: Todo
  -> html.Html<Task<Unit>> =
  html.td {
    className: deleteCellClass,
    children: html.button {
      buttonType: "button",
      onClick: dispatch state (Removed todo.id),
      stopClickPropagation: True,
      className: deleteButtonClass,
      children: "Delete"
    }
  }

fn itemRow state: MutableSignal<Model>
  -> todo: Todo
  -> html.Html<Task<Unit>> =
  html.tr {
    key: `${todo.id}`,
    onPointerDown: pointerTask state,
    children: [
    titleCell state todo,
    noteCell todo.note,
    priorityCell (if todo.urgent then "Urgent" else "Normal"),
    deleteCell state todo
    ]
  }

fn tableCaption model: Model -> html.Html<Task<Unit>> =
  html.caption {
    className: tableCaptionClass,
    children:
    `${arrays.length (visibleItems model.filter model.items)} visible tasks`
  }

fn tableHeading label: String -> html.Html<Task<Unit>> =
  html.th { className: "px-3 py-2", children: label }

fn tableHeaderRow -> html.Html<Task<Unit>> =
  html.tr {
    children: [
    tableHeading "Editable task",
    tableHeading "Note",
    tableHeading "Priority",
    tableHeading "Action"
    ]
  }

fn tableHeader -> html.Html<Task<Unit>> =
  html.thead { children: tableHeaderRow () }

fn taskTable state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.table {
    className: "mt-4 w-full border-collapse text-left",
    children: [
    tableCaption model,
    tableHeader (),
    html.tbody {
      children: [
      itemRow state item
      | item <- visibleItems model.filter model.items
      ]
    }
    ]
  }

fn brandImage imageUrl: html.WebUrl -> html.Html<Task<Unit>> =
  html.img {
    src: imageUrl,
    alt: "手帳のチェックリストへ予定を書き込む手元",
    className: brandImageClass,
    width: 720,
    height: 360,
    loading: "eager"
  }

fn introHeading -> html.Html<Task<Unit>> =
  html.h1 {
    className: "mb-2 mt-4 text-3xl font-bold",
    children: "Typed Web UI workshop"
  }

fn introCopy -> html.Html<Task<Unit>> =
  html.p {
    className: "mb-3 text-emerald-50",
    children: "One feature-owned Signal connects forms, tables, keyboard, and pointer input."
  }

fn sourceLink repositoryUrl: html.WebUrl -> html.Html<Task<Unit>> =
  html.a {
    href: repositoryUrl,
    target: "_blank",
    rel: "noopener",
    className: "font-semibold text-emerald-200",
    children: "Read the Seseragi source"
  }

fn documentIntro imageUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> html.Html<Task<Unit>> =
  html.article {
    className: documentIntroClass,
    children: [
    brandImage imageUrl,
    introHeading (),
    introCopy (),
    sourceLink repositoryUrl
    ]
  }

fn fieldLabel target: String -> label: String -> html.Html<Task<Unit>> =
  html.label {
    htmlFor: target,
    className: "mb-2 block font-semibold text-slate-700",
    children: label
  }

fn urgentControl state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.label {
    className: urgentControlClass,
    children: [
    html.input {
      name: "urgent",
      inputType: "checkbox",
      checked: model.urgent,
      onChange: urgentTask state
    },
    html.text "Mark as urgent"
    ]
  }

fn status model: Model -> html.Html<Task<Unit>> =
  html.p {
    role: "status",
    className: statusClass,
    children: model.lastInteraction
  }

fn todoForm state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.form {
    onSubmit: dispatch state Submitted,
    children: [
    fieldLabel "todo-title" "Task",
    html.input {
      id: "todo-title",
      name: "title",
      value: model.draft,
      placeholder: "Ship the next slice",
      inputType: "text",
      required: True,
      onInput: draftTask state,
      className: textFieldClass
    },
    fieldLabel "todo-note" "Note",
    html.textarea {
      id: "todo-note",
      name: "note",
      value: model.note,
      placeholder: "Optional detail",
      onInput: noteTask state,
      className: textFieldClass
    },
    urgentControl state model,
    html.button {
      buttonType: "submit",
      disabled: model.draft == "",
      className: submitButtonClass,
      children: "Add task"
    }
    ]
  }

fn filterNavigation state: MutableSignal<Model>
  -> html.Html<Task<Unit>> =
  html.nav {
    role: "group",
    className: "mt-6 flex gap-2",
    children: [
    filterButton state "All" All,
    filterButton state "Urgent" UrgentOnly
    ]
  }

fn workspaceCard state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.section {
    className: workspaceCardClass,
    children: [
    todoForm state model,
    filterNavigation state,
    status model,
    taskTable state model
    ]
  }

fn view state: MutableSignal<Model>
  -> imageUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.main {
    className: pageClass,
    children: [
    documentIntro imageUrl repositoryUrl,
    workspaceCard state model
    ]
  }

fn perform action: Task<Unit> -> Task<Unit> = action

effect fn mount content: Signal<html.Html<Task<Unit>>> -> Unit
with dom: dom.Dom
fails String =
  do {
    target <-
      dom.query "#app"
      |> mapError (\error: dom.DomError -> "DOM target unavailable")
    dom.run (dom.defaultOptions ()) target perform content
    |> mapError (\error: dom.DomRuntimeError<Never> -> "DOM runtime failed")
  }

effect fn parsedUrl value: String -> html.WebUrl
fails html.HtmlBuildError =
  fromEither (html.parseWebUrl value)

effect fn parseSampleUrl value: String -> html.WebUrl
fails String =
  mapError
  (\error: html.HtmlBuildError -> show error)
  (parsedUrl value)

pub effect fn main =
  do {
    imageUrl <-
      parseSampleUrl "https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?fit=crop&w=720&h=360&q=80"
    repositoryUrl <-
      parseSampleUrl "https://github.com/KentaroMorishita/seseragi"
    state <- signals.make initialModel
    mount $ signals.map (view state imageUrl repositoryUrl) state
  }
