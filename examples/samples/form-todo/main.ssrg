    className: panelCopyClass,
    children: "Capture the smallest useful action, then keep it visible."
  }

fn titleField state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: fieldGroupClass,
    children: [
    fieldLabel "plan-title" "Plan name",
    html.input {
      id: "plan-title",
      name: "title",
      value: model.draft,
      placeholder: "Draft the opening line",
      inputType: "text",
      onInput: draftTask state,
      onFocus:
      dispatch state (InteractionChanged "Plan name field focused."),
      className: fieldClass
    }
    ]
  }

fn detailsField state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: fieldGroupClass,
    children: [
    fieldLabel "plan-details" "Why it matters",
    html.textarea {
      id: "plan-details",
      name: "details",
      value: model.details,
      placeholder: "A sentence that keeps the action grounded.",
      onInput: detailsTask state,
      style: detailsFieldStyle,
      className: detailsFieldClass
    }
    ]
  }

fn trackLabelHeading -> html.Html<Task<Unit>> =
  html.p {
    className: fieldLabelClass,
    children: "Track"
  }

fn trackChoices state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: badgeRowClass,
    children: [
    trackButton state model "Build" Build,
    trackButton state model "Share" Share,
    trackButton state model "Rest" Rest
    ]
  }

fn trackField state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: fieldGroupClass,
    children: [
    trackLabelHeading (),
    trackChoices state model
    ]
  }

fn pinnedText -> html.Html<Task<Unit>> =
  html.span { children: "Keep this move in focus" }

fn pinnedField state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.label {
    className: checkboxRowClass,
    children: [
    html.input {
      id: "plan-pinned",
      name: "pinned",
      inputType: "checkbox",
      checked: model.pinned,
      onChange: pinnedTask state
    },
    pinnedText ()
    ]
  }

fn submitPlanButton model: Model -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "submit",
    disabled: model.draft == "",
    style: submitStyle,
    className: submitButtonClass,
    children: "Add to launch loop"
  }

fn validationMessage model: Model -> html.Html<Task<Unit>> =
  if model.validation == ""
  then html.text ""
  else
  html.p {
    role: "alert",
    style: validationStyle,
    className: validationClass,
    children: model.validation
  }

fn planFormBody state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.form {
    onSubmit: dispatch state Submitted,
    children: [
    titleField state model,
    detailsField state model,
    trackField state model,
    pinnedField state model,
    submitPlanButton model,
    validationMessage model
    ]
  }

fn planForm state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.section {
    className: panelClass,
    children: [
    planFormHeading (),
    planFormCopy (),
    planFormBody state model
    ]
  }

fn boardViewLabel -> html.Html<Task<Unit>> =
  html.p {
    className: filterLabelClass,
    children: "View"
  }

fn filterControls state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    role: "group",
    className: badgeRowClass,
    children: [
    filterButton state model "All" All,
    filterButton state model "Pinned" Pinned,
    filterButton state model "Open" Open,
    filterButton state model "Done" Complete
    ]
  }

fn boardToolbarGroup state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    children: [
    boardViewLabel (),
    filterControls state model
    ]
  }

fn boardToolbar state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: boardToolbarClass,
    children: [
    boardToolbarGroup state model,
    html.button {
      buttonType: "button",
      disabled: completeCount model.plans == 0,
      onClick: dispatch state ClearCompleted,
      className: clearButtonClass,
      children: "Clear completed"
    }
    ]
  }

fn progressBar model: Model -> html.Html<Task<Unit>> =
  html.div {
    className: progressBarClass,
    style: progressStyle model,
    children: ""
  }

fn progressTrack model: Model -> html.Html<Task<Unit>> =
  html.div {
    className: progressTrackClass,
    style: progressTrackStyle,
    children: progressBar model
  }

fn summaryFilter filter: ViewFilter -> html.Html<Task<Unit>> =
  html.span { children: filterLabel filter }

fn summaryColon -> html.Html<Task<Unit>> =
  html.span { children: ": " }

fn summaryCount model: Model -> html.Html<Task<Unit>> =
  html.span {
    children: show (arrays.length (visiblePlans model.filter model.plans))
  }

fn summarySuffix -> html.Html<Task<Unit>> =
  html.span { children: " plan(s) visible." }

fn summaryText model: Model -> html.Html<Task<Unit>> =
  html.p {
    className: panelCopyClass,
    children: [
    summaryFilter model.filter,
    summaryColon (),
    summaryCount model,
    summarySuffix ()
    ]
  }

fn boardSummary model: Model -> html.Html<Task<Unit>> =
  html.div {
    children: [
    progressTrack model,
    summaryText model
    ]
  }

fn planTrackBadge plan: Plan -> html.Html<Task<Unit>> =
  html.span {
    className: badgeClass,
    style: trackStyle plan.track,
    children: trackLabel plan.track
  }

fn planBadges plan: Plan -> html.Html<Task<Unit>> =
  html.div {
    className: badgeRowClass,
    children: [
    planTrackBadge plan,
    statusBadge plan
    ]
  }

fn planRemoveButton state: MutableSignal<Model>
  -> plan: Plan
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: dispatch state (Removed plan.id),
    stopClickPropagation: True,
    className: removeButtonClass,
    children: "Remove"
  }

fn planTop state: MutableSignal<Model>
  -> plan: Plan
  -> html.Html<Task<Unit>> =
  html.div {
    className: planTopClass,
    children: [
    planBadges plan,
    planRemoveButton state plan
    ]
  }

fn planEditorLabel plan: Plan -> html.Html<Task<Unit>> =
  html.label {
    htmlFor: show plan.id,
    className: fieldLabelClass,
    children: "Editable plan name"
  }

fn planEditorInput state: MutableSignal<Model>
  -> plan: Plan
  -> html.Html<Task<Unit>> =
  html.input {
    id: show plan.id,
    value: plan.title,
    onInput: titleTask state plan.id,
    onFocus:
    dispatch state (InteractionChanged "Inline plan editor focused."),
    className: planTitleClass
  }

fn planEditor state: MutableSignal<Model>
  -> plan: Plan
  -> html.Html<Task<Unit>> =
  html.div {
    children: [
    planEditorLabel plan,
    planEditorInput state plan
    ]
  }

fn planDetails state: MutableSignal<Model>
  -> plan: Plan
  -> html.Html<Task<Unit>> =
  html.p {
    onPointerDown: pointerTask state,
    className: planDetailsClass,
    children: plan.details
  }

fn planCompleteButton state: MutableSignal<Model>
  -> plan: Plan
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: dispatch state (ToggleComplete plan.id),
    stopClickPropagation: True,
    className: actionButtonClass,
    children:
    if plan.complete then "Mark open" else "Mark complete"
  }

fn planPinButton state: MutableSignal<Model>
  -> plan: Plan
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: dispatch state (TogglePinned plan.id),
    stopClickPropagation: True,
    className: actionButtonClass,
    children:
    if plan.pinned then "Unpin" else "Pin for focus"
  }

fn planFooter state: MutableSignal<Model>
  -> plan: Plan
  -> html.Html<Task<Unit>> =
  html.div {
    className: planFooterClass,
    children: [
    planCompleteButton state plan,
    planPinButton state plan
    ]
  }

fn planCard state: MutableSignal<Model>
  -> plan: Plan
  -> html.Html<Task<Unit>> =
  html.article {
    key: show plan.id,
    className: planCardClass,
    children: [
    planTop state plan,
    planEditor state plan,
    planDetails state plan,
    planFooter state plan
    ]
  }

fn emptyHeading filter: ViewFilter -> html.Html<Task<Unit>> =
  html.h3 {
    className: emptyHeadingClass,
    children:
    match filter {
      All -> "Your launch loop is clear."
      Pinned -> "Nothing is pinned yet."
      Open -> "No open plans remain."
      Complete -> "No completed plans yet."
    }
  }

fn emptyCopy filter: ViewFilter -> html.Html<Task<Unit>> =
  html.p {
    className: emptyCopyClass,
    children:
    match filter {
      All -> "Add one small move to give the board a new direction."
      Pinned -> "Use Pin for focus on a plan you want to revisit."
      Open -> "Mark a completed plan open, or add a new move."
      Complete -> "When a move is done, mark it complete to see it here."
    }
  }

fn emptyState filter: ViewFilter -> html.Html<Task<Unit>> =
  html.section {
    className: emptyStateClass,
    children: [
    emptyHeading filter,
    emptyCopy filter
    ]
  }

fn boardHeading -> html.Html<Task<Unit>> =
  html.h2 {
    className: panelHeadingClass,
    children: "Launch loop"
  }

fn boardCopy -> html.Html<Task<Unit>> =
  html.p {
    className: panelCopyClass,
    children: "Edit a title, change its state, or filter the next view."
  }

fn boardHeadingGroup -> html.Html<Task<Unit>> =
  html.div {
    children: [
    boardHeading (),
    boardCopy ()
    ]
  }

fn boardHeader state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: boardToolbarClass,
    children: [
    boardHeadingGroup (),
    boardToolbar state model
    ]
  }

fn visiblePlanList state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: planListClass,
    children: [
    planCard state plan
    | plan <- visiblePlans model.filter model.plans
    ]
  }

fn boardItems state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  if arrays.length (visiblePlans model.filter model.plans) == 0
  then emptyState model.filter
  else visiblePlanList state model

fn boardStatus model: Model -> html.Html<Task<Unit>> =
  html.p {
    role: "status",
    className: statusClass,
    children: model.lastInteraction
  }

fn planBoard state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.section {
    className: panelClass,
    children: [
    boardHeader state model,
    boardSummary model,
    boardItems state model,
    boardStatus model
    ]
  }

fn workspace state: MutableSignal<Model>
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: workspaceClass,
    children: [
    planForm state model,
    planBoard state model
    ]
  }

fn shellContent state: MutableSignal<Model>
  -> imageUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: shellClass,
    children: [
    hero imageUrl repositoryUrl model,
    workspace state model
    ]
  }

fn view state: MutableSignal<Model>
  -> imageUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.main {
    className: pageClass,
    children: shellContent state imageUrl repositoryUrl model
  }

fn perform action: Task<Unit> -> Task<Unit> =
  action

effect fn mount content: Signal<html.Html<Task<Unit>>> -> Unit
with dom: dom.Dom
fails String =
  do {
    target <-
      dom.query "#app"
      |> mapError (\error: dom.DomError -> "DOM target unavailable")
    dom.run (dom.defaultOptions ()) target perform content
    |> mapError (\error: dom.DomRuntimeError<Never> -> "DOM runtime failed")
  }

effect fn parsedUrl value: String -> html.WebUrl
fails html.HtmlBuildError =
  fromEither (html.parseWebUrl value)

effect fn parseSampleUrl value: String -> html.WebUrl
fails String =
  mapError
  (\error: html.HtmlBuildError -> show error)
  (parsedUrl value)

pub effect fn main =
  do {
    imageUrl <-
      parseSampleUrl "https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?fit=crop&w=720&h=360&q=80"
    repositoryUrl <-
      parseSampleUrl "https://github.com/KentaroMorishita/seseragi"
    state <- signals.make initialModel
    mount $ signals.map (view state imageUrl repositoryUrl) state
  }
