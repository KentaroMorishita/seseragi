let heroStyle =
  html.style { backgroundColor: "#312e81" }

let metricStyle =
  html.style { backgroundColor: "#3730a3" }

let submitStyle =
  html.style { backgroundColor: "#f59e0b", color: "#0f172a" }

let validationStyle =
  html.style { borderLeft: "4px solid #e11d48" }

let detailsFieldStyle =
  html.style { minHeight: "96px" }

let progressTrackStyle =
  html.style { height: "12px", overflow: "hidden" }

let pinnedStyle =
  html.style { backgroundColor: "#fef3c7", color: "#92400e" }

let selectedChoiceStyle =
  html.style { backgroundColor: "#0f766e", color: "#ffffff" }

let neutralChoiceStyle =
  html.style { backgroundColor: "#ffffff", color: "#0f172a" }

fn trackStyle track: Track -> html.Style =
  match track {
    Build ->
    html.style { backgroundColor: "#ffedd5", color: "#9a3412" }
    Share ->
    html.style { backgroundColor: "#dbeafe", color: "#1d4ed8" }
    Rest ->
    html.style { backgroundColor: "#dcfce7", color: "#166534" }
  }

fn completionPercent model: Model -> Int =
  if arrays.length model.plans == 0
  then 0
  else completeCount model.plans * 100 / arrays.length model.plans

fn progressStyle model: Model -> html.Style =
  html.style {
    backgroundColor: "#f59e0b",
    height: "100%",
    width: `${completionPercent model}%`,
  }

fn metricValue value: String -> html.Html<Task<Unit>> =
  html.div {
    className: metricValueClass,
    children: value
  }

fn metricText value: String -> html.Html<Task<Unit>> =
  html.div {
    className: metricLabelClass,
    children: value
  }

fn metric label: String
  -> value: String
  -> detail: String
  -> html.Html<Task<Unit>> =
  html.div {
    className: metricClass,
    style: metricStyle,
    children: [
    metricValue value,
    metricText label,
    metricText detail
    ]
  }

fn trackButton state: MutableSignal<Model>
  -> model: Model
  -> label: String
  -> track: Track
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: dispatch state (TrackChanged track),
    style:
    if sameTrack model.track track
    then selectedChoiceStyle
    else neutralChoiceStyle,
    className: actionButtonClass,
    children: label
  }

fn filterButton state: MutableSignal<Model>
  -> model: Model
  -> label: String
  -> filter: ViewFilter
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    onClick: dispatch state (FilterChanged filter),
    onKeyDown: filterKeyTask state filter,
    style:
    if sameFilter model.filter filter
    then selectedChoiceStyle
    else neutralChoiceStyle,
    className: actionButtonClass,
    children: label
  }

fn statusBadge plan: Plan -> html.Html<Task<Unit>> =
  html.span {
    className: pinnedBadgeClass,
    style: pinnedStyle,
    children:
    if plan.complete
    then "Complete"
    else
    if plan.pinned then "Pinned" else "Open"
  }

fn heroImage imageUrl: html.WebUrl -> html.Html<Task<Unit>> =
  html.img {
    src: imageUrl,
    alt: "手帳へ次の一歩を書き込む手元",
    className: heroImageClass,
    width: 720,
    height: 360,
    loading: "eager"
  }

fn heroTag -> html.Html<Task<Unit>> =
  html.div {
    className: heroTagClass,
    children: "SIGNAL STUDIO"
  }

fn heroHeading -> html.Html<Task<Unit>> =
  html.h1 {
    className: heroHeadingClass,
    children: "Plan a calmer launch."
  }

fn heroCopy -> html.Html<Task<Unit>> =
  html.p {
    className: heroCopyClass,
    children:
    "Turn one intention into small, visible moves. Every control below is wired to the same feature-owned Signal."
  }

fn heroSourceLink repositoryUrl: html.WebUrl
  -> html.Html<Task<Unit>> =
  html.a {
    href: repositoryUrl,
    target: "_blank",
    rel: "noopener",
    className: sourceLinkClass,
    children: "Read the Seseragi source"
  }

fn heroMetrics model: Model -> html.Html<Task<Unit>> =
  html.div {
    className: summaryGridClass,
    children: [
    metric "Open" (show (openCount model.plans)) "in motion",
    metric "Pinned" (show (pinnedCount model.plans)) "to revisit",
    metric "Done" (show (completeCount model.plans)) "celebrated"
    ]
  }

fn heroText repositoryUrl: html.WebUrl
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    children: [
    heroTag (),
    heroHeading (),
    heroCopy (),
    heroSourceLink repositoryUrl,
    heroMetrics model
    ]
  }

fn heroGrid imageUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> model: Model
  -> html.Html<Task<Unit>> =
  html.div {
    className: heroGridClass,
    children: [
    heroImage imageUrl,
    heroText repositoryUrl model
    ]
  }

