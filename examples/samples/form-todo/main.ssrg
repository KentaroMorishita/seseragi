import * as arrays from "std/array"
import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"

struct Todo {
  id: Int,
  title: String,
  note: String,
  urgent: Bool
}

type Filter =
  | All
  | UrgentOnly

struct Model {
  draft: String,
  note: String,
  urgent: Bool,
  nextId: Int,
  filter: Filter,
  lastInteraction: String,
  items: Array<Todo>,
}

type TodoAction =
  | DraftChanged String
  | NoteChanged String
  | UrgentChanged Bool
  | Submitted
  | TitleChanged (Int, String)
  | Removed Int
  | FilterChanged Filter
  | InteractionChanged String
  | NoOp

fn cx classes: Array<String> -> String =
  join " " classes

let filterButtonClass =
  cx [
  "rounded-lg",
  "border",
  "border-emerald-200",
  "bg-emerald-50",
  "px-3",
  "py-2",
  "text-sm",
  "font-semibold",
  "text-emerald-800",
  ]

let titleInputClass =
  cx [
  "w-full",
  "rounded-lg",
  "border",
  "border-slate-200",
  "px-3",
  "py-2",
  "text-base",
  ]

let deleteCellClass =
  cx [
  "border-b",
  "border-slate-200",
  "px-3",
  "py-3",
  "text-right",
  ]

let deleteButtonClass =
  cx [
  "rounded-lg",
  "border-0",
  "bg-slate-900",
  "px-3",
  "py-2",
  "text-sm",
  "font-semibold",
  "text-white",
  ]

