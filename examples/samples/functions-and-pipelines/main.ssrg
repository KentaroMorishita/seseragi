fn add offset: Int -> value: Int -> Int = offset + value

fn double value: Int -> Int = value * 2

fn describe value: Int -> String = `Answer: ${value}`

// カリー化された関数は、パイプラインの値を最後の引数として受け取ります。
pub effect fn main -> Unit with Console fails ConsoleError =
  16
  |> add 5
  |> double
  |> describe
  |> println
