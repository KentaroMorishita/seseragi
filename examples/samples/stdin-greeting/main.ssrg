type AppError deriving Show =
  | InputFailure StdinError
  | OutputFailure ConsoleError

fn greeting maybeName: Maybe<String> -> String = match maybeName {
  Just name -> `Hello, ${name}!`
  Nothing -> "Hello, stranger!"
}

pub effect fn main -> Unit with Stdin, Console fails AppError = do {
  maybeName <- mapError InputFailure (readLine ())
  let message = greeting maybeName
  mapError OutputFailure (println message)
}
