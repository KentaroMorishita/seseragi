import * as arrays from "std/array"

struct Sale { item: String, amount: Int }

let sales: Array<Sale> = [
  Sale { item: "Book", amount: 2400 },
  Sale { item: "Pen", amount: 600 },
  Sale { item: "Cancelled", amount: 0 },
  Sale { item: "Notebook", amount: 1200 }
]

fn completed sale: Sale -> Bool = sale.amount > 0

fn renderSale sale: Sale -> String = `${sale.item}: ${sale.amount}`

fn totalSales values: Array<Sale> -> Int = sum (map (\sale: Sale -> sale.amount) values)

fn report completedSales: Array<Sale> -> String = {
  // 絞り込んだ同じ配列から、表示用の行と合計金額の両方を作ります。
  let lines = map renderSale completedSales
  let total = totalSales completedSales

  join "\n" [`Completed: ${join ", " lines}`, `Total: ${total}`]
}

pub effect fn main -> Unit with Console fails ConsoleError =
  sales
  |> arrays.filter completed
  |> report
  |> println
