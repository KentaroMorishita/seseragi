import * as dom from "std/web/dom"
import * as html from "std/web/html"

type Mode =
  | Ready
  | Focusing
  | Resting

type Action =
  | StartFocus
  | TakeBreak
  | Reset

fn cx classes: Array<String> -> String =
  join " " classes

fn update action: Action -> mode: Mode -> Mode =
  match action {
    StartFocus -> Focusing
    TakeBreak -> Resting
    Reset -> Ready
  }

fn title mode: Mode -> String =
  match mode {
    Ready -> "Choose your rhythm"
    Focusing -> "Deep work in progress"
    Resting -> "Pause with purpose"
  }

fn guidance mode: Mode -> String =
  match mode {
    Ready -> "Pick a mode and let a typed action update the Signal."
    Focusing -> "One task. No tab hopping. You have got this."
    Resting -> "Look away from the screen and take a slow breath."
  }

fn accent mode: Mode -> String =
  match mode {
    Ready -> "#475569"
    Focusing -> "#059669"
    Resting -> "#2563eb"
  }

fn progress mode: Mode -> String =
  match mode {
    Ready -> "18%"
    Focusing -> "82%"
    Resting -> "46%"
  }

let pageClass =
  cx [
  "min-h-screen",
  "bg-emerald-50",
  "p-8",
  "sm:p-12",
  ]

let focusCardClass =
  cx [
  "mx-auto",
  "max-w-lg",
  "rounded-2xl",
  "bg-white",
  "p-8",
  "shadow-lg",
  ]

let headingClass =
  cx [
  "mb-2",
  "mt-4",
  "text-3xl",
  "font-bold",
  "text-slate-900",
  "sm:text-4xl",
  ]

let actionButtonClass =
  cx [
  "w-full",
  "rounded-xl",
  "border-0",
  "px-4",
  "py-3",
  "font-semibold",
  "transition",
  "hover:shadow-lg",
  ]

let actionGroupClass =
  cx [
  "mt-6",
  "grid",
  "grid-cols-1",
  "gap-2",
  "sm:grid-cols-3",
  ]

let progressTrackStyle =
  html.style {
    backgroundColor: "#e2e8f0",
    borderRadius: "999px",
    height: "10px",
    overflow: "hidden"
  }

fn eyebrowStyle mode: Mode -> html.Style =
  html.style { color: accent mode, fontWeight: "700" }

fn progressStyle mode: Mode -> html.Style =
  html.style {
    backgroundColor: accent mode,
    borderRadius: "999px",
    height: "100%",
    transition: "all 240ms ease",
    width: progress mode
  }

fn actionStyle action: Action -> html.Style =
  match action {
    StartFocus -> html.style { backgroundColor: "#059669", color: "#ffffff" }
    TakeBreak -> html.style { backgroundColor: "#2563eb", color: "#ffffff" }
    Reset -> html.style { backgroundColor: "#f1f5f9", color: "#334155" }
  }

fn actionButton label: String -> action: Action -> html.Html<Action> =
  html.button {
    onClick: action,
    className: actionButtonClass,
    style: actionStyle action,
    children: label
  }

fn progressBar mode: Mode -> html.Html<Action> =
  html.div {
    style: progressTrackStyle,
    children: html.div {
      style: progressStyle mode,
      children: ""
    }
  }

fn actionGroup -> html.Html<Action> =
  html.div {
    className: actionGroupClass,
    children: [
    actionButton "Start focus" StartFocus,
    actionButton "Take a break" TakeBreak,
    actionButton "Reset the flow" Reset
    ]
  }

fn focusCard mode: Mode -> html.Html<Action> =
  html.section {
    className: focusCardClass,
    children: [
    html.span {
      style: eyebrowStyle mode,
      children: "SESERAGI FLOW"
    },
    html.h1 {
      className: headingClass,
      children: title mode
    },
    html.p {
      className: "mb-6 text-lg text-slate-700",
      children: guidance mode
    },
    progressBar mode,
    actionGroup ()
    ]
  }

fn view mode: Mode -> html.Html<Action> =
  html.main {
    className: pageClass,
    children: focusCard mode
  }

// dom.appがSignalの準備、mount、cleanup、失敗変換を引き受けます。
pub effect fn main =
  dom.app {
    target: "#app",
    initial: Ready,
    update,
    view
  }
