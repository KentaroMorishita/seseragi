// ブロック内の局所関数と末尾再帰を使って、10 万回の模擬試行を集計します。

fn simulateLottery trials: Int -> threshold: Int -> String = {
  let modulus = 2147483647
  let multiplier = 48271

  // 局所関数は外側の束縛（threshold）を参照でき、ジェネリック型引数も持てます。
  fn tagResult<A> label: String -> value: A -> (String, A) = (label, value)

  // 末尾位置の自己再帰はループへ変換されるため、10 万回でもスタックを消費しません。
  fn step remaining: Int -> seed: Int -> hits: Int -> Int =
    if remaining == 0 then hits else {
      let nextSeed = (seed * multiplier) % modulus
      let roll = (nextSeed % 100) + 1
      let nextHits = if roll <= threshold then hits + 1 else hits
      step (remaining - 1) nextSeed nextHits
    }

  let (label, hitCount) = tagResult "当たり回数" (step trials 12345 0)
  let rateTenths = hitCount * 1000 / trials
  let rateWhole = rateTenths / 10
  let rateFrac = rateTenths % 10
  [
    `試行回数: ${trials} 回（当たり条件: 1..=${threshold} / 100）`,
    `${label}: ${hitCount} 回（約 ${rateWhole}.${rateFrac}%）`,
  ]
    |> join "\n"
}

let trialCount = 100000

let hitThreshold = 15

pub effect fn main = simulateLottery trialCount hitThreshold |> println
