fn finalScore base: Int -> Int = {
  let bonus: Int = 2

  // 局所関数は先に定義した束縛を参照でき、ジェネリック型引数も持てます。
  fn withLabel<A> label: A -> score: Int -> (A, Int) = (label, score + bonus)

  // 末尾位置の自己再帰はループへ変換されるため、コールスタックを消費しません。
  fn countdown current: Int -> Int = if current == 0 then {
    let (_, total) = withLabel "final" base
    total
  } else countdown (current - 1)

  countdown 100000
}

pub effect fn main = println `Final score: ${finalScore 40}`
