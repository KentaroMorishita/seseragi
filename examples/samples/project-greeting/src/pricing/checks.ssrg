// Explorer からそのまま読める検証一覧。計算モジュールが期待通りに動くかを == で確かめます。
import * as arrays from "std/array"
import {
  Domestic,
  Island,
  Parcel,
  ShippingQuote,
  quoteShipping,
} from "self/pricing/shipping"

pub struct CheckCase deriving Eq, Show, Debug { pub name: String, pub passed: Bool, pub detail: String, }

fn verifyCase name: String -> parcel: Parcel -> expected: ShippingQuote -> CheckCase = {
  let actual = quoteShipping parcel
  let passed = actual == expected
  let detail =
    if passed then
      `OK (${actual.totalYen}円)`
    else
      `NG (期待 ${expected.totalYen}円 / 実際 ${actual.totalYen}円)`
  CheckCase { name, passed, detail }
}

pub fn runChecks -> Array<CheckCase> = [
  verifyCase "通常注文は基本送料 550 円"
    (Parcel { label: "マグカップ", subtotalYen: 2400, weightGrams: 400, zone: Domestic })
    (ShippingQuote { shippingYen: 550, totalYen: 2950, freeShipping: False }),
  verifyCase "国内で 5000 円以上は送料無料"
    (Parcel { label: "珈琲豆セット", subtotalYen: 5200, weightGrams: 1200, zone: Domestic })
    (ShippingQuote { shippingYen: 0, totalYen: 5200, freeShipping: True }),
  verifyCase "離島かつ 2kg 超えは追加料金あり"
    (Parcel { label: "陶器ポット", subtotalYen: 6000, weightGrams: 2600, zone: Island })
    (ShippingQuote { shippingYen: 1450, totalYen: 7450, freeShipping: False }),
]

pub fn formatChecks checks: Array<CheckCase> -> Array<String> = {
  let passedCount = arrays.length [check | check <- checks, check.passed]
  let lines = map (\check: CheckCase -> `  [${check.detail}] ${check.name}`) checks
  arrays.append lines [`検証結果 (${passedCount}/${arrays.length checks} 件通過):`]
}
