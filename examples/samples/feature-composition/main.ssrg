// 各カードが自分専用の非公開 Signal を持ち、親は Signal<Html<Task<Unit>>> だけを合成して dom.run で描画します。
import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"
import * as svg from "std/web/svg"

// ── 機能ごとの状態（各カードの中だけで閉じる） ──────────

struct CheckState { done: Int, goal: Int }

type CheckAction =
  | Advance
  | Reset

struct CardTheme { accent: String, surface: String, border: String, badgeBg: String, }

let amberTheme = CardTheme {
  accent: "#9a4a12",
  surface: "#fffaf0",
  border: "#ead6b8",
  badgeBg: "#f8e8cc",
}

let tealTheme = CardTheme {
  accent: "#0f6b64",
  surface: "#f2faf8",
  border: "#c5e4dd",
  badgeBg: "#d8f0ea",
}

let forestTheme = CardTheme {
  accent: "#2d6a4f",
  surface: "#f3faf5",
  border: "#c7e3d0",
  badgeBg: "#d8eedf",
}

// ── 見た目: 名前付きの style ───────────────────────────

let pageStyle = html.style {
  background: "#f6f4ef",
  color: "#1b242b",
  fontFamily: "system-ui, -apple-system, \"Hiragino Sans\", \"Noto Sans JP\", sans-serif",
  minHeight: "100vh",
  padding: "32px 20px 56px",
}

let shellStyle = html.style { margin: "0 auto", maxWidth: "880px", }

let heroStyle = html.style {
  background: "linear-gradient(135deg, #172a3a 0%, #244054 100%)",
  borderRadius: "20px",
  color: "#f8fafc",
  display: "grid",
  gap: "20px",
  gridTemplateColumns: "repeat(auto-fit, minmax(260px, 1fr))",
  alignItems: "center",
  marginBottom: "20px",
  padding: "28px 24px",
}

let eyebrowStyle = html.style {
  color: "#9fd3c7",
  fontSize: "12px",
  fontWeight: "700",
  letterSpacing: "0.14em",
  margin: "0",
}

let headingStyle = html.style {
  fontSize: "clamp(24px, 4.5vw, 34px)",
  fontWeight: "800",
  letterSpacing: "-0.02em",
  lineHeight: "1.25",
  margin: "8px 0 10px",
}

let heroCopyStyle = html.style {
  color: "#d4e3ec",
  fontSize: "15px",
  lineHeight: "1.75",
  margin: "0",
}

let diagramCardStyle = html.style {
  background: "rgba(255, 255, 255, 0.08)",
  border: "1px solid rgba(255, 255, 255, 0.16)",
  borderRadius: "14px",
  padding: "14px",
}

let controlPanelStyle = html.style {
  background: "#ffffff",
  border: "1px solid #dfd9cc",
  borderRadius: "16px",
  marginBottom: "20px",
  padding: "18px 20px",
}

let controlGroupStyle = html.style { display: "flex", flexWrap: "wrap", gap: "10px", }

let controlButtonStyle = html.style {
  background: "#f6f4ef",
  border: "1px solid #cfc7b6",
  borderRadius: "10px",
  color: "#172a3a",
  cursor: "pointer",
  font: "inherit",
  fontSize: "14px",
  fontWeight: "700",
  padding: "10px 14px",
}

let controlStatusStyle = html.style {
  color: "#4c5a64",
  fontSize: "14px",
  lineHeight: "1.6",
  margin: "12px 0 0",
}

let featureGridStyle = html.style {
  display: "grid",
  gap: "16px",
  gridTemplateColumns: "repeat(auto-fit, minmax(260px, 1fr))",
}

fn cardStyle theme: CardTheme -> html.Style = html.style {
  background: theme.surface,
  border: `1px solid ${theme.border}`,
  borderRadius: "16px",
  display: "flex",
  flexDirection: "column",
  gap: "12px",
  padding: "20px",
}

fn badgeStyle theme: CardTheme -> html.Style = html.style {
  alignSelf: "flex-start",
  background: theme.badgeBg,
  borderRadius: "999px",
  color: theme.accent,
  fontSize: "12px",
  fontWeight: "700",
  padding: "4px 10px",
}

let cardTitleStyle = html.style { fontSize: "20px", fontWeight: "800", margin: "0", }

fn countStyle theme: CardTheme -> html.Style = html.style {
  color: theme.accent,
  fontSize: "32px",
  fontVariantNumeric: "tabular-nums",
  fontWeight: "800",
  lineHeight: "1.1",
  margin: "0",
}

let cardNoteStyle = html.style {
  color: "#4c5a64",
  fontSize: "14px",
  lineHeight: "1.6",
  margin: "0",
}

let barTrackStyle = html.style {
  background: "#e5e0d5",
  borderRadius: "999px",
  height: "8px",
  overflow: "hidden",
  width: "100%",
}

fn barFillStyle theme: CardTheme -> percent: Int -> html.Style = html.style {
  background: theme.accent,
  borderRadius: "999px",
  height: "100%",
  transition: "width 180ms ease",
  width: `${percent}%`,
}

let cardActionsStyle = html.style {
  display: "flex",
  flexWrap: "wrap",
  gap: "8px",
  marginTop: "4px",
}

fn primaryActionStyle theme: CardTheme -> html.Style = html.style {
  background: theme.accent,
  border: "0",
  borderRadius: "10px",
  color: "#ffffff",
  cursor: "pointer",
  font: "inherit",
  fontSize: "14px",
  fontWeight: "700",
  padding: "10px 14px",
}

let secondaryActionStyle = html.style {
  background: "#ffffff",
  border: "1px solid #d5cfc2",
  borderRadius: "10px",
  color: "#334155",
  cursor: "pointer",
  font: "inherit",
  fontSize: "14px",
  fontWeight: "600",
  padding: "10px 12px",
}

let hiddenCardStyle = html.style {
  background: "#efece4",
  border: "1px dashed #bfb7a6",
  borderRadius: "16px",
  color: "#4c5a64",
  display: "flex",
  flexDirection: "column",
  gap: "8px",
  justifyContent: "center",
  padding: "24px 20px",
}

// ── 独立した機能カードのコンストラクタ ──────────────────

fn updateCheck action: CheckAction -> state: CheckState -> CheckState = match action {
  Advance -> CheckState {
    ...state,
    done:
      if state.done < state.goal then
        state.done + 1
      else
        state.goal,
  }
  Reset -> CheckState { ...state, done: 0 }
}

fn dispatchCheck state: MutableSignal<CheckState> -> action: CheckAction -> Task<Unit> =
  signals.update (updateCheck action) state

fn checkCardView title: String
  -> note: String
  -> theme: CardTheme
  -> state: MutableSignal<CheckState>
  -> current: CheckState
  -> html.Html<Task<Unit>> =
  {
    let percent = current.done * 100 / current.goal
    let statusText =
      if current.done == current.goal then
        "完了（非公開 Signal に保持）"
      else
        `残り ${current.goal - current.done} 件`
    html.section {
      key: title,
      style: cardStyle theme,
      children: [
        html.span { style: badgeStyle theme, children: statusText },
        html.h2 { style: cardTitleStyle, children: title },
        html.p {
          style: countStyle theme,
          children: `${current.done} / ${current.goal}`,
        },
        html.div {
          style: barTrackStyle,
          children: html.div { style: barFillStyle theme percent, children: "" },
        },
        html.p { style: cardNoteStyle, children: note },
        html.div {
          style: cardActionsStyle,
          children: [
            html.button {
              onClick: dispatchCheck state Advance,
              style: primaryActionStyle theme,
              children: "確認を 1 件進める",
            },
            html.button {
              onClick: dispatchCheck state Reset,
              style: secondaryActionStyle,
              children: "リセット",
            },
          ],
        },
      ],
    }
  }

// コンストラクタを呼んだ時点で各カード専用の Signal が一度だけ作られ、外へは描画 Signal だけを返します。
effect fn createChecklistCard title: String
  -> note: String
  -> goal: Int
  -> theme: CardTheme
  -> Signal<html.Html<Task<Unit>>>
fails Never =
  do {
    state <- signals.make (CheckState { done: 0, goal })
    succeed (signals.map (checkCardView title note theme state) state)
  }

// ── 親のレイアウト制御（子の状態には一切触れない） ──────

type LayoutAction =
  | ToggleFirst
  | SwapOrder
  | ReplaceFirst

struct LayoutState { showFirst: Bool, reversed: Bool, replaced: Bool }

fn updateLayout action: LayoutAction -> state: LayoutState -> LayoutState =
  match action {
    ToggleFirst -> LayoutState { ...state, showFirst: ! state.showFirst }
    SwapOrder -> LayoutState { ...state, reversed: ! state.reversed }
    ReplaceFirst -> LayoutState { ...state, replaced: ! state.replaced }
  }

fn dispatchLayout state: MutableSignal<LayoutState>
  -> action: LayoutAction
  -> Task<Unit> =
  signals.update (updateLayout action) state

fn controlButton label: String -> action: Task<Unit> -> html.Html<Task<Unit>> =
  html.button {
    onClick: action,
    style: controlButtonStyle,
    children: label,
  }

fn controlsView state: MutableSignal<LayoutState>
  -> current: LayoutState
  -> html.Html<Task<Unit>> =
  {
    let toggleLabel = if current.showFirst then "先頭カードを隠す" else "先頭カードを再表示する"
    let replaceLabel = if current.replaced then "下書き確認へ戻す" else "先頭を最終チェックへ差し替える"
    let statusMessage = if
    ! current.showFirst then
      "先頭カードは DOM から外れていますが、Signal 自体は破棄されないため確認数はそのまま残ります。"
    else if current.replaced then
      "先頭スロットを別の機能カードへ切り替えました。元のカードの確認数も保持されています。"
    else
      "各カードは独立した Signal を所有しています。順番を入れ替えても確認数はカード側に紐づいたままです。"
    html.section {
      style: controlPanelStyle,
      children: [
        html.div {
          style: controlGroupStyle,
          children: [
            controlButton toggleLabel (dispatchLayout state ToggleFirst),
            controlButton "カードの順番を入れ替える" (dispatchLayout state SwapOrder),
            controlButton replaceLabel (dispatchLayout state ReplaceFirst),
          ],
        },
        html.p { style: controlStatusStyle, children: statusMessage },
      ],
    }
  }

fn hiddenPlaceholder -> html.Html<Task<Unit>> = html.section {
  style: hiddenCardStyle,
  children: [
    html.strong { children: "先頭カードは非表示です" },
    html.p { style: cardNoteStyle, children: "上の「先頭カードを再表示する」を押すと、元の確認数のまま復帰します。", },
  ],
}

fn selectFirstSlot first: Signal<html.Html<Task<Unit>>>
  -> replacement: Signal<html.Html<Task<Unit>>>
  -> layout: LayoutState
  -> Signal<html.Html<Task<Unit>>> =
  if
  ! layout.showFirst then
    signals.constant (hiddenPlaceholder ())
  else if layout.replaced then
    replacement
  else
    first

// ── ヒーローと全体の組み立て ───────────────────────────

fn flowDiagram -> html.Html<Task<Unit>> = html.div {
  style: diagramCardStyle,
  children: svg.svg {
    viewBox: "0 0 300 92",
    role: "img",
    ariaLabel: "独立した Signal を 1 つの画面へ合成する流れ",
    children: [
      svg.rect { x: 8.0, y: 14.0, width: 80.0, height: 28.0, rx: 8.0, fill: "#d97706", },
      svg.rect { x: 8.0, y: 52.0, width: 80.0, height: 28.0, rx: 8.0, fill: "#0f766e", },
      svg.line {
        x1: 88.0,
        y1: 28.0,
        x2: 136.0,
        y2: 46.0,
        stroke: "#9fd3c7",
        strokeWidth: "2",
      },
      svg.line {
        x1: 88.0,
        y1: 66.0,
        x2: 136.0,
        y2: 46.0,
        stroke: "#9fd3c7",
        strokeWidth: "2",
      },
      svg.rect {
        x: 136.0,
        y: 28.0,
        width: 74.0,
        height: 36.0,
        rx: 10.0,
        fill: "#38617a",
      },
      svg.line {
        x1: 210.0,
        y1: 46.0,
        x2: 238.0,
        y2: 46.0,
        stroke: "#9fd3c7",
        strokeWidth: "2",
      },
      svg.rect {
        x: 238.0,
        y: 28.0,
        width: 54.0,
        height: 36.0,
        rx: 10.0,
        fill: "#9fd3c7",
      },
    ],
  } |> svg.toHtml,
}

fn heroSection -> html.Html<Task<Unit>> = html.section {
  style: heroStyle,
  children: [
    html.div {
      children: [
        html.p { style: eyebrowStyle, children: "FEATURE-OWNED SIGNALS" },
        html.h1 { style: headingStyle, children: "公開準備ボードを独立した Signal で合成する" },
        html.p {
          style: heroCopyStyle,
          children: "カードごとの確認数を親の状態へ吸い上げずに、非表示・並べ替え・差し替えを自在に組み合わせます。",
        },
      ],
    },
    flowDiagram (),
  ],
}

fn pageView layout: LayoutState
  -> panel: html.Html<Task<Unit>>
  -> first: html.Html<Task<Unit>>
  -> second: html.Html<Task<Unit>>
  -> html.Html<Task<Unit>> = {
    let shell: html.Html<Task<Unit>> = html.div {
      style: shellStyle,
      children: [
        heroSection (),
        panel,
        html.section {
          style: featureGridStyle,
          children:
            if layout.reversed then
              [second, first]
            else
              [first, second],
        },
      ],
    }
    html.main { style: pageStyle, children: shell }
  }

fn perform action: Task<Unit> -> Task<Unit> = action

effect fn mount content: Signal<html.Html<Task<Unit>>>
  -> Unit
with dom: dom.Dom
fails String =
  do {
    target <- dom.query "#app"
      |> mapError (\error: dom.DomError -> "DOM target unavailable")
    dom.run (dom.defaultOptions ()) target perform content
      |> mapError (\error: dom.DomRuntimeError<Never> -> "DOM runtime failed")
  }

pub effect fn main = do {
  layout <- signals.make (LayoutState { showFirst: True, reversed: False, replaced: False })
  first <- createChecklistCard "下書き確認" "本文の誤字・リンク切れ・サンプル出力を確認します。" 4 amberTheme
  second <- createChecklistCard "変更点の整理" "CHANGELOG と移行手順の要点をまとめます。" 3 tealTheme
  replacement <- createChecklistCard "最終チェック" "本番ビルドと公開タグの整合を確かめます。" 5 forestTheme

  let panel = signals.map (controlsView layout) layout
  let layoutView = signals.map (\current: LayoutState -> current) layout
  // switchMap は表示中の Signal だけへ購読を切り替え、外したカードの Signal はそのまま保持します。
  let activeFirst =
    signals.switchMap (\current: LayoutState -> selectFirstSlot first replacement current) layout
  let content = pageView <$> layoutView <*> panel <*> activeFirst <*> second

  mount content
}
