// 入口は #app を探して、組み立てた画面を dom.run に渡すだけにします。
import * as clock from "std/clock"
import * as dom from "std/web/dom"
import { create } from "self/app"

fn perform action: Task<Unit> -> Task<Unit> = action

pub effect fn main -> Unit with dom: dom.Dom, clock: clock.Clock fails String = do {
  content <- create ()
  target <- dom.query "#app" |> mapError (\_error: dom.DomError -> "表示先の #app が見つかりません")
  dom.run (dom.defaultOptions ()) target perform content
    |> mapError (\_error: dom.DomRuntimeError<Never> -> "画面の更新に失敗しました")
}
