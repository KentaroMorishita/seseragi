// 3 つの機能を作って並べます。組み立て側は、どの機能の状態にも触れません。
// 手順の機能には、タイマーの「タイマーをかける」操作だけを渡します。
import * as clock from "std/clock"
import * as html from "std/web/html"
import { Signal } from "std/signal"
import * as servings from "self/features/servings"
import * as steps from "self/features/steps"
import * as timer from "self/features/timer"
import * as styles from "self/ui/styles"

fn ownership color: String -> label: String -> html.Html<Task<Unit>> = html.li {
  style: styles.ownershipItemStyle (),
  children: [
    html.span { style: styles.ownershipMarkStyle color, children: "" },
    html.text label
  ],
}

// 見出しは言葉の切れ目でだけ折り返します。
fn titleLine text: String -> html.Html<Task<Unit>> = html.span {
  style: styles.titleLineStyle (),
  children: text
}

fn intro -> html.Html<Task<Unit>> = html.div {
  style: styles.introStyle (),
  children: [
    html.p { style: styles.eyebrowStyle (), children: "今夜のひと皿" },
    html.h1 {
      style: styles.titleStyle (),
      children: [titleLine "トマトとバジルの", titleLine "スパゲッティ"],
    },
    html.p {
      style: styles.leadStyle (),
      children: "分量・手順・タイマーの 3 つが、それぞれ自分の状態を持ったまま、一つの台所に並んでいます。",
    },
    html.ul {
      style: styles.ownershipListStyle (),
      children: [
        ownership (styles.servingsMark ()) "分量は人数を持つ",
        ownership (styles.stepsMark ()) "手順は済んだ番号を持つ",
        ownership (styles.timerMark ()) "タイマーは残り時間を持つ",
      ],
    },
  ],
}

fn kitchen servingsView: html.Html<Task<Unit>> -> stepsView: html.Html<Task<Unit>>
  -> timerView: html.Html<Task<Unit>> -> html.Html<Task<Unit>> =
  html.main {
    style: styles.pageStyle (),
    children: html.div {
      style: styles.shellStyle (),
      children: [
        html.header { style: styles.heroStyle (), children: [intro (), timerView] },
        html.div {
          style: styles.workbenchStyle (),
          children: [servingsView, stepsView]
        },
      ],
    },
  }

pub effect fn create -> Signal<html.Html<Task<Unit>>>
with clock: clock.Clock
fails String =
  do {
    kitchenTimer <- timer.create ()
    servingsView <- servings.create ()
    stepsView <- steps.create kitchenTimer.start
    succeed (kitchen <$> servingsView <*> stepsView <*> kitchenTimer.view)
  }
