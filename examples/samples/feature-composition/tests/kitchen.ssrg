// `seseragi test` で、画面なしに分量の換算とタイマーの状態遷移を確かめます。
import * as sets from "std/set"
import { Set } from "std/set"
import * as test from "std/test"
import {
  AddMinute,
  Countdown,
  Elapsed,
  Finished,
  Idle,
  Pause,
  Paused,
  Running,
  Start,
  TimerState,
  TimerRequest,
  advance,
  clockText,
  elapsedPermille,
  secondsLeft,
  splitElapsed,
  update,
} from "self/kitchen/countdown"
import {
  Grams,
  Pieces,
  Tablespoons,
  Tenths,
  amountText,
  clampServings,
  scale,
  toggleDone,
} from "self/kitchen/recipe"

let started = update (Start (TimerRequest { label: "スパゲッティをゆでる", minutes: 8 })) Idle

let lastQuarter =
  Running (Countdown { label: "にんにくを炒める", total: 180000, remaining: 250 })

let noneDone: Set<Int> = sets.empty ()

let garlicForThree =
  test.test "3 人分のにんにくは 1.5 かけ" (test.equal "1.5 かけ" (amountText (Pieces "かけ") (scale 3 (Tenths 10))))

let gramsRounded =
  test.test "グラムは整数に丸める" (test.equal "300 g" (amountText Grams (scale 3 (Tenths 2000))))

let oilForOne =
  test.test "1 人分のオリーブオイルは大さじ 1" (test.equal "大さじ 1" (amountText Tablespoons (scale 1 (Tenths 20))))

let servingsClamped =
  test.test "人数は 1 から 6 に収める" (test.equal (1, 6) (clampServings 0, clampServings 9))

let startsFull = {
  let expected =
    Running (Countdown { label: "スパゲッティをゆでる", total: 480000, remaining: 480000 })
  test.test "8 分のタイマーは 8:00 から始まる" (test.equal expected started)
}

let lastTickFinishes =
  test.test "残り 0.25 秒で 0.25 秒たつと終わる" (test.equal (Finished "にんにくを炒める") (advance 250 lastQuarter))

let throttledMinute =
  test.test "刻みが 1 分あいても、1 分ぶん減る" (test.equal "7:00" (clockText (shownSeconds (advance 60000 started))))

let carriedFraction =
  test.test "ミリ秒に満たない端数は次の刻みへ持ち越す" (test.equal (Elapsed { milliseconds: 251, carry: 0 }) (splitElapsed 600000 250400000))

let pausedStays = {
  let paused = update Pause started
  test.test "一時停止中は時間がたっても進まない" (test.equal paused (advance 60000 paused))
}

fn shownSeconds timer: TimerState -> Int = match timer {
  Running countdown -> secondsLeft countdown
  _ -> 0
}

let extraMinute =
  test.test "+1 分で残りが 9:00 になる" (test.equal "9:00" (clockText (shownSeconds (update AddMinute started))))

let roundedUp =
  test.test "残り 0.25 秒は 0:01 と見せる" (test.equal "0:01" (clockText (shownSeconds lastQuarter)))

let elapsedRange = test.test "経過は始めに 0、終わりに 1000" (
  test.equal (0, 1000)
    (elapsedPermille started, elapsedPermille (advance 250 lastQuarter))
)

let toggledBack =
  test.test "手順は押すたびに済みと未済みを行き来する" (test.equal noneDone (noneDone |> toggleDone 2 |> toggleDone 2))

pub let tests: test.Test = test.suite "kitchen" [
  garlicForThree,
  gramsRounded,
  oilForOne,
  servingsClamped,
  startsFull,
  lastTickFinishes,
  throttledMinute,
  carriedFraction,
  pausedStays,
  extraMinute,
  roundedUp,
  elapsedRange,
  toggledBack,
]
