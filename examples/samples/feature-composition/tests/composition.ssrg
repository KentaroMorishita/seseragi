// `seseragi test` で実行するカード進捗とレイアウト制御の単体テストです。
import * as test from "std/test"
import { Advance, CheckState, Reset, updateCheck } from "self/features/checklist"
import {
  LayoutState,
  ReplaceFirst,
  SwapOrder,
  ToggleFirst,
  initialLayout,
  updateLayout,
} from "self/features/layout"

let cappedCheck =
  CheckState { done: 0, goal: 2 }
  |> updateCheck Advance
  |> updateCheck Advance
  |> updateCheck Advance

let resetCheck = cappedCheck |> updateCheck Reset

let toggledLayout =
  initialLayout
  |> updateLayout ToggleFirst
  |> updateLayout SwapOrder
  |> updateLayout ReplaceFirst

pub let tests: test.Test = test.suite "feature composition" [
  test.test "check progress caps at goal"
    (test.equal (CheckState { done: 2, goal: 2 }) cappedCheck),
  test.test "reset clears completed count while keeping goal"
    (test.equal (CheckState { done: 0, goal: 2 }) resetCheck),
  test.test "layout actions toggle visibility, order, and replacement independently" (
    test.equal (LayoutState { showFirst: False, reversed: True, replaced: True })
    toggledLayout
  ),
]
