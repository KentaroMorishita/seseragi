// 旅行プランナーの状態・スポット・移動時間・割り勘計算を純粋関数でまとめます。
import * as arrays from "std/array"

pub type SpotCategory deriving Eq, Show =
  | Sightseeing
  | Dining
  | Lodging
  | Transit

pub type DayFilter deriving Eq, Show =
  | Day1
  | Day2

pub type ActiveTab deriving Eq, Show =
  | PlanTab
  | BudgetTab
  | ShareTab

pub type SaveState deriving Eq, Show =
  | SaveIdle
  | Saving
  | SaveFailed String
  | Saved String

pub struct Spot deriving Eq, Show {
  id: String,
  day: Int,
  name: String,
  area: String,
  category: SpotCategory,
  stayMinutes: Int,
  costYen: Int,
  latE4: Int,
  lonE4: Int,
  note: String,
}

pub struct SplitSummary deriving Eq, Show, Debug { totalYen: Int, travelers: Int, perPersonYen: Int, remainderYen: Int, }

pub struct TripState {
  activeTab: ActiveTab,
  activeDay: DayFilter,
  spots: Array<Spot>,
  focusedSpotId: String,
  travelers: Int,
  simulateFailure: Bool,
  saveState: SaveState,
}

pub type TripAction =
  | SelectTab ActiveTab
  | SelectDay DayFilter
  | FocusSpot String
  | MoveSpotUp String
  | MoveSpotDown String
  | RemoveSpot String
  | AddPresetSpot String
  | ClearDaySpots
  | ChangeTravelers Int
  | ToggleSimulateFailure Bool
  | StartSave
  | FinishSave (Either<String, String>)
  | ResetTrip

pub fn dayNumber day: DayFilter -> Int = match day {
  Day1 -> 1
  Day2 -> 2
}

pub fn categoryLabel category: SpotCategory -> String = match category {
  Sightseeing -> "観光"
  Dining -> "食事"
  Lodging -> "宿泊"
  Transit -> "移動"
}

fn pad3 n: Int -> String =
  if n < 10 then `00${n}` else if n < 100 then `0${n}` else `${n}`

fn formatCommas amount: Int -> String =
  if amount < 1000 then
    `${amount}`
  else
    `${formatCommas (amount / 1000)},${pad3 (amount % 1000)}`

pub fn formatYen amount: Int -> String = `${formatCommas amount}円`

