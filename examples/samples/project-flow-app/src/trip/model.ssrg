pub fn initialState -> TripState = TripState {
  activeTab: PlanTab,
  activeDay: Day1,
  spots: initialSpots (),
  focusedSpotId: "kiyomizu",
  travelers: 3,
  simulateFailure: False,
  saveState: SaveIdle,
}

pub fn spotsForDay day: DayFilter -> spots: Array<Spot> -> Array<Spot> = {
  let targetDay = dayNumber day
  arrays.filter (\spot: Spot -> spot.day == targetDay) spots
}

fn absDiff a: Int -> b: Int -> Int = if a >= b then a - b else b - a

// 実地の緯度経度差（1/10000 度単位）から概算の移動時間（分）を算出します。
pub fn segmentMinutes fromSpot: Spot -> toSpot: Spot -> Int = {
  let dLatMeters = absDiff fromSpot.latE4 toSpot.latE4 * 11
  let dLonMeters = absDiff fromSpot.lonE4 toSpot.lonE4 * 9
  let raw = (dLatMeters + dLonMeters) / 280 + 7
  if raw < 8 then 8 else raw
}

fn sumTransitHelper spots: Array<Spot> -> idx: Int -> acc: Int -> Int =
  match (arrays.get idx spots, arrays.get (idx + 1) spots) {
    (Just a, Just b) -> sumTransitHelper spots (idx + 1) (acc + segmentMinutes a b)
    _ -> acc
  }

pub fn totalTransitMinutes spots: Array<Spot> -> Int = sumTransitHelper spots 0 0

pub fn totalStayMinutes spots: Array<Spot> -> Int =
  spots
  |> map (\s: Spot -> s.stayMinutes)
  |> sum

pub fn dayTotalMinutes spots: Array<Spot> -> Int =
  totalStayMinutes spots + totalTransitMinutes spots

pub fn totalTripCost spots: Array<Spot> -> Int =
  spots
  |> map (\s: Spot -> s.costYen)
  |> sum

pub fn categoryTotal category: SpotCategory -> spots: Array<Spot> -> Int =
  spots
  |> arrays.filter (\s: Spot -> s.category == category)
  |> map (\s: Spot -> s.costYen)
  |> sum

pub fn calculateSplit totalYen: Int -> travelers: Int -> SplitSummary = {
  let safeTravelers = if travelers < 1 then 1 else travelers
  let perPerson = totalYen / safeTravelers
  let remainder = totalYen - perPerson * safeTravelers
  SplitSummary {
    totalYen,
    travelers: safeTravelers,
    perPersonYen: perPerson,
    remainderYen: remainder,
  }
}

fn findIndexHelper spots: Array<Spot> -> id: String -> idx: Int -> Int =
  match arrays.get idx spots {
    Nothing -> -1
    Just spot -> if spot.id == id then idx else findIndexHelper spots id (idx + 1)
  }

fn swapAdjacent spots: Array<Spot> -> leftIdx: Int -> Array<Spot> = {
  let total = arrays.length spots
  let indices = arrays.fromIterable (0 ..= total - 1)
  let build = \i: Int ->
    if i == leftIdx then
      arrays.get (leftIdx + 1) spots
    else if i == leftIdx + 1 then
      arrays.get leftIdx spots
    else
      arrays.get i spots
  [spot | Just spot <- map build indices]
}

fn reorderWithinDay day: DayFilter
  -> id: String
  -> moveUp: Bool
  -> spots: Array<Spot>
  -> Array<Spot> = {
    let targetDay = dayNumber day
    let daySpots = spotsForDay day spots
    let otherSpots = arrays.filter (\s: Spot -> s.day != targetDay) spots
    let idx = findIndexHelper daySpots id 0
    let reordered = if moveUp && idx > 0 then swapAdjacent daySpots (idx - 1) else if
    ! moveUp
      && idx >= 0
      && idx + 1 < arrays.length daySpots then
      swapAdjacent daySpots idx
    else
      daySpots
    if targetDay == 1 then
      arrays.concat [
        reordered,
        otherSpots
      ]
    else
      arrays.concat [
        otherSpots,
        reordered
      ]
  }

fn hasSpot id: String -> spots: Array<Spot> -> Bool = findIndexHelper spots id 0 >= 0

fn addPresetById id: String -> day: DayFilter -> spots: Array<Spot> -> Array<Spot> =
  if hasSpot id spots then
    spots
  else
    match arrays.find (\s: Spot -> s.id == id) (presetSpots ()) {
      Nothing -> spots
      Just preset -> arrays.append [Spot { ...preset, day: dayNumber day }] spots
    }

pub fn update action: TripAction -> state: TripState -> TripState = match action {
  SelectTab tab -> TripState { ...state, activeTab: tab }
  SelectDay day -> {
    let dayList = spotsForDay day state.spots
    let nextFocus = match arrays.head dayList {
      Just first -> first.id
      Nothing -> ""
    }
    TripState { ...state, activeDay: day, focusedSpotId: nextFocus }
  }
  FocusSpot id -> TripState { ...state, focusedSpotId: id }
  MoveSpotUp id -> TripState {
    ...state,
    spots: reorderWithinDay state.activeDay id True state.spots,
    focusedSpotId: id,
    saveState: SaveIdle,
  }
  MoveSpotDown id -> TripState {
    ...state,
    spots: reorderWithinDay state.activeDay id False state.spots,
    focusedSpotId: id,
    saveState: SaveIdle,
  }
  RemoveSpot id -> {
    let nextSpots = arrays.filter (\s: Spot -> s.id != id) state.spots
    let dayList = spotsForDay state.activeDay nextSpots
    let nextFocus = match arrays.head dayList {
      Just first -> first.id
      Nothing -> ""
    }
    TripState {
      ...state,
      spots: nextSpots,
      focusedSpotId: nextFocus,
      saveState: SaveIdle,
    }
  }
  AddPresetSpot id -> TripState {
    ...state,
    spots: addPresetById id state.activeDay state.spots,
    focusedSpotId: id,
    saveState: SaveIdle,
  }
  ClearDaySpots -> {
    let targetDay = dayNumber state.activeDay
    let nextSpots = arrays.filter (\s: Spot -> s.day != targetDay) state.spots
    TripState { ...state, spots: nextSpots, focusedSpotId: "", saveState: SaveIdle, }
  }
  ChangeTravelers count -> {
    let clamped = if count < 1 then 1 else if count > 6 then 6 else count
    TripState { ...state, travelers: clamped, saveState: SaveIdle }
  }
  ToggleSimulateFailure flag -> TripState { ...state, simulateFailure: flag }
  StartSave -> TripState { ...state, saveState: Saving }
  FinishSave outcome -> match outcome {
    Left msg -> TripState { ...state, saveState: SaveFailed msg }
    Right url -> TripState { ...state, saveState: Saved url }
  }
  ResetTrip -> initialState ()
}
