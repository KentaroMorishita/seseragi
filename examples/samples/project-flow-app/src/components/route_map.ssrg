  }, svg.line {
    x1: 18.0,
    y1: 285.0,
    x2: 18.0 + scaleWidth,
    y2: 285.0,
    stroke: "#5c6d7d",
    strokeWidth: "1.4",
  }, svg.line {
    x1: 18.0,
    y1: 282.0,
    x2: 18.0,
    y2: 286.0,
    stroke: "#5c6d7d",
    strokeWidth: "1.4",
  }, svg.line {
    x1: 18.0 + scaleWidth,
    y1: 282.0,
    x2: 18.0 + scaleWidth,
    y2: 286.0,
    stroke: "#5c6d7d",
    strokeWidth: "1.4",
  }, svg.text {
    x: 22.0 + scaleWidth,
    y: 286.0,
    fill: "#5c6d7d",
    fontSize: "8px",
    fontWeight: "600",
    children: scaleLabel,
  },
]

