fn routeLayer spots: Array<Spot> -> Array<svg.Svg<Task<Unit>>> = {
  let pathData = curvedRoutePath spots
  if pathData == "" then [] else [
    // 白い縁取りで地図要素の上からでもルート線をくっきり見せる
    svg.path {
      d: pathData,
      fill: "none",
      stroke: "#ffffff",
      strokeWidth: "6",
      strokeLinecap: "round",
      strokeLinejoin: "round",
      opacity: 0.85,
    }, svg.path {
      d: pathData,
      fill: "none",
      stroke: "#d65a31",
      strokeWidth: "2.8",
      strokeDasharray: "7 5",
      strokeLinecap: "round",
      strokeLinejoin: "round",
    },
  ]
}

fn pinElements spots: Array<Spot> -> focusedId: String -> Array<svg.Svg<Task<Unit>>> = {
  let count = arrays.length spots
  let indices = indexRange count
  let buildPin = \idx: Int -> match arrays.get idx spots {
    Nothing -> []
    Just spot -> {
      let x = floats.fromInt spot.mapX
      let y = floats.fromInt spot.mapY
      let isFocused = spot.id == focusedId
      let fill = if isFocused then "#d65a31" else "#1c3d5a"
      let radius = if isFocused then 12.0 else 9.5
      let halo: Array<svg.Svg<Task<Unit>>> =
        if isFocused then
          [svg.circle { cx: x, cy: y, r: 18.0, fill: "#d65a31", opacity: 0.18, }]
        else
          []
      let shadow: svg.Svg<Task<Unit>> = svg.circle {
        cx: x,
        cy: y + 2.0,
        r: radius,
        fill: "#1c3d5a",
        opacity: 0.18,
      }
      let outer: svg.Svg<Task<Unit>> = svg.circle {
        cx: x,
        cy: y,
        r: radius,
        fill,
        stroke: "#ffffff",
        strokeWidth: "2.4",
      }
      let num: svg.Svg<Task<Unit>> = svg.text {
        x,
        y: y + 3.5,
        fill: "#ffffff",
        fontSize:
          if isFocused then
            "10.5px"
          else
            "9.5px",
        fontWeight: "700",
        textAnchor: "middle",
        children: `${idx + 1}`,
      }
      arrays.concat [halo, [shadow, outer, num]]
    }
  }
  arrays.concat (map buildPin indices)
}

fn focusedCalloutLayer spots: Array<Spot>
  -> focusedId: String
  -> Array<svg.Svg<Task<Unit>>> =
  match arrays.find (\s: Spot -> s.id == focusedId) spots {
    Nothing -> []
    Just spot -> {
      let x = floats.fromInt spot.mapX
      let y = floats.fromInt spot.mapY
      let calloutY = if spot.mapY < 60 then y + 26.0 else y - 22.0
      let calloutX =
        if spot.mapX > 296 then x - 46.0 else if spot.mapX < 114 then x + 46.0 else x
      [
        svg.rect {
          x: calloutX - 62.0,
          y: calloutY - 10.5,
          width: 124.0,
          height: 19.0,
          rx: 9.5,
          fill: "#1c3d5a",
          stroke: "#ffffff",
          strokeWidth: "1.5",
        },
        svg.text {
          x: calloutX,
          y: calloutY + 2.5,
          fill: "#ffffff",
          fontSize: "8.5px",
          fontWeight: "700",
          textAnchor: "middle",
          children: spot.name,
        },
      ]
    }
  }

fn mapCanvas spots: Array<Spot> -> focusedId: String -> html.Html<Task<Unit>> = {
  let frameBorder: Array<svg.Svg<Task<Unit>>> =
    [svg.rect {
      x: 0.5,
      y: 0.5,
      width: 419.0,
      height: 299.0,
      rx: 12.0,
      fill: "none",
      stroke: "#ddd4c5",
      strokeWidth: "1",
    }]
  svg.toHtml (
    svg.svg {
      viewBox: "0 0 420 300",
      width: 420.0,
      height: 300.0,
      role: "img",
      ariaLabel: "京都・宇治の旅行ルート地図",
      style: html.style {
        display: "block",
        width: "100%",
        height: "auto",
        borderRadius: "12px",
      },
      children: arrays.concat [
        terrainLayer (),
        cartographicLabels (),
        routeLayer spots,
        pinElements spots focusedId,
        focusedCalloutLayer spots focusedId,
        frameBorder,
      ],
    }
  )
}

fn spotJumpChip dispatch: (TripAction -> Task<Unit>)
  -> focusedId: String
  -> idx: Int
  -> spot: Spot
  -> html.Html<Task<Unit>> =
  {
    let isFocused = spot.id == focusedId
    html.button {
      buttonType: "button",
      ariaSelected: isFocused,
      onClick: dispatch (FocusSpot spot.id),
      style: styles.dayChipStyle isFocused,
      children: `${idx + 1}. ${spot.name}`,
    }
  }

fn spotDetailCard spots: Array<Spot> -> focusedId: String -> html.Html<Task<Unit>> =
  match arrays.find (\s: Spot -> s.id == focusedId) spots {
    Nothing -> html.p {
      style: styles.metaStyle (),
      children: "日程にスポットを追加すると、地図上のルートと立ち寄り先のメモが表示されます。",
    }
    Just spot -> {
      let nameNode: html.Html<Task<Unit>> = html.strong {
        style: html.style { color: "#1c3d5a", fontSize: "14px", },
        children: `${spot.name}（${spot.area}）`,
      }
      let badgeNode: html.Html<Task<Unit>> = html.span {
        style: styles.categoryBadgeStyle spot.category,
        children: `${categoryLabel spot.category}・${formatYen spot.costYen}`,
      }
      let headerRow: html.Html<Task<Unit>> = html.div {
        style: html.style {
          display: "flex",
          flexWrap: "wrap",
          alignItems: "center",
          justifyContent: "space-between",
          gap: "8px",
          marginBottom: "6px",
        },
        children: [nameNode, badgeNode],
      }
      let noteNode: html.Html<Task<Unit>> = html.p {
        style: styles.metaStyle (),
        children: `${spot.note}（滞在目安 ${spot.stayMinutes} 分）`,
      }
      html.div {
        style: html.style {
          backgroundColor: "#faf6ef",
          border: "1px solid #e4ddd2",
          borderRadius: "12px",
          padding: "12px 14px",
          marginTop: "12px",
        },
        children: [headerRow, noteNode],
      }
    }
  }

pub fn view dispatch: (TripAction -> Task<Unit>)
  -> state: TripState
  -> html.Html<Task<Unit>> = {
    let daySpots = spotsForDay state.activeDay state.spots
    let count = arrays.length daySpots
    let indices = indexRange count
    let chips: Array<html.Html<Task<Unit>>> = [
      spotJumpChip dispatch state.focusedSpotId idx spot | idx <- indices,
      Just spot <- [arrays.get idx daySpots]
    ]
    let heading: html.Html<Task<Unit>> = html.h2 {
      style: styles.sectionHeadingStyle (),
      children: `${dayNumber state.activeDay}日目のルート地図（${count} スポット）`,
    }
    let chipRow: html.Html<Task<Unit>> = html.div {
      style: html.style {
        display: "flex",
        flexWrap: "wrap",
        gap: "6px",
        marginTop: "12px",
      },
      children: chips,
    }
    html.section {
      style: styles.cardStyle (),
      children: [
        heading,
        mapCanvas daySpots state.focusedSpotId,
        chipRow,
        spotDetailCard daySpots state.focusedSpotId,
      ],
    }
  }
