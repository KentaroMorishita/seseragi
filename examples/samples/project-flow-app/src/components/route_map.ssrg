fn routeLayer viewport: MapViewport
  -> spots: Array<Spot>
  -> Array<svg.Svg<Task<Unit>>> = {
    let pathData = curvedRoutePath viewport spots
    if pathData == "" then
      []
    else
      [
        svg.path {
          d: pathData,
          fill: "none",
          stroke: "#ffffff",
          strokeWidth: "6",
          strokeLinecap: "round",
          strokeLinejoin: "round",
          opacity: 0.88,
        },
        svg.path {
          d: pathData,
          fill: "none",
          stroke: "#d65a31",
          strokeWidth: "2.8",
          strokeDasharray: "7 5",
          strokeLinecap: "round",
          strokeLinejoin: "round",
        },
      ]
  }

fn pinElements viewport: MapViewport
  -> spots: Array<Spot>
  -> focusedId: String
  -> Array<svg.Svg<Task<Unit>>> = {
    let count = arrays.length spots
    let indices = indexRange count
    let buildPin = \idx: Int -> match arrays.get idx spots {
      Nothing -> []
      Just spot -> {
        let pt = projectSpot viewport spot
        let x = floats.fromInt pt.x
        let y = floats.fromInt pt.y
        let isFocused = spot.id == focusedId
        let fill = if isFocused then "#d65a31" else "#1c3d5a"
        let baseRadius = match viewport {
          CentralKyoto -> 9.5
          KyotoUjiWide -> 8.5
        }
        let radius = if isFocused then baseRadius + 2.5 else baseRadius
        let halo: Array<svg.Svg<Task<Unit>>> =
          if isFocused then
            [svg.circle { cx: x, cy: y, r: radius + 6.0, fill: "#d65a31", opacity: 0.2, }]
          else
            []
        let shadow: svg.Svg<Task<Unit>> = svg.circle {
          cx: x,
          cy: y + 2.0,
          r: radius,
          fill: "#1c3d5a",
          opacity: 0.2,
        }
        let outer: svg.Svg<Task<Unit>> = svg.circle {
          cx: x,
          cy: y,
          r: radius,
          fill,
          stroke: "#ffffff",
          strokeWidth: "2.2",
        }
        let num: svg.Svg<Task<Unit>> = svg.text {
          x,
          y: y + 3.5,
          fill: "#ffffff",
          fontSize:
            if isFocused then
              "10px"
            else
              "9px",
          fontWeight: "700",
          textAnchor: "middle",
          children: `${idx + 1}`,
        }
        arrays.concat [halo, [shadow, outer, num]]
      }
    }
    arrays.concat (map buildPin indices)
  }

fn calloutPosition viewport: MapViewport -> spot: Spot -> ProjectedPoint = {
  let pt = projectSpot viewport spot
  let rawX =
    if spot.id == "nishiki" then
      pt.x - 28
    else if spot.id == "gion-inn" then
      pt.x + 42
    else if spot.id == "byodoin" then
      pt.x - 78
    else if spot.id == "uji-matcha" then
      pt.x - 68
    else if pt.x > 310 then
      pt.x - 42
    else if pt.x < 100 then
      pt.x + 44
    else
      pt.x
  let clampedX = if rawX > 338 then 338 else if rawX < 82 then 82 else rawX
  let rawY =
    if spot.id == "nishiki" then
      pt.y + 24
    else if spot.id == "gion-inn" then
      pt.y + 22
    else if spot.id == "byodoin" then
      pt.y - 4
    else if pt.y < 52 then
      pt.y + 24
    else
      pt.y - 22
  let clampedY = if rawY > 282 then 282 else if rawY < 20 then 20 else rawY
  ProjectedPoint { x: clampedX, y: clampedY }
}

fn focusedCalloutLayer viewport: MapViewport
  -> spots: Array<Spot>
  -> focusedId: String
  -> Array<svg.Svg<Task<Unit>>> =
  match arrays.find (\s: Spot -> s.id == focusedId) spots {
    Nothing -> []
    Just spot -> {
      let pos = calloutPosition viewport spot
      let px = floats.fromInt pos.x
      let py = floats.fromInt pos.y
      [
        svg.rect {
          x: px - 74.0,
          y: py - 10.5,
          width: 148.0,
          height: 19.0,
          rx: 9.5,
          fill: "#1c3d5a",
          stroke: "#ffffff",
          strokeWidth: "1.5",
        },
        svg.text {
          x: px,
          y: py + 2.5,
          fill: "#ffffff",
          fontSize: "8.5px",
          fontWeight: "700",
          textAnchor: "middle",
          children: spot.name,
        },
      ]
    }
  }

fn mapCanvas mapAssets: MapAssets
  -> spots: Array<Spot>
  -> focusedId: String
  -> html.Html<Task<Unit>> = {
    let viewport = selectViewport spots
    let baseMapUrl = match viewport {
      CentralKyoto -> mapAssets.centralMapUrl
      KyotoUjiWide -> mapAssets.wideMapUrl
    }
    let basemapImg: html.Html<Task<Unit>> = html.img {
      src: baseMapUrl,
      alt: "",
      style: html.style {
        position: "absolute",
        top: "0",
        left: "0",
        width: "100%",
        height: "100%",
        objectFit: "cover",
        display: "block",
      },
    }
    let overlaySvg: html.Html<Task<Unit>> = svg.toHtml (
      svg.svg {
        viewBox: "0 0 420 300",
        width: 420.0,
        height: 300.0,
        role: "img",
        ariaLabel: "京都・宇治の実測位置に基づく旅行ルート地図",
        style: html.style {
          position: "relative",
          display: "block",
          width: "100%",
          height: "auto",
        },
        children: arrays.concat [
          cartographicLabels viewport,
          routeLayer viewport spots,
          pinElements viewport spots focusedId,
          focusedCalloutLayer viewport spots focusedId,
        ],
      }
    )
    html.div {
      style: html.style {
        position: "relative",
        width: "100%",
        borderRadius: "12px",
        overflow: "hidden",
        border: "1px solid #ddd4c5",
        backgroundColor: "#f5f1e7",
      },
      children: [basemapImg, overlaySvg],
    }
  }

fn spotJumpChip dispatch: (TripAction -> Task<Unit>)
  -> focusedId: String
  -> idx: Int
  -> spot: Spot
  -> html.Html<Task<Unit>> =
  {
    let isFocused = spot.id == focusedId
    html.button {
      buttonType: "button",
      ariaSelected: isFocused,
      onClick: dispatch (FocusSpot spot.id),
      style: styles.dayChipStyle isFocused,
      children: `${idx + 1}. ${spot.name}`,
    }
  }

fn spotDetailCard spots: Array<Spot> -> focusedId: String -> html.Html<Task<Unit>> =
  match arrays.find (\s: Spot -> s.id == focusedId) spots {
    Nothing -> html.p {
      style: styles.metaStyle (),
      children: "日程にスポットを追加すると、地図上のルートと立ち寄り先のメモが表示されます。",
    }
    Just spot -> {
      let nameNode: html.Html<Task<Unit>> = html.strong {
        style: html.style { color: "#1c3d5a", fontSize: "14px", },
        children: `${spot.name}（${spot.area}）`,
      }
      let badgeNode: html.Html<Task<Unit>> = html.span {
        style: styles.categoryBadgeStyle spot.category,
        children: `${categoryLabel spot.category}・${formatYen spot.costYen}`,
      }
      let headerRow: html.Html<Task<Unit>> = html.div {
        style: html.style {
          display: "flex",
          flexWrap: "wrap",
          alignItems: "center",
          justifyContent: "space-between",
          gap: "8px",
          marginBottom: "6px",
        },
        children: [nameNode, badgeNode],
      }
      let noteNode: html.Html<Task<Unit>> = html.p {
        style: styles.metaStyle (),
        children: `${spot.note}（滞在目安 ${spot.stayMinutes} 分）`,
      }
      html.div {
        style: html.style {
          backgroundColor: "#faf6ef",
          border: "1px solid #e4ddd2",
          borderRadius: "12px",
          padding: "12px 14px",
          marginTop: "12px",
        },
        children: [headerRow, noteNode],
      }
    }
  }

pub fn view mapAssets: MapAssets
  -> dispatch: (TripAction -> Task<Unit>)
  -> state: TripState
  -> html.Html<Task<Unit>> = {
    let daySpots = spotsForDay state.activeDay state.spots
    let count = arrays.length daySpots
    let indices = indexRange count
    let chips: Array<html.Html<Task<Unit>>> = [
      spotJumpChip dispatch state.focusedSpotId idx spot | idx <- indices,
      Just spot <- [arrays.get idx daySpots]
    ]
    let heading: html.Html<Task<Unit>> = html.h2 {
      style: styles.sectionHeadingStyle (),
      children: `${dayNumber state.activeDay}日目のルート地図（${count} スポット）`,
    }
    let chipRow: html.Html<Task<Unit>> = html.div {
      style: html.style {
        display: "flex",
        flexWrap: "wrap",
        gap: "6px",
        marginTop: "12px",
      },
      children: chips,
    }
    html.section {
      style: styles.cardStyle (),
      children: [
        heading,
        mapCanvas mapAssets daySpots state.focusedSpotId,
        chipRow,
        spotDetailCard daySpots state.focusedSpotId,
      ],
    }
  }
