// 国土地理院の京都・宇治の実測位置を下敷きに、緯度経度から SVG へ投影するルート地図です。
import * as arrays from "std/array"
import * as floats from "std/float"
import * as html from "std/web/html"
import * as svg from "std/web/svg"
import {
  FocusSpot,
  Spot,
  TripAction,
  TripState,
  categoryLabel,
  dayNumber,
  formatYen,
  spotsForDay,
} from "self/trip/model"
import * as styles from "self/ui/styles"

type MapViewport deriving Eq =
  | CentralKyoto
  | KyotoUjiWide

struct ProjectedPoint { x: Int, y: Int, }

fn indexRange count: Int -> Array<Int> = {
  let empty: Array<Int> = []
  if count <= 0 then empty else arrays.fromIterable (0 ..= count - 1)
}

fn isInCentralKyoto spot: Spot -> Bool =
  spot.latE4 >= 349820
  && spot.latE4 <= 350160
  && spot.lonE4 >= 1357400
  && spot.lonE4 <= 1357980

fn selectViewport spots: Array<Spot> -> MapViewport =
  if arrays.isEmpty spots then
    CentralKyoto
  else if all isInCentralKyoto spots then
    CentralKyoto
  else
    KyotoUjiWide

// 緯度経度（1/10000 度単位）を各ビューポートの正角図法（420x300）へ投影します。
fn projectSpot viewport: MapViewport -> spot: Spot -> ProjectedPoint = match viewport {
  CentralKyoto -> ProjectedPoint {
    x: (spot.lonE4 - 1357375) * 420 / 625,
    y: (350175 - spot.latE4) * 300 / 367,
  }
  KyotoUjiWide -> ProjectedPoint {
    x: (spot.lonE4 - 1356500) * 420 / 2000,
    y: (350250 - spot.latE4) * 300 / 1470,
  }
}

fn curvedSegment fromPt: ProjectedPoint -> toPt: ProjectedPoint -> idx: Int -> String =
  {
    let dx = toPt.x - fromPt.x
    let dy = toPt.y - fromPt.y
    let midX = (fromPt.x + toPt.x) / 2
    let midY = (fromPt.y + toPt.y) / 2
    let bend = if idx % 2 == 0 then 1 else -1
    let ctrlX = midX - (dy * bend) / 9
    let ctrlY = midY + (dx * bend) / 9
    `Q ${ctrlX} ${ctrlY} ${toPt.x} ${toPt.y}`
  }

fn curvedRoutePath viewport: MapViewport -> spots: Array<Spot> -> String =
  match arrays.head spots {
    Nothing -> ""
    Just first -> {
      let start = projectSpot viewport first
      let count = arrays.length spots
      let segIndices = if count <= 1 then [] else indexRange (count - 1)
      let buildSeg = \idx: Int ->
        match (arrays.get idx spots, arrays.get (idx + 1) spots) {
        (Just a, Just b) -> [curvedSegment (projectSpot viewport a)
            (projectSpot viewport b) idx]
        _ -> []
      }
      let segments = arrays.concat (map buildSeg segIndices)
      join " " (arrays.concat [[`M ${start.x} ${start.y}`], segments])
    }
  }

