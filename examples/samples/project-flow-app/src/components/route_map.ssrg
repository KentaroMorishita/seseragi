// 京都・宇治エリアの地形・川・街路・鉄道を描いたガイドブック調 SVG ルート地図です。
import * as arrays from "std/array"
import * as floats from "std/float"
import * as html from "std/web/html"
import * as svg from "std/web/svg"
import {
  FocusSpot,
  Spot,
  TripAction,
  TripState,
  categoryLabel,
  dayNumber,
  formatYen,
  spotsForDay,
} from "self/trip/model"
import * as styles from "self/ui/styles"

fn indexRange count: Int -> Array<Int> = {
  let empty: Array<Int> = []
  if count <= 0 then empty else arrays.fromIterable (0 ..= count - 1)
}

// 隣り合う 2 地点を緩やかな二次ベジェ曲線で結び、直線の交差や角張りを和らげます。
fn curvedSegment fromSpot: Spot -> toSpot: Spot -> idx: Int -> String = {
  let dx = toSpot.mapX - fromSpot.mapX
  let dy = toSpot.mapY - fromSpot.mapY
  let midX = (fromSpot.mapX + toSpot.mapX) / 2
  let midY = (fromSpot.mapY + toSpot.mapY) / 2
  let bend = if idx % 2 == 0 then 1 else -1
  let ctrlX = midX - (dy * bend) / 7
  let ctrlY = midY + (dx * bend) / 7
  `Q ${ctrlX} ${ctrlY} ${toSpot.mapX} ${toSpot.mapY}`
}

fn curvedRoutePath spots: Array<Spot> -> String = match arrays.head spots {
  Nothing -> ""
  Just first -> {
    let count = arrays.length spots
    let segIndices = if count <= 1 then [] else indexRange (count - 1)
    let buildSeg = \idx: Int ->
      match (arrays.get idx spots, arrays.get (idx + 1) spots) {
      (Just a, Just b) -> [curvedSegment a b idx]
      _ -> []
    }
    let segments = arrays.concat (map buildSeg segIndices)
    join " " (arrays.concat [[`M ${first.mapX} ${first.mapY}`], segments])
  }
}

