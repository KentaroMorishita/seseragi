// 旅のしおりアプリのシェル: 3 画面タブ（日程と地図・予算と割り勘・しおり共有）と Signal を束ねます。
import * as arrays from "std/array"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"
import {
  ActiveTab,
  BudgetTab,
  FinishSave,
  PlanTab,
  SelectTab,
  ShareTab,
  StartSave,
  TripAction,
  TripState,
  formatYen,
  initialState,
  totalTripCost,
  update,
} from "self/trip/model"
import * as budget from "self/components/budget"
import * as routeMap from "self/components/route_map"
import * as shareView from "self/components/share_view"
import * as timeline from "self/components/timeline"
import * as styles from "self/ui/styles"

fn dispatch state: MutableSignal<TripState> -> action: TripAction -> Task<Unit> =
  match action {
    StartSave -> do {
      signals.update (update StartSave) state
      current <- *state
      let outcome =
        if current.simulateFailure then
          Left "ネットワークに接続できませんでした。チェックを外して再試行してください。"
        else
          Right `https://trip.example/kyoto-${arrays.length current.spots}s-${current.travelers}p`
      signals.update (update (FinishSave outcome)) state
    }
    _ -> signals.update (update action) state
  }

fn navTab send: (TripAction -> Task<Unit>)
  -> current: ActiveTab
  -> target: ActiveTab
  -> label: String
  -> html.Html<Task<Unit>> =
  html.button {
    buttonType: "button",
    ariaSelected: current == target,
    onClick: send (SelectTab target),
    style: styles.tabButtonStyle (current == target),
    children: label,
  }

fn headerView send: (TripAction -> Task<Unit>)
  -> state: TripState
  -> html.Html<Task<Unit>> = {
    let total = totalTripCost state.spots
    let titleBlock: html.Html<Task<Unit>> = html.div {
      children: [
        html.p { style: styles.eyebrowStyle (), children: "KYOTO & UJI · 1泊2日 旅のしおり", },
        html.h1 { style: styles.titleStyle (), children: "京都・宇治 週末旅行プランナー", },
        html.p {
          style: styles.metaStyle (),
          children: `全 ${arrays.length state.spots} スポット ・ 参加 ${state.travelers} 名 ・ 予算合計 ${formatYen total}`,
        },
      ],
    }
    let tabs: html.Html<Task<Unit>> = html.nav {
      ariaLabel: "画面の切り替え",
      style: styles.tabBarStyle (),
      children: [
        navTab send state.activeTab PlanTab "1. 日程と地図",
        navTab send state.activeTab BudgetTab "2. 予算と割り勘",
        navTab send state.activeTab ShareTab "3. しおり共有",
      ],
    }
    html.header { style: styles.headerStyle (), children: [titleBlock, tabs], }
  }

effect fn parsedUrl value: String -> html.WebUrl fails html.HtmlBuildError =
  fromEither (html.parseWebUrl value)

effect fn parseUrl value: String -> html.WebUrl fails String =
  mapError (\error: html.HtmlBuildError -> show error) (parsedUrl value)

fn bodyView mapAssets: routeMap.MapAssets
  -> send: (TripAction -> Task<Unit>)
  -> state: TripState
  -> html.Html<Task<Unit>> =
  match state.activeTab {
    PlanTab -> html.div {
      style: styles.twoColGridStyle (),
      children: [routeMap.view mapAssets send state, timeline.view send state],
    }
    BudgetTab -> budget.view send state
    ShareTab -> shareView.view send state
  }

fn pageView mapAssets: routeMap.MapAssets
  -> state: MutableSignal<TripState>
  -> current: TripState
  -> html.Html<Task<Unit>> =
  {
    let send = dispatch state
    html.main {
      style: styles.pageStyle (),
      children: html.div {
        style: styles.shellStyle (),
        children: [headerView send current, bodyView mapAssets send current],
      },
    }
  }

pub effect fn create -> Signal<html.Html<Task<Unit>>> fails String = do {
  centralMapUrl <- parseUrl "https://raw.githubusercontent.com/KentaroMorishita/seseragi/main/assets/samples/trip-planner/kyoto-central-map.jpg"
  wideMapUrl <- parseUrl "https://raw.githubusercontent.com/KentaroMorishita/seseragi/main/assets/samples/trip-planner/kyoto-uji-wide-map.jpg"
  let mapAssets = routeMap.MapAssets { centralMapUrl, wideMapUrl }
  let initial: TripState = initialState ()
  state <- signals.make initial
  succeed (signals.map (pageView mapAssets state) state)
}
