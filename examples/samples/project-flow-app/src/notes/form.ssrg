import * as html from "std/web/html"
import { sectionCopy, sectionHeading } from "../ui/components"
import { cx, noteButtonStyle } from "../ui/styles"

let fieldLabelClass = cx [
  "mt-4",
  "block",
  "text-sm",
  "font-semibold",
  "text-slate-700",
]

let fieldClass = cx [
  "mt-2",
  "w-full",
  "rounded-xl",
  "border",
  "border-slate-200",
  "px-3",
  "py-3",
  "text-base",
  "text-slate-900",
]

let submitButtonClass = cx [
  "mt-4",
  "w-full",
  "rounded-xl",
  "border-0",
  "px-4",
  "py-3",
  "font-semibold",
]

let validationClass = cx [
  "mt-2",
  "rounded-xl",
  "bg-slate-100",
  "p-4",
  "text-sm",
  "text-slate-900",
]

fn validationMessage value: String -> html.Html<Task<Unit>> =
  if value == "" then
    html.div { children: "" }
  else
    html.p { role: "alert", class: validationClass, children: value }

fn fieldLabel -> html.Html<Task<Unit>> = html.label {
  htmlFor: "story-draft",
  class: fieldLabelClass,
  children: "Story card title"
}

pub fn view draft: String
  -> validation: String
  -> onDraft: (html.InputEvent -> Task<Unit>)
  -> onSubmit: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.section {
    children: [
      sectionHeading "Capture the next story card.",
      sectionCopy
        "A separate feature owns the form draft, validation, items, and every edit or remove action.",
      html.form {
        onSubmit,
        children: [
          fieldLabel (),
          html.input {
            id: "story-draft",
            name: "story-draft",
            value: draft,
            placeholder: "Name the moment worth sharing",
            inputType: "text",
            onInput: onDraft,
            class: fieldClass
          },
          html.button {
            buttonType: "submit",
            class: submitButtonClass,
            style: noteButtonStyle (),
            children: "Add a story card"
          },
          validationMessage validation
        ]
      }
    ]
  }
