import * as html from "std/web/html"

pub fn view
  draft: String
  -> onDraft: (html.InputEvent -> Effect<{}, Never, Unit>)
  -> onSubmit: Effect<{}, Never, Unit>
  -> html.Html<Effect<{}, Never, Unit>> =
  html.form {
    onSubmit,
    className: "grid grid-cols-[1fr_auto] gap-2",
    children: [
    html.input {
      id: "todo-draft",
      value: draft,
      placeholder: "Add a task",
      onInput: onDraft,
      className: "rounded-lg border border-slate-200 px-3 py-2 text-base"
    },
    html.button {
      buttonType: "submit",
      className: "rounded-lg border-0 bg-slate-900 px-4 py-2 font-semibold text-white",
      children: "Add"
    }
    ]
  }
