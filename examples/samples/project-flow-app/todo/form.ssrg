import * as html from "std/web/html"
import { cx } from "../styles"

let taskInputClass =
  cx [
  "rounded-lg",
  "border",
  "border-slate-200",
  "px-3",
  "py-2",
  "text-base",
  ]

let submitButtonClass =
  cx [
  "rounded-lg",
  "border-0",
  "bg-slate-900",
  "px-4",
  "py-2",
  "font-semibold",
  "text-white",
  ]

pub fn view
  draft: String
  -> onDraft: (html.InputEvent -> Effect<{}, Never, Unit>)
  -> onSubmit: Effect<{}, Never, Unit>
  -> html.Html<Effect<{}, Never, Unit>> =
  html.form {
    onSubmit,
    className: "grid grid-cols-[1fr_auto] gap-2",
    children: [
    html.input {
      id: "todo-draft",
      value: draft,
      placeholder: "Add a task",
      onInput: onDraft,
      className: taskInputClass
    },
    html.button {
      buttonType: "submit",
      className: submitButtonClass,
      children: "Add"
    }
    ]
  }
