// 同じメンバーのレコードから名札と配送先を作り、異動後の情報をスプレッド構文で不変更新します。

// 関数が必要とするフィールドだけを宣言すれば、余分なフィールドを持つレコードも渡せます。
fn badgeLabel member: {
  first: String,
  last: String,
  department: String
} -> String =
  `名札: ${member.last} ${member.first}（${member.department}）`

fn shippingLabel member: {
  first: String,
  last: String,
  city: String
} -> String =
  `配送先: ${member.city} / ${member.last} ${member.first} 様`

let originalMember = {
  first: "ミオ",
  last: "田中",
  department: "開発",
  city: "東京",
  role: "Engineer",
}

// 元のレコードは変えず、異動で変わる部署と拠点だけを上書きした新しいレコードを作ります。
let transferredMember = { ...originalMember, department: "設計", city: "京都", }

pub effect fn main = [
  "異動前:",
  `  ${badgeLabel originalMember}`,
  `  ${shippingLabel originalMember}`,
  "異動後:",
  `  ${badgeLabel transferredMember}`,
  `  ${shippingLabel transferredMember}`,
]
  |> join "\n"
  |> println
