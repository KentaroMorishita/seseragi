fn displayName profile: {
  first: String,
  last: String
} -> String =
  `${profile.first} ${profile.last}`

let profile = { first: "Mio", last: "Tanaka", role: "Engineer" }

// スプレッド構文で新しいレコードを作り、必要なフィールドだけを関数へ渡します。
pub effect fn main -> Unit with Console fails ConsoleError = {
  ...profile,
  first: "Aoi"
}
  |> displayName
  |> println
