fn validateQuantity count: Int -> Either<String, Int> =
  if count > 0 then Right count else Left "quantity must be positive"

fn validateUnitPrice price: Int -> Either<String, Int> =
  if price >= 100 then Right price else Left "unit price is too low"

fn orderTotal count: Int -> price: Int -> Either<String, Int> = do {
  validCount <- validateQuantity count
  validPrice <- validateUnitPrice price
  pure (validCount * validPrice)
}

fn renderOrder label: String -> result: Either<String, Int> -> String = match result {
  Left reason -> `${label}: rejected (${reason})`
  Right total -> `${label}: ${total} yen`
}

// 途中でLeftになると後続の計算はスキップされ、最初の失敗理由がそのまま返ります。
pub effect fn main -> Unit with Console fails ConsoleError = do {
  println (renderOrder "valid" (orderTotal 3 1200))
  println (renderOrder "invalid" (orderTotal 0 1200))
}
