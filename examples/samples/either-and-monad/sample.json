{
  "$schema": "../sample.schema.json",
  "id": "either-and-monad",
  "title": "会員登録の入力チェック",
  "summary": "同じ入力チェックを、最初の失敗で止まる Either と、すべての失敗を集める Validation で比べます。",
  "kind": "recipe",
  "difficulty": "intermediate",
  "topics": [
    "Either",
    "Validation",
    "Applicative",
    "do"
  ],
  "capabilities": [
    "console"
  ],
  "outputMode": "text",
  "prerequisites": [
    "expression-calculator"
  ],
  "featured": false,
  "files": {
    "source": "main.ssrg",
    "guide": "guide.md",
    "expectedOutput": "stdout.txt"
  },
  "guidance": {
    "autoRun": true,
    "tryNext": [
      {
        "label": "名前だけ先に直す",
        "edits": [
          {
            "find": "let brokenForm = SignupForm {\n  name: \"\",",
            "replace": "let brokenForm = SignupForm {\n  name: \"Mio\","
          }
        ]
      },
      {
        "label": "メールアドレスも直す",
        "edits": [
          {
            "find": "  email: \"mio-at-example\",",
            "replace": "  email: \"mio@example.com\","
          }
        ]
      }
    ]
  }
}
