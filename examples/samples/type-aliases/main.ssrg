import * as signals from "std/signal"
import { MutableSignal } from "std/signal"

alias UserId = Int
alias Pair<A> = { left: A, right: A }

fn userPath id: UserId -> String = `/users/${id}`

fn routePair before: UserId -> after: UserId -> Pair<String> = {
  left: userPath before,
  right: userPath after
}

fn advanceUser state: MutableSignal<UserId> -> Task<Unit> =
  signals.update (\id: UserId -> id + 1) state

pub effect fn main -> Unit with Console fails ConsoleError = do {
  state <- signals.make 41
  before <- *state
  advanceUser state
  after <- *state
  let routes = routePair before after
  println `${routes.left} -> ${routes.right}`
}
