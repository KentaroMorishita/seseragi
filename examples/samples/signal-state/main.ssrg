// 複数の Signal から導出状態を作り、transaction で在庫と販売数を一度に更新します。
import * as signals from "std/signal"

fn formatInventory remaining: Int -> sold: Int -> String =
  `在庫 ${remaining} 袋 / 販売済み ${sold} 袋（累計 ${remaining + sold} 袋）`

pub effect fn main = do {
  stock <- signals.make 12
  sold <- signals.make 0
  let summary = signals.combine formatInventory stock sold

  opening <- *summary

  // transaction は複数の更新をまとめて確定し、途中の不整合な状態を見せません。
  let orderBags = 3
  signals.transaction [
    signals.planUpdate (\n: Int -> n - orderBags) stock,
    signals.planUpdate (\n: Int -> n + orderBags) sold,
  ]
  afterMorning <- *summary

  let restockBags = 6
  signals.transaction [
    signals.planUpdate (\n: Int -> n + restockBags) stock,
    signals.planUpdate (\n: Int -> n + 2) sold,
  ]
  afterAfternoon <- *summary

  [
    `開店時:   ${opening}`,
    `午前の後: ${afterMorning}`,
    `午後の後: ${afterAfternoon}`,
  ]
    |> join "\n"
    |> println
}
