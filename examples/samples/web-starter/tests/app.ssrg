// `seseragi test` で実行するテストです。画面を使わない update を確かめます。
import * as test from "std/test"
import { Increment, StarterState, update } from "self/app"

let next = update Increment (StarterState { count: 0 })

pub let tests: test.Test =
  test.suite "counter" [test.test "Increment adds one" (test.equal 1 next.count)]
