import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"

// The page state. Add fields here as the app grows.
pub struct StarterState { pub count: Int, }

pub type StarterAction =
  | Increment

pub fn update action: StarterAction -> state: StarterState -> StarterState =
  match action {
    Increment -> StarterState { ...state, count: state.count + 1 }
  }

fn dispatch state: MutableSignal<StarterState> -> action: StarterAction -> Task<Unit> =
  signals.update (update action) state

// Named styles keep the view readable. Change the colors to make it yours.
fn pageStyle -> html.Style = html.style {
  background: "linear-gradient(180deg, #e7f4f2 0%, #f6f8f7 55%)",
  color: "#10201d",
  display: "grid",
  fontFamily: "system-ui, -apple-system, \"Segoe UI\", sans-serif",
  minHeight: "100vh",
  placeItems: "center",
  padding: "24px"
}

fn cardStyle -> html.Style = html.style {
  background: "#ffffff",
  boxSizing: "border-box",
  border: "1px solid #d9e6e3",
  borderRadius: "24px",
  boxShadow: "0 24px 60px -32px #0f3d3866",
  maxWidth: "460px",
  padding: "36px 32px",
  width: "100%"
}

fn eyebrowStyle -> html.Style = html.style {
  color: "#0f766e",
  fontSize: "12px",
  fontWeight: "700",
  letterSpacing: "0.14em",
  margin: "0"
}

fn headingStyle -> html.Style = html.style {
  fontSize: "32px",
  fontWeight: "800",
  letterSpacing: "-0.02em",
  margin: "8px 0 0"
}

fn countStyle -> html.Style = html.style {
  fontSize: "44px",
  fontVariantNumeric: "tabular-nums",
  fontWeight: "800",
  margin: "24px 0 0"
}

fn buttonStyle -> html.Style = html.style {
  background: "#0f766e",
  border: "0",
  borderRadius: "999px",
  color: "#ffffff",
  cursor: "pointer",
  font: "inherit",
  fontWeight: "700",
  marginTop: "20px",
  padding: "12px 22px"
}

fn hintStyle -> html.Style = html.style {
  color: "#5b6b67",
  fontSize: "14px",
  lineHeight: "1.6",
  margin: "20px 0 0"
}

fn view state: MutableSignal<StarterState> -> current: StarterState
  -> html.Html<Task<Unit>> = {
    let parts: Array<html.Html<Task<Unit>>> = [
      html.p { style: eyebrowStyle (), children: "SESERAGI WEB STARTER" },
      html.h1 { style: headingStyle (), children: "Hello from Seseragi" },
      html.p { style: countStyle (), children: `Count: ${current.count}` },
      html.button {
        buttonType: "button",
        onClick: dispatch state Increment,
        style: buttonStyle (),
        children: "Count one more"
      },
      html.p {
        style: hintStyle (),
        children: "Edit src/app.ssrg and save. Run seseragi test to check update."
      }
    ]
    html.main {
      style: pageStyle (),
      children: html.section { style: cardStyle (), children: parts }
    }
  }

pub effect fn create -> Signal<html.Html<Task<Unit>>> fails Never = do {
  state <- signals.make (StarterState { count: 0 })
  succeed (signals.map (view state) state)
}
