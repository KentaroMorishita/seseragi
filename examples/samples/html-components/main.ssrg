import * as html from "std/web/html"

type Action =
  | OpenProfile

// Styleは値として再利用でき、variablesはCSS custom propertyになります。
let cardStyle =
  html.style {
    variables: { cardShadow: "0 4px 16px #0002" },
    backgroundColor: "#fff",
    boxShadow: "var(--card-shadow)",
    borderRadius: "16px",
    padding: "24px"
  }

// 通常のpure関数を、そのままHTML componentとして使えます。
fn card title: String -> detail: String -> html.Html<Action> =
  html.article {
    className: "mx-auto max-w-xl",
    style: cardStyle,
    children: [
      html.header {
        children: html.h2 {
          style: html.style { color: "#185f50", marginTop: "0" },
          children: title
        }
      },
      html.p {
        style: html.style { color: "#315c53", marginBottom: "0" },
        children: [
          html.strong { children: "Typed document surface" },
          html.br {},
          html.em { children: detail }
        ]
      },
      html.ul {
        children: [
          html.li { children: "sectioning tags" },
          html.li { children: "text semantics" },
          html.li { children: "ordered children" }
        ]
      },
      html.footer { children: html.small { children: "Rendered by Seseragi" } }
    ]
  }

fn page -> html.Html<Action> =
  html.main {
    id: "app",
    className: "min-h-screen bg-emerald-50 p-8 sm:p-12",
    children: [
      html.header {
        children: [
          html.h1 {
            onClick: OpenProfile,
            className: "mx-auto mb-6 max-w-xl text-3xl font-bold text-emerald-950",
            children: "Seseragi components"
          },
          html.nav {
            children: html.ol {
              children: [html.li { children: "Document components" }]
            }
          }
        ]
      },
      html.hr {},
      card "Reusable card" "Function component from children"
    ]
  }

pub effect fn main = println $ html.renderToString (page ())
