// 100 番目のフィボナッチ数を、桁あふれせずに正確に求めます。
import { BigInt } from "std/big-int"
import * as bigints from "std/big-int"
import * as text from "std/text"

// 直前の 2 つの数だけを持って進む。関数の中の関数が、最後に自分を呼ぶ（末尾再帰）
fn fibonacci n: Int -> BigInt = {
  fn step remaining: Int -> current: BigInt -> next: BigInt -> BigInt =
    if remaining == 0 then current else step (remaining - 1) next (current + next)

  step n (bigints.fromInt 0) (bigints.fromInt 1)
}

fn describe n: Int -> String = {
  let digits = bigints.format (fibonacci n)
  `${n} 番目: ${digits}（${text.lengthScalars digits} 桁）`
}

pub effect fn main = [10, 50, 100] |> map describe |> join "\n" |> println
