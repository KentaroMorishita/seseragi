import * as html from "std/web/html"
import { codePanel } from "./code-panel"
import * as styles from "../../ui/styles"

fn tabStyle selected: Bool -> html.Style =
  match selected {
    True -> html.style {
      background: "linear-gradient(135deg, #bdf6d8, #67dca4)",
      backgroundColor: "#8de7bf",
      border: "1px solid transparent",
      borderRadius: "999px",
      color: "#06251a",
      cursor: "pointer",
      fontSize: "13px",
      fontWeight: "850",
      padding: "12px 18px"
    }
    False -> html.style {
      backgroundColor: "transparent",
      border: "1px solid rgba(255, 255, 255, 0.12)",
      borderRadius: "999px",
      color: "#a8beb5",
      cursor: "pointer",
      fontSize: "13px",
      fontWeight: "700",
      padding: "12px 18px"
    }
  }

fn chapterEyebrow -> html.Html<Task<Unit>> =
  html.p { style: styles.eyebrowStyle (), children: "Three ways to see it" }

fn tab label: String -> selected: Bool -> action: Task<Unit> -> html.Html<Task<Unit>> =
  html.button { onClick: action, style: tabStyle selected, children: label }

fn tabs readableSelected: Bool
  -> composableSelected: Bool
  -> aliveSelected: Bool
  -> showReadable: Task<Unit>
  -> showComposable: Task<Unit>
  -> showAlive: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.div {
    style: html.style { display: "flex", flexWrap: "wrap", gap: "9px", marginTop: "26px" },
    children: [
      tab "Readable" readableSelected showReadable,
      tab "Composable" composableSelected showComposable,
      tab "Alive" aliveSelected showAlive
    ]
  }

fn accentLine accent: String -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      backgroundColor: accent,
      borderRadius: "999px",
      height: "3px",
      marginTop: "46px",
      width: "52px"
    },
    children: ""
  }

fn chapterTitle title: String -> html.Html<Task<Unit>> =
  html.h2 {
    style: html.style {
      color: "#f4fff9",
      fontSize: "clamp(30px, 6vw, 54px)",
      fontWeight: "610",
      letterSpacing: "-0.05em",
      lineHeight: "1.04",
      marginBottom: "0",
      marginTop: "22px"
    },
    children: title
  }

fn chapterBody body: String -> html.Html<Task<Unit>> =
  html.p { style: styles.mutedTextStyle (), children: body }

fn chapterText title: String
  -> body: String
  -> accent: String
  -> readableSelected: Bool
  -> composableSelected: Bool
  -> aliveSelected: Bool
  -> showReadable: Task<Unit>
  -> showComposable: Task<Unit>
  -> showAlive: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.div {
    children: [
      chapterEyebrow (),
      tabs readableSelected composableSelected aliveSelected showReadable showComposable showAlive,
      accentLine accent,
      chapterTitle title,
      chapterBody body
    ]
  }

fn chapterLayout key: String
  -> title: String
  -> body: String
  -> accent: String
  -> readableSelected: Bool
  -> composableSelected: Bool
  -> aliveSelected: Bool
  -> showReadable: Task<Unit>
  -> showComposable: Task<Unit>
  -> showAlive: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      display: "grid",
      gap: "clamp(40px, 7vw, 76px)",
      gridTemplateColumns: "repeat(auto-fit, minmax(min(100%, 400px), 1fr))",
      marginLeft: "auto",
      marginRight: "auto",
      maxWidth: "1180px",
      width: "calc(100% - 32px)"
    },
    children: [
      chapterText title body accent readableSelected composableSelected aliveSelected showReadable
      showComposable showAlive,
      codePanel key
    ]
  }

pub fn view key: String
  -> title: String
  -> body: String
  -> accent: String
  -> readableSelected: Bool
  -> composableSelected: Bool
  -> aliveSelected: Bool
  -> showReadable: Task<Unit>
  -> showComposable: Task<Unit>
  -> showAlive: Task<Unit>
  -> html.Html<Task<Unit>> =
  html.section {
    style: html.style { paddingBottom: "clamp(70px, 9vw, 110px)", paddingTop: "clamp(70px, 9vw, 110px)" },
    children: chapterLayout key title body accent readableSelected composableSelected aliveSelected
    showReadable showComposable showAlive
  }
