// 言語設計の 3 つの柱を、ゆとりのある縦の区切りで並べるセクションです。
import * as html from "std/web/html"
import * as styles from "../ui/styles"

fn principle index: Int
  -> number: String
  -> title: String
  -> body: String
  -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      borderTop: "1px solid rgba(255, 255, 255, 0.12)",
      paddingBottom: "34px",
      paddingTop: "34px",
    },
    children: html.div {
      style: html.style {
        display: "grid",
        gap: "16px",
        gridTemplateColumns: "56px minmax(0, 1fr)",
      },
      children: [
        html.span {
          style: html.style {
            color: styles.principleAccent index,
            fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, monospace",
            fontSize: "12px",
            fontWeight: "800",
            letterSpacing: "0.14em",
            paddingTop: "6px",
          },
          children: number,
        },
        html.div {
          children: [
            html.h3 {
              style: html.style {
                color: "#effaf5",
                fontSize: "clamp(21px, 3.4vw, 30px)",
                fontWeight: "650",
                letterSpacing: "-0.02em",
                lineHeight: "1.2",
                margin: "0",
              },
              children: title,
            },
            html.p {
              style: html.style {
                color: "#92aaa0",
                fontSize: "15px",
                lineHeight: "1.75",
                marginBottom: "0",
                marginTop: "10px",
                maxWidth: "660px",
              },
              children: body,
            },
          ],
        },
      ],
    },
  }

pub fn principles -> html.Html<Task<Unit>> = html.section {
  style: html.style {
    backgroundColor: "#040b09",
    borderBottom: "1px solid rgba(255, 255, 255, 0.06)",
    paddingBottom: "clamp(60px, 8vw, 104px)",
    paddingTop: "clamp(60px, 8vw, 104px)",
  },
  children: html.div {
    style: styles.containerStyle (),
    children: [
      html.p {
        style: styles.eyebrowStyle (),
        children: "Why Seseragi feels different",
      },
      html.h2 { style: styles.sectionTitleStyle (), children: "抽象化しても、読めるまま。", },
      html.div {
        style: html.style { marginTop: "44px", },
        children: [
          principle 1 "01" "読み進められる" "型、エラー、処理の流れを別々の場所へ散らさず、上から自然に読み進められる。",
          principle 2 "02" "組み合わせられる" "型、Signal、Effect、UI。それぞれを孤立させず、普通の値と関数としてつないでいく。",
          principle 3 "03" "アプリまで届く" "言語の見た目だけで終わらず、CLI、Playground、Web UI まで同じ設計の延長にある。",
        ],
      },
    ],
  },
}
