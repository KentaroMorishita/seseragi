// ページ上部のブランドロゴと主要ナビゲーションです。
import * as html from "std/web/html"
import * as styles from "../ui/styles"

fn navLink label: String -> href: html.WebUrl -> html.Html<Task<Unit>> = html.a {
  href,
  target: "_blank",
  rel: "noopener noreferrer",
  style: styles.navLinkStyle (),
  children: label,
}

fn logoImage logoUrl: html.WebUrl -> html.Html<Task<Unit>> = html.img {
  src: logoUrl,
  alt: "Seseragi",
  width: 200,
  height: 60,
  loading: "eager",
  style: html.style { height: "auto", width: "clamp(132px, 26vw, 178px)", },
}

fn logo logoUrl: html.WebUrl -> playgroundUrl: html.WebUrl -> html.Html<Task<Unit>> =
  html.a {
    href: playgroundUrl,
    target: "_blank",
    rel: "noopener noreferrer",
    style: html.style { alignItems: "center", display: "flex", textDecoration: "none", },
    children: logoImage logoUrl,
  }

fn navigation playgroundUrl: html.WebUrl
  -> tourUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> html.Html<Task<Unit>> =
  html.nav {
    ariaLabel: "主要リンク",
    style: html.style {
      alignItems: "center",
      display: "flex",
      flexWrap: "wrap",
      gap: "clamp(12px, 3vw, 26px)",
    },
    children: [
      navLink "Playground" playgroundUrl,
      navLink "Tour" tourUrl,
      navLink "GitHub" repositoryUrl,
    ],
  }

pub fn header logoUrl: html.WebUrl
  -> playgroundUrl: html.WebUrl
  -> tourUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> html.Html<Task<Unit>> =
  html.header {
    style: html.style {
      left: "0",
      position: "absolute",
      right: "0",
      top: "0",
      zIndex: "10",
    },
    children: html.div {
      style: html.style {
        alignItems: "center",
        display: "flex",
        flexWrap: "wrap",
        gap: "12px",
        justifyContent: "space-between",
        marginLeft: "auto",
        marginRight: "auto",
        maxWidth: "1180px",
        paddingBottom: "20px",
        paddingTop: "20px",
        width: "calc(100% - 32px)",
      },
      children: [
        logo logoUrl playgroundUrl,
        navigation playgroundUrl tourUrl repositoryUrl,
      ],
    },
  }
