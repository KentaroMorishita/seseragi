// 川の写真と短い宣言文で、後半へ視線を切り替える全幅セクションです。
import * as html from "std/web/html"
import * as styles from "../ui/styles"

fn riverImage riverImageUrl: html.WebUrl -> html.Html<Task<Unit>> = html.img {
  src: riverImageUrl,
  alt: "深い森の中を流れる静かな川",
  width: 2000,
  height: 1200,
  loading: "lazy",
  style: html.style { height: "100%", objectFit: "cover", width: "100%", },
}

fn imageOverlay -> html.Html<Task<Unit>> = html.div {
  style: html.style {
    background: "linear-gradient(90deg, rgba(2, 12, 9, 0.93) 0%, rgba(2, 12, 9, 0.62) 58%, rgba(2, 12, 9, 0.2) 100%)",
    bottom: "0",
    left: "0",
    position: "absolute",
    right: "0",
    top: "0",
  },
  children: "",
}

pub fn imageStatement riverImageUrl: html.WebUrl -> html.Html<Task<Unit>> =
  html.section {
    style: html.style {
      height: "clamp(420px, 60vw, 660px)",
      overflow: "hidden",
      position: "relative",
    },
    children: [
      riverImage riverImageUrl,
      imageOverlay (),
      html.div {
        style: html.style {
          alignItems: "center",
          bottom: "0",
          display: "flex",
          left: "0",
          position: "absolute",
          right: "0",
          top: "0",
        },
        children: html.div {
          style: styles.containerStyle (),
          children: [
            html.p {
              style: styles.eyebrowStyle (),
              children: "Not just another language",
            },
            html.blockquote {
              style: html.style {
                color: "#f1fff8",
                fontSize: "clamp(28px, 5.2vw, 56px)",
                fontWeight: "600",
                letterSpacing: "-0.02em",
                lineHeight: "1.12",
                marginBottom: "0",
                marginLeft: "0",
                marginRight: "0",
                marginTop: "20px",
                maxWidth: "820px",
              },
              children: "複雑なアプリを、美しいまま書く。",
            },
            html.p {
              style: html.style {
                color: "#c0d6cc",
                fontSize: "clamp(15px, 1.8vw, 17px)",
                lineHeight: "1.78",
                marginBottom: "0",
                marginTop: "20px",
                maxWidth: "560px",
              },
              children: "理想論ではなく、実際に動くコードとして形になり始めています。型と流れがそのままアプリの土台になる——そこが Seseragi の核です。",
            },
          ],
        },
      },
    ],
  }
