// ファーストビュー: 言語を一文で伝え、Playground と同じ配色の本物のコードと行動リンクを並べます。
import * as html from "std/web/html"
import * as svg from "std/web/svg"
import { header } from "./header"
import { heroCodeCard } from "./chapter/code-panel"
import * as styles from "../ui/styles"

fn heroArtwork -> html.Html<Task<Unit>> = svg.svg {
  viewBox: "0 0 1200 800",
  role: "img",
  ariaLabel: "流れる緑の光",
  style: html.style {
    display: "block",
    height: "100%",
    left: "0",
    position: "absolute",
    top: "0",
    width: "100%",
  },
  children: [
    svg.rect { x: 0.0, y: 0.0, width: 1200.0, height: 800.0, fill: "#04120e" },
    svg.circle { cx: 240.0, cy: 180.0, r: 280.0, fill: "#0d3b2e", opacity: 0.55 },
    svg.circle { cx: 980.0, cy: 260.0, r: 320.0, fill: "#0f4c45", opacity: 0.45 },
    svg.path {
      d: "M 0 460 C 260 360, 520 540, 840 420 C 1000 360, 1110 400, 1200 370 L 1200 800 L 0 800 Z",
      fill: "#06211a",
    },
    svg.path {
      d: "M 0 560 C 300 470, 560 630, 880 510 C 1030 455, 1130 490, 1200 470",
      fill: "none",
      stroke: "#2dd4bf",
      strokeWidth: "2.5",
      opacity: 0.4,
    },
    svg.path {
      d: "M 0 620 C 280 540, 560 680, 900 575 C 1040 532, 1130 560, 1200 545",
      fill: "none",
      stroke: "#8ee6bc",
      strokeWidth: "2.0",
      opacity: 0.3,
    },
  ],
}
  |> svg.toHtml

fn heroOverlay -> html.Html<Task<Unit>> = html.div {
  style: html.style {
    background: "linear-gradient(180deg, rgba(3, 13, 10, 0.34) 0%, rgba(3, 13, 10, 0.68) 45%, rgba(4, 11, 9, 0.96) 100%), linear-gradient(90deg, rgba(3, 13, 10, 0.84) 0%, rgba(3, 13, 10, 0.52) 55%, rgba(3, 13, 10, 0.28) 100%)",
    bottom: "0",
    left: "0",
    position: "absolute",
    right: "0",
    top: "0",
  },
  children: "",
}

fn heroTitle -> html.Html<Task<Unit>> = html.h1 {
  style: html.style {
    color: "#f8fffb",
    fontSize: "clamp(42px, 7.2vw, 84px)",
    fontWeight: "650",
    letterSpacing: "-0.03em",
    lineHeight: "0.98",
    marginBottom: "0",
    marginTop: "18px",
  },
  children: [
    html.span { style: html.style { display: "block", }, children: "Code that", },
    html.span {
      style: html.style { color: "#8ee6bc", display: "block", marginTop: "8px", },
      children: "keeps flowing.",
    },
  ],
}

fn heroCopy -> html.Html<Task<Unit>> = html.p {
  style: html.style {
    color: "#d3e1dc",
    fontSize: "clamp(15px, 2vw, 18px)",
    lineHeight: "1.78",
    marginBottom: "0",
    marginTop: "24px",
    maxWidth: "540px",
  },
  children: "Seseragi は、型・失敗・副作用・Web UI をひとつの読みやすい流れとして書けるプログラミング言語です。",
}

fn heroActions playgroundUrl: html.WebUrl
  -> tourUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> html.Html<Task<Unit>> =
  html.div {
    style: html.style {
      display: "flex",
      flexWrap: "wrap",
      gap: "10px",
      marginTop: "28px",
    },
    children: [
      html.a {
        href: playgroundUrl,
        target: "_blank",
        rel: "noopener noreferrer",
        style: styles.primaryLinkStyle (),
        children: "Playgroundで試す ↗",
      },
      html.a {
        href: tourUrl,
        target: "_blank",
        rel: "noopener noreferrer",
        style: styles.secondaryLinkStyle (),
        children: "Tourで学ぶ →",
      },
      html.a {
        href: repositoryUrl,
        target: "_blank",
        rel: "noopener noreferrer",
        style: styles.secondaryLinkStyle (),
        children: "GitHubを見る →",
      },
    ],
  }

fn heroLead playgroundUrl: html.WebUrl
  -> tourUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> html.Html<Task<Unit>> = {
    let eyebrow: html.Html<Task<Unit>> = html.p {
      style: styles.eyebrowStyle (),
      children: "A programming language in motion",
    }
    html.div {
      children: [
        eyebrow,
        heroTitle (),
        heroCopy (),
        heroActions playgroundUrl tourUrl repositoryUrl,
      ],
    }
  }

pub fn hero playgroundUrl: html.WebUrl
  -> tourUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> html.Html<Task<Unit>> =
  html.section {
    style: html.style { minHeight: "100vh", overflow: "hidden", position: "relative", },
    children: [
      heroArtwork (),
      heroOverlay (),
      header playgroundUrl tourUrl repositoryUrl,
      html.div {
        style: html.style {
          alignItems: "center",
          display: "flex",
          minHeight: "100vh",
          position: "relative",
          zIndex: "1",
        },
        children: html.div {
          style: html.style {
            alignItems: "center",
            display: "grid",
            gap: "clamp(28px, 5vw, 56px)",
            gridTemplateColumns: "repeat(auto-fit, minmax(min(100%, 340px), 1fr))",
            marginLeft: "auto",
            marginRight: "auto",
            maxWidth: "1180px",
            paddingBottom: "clamp(56px, 8vw, 96px)",
            paddingTop: "clamp(108px, 14vw, 148px)",
            width: "calc(100% - 32px)",
          },
          children: [heroLead playgroundUrl tourUrl repositoryUrl, heroCodeCard ()],
        },
      },
    ],
  }
