// 最後に Playground・Tour・GitHub への導線をまとめる締めくくりセクションです。
import * as html from "std/web/html"
import * as styles from "../ui/styles"

pub fn closing playgroundUrl: html.WebUrl -> tourUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl -> html.Html<Task<Unit>> =
  html.section {
    style: html.style {
      background: "radial-gradient(circle at 50% 100%, rgba(70, 216, 147, 0.2), rgba(70, 216, 147, 0) 48%)",
      paddingBottom: "clamp(64px, 8vw, 104px)",
      paddingTop: "clamp(64px, 8vw, 104px)",
      textAlign: "center",
    },
    children: html.div {
      style: styles.containerStyle (),
      children: [
        html.p { style: styles.eyebrowStyle (), children: "See the language move", },
        html.h2 {
          style: html.style {
            color: "#f5fff9",
            fontSize: "clamp(32px, 6vw, 62px)",
            fontWeight: "620",
            letterSpacing: "-0.025em",
            lineHeight: "1.08",
            marginBottom: "0",
            marginLeft: "auto",
            marginRight: "auto",
            marginTop: "18px",
            maxWidth: "820px",
          },
          children: "まずは、触ってみて。",
        },
        html.p {
          style: html.style {
            color: "#9eb6ac",
            fontSize: "16px",
            lineHeight: "1.78",
            marginBottom: "0",
            marginLeft: "auto",
            marginRight: "auto",
            marginTop: "20px",
            maxWidth: "540px",
          },
          children: "スマートフォンでもパソコンでも、Playground を開いた瞬間から Seseragi を書いて実行できます。",
        },
        html.div {
          style: html.style {
            display: "flex",
            flexWrap: "wrap",
            gap: "12px",
            justifyContent: "center",
            marginTop: "30px",
          },
          children: [
            html.a {
              href: playgroundUrl,
              target: "_blank",
              rel: "noopener noreferrer",
              style: styles.primaryLinkStyle (),
              children: "Open Playground ↗",
            },
            html.a {
              href: tourUrl,
              target: "_blank",
              rel: "noopener noreferrer",
              style: styles.secondaryLinkStyle (),
              children: "Start Tour →",
            },
            html.a {
              href: repositoryUrl,
              target: "_blank",
              rel: "noopener noreferrer",
              style: styles.secondaryLinkStyle (),
              children: "Read the source →",
            },
          ],
        },
      ],
    },
  }
