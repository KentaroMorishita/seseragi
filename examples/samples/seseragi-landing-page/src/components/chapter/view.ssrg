// Three ways to see it: タブ切り替えとシンタックスハイライト付きコードパネルを描画します。
import * as html from "std/web/html"
import { codePanel } from "./code-panel"
import * as styles from "../../ui/styles"

pub type Chapter deriving Eq =
  | Readable
  | Composable
  | Alive

fn chapterKey chapter: Chapter -> String = match chapter {
  Readable -> "readable"
  Composable -> "composable"
  Alive -> "alive"
}

fn chapterTitle chapter: Chapter -> String = match chapter {
  Readable -> "読めることは、機能である。"
  Composable -> "別々の力を、ひとつの流れへ。"
  Alive -> "言語は、動いた瞬間に生き始める。"
}

fn chapterBody chapter: Chapter -> String = match chapter {
  Readable -> "Seseragi のコードは、短くするために情報を消しません。型とエラーの流れを、上から読める位置へ置き直します。"
  Composable -> "型、Signal、Effect、UI を別々の世界に閉じ込めず、同じ言語の値と関数として組み合わせていきます。"
  Alive -> "Playground で書いて、実行して、Web UI まで触れる。仕様の中だけではなく、手元まで届く言語です。"
}

fn chapterTab dispatch: (Chapter -> Task<Unit>)
  -> current: Chapter
  -> target: Chapter
  -> label: String
  -> html.Html<Task<Unit>> =
  {
    let isSelected = current == target
    html.button {
      ariaSelected: isSelected,
      buttonType: "button",
      onClick: dispatch target,
      style: styles.tabStyle isSelected,
      children: label,
    }
  }

fn tabs dispatch: (Chapter -> Task<Unit>) -> current: Chapter -> html.Html<Task<Unit>> =
  html.div {
    role: "tablist",
    ariaLabel: "Seseragi の特徴を切り替える",
    style: html.style {
      display: "flex",
      flexWrap: "wrap",
      gap: "9px",
      marginTop: "24px",
    },
    children: [
      chapterTab dispatch current Readable "Readable",
      chapterTab dispatch current Composable "Composable",
      chapterTab dispatch current Alive "Alive",
    ],
  }

fn accentLine accent: String -> html.Html<Task<Unit>> = html.div {
  style: html.style {
    backgroundColor: accent,
    borderRadius: "999px",
    height: "3px",
    marginTop: "36px",
    width: "48px",
  },
  children: "",
}

fn chapterHeading title: String -> html.Html<Task<Unit>> = html.h2 {
  style: styles.sectionTitleStyle (),
  children: title,
}

fn chapterText dispatch: (Chapter -> Task<Unit>)
  -> current: Chapter
  -> html.Html<Task<Unit>> = {
    let key = chapterKey current
    let eyebrow: html.Html<Task<Unit>> = html.p {
      style: styles.eyebrowStyle (),
      children: "Three ways to see it",
    }
    let bodyNode: html.Html<Task<Unit>> = html.p {
      style: styles.mutedTextStyle (),
      children: chapterBody current,
    }
    html.div {
      children: [
        eyebrow,
        tabs dispatch current,
        accentLine (styles.chapterAccent key),
        chapterHeading (chapterTitle current),
        bodyNode,
      ],
    }
  }

pub fn view dispatch: (Chapter -> Task<Unit>)
  -> current: Chapter
  -> html.Html<Task<Unit>> =
  html.section {
    style: html.style {
      paddingBottom: "clamp(64px, 8vw, 108px)",
      paddingTop: "clamp(64px, 8vw, 108px)",
    },
    children: html.div {
      style: html.style {
        alignItems: "center",
        display: "grid",
        gap: "clamp(32px, 6vw, 68px)",
        gridTemplateColumns: "repeat(auto-fit, minmax(min(100%, 340px), 1fr))",
        marginLeft: "auto",
        marginRight: "auto",
        maxWidth: "1180px",
        width: "calc(100% - 32px)",
      },
      children: [chapterText dispatch current, codePanel (chapterKey current)],
    },
  }
