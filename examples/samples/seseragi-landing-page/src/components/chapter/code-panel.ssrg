// Playground と同じトークン配色で Seseragi コードを描画するパネルです。
import * as html from "std/web/html"
import * as styles from "../../ui/styles"

type TokenKind =
  | Kw
  | Ty
  | StdTy
  | Op
  | Str
  | Cmt
  | Punc
  | Plain

struct Token { kind: TokenKind, text: String, }

struct CodeLine { number: String, tokens: Array<Token>, }

fn kw text: String -> Token = Token { kind: Kw, text }

fn ty text: String -> Token = Token { kind: Ty, text }

fn stdTy text: String -> Token = Token { kind: StdTy, text }

fn op text: String -> Token = Token { kind: Op, text }

fn str text: String -> Token = Token { kind: Str, text }

fn cmt text: String -> Token = Token { kind: Cmt, text }

fn punc text: String -> Token = Token { kind: Punc, text }

fn plain text: String -> Token = Token { kind: Plain, text }

fn line number: String -> tokens: Array<Token> -> CodeLine = CodeLine { number, tokens }

fn tokenStyle kind: TokenKind -> html.Style = match kind {
  Kw -> styles.synKeywordStyle ()
  Ty -> styles.synTypeStyle ()
  StdTy -> styles.synStandardTypeStyle ()
  Op -> styles.synOperatorStyle ()
  Str -> styles.synStringStyle ()
  Cmt -> styles.synCommentStyle ()
  Punc -> styles.synPunctStyle ()
  Plain -> styles.synPlainStyle ()
}

fn renderToken token: Token -> html.Html<Task<Unit>> = html.span {
  style: tokenStyle token.kind,
  children: token.text,
}

fn renderLine entry: CodeLine -> html.Html<Task<Unit>> = {
  let numNode: html.Html<Task<Unit>> = html.span {
    ariaHidden: True,
    style: styles.lineNumberStyle (),
    children: entry.number,
  }
  let textNode: html.Html<Task<Unit>> = html.span {
    style: styles.codeLineTextStyle (),
    children: map renderToken entry.tokens,
  }
  html.div { style: styles.codeLineRowStyle (), children: [numNode, textNode], }
}

fn heroLines -> Array<CodeLine> = [
  line "01" [cmt "// 型・失敗・流れを、そのまま上から読む"],
  line "02" [
    kw "type",
    plain " ",
    ty "OrderError",
    plain " ",
    op "=",
    plain " ",
    ty "OutOfStock",
    plain " ",
    stdTy "String"
  ],
  line "03" [],
  line "04" [
    kw "pub",
    plain " ",
    kw "effect",
    plain " ",
    kw "fn",
    plain " checkout id",
    punc ":",
    plain " ",
    ty "OrderId",
    plain " ",
    op "="
  ],
  line "05" [plain "  ", kw "do", plain " ", punc "{"],
  line "06" [plain "    item ", op "<-", plain " Inventory.reserve id"],
  line "07" [plain "      ", op "|>", plain " mapError ", ty "OutOfStock"],
  line "08" [
    plain "    succeed ",
    punc "{",
    plain " item",
    punc ",",
    plain " status",
    punc ":",
    plain " ",
    str "\"confirmed\"",
    plain " ",
    punc "}"
  ],
  line "09" [plain "  ", punc "}"],
]

