fn composableLines -> Array<CodeLine> = [
  line "01" [
    kw "fn",
    plain " pair",
    punc "<",
    ty "F",
    punc "<",
    op "_",
    punc ">,",
    plain " ",
    ty "A",
    punc ",",
    plain " ",
    ty "B",
    punc ">"
  ],
  line "02" [plain "  left", punc ":", plain " ", ty "F", punc "<", ty "A", punc ">"],
  line "03" [
    plain "  ",
    op "->",
    plain " right",
    punc ":",
    plain " ",
    ty "F",
    punc "<",
    ty "B",
    punc ">"
  ],
  line "04" [
    plain "  ",
    op "->",
    plain " ",
    ty "F",
    punc "<(",
    ty "A",
    punc ",",
    plain " ",
    ty "B",
    punc ")>"
  ],
  line "05" [
    kw "where",
    plain " ",
    ty "Applicative",
    punc "<",
    ty "F",
    punc ">",
    plain " ",
    op "="
  ],
  line "06" [
    plain "  ",
    punc "(",
    op "\\",
    plain "a ",
    op "->",
    plain " ",
    op "\\",
    plain "b ",
    op "->",
    plain " ",
    punc "(",
    plain "a",
    punc ",",
    plain " b",
    punc "))"
  ],
  line "07" [plain "    ", op "<$>", plain " left"],
  line "08" [plain "    ", op "<*>", plain " right"],
]

fn aliveLines -> Array<CodeLine> = [
  line "01" [kw "type", plain " ", ty "Mode", plain " ", op "="],
  line "02" [plain "  ", op "|", plain " ", ty "Ready"],
  line "03" [plain "  ", op "|", plain " ", ty "Running"],
  line "04" [],
  line "05" [kw "fn", plain " view mode", punc ":", plain " ", ty "Mode"],
  line "06" [
    plain "  ",
    op "->",
    plain " html",
    punc ".",
    stdTy "Html",
    punc "<",
    ty "Action",
    punc ">",
    plain " ",
    op "="
  ],
  line "07" [plain "  html", punc ".", plain "main ", punc "{"],
  line "08" [
    plain "    children",
    punc ":",
    plain " html",
    punc ".",
    plain "h1 ",
    punc "{"
  ],
  line "09" [plain "      children", punc ":", plain " label mode"],
  line "10" [plain "    ", punc "}"],
  line "11" [plain "  ", punc "}"],
  line "12" [],
  line "13" [
    plain "mode ",
    op "<-",
    plain " signals",
    punc ".",
    plain "make ",
    ty "Ready"
  ],
  line "14" [
    kw "let",
    plain " content ",
    op "=",
    plain " signals",
    punc ".",
    plain "map view mode"
  ],
]

fn snippetLines key: String -> Array<CodeLine> =
  if key == "readable" then
    readableLines ()
  else if key == "composable" then
    composableLines ()
  else
    aliveLines ()

fn chapterLabel key: String -> String =
  if key == "readable" then
    "Readable · explicit failure flow"
  else if key == "composable" then
    "Composable · values stay generic"
  else
    "Alive · Signal reaches the DOM"

fn chapterFooterTag key: String -> String =
  if key == "readable" then
    "ADT · do · mapError"
  else if key == "composable" then
    "Generics · Applicative · <$> / <*>"
  else
    "Signal · std/web/html · dom.run"

fn trafficDot color: String -> html.Html<Task<Unit>> = html.span {
  style: html.style {
    backgroundColor: color,
    borderRadius: "999px",
    height: "9px",
    width: "9px",
  },
  children: "",
}

fn trafficLights -> html.Html<Task<Unit>> = html.div {
  style: html.style { display: "flex", gap: "7px", },
  children: [trafficDot "#ff725f", trafficDot "#e8bd58", trafficDot "#66d38e"],
}

fn panelLabel accent: String -> label: String -> html.Html<Task<Unit>> = html.span {
  style: html.style {
    color: accent,
    fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, monospace",
    fontSize: "11px",
    fontWeight: "750",
  },
  children: label,
}

fn codeWindow accent: String
  -> label: String
  -> fileHint: String
  -> surfaceTag: String
  -> lines: Array<CodeLine>
  -> html.Html<Task<Unit>> = {
    let headerNode: html.Html<Task<Unit>> = html.div {
      style: styles.codePanelHeaderStyle (),
      children: [trafficLights (), panelLabel accent label],
    }
    let preNode: html.Html<Task<Unit>> = html.pre {
      style: styles.codeContentStyle (),
      children: map renderLine lines,
    }
    let hintNode: html.Html<Task<Unit>> = html.span { children: fileHint }
    let tagNode: html.Html<Task<Unit>> = html.span { children: surfaceTag }
    let footerNode: html.Html<Task<Unit>> = html.div {
      style: styles.codePanelFooterStyle (),
      children: [hintNode, tagNode],
    }
    html.div {
      style: styles.codePanelStyle (),
      children: [headerNode, preNode, footerNode],
    }
  }

pub fn heroCodeCard -> html.Html<Task<Unit>> =
  codeWindow "#8de7bf" "checkout.ssrg · Seseragi" "Type-checked · Zero null" "Effect · Pipeline" (heroLines ())

pub fn codePanel key: String -> html.Html<Task<Unit>> =
  codeWindow (styles.chapterAccent key) (chapterLabel key) `${key}.ssrg` (chapterFooterTag key) (snippetLines key)
