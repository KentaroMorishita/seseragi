// コード紹介セクションの状態（Readable / Composable / Alive）を Signal で管理します。
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal, Signal } from "std/signal"
import { Chapter, Readable, view as chapterView } from "./view"

fn selectChapter state: MutableSignal<Chapter> -> next: Chapter -> Task<Unit> =
  signals.update (\_: Chapter -> next) state

fn render state: MutableSignal<Chapter> -> current: Chapter -> html.Html<Task<Unit>> =
  chapterView (selectChapter state) current

pub effect fn create -> Signal<html.Html<Task<Unit>>> fails Never = do {
  let initial: Chapter = Readable
  state <- signals.make initial
  succeed (signals.map (render state) state)
}
