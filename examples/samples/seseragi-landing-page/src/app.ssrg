// ページ全体の URL 準備とセクション合成を担います。
import * as html from "std/web/html"
import * as signals from "std/signal"
import { Signal } from "std/signal"
import { parseUrl } from "./url"
import { create as createChapter } from "./components/chapter/model"
import { hero } from "./components/hero"
import { principles } from "./components/principles"
import { imageStatement } from "./components/image-statement"
import { closing } from "./components/closing"
import { footer } from "./components/footer"
import * as styles from "./ui/styles"

fn page playgroundUrl: html.WebUrl -> tourUrl: html.WebUrl -> repositoryUrl: html.WebUrl
  -> chapter: html.Html<Task<Unit>> -> html.Html<Task<Unit>> =
  html.main {
    style: styles.pageStyle (),
    children: [
      hero playgroundUrl tourUrl repositoryUrl,
      principles (),
      chapter,
      imageStatement (),
      closing playgroundUrl tourUrl repositoryUrl,
      footer repositoryUrl,
    ],
  }

pub effect fn create -> Signal<html.Html<Task<Unit>>> fails String = do {
  playgroundUrl <- parseUrl "https://seseragi.vercel.app/"
  tourUrl <- parseUrl "https://seseragi.vercel.app/tour/"
  repositoryUrl <- parseUrl "https://github.com/KentaroMorishita/seseragi"
  chapter <- createChapter ()
  succeed (signals.map (page playgroundUrl tourUrl repositoryUrl) chapter)
}
