import * as dom from "std/web/dom"
import * as html from "std/web/html"
import * as signals from "std/signal"
import { MutableSignal } from "std/signal"

type Chapter =
  | Readable
  | Composable
  | Alive

type Action =
  | ShowReadable
  | ShowComposable
  | ShowAlive

fn update action: Action -> chapter: Chapter -> Chapter =
  match action {
    ShowReadable -> Readable
    ShowComposable -> Composable
    ShowAlive -> Alive
  }

