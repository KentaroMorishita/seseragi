  -> accent: String
  -> title: String
  -> body: String
  -> html.Html<Action> =
  html.div {
    style: html.style {
      borderTop: "1px solid rgba(255, 255, 255, 0.12)",
      paddingBottom: "38px",
      paddingTop: "38px"
    },
    children: html.div {
      style: html.style {
        display: "grid",
        gap: "18px",
        gridTemplateColumns: "64px minmax(0, 1fr)"
      },
      children: [
        html.span {
          style: html.style {
            color: accent,
            fontSize: "12px",
            fontWeight: "900",
            letterSpacing: "0.15em",
            paddingTop: "6px"
          },
          children: number
        },

        html.div {
          children: [
            html.h3 {
              style: html.style {
                color: "#effaf5",
                fontSize: "clamp(23px, 3.8vw, 32px)",
                fontWeight: "650",
                letterSpacing: "-0.04em",
                lineHeight: "1.15",
                margin: "0"
              },
              children: title
            },

            html.p {
              style: html.style {
                color: "#92aaa0",
                fontSize: "15px",
                lineHeight: "1.75",
                marginBottom: "0",
                marginTop: "12px",
                maxWidth: "680px"
              },
              children: body
            }
          ]
        }
      ]
    }
  }

fn principles -> html.Html<Action> =
  html.section {
    style: html.style {
      backgroundColor: "#040b09",
      borderBottom: "1px solid rgba(255, 255, 255, 0.06)",
      paddingBottom: "clamp(64px, 9vw, 110px)",
      paddingTop: "clamp(64px, 9vw, 110px)"
    },
    children: html.div {
      style: containerStyle,
      children: [
        html.p {
          style: eyebrowStyle,
          children: "Why Seseragi feels different"
        },

        html.h2 {
          style: sectionTitleStyle,
          children:
          "抽象化しても、読めるまま。"
        },

        html.div {
          style: html.style {
            marginTop: "52px"
          },
          children: [
            principle
              "01"
              "#72e4ad"
              "読み進められる"
              "型、エラー、処理の流れを別々の場所へ散らさず、上から自然に読み進められる。",

            principle
              "02"
              "#74c7e9"
              "組み合わせられる"
              "型、Signal、Effect、UI。それぞれを孤立させず、普通の値と関数としてつないでいく。",

            principle
              "03"
              "#dab984"
              "アプリまで届く"
              "言語の見た目だけで終わらず、CLI、Playground、Web UIまで同じ設計の延長にある。"
          ]
        }
      ]
    }
  }

fn isReadable chapter: Chapter -> Bool =
  match chapter {
    Readable -> True
    Composable -> False
    Alive -> False
  }

fn isComposable chapter: Chapter -> Bool =
  match chapter {
    Readable -> False
    Composable -> True
    Alive -> False
  }

fn isAlive chapter: Chapter -> Bool =
  match chapter {
    Readable -> False
    Composable -> False
    Alive -> True
  }

fn tabStyle selected: Bool -> html.Style =
  match selected {
    True ->
    html.style {
      background: "linear-gradient(135deg, #bdf6d8, #67dca4)",
      border: "1px solid transparent",
      borderRadius: "999px",
      color: "#06251a",
      cursor: "pointer",
      fontSize: "13px",
      fontWeight: "850",
      padding: "12px 18px"
    }

    False ->
    html.style {
      backgroundColor: "transparent",
      border: "1px solid rgba(255, 255, 255, 0.12)",
      borderRadius: "999px",
      color: "#a8beb5",
      cursor: "pointer",
      fontSize: "13px",
      fontWeight: "700",
      padding: "12px 18px"
    }
  }

fn chapterTitle chapter: Chapter -> String =
  match chapter {
    Readable ->
    "読めることは、機能である。"

    Composable ->
    "別々の力を、ひとつの流れへ。"

    Alive ->
    "言語は、動いた瞬間に生き始める。"
  }

fn chapterBody chapter: Chapter -> String =
  match chapter {
    Readable ->
    "Seseragiのコードは、短くするために情報を消しません。必要な情報を、読める位置へ置き直します。"

    Composable ->
    "型、Signal、Effect、UIを別々の世界に閉じ込めず、同じ言語の値と関数として組み合わせていきます。"

    Alive ->
    "Playgroundで書いて、実行して、Web UIまで触れる。仕様の中だけではなく、ユーザーの手元まで届く言語です。"
  }

fn chapterAccent chapter: Chapter -> String =
  match chapter {
    Readable -> "#79e0ab"
    Composable -> "#7ec8ed"
    Alive -> "#e0bc7c"
  }

fn codeLine number: String
  -> indent: String
  -> content: html.Html<Action>
  -> html.Html<Action> =
  html.div {
    style: html.style {
      display: "grid",
      gridTemplateColumns: "28px minmax(0, 1fr)"
    },
    children: [
      html.span {
        style: html.style {
          color: "#4f655d",
          paddingRight: "10px",
          textAlign: "right"
        },
        children: number
      },

      html.div {
        style: html.style {
          minWidth: "0",
          paddingLeft: indent,
          whiteSpace: "nowrap"
        },
        children: content
      }
    ]
  }

fn codeSpacer -> html.Html<Action> =
  html.div {
    style: html.style {
      height: "13px"
    },
    children: ""
  }

fn readableCode -> html.Html<Action> =
  html.div {
    style: codeContentStyle,
    children: [
      codeLine "1" "0px" $ html.code {
        children: [
          token syntaxKeyword "type ",
          token syntaxType "AppError ",
          token syntaxOperator "="
        ]
      },

      codeLine "2" "14px" $ html.code {
        children: [
          token syntaxOperator "| ",
          token syntaxType "RepoFailed ",
          token syntaxType "RepoError"
        ]
      },

      codeLine "3" "14px" $ html.code {
        children: [
          token syntaxOperator "| ",
          token syntaxType "ClockFailed ",
          token syntaxType "ClockError"
        ]
      },

      codeSpacer (),

      codeLine "5" "0px" $ html.code {
        children: [
          token syntaxKeyword "pub effect fn ",
          token syntaxFunction "report",
          token syntaxName " id",
          token syntaxPunctuation ": ",
          token syntaxType "UserId ",
          token syntaxOperator "="
        ]
      },

      codeLine "6" "14px" $ html.code {
        children: [
          token syntaxKeyword "do ",
          token syntaxPunctuation "{"
        ]
      },

      codeLine "7" "28px" $ html.code {
        children: [
          token syntaxName "user ",
          token syntaxOperator "<- ",
          token syntaxFunction "UserRepo.find ",
          token syntaxName "id"
        ]
      },

      codeLine "8" "42px" $ html.code {
        children: [
          token syntaxOperator "|> ",
          token syntaxFunction "mapError ",
          token syntaxType "AppError.RepoFailed"
        ]
      },

      codeSpacer (),

      codeLine "10" "28px" $ html.code {
        children: [
          token syntaxName "now ",
          token syntaxOperator "<- ",
          token syntaxFunction "Clock.now"
        ]
      },

      codeLine "11" "42px" $ html.code {
        children: [
          token syntaxOperator "|> ",
          token syntaxFunction "mapError ",
          token syntaxType "AppError.ClockFailed"
        ]
      },

      codeSpacer (),

      codeLine "13" "28px" $ html.code {
        children: [
          token syntaxFunction "succeed ",
          token syntaxPunctuation "{ ",
          token syntaxName "user",
          token syntaxPunctuation ", ",
          token syntaxName "now",
          token syntaxPunctuation " }"
        ]
      },

      codeLine "14" "14px" $ html.code {
        children:
        token syntaxPunctuation "}"
      }
    ]
  }

fn composableCode -> html.Html<Action> =
  html.div {
    style: codeContentStyle,
    children: [
      codeLine "1" "0px" $ html.code {
        children: [
          token syntaxKeyword "fn ",
          token syntaxFunction "pair",
          token syntaxPunctuation "<",
          token syntaxType "F<_>",
          token syntaxPunctuation ", ",
          token syntaxType "A",
          token syntaxPunctuation ", ",
          token syntaxType "B",
          token syntaxPunctuation ">"
        ]
      },

      codeLine "2" "14px" $ html.code {
        children: [
          token syntaxName "left",
          token syntaxPunctuation ": ",
          token syntaxType "F<A>"
        ]
      },

      codeLine "3" "14px" $ html.code {
        children: [
          token syntaxOperator "-> ",
          token syntaxName "right",
          token syntaxPunctuation ": ",
          token syntaxType "F<B>"
        ]
      },

      codeLine "4" "14px" $ html.code {
        children: [
          token syntaxOperator "-> ",
          token syntaxType "F<(A, B)>"
        ]
      },

      codeLine "5" "0px" $ html.code {
        children: [
          token syntaxKeyword "where ",
          token syntaxType "Applicative<F> ",
          token syntaxOperator "="
        ]
      },

      codeLine "6" "14px" $ html.code {
        children: [
          token syntaxPunctuation "(\\",
          token syntaxName "a ",
          token syntaxOperator "-> ",
          token syntaxPunctuation "\\",
          token syntaxName "b ",
          token syntaxOperator "-> ",
          token syntaxPunctuation "(",
          token syntaxName "a",
          token syntaxPunctuation ", ",
          token syntaxName "b",
          token syntaxPunctuation "))"
        ]
      },

      codeLine "7" "28px" $ html.code {
        children: [
          token syntaxOperator "<$> ",
          token syntaxName "left"
        ]
      },

      codeLine "8" "28px" $ html.code {
        children: [
          token syntaxOperator "<*> ",
          token syntaxName "right"
        ]
      }
    ]
  }

fn aliveCode -> html.Html<Action> =
  html.div {
    style: codeContentStyle,
    children: [
      codeLine "1" "0px" $ html.code {
        children: [
          token syntaxKeyword "type ",
          token syntaxType "Mode ",
          token syntaxOperator "="
        ]
      },

      codeLine "2" "14px" $ html.code {
        children: [
          token syntaxOperator "| ",
          token syntaxType "Ready"
        ]
      },

      codeLine "3" "14px" $ html.code {
        children: [
          token syntaxOperator "| ",
          token syntaxType "Running"
        ]
      },

      codeSpacer (),

      codeLine "5" "0px" $ html.code {
        children: [
          token syntaxKeyword "fn ",
          token syntaxFunction "view",
          token syntaxName " mode",
          token syntaxPunctuation ": ",
          token syntaxType "Mode"
        ]
      },

      codeLine "6" "14px" $ html.code {
        children: [
          token syntaxOperator "-> ",
          token syntaxType "html.Html<Action> ",
          token syntaxOperator "="
        ]
      },

      codeLine "7" "14px" $ html.code {
        children: [
          token syntaxFunction "html.main ",
          token syntaxPunctuation "{"
        ]
      },

      codeLine "8" "28px" $ html.code {
        children: [
          token syntaxName "children",
          token syntaxOperator ": ",
          token syntaxFunction "html.h1 ",
          token syntaxPunctuation "{"
        ]
      },

      codeLine "9" "42px" $ html.code {
        children: [
          token syntaxName "children",
          token syntaxOperator ": ",
          token syntaxFunction "label ",
          token syntaxName "mode"
        ]
      },

      codeLine "10" "28px" $ html.code {
        children:
        token syntaxPunctuation "}"
      },

      codeLine "11" "14px" $ html.code {
        children:
        token syntaxPunctuation "}"
      },

      codeSpacer (),

      codeLine "13" "0px" $ html.code {
        children: [
          token syntaxName "mode ",
          token syntaxOperator "<- ",
          token syntaxFunction "signals.make ",
          token syntaxType "Ready"
        ]
      },

      codeLine "14" "0px" $ html.code {
        children: [
          token syntaxKeyword "let ",
          token syntaxName "content ",
          token syntaxOperator "="
        ]
      },

      codeLine "15" "14px" $ html.code {
        children: [
          token syntaxFunction "signals.map ",
          token syntaxFunction "view ",
          token syntaxName "mode"
        ]
      }
    ]
  }

fn chapterCode chapter: Chapter -> html.Html<Action> =
  match chapter {
    Readable -> readableCode ()
    Composable -> composableCode ()
    Alive -> aliveCode ()
  }

fn chapterSection chapter: Chapter -> html.Html<Action> =
  html.section {
    style: html.style {
      paddingBottom: "clamp(70px, 9vw, 110px)",
      paddingTop: "clamp(70px, 9vw, 110px)"
    },
    children: html.div {
      style: html.style {
        display: "grid",
        gap: "clamp(40px, 7vw, 76px)",
        gridTemplateColumns: "repeat(auto-fit, minmax(min(100%, 400px), 1fr))",
        marginLeft: "auto",
        marginRight: "auto",
        maxWidth: "1180px",
        width: "calc(100% - 32px)"
      },
      children: [
        html.div {
          children: [
            html.p {
              style: eyebrowStyle,
              children: "Three ways to see it"
            },

            html.div {
              style: html.style {
                display: "flex",
                flexWrap: "wrap",
                gap: "9px",
                marginTop: "26px"
              },
              children: [
                html.button {
                  onClick: ShowReadable,
                  style: tabStyle (isReadable chapter),
                  children: "Readable"
                },

                html.button {
                  onClick: ShowComposable,
                  style: tabStyle (isComposable chapter),
                  children: "Composable"
                },

                html.button {
                  onClick: ShowAlive,
                  style: tabStyle (isAlive chapter),
                  children: "Alive"
                }
              ]
            },

            html.div {
              style: html.style {
                backgroundColor: chapterAccent chapter,
                borderRadius: "999px",
                height: "3px",
                marginTop: "46px",
                width: "52px"
              },
              children: ""
            },

            html.h2 {
              style: html.style {
                color: "#f4fff9",
                fontSize: "clamp(30px, 6vw, 54px)",
                fontWeight: "610",
                letterSpacing: "-0.05em",
                lineHeight: "1.04",
                marginBottom: "0",
                marginTop: "22px"
              },
              children:
              chapterTitle chapter
            },

            html.p {
              style: mutedTextStyle,
              children:
              chapterBody chapter
            }
          ]
        },

        html.div {
          style: codePanelStyle,
          children: [
            html.div {
              style: html.style {
                alignItems: "center",
                borderBottom: "1px solid rgba(255, 255, 255, 0.08)",
                display: "flex",
                justifyContent: "space-between",
                padding: "15px 18px"
              },
              children: [
                html.div {
                  style: html.style {
                    display: "flex",
                    gap: "7px"
                  },
                  children: [
                    html.span {
                      style: html.style {
                        backgroundColor: "#ff725f",
                        borderRadius: "999px",
                        height: "9px",
                        width: "9px"
                      },
                      children: ""
                    },

                    html.span {
                      style: html.style {
                        backgroundColor: "#e8bd58",
                        borderRadius: "999px",
                        height: "9px",
                        width: "9px"
                      },
                      children: ""
                    },

                    html.span {
                      style: html.style {
                        backgroundColor: "#66d38e",
                        borderRadius: "999px",
                        height: "9px",
                        width: "9px"
                      },
                      children: ""
                    }
                  ]
                },

                html.span {
                  style: html.style {
                    color: "#71877e",
                    fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, monospace",
                    fontSize: "11px"
                  },
                  children: "main.ssrg"
                }
              ]
            },

            chapterCode chapter
          ]
        }
      ]
    }
  }

