  html.style {
    background: "#040b09",
    color: "#edf7f3",
    fontFamily: "Inter, Avenir, Helvetica Neue, Helvetica, Arial, sans-serif",
    margin: "0",
    minHeight: "100vh",
    overflowX: "hidden"
  }

