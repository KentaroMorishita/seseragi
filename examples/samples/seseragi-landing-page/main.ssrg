  }

let syntaxKeyword =
  html.style {
    color: "#d58cff",
    fontWeight: "700"
  }

let syntaxType =
  html.style {
    color: "#efb866"
  }

let syntaxFunction =
  html.style {
    color: "#7dd3fc"
  }

let syntaxOperator =
  html.style {
    color: "#67d5ff"
  }

let syntaxString =
  html.style {
    color: "#98df83"
  }

let syntaxNumber =
  html.style {
    color: "#c7d7ff"
  }

let syntaxName =
  html.style {
    color: "#d7f7e7"
  }

let syntaxPunctuation =
  html.style {
    color: "#91aaa0"
  }

fn token style: html.Style
  -> value: String
  -> html.Html<Action> =
  html.span {
    style,
    children: value
  }

fn navLink label: String
  -> href: html.WebUrl
  -> html.Html<Action> =
  html.a {
    href,
    target: "_blank",
    rel: "noopener noreferrer",
    style: html.style {
      color: "#d8e9e2",
      fontSize: "13px",
      fontWeight: "650",
      textDecoration: "none"
    },
    children: label
  }

fn header logoUrl: html.WebUrl
  -> playgroundUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> html.Html<Action> =
  html.header {
    style: html.style {
      left: "0",
      position: "absolute",
      right: "0",
      top: "0",
      zIndex: "10"
    },
    children: html.div {
      style: html.style {
        alignItems: "center",
        display: "flex",
        justifyContent: "space-between",
        marginLeft: "auto",
        marginRight: "auto",
        maxWidth: "1180px",
        paddingBottom: "22px",
        paddingTop: "22px",
        width: "calc(100% - 32px)"
      },
      children: [
        html.a {
          href: playgroundUrl,
          target: "_blank",
          rel: "noopener noreferrer",
          style: html.style {
            alignItems: "center",
            display: "flex",
            textDecoration: "none"
          },
          children: html.img {
            src: logoUrl,
            alt: "Seseragi",
            width: 200,
            height: 60,
            loading: "eager",
            style: html.style {
              height: "auto",
              width: "clamp(150px, 30vw, 190px)"
            }
          }
        },

        html.nav {
          style: html.style {
            alignItems: "center",
            display: "flex",
            gap: "clamp(14px, 4vw, 30px)"
          },
          children: [
            navLink "Playground" playgroundUrl,
            navLink "GitHub" repositoryUrl
          ]
        }
      ]
    }
  }

