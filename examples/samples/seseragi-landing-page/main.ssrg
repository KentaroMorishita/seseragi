fn view logoUrl: html.WebUrl
  -> heroImageUrl: html.WebUrl
  -> riverImageUrl: html.WebUrl
  -> playgroundUrl: html.WebUrl
  -> repositoryUrl: html.WebUrl
  -> chapter: Chapter
  -> html.Html<Action> =
  html.main {
    style: pageStyle,
    children: [
      hero logoUrl heroImageUrl playgroundUrl repositoryUrl,
      principles (),
      chapterSection chapter,
      imageStatement riverImageUrl,
      closing playgroundUrl repositoryUrl,
      footer logoUrl repositoryUrl
    ]
  }

effect fn parsedUrl value: String -> html.WebUrl
fails html.HtmlBuildError =
  fromEither (html.parseWebUrl value)

effect fn parseUrl value: String -> html.WebUrl
fails String =
  mapError (\error: html.HtmlBuildError -> show error) (parsedUrl value)

fn handle state: MutableSignal<Chapter>
  -> action: Action
  -> Task<Unit> =
  signals.update (update action) state

pub effect fn main -> Unit
with dom: dom.Dom
fails String =
  do {
    logoUrl <-
      parseUrl "https://raw.githubusercontent.com/KentaroMorishita/seseragi/main/assets/brand/source/seseragi-logo-dark.svg"

    heroImageUrl <-
      parseUrl "https://images.unsplash.com/photo-1760344594784-60ff14035eb0?auto=format&fit=crop&w=1800&q=88"

    riverImageUrl <-
      parseUrl "https://images.unsplash.com/photo-1769795070373-aa9021325c86?auto=format&fit=crop&w=2000&q=86"

    playgroundUrl <-
      parseUrl "https://seseragi.vercel.app/"

    repositoryUrl <-
      parseUrl "https://github.com/KentaroMorishita/seseragi"

    state <- signals.make Readable
    let content = signals.map (view logoUrl heroImageUrl riverImageUrl playgroundUrl repositoryUrl) state
    let options = dom.defaultOptions ()

    target <-
      dom.query "#app"
      |> mapError (\error: dom.DomError -> "DOM target unavailable")

    dom.run options target (handle state) content
    |> mapError (\error: dom.DomRuntimeError<Never> -> "DOM runtime failed")
  }
