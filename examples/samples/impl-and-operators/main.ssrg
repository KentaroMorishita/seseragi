struct Score { value: Int, }

impl Score {
  operator + self -> bonus: Int -> Score = Score { value: self.value + bonus }

  operator == self -> other: Score -> Bool = self.value == other.value
}

fn render score: Score -> String =
  if score == Score { value: 42 } then `Score: ${score.value}` else "Unexpected score"

// 演算子定義も通常のAdd / Eqインスタンスと同じ仕組みで解決されます。
pub effect fn main -> Unit with Console fails ConsoleError =
  Score { value: 21 } + 21
  |> render
  |> println
