// 金額と個数を別の newtype にして、計算と丸めを型で守ります。
import { Decimal } from "std/decimal"
import * as decimal from "std/decimal"
import { Floor } from "std/number"

newtype Yen deriving Eq, Show = Decimal

newtype Quantity deriving Eq, Show = Int

impl Yen {
  operator + self -> other: Yen -> Yen = match (self, other) {
    (Yen left, Yen right) -> Yen (left + right)
  }

  operator - self -> other: Yen -> Yen = match (self, other) {
    (Yen left, Yen right) -> Yen (left - right)
  }

  operator * self -> count: Quantity -> Yen = match (self, count) {
    (Yen price, Quantity n) -> Yen (price * decimal.fromInt n)
  }
}

struct OrderLine { itemName: String, unitPrice: Yen, quantity: Quantity, }

struct Order {
  customer: String,
  lines: Array<OrderLine>,
  discountPercent: Int,
  taxPercent: Int,
}

struct Invoice {
  customer: String,
  discountPercent: Int,
  subtotal: Yen,
  discount: Yen,
  tax: Yen,
  total: Yen,
}

fn yen amount: Int -> Yen = Yen (decimal.fromInt amount)

fn rawYen amount: Yen -> Decimal = match amount {
  Yen value -> value
}

fn lineSubtotal line: OrderLine -> Yen = line.unitPrice * line.quantity

fn addYen left: Yen -> right: Yen -> Yen = left + right

fn orderSubtotal lines: Array<OrderLine> -> Yen =
  lines
  |> map lineSubtotal
  |> reduce (yen 0) addYen

// divideExact はゼロ除算などに備えて Either を返しますが、100 で割るこの計算では失敗しません。
// 日本の請求・消費税の端数処理に合わせて 1 円未満は切り捨て（Floor）にしています。
fn percentOfYen percent: Int
  -> base: Yen
  -> Either<decimal.DecimalArithmeticError, Yen> =
  do {
    exact <- decimal.divideExact (decimal.fromInt 100) (rawYen base * decimal.fromInt percent)
    pure (Yen (decimal.quantize 0 Floor exact))
  }

// 途中計算は Decimal で正確に行い、割引と税をそれぞれ 1 円単位へ丸めて請求書を作ります。
fn buildInvoice order: Order -> Either<decimal.DecimalArithmeticError, Invoice> = {
  let subtotal = orderSubtotal order.lines
  do {
    discount <- percentOfYen order.discountPercent subtotal
    let afterDiscount = subtotal - discount
    tax <- percentOfYen order.taxPercent afterDiscount
    let total = afterDiscount + tax
    pure (Invoice {
      customer: order.customer,
      discountPercent: order.discountPercent,
      subtotal,
      discount,
      tax,
      total,
    })
  }
}

fn renderInvoice label: String
  -> result: Either<decimal.DecimalArithmeticError, Invoice>
  -> String =
  match result {
    Left error -> `${label}: 計算できません (${error})`
    Right invoice -> `${label} [${invoice.customer}]: 小計 ${rawYen invoice.subtotal}円 - 割引(${invoice.discountPercent}%) ${rawYen invoice.discount}円 + 税 ${rawYen invoice.tax}円 = ${rawYen invoice.total}円`
  }

let standardOrder = Order {
  customer: "アオイ",
  lines: [
    OrderLine { itemName: "珈琲豆 200g", unitPrice: yen 1280, quantity: Quantity 2 },
    OrderLine { itemName: "マグカップ", unitPrice: yen 1850, quantity: Quantity 1 },
  ],
  discountPercent: 0,
  taxPercent: 10,
}

// 元の構造体を保ったまま、割引率だけを書き換えた新しい注文を作ります。
let memberOrder = Order { ...standardOrder, discountPercent: 15 }

pub effect fn main = [
  renderInvoice "通常注文" (buildInvoice standardOrder),
  renderInvoice "会員割引" (buildInvoice memberOrder),
]
  |> join "\n"
  |> println
